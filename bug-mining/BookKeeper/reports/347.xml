<item>
            <title>[BOOKKEEPER-839] AuditorPeriodicCheckTest timeout</title>
                <link>https://issues.apache.org/jira/browse/BOOKKEEPER-839</link>
                <project id="12311293" key="BOOKKEEPER">Bookkeeper</project>
                    <description>&lt;p&gt;This is failing consistently for me. I&apos;m using a ubuntu vm with Oracle jdk 8. Attaching a log file that I got from running it on the master branch.&lt;/p&gt;</description>
                <environment></environment>
        <key id="12777218">BOOKKEEPER-839</key>
            <summary>AuditorPeriodicCheckTest timeout</summary>
