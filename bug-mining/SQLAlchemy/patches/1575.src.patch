diff --git a/doc/build/changelog/unreleased_20/12488.rst b/doc/build/changelog/unreleased_20/12488.rst
new file mode 100644
index 000000000..d81d025bd
--- /dev/null
+++ b/doc/build/changelog/unreleased_20/12488.rst
@@ -0,0 +1,8 @@
+.. change::
+    :tags: bug, mysql
+    :tickets: 12488
+
+    Fixed regression caused by the DEFAULT rendering changes in 2.0.40
+    :ticket:`12425` where using lowercase `on update` in a MySQL server default
+    would incorrectly apply parenthesis, leading to errors when MySQL
+    interpreted the rendered DDL.  Pull request courtesy Alexander Ruehe.
diff --git a/lib/sqlalchemy/dialects/mysql/base.py b/lib/sqlalchemy/dialects/mysql/base.py
index bff907d53..c3bf5fee3 100644
--- a/lib/sqlalchemy/dialects/mysql/base.py
+++ b/lib/sqlalchemy/dialects/mysql/base.py
@@ -1941,7 +1941,7 @@ class MySQLDDLCompiler(compiler.DDLCompiler):
                 if (
                     self.dialect._support_default_function
                     and not re.match(r"^\s*[\'\"\(]", default)
-                    and "ON UPDATE" not in default
+                    and not re.search(r"ON +UPDATE", default, re.I)
                     and re.match(r".*\W.*", default)
                 ):
                     colspec.append(f"DEFAULT ({default})")
