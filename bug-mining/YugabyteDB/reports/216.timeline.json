_at":"2019-08-01T00:34:36Z","body":"This error occurs when selecting from large system table that has secondary index.\r\n- For this select statement, YugaByte send nested queries to DocDB (storage layer), when the result set is larger than prefetch-limit, DocDB sent back a paging state for the subsequent fetches.\r\n- The returned paging state is for the innermost query (the last operation node), but it is kept in the outermost query / node, and that causes a crash.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/517072418/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"nocaway","id":31016169,"node_id":"MDQ6VXNlcjMxMDE2MTY5","avatar_url":"https://avatars.githubusercontent.com/u/31016169?v=4","gravatar_id":"","url":"https://api.github.com/users/nocaway","html_url":"https://github.com/nocaway","followers_url":"https://api.github.com/users/nocaway/followers","following_url":"https://api.github.com/users/nocaway/following{/other_user}","gists_url":"https://api.github.com/users/nocaway/gists{/gist_id}","starred_url":"https://api.github.com/users/nocaway/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nocaway/subscriptions","organizations_url":"https://api.github.com/users/nocaway/orgs","repos_url":"https://api.github.com/users/nocaway/repos","events_url":"https://api.github.com/users/nocaway/events{/privacy}","received_events_url":"https://api.github.com/users/nocaway/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":2528122612,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDI1MjgxMjI2MTI=","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/2528122612","actor":{"login":"nocaway","id":31016169,"node_id":"MDQ6VXNlcjMxMDE2MTY5","avatar_url":"https://avatars.githubusercontent.com/u/31016169?v=4","gravata