-            sb.append("info : [").append(hubInfo.toString().trim().replaceAll("\n", ", "))
-              .append("], load : [").append(hubLoad.toString().trim().replaceAll("\n", ", "))
-              .append("]");
-            return sb.toString();
-        }
-    }
