s.\r\n    \r\n    - Performance improvements would need a benchmark test to prove it.\r\n    \r\n    - All exposed objects should have a comment.\r\n    \r\n    - All comments should start with a capital letter and end with a full stop.\r\n -->","reactions":{"url":"https://api.github.com/repos/prometheus/prometheus/issues/6650/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/prometheus/prometheus/issues/6650/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":2958078569,"node_id":"MDExOkNsb3NlZEV2ZW50Mjk1ODA3ODU2OQ==","url":"https://api.github.com/repos/prometheus/prometheus/issues/events/2958078569","actor":{"login":"brian-brazil","id":7115638,"node_id":"MDQ6VXNlcjcxMTU2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/7115638?v=4","gravatar_id":"","url":"https://api.github.com/users/brian-brazil","html_url":"https://github.com/brian-brazil","followers_url":"https://api.github.com/users/brian-brazil/followers","following_url":"https://api.github.com/users/brian-brazil/following{/other_user}","gists_url":"https://api.github.com/users/brian-brazil/gists{/gist_id}","starred_url":"https://api.github.com/users/brian-brazil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brian-brazil/subscriptions","organizations_url":"https://api.github.com/users/brian-brazil/orgs","repos_url":"https://api.github.com/users/brian-brazil/repos","events_url":"https://api.github.com/users/brian-brazil/events{/privacy}","received_events_url":"https://api.github.com/users/brian-brazil/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2020-01-17T13:06:27Z","state_reason":null,"performed_via_github_app":null},{"id":2958078686,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDI5NTgwNzg2ODY=","url":"https://api.github.com/repos/prometheu