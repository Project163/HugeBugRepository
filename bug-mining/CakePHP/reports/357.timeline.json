tional headers that have Non-ASCII value.\n\n``` PHP\n// 4th arg of mb_encode_mimeheader defaults to \"\\r\\n\".\n$obj->addHeaders(array('X-add', mb_encode_mimeheader('long Non-ASCII value', 'utf8', 'B')));\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/27541785/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"nmaya","id":5668936,"node_id":"MDQ6VXNlcjU2Njg5MzY=","avatar_url":"https://avatars.githubusercontent.com/u/5668936?v=4","gravatar_id":"","url":"https://api.github.com/users/nmaya","html_url":"https://github.com/nmaya","followers_url":"https://api.github.com/users/nmaya/followers","following_url":"https://api.github.com/users/nmaya/following{/other_user}","gists_url":"https://api.github.com/users/nmaya/gists{/gist_id}","starred_url":"https://api.github.com/users/nmaya/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nmaya/subscriptions","organizations_url":"https://api.github.com/users/nmaya/orgs","repos_url":"https://api.github.com/users/nmaya/repos","events_url":"https://api.github.com/users/nmaya/events{/privacy}","received_events_url":"https://api.github.com/users/nmaya/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":73732117,"node_id":"MDExOkNsb3NlZEV2ZW50NzM3MzIxMTc=","url":"https://api.github.com/repos/cakephp/cakephp/issues/events/73732117","actor":{"login":"Phally","id":112639,"node_id":"MDQ6VXNlcjExMjYzOQ==","avatar_url":"https://avatars.githubusercontent.com/u/112639?v=4","gravatar_id":"","url":"https://api.github.com/users/Phally","html_url":"https://github.com/Phally","followers_url":"https://api.github.com/users/Phally/followers","following_url":"https://api.github.com/users/Phally/following{/other_user}","gists_url":"https://api.github.com/users/Phally/gists{/gist_id}","starred_url":"https://a