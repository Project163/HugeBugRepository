rl":"https://api.github.com/users/normanmaurer/followers","following_url":"https://api.github.com/users/normanmaurer/following{/other_user}","gists_url":"https://api.github.com/users/normanmaurer/gists{/gist_id}","starred_url":"https://api.github.com/users/normanmaurer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/normanmaurer/subscriptions","organizations_url":"https://api.github.com/users/normanmaurer/orgs","repos_url":"https://api.github.com/users/normanmaurer/repos","events_url":"https://api.github.com/users/normanmaurer/events{/privacy}","received_events_url":"https://api.github.com/users/normanmaurer/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"normanmaurer","id":439362,"node_id":"MDQ6VXNlcjQzOTM2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/439362?v=4","gravatar_id":"","url":"https://api.github.com/users/normanmaurer","html_url":"https://github.com/normanmaurer","followers_url":"https://api.github.com/users/normanmaurer/followers","following_url":"https://api.github.com/users/normanmaurer/following{/other_user}","gists_url":"https://api.github.com/users/normanmaurer/gists{/gist_id}","starred_url":"https://api.github.com/users/normanmaurer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/normanmaurer/subscriptions","organizations_url":"https://api.github.com/users/normanmaurer/orgs","repos_url":"https://api.github.com/users/normanmaurer/repos","events_url":"https://api.github.com/users/normanmaurer/events{/privacy}","received_events_url":"https://api.github.com/users/normanmaurer/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":{"url":"https://api.github.com/repos/netty/netty/milestones/155","html_url":"https://github.com/netty/netty/milestone/155","labels_url":"https://api.github.com/repos/netty/netty/milestones/155/labels","id":2069740,"node_id":"MDk6TWlsZXN0b25lMjA2OTc0MA==","number":155,"title":"4.1.7.Final","description":"","creator":{"login":"normanmaurer","id":439362,"node_id":"MDQ6VXNlcjQzOTM2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/439362?v=4","gravatar_id":"","url":"https://api.github.com/users/normanmaurer","html_url":"https://github.com/normanmaurer","followers_url":"https://api.github.com/users/normanmaurer/followers","following_url":"https://api.github.com/users/normanmaurer/following{/other_user}","gists_url":"https://api.github.com/users/normanmaurer/gists{/gist_id}","starred_url":"https://api.github.com/users/normanmaurer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/normanmaurer/subscriptions","organizations_url":"https://api.github.com/users/normanmaurer/orgs","repos_url":"https://api.github.com/users/normanmaurer/repos","events_url":"https://api.github.com/users/normanmaurer/events{/privacy}","received_events_url":"https://api.github.com/users/normanmaurer/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":68,"state":"closed","created_at":"2016-10-14T09:12:18Z","updated_at":"2017-01-12T11:35:43Z","due_on":null,"closed_at":"2017-01-12T11:35:43Z"},"comments":6,"created_at":"2016-11-13T21:12:41Z","updated_at":"2016-11-18T11:25:59Z","closed_at":"2016-11-18T11:22:37Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"`ClientCookieDecoder` currently uses `HttpHeaderDateFormat` underneath, which has a fallback strategy and tries the following patterns:\r\n* `E, dd MMM yyyy HH:mm:ss z`\r\n* `EEEE, d-MMM-y HH:mm:ss z`\r\n* `EEE, MMM d HH:mm:ss yyyy`\r\n\r\nThe former is more or less RFC1123 (it accepts full days of week, while RFC1123 requires 3 letters), I don't know where the 2 others come from.\r\nRFC1123 is [the spec for headers such as `Expires` or `Date`](https://www.w3.org/Protocols/rfc2616/rfc2616-sec14.html).\r\n\r\nThe problem is that RFC6265 defines [its own spec](https://tools.ietf.org/html/rfc6265#section-5.1.1) (shaking head) that supports RFC1123 format.\r\n\r\nWhile most people stick to RFC1123, some don't.\r\nFor example, Github uses a thing of beauty such as `Sun, 27 Nov 2016 19:37:15 -0000` (`-0000` instead of `GMT` (banging head on desk).\r\nBasically, the spirit is that:\r\n* the day of week is ignored (completely redundant/useless)\r\n* the timezone is ignored as RFC6265 enforces UTC\r\n* delimiters can be many things, so it's not problem to write something like `27-Nov-2016`\r\n\r\nWorking on a fix.","closed_by":{"login":"normanmaurer","id":439362,"node_id":"MDQ6VXNlcjQzOTM2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/439362?v=4","gravatar_id":"","url":"https://api.github.com/users/normanmaurer","html_url":"https://github.com/normanmaurer","followers_url":"https://api.github.com/users/normanmaurer/followers","following_url":"https://api.github.com/users/normanmaurer/following{/other_user}","gists_url":"https://api.github.com/users/normanmaurer/gists{/gist_id}","starred_url":"https://api.github.com/users/normanmaurer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/normanmaurer/subscriptions","organizations_url":"https://api.github.com/users/normanmaurer/orgs","repos_url":"https://api.github.com/users/normanmaurer/repos","events_url":"https://api.github.com/users/normanmaurer/events{/privacy}","received_events_url":"https://api.github.com/users/normanmaurer/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/netty/netty/issues/6016/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/netty/netty/issues/6016/timeline","performed_via_github_app":null,"state_reason":"completed"}