ommits{/sha}","git_commits_url":"https://api.github.com/repos/vimeo/psalm/git/commits{/sha}","comments_url":"https://api.github.com/repos/vimeo/psalm/comments{/number}","issue_comment_url":"https://api.github.com/repos/vimeo/psalm/issues/comments{/number}","contents_url":"https://api.github.com/repos/vimeo/psalm/contents/{+path}","compare_url":"https://api.github.com/repos/vimeo/psalm/compare/{base}...{head}","merges_url":"https://api.github.com/repos/vimeo/psalm/merges","archive_url":"https://api.github.com/repos/vimeo/psalm/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/vimeo/psalm/downloads","issues_url":"https://api.github.com/repos/vimeo/psalm/issues{/number}","pulls_url":"https://api.github.com/repos/vimeo/psalm/pulls{/number}","milestones_url":"https://api.github.com/repos/vimeo/psalm/milestones{/number}","notifications_url":"https://api.github.com/repos/vimeo/psalm/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/vimeo/psalm/labels{/name}","releases_url":"https://api.github.com/repos/vimeo/psalm/releases{/id}","deployments_url":"https://api.github.com/repos/vimeo/psalm/deployments","created_at":"2016-11-21T17:04:41Z","updated_at":"2025-12-12T13:56:46Z","pushed_at":"2025-12-11T08:59:09Z","git_url":"git://github.com/vimeo/psalm.git","ssh_url":"git@github.com:vimeo/psalm.git","clone_url":"https://github.com/vimeo/psalm.git","svn_url":"https://github.com/vimeo/psalm","homepage":"https://psalm.dev","size":116606,"stargazers_count":5784,"watchers_count":5784,"language":"PHP","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":684,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1949,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["hacktoberfest","php","security-analysis","static-analysis","taint-analysis","type-inference"],"visibility":"public","forks":684,"open_issues":1949,"watchers":5784,"default_branch":"6.x","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"https://github.com/Microsoft/TypeScript/wiki/What's-new-in-TypeScript#optional-parameters-and-properties is similar to what I had in mind.\r\n\r\nOne possible syntax is to place a `?` before the `:`. (An optional nullable string would be `array{field?:?string}`, which is parseable but possibly confusing.)\r\n\r\nAnother syntax could be to place an `=` after the type (like JSDoc). `array{field:?string=}` \r\n\r\nE.g. `@param array{field?: string, other:string} $params` would be a parameter that would accept both `['other' => 'value']` and `['field' => 'v1', 'other' => 'v2']`\r\n\r\nCasting rules: \r\n\r\n- Can cast required fields to optional (references may be an exception). E.g. casting `array{field:string}` to `array{field?:string}`.\r\n- Can cast an absent field to an optional field, e.g. casting `array{field:string}` to `array{field:string, otherOptionalField?:string}`\r\n\r\nThe implementation details of this may affect https://github.com/vimeo/psalm/issues/457 (Different views on whether or not fields not mentioned in the union type are allowed to exist or not).\r\n\r\n---\r\n\r\nUse cases: Option arrays for function calls, global constructors.\r\nE.g. http://php.net/unserialize would have these template annotations if there was union type support for it.\r\n\r\n```php\r\n<?php\r\n\r\n/**\r\n * @param string $str\r\n * @param {allowed_classes?:string[]|bool} $options\r\n * @return mixed\r\n */\r\nfunction unserialize($str, $options = []) {...}\r\n```","reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/458/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vimeo/psalm/issues/458/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":1466027123,"node_id":"MDEyOkxhYmVsZWRFdmVudDE0NjYwMjcxMjM=","url":"https://api.github.com/repos/vimeo/psalm/issues/events/1466027123","actor":{"login":"muglug","id":2292638,"node_id":"MDQ6VXNlcjIyOTI2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/2292638?v=4","gravatar_id":"","url":"https://api.github.com/users/muglug","html_url":"https://github.com/muglug","followers_url":"https://api.github.com/users/muglug/followers","following_url":"https://api.github.com/users/muglug/following{/other_user}","gists_url":"https://api.github.com/users/muglug/gists{/gist_id}","starred_url":"https://api.github.com/users/muglug/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/muglug/subscriptions","organizations_url":"https://api.github.com/users/muglug/orgs","repos_url":"https://api.github.com/users/muglug/repos","events_url":"https://api.github.com/users/muglug/events{/privacy}","received_events_url":"https://api.github.com/users/muglug/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2018-02-09T05:34:03Z","label":{"name":"bug","color":"ee0701"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/vimeo/psalm/issues/comments/364339925","html_url":"https://github.com/vimeo/psalm/issues/457#issuecomment-364339925","issue_url":"https://api.github.com/repos/vimeo/psalm/issues/457","id":364339925,"node_id":"MDEyOklzc3VlQ29tbWVudDM2NDMzOTkyNQ==","user":{"login":"muglug","id":2292638,"node_id":"MDQ6VXNlcjIyOTI2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/2292638?v=4","gravatar_id":"","url":"https://api.github.com/users/muglug","html_url":"https://github.com/muglug","followers_url":"https://api.github.com/users/muglug/followers","following_url":"https://api.github.com/users/muglug/following{/other_user}","gists_url":"htt