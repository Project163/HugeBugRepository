areechang/orgs","repos_url":"https://api.github.com/users/Jareechang/repos","events_url":"https://api.github.com/users/Jareechang/events{/privacy}","received_events_url":"https://api.github.com/users/Jareechang/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-10-30T21:42:05Z","updated_at":"2016-10-30T21:48:38Z","body":"I can add a PR request for this. \n\n### Bug causing code:\n\nThis code should check for **null** as `typeof null` is considered object.\n\n``` javascript\nif (typeof me.chart.data.datasets[datasetIndex].data[0] === 'object') {\n    label = me.getRightValue(me.chart.data.datasets[datasetIndex].data[index]);\n}\n```\n\n### Full method (reference):\n\n``` javascript\ngetLabelForIndex: function(index, datasetIndex) {\n    var me = this;\n    var label = me.chart.data.labels && index < me.chart.data.labels.length ? me.chart.data.labels[index] : '';\n\n    if (typeof me.chart.data.datasets[datasetIndex].data[0] === 'object') {\n        label = me.getRightValue(me.chart.data.datasets[datasetIndex].data[index]);\n    }\n\n    // Format nicely\n    if (me.options.time.tooltipFormat) {\n        label = me.parseTime(label).format(me.options.time.tooltipFormat);\n    }\n\n    return label;\n}\n```\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/chartjs/Chart.js/issues/comments/257181473/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Jareechang","id":9851316,"node_id":"MDQ6VXNlcjk4NTEzMTY=","avatar_url":"https://avatars.githubusercontent.com/u/9851316?v=4","gravatar_id":"","url":"https://api.github.com/users/Jareechang","html_url":"https://github.com/Jareechang","followers_url":"https://api.github.com/users/Jareechang/followers","following_url":"https://api.github.com/users/Jareechang/following{/other_user}","gists_url":"https://api.github.com/users/Ja