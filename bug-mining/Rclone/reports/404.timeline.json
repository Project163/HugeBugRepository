ivacy}","received_events_url":"https://api.github.com/users/usbpc/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/rclone/rclone/issues/comments/480600563","html_url":"https://github.com/rclone/rclone/issues/3095#issuecomment-480600563","issue_url":"https://api.github.com/repos/rclone/rclone/issues/3095","id":480600563,"node_id":"MDEyOklzc3VlQ29tbWVudDQ4MDYwMDU2Mw==","user":{"login":"usbpc","id":3638901,"node_id":"MDQ6VXNlcjM2Mzg5MDE=","avatar_url":"https://avatars.githubusercontent.com/u/3638901?v=4","gravatar_id":"","url":"https://api.github.com/users/usbpc","html_url":"https://github.com/usbpc","followers_url":"https://api.github.com/users/usbpc/followers","following_url":"https://api.github.com/users/usbpc/following{/other_user}","gists_url":"https://api.github.com/users/usbpc/gists{/gist_id}","starred_url":"https://api.github.com/users/usbpc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/usbpc/subscriptions","organizations_url":"https://api.github.com/users/usbpc/orgs","repos_url":"https://api.github.com/users/usbpc/repos","events_url":"https://api.github.com/users/usbpc/events{/privacy}","received_events_url":"https://api.github.com/users/usbpc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-04-07T15:34:47Z","updated_at":"2019-04-07T15:34:47Z","body":"Interestingly it works as expected in an older version:\r\n\r\n```\r\n$ rclone -V\r\nrclone v1.43\r\n- os/arch: linux/amd64\r\n- go version: go1.11\r\n```\r\n\r\nIt dosen't work quite as fast as I'd like but it dosen't use a way to big amount of b2 class C transactions.\r\n\r\nWhat I think is making it slower has something to do with  #2639 as the local file system dosen't benefit from `--fast-list` but rclone still does a recursive listing of all files even tho `--files-from` is specified.\r\n\r\nBut it does use fewer transactions and with `--files-from` it is way faster cause it dosen't really compare all files it just compares everything against the `--files-from` whitelist.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/rclone/rclone/issues/comments/480600563/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"usbpc","id":3638901,"node_id":"MDQ6VXNlcjM2Mzg5MDE=","avatar_url":"https://avatars.githubusercontent.com/u/3638901?v=4","gravatar_id":"","url":"https://api.github.com/users/usbpc","html_url":"https://github.com/usbpc","followers_url":"https://api.github.com/users/usbpc/followers","following_url":"https://api.github.com/users/usbpc/following{/other_user}","gists_url":"https://api.github.com/users/usbpc/gists{/gist_id}","starred_url":"https://api.github.com/users/usbpc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/usbpc/subscriptions","organizations_url":"https://api.github.com/users/usbpc/orgs","repos_url":"https://api.github.com/users/usbpc/repos","events_url":"https://api.github.com/users/usbpc/events{/privacy}","received_events_url":"https://api.github.com/users/usbpc/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/rclone/rclone/issues/comments/481737532","html_url":"https://github.com/rclone/rclone/issues/3095#issuecomment-481737532","issue_url":"https://api.github.com/repos/rclone/rclone/issues/3095","id":481737532,"node_id":"MDEyOklzc3VlQ29tbWVudDQ4MTczNzUzMg==","user":{"login":"ncw","id":536803,"node_id":"MDQ6VXNlcjUzNjgwMw==","avatar_url":"https://avatars.githubusercontent.com/u/536803?v=4","gravatar_id":"","url":"https://api.github.com/users/ncw","html_url":"https://github.com/ncw","followers_url":"https://api.github.com/users/ncw/followers","following_url":"https://api.github.com/users/ncw/following{/other_user}","gists_url":"https://api.github.com/users/ncw/gists{/gist_id}","starred_url":"https://api.github.com/users/ncw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ncw/subscriptions","organizations_url":"https://api.github.com/users/ncw/orgs","repos_url":"https://api.github.com/users/ncw/repos","events_url":"https://api.github.com/users/ncw/events{/privacy}","received_events_url":"https://api.github.com/users/ncw/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-04-10T15:24:31Z","updated_at":"2019-04-10T15:24:31Z","body":"This change was made in c5ac96e9e7afd2e11b69233ed3671e8ad05d24a9 which was released in v1.45.\r\n\r\n> Make --files-from only read the objects specified and don't scan directories\r\n> \r\n> Before this change using --files-from would scan all the directories\r\n> that the files could possibly be in causing rclone to do more work\r\n> that was necessary.\r\n> \r\n> After this change, rclone constructs an in memory tree using the\r\n> --fast-list mechanism but from all of the files in the --files-from\r\n> list and without scanning any directories.\r\n> \r\n> Any objects that are not found in the --files-from list are ignored\r\n> silently.\r\n> \r\n> This mechanism is used for sync/copy/move (march) and all of the\r\n> listing commands ls/lsf/md5sum/etc (walk).\r\n\r\nThere is a tradeoff for doing `--files-from` like this and just doing a full file system traverse (eg with `--fast-list`).  It should be faster but I suspect for big lists it won't be faster.\r\n\r\nHow many files do you have in your list?\r\n\r\nThis problem came up on the forum too (with google drive) and there you'll find a beta with a flag `--files-from-traverse` to re-enable the old behavior.\r\n\r\nhttps://forum.rclone.org/t/using-files-from-with-drive-hammers-the-api/8726\r\n\r\nhttps://beta.rclone.org/branch/v1.46.0-019-gf97cbd3b-fix-files-from-traverse-beta/\r\n\r\nI wonder whether I made a mistake with the new `--files-from` behaviour, or should add some heuristic to turn it on and off...\r\n\r\nPerhaps `--fast-list` should turn it off and force it to use the whole listing... That would fix this problem and the one in the forum.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/rclone/rclone/issues/comments/481737532/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ncw","id":536803,"node_id":"MDQ6VXNlcjUzNjgwMw==","avatar_url":"https://avatars.githubusercontent.com/u/536803?v=4","gravatar_id":"","url":"https://api.github.com/users/ncw","html_url":"https://github.com/ncw","followers_url":"https://api.github.com/users/ncw/followers","following_url":"https://api.github.com/users/ncw/following{/other_user}","gists_url":"https://api.github.com/users/ncw/gists{/gist_id}","starred_url":"https://api.github.com/users/ncw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ncw/subscriptions","organizations_url":"https://api.github.com/users/ncw/orgs","repos_url":"https://api.github.com/users/ncw/repos","events_url":"https://api.github.com/users/ncw/events{/privacy}","received_events_url":"https://api.github.com/users/ncw/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":2266475359,"node_id":"MDEyOkxhYmVsZWRFdmVudDIyNjY0NzUzNTk=","url":"https://api.github.com/repos/rclone/rclone/issues/events/2266475359","actor":{"login":"ncw","id":536803,"node_id":"MDQ6VXNlcjUzNjgwMw==","avatar_url":"https://avatars.githubusercontent.com/u/536803?v=4","gravatar_id":"","url":"https://api.github.com/users/ncw","html_url":"https://github.com/ncw","followers_url":"https://api.github.com/users/ncw/followers","following_url":"https://api.github.com/users/ncw/following{/other_user}","gists_url":"https://api.github.com/users/ncw/gists{/gist_id}","starred_url":"https://api.github.com/users/ncw/starred{/owner}{/repo}","subscriptions_url":"https://api.gith