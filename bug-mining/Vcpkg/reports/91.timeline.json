s_url":"https://api.github.com/repos/opencv/opencv/contents/{+path}","compare_url":"https://api.github.com/repos/opencv/opencv/compare/{base}...{head}","merges_url":"https://api.github.com/repos/opencv/opencv/merges","archive_url":"https://api.github.com/repos/opencv/opencv/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/opencv/opencv/downloads","issues_url":"https://api.github.com/repos/opencv/opencv/issues{/number}","pulls_url":"https://api.github.com/repos/opencv/opencv/pulls{/number}","milestones_url":"https://api.github.com/repos/opencv/opencv/milestones{/number}","notifications_url":"https://api.github.com/repos/opencv/opencv/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/opencv/opencv/labels{/name}","releases_url":"https://api.github.com/repos/opencv/opencv/releases{/id}","deployments_url":"https://api.github.com/repos/opencv/opencv/deployments","created_at":"2012-07-19T09:40:17Z","updated_at":"2025-12-13T06:37:33Z","pushed_at":"2025-12-13T06:45:02Z","git_url":"git://github.com/opencv/opencv.git","ssh_url":"git@github.com:opencv/opencv.git","clone_url":"https://github.com/opencv/opencv.git","svn_url":"https://github.com/opencv/opencv","homepage":"https://opencv.org","size":551805,"stargazers_count":85249,"watchers_count":85249,"language":"C++","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":56392,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":2701,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["c-plus-plus","computer-vision","deep-learning","image-processing","opencv"],"visibility":"public","forks":56392,"open_issues":2701,"watchers":85249,"default_branch":"4.x","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/opencv/opencv/pulls/14746","html_url":"https://github.com/opencv/opencv/pull/14746","diff_url":"https://github.com/opencv/opencv/pull/14746.diff","patch_url":"https://github.com/opencv/opencv/pull/14746.patch","merged_at":null},"body":"The version is now derived from a git repository if that git repository is rooted at the source directory. This is to prevent problems when OpenCV is included inside of another git repository.\r\n\r\nResolves https://github.com/microsoft/vcpkg/issues/6708\r\n\r\nSame technique as this [AWS SDK for C++ fix](https://github.com/aws/aws-sdk-cpp/pull/425/files#diff-198ad692bfaa08553bc0dc7b00415241)","reactions":{"url":"https://api.github.com/repos/opencv/opencv/issues/14746/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/opencv/opencv/issues/14746/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/microsoft/vcpkg/issues/comments/499666717","html_url":"https://github.com/microsoft/vcpkg/issues/6708#issuecomment-499666717","issue_url":"https://api.github.com/repos/microsoft/vcpkg/issues/6708","id":499666717,"node_id":"MDEyOklzc3VlQ29tbWVudDQ5OTY2NjcxNw==","user":{"login":"alalek","id":4981219,"node_id":"MDQ6VXNlcjQ5ODEyMTk=","avatar_url":"https://avatars.githubusercontent.com/u/4981219?v=4","gravatar_id":"","url":"https://api.github.com/users/alalek","html_url":"https://github.com/alalek","followers_url":"https://api.github.com/users/alalek/followers","following_url":"https://api.github.com/users/alalek/following{/other_user}","gists_url":"https://api.github.com/users/alalek/gists{/gist_id}","starred_url":"https://api.github.com/users/alalek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alalek/subscriptions","organizations_url":"https://api.github.com/users/alalek/orgs","repos_url":"https://api.github.com/users/alalek/repos","events_url":"https://api.github.com/users/alalek/events{/privacy}","received_events_url":"https://api.github.com/users/alalek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-06-06T21:03:38Z","updated_at":"2019-06-06T21:03:38Z","body":"There is no \"git\" information available from unpacked archives.\r\n\r\nTry to add [here](https://github.com/microsoft/vcpkg/blob/a260c2dafba9a2ef822985376da612567c6029fa/ports/opencv/portfile.cmake#L296) something like:\r\n```\r\n-DOPENCV_VCSVERSION=vcpkg-${OPENCV_VCSVERSION}\r\n```\r\n\r\nUnfortunately, there is no similar way to workaround `opencv_contrib` git hashes (they are not collected from the git-\"rooted\" path in general, so proposed above workaround doesn't work at all even without vcpkg):\r\n- turn off information about them completely via `BUILD_INFO_SKIP_EXTRA_MODULES=ON`\r\n- or disable \"find_package(Git)\" via CMake's: `CMAKE_DISABLE_FIND_PACKAGE_Git=ON` (should work if it is new \"CMake\" process)","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/microsoft/vcpkg/issues/comments/499666717/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"alalek","id":4981219,"node_id":"MDQ6VXNlcjQ5ODEyMTk=","avatar_url":"https://avatars.githubusercontent.com/u/4981219?v=4","gravatar_id":"","url":"https://api.github.com/users/alalek","html_url":"https://github.com/alalek","followers_url":"https://api.github.com/users/alalek/followers","following_url":"https://api.github.com/users/alalek/following{/other_user}","gists_url":"https://api.github.com/users/alalek/gists{/gist_id}","starred_url":"https://api.github.com/users/alalek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alalek/subscriptions","organizations_url":"htt