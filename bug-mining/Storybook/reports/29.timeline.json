kjs/storybook/labels{/name}","releases_url":"https://api.github.com/repos/storybookjs/storybook/releases{/id}","deployments_url":"https://api.github.com/repos/storybookjs/storybook/deployments","created_at":"2016-03-18T04:23:44Z","updated_at":"2025-12-12T17:56:23Z","pushed_at":"2025-12-12T17:55:46Z","git_url":"git://github.com/storybookjs/storybook.git","ssh_url":"git@github.com:storybookjs/storybook.git","clone_url":"https://github.com/storybookjs/storybook.git","svn_url":"https://github.com/storybookjs/storybook","homepage":"https://storybook.js.org","size":1090866,"stargazers_count":88816,"watchers_count":88816,"language":"TypeScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":9808,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":2246,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["angular","components","design-systems","documentation","html","javascript","react","react-native","stories","storybook","styleguide","svelte","testing","typescript","ui","vite","vue","web-components","webpack","workshop"],"visibility":"public","forks":9808,"open_issues":2246,"watchers":88816,"default_branch":"next","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"For HMR (hot module reload) to work, the root component has to be a class, as it seems.\r\n\r\nI therefore added this to storybook/storybook.js :\r\n\r\n\r\n```\r\nconst StorybookUIOrg = getStorybookUI({ port: 7007, onDeviceUI: true })\r\n\r\nconst StorybookUI = class extends Component {\r\n  render() {\r\n    return <StorybookUIOrg />\r\n  }\r\n}\r\n\r\nAppRegistry.registerComponent('homestory', () => StorybookUI)\r\n```\r\n\r\nThis used to work in the past, but with latest version, i just see the native ui menu and some warnings like:\r\n\r\n\"The prop url is marked as required in `StoryView` but it's value is null\"\r\n\r\nand \r\n\r\n\"The prop url is marked as required in `OnDeviceUI`, but it's value is null\"\r\n\r\n\r\nEdit: without the class above, there is no warning. But hot reload does not work. On the simulator it notifies about \"hot reloading\", but nothing changes.\r\n\r\nEdit 2: if i change to a different story after hot reload and back, the changes are applied... So what's wrong? \r\n\r\nI now switched back to live reload, HMR seems broken at the time beeing","reactions":{"url":"https://api.github.com/repos/storybookjs/storybook/issues/2081/reactions","total_count":7,"+1":7,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/storybookjs/storybook/issues/2081/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":1317307941,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDEzMTczMDc5NDE=","url":"https://api.github.com/repos/storybookjs/storybook/issues/events/1317307941","actor":{"login":"danielduan","id":1474548,"node_id":"MDQ6VXNlcjE0NzQ1NDg=","avatar_url":"https://avatars.githubusercontent.com/u/1474548?v=4","gravatar_id":"","url":"https://api.github.com/users/danielduan","html_url":"https://github.com/danielduan","followers_url":"https://api.github.com/users/danielduan/followers","following_url":"https://api.github.com/users/danielduan/following{/other_user}","gists_url":"https://api.github.com/users/danielduan/gists{/gist_id}","starred_url":"https://api.github.com/users/danielduan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/danielduan/subscriptions","organizations_url":"https://api.github.com/users/danielduan/orgs","repos_url":"https://api.github.com/users/danielduan/repos","events_url":"https://api.github.com/users/danielduan/events{/privacy}","received_events_url":"https://api.github.com/users/danielduan/recei