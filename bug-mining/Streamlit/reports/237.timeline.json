d_url":"https://api.github.com/users/frederiksteiner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/frederiksteiner/subscriptions","organizations_url":"https://api.github.com/users/frederiksteiner/orgs","repos_url":"https://api.github.com/users/frederiksteiner/repos","events_url":"https://api.github.com/users/frederiksteiner/events{/privacy}","received_events_url":"https://api.github.com/users/frederiksteiner/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2023-04-19T15:01:14Z","label":{"name":"type:bug","color":"D93F0B"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/streamlit/streamlit/issues/comments/1528365611","html_url":"https://github.com/streamlit/streamlit/issues/6515#issuecomment-1528365611","issue_url":"https://api.github.com/repos/streamlit/streamlit/issues/6515","id":1528365611,"node_id":"IC_kwDODCoeTs5bGQIr","user":{"login":"vdonato","id":3144420,"node_id":"MDQ6VXNlcjMxNDQ0MjA=","avatar_url":"https://avatars.githubusercontent.com/u/3144420?v=4","gravatar_id":"","url":"https://api.github.com/users/vdonato","html_url":"https://github.com/vdonato","followers_url":"https://api.github.com/users/vdonato/followers","following_url":"https://api.github.com/users/vdonato/following{/other_user}","gists_url":"https://api.github.com/users/vdonato/gists{/gist_id}","starred_url":"https://api.github.com/users/vdonato/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vdonato/subscriptions","organizations_url":"https://api.github.com/users/vdonato/orgs","repos_url":"https://api.github.com/users/vdonato/repos","events_url":"https://api.github.com/users/vdonato/events{/privacy}","received_events_url":"https://api.github.com/users/vdonato/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-04-29T01:08:21Z","updated_at":"2023-04-29T01:10:14Z","body":"Hi @frederiksteiner,\r\n\r\nI'm not sure if this is something that we could reasonably fix on the Streamlit side of things as we're offloading the responsibility of deciding what index of a collection an element is in to Python's builtin `list.index()` method. While writing a more specialized implementation here would be possible, I'm not sure it would be worth the additional implementation+maintenance effort to support what I think is a relatively rare use-case.\r\n\r\nThe standard way of getting this to work would be to provide a custom `__eq__` method in your class implementation that considers two `Choice`s equal if they have the same name (or by some other more complex criteria for the real class this is being done for):\r\n\r\n```python3\r\ndef __eq__(self, other) -> bool:\r\n    return self.name == other.name\r\n```\r\n\r\nLet me know if this solution works for you!","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/streamlit/streamlit/issues/comments/1528365611/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"vdonato","id":3144420,"node_id":"MDQ6VXNlcjMxNDQ0MjA=","avatar_url":"https://avatars.githubusercontent.com/u/3144420?v=4","gravatar_id":"","url":"https://api.github.com/users/vdonato","html_url":"https://github.com/vdonato","followers_url":"https://api.github.com/users/vdonato/followers","following_url":"https://api.github.com/users/vdonato/following{/other_user}","gists_url":"https://api.github.com/users/vdonato/gists{/gist_id}","starred_url":"https://api.github.com/users/vdonato/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vdonato/subscriptions","organizations_url":"https://api.github.com/users/vdonato/orgs","repos_url":"https://api.github.com/users/vdonato/repos","events_url":"https://api.github.com/users/vdonato/events{/privacy}","received_events_url":"https://api.github.com