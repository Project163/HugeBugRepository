un/react-router.git","clone_url":"https://github.com/remix-run/react-router.git","svn_url":"https://github.com/remix-run/react-router","homepage":"https://reactrouter.com","size":44323,"stargazers_count":56017,"watchers_count":56017,"language":"TypeScript","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":10809,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":145,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":[],"visibility":"public","forks":10809,"open_issues":145,"watchers":56017,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/remix-run/react-router/pulls/8533","html_url":"https://github.com/remix-run/react-router/pull/8533","diff_url":"https://github.com/remix-run/react-router/pull/8533.diff","patch_url":"https://github.com/remix-run/react-router/pull/8533.patch","merged_at":"2022-02-27T20:34:54Z"},"body":"As no member confirm or refuse my issue #8458.\r\nHere a PR that fix the bug for me.\r\n\r\nNot sure if this is the best place to call normalizePathname, though.\r\n\r\nDo not hesitate to comment, I will gladly change my PR.\r\n\r\n\r\n----- Commit message -----\r\nMotivation:\r\nWhen matching with \"*\", the `pathnameBase` had a trailing slash `/`.\r\n\r\nModifications:\r\n * Call normalizePathname for pathnameBase\r\n\r\nResult:\r\nWe can use an element that call useRoutes to define another alternative router for matching with \"*\".\r\n\r\nCloses: #8458","reactions":{"url":"https://api.github.com/repos/remix-run/react-router/issues/8533/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/remix-run/react-router/issues/8533/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/remix-run/react-router/issues/comments/1013293364","html_url":"https://github.com/remix-run/react-router/issues/8458#issuecomment-1013293364","issue_url":"https://api.github.com/repos/remix-run/react-router/issues/8458","id":1013293364,"node_id":"IC_kwDOAS86yM48ZaE0","user":{"login":"elijahrdorman","id":4094750,"node_id":"MDQ6VXNlcjQwOTQ3NTA=","avatar_url":"https://avatars.githubusercontent.com/u/4094750?v=4","gravatar_id":"","url":"https://api.github.com/users/elijahrdorman","html_url":"https://github.com/elijahrdorman","followers_url":"https://api.github.com/users/elijahrdorman/followers","following_url":"https://api.github.com/users/elijahrdorman/following{/other_user}","gists_url":"https://api.github.com/users/elijahrdorman/gists{/gist_id}","starred_url":"https://api.github.com/users/elijahrdorman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elijahrdorman/subscriptions","organizations_url":"https://api.github.com/users/elijahrdorman/orgs","repos_url":"https://api.github.com/users/elijahrdorman/repos","events_url":"https://api.github.com/users/elijahrdorman/events{/privacy}","received_events_url":"https://api.github.com/users/elijahrdorman/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-01-14T16:55:41Z","updated_at":"2022-01-14T17:02:47Z","body":"I'm also affected by this issue.\r\n\r\nBasically:\r\n\r\n```typescript\r\nconst Outer = () => (\r\n  <Routes>\r\n    <Route path=\"foo\" element={<Inner />} />\r\n    <Route path=\"*\" element={<NotFound />} />\r\n  </Routes>\r\n)\r\n\r\nconst Inner () => {\r\n  const params = useParams()\r\n\r\n  return (\r\n    <Routes>\r\n      <Route path=\":myId\" element={<WithId />} />\r\n      <Route path=\"\" element={<WithoutId />} />\r\n    </Routes>\r\n  )\r\n}\r\n```\r\n\r\nWith the path `/foo/abc` results in `NotFound` rendering.\r\n\r\nChanging to `<Route path=\"foo/*\" />` means that the `WithoutId` renders, but with params being `{'*': 'abc'}`.\r\n\r\nChanging to `<Route path=\"foo/:myId\" />` also renders `WithoutId`, but with params being `{myId: 'abc'}`.\r\n\r\nIt seems like there needs to be a symbol that means \"consider a match, but pass on to a subrouter\". Alternatively, it could detect the presence of `<Routes>` children/grandchildren in addition to `<Route>` children.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/remix-run/react-router/issues/comments/1013293364/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"elijahrdorman","id":4094750,"node_id":"MDQ6VXNlcjQwOTQ3NTA=","avatar_url":"https://avatars.githubusercontent.com/u/4094750?v=4","gravatar_id":"","url":"https://api.github.com/users/elijahrdorman","html_url":"https://github.com/elijahrdorman","followers_url":"https://api.github.com/users/elijahrdorman/followers","following_url":"https://api.github.com/users/elijahrdorman/following{/other_user}","gists_url":"https://api.github.com/users/elijahrdorman/gists{/gist_id}","starred_url":"https://api.github.com/users/elijahrdorman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elijahrdorman/subscriptions","organizations_url":"https://api.github.com/users/elijahrdorman/orgs","repos_url":"https://api.github.com/users/elijahrdorman/repos","events_url":"https://api.github.com/users/elijahrdorman/events{/privacy}","received_events_url":"https://api.github.com/users/elijahrdorman/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":6150892063,"node_id":"REFE_lADOAS86yM5AG_TPzwAAAAFunyof","url":"https://api.github.com/repos/remix-run/react-router/issues/events/6150892063","actor":{"login":"timdorr","id":17882,"node_id