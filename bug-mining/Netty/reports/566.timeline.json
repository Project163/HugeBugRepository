om the method rather than falling back to the default value.\r\n\r\nResult:\r\n\r\nIn invalid content-length header will not be silently ignored.\r\n\r\nRelates #5861\r\n\r\n","reactions":{"url":"https://api.github.com/repos/netty/netty/issues/6866/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/netty/netty/issues/6866/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":1242072599,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDEyNDIwNzI1OTk=","url":"https://api.github.com/repos/netty/netty/issues/events/1242072599","actor":{"login":"liuzhengyang","id":7070174,"node_id":"MDQ6VXNlcjcwNzAxNzQ=","avatar_url":"https://avatars.githubusercontent.com/u/7070174?v=4","gravatar_id":"","url":"https://api.github.com/users/liuzhengyang","html_url":"https://github.com/liuzhengyang","followers_url":"https://api.github.com/users/liuzhengyang/followers","following_url":"https://api.github.com/users/liuzhengyang/following{/other_user}","gists_url":"https://api.github.com/users/liuzhengyang/gists{/gist_id}","starred_url":"https://api.github.com/users/liuzhengyang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/liuzhengyang/subscriptions","organizations_url":"https://api.github.com/users/liuzhengyang/orgs","repos_url":"https://api.github.com/users/liuzhengyang/repos","events_url":"https://api.github.com/users/liuzhengyang/events{/privacy}","received_events_url":"https://api.github.com/users/liuzhengyang/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"94f697881630d0f718aaa510f0c65bed4e20020d","commit_url":"https://api.github.com/repos/liuzhengyang/netty/commits/94f697881630d0f718aaa510f0c65bed4e20020d","created_at":"2017-09-10T04:58:21Z","performed_via_github_app":null}]