--- a/pylint/checkers/typecheck.py
+++ b/pylint/checkers/typecheck.py
@@ -422,9 +422,10 @@ def _no_context_variadic_keywords(node):
     if not isinstance(scope, astroid.FunctionDef):
         return False
 
