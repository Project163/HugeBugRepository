{"url":"https://api.github.com/repos/symfony/symfony/issues/26065","repository_url":"https://api.github.com/repos/symfony/symfony","labels_url":"https://api.github.com/repos/symfony/symfony/issues/26065/labels{/name}","comments_url":"https://api.github.com/repos/symfony/symfony/issues/26065/comments","events_url":"https://api.github.com/repos/symfony/symfony/issues/26065/events","html_url":"https://github.com/symfony/symfony/issues/26065","id":294812169,"node_id":"MDU6SXNzdWUyOTQ4MTIxNjk=","number":26065,"title":"Yaml::DUMP_MULTI_LINE_LITERAL_BLOCK creates invalid YAMl if first line has leading spaces","user":{"login":"tamc","id":43987,"node_id":"MDQ6VXNlcjQzOTg3","avatar_url":"https://avatars.githubusercontent.com/u/43987?v=4","gravatar_id":"","url":"https://api.github.com/users/tamc","html_url":"https://github.com/tamc","followers_url":"https://api.github.com/users/tamc/followers","following_url":"https://api.github.com/users/tamc/following{/other_user}","gists_url":"https://api.github.com/users/tamc/gists{/gist_id}","starred_url":"https://api.github.com/users/tamc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tamc/subscriptions","organizations_url":"https://api.github.com/users/tamc/orgs","repos_url":"https://api.github.com/users/tamc/repos","events_url":"https://api.github.com/users/tamc/events{/privacy}","received_events_url":"https://api.github.com/users/tamc/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":100079,"node_id":"MDU6TGFiZWwxMDAwNzk=","url":"https://api.github.com/repos/symfony/symfony/labels/Bug","name":"Bug","color":"e10c02","default":false,"description":null},{"id":3536874,"node_id":"MDU6TGFiZWwzNTM2ODc0","url":"https://api.github.com/repos/symfony/symfony/labels/Yaml","name":"Yaml","color":"DDDDDD","default":false,"description":null},{"id":237003792,"node_id":"MDU6TGFiZWwyMzcwMDM3OTI=","url":"https://api.github.com/repos/symfony/symfony/labels/Status:%20Needs%20Review","name":"Status: Needs Review","color":"ededed","default":false,"description":null}],"state":"closed","locked":false,"assignee":null,"assignees":[],"milestone":null,"comments":0,"created_at":"2018-02-06T15:57:59Z","updated_at":"2018-02-11T15:00:44Z","closed_at":"2018-02-11T15:00:44Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"| Q                | A\r\n| ---------------- | -----\r\n| Bug report?      | yes\r\n| Feature request? | no\r\n| BC Break report? | no\r\n| RFC?             | no\r\n| Symfony version  | 3.4.4\r\n\r\nDoing this:\r\n    \r\n    Yaml::dump(\r\n        [\"text\" => \"  leading space in first line\\nno leading space in last line\\n\"],\r\n        2, \r\n        4, \r\n        Yaml::DUMP_MULTI_LINE_LITERAL_BLOCK\r\n    );\r\n\r\nWill produce this:\r\n\r\n    text: |\r\n           leading space in first line\r\n         no leading space in last line\r\n         \r\nWhich is invalid YAML because when the first line has leading spaces it needs a [block indentation indicator](http://www.yaml.org/spec/1.2/spec.html#id2793979) like this:\r\n\r\n    text: |4\r\n          leading space in first line\r\n        no leading space in last line","closed_by":{"login":"nicolas-grekas","id":243674,"node_id":"MDQ6VXNlcjI0MzY3NA==","avatar_url":"https://avatars.githubusercontent.com/u/243674?v=4","gravatar_id":"","url":"https://api.github.com/users/nicolas-grekas","html_url":"https://github.com/nicolas-grekas","followers_url":"https://api.github.com/users/nicolas-grekas/followers","following_url":"https://api.github.com/users/nicolas-grekas/following{/other_user}","gists_url":"https://api.github.com/users/nicolas-grekas/gists{/gist_id}","starred_url":"https://api.github.com/users/nicolas-grekas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nicolas-grekas/subscriptions","organizations_url":"https://api.github.com/users/nicolas-grekas/orgs","repos_url":"https://api.github.com/users/nicolas-grekas/repos","events_url":"https://api.github.com/users/nicolas-grekas/events{/privacy}","received_events_url":"https://api.github.com/users/nicolas-grekas/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/symfony/symfony/issues/26065/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/symfony/symfony/issues/26065/timeline","performed_via_github_app":null,"state_reason":"completed"}