`` php\n public function getTable1()\n    {\n        return $this->hasOne(Table1::className(), ['k1' => 'id']);\n    }\n```\n\nIn model table2 the relationship should be `has-many()`.  The relationship in model table1 is correct.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/yiisoft/yii2/issues/comments/45611931/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"gpoehl","id":5811414,"node_id":"MDQ6VXNlcjU4MTE0MTQ=","avatar_url":"https://avatars.githubusercontent.com/u/5811414?v=4","gravatar_id":"","url":"https://api.github.com/users/gpoehl","html_url":"https://github.com/gpoehl","followers_url":"https://api.github.com/users/gpoehl/followers","following_url":"https://api.github.com/users/gpoehl/following{/other_user}","gists_url":"https://api.github.com/users/gpoehl/gists{/gist_id}","starred_url":"https://api.github.com/users/gpoehl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gpoehl/subscriptions","organizations_url":"https://api.github.com/users/gpoehl/orgs","repos_url":"https://api.github.com/users/gpoehl/repos","events_url":"https://api.github.com/users/gpoehl/events{/privacy}","received_events_url":"https://api.github.com/users/gpoehl/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":129772671,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50MTI5NzcyNjcx","url":"https://api.github.com/repos/yiisoft/yii2/issues/events/129772671","actor":{"login":"samdark","id":47294,"node_id":"MDQ6VXNlcjQ3Mjk0","avatar_url":"https://avatars.githubusercontent.com/u/47294?v=4","gravatar_id":"","url":"https://api.github.com/users/samdark","html_url":"https://github.com/samdark","followers_url":"https://api.github.com/users/samdark/followers","following_url":"https://api.github.com/users/samdark/following{/other_user}","gists_url":"https://api.github.com/users/samdark/gists{/gist