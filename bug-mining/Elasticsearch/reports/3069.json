:false,"description":"Meta label for core/infra team"},{"id":2853288188,"node_id":"MDU6TGFiZWwyODUzMjg4MTg4","url":"https://api.github.com/repos/elastic/elasticsearch/labels/:Core/Infra/Node%20Lifecycle","name":":Core/Infra/Node Lifecycle","color":"0e8a16","default":false,"description":"Node startup, bootstrapping, and shutdown"}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":2,"created_at":"2024-04-24T16:16:22Z","updated_at":"2024-05-03T15:57:21Z","closed_at":"2024-05-03T15:57:21Z","assignee":null,"author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"`PutShutdownNodeAction.Request` is an `AcknowledgedRequest` whose transport-protocol representation therefore should start with the parent task ID followed by the `?masterNodeTimeout` and `?timeout` parameters. However we do not call the superclass `writeTo()` method when serializing it so these fields are omitted, and therefore we end up with the default 30s timeouts (and no parent task ID) on a remote master node.","closed_by":{"login":"thecoop","id":2678694,"node_id":"MDQ6VXNlcjI2Nzg2OTQ=","avatar_url":"https://avatars.githubusercontent.com/u/2678694?v=4","gravatar_id":"","url":"https://api.github.com/users/thecoop","html_url":"https://github.com/thecoop","followers_url":"https://api.github.com/users/thecoop/followers","following_url":"https://api.github.com/users/thecoop/following{/other_user}","gists_url":"https://api.github.com/users/thecoop/gists{/gist_id}","starred_url":"https://api.github.com/users/thecoop/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thecoop/subscriptions","organizations_url":"https://api.github.com/users/thecoop/orgs","repos_url":"https://api.github.com/users/thecoop/repos","events_url":"https://api.github.com/users/thecoop/events{/privacy}","r