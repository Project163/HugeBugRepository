ses_url":"https://api.github.com/repos/yugabyte/yugabyte-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Jira Link: [DB-10188](https://yugabyte.atlassian.net/browse/DB-10188)\r\n### Description\n\nProblem\r\n---\r\n* Found by RQG, reproducible on the latest master (7537e4224f).\r\n* From the test query:\r\n   * The YB default plan returns 2 rows\r\n   * YB returns an empty set with Index Scan disabled.\r\n   * PG15 also returns an empty set with its default plan as well as the plan same as the YB plan returning 2 rows.\r\n\r\nYB:\r\n```\r\npsql test -U yugabyte -h 127.0.0.1 -p 5433 -Ppager=off -Pnull='<null>' -vPROMPT1='YB %/%# '\r\npsql (15.1, server 11.2-YB-2.21.1.0-b0)\r\nType \"help\" for help.\r\n\r\nYB test# SELECT table1.pk FROM CC  AS table1  JOIN ( C  AS table2  JOIN C  AS table3  ON ( table3 .col_varchar_key  >= table2 .col_varchar_key  )  )  ON ( table3 .pk  <= table2 .col_int_key  )  AND ( table3 .pk  > table2 .col_int_key  )  WHERE table1 .col_varchar_key  = table3 .col_varchar_key    ;\r\n\r\n pk\r\n----\r\n 25\r\n 10\r\n(2 rows)\r\n\r\nYB test# /*+ Set(enable_indexscan off) */\r\nSELECT table1.pk FROM CC  AS table1  JOIN ( C  AS table2  JOIN C  AS table3  ON ( table3 .col_varchar_key  >= table2 .col_varchar_key  )  )  ON ( table3 .pk  <= table2 .col_int_key  )  AND ( table3 .pk  > table2 .col_int_key  )  WHERE table1 .col_varchar_key  = table3 .col_varchar_key    ;\r\n\r\n pk\r\n----\r\n(0 rows)\r\n\r\nYB test# EXPLAIN (COSTS OFF)\r\nSELECT table1.pk FROM CC  AS table1  JOIN ( C  AS table2  JOIN C  AS table3  ON ( table3 .col_varchar_key  >= table2 .col_varchar_key  )  )  ON ( table3 .pk  <= table2 .col_int_key  )  AND ( table3 .pk  > table2 .col_int_key  )  WHERE table1 .col_varchar_key  = table3 .col_varchar_key    ;\r\n\r\n                                                                  QUERY PLAN\r\n----------------------------------------------------------------------------------------------------------------------------------------------\r\n Merge Join\r\n   Merge Cond: ((table3.col_varchar_key)::text = (table1.col_varchar_key)::text)\r\n   ->  Nested Loop\r\n         ->  Index Scan using c_varchar_key on c table3\r\n         ->  Index Only Scan using c_varchar_key on c table2\r\n               Index Cond: ((col_varchar_key <= (table3.col_varchar_key)::text) AND (col_int_key >= table3.pk) AND (col_int_key < table3.pk))\r\n   ->  Sort\r\n         Sort Key: table1.col_varchar_key\r\n         ->  Seq Scan on cc table1\r\n(9 rows)\r\n\r\nYB test# EXPLAIN (COSTS OFF)\r\n/*+ Set(enable_indexscan off) */\r\nSELECT table1.pk FROM CC  AS table1  JOIN ( C  AS table2  JOIN C  AS table3  ON ( table3 .col_varchar_key  >= table2 .col_varchar_key  )  )  ON ( table3 .pk  <= table2 .col_int_key  )  AND ( table3 .pk  > table2 .col_int_key  )  WHERE table1 .col_varchar_key  = table3 .col_varchar_key    ;\r\n\r\n\r\n                                                                                 QUERY PLAN\r\n----------------------------------------------------------------------------------------------------------------------------------------------------------------------------\r\n Merge Join\r\n   Merge Cond: ((table1.col_varchar_key)::text = (table3.col_varchar_key)::text)\r\n   ->  Sort\r\n         Sort Key: table1.col_varchar_key\r\n         ->  Seq Scan on cc table1\r\n   ->  Sort\r\n         Sort Key: table3.col_varchar_key\r\n         ->  Nested Loop\r\n               Join Filter: (((table3.col_varchar_key)::text >= (table2.col_varchar_key)::text) AND (table3.pk <= table2.col_int_key) AND (table3.pk > table2.col_int_key))\r\n               ->  Seq Scan on c table2\r\n               ->  Materialize\r\n                     ->  Seq Scan on c table3\r\n(12 rows)\r\n\r\nYB test#\r\n```\r\n\r\nPG15:\r\n```\r\npsql test -U postgres -h 127.0.0.1 -p 5432 -Ppager=off -Pnull='<null>' -vPROMPT1='PG15 %/%# '\r\npsql (15.1)\r\nType \"help\" for help.\r\n\r\nPG15 test# -- the same as the YB plan returning wrong results\r\n/*+ Leading (((table3 table2) table1)) IndexOnlyScan(table2 c_varchar_key) IndexScan(table3 c_varchar_key) MergeJoin(table1 table2 table3) */\r\nSELECT table1.pk FROM CC  AS table1  JOIN ( C  AS table2  JOIN C  AS table3  ON ( table3 .col_varchar_key  >= table2 .col_varchar_key  )  )  ON ( table3 .pk  <= table2 .col_int_key  )  AND ( table3 .pk  > table2 .col_int_key  )  WHERE table1 .col_varchar_key  = table3 .col_varchar_key    ;\r\n\r\n pk\r\n----\r\n(0 rows)\r\n\r\nPG15 test# /*+ Leading (((table3 table2) table1)) IndexOnlyScan(table2 c_varchar_key) IndexScan(table3 c_varchar_key) MergeJoin(table1 table2 table3) */\r\nEXPLAIN (COSTS OFF)\r\nSELECT table1.pk FROM CC  AS table1  JOIN ( C  AS table2  JOIN C  AS table3  ON ( table3 .col_varchar_key  >= table2 .col_varchar_key  )  )  ON ( table3 .pk  <= table2 .col_int_key  )  AND ( table3 .pk  > table2 .col_int_key  )  WHERE table1 .col_varchar_key  = table3 .col_varchar_key    ;\r\n\r\n                                                                  QUERY PLAN\r\n----------------------------------------------------------------------------------------------------------------------------------------------\r\n Merge Join\r\n   Merge Cond: ((table3.col_varchar_key)::text = (table1.col_varchar_key)::text)\r\n   ->  Nested Loop\r\n         ->  Index Scan using c_varchar_key on c table3\r\n         ->  Index Only Scan using c_varchar_key on c table2\r\n               Index Cond: ((col_varchar_key <= (table3.col_varchar_key)::text) AND (col_int_key >= table3.pk) AND (col_int_key < table3.pk))\r\n   ->  Sort\r\n         Sort Key: table1.col_varchar_key\r\n         ->  Seq Scan on cc table1\r\n(9 rows)\r\n\r\nPG15 test# SELECT table1.pk FROM CC  AS table1  JOIN ( C  AS table2  JOIN C  AS table3  ON ( table3 .col_varchar_key  >= table2 .col_varchar_key  )  )  ON ( table3 .pk  <= table2 .col_int_key  )  AND ( table3 .pk  > table2 .col_int_key  )  WHERE table1 .col_varchar_key  = table3 .col_varchar_key    ;\r\n\r\n pk\r\n----\r\n(0 rows)\r\n\r\nPG15 test#\r\n```\r\n\r\nTest Case\r\n---\r\n```\r\nCREATE TABLE c (\r\n    pk integer NOT NULL,\r\n    col_int_key integer,\r\n    col_varchar_key character varying(1),\r\n    PRIMARY KEY(pk ASC)\r\n);\r\n\r\nCREATE TABLE public.cc (\r\n    pk integer NOT NULL,\r\n    col_int_key integer,\r\n    col_varchar_key character varying(1),\r\n    PRIMARY KEY(pk ASC)\r\n);\r\n\r\nCOPY c (pk, col_int_key, col_varchar_key) FROM stdin;\r\n1\t4\tv\r\n2\t62\tv\r\n3\t7\tc\r\n4\t1\t\\N\r\n5\t0\tx\r\n6\t7\ti\r\n7\t7\te\r\n8\t1\tp\r\n9\t7\ts\r\n10\t1\tj\r\n11\t5\tz\r\n12\t2\tc\r\n13\t0\ta\r\n14\t1\tq\r\n15\t8\ty\r\n16\t1\t\\N\r\n17\t1\tr\r\n18\t9\tv\r\n19\t1\t\\N\r\n20\t5\tr\r\n\\.\r\n\r\nCOPY cc (pk, col_int_key, col_varchar_key) FROM stdin;\r\n10\t8\tx\r\n11\t7\td\r\n12\t1\tr\r\n13\t7\tf\r\n14\t9\ty\r\n15\t\\N\tu\r\n16\t1\tm\r\n17\t9\t\\N\r\n18\t2\to\r\n19\t9\tw\r\n20\t2\tm\r\n21\t4\tq\r\n22\t0\t\\N\r\n23\t4\td\r\n24\t8\tg\r\n25\t\\N\tx\r\n26\t\\N\tf\r\n27\t0\tp\r\n28\t\\N\tj\r\n29\t8\tc\r\n\\.\r\n\r\nCREATE INDEX c_varchar_key ON c (col_varchar_key ASC, col_int_key ASC);\r\n\r\n\r\nSELECT table1.pk FROM CC  AS table1  JOIN ( C  AS table2  JOIN C  AS table3  ON ( table3 .col_varchar_key  >= table2 .col_varchar_key  )  )  ON ( table3 .pk  <= table2 .col_int_key  )  AND ( table3 .pk  > table2 .col_int_key  )  WHERE table1 .col_varchar_key  = table3 .col_varchar_key    ;\r\n\r\nEXPLAIN (COSTS OFF)\r\nSELECT table1.pk FROM CC  AS table1  JOIN ( C  AS table2  JOIN C  AS table3  ON ( table3 .col_varchar_key  >= table2 .col_varchar_key  )  )  ON ( table3 .pk  <= table2 .col_int_key  )  AND ( table3 .pk  > table2 .col_int_key  )  WHERE table1 .col_varchar_key  = table3 .col_varchar_key    ;\r\n\r\n\r\n/*+ Set(enable_indexscan off) */\r\nSELECT table1.pk FROM CC  AS table1  JOIN ( C  AS table2  JOIN C  AS table3  ON ( table3 .col_varchar_key  >= table2 .col_varchar_key  )  )  ON ( table3 .pk  <= table2 .col_int_key  )  AND ( table3 .pk  > table2 .col_int_key  )  WHERE table1 .col_varchar_key  = table3 .col_varchar_key    ;\r\n\r\n\r\nEXPLAIN (COSTS OFF)\r\n/*+ Set(enable_indexscan off) */\r\nSELECT table1.pk FROM CC  AS table1  JOIN ( C  AS table2  JOIN C  AS table3  ON ( table3 .col_varchar_key  >= table2 .col_varchar_key  )  )  ON ( table3 .pk  <= table2 .col_int_key  )  AND ( table3 .pk  > table2 .col_int_key  )  WHERE table1 .col_varchar_key  = table3 .col_varchar_key    ;\r\n\r\n```\n\n### Issue Type\n\nkind/bug\n\n### Warning: Please confirm that this issue does not contain any sensitive information\n\n- [X] I confirm this issue does not contain any sensitive information.\n\n[DB-10188]: https://yugabyte.atlassian.net/browse/DB-10188?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZj