ge."},{"id":3272171553,"node_id":"MDU6TGFiZWwzMjcyMTcxNTUz","url":"https://api.github.com/repos/vuejs/core/labels/scope:%20custom%20elements","name":"scope: custom elements","color":"5D6CB9","default":false,"description":""}],"state":"closed","locked":true,"assignees":[],"milestone":null,"comments":0,"created_at":"2021-09-21T10:51:14Z","updated_at":"2023-09-30T00:17:46Z","closed_at":"2022-04-13T09:58:30Z","assignee":null,"author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Version\r\n3.2.12\r\n\r\n### Reproduction link\r\n[github.com](https://github.com/gnuletik/vue-async-ce-slot)\r\n\r\n### Steps to reproduce\r\nCustom elements usage inside index.html\r\n```html\r\n<html>\r\n  <body>\r\n    <my-component>\r\n      <button>Slot content</button>\r\n    </my-component>\r\n    <script type=\"module\" src=\"/src/main.ts\"></script>\r\n  </body>\r\n</html>\r\n```\r\n\r\nMyComponent.ce.vue\r\n```vue\r\n<template>\r\n  <slot><button>Default slot</button></slot>\r\n</template>\r\n```\r\n\r\nmain.ts\r\n```ts\r\nimport { defineCustomElement, defineAsyncComponent } from 'vue'\r\n\r\n// Slot fails\r\ncustomElements.define('my-component', defineCustomElement(\r\n  defineAsyncComponent(() => import('./MyComponent.ce.vue'))\r\n))\r\n\r\n// Slot works when using not async component\r\n/*\r\nimport MyComponent from './MyComponent.ce.vue'\r\n\r\ncustomElements.define('my-component', defineCustomElement(MyComponent))\r\n*/\r\n```\r\n\r\n### What is expected?\r\nThe slot content defined when consuming the custom elements should be rendered (a.k.a \"Slot Content\").\r\n\r\n### What is actually happening?\r\nThe default slot defined in the Vue component is rendered (a.k.a \"Default slot\").\r\n\r\n<!-- generated by vue-issues. DO NOT REMOVE -->","closed_by":{"login":"yyx990803","id":499550,"node_id