lls{/number}","milestones_url":"https://api.github.com/repos/pola-rs/polars/milestones{/number}","notifications_url":"https://api.github.com/repos/pola-rs/polars/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/pola-rs/polars/labels{/name}","releases_url":"https://api.github.com/repos/pola-rs/polars/releases{/id}","deployments_url":"https://api.github.com/repos/pola-rs/polars/deployments","created_at":"2020-05-13T19:45:33Z","updated_at":"2025-12-12T15:37:29Z","pushed_at":"2025-12-12T15:40:22Z","git_url":"git://github.com/pola-rs/polars.git","ssh_url":"git@github.com:pola-rs/polars.git","clone_url":"https://github.com/pola-rs/polars.git","svn_url":"https://github.com/pola-rs/polars","homepage":"https://docs.pola.rs","size":213763,"stargazers_count":36515,"watchers_count":36515,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":true,"has_discussions":false,"forks_count":2510,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":2662,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["arrow","dataframe","dataframe-library","dataframes","out-of-core","polars","python","rust"],"visibility":"public","forks":2510,"open_issues":2662,"watchers":36515,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/pola-rs/polars/pulls/8508","html_url":"https://github.com/pola-rs/polars/pull/8508","diff_url":"https://github.com/pola-rs/polars/pull/8508.diff","patch_url":"https://github.com/pola-rs/polars/pull/8508.patch","merged_at":"2023-04-26T09:40:44Z"},"body":"On conversion from a decimal value to a Python decimal, `impl IntoPy<PyObject> for Wrap<AnyValue<'_>>`, on line 274 of conversion.rs, correctly reverses the sign of scale, to fit the Python Decimal's expected input (Python's Decimal is floating point and expects a signed offset of the point).  `impl ToPyObject for Wrap<&DecimalChunked>` does not, resulting in converted values that are off by a factor of $10^{2\\cdot scale}$ for methods that use that, such as to_list.\r\n\r\nThis fixes the sign, and adds to an existing test to ensure that to_list works properly with decimals.\r\n\r\nFixes #8423.","reactions":{"url":"https://api.github.com/repos/pola-rs/polars/issues/8508/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/pola-rs/polars/issues/8508/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":9101386998,"node_id":"CE_lADOD7gq785kFJfbzwAAAAIefCT2","url":"https://api.github.com/repos/pola-rs/polars/issues/events/9101386998","actor":{"login":"ritchie46","id":3023000,"node_id":"MDQ6VXNlcjMwMjMwMDA=","avatar_url":"https://avatars.githubusercontent.com/u/3023000?v=4","gravatar_id":"","url":"https://api.github.com/users/ritchie46","html_url":"https://github.com/ritchie46","followers_url":"https://api.github.com/users/ritchie46/followers","following_url":"https://api.github.com/users/ritchie46/following{/other_user}","gists_url":"https://api.github.com/users/ritchie46/gists{/gist_id}","starred_url":"https://api.github.com/users/ritchie46/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ritchie46/subscriptions","organizations_url":"https://api.github.com/users/ritchie46/orgs","repos_url":"https://api.github.com/users/ritchie46/repos","events_url":"https://api.github.com/users/ritchie46/events{/privacy}","received_events_url":"https://api.github.com/users/ritchie46/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2023-04-26T09:40:45Z","state_reason":null,"performed_via_github_app"