ists{/gist_id}","starred_url":"https://api.github.com/users/christosts/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/christosts/subscriptions","organizations_url":"https://api.github.com/users/christosts/orgs","repos_url":"https://api.github.com/users/christosts/repos","events_url":"https://api.github.com/users/christosts/events{/privacy}","received_events_url":"https://api.github.com/users/christosts/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"4b1609d569d2a5976b5856432e9b5a37dc483a87","commit_url":"https://api.github.com/repos/google/ExoPlayer/commits/4b1609d569d2a5976b5856432e9b5a37dc483a87","created_at":"2021-08-04T17:48:43Z","performed_via_github_app":null},{"id":5130762226,"node_id":"MDE0OlVubGFiZWxlZEV2ZW50NTEzMDc2MjIyNg==","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/5130762226","actor":{"login":"christosts","id":54315740,"node_id":"MDQ6VXNlcjU0MzE1NzQw","avatar_url":"https://avatars.githubusercontent.com/u/54315740?v=4","gravatar_id":"","url":"https://api.github.com/users/christosts","html_url":"https://github.com/christosts","followers_url":"https://api.github.com/users/christosts/followers","following_url":"https://api.github.com/users/christosts/following{/other_user}","gists_url":"https://api.github.com/users/christosts/gists{/gist_id}","starred_url":"https://api.github.com/users/christosts/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/christosts/subscriptions","organizations_url":"https://api.github.com/users/christosts/orgs","repos_url":"https://api.github.com/users/christosts/repos","events_url":"https://api.github.com/users/christosts/events{/privacy}","received_events_url":"https://api.github.com/users/christosts/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"unlabeled","commit_id":null,"commit_url":null,"created_at":"2021-08-09T16:23:52Z","label":{"name":"needs triage","color":"5ce8b7"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/895366411","html_url":"https://github.com/google/ExoPlayer/issues/9175#issuecomment-895366411","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/9175","id":895366411,"node_id":"IC_kwDOAT2ozs41XjUL","user":{"login":"christosts","id":54315740,"node_id":"MDQ6VXNlcjU0MzE1NzQw","avatar_url":"https://avatars.githubusercontent.com/u/54315740?v=4","gravatar_id":"","url":"https://api.github.com/users/christosts","html_url":"https://github.com/christosts","followers_url":"https://api.github.com/users/christosts/followers","following_url":"https://api.github.com/users/christosts/following{/other_user}","gists_url":"https://api.github.com/users/christosts/gists{/gist_id}","starred_url":"https://api.github.com/users/christosts/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/christosts/subscriptions","organizations_url":"https://api.github.com/users/christosts/orgs","repos_url":"https://api.github.com/users/christosts/repos","events_url":"https://api.github.com/users/christosts/events{/privacy}","received_events_url":"https://api.github.com/users/christosts/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-08-09T16:30:44Z","updated_at":"2021-08-09T16:30:44Z","body":"Thank you for reporting this. \r\n\r\n`PlaybackStats.getMeanAudioFormatBitrate()` returns -1 (=> C.LENGTH_UNSET) because the player cannot derive accurate audio bitrate information from the HLS playlist.\r\n\r\nAccording to the [HLS spec](https://datatracker.ietf.org/doc/html/draft-pantos-hls-rfc8216bis#section-4.4.6.2), bitrate information can be derived from the `BANDWIDTH` attribute of the `EXT-X-STREAM-INF` tag, however in most cases this refers to the aggregate bitrate of a stream and this includes video and audio. This same rule applies when audio and video are either muxed or demuxed (the playlist you provided has audio muxed with video). Considering that video bitrates are typically much higher than audio, the player assumes that `BANDWIDTH` information regards video bitrate and not audio.\r\n\r\nThe player uses the `BANDWIDTH` information for audio-only HLS playlists to derive audio bitrate. However, there was a bug and the audio bitrate was not propagated to PlaybackStats for audio-only HLS playlists. This is fixed in 4b1609d and will be included in the next release, 2.15.0.\r\n\r\nThe link provided for the progressive case: the audio stream has [ICY](https://cast.readme.io/docs/icy) metadata which clearly point to the audio bitrate and the player uses those correctly. ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/895366411/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"christosts","id":54315740,"node_id":"MDQ6VXNlcjU0MzE1NzQw","avatar_url":"https://avatars.githubusercontent.com/u/54315740?v=4","gravatar_id":"","url":"https://api.github.com/users/christosts","html_url":"https://github.com/christosts","followers_url":"https://api.github.com/users/christosts/followers","following_url":"https://api.github.com/users/christosts/following{/other_user}","gists_url":"https://api.github.com/users/christosts/gists{/gist_id}","starred_url":"https://api.github.com/users/christosts/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/christosts/subscriptions","organizations_url":"https://api.github.com/users/christosts/orgs","repos_url":"https://api.github.com/users/christosts/repos","events_url":"https://api.github.com/users/christosts/events{/privacy}","received_events_url":"https://api.github.com/users/christosts/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":5130796979,"node_id":"MDExOkNsb3NlZEV2ZW50NTEzMDc5Njk3OQ==