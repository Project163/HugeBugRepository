thub.com/repos/facebook/react-native-website/downloads","issues_url":"https://api.github.com/repos/facebook/react-native-website/issues{/number}","pulls_url":"https://api.github.com/repos/facebook/react-native-website/pulls{/number}","milestones_url":"https://api.github.com/repos/facebook/react-native-website/milestones{/number}","notifications_url":"https://api.github.com/repos/facebook/react-native-website/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/facebook/react-native-website/labels{/name}","releases_url":"https://api.github.com/repos/facebook/react-native-website/releases{/id}","deployments_url":"https://api.github.com/repos/facebook/react-native-website/deployments","created_at":"2017-10-31T22:34:42Z","updated_at":"2026-03-10T20:19:50Z","pushed_at":"2026-03-10T20:19:36Z","git_url":"git://github.com/facebook/react-native-website.git","ssh_url":"org-69631@github.com:facebook/react-native-website.git","clone_url":"https://github.com/facebook/react-native-website.git","svn_url":"https://github.com/facebook/react-native-website","homepage":"https://reactnative.dev","size":343852,"stargazers_count":2109,"watchers_count":2109,"language":"TypeScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":5888,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":108,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["docusaurus","react","react-native"],"visibility":"public","forks":5888,"open_issues":108,"watchers":2109,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Here:\r\n\r\nhttps://facebook.github.io/react-native/docs/integration-with-existing-apps\r\n\r\nFollowing those steps will lead you to a few errors, which might lead developers to lost a lot of time trying to find solutions for this ! Please update this page ! \r\n\r\nFor example, the section\r\n\r\n`Configuring CocoaPods dependencies`\r\n\r\nOn the Podfile, this part is incorrect \r\n\r\n```\r\npod 'React', :path => '../node_modules/react-native', :subspecs => [\r\n    'Core',\r\n    'CxxBridge', # Include this for RN >= 0.47\r\n    'DevSupport', # Include this to enable In-App Devmenu if RN >= 0.43\r\n    'RCTText',\r\n    'RCTNetwork',\r\n    'RCTWebSocket', # needed for debugging\r\n    # Add any other subspecs you want to use in your project\r\n  ]\r\n```\r\n\r\nIf i create a new react-project using `react-native init MyAwesomeProject` , if I go to the Podfile automatically generated, the Podfile is the correct one, with the correct paths !\r\n\r\nFor example :\r\n```\r\n  pod 'React', :path => '../node_modules/react-native/'\r\n  pod 'React-Core', :path => ../node_modules/react-native/React'\r\n  pod 'React-DevSupport', :path => ../node_modules/react-native/React'\r\n  pod 'React-RCTActionSheet', :path => '../node_modules/react-native/Libraries/ActionSheetIOS'\r\n  pod 'React-RCTAnimation', :path => '../node_modules/react-native/Libraries/NativeAnimation'\r\n  pod 'React-RCTBlob', :path => '../node_modules/react-native/Libraries/Blob'\r\n  pod 'React-RCTImage', :path => '../node_modules/react-native/Libraries/Image'\r\n  pod 'React-RCTLinking', :path => '../node_modules/react-native/Libraries/LinkingIOS'\r\n  pod 'React-RCTNetwork', :path => '../node_modules/react-native/Libraries/Network'\r\n  pod 'React-RCTSettings', :path => '../node_modules/react-native/Libraries/Settings'\r\n  pod 'React-RCTText', :path => '../node_modules/react-native/Libraries/Text'\r\n  pod 'React-RCTVibration', :path => '../node_modules/react-native/Libraries/Vibration'\r\n  pod 'React-RCTWebSocket', :path => '../node_modules/react-native/Libraries/WebSocket'\r\n\r\n  pod 'React-cxxreact', :path => '../node_modules/react-native/ReactCommon/cxxreact'\r\n  pod 'React-jsi', :path => '../node_modules/react-native/ReactCommon/jsi'\r\n  pod 'React-jsiexecutor', :path => '../node_modules/react-native/ReactCommon/jsiexecutor'\r\n  pod 'React-jsinspector', :path => '../node_modules/react-native/ReactCommon/jsinspector'\r\n  pod 'yoga', :path => '../node_modules/react-native/ReactCommon/yoga'\r\n```\r\n\r\nUsing `use_frameworks!` will lead you to an error on compile process, already reported here, \r\n\r\nhttps://github.com/facebook/react-native/issues/26124\r\n\r\nAfter using the right Podfile and by removing the `use_frameworks!` , and call `pod install`, when I tried to `import React` it fails, and the only way I found to make this working, was by creating a `Bridging-Header-h` file .... \r\n\r\n \r\n","reactions":{"url":"https://api.github.com/repos/facebook/react-native-website/issues/1194/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/facebook/react-native-website/issues/1194/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/facebook/react-native/issues/comments/526202985","html_url":"https://github.com/facebook/react-native/issues/26124#issuecomment-526202985","issue_url":"https://api.github.com/repos/facebook/react-native/issues/26124","id":526202985,"node_id":"MDEyOklzc3VlQ29tbWVudDUyNjIwMjk4NQ==","user":{"login":"edgarclerigo","id":559619,"node_id":"MDQ6VXNlcjU1OTYxOQ==","avatar_url":"https://avatars.githubusercontent.com/u/559619?v=4","gravatar_id":"","url":"https://api.github.com/users/edgarclerigo","html_url":"https://github.com/edgarclerigo","followers_url":"https://api.github.com/users/edgarclerigo/followers","following_url":"https://api.github.com/users/edgarclerigo/following{/other_user}","gists_url