ralphiech/followers","following_url":"https://api.github.com/users/ralphiech/following{/other_user}","gists_url":"https://api.github.com/users/ralphiech/gists{/gist_id}","starred_url":"https://api.github.com/users/ralphiech/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ralphiech/subscriptions","organizations_url":"https://api.github.com/users/ralphiech/orgs","repos_url":"https://api.github.com/users/ralphiech/repos","events_url":"https://api.github.com/users/ralphiech/events{/privacy}","received_events_url":"https://api.github.com/users/ralphiech/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2018-01-18T09:40:50Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/Seldaek/monolog/issues/comments/358902030","html_url":"https://github.com/Seldaek/monolog/issues/1096#issuecomment-358902030","issue_url":"https://api.github.com/repos/Seldaek/monolog/issues/1096","id":358902030,"node_id":"MDEyOklzc3VlQ29tbWVudDM1ODkwMjAzMA==","user":{"login":"hinrik","id":43533,"node_id":"MDQ6VXNlcjQzNTMz","avatar_url":"https://avatars.githubusercontent.com/u/43533?v=4","gravatar_id":"","url":"https://api.github.com/users/hinrik","html_url":"https://github.com/hinrik","followers_url":"https://api.github.com/users/hinrik/followers","following_url":"https://api.github.com/users/hinrik/following{/other_user}","gists_url":"https://api.github.com/users/hinrik/gists{/gist_id}","starred_url":"https://api.github.com/users/hinrik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hinrik/subscriptions","organizations_url":"https://api.github.com/users/hinrik/orgs","repos_url":"https://api.github.com/users/hinrik/repos","events_url":"https://api.github.com/users/hinrik/events{/privacy}","received_events_url":"https://api.github.com/users/hinrik/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-01-19T08:44:17Z","updated_at":"2018-01-19T08:54:57Z","body":"Actually, after considering other projects where we use Monolog, this patch would be too limiting for us. There are cases where we want to return a response code of `200` even when an exception has been raised, but since the upstream code immediately calls `exit(255)`, that's not something we can easily work around (e.g. with a subclass).\r\n\r\nWe'd have to manually set the response code and send output to the client sometime before any exception would be raised. The patch also wouldn't play well with PHP setups that have `display_errors` enabled.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/Seldaek/monolog/issues/comments/358902030/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"hinrik","id":43533,"node_id":"MDQ6VXNlcjQzNTMz","avatar_url":"https://avatars.githubusercontent.com/u/43533?v=4","gravatar_id":"","url":"https://api.github.com/users/hinrik","html_url":"https://github.com/hinrik","followers_url":"https://api.github.com/users/hinrik/followers","following_url":"https://api.github.com/users/hinrik/following{/other_user}","gists_url":"https://api.github.com/users/hinrik/gists{/gist_id}","starred_url":"https://api.github.com/users/hinrik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hinrik/subscriptions","organizations_url":"https://api.github.com/users/hinrik/orgs","repos_url":"https://api.github.com/users/hinrik/repos","events_url":"https://api.github.com/users/hinrik/events{/privacy}","received_events_url":"https://api.github.com/users/hinrik/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/Seldaek/monolog/issues/comments/358908614","html_url":"https://github.com/Seldaek/monolog/issues/1096#issuecomment-358908614","issue_url":"htt