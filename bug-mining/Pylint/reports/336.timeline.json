_user}","gists_url":"https://api.github.com/users/PCManticore/gists{/gist_id}","starred_url":"https://api.github.com/users/PCManticore/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PCManticore/subscriptions","organizations_url":"https://api.github.com/users/PCManticore/orgs","repos_url":"https://api.github.com/users/PCManticore/repos","events_url":"https://api.github.com/users/PCManticore/events{/privacy}","received_events_url":"https://api.github.com/users/PCManticore/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-11-06T17:29:02Z","updated_at":"2019-11-06T17:29:02Z","body":"Thanks for the report. This particular check skips functions that don't return as long as they are \"abstract\", and by abstract it expects to be either marked with `abc.abstractmethod` or either raises a `NotImplementedError`. From a quick look, it seems `NotImplementedError` would fit more nicely with this function, which would also silence the linter in complaining.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/pylint-dev/pylint/issues/comments/550416007/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"PCManticore","id":448166,"node_id":"MDQ6VXNlcjQ0ODE2Ng==","avatar_url":"https://avatars.githubusercontent.com/u/448166?v=4","gravatar_id":"","url":"https://api.github.com/users/PCManticore","html_url":"https://github.com/PCManticore","followers_url":"https://api.github.com/users/PCManticore/followers","following_url":"https://api.github.com/users/PCManticore/following{/other_user}","gists_url":"https://api.github.com/users/PCManticore/gists{/gist_id}","starred_url":"https://api.github.com/users/PCManticore/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PCManticore/subscriptions","organizations_url":"https://api.github.com/users/PCManticore/orgs","repos_url":"https://api.github.com/users/PCManticore/repos","events_url":"https://api.github.com/users/PCManticore/events{/privacy}","received_events_url":"https://api.github.com/users/PCManticore/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":2776217608,"node_id":"MDExOkNsb3NlZEV2ZW50Mjc3NjIxNzYwOA==","url":"https://api.github.com/repos/pylint-dev/pylint/issues/events/2776217608","actor":{"login":"PCManticore","id":448166,"node_id":"MDQ6VXNlcjQ0ODE2Ng==","avatar_url":"https://avatars.githubusercontent.com/u/448166?v=4","gravatar_id":"","url":"https://api.github.com/users/PCManticore","html_url":"https://github.com/PCManticore","followers_url":"https://api.github.com/users/PCManticore/followers","following_url":"https://api.github.com/users/PCManticore/following{/other_user}","gists_url":"https://api.github.com/users/PCManticore/gists{/gist_id}","starred_url":"https://api.github.com/users/PCManticore/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PCManticore/subscriptions","organizations_url":"https://api.github.com/users/PCManticore/orgs","repos_url":"https://api.github.com/users/PCManticore/repos","events_url":"https://api.github.com/users/PCManticore/events{/privacy}","received_events_url":"https://api.github.com/users/PCManticore/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2019-11-06T17:29:02Z","state_reason":null,"performed_via_github_app":null},{"url":"https://api.github.com/repos/pylint-dev/pylint/issues/comments/550892637","html_url":"https://github.com/pylint-dev/pylint/issues/3218#issuecomment-550892637","issue_url":"https://api.github.com/repos/pylint-dev/pylint/issues/3218","id":550892637,"node_id":"MDEyOklzc3VlQ29tbWVudDU1MDg5MjYzNw==","user":{"login":"ronf","id":1901085,"node_id":"MDQ6VXNlcjE5MDEwODU=","avatar_url":"https://avatars.githubusercontent.com/u/1901085?v=4","gravatar_id":"","url":"https://api.github.com/users/ronf","html_url":"https://github.com/ronf","followers_url":"https://api.github.com/users/ronf/followers","following_url":"https://api.github.com/users/ronf/following{/other_user}","gists_url":"https://api.github.com/users/ronf/gists{/gist_id}","starred_url":"https://api.github.com/users/ronf/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ronf/subscriptions","organizations_url":"https://api.github.com/users/ronf/orgs","repos_url":"https://api.github.com/users/ronf/repos","events_url":"https://api.github.com/users/ronf/events{/privacy}","received_events_url":"https://api.github.com/users/ronf/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-11-07T06:35:41Z","updated_at":"2019-11-07T06:35:41Z","body":"In the real code, these methods are doing format conversions for keys into different formats, and I have a custom KeyExportError exception (currently derived from ValueError) that I raise when you ask for a conversion into a format a particular key type doesn't support. While I could catch and re-raise a NotImplementedError as a KeyExportError in the calling code, that's kind of ugly.\r\n\r\nMore generally, I can see this pattern applying in scenarios where the error isn't due to the method being abstract. As long as code being called in the assignment never returns without providing a value or triggering an exception, it seems to me this warning shouldn't fire. It would only be a plain \"return\" or falling off the end of a function without a \"return\" that I would expect to trigger this.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/pylint-dev/pylint/issues/comments/550892637/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ronf","id":1901085,"node_id":"MDQ6VXNlcjE5MDEwODU=","avatar_url":"https