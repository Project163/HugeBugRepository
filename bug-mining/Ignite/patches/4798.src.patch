+
+            ctx.metric().registry("test");
+        });
+
+        // Waiting for creation to start.
+        addStarted.await();
+
+        Thread.sleep(100);
+
+        // Complete removal.
+        rmvCompleted.countDown();
+
+        rmvFut.get(getTestTimeout());
