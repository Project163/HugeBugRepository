.github.com/users/alteredq","html_url":"https://github.com/alteredq","followers_url":"https://api.github.com/users/alteredq/followers","following_url":"https://api.github.com/users/alteredq/following{/other_user}","gists_url":"https://api.github.com/users/alteredq/gists{/gist_id}","starred_url":"https://api.github.com/users/alteredq/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alteredq/subscriptions","organizations_url":"https://api.github.com/users/alteredq/orgs","repos_url":"https://api.github.com/users/alteredq/repos","events_url":"https://api.github.com/users/alteredq/events{/privacy}","received_events_url":"https://api.github.com/users/alteredq/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2012-11-15T12:51:35Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/mrdoob/three.js/issues/comments/10407769","html_url":"https://github.com/mrdoob/three.js/issues/2633#issuecomment-10407769","issue_url":"https://api.github.com/repos/mrdoob/three.js/issues/2633","id":10407769,"node_id":"MDEyOklzc3VlQ29tbWVudDEwNDA3NzY5","user":{"login":"mrdoob","id":97088,"node_id":"MDQ6VXNlcjk3MDg4","avatar_url":"https://avatars.githubusercontent.com/u/97088?v=4","gravatar_id":"","url":"https://api.github.com/users/mrdoob","html_url":"https://github.com/mrdoob","followers_url":"https://api.github.com/users/mrdoob/followers","following_url":"https://api.github.com/users/mrdoob/following{/other_user}","gists_url":"https://api.github.com/users/mrdoob/gists{/gist_id}","starred_url":"https://api.github.com/users/mrdoob/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrdoob/subscriptions","organizations_url":"https://api.github.com/users/mrdoob/orgs","repos_url":"https://api.github.com/users/mrdoob/repos","events_url":"https://api.github.com/users/mrdoob/events{/privacy}","received_events_url":"https://api.github.com/users/mrdoob/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2012-11-15T13:03:19Z","updated_at":"2012-11-15T13:03:19Z","body":"Seems like it has something to do with the material. That example uses this material:\n\n``` javascript\nvar material = new THREE.MeshPhongMaterial( { ambient: 0x552811, color: 0x552811, specular: 0x333333, shininess: 25, bumpMap: mapHeight, bumpScale: 19, metal: false } );\n```\n\nIf we replace it with a `MeshBasicMaterial` it works fine but `MeshLambertMaterial` and `MeshPhongMaterial` throw those errors.\n","author_association":"OWNER","reactions":{"url":"https://api.github.com/repos/mrdoob/three.js/issues/comments/10407769/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"mrdoob","id":97088,"node_id":"MDQ6VXNlcjk3MDg4","avatar_url":"https://avatars.githubusercontent.com/u/97088?v=4","gravatar_id":"","url":"https://api.github.com/users/mrdoob","html_url":"https://github.com/mrdoob","followers_url":"https://api.github.com/users/mrdoob/followers","following_url":"https://api.github.com/users/mrdoob/following{/other_user}","gists_url":"https://api.github.com/users/mrdoob/gists{/gist_id}","starred_url":"https://api.github.com/users/mrdoob/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrdoob/subscriptions","organizations_url":"https://api.github.com/users/mrdoob/orgs","repos_url":"https://api.github.com/users/mrdoob/repos","events_url":"https://api.github.com/users/mrdoob/events{/privacy}","received_events_url":"https://api.github.com/users/mrdoob/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/mrdoob/three.js/issues/comments/10409314","html_url":"https://github.com/mrdoob/three.js/issues/2633#issuecomment-10409314","issue_url":"https://api.github.com/repos/mrdoob/three.js/issues/2633","id":10409314,"node_id":"MDEyOklzc3VlQ29tbWVudDEwNDA5MzE0","user":{"login":"MKHenson","id":2727104,"node_id":"MDQ6VXNlcjI3MjcxMDQ=","avatar_url":"https://avatars.githubusercontent.com/u/2727104?v=4","gravatar_id":"","url":"https://api.github.com/users/MKHenson","html_url":"https://github.com/MKHenson","followers_url":"https://api.github.com/users/MKHenson/followers","following_url":"https://api.github.com/users/MKHenson/following{/other_user}","gists_url":"https://api.github.com/users/MKHenson/gists{/gist_id}","starred_url":"https://api.github.com/users/MKHenson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MKHenson/subscriptions","organizations_url":"https://api.github.com/users/MKHenson/orgs","repos_url":"https://api.github.com/users/MKHenson/repos","events_url":"https://api.github.com/users/MKHenson/events{/privacy}","received_events_url":"https://api.github.com/users/MKHenson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2012-11-15T14:03:34Z","updated_at":"2012-11-15T14:04:05Z","body":"Something that may or may not be related to this... In my app, when I load in the js or obj files and apply a phong material to both at some later point in time. The material is applied, however if I then update the material with a diffuse texture and update the meshes (so basically call the \n\n```\nobject.geometry.buffersNeedUpdate = true;\nobject.geometry.uvsNeedUpdate = true;\n```\n\nfunctions on each of them ) - the js model will update with the texture, but the obj model won't and will actually throw a series of errors. But as soon as I remove the texture things go back to normal. \n\nPerhaps there is something going wrong in the loading process or the creation of the meshes and/or their materials? \n\nLike with above, I get different behaviour when using the deallocateObject. When I remove the js mesh using deallocateObject the webgl errors are thrown, but when I remove the obj object no errors are thrown. \n\nAgain I'm not sure if its related... but it seems like these errors are happening based on which file is being loaded.\n\nThanks guys :)\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/mrdoob/three.js/issues/comments/10409314/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"MKHenson","id":2727104,"node_id":"MDQ6VXNlcjI3MjcxMDQ=","avatar_url":"https://avatars.githubusercontent.com/u/2727104?v=4","gravatar_id":"","url":"https://api.github.com/users/MKHenson","html_url":"https://github.com/MKHenson","followers_url":"https://api.github.com/users/MKHenson/followers","following_url":"https://api.github.com/users/MKHenson/following{/other_user}","gists_url":"https://api.github.com/users/MKHenson/gists{/gist_id}","starred_url":"https://api.github.com/users/MKHenson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MKHenson/subscriptions","organizations_url":"https://api.github.com/users/MKHenson/orgs","repos_url":"https://api.github.com/users/MKHenson/repos","events_url":"https://api.github.com/users/MKHenson/events{/privacy}","received_events_url":"https://api.github.com/users/MKHenson/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/mrdoob/three.js/issues/comments/10410057","html_url":"https://github.com/mrdoob/three.js/issues/2633#issuecomment-10410057","issue_url":"https://api.github.com/repos/mrdoob/three.js/issues/2633","id":10410057,"node_id":"MDEyOklzc3VlQ29tbWVudDEwNDEwMDU3","user":{"login":"alteredq","id":438022,"node_id":"MDQ6VXNlcjQzODAyMg==","avatar_url":"https://avatars.githubusercontent.com/u/438022?v=4","gravatar_id":"","url":"https://api.github.com/users/alteredq","html_url":"https://github.com/alteredq","followers_url":"https://api.github.com/users/alteredq/followers","following_url":"https://api.github.com/users/alteredq/following{/other_user}","gists_url":"https://api.github.com/users/alteredq/gists{/gist_id}","starred_url":"https://api.github.com/users/alteredq/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alteredq/subscriptions","organizations_url":"https://api.github.com/users/alteredq/orgs","repos_url":"https://api.github.com/users/alteredq/repos","events_url":"https://api.github.com/users/alteredq/events{/privacy}","received_events_url":"https://api.github.com/users/alteredq/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2012-11-15T14:28:25Z","updated_at":"2012-11-15T14:28:25Z","body":"Hmmm, after some poking around, I think I know what it is, not yet sure how to best solve this.\n\nIt's something that kept me puzzled for a long time. Unlike other WebGL libs, we don't disable attributes after each drawcall. This was somehow magically working and reduced number of GL API calls.\n\nNow after seeing these errors, I believe what could be going on in the \"magic\" part is that attribute buffers from other objects stayed enabled all the time and filled in missing parts if needed (because before GL objects were never deleted, so even if we removed things from scene graph and they weren't rendered, they could be still available to GL state).\n\nIf you use the same type of material for plane as for JSON object (meaning they would both use the same buffers), errors will not happen.\n\nI'll need to investigate more. \n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/mrdoob/three.js/issues/comments/10410057/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"alteredq","id":438022,"node_id":"MDQ6VXNlcjQzODAyMg==","avatar_url":"https://avatars.githubusercontent.com/u/438022?v=4","gravatar_id":"","url":"https://api.github.com/users/alteredq","h