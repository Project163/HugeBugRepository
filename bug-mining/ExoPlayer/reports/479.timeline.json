hub.com/users/Leeyoungryun/followers","following_url":"https://api.github.com/users/Leeyoungryun/following{/other_user}","gists_url":"https://api.github.com/users/Leeyoungryun/gists{/gist_id}","starred_url":"https://api.github.com/users/Leeyoungryun/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Leeyoungryun/subscriptions","organizations_url":"https://api.github.com/users/Leeyoungryun/orgs","repos_url":"https://api.github.com/users/Leeyoungryun/repos","events_url":"https://api.github.com/users/Leeyoungryun/events{/privacy}","received_events_url":"https://api.github.com/users/Leeyoungryun/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-04-30T06:50:46Z","updated_at":"2019-04-30T06:55:42Z","body":"I investigated some codes.\r\n\r\nIn HlsChunkSource\r\n\r\n\"\r\nif (chunkMediaSequence < mediaPlaylist.mediaSequence) {\r\n      if (previous != null && switchingVariant) {\r\n        // We try getting the next chunk without adapting in case that's the reason for falling\r\n        // behind the live window.\r\n        selectedVariantIndex = oldVariantIndex;\r\n        selectedUrl = variants[selectedVariantIndex];\r\n        mediaPlaylist = playlistTracker.getPlaylistSnapshot(selectedUrl);\r\n        startOfPlaylistInPeriodUs =\r\n            mediaPlaylist.startTimeUs - playlistTracker.getInitialStartTimeUs();\r\n        chunkMediaSequence = previous.getNextChunkIndex();\r\n      } else {\r\n        fatalError = new BehindLiveWindowException();\r\n        return;\r\n      }\r\n    }\r\nint chunkIndex = (int) (chunkMediaSequence - mediaPlaylist.mediaSequence);\r\n\"\r\n\r\nI have a few questions about that code.\r\n\r\n1. Do you consider if previous is not null and switchingVariant is true, chunkMediaSequence is under than  mediaPlaylist.mediaSequence?\r\n I saw many safe guard(queue is null then switchingVariant is almost false) for sinking with chunks, but upper codition often breaks out.\r\n\r\n2. I think, \"switchingVariant is true\" means \"Threre are some changes about track\"  \r\nis that right?\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/487837976/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Leeyoungryun","id":13132019,"node_id":"MDQ6VXNlcjEzMTMyMDE5","avatar_url":"https://avatars.githubusercontent.com/u/13132019?v=4","gravatar_id":"","url":"https://api.github.com/users/Leeyoungryun","html_url":"https://github.com/Leeyoungryun","followers_url":"https://api.github.com/users/Leeyoungryun/followers","following_url":"https://api.github.com/users/Leeyoungryun/following{/other_user}","gists_url":"https://api.github.com/users/Leeyoungryun/gists{/gist_id}","starred_url":"https://api.github.com/users/Leeyoungryun/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Leeyoungryun/subscriptions","organizations_url":"https://api.github.com/users/Leeyoungryun/orgs","repos_url":"https://api.github.com/users/Leeyoungryun/repos","events_url":"https://api.github.com/users/Leeyoungryun/events{/privacy}","received_events_url":"https://api.github.com/users/Leeyoungryun/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":2308988057,"node_id":"MDEzOkFzc2lnbmVkRXZlbnQyMzA4OTg4MDU3","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/2308988057","actor":{"login":"AquilesCanta","id":8539544,"node_id":"MDQ6VXNlcjg1Mzk1NDQ=","avatar_url":"https://avatars.githubusercontent.com/u/8539544?v=4","gravatar_id":"","url":"https://api.github.com/users/AquilesCanta","html_url":"https://github.com/AquilesCanta","followers_url":"https://api.github.com/users/AquilesCanta/followers","following_url":"https://api.github.com/users/AquilesCanta/following{/other_user}","gists_url":"https://api.github.com/users/AquilesCanta/gists{/gist_i