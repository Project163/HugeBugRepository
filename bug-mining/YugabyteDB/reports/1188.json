sers/d-uspenskiy/gists{/gist_id}","starred_url":"https://api.github.com/users/d-uspenskiy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/d-uspenskiy/subscriptions","organizations_url":"https://api.github.com/users/d-uspenskiy/orgs","repos_url":"https://api.github.com/users/d-uspenskiy/repos","events_url":"https://api.github.com/users/d-uspenskiy/events{/privacy}","received_events_url":"https://api.github.com/users/d-uspenskiy/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2024-08-05T11:39:10Z","updated_at":"2024-08-16T09:45:30Z","closed_at":"2024-08-16T09:45:30Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Jira Link: [DB-12317](https://yugabyte.atlassian.net/browse/DB-12317)\r\n### Description\n\nThe `PrecastRequestSender` class is intended to send read requests to different tables in single Perform RPC. This allows to parallel executions of read operations and reduces the number of RPC round trips.\r\nBut in spite of the fact `PrecastRequestSender` sends single RPC for reads from multiple tables the `Storage Read Requests` metric of `EXPLAIN` statement is incremented for each table individually.\r\n\r\nI.e. in case `PrecastRequestSender` sends single RPC request to read from `t1`, `t2` and `t3` the `Storage Read Requests` will be incremented by 3 instead of 1. This contradicts with the meaning of `Storage Read Requests` metric\r\n\r\nQuote from YB doc for `EXPLAIN` command (https://docs.yugabyte.com/preview/explore/query-1-performance/explain-analyze/)\r\n\r\n```\r\nStorage Table Read Requests: Number of RPC round-trips made to the local [YB-TServer](https://docs.yugabyte.com/preview/architecture/yb-tserver) for main table scans.\r\n...\r\nStorage Read Requests: The sum of number of table reads and index reads across all plan nodes.\r\n```\n\n### Issue Type\n\nkind/bug\n\n### Warning: Please confirm that this issue does not contain any sensitive information\n\n- [X] I confirm this issue does not contain any sensitive information.\n\n[DB-12317]: https://yugabyte.atlassian.net/browse/DB-12317?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","closed_by":{"login":"d-uspenskiy","id":47734295,"node_id":"MDQ6VXNlcjQ3NzM0Mjk1","avatar_url":"https://avatars.githubusercontent.com/u/47734295?v=4","gravatar_id":"","url":"https://api.github.com/users/d-uspenskiy","html_url":"https://github.com/d-uspenskiy","followers_url":"https://api.github.com/users/d-uspenskiy/followers","following_url":"https://api.github.com/users/d-uspenskiy/following{/other_user}","gists_url":"https://api.github.com/users/d-uspenskiy/gists{/gist_id}","starred_url":"https://api.github.com/users/d-uspenskiy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/d-uspenskiy/subscriptions","organizations_url":"https://api.github.com/users/d-uspenskiy/orgs","repos_url":"https://api.github.com/users/d-uspenskiy/repos","events_url":"https://api.github.com/users/d-uspenskiy/events{/privacy}","received_events_url":"https://api.github.com/users/d-uspenskiy/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/23396/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/23396/timeline","performed_via_github_app":null,"state_reason":"completed"}