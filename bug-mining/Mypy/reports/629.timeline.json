chive_format}{/ref}","downloads_url":"https://api.github.com/repos/python/mypy/downloads","issues_url":"https://api.github.com/repos/python/mypy/issues{/number}","pulls_url":"https://api.github.com/repos/python/mypy/pulls{/number}","milestones_url":"https://api.github.com/repos/python/mypy/milestones{/number}","notifications_url":"https://api.github.com/repos/python/mypy/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/python/mypy/labels{/name}","releases_url":"https://api.github.com/repos/python/mypy/releases{/id}","deployments_url":"https://api.github.com/repos/python/mypy/deployments","created_at":"2012-12-07T13:30:23Z","updated_at":"2025-12-12T11:48:01Z","pushed_at":"2025-12-11T20:11:30Z","git_url":"git://github.com/python/mypy.git","ssh_url":"git@github.com:python/mypy.git","clone_url":"https://github.com/python/mypy.git","svn_url":"https://github.com/python/mypy","homepage":"https://www.mypy-lang.org/","size":77161,"stargazers_count":20064,"watchers_count":20064,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":3065,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":3124,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["linter","python","typechecker","types","typing"],"visibility":"public","forks":3065,"open_issues":3124,"watchers":20064,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Following #7188, we can now have:\r\n```python\r\nfrom typing import overload\r\nfrom typing_extensions import Literal\r\n\r\n\r\nclass Cat:\r\n    @overload\r\n    def __new__(cls, name: Literal['Tabby']) -> 'Tabby': ...\r\n    @overload\r\n    def __new__(cls, name: Literal['Kitty']) -> 'Kitty': ...\r\n\r\n    def __new__(cls, name: str) -> 'Cat': ...\r\n\r\nclass Kitty(Cat):\r\n    pass\r\n\r\nclass Tabby(Cat):\r\n    pass\r\n\r\n\r\nreveal_type(Cat('Kitty'))\r\nreveal_type(Cat('Tabby'))\r\n```\r\nresult in:\r\n```\r\nRevealed type is 'test.Kitty'\r\nRevealed type is 'test.Tabby'\r\n```\r\n(Meant as a trivial example.)\r\n\r\nHowever, this doesn't extend to derived classes:\r\n```python\r\nreveal_type(Tabby('Kitty'))\r\nreveal_type(Tabby('Tabby'))\r\n```\r\nwould result in:\r\n```\r\nRevealed type is 'test.Tabby'\r\nRevealed type is 'test.Tabby'\r\n```\r\n \r\nI'm using mypy 0.761.","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/8330/reactions","total_count":8,"+1":8,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/mypy/issues/8330/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"}]