diff --git a/src/Psalm/Visitor/NodeCleanerVisitor.php b/src/Psalm/Visitor/NodeCleanerVisitor.php
new file mode 100644
index 000000000..c0162dfa0
--- /dev/null
+++ b/src/Psalm/Visitor/NodeCleanerVisitor.php
@@ -0,0 +1,21 @@
+<?php
+namespace Psalm\Visitor;
+
+use PhpParser;
+use Psalm\Checker\Statements\ExpressionChecker;
+
+class NodeCleanerVisitor extends PhpParser\NodeVisitorAbstract implements PhpParser\NodeVisitor
+{
+    /**
+     * @param  PhpParser\Node $node
+     *
+     * @return null|int
+     */
+    public function enterNode(PhpParser\Node $node)
+    {
+        /** @psalm-suppress NoInterfaceProperties */
+        unset($node->inferredType, $node->assertions);
+
+        return null;
+    }
+}
