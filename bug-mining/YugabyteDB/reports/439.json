ode_id":"MDU6TGFiZWwxMzUzOTA3MDA0","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/priority/high","name":"priority/high","color":"ffdc5e","default":false,"description":"High Priority"}],"state":"closed","locked":false,"assignee":{"login":"mbautin","id":552936,"node_id":"MDQ6VXNlcjU1MjkzNg==","avatar_url":"https://avatars.githubusercontent.com/u/552936?v=4","gravatar_id":"","url":"https://api.github.com/users/mbautin","html_url":"https://github.com/mbautin","followers_url":"https://api.github.com/users/mbautin/followers","following_url":"https://api.github.com/users/mbautin/following{/other_user}","gists_url":"https://api.github.com/users/mbautin/gists{/gist_id}","starred_url":"https://api.github.com/users/mbautin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mbautin/subscriptions","organizations_url":"https://api.github.com/users/mbautin/orgs","repos_url":"https://api.github.com/users/mbautin/repos","events_url":"https://api.github.com/users/mbautin/events{/privacy}","received_events_url":"https://api.github.com/users/mbautin/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"mbautin","id":552936,"node_id":"MDQ6VXNlcjU1MjkzNg==","avatar_url":"https://avatars.githubusercontent.com/u/552936?v=4","gravatar_id":"","url":"https://api.github.com/users/mbautin","html_url":"https://github.com/mbautin","followers_url":"https://api.github.com/users/mbautin/followers","following_url":"https://api.github.com/users/mbautin/following{/other_user}","gists_url":"https://api.github.com/users/mbautin/gists{/gist_id}","starred_url":"https://api.github.com/users/mbautin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mbautin/subscriptions","organizations_url":"https://api.github.com/users/mbautin/orgs","repos_url":"https://api.github.com/users/mbautin/repos","events_url":"https://api.github.com/users/mbautin/events{/privacy}","received_events_url":"https://api.github.com/users/mbautin/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2020-08-05T00:04:58Z","updated_at":"2020-08-13T17:56:22Z","closed_at":"2020-08-13T17:56:22Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"In 023c20ad6caf13e5228081ddec07d9f3cf904348 a \"restart-safe monotonic timestamp\" was introduced into WAL records to help with making sure that we retain enough logs to detect and reject retries that have already been processed. This timestamp might not be present in old WAL entries. In e4e2d398864360e498dd0f6a61178c2a4f9903cd a DCHECK checking for this was replaced with an SCHECK, leading to tablet bootstrap failures on old clusters that still have very old entries in master WALs.\r\n(BTW we should ensure we flush sstables at least once in a while to avoid these kind of very old WAL entries from showing up in the future.)\r\n\r\nStack trace:\r\n\r\n```\r\nF20200804 23:28:02 ../../src/yb/master/master_main.cc:120] Corruption (yb/tablet/tablet_bootstrap.cc:801): Unable to initialize catalog manager: Failed to initialize sys tables async: Failed log replay. Reason: Debug Info: Error playing entry 0 of segment 1 of tablet 00000000000000000000000000000000. Segment path: /mnt/d0/yb-data/master/wals/table-sys.catalog.uuid/tablet-00000000000000000000000000000000/wal-000000001. Entry: type: REPLICATE replicate { id { term: 1 index: 1 } hybrid_time: 6290421128457375744 op_type: NO_OP committed_op_id { term: 0 index: 0 } noop_request { } }: Entry metadata must have a restart-safe time: 0 vs. 1\r\n\r\n    @     0x7f0d140f777c  yb::LogFatalHandlerSink::send()\r\n\r\n    @     0x7f0d132de346  google::LogMessage::SendToLog()\r\n\r\n    @     0x7f0d132db7aa  google::LogMessage::Flush()\r\n\r\n    @     0x7f0d132de879  google::LogMessageFatal::~LogMessageFatal()\r\n\r\n    @           0x409074  yb::master::MasterMain()\r\n\r\n    @     0x7f0d0ef3d825  __libc_start_main\r\n\r\n    @           0x408429  _start\r\n\r\n    @              (nil)  (unknown)\r\n\r\n```\n","closed_by":{"login":"mbautin","id":552936,"node_id":"MDQ6VXNlcjU1MjkzNg==","avatar_url":"https://avatars.githubusercontent.com/u/552936?v=4","gravatar_id":"","url":"https://api.github.com/users/mbautin","html_url":"https://github.com/mbautin","followers_url":"https://api.github.com/users/mbautin/followers","following_url":"https://api.github.com/users/mbautin/following{/other_user}","gists_url":"https://api.github.com/users/mbautin/gists{/gist_id}","starred_url":"https://api.github.com/users/mbautin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mbautin/subscriptions","organizations_url":"https://api.github.com/users/mbautin/orgs","repos_url":"https://api.github.com/users/mbautin/repos","events_url":"https://api.github.com/users/mbautin/events{/privacy}","received_events_url":"https://api.github.com/users/mbautin/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/5314/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/5314/timeline","performed_via_github_app":null,"state_reason":"completed"}