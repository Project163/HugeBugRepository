_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"https://getpsalm.org/r/f3122cd4ba\r\n```php\r\n<?php\r\n  class B {\r\n     public function __call(string $methodName, array $args): string {\r\n       return __METHOD__;\r\n     }\r\n  }\r\n  class A {\r\n     /** @return B */\r\n     public function __call(string $methodName, array $args) {\r\n       return new B;\r\n     }\r\n  }\r\n  strlen((new A)->zugzug()); // expected: argument of strlen cannot be B, actual: ... cannot be mixed\r\n  strlen((new A)->bar()->baz()); // expected: no errors, actual: ... cannot be mixed\r\n```\r\n39870f97c46b85e88f3ea82703bbe298ba904aa7 has not fixed this.\r\n\r\nReal-world example: https://github.com/phpspec/prophecy/blob/master/src/Prophecy/Prophecy/ObjectProphecy.php#L238\r\n\r\nI understand this may conflict with `@method` annotations, but it would be useful to use `@return` at least when there's no `@method`s present.","closed_by":{"login":"muglug","id":2292638,"node_id":"MDQ6VXNlcjIyOTI2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/2292638?v=4","gravatar_id":"","url":"https://api.github.com/users/muglug","html_url":"https://github.com/muglug","followers_url":"https://api.github.com/users/muglug/followers","following_url":"https://api.github.com/users/muglug/following{/other_user}","gists_url":"https://api.github.com/users/muglug/gists{/gist_id}","starred_url":"https://api.github.com/users/muglug/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/muglug/subscriptions","organizations_url":"https://api.github.com/users/muglug/orgs","repos_url":"https://api.github.com/users/muglug/repos","events_url":"https://api.github.com/users/muglug/events{/privacy}","received_events_url":"https://api.github.com/users/muglug/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/895/reactions","total_count":0,"+1":0,"