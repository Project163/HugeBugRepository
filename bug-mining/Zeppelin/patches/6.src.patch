diff --git a/zan-repo/txt.wordcount/zql.erb b/zan-repo/txt.wordcount/zql.erb
new file mode 100644
index 000000000..629128e04
--- /dev/null
+++ b/zan-repo/txt.wordcount/zql.erb
@@ -0,0 +1,10 @@
+SELECT
+    sq.wd as word,
+    sum(sq.cnt) as count
+FROM (
+    MAP
+        * using 'python ./txt.wordcount_mapper.py' as (wd, cnt)
+    FROM <%=z.in%>
+) sq 
+GROUP BY sq.wd
+ORDER BY count desc
