byte-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Jira Link: [DB-14262](https://yugabyte.atlassian.net/browse/DB-14262)\r\n### Description\r\n\r\nApply the following patch\r\n```diff\r\ndiff --git src/yb/yql/pgwrapper/pg_ddl_atomicity-test.cc src/yb/yql/pgwrapper/pg_ddl_atomicity-test.cc\r\nindex c594285c03..0fce2894d5 100644\r\n--- a/src/yb/yql/pgwrapper/pg_ddl_atomicity-test.cc\r\n+++ b/src/yb/yql/pgwrapper/pg_ddl_atomicity-test.cc\r\n@@ -72,6 +72,9 @@ class PgDdlAtomicityTest : public PgDdlAtomicityTestBase {\r\n   void UpdateMiniClusterOptions(ExternalMiniClusterOptions* options) override {\r\n     options->extra_master_flags.push_back(\"--ysql_transaction_bg_task_wait_ms=5000\");\r\n     options->extra_tserver_flags.push_back(\"--ysql_pg_conf_csv=log_statement=all\");\r\n+\r\n+    options->num_masters = 3;\r\n+    options->num_tablet_servers = 3;\r\n   }\r\n\r\n   void CreateTable(const string& tablename) {\r\n@@ -1846,6 +1849,31 @@ TEST_F(PgDdlAtomicityTest, TestAlterTableAddUniqueConstraint) {\r\n   ASSERT_EQ(ASSERT_RESULT(client->ListTables(\"y_unique\")).size(), 1);\r\n }\r\n\r\n+TEST_F(PgDdlAtomicityTest, TestAlterTableAndRestart) {\r\n+  {\r\n+    auto conn = ASSERT_RESULT(cluster_->ConnectToDB());\r\n+    ASSERT_OK(conn.Execute(\"CREATE TABLE rename_test (id int)\"));\r\n+  }\r\n+\r\n+  for (int i = 0; i < 10; i++) {\r\n+    auto conn = ASSERT_RESULT(cluster_->ConnectToDB());\r\n+    ASSERT_OK(conn.Execute(\"CREATE TEMP TABLE temp_table(a int primary key, b int)\"));\r\n+    ASSERT_OK(conn.Execute(\"SET yb_test_fail_next_ddl TO true\"));\r\n+    ASSERT_NOK(conn.Execute(\"ALTER TABLE rename_test RENAME TO foobar\"));\r\n+\r\n+    for (auto* master : cluster_->master_daemons()) {\r\n+      master->Shutdown();\r\n+      ASSERT_OK(master->Restart());\r\n+    }\r\n+    ASSERT_OK(cluster_->WaitForTabletServerCount(cluster_->num_tablet_servers(), 30s));\r\n+  }\r\n+\r\n+  {\r\n+    auto conn = ASSERT_RESULT(cluster_->ConnectToDB());\r\n+    ASSERT_OK(conn.FetchRows<int>(\"SELECT * FROM rename_test\"));\r\n+  }\r\n+}\r\n+\r\n TEST_F(PgDdlAtomicityTest, TestAlterTableAddCheckConstraint) {\r\n   auto conn = ASSERT_RESULT(Connect());\r\n   auto client = ASSERT_RESULT(cluster_->CreateClient());\r\n```\r\n\r\nThe commands seem to be unrelated to each other, but the failure does not reproduce without each line present. \r\n\r\nRun the test\r\n```\r\n./yb_build.sh release --cxx-test pg_ddl_atomicity-test --gtest_filter PgDdlAtomicityTest.TestAlterTableAndRestart\r\n```\r\n\r\nObserve lots of logs like:\r\n```\r\n[m-3] I1212 11:38:44.237526 1843949568 reactor.cc:636] Master_R004: DEBUG: Closing idle connection: Connection (0x000000010cbfe598) server 127.0.0.3:53463 => 127.0.0.1:28030 - it has been idle for 65.0991s\r\n[m-3] I1212 11:38:44.237938 1846816768 reactor.cc:636] Master_R009: DEBUG: Closing idle connection: Connection (0x000000010c7ede58) server 127.0.0.1:53462 => 127.0.0.1:28030 - it has been idle for 65.099s\r\n[m-3] I1212 11:38:44.337834 1845096448 reactor.cc:636] Master_R006: DEBUG: Closing idle connection: Connection (0x000000010cbfe018) server 127.0.0.3:53464 => 127.0.0.1:28030 - it has been idle for 65.0996s\r\n[m-3] W1212 11:38:45.737087 1861152768 consensus_peers.cc:625] T 00000000000000000000000000000000 P e92c9068e3854c4dbf92f3a6f222fb2f -> Peer c1f282ceb4a04ef593f3c4bff9206447 ([host: \"127.0.0.1\" port: 28366], []): Couldn't send request.  Status: Timed out (yb/rpc/outbound_call.cc:643): UpdateConsensus RPC (request call id 758) to 127.0.0.1:28366 timed out after 3.000s. Retrying in the next heartbeat period. Already tried 135 times. State: 2\r\n[m-2] W1212 11:38:45.740509 1835249664 yb_rpc.cc:362] Call yb.consensus.ConsensusService.UpdateConsensus 127.0.0.1:53063 => 127.0.0.1:28366 (request call id 758) took 3004ms (client timeout 3000ms).\r\n[m-2] I1212 11:38:45.740537 1835249664 yb_rpc.cc:366] Trace:\r\n[m-2] I1212 11:38:45.740551 1835249664 trace.cc:442] 1212 11:38:42.731385 (+     0us) inbound_call.cc:124] Created InboundCall\r\n[m-2] 1212 11:38:42.731402 (+    17us) service_pool.cc:183] Inserting onto call queue\r\n[m-2] 1212 11:38:42.731432 (+    30us) service_pool.cc:268] Handling call UpdateConsensus\r\n[m-2] 1212 11:38:45.735722 (+3004290us) inbound_call.cc:258] Queueing success response\r\n[m-1] W1212 11:38:46.680161 1857712128 yb_rpc.cc:362] Call yb.consensus.ConsensusService.UpdateConsensus 127.0.0.1:53142 => 127.0.0.1:17991 (request call id 759) took 3000ms (client timeout 3000ms).\r\n[m-1] I1212 11:38:46.680214 1857712128 yb_rpc.cc:366] Trace:\r\n[m-1] I1212 11:38:46.680233 1857712128 trace.cc:442] 1212 11:38:43.675194 (+     0us) inbound_call.cc:124] Created InboundCall\r\n```\r\n\r\n### Issue Type\r\n\r\nkind/