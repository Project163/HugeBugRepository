/angular/angular/contents/{+path}","compare_url":"https://api.github.com/repos/angular/angular/compare/{base}...{head}","merges_url":"https://api.github.com/repos/angular/angular/merges","archive_url":"https://api.github.com/repos/angular/angular/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/angular/angular/downloads","issues_url":"https://api.github.com/repos/angular/angular/issues{/number}","pulls_url":"https://api.github.com/repos/angular/angular/pulls{/number}","milestones_url":"https://api.github.com/repos/angular/angular/milestones{/number}","notifications_url":"https://api.github.com/repos/angular/angular/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/angular/angular/labels{/name}","releases_url":"https://api.github.com/repos/angular/angular/releases{/id}","deployments_url":"https://api.github.com/repos/angular/angular/deployments","created_at":"2014-09-18T16:12:01Z","updated_at":"2026-03-11T08:09:26Z","pushed_at":"2026-03-10T23:39:43Z","git_url":"git://github.com/angular/angular.git","ssh_url":"git@github.com:angular/angular.git","clone_url":"https://github.com/angular/angular.git","svn_url":"https://github.com/angular/angular","homepage":"https://angular.dev","size":616697,"stargazers_count":100153,"watchers_count":100153,"language":"TypeScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":27110,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1141,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["angular","javascript","pwa","typescript","web","web-framework","web-performance"],"visibility":"public","forks":27110,"open_issues":1141,"watchers":100153,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/angular/angular/pulls/24213","html_url":"https://github.com/angular/angular/pull/24213","diff_url":"https://github.com/angular/angular/pull/24213.diff","patch_url":"https://github.com/angular/angular/pull/24213.patch","merged_at":null},"body":"Fixes #19278.\r\n\r\ninnerHTML is conservatively marked as an attribute for security purpose so that it's sanitized when set. However this same mapping is used by the server renderer to decide whether the `innerHTML` property needs to be reflected to the `innerhtml` attribute. The fix is to just skip the property to attribute reflection for `innerHTML`.\r\n\r\n## PR Checklist\r\nPlease check if your PR fulfills the following requirements:\r\n\r\n- [x] The commit message follows our guidelines: https://github.com/angular/angular/blob/master/CONTRIBUTING.md#commit\r\n- [x] Tests for the changes have been added (for bug fixes / features)\r\n- [ ] Docs have been added / updated (for bug fixes / features)\r\n\r\n\r\n## PR Type\r\nWhat kind of change does this PR introduce?\r\n\r\n<!-- Please check the one that applies to this PR using \"x\". -->\r\n```\r\n[x] Bugfix\r\n[ ] Feature\r\n[ ] Code style update (formatting, local variables)\r\n[ ] Refactoring (no functional changes, no api changes)\r\n[ ] Build related changes\r\n[ ] CI related changes\r\n[ ] Documentation content changes\r\n[ ] angular.io application / infrastructure changes\r\n[ ] Other... Please describe:\r\n```\r\n\r\n## What is the current behavior?\r\nWhen innerHTML property is set on an element it is wrongly reflected to an \"innerhtml\" attribute in addition to actually setting the innerHTML.\r\n```\r\n<div [innerHTML]=\"'content'\"></div>\r\n```\r\nin template produces\r\n```\r\n<div innerhtml=\"content\">content</div>\r\n```\r\n\r\nIssue Number: #19278\r\n\r\n\r\n## What is the new behavior?\r\n```\r\n<div [innerHTML]=\"'content'\"></div>\r\n```\r\nin template produces\r\n```\r\n<div>content</div>\r\n```\r\n\r\n\r\n## Does this PR introduce a breaking change?\r\n```\r\n[ ] Yes\r\n[x] No\r\n```\r\n","reactions":{"url":"https://api.github.com/repos/angular/angular/issues/24213/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/angular/angular/issues/24213/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":1655118757,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDE2NTUxMTg3NTc=","url":"https://api.github.com/repos/angular/angular/issues/events/1655118757","actor":{"login":"vikerman","id":85066,"node_id":"MDQ6VXNlcjg1MDY2","avatar_url":"https://avatars.githubusercontent.com/u/85066?v=4","gravatar_id":"","url":"https://api.github.com/users/vikerman","html_url":"https://github.com/vikerman","followers_url":"https://api.github.com/users/vikerman/followers","following_url":"https://api.github.com/users/vikerman/following{/other_user}","gists_url":"https://api.github.com/users/vikerman/gists{/gist_id}","starred_url":"https://api.github.com/users/vikerman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vikerman/subscriptions","organizations_url":"https://api.github.com/users/vikerman/orgs","repos_url":"https://api.github.com/users/vikerman/repos","events_url":"https://api.github.com/users/vikerman/events{/privacy}","received_events_url":"https://api.github.com/users/vikerman/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"889ef504ef4295a557403e94b4d236273ff5654b","commit_url":"https://api.github.com/repos/vikerman/angular/commits/889ef504ef4295a557403e94b4d236273ff5654b","created_at":"2018-05-31T04:49:24Z","performed_via_github_app":null},{"id":1656503773,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDE2NTY1MDM3NzM=","url":"https://api.github.com/repos/angular/angular/i