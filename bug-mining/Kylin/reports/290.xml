<item>
            <title>[KYLIN-5762] Initialize job scheduler encounters NPE</title>
                <link>https://issues.apache.org/jira/browse/KYLIN-5762</link>
                <project id="12316121" key="KYLIN">Kylin</project>
                    <description>&lt;p&gt;Given `kylin.job.max-concurrent-jobs=0`, the initialization of job scheduler encounters NPE.&lt;/p&gt;</description>
                <environment></environment>
        <key id="13573447">KYLIN-5762</key>
            <summary>Initialize job scheduler encounters NPE</summary>
