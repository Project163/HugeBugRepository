<item>
            <title>[IGNITE-613] [Test] IgniteCacheReplicatedQuerySelfTest # testNodeLeft fails</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-613</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;IgniteCacheReplicatedQuerySelfTest #testNodeLeft  test fails by unknown reason (should be unmuted on TC after fix). &lt;br/&gt;
Test works long and fails after. Should be enabled after fix.&lt;/p&gt;</description>
                <environment></environment>
        <key id="12785890">IGNITE-613</key>
            <summary>[Test] IgniteCacheReplicatedQuerySelfTest # testNodeLeft fails</summary>
                <type id="1" iconUrl="https://issues.apache.org/jira/secure/viewavatar?size=xsmall&amp;avatarId=21133&amp;avatarType=issuetype">Bug</type>
                                            <priority id="2" iconUrl="https://issues.apache.org/jira/images/icons/priorities/critical.svg">Critical</priority>
                        <status id="6" iconUrl="https://issues.apache.org/jira/images/icons/statuses/closed.png" description="The issue is considered finished, the resolution is correct. Issues which are not closed can be reopened.">Closed</status>
                    <statusCategory id="3" key="done" colorName="green"/>
