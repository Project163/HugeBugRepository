+    use PsalmRunnerTrait;
+
+    public function testSucceedsWithEmptyFile(): void
+    {
+        if (\version_compare(\PHP_VERSION, '7.2.0', '<')) {
+            $this->markTestSkipped('Test case requires PHP 7.2.');
+
+            return;
