1-4efe-bb9d-8a0369e7b893, addrs=ArrayList [127.0.0.1, 172.22.229.21], sockAddrs=HashSet [/127.0.0.1:0, ip-172-22-229-21.ec2.internal/172.22.229.21:0], discPort=0, order=47, intOrder=47, lastExchangeTime=1603983940522, loc=&lt;span class=&quot;code-keyword&quot;&gt;false&lt;/span&gt;, ver=8.7.25#20200910-sha1:b580d9fd, isClient=&lt;span class=&quot;code-keyword&quot;&gt;true&lt;/span&gt;], msg=GridIoMessage [plc=2, topic=TOPIC_CACHE, topicOrd=8, ordered=&lt;span class=&quot;code-keyword&quot;&gt;false&lt;/span&gt;, timeout=0, skipOnTimeout=f
alse, msg=GridDhtAtomicSingleUpdateRequest [key=KeyCacheObjectImpl [part=24, val=23576, hasValBytes=&lt;span class=&quot;code-keyword&quot;&gt;true&lt;/span&gt;], val=com.dream11.ignite.model.GetRoundSummaryRes [idHash=69226443, hash=580815760,roundId=23576, dataSource=MYSQL, sparkJobStatus=COMPLETED], prevVal=&lt;span class=&quot;code-keyword&quot;&gt;null&lt;/span&gt;, &lt;span class=&quot;code-keyword&quot;&gt;super&lt;/span&gt;=GridDhtAtomicAbstractUpdateRequest [onRes=&lt;span class=&quot;code-keyword&quot;&gt;false&lt;/span&gt;, nearNodeId=&lt;span class=&quot;code-keyword&quot;&gt;null&lt;/span&gt;, nearFutId=0, flags=near]], connIdx=-1]]
