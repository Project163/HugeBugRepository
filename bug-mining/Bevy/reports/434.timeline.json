s_url":"https://api.github.com/repos/bevyengine/bevy/merges","archive_url":"https://api.github.com/repos/bevyengine/bevy/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/bevyengine/bevy/downloads","issues_url":"https://api.github.com/repos/bevyengine/bevy/issues{/number}","pulls_url":"https://api.github.com/repos/bevyengine/bevy/pulls{/number}","milestones_url":"https://api.github.com/repos/bevyengine/bevy/milestones{/number}","notifications_url":"https://api.github.com/repos/bevyengine/bevy/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/bevyengine/bevy/labels{/name}","releases_url":"https://api.github.com/repos/bevyengine/bevy/releases{/id}","deployments_url":"https://api.github.com/repos/bevyengine/bevy/deployments","created_at":"2020-01-18T21:13:55Z","updated_at":"2025-12-12T22:52:09Z","pushed_at":"2025-12-12T23:54:15Z","git_url":"git://github.com/bevyengine/bevy.git","ssh_url":"git@github.com:bevyengine/bevy.git","clone_url":"https://github.com/bevyengine/bevy.git","svn_url":"https://github.com/bevyengine/bevy","homepage":"https://bevy.org","size":153505,"stargazers_count":43454,"watchers_count":43454,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":true,"has_discussions":true,"forks_count":4270,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":3179,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["bevy","game-development","game-engine","gamedev","open-source","rust"],"visibility":"public","forks":4270,"open_issues":3179,"watchers":43454,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/bevyengine/bevy/pulls/10103","html_url":"https://github.com/bevyengine/bevy/pull/10103","diff_url":"https://github.com/bevyengine/bevy/pull/10103.diff","patch_url":"https://github.com/bevyengine/bevy/pull/10103.patch","merged_at":"2023-10-16T23:53:14Z"},"body":"# Objective\r\n\r\nFixes #10086\r\n\r\n## Solution\r\n\r\nInstead of serializing via `DynamicTypePath::reflect_type_path`, now uses the `TypePath` found on the `TypeInfo` returned by `Reflect::get_represented_type_info`.\r\n\r\nThis issue was happening because the dynamic types implement `TypePath` themselves and do not (and cannot) forward their proxy's `TypePath` data. The solution was to access the proxy's type information in order to get the correct `TypePath` data.\r\n\r\n## Changed\r\n\r\n- The `Debug` impl for `TypePathTable` now includes output for all fields.\r\n","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/10103/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bevyengine/bevy/issues/10103/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1760544017","html_url":"https://github.com/bevyengine/bevy/issues/10086#issuecomment-1760544017","issue_url":"https://api.github.com/repos/bevyengine/bevy/issues/10086","id":1760544017,"node_id":"IC_kwDODf6-U85o78UR","user":{"login":"MrGVSV","id":49806985,"node_id":"MDQ6VXNlcjQ5ODA2OTg1","avatar_url":"https://avatars.githubusercontent.com/u/49806985?v=4","gravatar_id":"","url":"https://api.github.com/users/MrGVSV","html_url":"https://github.com/MrGVSV","followers_url":"https://api.github.com/users/MrGVSV/followers","following_url":"https://api.github.com/users/MrGVSV/following{/other_user}","gists_url":"https://api.github.com/users/MrGVSV/gists{/gist_id}","starred_url":"https://api.github.com/users/MrGVSV/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MrGVSV/subscriptions","organizations_url":"https://api.github.com/users/MrGVSV/orgs","repos_url":"https://api.github.com/users/MrGVSV/repos","events_url":"https://api.github.com/users/MrGVSV/events{/privacy}","received_events_url":"https://api.github.com/users/MrGVSV/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-10-12T23:46:33Z","updated_at":"2023-10-12T23:46:33Z","body":"I should make a note, though, that this only applies to top-level dynamic types. Attempting to serialize a field that is a dynamic type is currently not allowed (or should be if it isn't). \r\n\r\nThis is because of the fact that the top-level type is always serialized as a map of its type path to its value. Whereas fields do not contain any self-describing type information. Because of this, we couldn't possibly deserialize a value accurately (i.e. is `123` an `i32` or a `u32`?).\r\n\r\nThis is also why dynamic types need to be proxied in order to be serialized— they need a type to describe themselves as representing!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1760544017/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"MrGVSV","id":49806985,"node_id":"MDQ6VXNlcjQ5ODA2OTg1","avatar_url":"https://avatars.githubusercontent.com/u/49806985?v=4","gravatar_id":"","url":"https://api.github.com/users/MrGVSV","html_url":"https://github.com/MrGVSV","followers_url":"https://api.github.com/users/MrGVSV/followers","following_url":"https://api.github.com/users/MrGVSV/following{/other_user}","gists_url":"https://api.github.com/users/MrGVSV/gists{/gist_id}","starred_url":"https://api.github.com/users/MrGVSV/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MrGVSV/subscriptions","organizations_url":"https://api.github.com/users/MrGVSV