tyle-ext-html-webpack-plugin/dynavers_modules/webpack-2.2.0-rc.2/node_modules/webpack/lib/Compiler.js:340:8)\r\n    at Compiler.<anonymous> (/Users/jb/code/style-ext-html-webpack-plugin/dynavers_modules/webpack-2.2.0-rc.2/node_modules/webpack/lib/Compiler.js:335:14)\r\n    at /Users/jb/code/style-ext-html-webpack-plugin/dynavers_modules/webpack-2.2.0-rc.2/node_modules/async/dist/async.js:356:16\r\n    at iteratorCallback (/Users/jb/code/style-ext-html-webpack-plugin/dynavers_modules/webpack-2.2.0-rc.2/node_modules/async/dist/async.js:936:13)\r\n    at /Users/jb/code/style-ext-html-webpack-plugin/dynavers_modules/webpack-2.2.0-rc.2/node_modules/async/dist/async.js:840:16\r\n    at /Users/jb/code/style-ext-html-webpack-plugin/dynavers_modules/webpack-2.2.0-rc.2/node_modules/graceful-fs/graceful-fs.js:43:10\r\n    at /Users/jb/code/style-ext-html-webpack-plugin/dynavers_modules/webpack-2.2.0-rc.2/node_modules/graceful-fs/graceful-fs.js:43:10\r\n    at /Users/jb/code/style-ext-html-webpack-plugin/dynavers_modules/webpack-2.2.0-rc.2/node_modules/graceful-fs/graceful-fs.js:43:10\r\n    at FSReqWrap.oncomplete (fs.js:123:15)\r\n```\r\n\r\n(this was produced from upgrading the version of webpack 2 used during test and running `npm run test:webpack2`). The same error occurs when using the plugin with a real toy project.\r\n\r\nA quick glance appears to show the cause is the line deleting the extracted css file: https://github.com/numical/style-ext-html-webpack-plugin/blob/3e17a2517df6b733e13942b415870ca24adc735b/lib/plugin.js#L107 - apparently the (new?) SizeLimitsPlugin is expecting it to exist: https://github.com/webpack/webpack/blob/8bc25f65e60001861a2c9f9962ddfbe3a5aa9025/lib/performance/SizeLimitsPlugin.js#L37. Removing the deletion line appears to work, although the tests fail since they're currently testing that the file is deleted.\r\n\r\nI'm not sure whether this is more of a bug with webpack, or if the recommendation is for plugins to avoid deleting emitted assets created by other plugins? At this point my knowledge of webpack plugin execution order and interop is limited, so please let me know if I should create an issue on webpack itself.","reactions":{"url":"https://api.github.com/repos/numical/style-ext-html-webpack-plugin/issues/11/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/numical/style-ext-html-webpack-plugin/issues/11/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":907166290,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDkwNzE2NjI5MA==","url":"https://api.github.com/repos/webpack/webpack/issues/events/907166290","actor":{"login":"nkzawa","id":775227,"node_id":"MDQ6VXNlcjc3NTIyNw==","avatar_url":"https://avatars.githubusercontent.com/u/775227?v=4","gravatar_id":"","url":"https://api.github.com/users/nkzawa","html_url":"https://github.com/nkzawa","followers_url":"https://api.github.com/users/nkzawa/followers","following_url":"https://api.github.com/users/nkzawa/following{/other_user}","gists_url":"https://api.github.com/users/nkzawa/gists{/gist_id}","starred_url":"https://api.github.com/users/nkzawa/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nkzawa/subscriptions","organizations_url":"https://api.github.com/users/nkzawa/orgs","repos_url":"https://api.github.com/users/nkzawa/repos","events_url":"https://api.github.com/users/nkzawa/events{/privacy}","received_events_url":"https://api.github.com/users/nkzawa/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"baa36a90768e5274117bf8f2e8c7da58ac8a0011","commit_url":"https://api.github.com/repos/nkzawa/webpack/commits/baa36a90768e5274117bf8f2e8c7da58ac8a0011","created_at":"2016-12-29T08:57:33Z","performed_via_github_app":null}]