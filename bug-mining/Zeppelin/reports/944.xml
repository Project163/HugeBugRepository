<item>
            <title>[ZEPPELIN-3715] Fix text &amp; titile passing in NotebookRestApi.runParagraph</title>
                <link>https://issues.apache.org/jira/browse/ZEPPELIN-3715</link>
                <project id="12316221" key="ZEPPELIN">Zeppelin</project>
                    <description>&lt;p&gt;All paragraphs processing as blank, because text string is empty.&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
@POST
@Path(&lt;span class=&quot;code-quote&quot;&gt;&quot;job/{noteId}/{paragraphId}&quot;&lt;/span&gt;)
@ZeppelinApi
&lt;span class=&quot;code-keyword&quot;&gt;public&lt;/span&gt; Response runParagraph(@PathParam(&lt;span class=&quot;code-quote&quot;&gt;&quot;noteId&quot;&lt;/span&gt;) &lt;span class=&quot;code-object&quot;&gt;String&lt;/span&gt; noteId,
@PathParam(&lt;span class=&quot;code-quote&quot;&gt;&quot;paragraphId&quot;&lt;/span&gt;) &lt;span class=&quot;code-object&quot;&gt;String&lt;/span&gt; paragraphId, &lt;span class=&quot;code-object&quot;&gt;String&lt;/span&gt; message)
&lt;span class=&quot;code-keyword&quot;&gt;throws&lt;/span&gt; IOException, IllegalArgumentException {

...

notebookService.runParagraph(
    noteId, paragraphId, &lt;span class=&quot;code-quote&quot;&gt;&quot;&quot;, &quot;&lt;/span&gt;&quot;, params,
    &lt;span class=&quot;code-keyword&quot;&gt;new&lt;/span&gt; HashMap&amp;lt;&lt;span class=&quot;code-object&quot;&gt;String&lt;/span&gt;, &lt;span class=&quot;code-object&quot;&gt;Object&lt;/span&gt;&amp;gt;(), &lt;span class=&quot;code-keyword&quot;&gt;false&lt;/span&gt;, getServiceContext(), &lt;span class=&quot;code-keyword&quot;&gt;new&lt;/span&gt; RestServiceCallback&amp;lt;&amp;gt;());
&lt;span class=&quot;code-keyword&quot;&gt;return&lt;/span&gt; &lt;span class=&quot;code-keyword&quot;&gt;new&lt;/span&gt; JsonResponse&amp;lt;&amp;gt;(Status.OK).build();
}
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</description>
