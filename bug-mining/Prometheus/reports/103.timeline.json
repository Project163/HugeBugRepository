tps://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":true,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["alerting","graphing","hacktoberfest","metrics","monitoring","prometheus","time-series"],"visibility":"public","forks":10224,"open_issues":763,"watchers":63109,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/prometheus/prometheus/pulls/12730","html_url":"https://github.com/prometheus/prometheus/pull/12730","diff_url":"https://github.com/prometheus/prometheus/pull/12730.diff","patch_url":"https://github.com/prometheus/prometheus/pull/12730.patch","merged_at":null},"body":"Fixes: #12731 \r\n\r\nThe fundamental problem is that the ProtobufParser.fieldPos field is used for two things:\r\n* keeping track of which classic histogram bucket we need to process next\r\n* keeping track of which exemplar we processed for a classic / native histogram\r\n\r\nThese are not compatible as soon as you want to process native histogram's classic buckets.\r\n\r\nAn alternate solution would be for the Exemplar function to return a slice, which is nicer, but introduces more memory allocations, so I'm not sure if we should do that @beorn7 ","reactions":{"url":"https://api.github.com/repos/prometheus/prometheus/issues/12730/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/prometheus/prometheus/issues/12730/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"actor":{"login":"krajorama","id":13435893,"node_id":"MDQ6VXNlcjEzNDM1ODkz","avatar_url":"https://avatars.githubusercontent.com/u/13435893?v=4","gravatar_id":"","url":"https://api.github.com/users/krajorama","html_url":"https://github.com/krajorama","followers_url":"h