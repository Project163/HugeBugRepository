-        Map<String, Object> propertiesCopy = new HashMap<String, Object>(properties);
-        if (isBodyEmpty()) {
-            propertiesCopy.put(EMPTY_BODY_KEY, true);
-            builder.setBody(ByteString.EMPTY);
