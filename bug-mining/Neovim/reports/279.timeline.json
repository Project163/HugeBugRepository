im/subscription","commits_url":"https://api.github.com/repos/vim/vim/commits{/sha}","git_commits_url":"https://api.github.com/repos/vim/vim/git/commits{/sha}","comments_url":"https://api.github.com/repos/vim/vim/comments{/number}","issue_comment_url":"https://api.github.com/repos/vim/vim/issues/comments{/number}","contents_url":"https://api.github.com/repos/vim/vim/contents/{+path}","compare_url":"https://api.github.com/repos/vim/vim/compare/{base}...{head}","merges_url":"https://api.github.com/repos/vim/vim/merges","archive_url":"https://api.github.com/repos/vim/vim/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/vim/vim/downloads","issues_url":"https://api.github.com/repos/vim/vim/issues{/number}","pulls_url":"https://api.github.com/repos/vim/vim/pulls{/number}","milestones_url":"https://api.github.com/repos/vim/vim/milestones{/number}","notifications_url":"https://api.github.com/repos/vim/vim/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/vim/vim/labels{/name}","releases_url":"https://api.github.com/repos/vim/vim/releases{/id}","deployments_url":"https://api.github.com/repos/vim/vim/deployments","created_at":"2015-08-18T21:03:56Z","updated_at":"2025-12-13T05:31:00Z","pushed_at":"2025-12-12T08:04:41Z","git_url":"git://github.com/vim/vim.git","ssh_url":"git@github.com:vim/vim.git","clone_url":"https://github.com/vim/vim.git","svn_url":"https://github.com/vim/vim","homepage":"https://www.vim.org","size":189300,"stargazers_count":39400,"watchers_count":39400,"language":"Vim Script","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":5890,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1603,"license":{"key":"vim","name":"Vim License","spdx_id":"Vim","url":"https://api.github.com/licenses/vim","node_id":"MDc6TGljZW5zZTQw"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["c","cross-platform","text-editor","vim"],"visibility":"public","forks":5890,"open_issues":1603,"watchers":39400,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/vim/vim/pulls/5974","html_url":"https://github.com/vim/vim/pull/5974","diff_url":"https://github.com/vim/vim/pull/5974.diff","patch_url":"https://github.com/vim/vim/pull/5974.patch","merged_at":null},"body":"Noticed at https://github.com/neovim/neovim/issues/12174\r\n\r\nTrying to do `:let &number=v:false` will error out with `E521: Number required`, while `:let &number=v:true` works as expected.\r\n\r\nI believe the problem is, that when we convert v:false it to number zero correctly at\r\n\r\nhttps://github.com/vim/vim/blob/e71ebb46a252cd1cdfb075e6014c2b13c580bf3f/src/evalvars.c#L1259-L1260\r\n\r\nwhen we further down call `set_option_value(arg, n, s, opt_flags)` with `n=0, s=v:false`, `set_option_value()` wrongly assumes to use the string value instead of the number value, because the number value is zero:\r\n\r\nhttps://github.com/vim/vim/blob/e71ebb46a252cd1cdfb075e6014c2b13c580bf3f/src/option.c#L4233-L4254\r\n\r\nSo make sure, to set the string pointer to NULL, if `n==0 and s==v:false`.\r\n\r\n","reactions":{"url":"https://api.github.com/repos/vim/vim/issues/5974/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vim/vim/issues/5974/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":3269835973,"node_id":"MDEyOkxhYmVsZWRFdmVudDMyNjk4MzU5NzM=","url":"https://api.github.com/repos/neovim/neovim/issues/events/3269835973","actor":{"login":"teto","id":886074,"node_id":"MDQ6VXNlcjg4NjA3NA==","avatar_url":"https://avatars.githubusercontent.com/u/886074?v=4","gravatar_id":"","url":"https://api.github.com/users/teto","html_url":"https://github.com/teto",