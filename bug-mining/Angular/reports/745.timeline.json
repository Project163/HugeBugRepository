lar/angular/pull/25357.diff","patch_url":"https://github.com/angular/angular/pull/25357.patch","merged_at":null},"body":"## PR Checklist\r\n- [x] The commit message follows our guidelines: https://github.com/angular/angular/blob/master/CONTRIBUTING.md#commit\r\n- [x] Tests for the changes have been added (for bug fixes / features)\r\n- [ ] ~~Docs have been added / updated (for bug fixes / features)~~\r\n\r\n\r\n## PR Type\r\n```\r\n[x] Bugfix\r\n```\r\n\r\n\r\n## What is the current behavior?\r\nDestroying an upgraded component, does not trigger `$destroy` on the element.\r\n\r\nIssue Number: #25334\r\n\r\n\r\n## What is the new behavior?\r\nDestroying an upgraded component, triggers `$destroy` on the element (as would happen in an AngularJS app).\r\n\r\n\r\n## Does this PR introduce a breaking change?\r\n```\r\n[ ] Yes\r\n[x] No (afaict :grin:)\r\n```\r\n\r\n\r\n## Other information\r\nFixes #25334.\r\n","reactions":{"url":"https://api.github.com/repos/angular/angular/issues/25357/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/angular/angular/issues/25357/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/angular/angular/issues/comments/412129201","html_url":"https://github.com/angular/angular/issues/25334#issuecomment-412129201","issue_url":"https://api.github.com/repos/angular/angular/issues/25334","id":412129201,"node_id":"MDEyOklzc3VlQ29tbWVudDQxMjEyOTIwMQ==","user":{"login":"llRandom","id":2345582,"node_id":"MDQ6VXNlcjIzNDU1ODI=","avatar_url":"https://avatars.githubusercontent.com/u/2345582?v=4","gravatar_id":"","url":"https://api.github.com/users/llRandom","html_url":"https://github.com/llRandom","followers_url":"https://api.github.com/users/llRandom/followers","following_url":"https://api.github.com/users/llRandom/following{/other_user}","gists_url":"https://api.github.com/users/llRandom/gists{/gist_id}","starred_url":"https://api.github.com/users/llRandom/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/llRandom/subscriptions","organizations_url":"https://api.github.com/users/llRandom/orgs","repos_url":"https://api.github.com/users/llRandom/repos","events_url":"https://api.github.com/users/llRandom/events{/privacy}","received_events_url":"https://api.github.com/users/llRandom/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-08-10T16:06:16Z","updated_at":"2018-08-10T16:06:16Z","body":"For some reason if I trigger `$destroy` on a root element it's not captured by nested elements. If I do something like `(this as any).$element.find('my-ng1-component').trigger('$destroy')` it's working but in some cases it gives me another error\r\n\r\n```\r\nTypeError: Cannot read property '$$nextSibling' of null\r\n    at Scope.$broadcast (http://localhost/Scripts/angular/angular.js:18310:59)\r\n    at Scope.$destroy (http://localhost/Scripts/angular/angular.js:17913:14)\r\n    at afterAnimating (http://localhost/Scripts/angular-ui/ui-bootstrap-tpls.js:4115:17)\r\n    at processQueue (http://localhost/Scripts/angular/angular.js:16648:37)\r\n    at http://localhost/Scripts/angular/angular.js:16692:27\r\n    at Scope.$eval (http://localhost/Scripts/angular/angular.js:17972:28)\r\n    at Scope.$digest (http://localhost/Scripts/angular/angular.js:17786:31)\r\n    at my-project-bundle\r\n    at SafeSubscriber.schedulerFn [as _next] (my-project-bundle)\r\n    at SafeSubscriber.push../node_modules/rxjs/_esm5/internal/Subscriber.js.SafeSubscriber.__tryOrUnsub (my-project-bundle) Possibly unhandled rejection: {}\r\n```\r\n\r\nIt fails inside this angular.js block\r\n\r\n          // Insanity Warning: scope depth-first traversal\r\n          // yes, this code is a bit crazy, but it works and we have tests to prove it!\r\n          // this piece should be kept in sync with the traversal in $digest\r\n          // (though it differs due to having the extra check for $$listenerCount)\r\n          if (!(next = ((current.$$listenerCount[name] && current.$$childHead) ||\r\n              (current !== target && current.$$nextSibling)))) {\r\n            while (current !== target && !(next = current.$$nextSibling)) {\r\n              current = current.$parent;\r\n            }\r\n          }\r\nAs I understand, it triggers second scope dispose and it fails because `$parent` property is set to `null`. So, something is also wrong with the way Angular Upgrade disposes $scopes","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/comments/412129201/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"llRandom","id":2345582,"node_id":"MDQ6VXNlcjIzNDU1ODI=","avatar_url":"https://avatars.githubusercontent.com/u/2345582?v=4","gravatar_id":"","url":"https://api.github.com/users/llRandom","html_url":"https://github.com/llRandom","followers_url":"https://api.github.com/users/llRandom/followers","following_url":"https://api.github.com/users/llRandom/following{/other_user}","gists_url":"https://api.github.com/users/llRandom/gists{/gist_id}","starred_url":"https://api.github.com/users/llRandom/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/llRandom/subscriptions","organizations_url":"https://api.github.com/users/llRandom/orgs","repos_url":"https://api.github.com/users/llRandom/repos","events_url":"https://api.github.com/users/llRandom/events{/privacy}","received_events_url":"https://api.github.com/users/llRandom/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/angular/angular/issues/comments/412618093","html_url":"https://github.com/angular/angular/issues/25334#issuecomment-412618093","issue_url":"https://api.gi