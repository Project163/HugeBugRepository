ount":27110,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1142,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["angular","javascript","pwa","typescript","web","web-framework","web-performance"],"visibility":"public","forks":27110,"open_issues":1142,"watchers":100154,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/angular/angular/pulls/38014","html_url":"https://github.com/angular/angular/pull/38014","diff_url":"https://github.com/angular/angular/pull/38014.diff","patch_url":"https://github.com/angular/angular/pull/38014.patch","merged_at":null},"body":"We currently use 16 bits to store information about nodes in a view. The 16 bits give us 65536 entries in the array, but the problem is that while the number is large, it can be reached by ~4300 directive instances with host bindings which could realistically happen in a very large view, as seen in #37876. Once we hit the limit, we end up overflowing which eventually leads to a runtime error.\r\n\r\nThese changes bump to using 20 bits which gives us around 1048576 entries in the array or 16 times more than the current amount which could still technically be reached, but is much less likely and the user may start hitting browser limitations by that point.\r\n\r\nI picked the 20 bit number since it gives us enough buffer over the 16 bit one, while not being as massive as a 24 bit or 32 bit.\r\n\r\nI've also added a dev mode assertion so it's easier to track down if it happens again in the future.\r\n\r\nFixes #37876.","reactions":{"url":"https://api.github.com/repos/angular/angular/issues/38014/reactions","total_count":2,"+1":0,"-1":0,"laugh":2,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/angular/angular/issues/38014/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":3536397817,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDM1MzYzOTc4MTc=","url":"https://api.github.com/repos/angular/angular/issues/events/3536397817","actor":{"login":"crisbeto","id":4450522,"node_id":"MDQ6VXNlcjQ0NTA1MjI=","avatar_url":"https://avatars.githubusercontent.com/u/4450522?v=4","gravatar_id":"","url":"https://api.github.com/users/crisbeto","html_url":"https://github.com/crisbeto","followers_url":"https://api.github.com/users/crisbeto/followers","following_url":"https://api.github.com/users/crisbeto/following{/other_user}","gists_url":"https://api.github.com/users/crisbeto/gists{/gist_id}","starred_url":"https://api.github.com/users/crisbeto/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/crisbeto/subscriptions","organizations_url":"https://api.github.com/users/crisbeto/orgs","repos_url":"https://api.github.com/users/crisbeto/repos","events_url":"https://api.github.com/users/crisbeto/events{/privacy}","received_events_url":"https://api.github.com/users/crisbeto/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"a883497725cdb739d51719c7369df9aeae890b77","commit_url":"https://api.github.com/repos/crisbeto/angular/commits/a883497725cdb739d51719c7369df9aeae890b77","created_at":"2020-07-11T16:02:44Z","performed_via_github_app":null},{"id":3536455191,"node_id":"MDEzOkFzc2lnbmVkRXZlbnQzNTM2NDU1MTkx","url":"https://api.github.com/repos/angular/angular/issues/events/3536455191","actor":{"login":"crisbeto","id":4450522,"node_id":"MDQ6VXNlcjQ0NTA1MjI=","avatar_url":"https://avatars.githubusercontent.com/u/4450522?v=4","gravatar_id":"","url":"https://api.github.com/users/crisbeto","html_url":"https://github.com/crisbeto","followers_url":"https://api.github.com/users/crisbe