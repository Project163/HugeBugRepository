+
+			Assert.IsType<EquivalentException>(ex);
+			Assert.Equal(
+				"Assert.Equivalent() Failure" + Environment.NewLine +
+				"Expected: 1" + Environment.NewLine +
+				"Actual:   Object { }",
+				ex.Message
+			);
