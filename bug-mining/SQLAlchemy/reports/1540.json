fdff","default":false,"description":""}],"state":"closed","locked":false,"assignee":null,"assignees":[],"milestone":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/milestones/100","html_url":"https://github.com/sqlalchemy/sqlalchemy/milestone/100","labels_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/milestones/100/labels","id":8974115,"node_id":"MI_kwDOCX5JB84AiO8j","number":100,"title":"2.0.x","description":"","creator":{"login":"CaselIT","id":16175304,"node_id":"MDQ6VXNlcjE2MTc1MzA0","avatar_url":"https://avatars.githubusercontent.com/u/16175304?v=4","gravatar_id":"","url":"https://api.github.com/users/CaselIT","html_url":"https://github.com/CaselIT","followers_url":"https://api.github.com/users/CaselIT/followers","following_url":"https://api.github.com/users/CaselIT/following{/other_user}","gists_url":"https://api.github.com/users/CaselIT/gists{/gist_id}","starred_url":"https://api.github.com/users/CaselIT/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CaselIT/subscriptions","organizations_url":"https://api.github.com/users/CaselIT/orgs","repos_url":"https://api.github.com/users/CaselIT/repos","events_url":"https://api.github.com/users/CaselIT/events{/privacy}","received_events_url":"https://api.github.com/users/CaselIT/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":62,"closed_issues":423,"state":"open","created_at":"2023-01-27T12:23:11Z","updated_at":"2025-12-09T20:45:45Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2024-09-13T14:03:15Z","updated_at":"2024-09-15T23:17:07Z","closed_at":"2024-09-15T23:17:06Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"While trying to ensure our codebase works with both connectors the first issue was that appending, in our case, `?unix_socket=/path/to/socket` wasn't having any effect while using mariadbconnector while mysqldb passes it as args to the connect method.\r\n\r\nBoth drivers are very similar and supports the same argument in almost all cases so I assume it would work fine just doing the same call in both drivers (or if that is not a desired usage deprecate passing it as url_params and document that it's prefered to pass it as explicit options to create_engine).\r\n\r\nWe can work around it either way but it feels like an unnecesary inconsistency.\r\n\r\nI havn't checked the behavior of other dialects in this regard but the difference between these to is simply the call to `opts.update(url.query)` at \r\nhttps://github.com/sqlalchemy/sqlalchemy/blob/29c2c15902094965f9dca66efae33305f09c3878/lib/sqlalchemy/dialects/mysql/mysqldb.py#L208\r\n\r\nwhich has no corresponding call in mariadbconnector.\r\nJust adding it here https://github.com/sqlalchemy/sqlalchemy/blob/29c2c15902094965f9dca66efae33305f09c3878/lib/sqlalchemy/dialects/mysql/mariadbconnector.py#L169\r\n\r\nworks reasonably in my preliminary testing.\r\n\r\n_Originally posted by @tapetersen in https://github.com/sqlalchemy/sqlalchemy/discussions/11868_","closed_by":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqla