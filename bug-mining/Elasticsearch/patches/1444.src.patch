+            @Override
+            public void onResponse(ScrollQueryFetchSearchResult result) {
+                queryFetchResults.set(shardIndex, result.result());
+                if (counter.decrementAndGet() == 0) {
+                    finishHim();
+                }
+            }
+
+            @Override
+            public void onFailure(Throwable t) {
