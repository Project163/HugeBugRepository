 smarter to make sure the script doesn't add -Werror=partial-availability until the very end of the script, so no other tests in the future fail because of it. That change is safe to leave in here in any case, though.","reactions":{"url":"https://api.github.com/repos/curl/curl/issues/1343/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/curl/curl/issues/1343/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/curl/curl/issues/comments/319585620","html_url":"https://github.com/curl/curl/issues/1069#issuecomment-319585620","issue_url":"https://api.github.com/repos/curl/curl/issues/1069","id":319585620,"node_id":"MDEyOklzc3VlQ29tbWVudDMxOTU4NTYyMA==","user":{"login":"loveinsky100","id":18205561,"node_id":"MDQ6VXNlcjE4MjA1NTYx","avatar_url":"https://avatars.githubusercontent.com/u/18205561?v=4","gravatar_id":"","url":"https://api.github.com/users/loveinsky100","html_url":"https://github.com/loveinsky100","followers_url":"https://api.github.com/users/loveinsky100/followers","following_url":"https://api.github.com/users/loveinsky100/following{/other_user}","gists_url":"https://api.github.com/users/loveinsky100/gists{/gist_id}","starred_url":"https://api.github.com/users/loveinsky100/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/loveinsky100/subscriptions","organizations_url":"https://api.github.com/users/loveinsky100/orgs","repos_url":"https://api.github.com/users/loveinsky100/repos","events_url":"https://api.github.com/users/loveinsky100/events{/privacy}","received_events_url":"https://api.github.com/users/loveinsky100/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-08-02T06:59:07Z","updated_at":"2017-08-02T06:59:07Z","body":"https://github.com/loveinsky100/libcurl-nghttp2-mbedtls-ios ","author_association":"NONE","react