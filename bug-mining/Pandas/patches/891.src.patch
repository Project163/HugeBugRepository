+        # GH11761
+        io = StringIO()
+
+        frame = DataFrame([[1, 2.0]],
+                          columns=['a', 'a'])
+        frame.info(buf=io)
+        io.seek(0)
+        lines = io.readlines()
+        self.assertEqual('a    1 non-null int64\n', lines[3])
+        self.assertEqual('a    1 non-null float64\n', lines[4])
