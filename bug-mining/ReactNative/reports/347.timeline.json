e !","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/facebook/react-native/issues/comments/511406909/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"AlexisChup","id":47422165,"node_id":"MDQ6VXNlcjQ3NDIyMTY1","avatar_url":"https://avatars.githubusercontent.com/u/47422165?v=4","gravatar_id":"","url":"https://api.github.com/users/AlexisChup","html_url":"https://github.com/AlexisChup","followers_url":"https://api.github.com/users/AlexisChup/followers","following_url":"https://api.github.com/users/AlexisChup/following{/other_user}","gists_url":"https://api.github.com/users/AlexisChup/gists{/gist_id}","starred_url":"https://api.github.com/users/AlexisChup/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AlexisChup/subscriptions","organizations_url":"https://api.github.com/users/AlexisChup/orgs","repos_url":"https://api.github.com/users/AlexisChup/repos","events_url":"https://api.github.com/users/AlexisChup/events{/privacy}","received_events_url":"https://api.github.com/users/AlexisChup/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":2482940575,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50MjQ4Mjk0MDU3NQ==","url":"https://api.github.com/repos/facebook/react-native/issues/events/2482940575","actor":{"login":"RobinCsl","id":22741774,"node_id":"MDQ6VXNlcjIyNzQxNzc0","avatar_url":"https://avatars.githubusercontent.com/u/22741774?v=4","gravatar_id":"","url":"https://api.github.com/users/RobinCsl","html_url":"https://github.com/RobinCsl","followers_url":"https://api.github.com/users/RobinCsl/followers","following_url":"https://api.github.com/users/RobinCsl/following{/other_user}","gists_url":"https://api.github.com/users/RobinCsl/gists{/gist_id}","starred_url":"https://api.github.com/users/RobinCsl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com