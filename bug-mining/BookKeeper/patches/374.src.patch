-            data[i] = createMessageText(i);
-        }
-    }
-
-
-    protected void initializeData(HedwigConnectionImpl connection, SessionImpl session) {
-        int messageCount = 100;
-        if (session.getTransacted() || Session.CLIENT_ACKNOWLEDGE == session.getAcknowledgeMode()){
-            messageCount = connection.getHedwigClientConfig().getMaximumOutstandingMessages() - 1;
-        }
-
-        initializeData(messageCount);
-    }
-
-    protected String createMessageText(int i) {
