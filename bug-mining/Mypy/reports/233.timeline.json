n-horizons/unknown-horizons/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/unknown-horizons/unknown-horizons/labels{/name}","releases_url":"https://api.github.com/repos/unknown-horizons/unknown-horizons/releases{/id}","deployments_url":"https://api.github.com/repos/unknown-horizons/unknown-horizons/deployments","created_at":"2010-08-23T08:48:29Z","updated_at":"2025-12-09T13:10:09Z","pushed_at":"2023-12-21T00:22:43Z","git_url":"git://github.com/unknown-horizons/unknown-horizons.git","ssh_url":"git@github.com:unknown-horizons/unknown-horizons.git","clone_url":"https://github.com/unknown-horizons/unknown-horizons.git","svn_url":"https://github.com/unknown-horizons/unknown-horizons","homepage":"http://unknown-horizons.org","size":501393,"stargazers_count":1476,"watchers_count":1476,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":234,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":231,"license":null,"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["game","python","simulation","strategy"],"visibility":"public","forks":234,"open_issues":231,"watchers":1476,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"[PEP-484](https://www.python.org/dev/peps/pep-0484/) introduced new syntax to declare type hints. The interpreter makes no use of them, other then to expose them on e.g. function objects.\r\n\r\nThird party tools like [mypy](http://mypy-lang.org/) understand the syntax and can check programs statically.\r\n\r\nNote: this won't affect the game at runtime at all. It won't run faster, it won't run slower. It will however most likely help catching bugs and making lovers of static typing happy.\r\n\r\nIf I understand it correctly, mypy will only check function bodies if we start providing type hints, however running it against our codebase produces some errors. Failure to import FIFE and some complaints about our class inheritance trees. \r\n- [x] 1. Fix issues raised when running mypy on clean codebase (`mypy --py2 --silent-imports --fast-parser -p horizons`)\r\n- [ ] 2. Fix issues raised by adding the `--check-untyped-defs` argument\r\n- [ ] 3. Once `--check-untyped-defs` passes, add mypy to CI\r\n- [ ] 4. Identify parts of codebase most likely to benefit the most (I'm thinking of essentials, Scheduler and stuff) and add type hints\r\n- [ ] 5. Profit?\r\n\r\n@ChrisOelmueller COMEFROM .idle","reactions":{"url":"https://api.github.com/repos/unknown-horizons/unknown-horizons/issues/2513/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/unknown-horizons/unknown-horizons/issues/2513/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/python/mypy/issues/comments/257462250","html_url":"https://github.com/python/mypy/issues/2052#issuecomment-257462250","issue_url":"https://api.github.com/repos/python/mypy/issues/2052","id":257462250,"node_id":"MDEyOklzc3VlQ29tbWVudDI1NzQ2MjI1MA==","user":{"login":"gvanrossum","id":2894642,"node_id":"MDQ6VXNlcjI4OTQ2NDI=","avatar_url":"https://avatars.githubusercontent.com/u/2894642?v=4","gravatar_id":"","url":"https://api.github.com/users/gvanrossum","html_url":"https://github.com/gvanrossum","followers_url":"https://api.github.com/users/gvanrossum/followers","following_url":"https://api.github.com/users/gvanrossum/following{/other_user}","gists_url":"https://api.github.com/users/gvanrossum/gists{/gist_id}","starred_url":"https://api.github.com/users/gvanrossum/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gvanrossum/subscriptions","organizations_url":"https://api.github.com/users/gvanrossum/orgs","repos_url":"https://api.github.com/users