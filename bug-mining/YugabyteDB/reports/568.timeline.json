sts{/gist_id}","starred_url":"https://api.github.com/users/fizaaluthra/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fizaaluthra/subscriptions","organizations_url":"https://api.github.com/users/fizaaluthra/orgs","repos_url":"https://api.github.com/users/fizaaluthra/repos","events_url":"https://api.github.com/users/fizaaluthra/events{/privacy}","received_events_url":"https://api.github.com/users/fizaaluthra/received_events","type":"User","user_view_type":"public","site_admin":false},"performed_via_github_app":null},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1042264650","html_url":"https://github.com/yugabyte/yugabyte-db/issues/11425#issuecomment-1042264650","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/11425","id":1042264650,"node_id":"IC_kwDOBlCVUc4-H7JK","user":{"login":"myang2021","id":79478033,"node_id":"MDQ6VXNlcjc5NDc4MDMz","avatar_url":"https://avatars.githubusercontent.com/u/79478033?v=4","gravatar_id":"","url":"https://api.github.com/users/myang2021","html_url":"https://github.com/myang2021","followers_url":"https://api.github.com/users/myang2021/followers","following_url":"https://api.github.com/users/myang2021/following{/other_user}","gists_url":"https://api.github.com/users/myang2021/gists{/gist_id}","starred_url":"https://api.github.com/users/myang2021/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/myang2021/subscriptions","organizations_url":"https://api.github.com/users/myang2021/orgs","repos_url":"https://api.github.com/users/myang2021/repos","events_url":"https://api.github.com/users/myang2021/events{/privacy}","received_events_url":"https://api.github.com/users/myang2021/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-02-16T20:39:08Z","updated_at":"2022-02-16T20:39:08Z","body":"I was looking at fdw example and saw this ticket. I debugged it and found that it is caused by referencing freed memory:\r\n\r\n```\r\n    /* If we created a prepared statement, destroy it */\r\n    if (fmstate->p_name)\r\n    {\r\n        char        sql[64];\r\n        PGresult   *res;\r\n\r\n        snprintf(sql, sizeof(sql), \"DEALLOCATE %s\", fmstate->p_name);\r\n\r\n ```\r\n The memory fmstate->p_name is already freed, so we end up composing some garbage characters after DEALLOCATE. I see there is some interaction between COPY and FDW. I see there is a simple fix for this. Will make a diff and add the test case.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1042264650/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"myang2021","id":79478033,"node_id":"MDQ6VXNlcjc5NDc4MDMz","avatar_url":"https://avatars.githubusercontent.com/u/79478033?v=4","gravatar_id":"","url":"https://api.github.com/users/myang2021","html_url":"https://github.com/myang2021","followers_url":"https://api.github.com/users/myang2021/followers","following_url":"https://api.github.com/users/myang2021/following{/other_user}","gists_url":"https://api.github.com/users/myang2021/gists{/gist_id}","starred_url":"https://api.github.com/users/myang2021/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/myang2021/subscriptions","organizations_url":"https://api.github.com/users/myang2021/orgs","repos_url":"https://api.github.com/users/myang2021/repos","events_url":"https://api.github.com/users/myang2021/events{/privacy}","received_events_url":"https://api.github.com/users/myang2021/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":6103416219,"node_id":"AE_lADOBlCVUc5DXvhazwAAAAFryr2b","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/6103416219","actor":{"login":"myang2021","id":79478033,"node_id":"MDQ6VXNlcjc5NDc4MDMz","avatar_url":"https://avat