users/sqla-tester/repos","events_url":"https://api.github.com/users/sqla-tester/events{/privacy}","received_events_url":"https://api.github.com/users/sqla-tester/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-03-06T19:20:34Z","updated_at":"2021-03-06T19:20:34Z","body":"**Gord Thompson** has proposed a fix for this issue in the **master** branch:\n\n**Fix named CHECK constraint name omitted on repeated creates** https://gerrit.sqlalchemy.org/c/sqlalchemy/sqlalchemy/+/2624","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/792032040/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"sqla-tester","id":8250554,"node_id":"MDQ6VXNlcjgyNTA1NTQ=","avatar_url":"https://avatars.githubusercontent.com/u/8250554?v=4","gravatar_id":"","url":"https://api.github.com/users/sqla-tester","html_url":"https://github.com/sqla-tester","followers_url":"https://api.github.com/users/sqla-tester/followers","following_url":"https://api.github.com/users/sqla-tester/following{/other_user}","gists_url":"https://api.github.com/users/sqla-tester/gists{/gist_id}","starred_url":"https://api.github.com/users/sqla-tester/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqla-tester/subscriptions","organizations_url":"https://api.github.com/users/sqla-tester/orgs","repos_url":"https://api.github.com/users/sqla-tester/repos","events_url":"https://api.github.com/users/sqla-tester/events{/privacy}","received_events_url":"https://api.github.com/users/sqla-tester/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/792185908","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/6007#issuecomment-792185908","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/6007","id":792185908,"node_id":"MDEyOklzc3VlQ29tbWVudDc5MjE4NTkwOA==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-03-07T03:11:04Z","updated_at":"2021-03-07T03:11:04Z","body":"so background, we can go to the original commit where _defer_name() was added: d2193f53c10d29a7a9b1846ebf32\r\n\r\nwe can then change the tests in that commit, to run the \"compile\" twice on the tables:\r\n\r\n```diff\r\ndiff --git a/test/sql/test_metadata.py b/test/sql/test_metadata.py\r\nindex 7aa2059dc..ab625ac53 100644\r\n--- a/test/sql/test_metadata.py\r\n+++ b/test/sql/test_metadata.py\r\n@@ -2950,10 +2950,10 @@ class NamingConventionTest(fixtures.TestBase, AssertsCompiledSQL):\r\n             Column('x', Boolean(name='foo'))\r\n             )\r\n         # constraint is not hit\r\n-        eq_(\r\n-            [c for c in u1.constraints\r\n-                if isinstance(c, CheckConstraint)][0].name, \"foo\"\r\n-        )\r\n+        #eq_(\r\n+        #    [c for c in u1.constraints\r\n+        #        if isinstance(c, CheckConstraint)][0].name, \"foo\"\r\n+        #)\r\n         # but is hit at compile time\r\n         self.assert_compile(\r\n             schema.CreateTable(u1),\r\n@@ -2963,6 +2963,14 @@ class NamingConventionTest(fixtures.TestBase, AssertsCompiledSQL):\r\n             \")\"\r\n         )\r\n \r\n+        self.assert_compile(\r\n+            schema.CreateTable(u1),\r\n+            \"CREATE TABLE user (\"\r\n+            \"x BOOLEAN, \"\r\n+            \"CONSTRAINT ck_user_foo CHECK (x IN (0, 1))\"\r\n+            \")\"\r\n+        )\r\n+\r\n     def test_schematype_ck_name_enum(self):\r\n         m1 = MetaData(naming_convention={\r\n                             \"ck\": \"ck_%(table_name)s_%(constraint_name)s\"})\r\n@@ -2970,10 +2978,10 @@ class NamingConventionTest(fixtures.TestBase, AssertsCompiledSQL):\r\n         u1 = Table('user', m1,\r\n             Column('x', Enum('a', 'b', name='foo'))\r\n             )\r\n-        eq_(\r\n-            [c for c in u1.constraints\r\n-                if isinstance(c, CheckConstraint)][0].name, \"foo\"\r\n-        )\r\n+        #eq_(\r\n+        #    [c for c in u1.constraints\r\n+        #        if isinstance(c, CheckConstraint)][0].name, \"foo\"\r\n+        #)\r\n         # but is hit at compile time\r\n         self.assert_compile(\r\n             schema.CreateTable(u1),\r\n@@ -2983,6 +2991,14 @@ class NamingConventionTest(fixtures.TestBase, AssertsCompiledSQL):\r\n             \")\"\r\n         )\r\n \r\n+        self.assert_compile(\r\n+            schema.CreateTable(u1),\r\n+            \"CREATE TABLE user (\"\r\n+                \"x VARCHAR(1), \"\r\n+                \"CONSTRAINT ck_user_foo CHECK (x IN ('a', 'b'))\"\r\n+            \")\"\r\n+        )\r\n+\r\n     def test_schematype_ck_name_boolean_no_name(self):\r\n         m1 = MetaData(naming_convention={\r\n             \"ck\": \"ck_%(table_name)s_%(constraint_name)s\"\r\n\r\n```\r\n\r\nand it fails then:\r\n\r\n```sql\r\nSQL String:\r\n\r\nCREATE TABLE user (\r\n\tx BOOLEAN, \r\n\tCONSTRAINT ck_user_foo CHECK (x IN (0, 1))\r\n)\r\n\r\nNone\r\n\r\nSQL String:\r\n\r\nCREATE TABLE user (\r\n\tx BOOLEAN, \r\n\tCHECK (x IN (0, 1))\r\n)\r\n\r\n```\r\n\r\nwhat's strange is that the issue that was being fixed was if .name were None for the Boolean / Enum, that it wouldnt raise an error until DDL compile time.    So I don't see what purpose there was in doing something special if the name is not none.   indeed, I can remove the use of _defer_name() entirely, except for the \"none\" version:\r\n\r\n```diff\r\ndiff --git a/lib/sqlalchemy/sql/sqltypes.py b/lib/sqlalchemy/sql/sqltypes.py\r\nindex 52e5053ef..e90df374b 100644\r\n--- a/lib/sqlalchemy/sql/sqltypes.py\r\n+++ b/lib/sqlalchemy/sql/sqltypes.py\r\n@@ -1132,7 +1132,7 @@ class Enum(String, SchemaType):\r\n \r\n         e = schema.CheckConstraint(\r\n                         type_coerce(column, self).in_(self.enums),\r\n-                        name=_defer_name(self.name),\r\n+                        name=_defer_name(self.name) if self.name is None else self.name,\r\n                         _create_rule=util.portable_instancemethod(\r\n                                         self._should_create_constraint)\r\n                     )\r\n@@ -1268,7 +1268,7 @@ class Boolean(TypeEngine, SchemaType):\r\n \r\n         e = schema.CheckConstraint(\r\n                         type_coerce(column, self).in_([0, 1]),\r\n-                        name=_defer_name(self.name),\r\n+                        name=_defer_name(self.name) if self.name is None else self.name,\r\n                         _create_rule=util.portable_instancemethod(\r\n                                     self._should_create_constraint)\r\n                     )\r\n\r\n```\r\n\r\nand then all the tests pass! nothing breaks, just the \"none name\" part needs an extra conditional in compiler.py.\r\n\r\nso i think i can try to approach this by taking out \"_defer_name\" altogether and just having there be a token for \"name is none\" , which is just so it can raise an error later on in that case.      \r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/792185908/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/792195508","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/6007#issuecomment-792195508","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/6007","id":792195508,"node_id":"MDEyOklzc3VlQ29tbWVudDc5MjE5NTUwOA==","user":{"login":"sqla-tester","id":8250554,"node_id":"MDQ6VXNlcjgyNTA1NTQ=","avatar_url":"https://avatars.githubusercontent.com/u/8250554?v=4","gravatar_id":"","url":"https://api.github.com/users/sqla-tester","html_url":"https://github.com/sqla-tester","followers_url":"https://api.github.com/users/sqla-tester/followers","following_url":"https://api.github.com/users/sqla-tester/following{/other_user}","gists_url":"https://api.github.com/users/sqla-tester