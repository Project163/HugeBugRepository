tic.co/products/elasticsearch","size":1565901,"stargazers_count":76300,"watchers_count":76300,"language":"Java","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":25807,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":5584,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["elasticsearch","java","search-engine"],"visibility":"public","forks":25807,"open_issues":5584,"watchers":76300,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/elastic/elasticsearch/pulls/139337","html_url":"https://github.com/elastic/elasticsearch/pull/139337","diff_url":"https://github.com/elastic/elasticsearch/pull/139337.diff","patch_url":"https://github.com/elastic/elasticsearch/pull/139337.patch","merged_at":"2025-12-16T04:10:27Z"},"body":"The dash character is used as a prefix to signify index exclusion. It should not be used on its own. For example, an expression like `*,-` should be invalid. However, today this is handled differently depending on whether security is enabled or disabled. When security is enabled, the standalone exclusion char is ignored and the expression is handled as just `*`. But when security is disabled, the expression encounters an IndexNotFoundException.\r\n\r\nThis PR fixes the inconsistency by always throwing InvalidIndexNameException. In addition, this PR also fixes #45504 by ensuring InvalidIndexNameException is thrown for empty index name instead of IndexOutOfBoundsException.\r\n\r\nResolves: #45504","reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/139337/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"