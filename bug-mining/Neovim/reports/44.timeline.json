users/brammool/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brammool/subscriptions","organizations_url":"https://api.github.com/users/brammool/orgs","repos_url":"https://api.github.com/users/brammool/repos","events_url":"https://api.github.com/users/brammool/events{/privacy}","received_events_url":"https://api.github.com/users/brammool/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"mentioned","commit_id":null,"commit_url":null,"created_at":"2017-08-18T17:07:01Z","performed_via_github_app":null},{"id":1212243052,"node_id":"MDE1OlN1YnNjcmliZWRFdmVudDEyMTIyNDMwNTI=","url":"https://api.github.com/repos/neovim/neovim/issues/events/1212243052","actor":{"login":"brammool","id":8530623,"node_id":"MDQ6VXNlcjg1MzA2MjM=","avatar_url":"https://avatars.githubusercontent.com/u/8530623?v=4","gravatar_id":"","url":"https://api.github.com/users/brammool","html_url":"https://github.com/brammool","followers_url":"https://api.github.com/users/brammool/followers","following_url":"https://api.github.com/users/brammool/following{/other_user}","gists_url":"https://api.github.com/users/brammool/gists{/gist_id}","starred_url":"https://api.github.com/users/brammool/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brammool/subscriptions","organizations_url":"https://api.github.com/users/brammool/orgs","repos_url":"https://api.github.com/users/brammool/repos","events_url":"https://api.github.com/users/brammool/events{/privacy}","received_events_url":"https://api.github.com/users/brammool/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2017-08-18T17:07:01Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/neovim/neovim/issues/comments/323466487","html_url":"https://github.com/neovim/neovim/issues/6726#issuecomment-323466487","issue_url":"https://api.github.com/repos/neovim/neovim/issues/6726","id":323466487,"node_id":"MDEyOklzc3VlQ29tbWVudDMyMzQ2NjQ4Nw==","user":{"login":"chrisbra","id":244927,"node_id":"MDQ6VXNlcjI0NDkyNw==","avatar_url":"https://avatars.githubusercontent.com/u/244927?v=4","gravatar_id":"","url":"https://api.github.com/users/chrisbra","html_url":"https://github.com/chrisbra","followers_url":"https://api.github.com/users/chrisbra/followers","following_url":"https://api.github.com/users/chrisbra/following{/other_user}","gists_url":"https://api.github.com/users/chrisbra/gists{/gist_id}","starred_url":"https://api.github.com/users/chrisbra/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chrisbra/subscriptions","organizations_url":"https://api.github.com/users/chrisbra/orgs","repos_url":"https://api.github.com/users/chrisbra/repos","events_url":"https://api.github.com/users/chrisbra/events{/privacy}","received_events_url":"https://api.github.com/users/chrisbra/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-08-18T21:36:44Z","updated_at":"2017-08-18T21:36:44Z","body":"I see the problem. The obvious segfault can be fixed with this patch:\r\n```\r\ndiff --git a/src/ops.c b/src/ops.c\r\nindex 9ca5198d2..e50b8fda5 100644\r\n--- a/src/ops.c\r\n+++ b/src/ops.c\r\n@@ -3064,8 +3064,9 @@ op_yank(oparg_T *oap, int deleting, int mess)\r\n                            {\r\n                                /* Part of a tab selected -- but don't\r\n                                 * double-count it. */\r\n-                               bd.startspaces = (ce - cs + 1)\r\n-                                                         - oap->start.coladd;\r\n+                               bd.startspaces = (ce - cs + 1);\r\n+                               if (bd.startspaces > oap->start.coladd)\r\n+                                   bd.startspaces -= oap->start.coladd;\r\n                                startcol++;\r\n                            }\r\n                        }\r\n```\r\nHowever, while this fixes the segfault, yank_copy_lines does copy too much and breaks my test. I think, this is caused because `curwin->w_pcmark.col` is set to 0 because of using visual line selection which makes the cursor before `curwin->w_cursor.pos=0` before doing `ce`, while it should be 1. I am scratching my head, where this needs to be fixed however. ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/neovim/neovim/issues/comments/323466487/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"chrisbra","id":244927,"node_id":"MDQ6VXNlcjI0NDkyNw==","avatar_url":"https://avatars.githubusercontent.com/u/244927?v=4","gravatar_id":"","url":"https://api.github.com/users/chrisbra","html_url":"https://github.com/chrisbra","followers_url":"https://api.github.com/users/chrisbra/followers","following_url":"https://api.github.com/users/chrisbra/following{/other_user}","gists_url":"https://api.github.com/users/chrisbra/gists{/gist_id}","starred_url":"https://api.github.com/users/chrisbra/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chrisbra/subscriptions","organizations_url":"https://api.github.com/users/chrisbra/orgs","repos_url":"https://api.github.com/users/chrisbra/repos","events_url":"https://api.github.com/users/chrisbra/events{/privacy}","received_events_url":"https://api.github.com/users/chrisbra/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1212614183,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDEyMTI2MTQxODM=","url":"https://api.github.com/repos/neovim/neovim/issues/events/1212614183","actor":{"login":"chrisbra","id":244927,"node_id":"MDQ6VXNlcjI0NDkyNw==","avatar_url":"https://avatars.githubusercontent.com/u/244927?v=4","gravatar_id":"","url":"https://api.github.com/users/chrisbra","html_url":"https://github.com/chrisbra","followers_url":"https://api.github.com/users/chrisbra/followers","following_url":"https://api.github.com/users/chrisbra/following{/other_user}","gists_url":"https://api.github.com/users/chrisbra/gists{/gist_id}","starred_url":"https://api.github.com/users/chrisbra/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chrisbra/subscriptions","organizations_url":"https://api.github.com/users/chrisbra/orgs","repos_url":"https://api.github.com/users/chrisbra/repos","events_url":"https://api.github.com/users/chrisbra/events{/privacy}","received_events_url":"https://api.github.com/users/chrisbra/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"b50ae871bdfba84ab3157be0da96f579d53e6a24","commit_url":"https://api.github.com/repos/chrisbra/vim/commits/b50ae871bdfba84ab3157be0da96f579d53e6a24","created_at":"2017-08-18T21:45:14Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/neovim/neovim/issues/comments/323522084","html_url":"https://github.com/neovim/neovim/issues/6726#issuecomment-323522084","issue_url":"https://api.github.com/repos/neovim/neovim/issues/6726","id":323522084,"node_id":"MDEyOklzc3VlQ29tbWVudDMyMzUyMjA4NA==","user":{"login":"brammool","id":8530623,"node_id":"MDQ6VXNlcjg1MzA2MjM=","avatar_url":"https://avatars.githubusercontent.com/u/8530623?v=4","gravatar_id":"","url":"https://api.github.com/users/brammool","html_url":"https://github.com/brammool","followers_url":"https://api.github.com/users/brammool/followers","following_url":"https://api.github.com/users/brammool/following{/other_user}","gists_url":"https://api.github.com/users/brammool/gists{/gist_id}","starred_url":"https://api.github.com/users/brammool/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brammool/subscriptions","organizations_url":"https://api.github.com/users/brammool/orgs","repos_url":"https://api.github.com/users/brammool/repos","events_url":"https://api.github.com/users/brammool/events{/privacy}","received_events_url":"https://api.github.com/users/brammool/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-08-19T13:06:05Z","updated_at":"2017-08-19T13:06:05Z","body":"\nChristian wrote:\n\n> I see the problem. The obvious segfault can be fixed with this patch:\n> ```\n> diff --git a/src/ops.c b/src/ops.c\n> index 9ca5198d2..e50b8fda5 100644\n> --- a/src/ops.c\n> +++ b/src/ops.c\n> @@ -3064,8 +3064,9 @@ op_yank(oparg_T *oap, int deleting, int mess)\n>                             {\n>                                 /* Part of a tab selected -- but don't\n>                                  * double-count it. */\n> -                               bd.startspaces = (ce - cs + 1)\n> -                                                         - oap->start.coladd;\n> +                               bd.startspaces = (ce - cs + 1);\n> +                               if (bd.startspaces > oap->start.coladd)\n> +                                   bd.startspaces -= oap->start.coladd;\n>                                 startcol++;\n>                             }\n>                         }\n> ```\n> However, while this fixes the segfault, yank_copy_lines does copy too\n> much and breaks my test. I think, this is caused because\n> `curwin->w_pcmark.col` is set to 0 because of using visual line\n> selection which makes the cursor before `curwin->w_cursor.pos=0`\n> before doing `ce`, while it should be 1. I am scratching my head,\n> where this needs to be fixed however. \n\nThanks for looking into this.  The problem is that \"coladd\" is larger\nthan the width of the character.  Thus somewhere \"coladd\" gets a wrong\nvalue.  This appears to be in do_pending_perator, where start.col is set\nto zero, but coladd isn't reset.\n\nOn top of that, when using a mark the column is not checked to be valid.\nAnd even if we do check, it doesn't verify the value of coladd.\n\nSo we need three fixes.  And I'll turn the example into a test.\n\n-- \nHacker: Someone skilled in computer programming (good guy).\nCracker: A hacker that uses his skills to crack software (bad guy).\n\n /// Bram Moolenaar -- Bram@Moolenaar.net -- http://www.Moolenaar.net   \\\\\\\n///        sponsor Vim, vote for features -- http://www.Vim.org/sponsor/ \\\\\\\n\\\\\\  an exciting new programming language -- http://www.Zimbu.org        ///\n \\\\\\            help me help AIDS victims -- http://ICCF-Holland.org    ///\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/neovim/neovim/issues/comments/323522084/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"brammool","id":8530623,"node_id":"MDQ6VXNlcjg1MzA2MjM=","avatar_url":"https://avatars.githubusercontent.com/u/8530623?v=4","gravatar_id":"","url":"https://api.github.com/users/brammool","html_url":"https://github.com/brammool","followers_url":"https://api.github.com/users/brammool/followers","following_url":"https://api.github.com/users/brammool/following{/other_user}","gists_url":"https://api.github.com/users/brammool/gists{/gist_id}","starred_url":"https://api.github.com/users/brammool/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brammool/subscriptions","organizations_url":"https://api.github.com/users/brammool/orgs","repos_url":"https://api.github.com/users/brammool/repos","events_url":"https://api.github.com/users/brammool/events{/privacy}","received_events_url":"https://api.github.com/users/brammool/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/neovim/neovim/issues/comments/329960585","html_url":"https://github.com/neovim/neovim/issues/6726#issuecomment-329960585","issue_url":"https://api.github.com/repos/neovim/neovim/issues/6726","id":329960585,"node_id":"MDEyOklzc3VlQ29tbWVudDMyOTk2MDU4NQ==","user":{"login":"