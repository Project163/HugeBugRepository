+                            $input_callable = new TCallable(
+                                'callable',
+                                $method_storage->params,
+                                $method_storage->return_type
+                            );
+                        } catch (\Exception $e) {
+                            // do nothing
+                        }
+                    }
+                }
+            }
+
+            if ($input_callable) {
+                $all_types_contain = true;
+
+                if (self::compareCallable(
+                    $codebase,
+                    $input_callable,
+                    $container_type_part,
+                    $type_coerced,
+                    $type_coerced_from_mixed,
+                    $has_scalar_match,
+                    $all_types_contain
+                ) === false
+                ) {
+                    return false;
+                }
+
+                if (!$all_types_contain) {
+                    return false;
+                }
+            }
+
             return true;
         }
 
