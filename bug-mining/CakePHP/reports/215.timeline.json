story","followers_url":"https://api.github.com/users/markstory/followers","following_url":"https://api.github.com/users/markstory/following{/other_user}","gists_url":"https://api.github.com/users/markstory/gists{/gist_id}","starred_url":"https://api.github.com/users/markstory/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/markstory/subscriptions","organizations_url":"https://api.github.com/users/markstory/orgs","repos_url":"https://api.github.com/users/markstory/repos","events_url":"https://api.github.com/users/markstory/events{/privacy}","received_events_url":"https://api.github.com/users/markstory/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-11-08T02:52:24Z","updated_at":"2014-11-08T02:52:24Z","body":"I wasn't able to reproduce this issue. I tried the following:\n\n``` php\n        $users = TableRegistry::get('Users');\n        $users->hasOne('Profiles', [\n            'conditions' => ['is_primary' => true]\n        ]);\n\n        $user = $users->newEntity([\n            'username' => 'mark',\n            'password' => 'secret',\n            'profile' => [\n                'twitter' => 'mark_story',\n                'is_primary' => true,\n            ]\n        ]);\n        $users->save($user);\n\n        $user->profile = $users->Profiles->newEntity([\n            'twitter' => 'example',\n            'is_primary' => true\n        ]);\n        $users->save($user);\n```\n\nWhich created the following SQL:\n\n``` sql\n2014-11-08 02:49:14 Debug: BEGIN\n2014-11-08 02:49:14 Debug: INSERT INTO `users` (`username`, `password`) VALUES ('mark', 'secret')\n2014-11-08 02:49:14 Debug: INSERT INTO `profiles` (`user_id`, `is_primary`, `twitter`) VALUES (10, 1, 'mark_story')\n2014-11-08 02:49:14 Debug: COMMIT\n2014-11-08 02:49:14 Debug: BEGIN\n2014-11-08 02:49:14 Debug: INSERT INTO `profiles` (`user_id`, `is_primary`, `twitter`) VALUES (10, 1, 'example')\n2014-11-08 02:49:14 Debug: COMMIT\n```\n\nMy schema was:\n\n``` sql\nCREATE TABLE `users` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `username` varchar(255) DEFAULT NULL,\n  `password` varchar(400) DEFAULT NULL,\n  `created` datetime DEFAULT NULL,\n  `modified` datetime DEFAULT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB AUTO_INCREMENT=11 DEFAULT CHARSET=utf8;\n\nCREATE TABLE `profiles` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `is_primary` tinyint(1) DEFAULT '0',\n  `twitter` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB AUTO_INCREMENT=3 DEFAULT CHARSET=utf8;\n```\n\nBoth my table classes were default `Cake\\ORM\\Table` instances. Without additional information, no fix can be made as I don't know how to reproduce the issue.\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/62242757/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"markstory","id":24086,"node_id":"MDQ6VXNlcjI0MDg2","avatar_url":"https://avatars.githubusercontent.com/u/24086?v=4","gravatar_id":"","url":"https://api.github.com/users/markstory","html_url":"https://github.com/markstory","followers_url":"https://api.github.com/users/markstory/followers","following_url":"https://api.github.com/users/markstory/following{/other_user}","gists_url":"https://api.github.com/users/markstory/gists{/gist_id}","starred_url":"https://api.github.com/users/markstory/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/markstory/subscriptions","organizations_url":"https://api.github.com/users/markstory/orgs","repos_url":"https://api.github.com/users/markstory/repos","events_url":"https://api.github.com/users/markstory/events{/privacy}","received_events_url":"https://api.github.com/users/markstory/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":190271981,"node_id":"M