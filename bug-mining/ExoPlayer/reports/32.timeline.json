an-gpfw/following{/other_user}","gists_url":"https://api.github.com/users/ptran-gpfw/gists{/gist_id}","starred_url":"https://api.github.com/users/ptran-gpfw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ptran-gpfw/subscriptions","organizations_url":"https://api.github.com/users/ptran-gpfw/orgs","repos_url":"https://api.github.com/users/ptran-gpfw/repos","events_url":"https://api.github.com/users/ptran-gpfw/events{/privacy}","received_events_url":"https://api.github.com/users/ptran-gpfw/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-04-23T22:12:51Z","updated_at":"2015-04-23T22:12:59Z","body":"I've seen a similar OWNED_BY_DOWNSTREAM error when I was using MediaCodec before ExoPlayer existed. What device and OS are you using? Custom ROM? I've seen codec reconfig issues when using non-stock ROM?\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/95733015/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ptran-gpfw","id":3084650,"node_id":"MDQ6VXNlcjMwODQ2NTA=","avatar_url":"https://avatars.githubusercontent.com/u/3084650?v=4","gravatar_id":"","url":"https://api.github.com/users/ptran-gpfw","html_url":"https://github.com/ptran-gpfw","followers_url":"https://api.github.com/users/ptran-gpfw/followers","following_url":"https://api.github.com/users/ptran-gpfw/following{/other_user}","gists_url":"https://api.github.com/users/ptran-gpfw/gists{/gist_id}","starred_url":"https://api.github.com/users/ptran-gpfw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ptran-gpfw/subscriptions","organizations_url":"https://api.github.com/users/ptran-gpfw/orgs","repos_url":"https://api.github.com/users/ptran-gpfw/repos","events_url":"https://api.github.com/users/ptran-gpfw/events{/privacy}","received_events_url":"https://api.github.com/users/ptran-gpfw/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/95884251","html_url":"https://github.com/google/ExoPlayer/issues/400#issuecomment-95884251","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/400","id":95884251,"node_id":"MDEyOklzc3VlQ29tbWVudDk1ODg0MjUx","user":{"login":"krok55","id":3122749,"node_id":"MDQ6VXNlcjMxMjI3NDk=","avatar_url":"https://avatars.githubusercontent.com/u/3122749?v=4","gravatar_id":"","url":"https://api.github.com/users/krok55","html_url":"https://github.com/krok55","followers_url":"https://api.github.com/users/krok55/followers","following_url":"https://api.github.com/users/krok55/following{/other_user}","gists_url":"https://api.github.com/users/krok55/gists{/gist_id}","starred_url":"https://api.github.com/users/krok55/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/krok55/subscriptions","organizations_url":"https://api.github.com/users/krok55/orgs","repos_url":"https://api.github.com/users/krok55/repos","events_url":"https://api.github.com/users/krok55/events{/privacy}","received_events_url":"https://api.github.com/users/krok55/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-04-24T10:29:24Z","updated_at":"2015-04-24T10:30:46Z","body":"Hi,\nI have two android mini-tv boxes: one is CX-919 with 4.2.2 \"stock\" ROM, the other one is MK808 with 4.1.\nThe problem happens on both devices with the same scenario, but with different symptoms:\nOn CX-919 you see the crash above, while on MK808 I see strange rendering artifacts (like split screen and snow during playback).\nThe scenario is always the same: use a multi-variant  HLS source (for example 0,1,2 - where 0 is the best-quality) and wait until a situation where ExoPlayer decided to switch from a lower-quality source to a higher one. \nI've also added some printings in HlsChuckSource::getChunkOperation() and I noticed that in the given scenario the player simply \"ignores\" higher quality chunks, and crashes (on Acodec) while reaching to the last buffered chunk of the lower-quality sample.\nI'm starting to suspect that maybe the higher-quality sample isn't perfectly aligned with the lower one.\nFor example: if the \"lower\" chunk contains video from 0 to 6000000us, then the \"higher\" one doesn't continue the video smoothly at 6000000us...\nI really want to understand how to smooth-transition between different variants is designed to work, so I will be able to try to dig-in deeper in to this...\n\nAny thought on this?\n\nThanks.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/95884251/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"krok55","id":3122749,"node_id":"MDQ6VXNlcjMxMjI3NDk=","avatar_url":"https://avatars.githubusercontent.com/u/3122749?v=4","gravatar_id":"","url":"https://api.github.com/users/krok55","html_url":"https://github.com/krok55","followers_url":"https://api.github.com/users/krok55/followers","following_url":"https://api.github.com/users/krok55/following{/other_user}","gists_url":"https://api.github.com/users/krok55/gists{/gist_id}","starred_url":"https://api.github.com/users/krok55/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/krok55/subscriptions","organizations_url":"https://api.github.com/users/krok55/orgs","repos_url":"https://api.github.com/users/krok55/repos","events_url":"https://api.github.com/users/krok55/events{/privacy}","received_events_url":"https://api.github.com/users/krok55/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/100676390","html_url":"https://github.com/google/ExoPlayer/issues/400#issuecomment-100676390","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/400","id":100676390,"node_id":"MDEyOklzc3VlQ29tbWVudDEwMDY3NjM5MA==","user":{"login":"krok55","id":3122749,"node_id":"MDQ6VXNlcjMxMjI3NDk=","avatar_url":"https://avatars.githubusercontent.com/u/3122749?v=4","gravatar_id":"","url":"https://api.github.com/users/krok55","html_url":"https://github.com/krok55","followers_url":"https://api.github.com/users/krok55/followers","following_url":"https://api.github.com/users/krok55/following{/other_user}","gists_url":"https://api.github.com/users/krok55/gists{/gist_id}","starred_url":"https://api.github.com/users/krok55/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/krok55/subscriptions","organizations_url":"https://api.github.com/users/krok55/orgs","repos_url":"https://api.github.com/users/krok55/repos","events_url":"https://api.github.com/users/krok55/events{/privacy}","received_events_url":"https://api.github.com/users/krok55/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-05-10T18:17:01Z","updated_at":"2015-05-10T18:17:01Z","body":"OK, I think I found a workaround.\nThe problem seems to be in HlsChunkSource.getChunkOperation()\nBy the end of this method, there are several lines that deal with reconfiguring the extractor in case of variant switch detection:\n\n``` Java\n   // Configure the extractor that will read the chunk.\n    HlsExtractor extractor;\n    if (previousTsChunk == null || segment.discontinuity || switchingVariant || liveDiscontinuity) {\n      extractor = chunkUri.getLastPathSegment().endsWith(AAC_FILE_EXTENSION)\n          ? new AdtsExtractor(switchingVariantSpliced, startTimeUs, bufferPool)\n          : new TsExtractor(switchingVariantSpliced, startTimeUs, bufferPool);\n    } else {\n      extractor = previousTsChunk.extractor;\n    }\n\n    return new TsChunk(dataSource, dataSpec, extractor, enabledVariants[variantIndex].index,\n        startTimeUs, endTimeUs, chunkMediaSequence, isLastChunk);\n```\n\nThis code works fine, if `switchingVarinat` is set to true in the same call where the new variant index is set in line 263:\n\n``` Java\nvariantIndex = nextVariantIndex;\n```\n\nHowever,\nThere are several exit points earlier in this method:\nLines 289-296:\n\n``` Java\n    int chunkIndex = chunkMediaSequence - mediaPlaylist.mediaSequence;\n    if (chunkIndex >= mediaPlaylist.segments.size()) {\n      if (mediaPlaylist.live && shouldRerequestMediaPlaylist(variantIndex)) {\n        return newMediaPlaylistChunk(variantIndex);\n      } else {\n        return null;\n      }\n    }\n```\n\nAnd in lines 301-314:\n\n``` Java\n    // Check if encryption is specified.\n    if (HlsMediaPlaylist.ENCRYPTION_METHOD_AES_128.equals(segment.encryptionMethod)) {\n      Uri keyUri = Util.getMergedUri(mediaPlaylist.baseUri, segment.encryptionKeyUri);\n      if (!keyUri.equals(encryptionKeyUri)) {\n        // Encryption is specified and the key has changed.\n        HlsChunk toReturn = newEncryptionKeyChunk(keyUri, segment.encryptionIV);\n        return toReturn;\n      }\n      if (!Util.areEqual(segment.encryptionIV, encryptedDataSourceIv)) {\n        initEncryptedDataSource(keyUri, segment.encryptionIV, encryptedDataSourceSecretKey);\n      }\n    } else {\n      clearEncryptedDataSource();\n    }\n```\n\nThis causes the new variant index to be set, but without updating the corresponding extractor. (In the next call to `getChunkOperation` we won't set `switchingVariants` again).\n\nI have a patched solution to this problem. If you want me to push - please instruct me where.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/100676390/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"krok55","id":3122749,"node_id":"MDQ6VXNlcjMxMjI3NDk=","avatar_url":"https://avatars.githubusercontent.com/u/3122749?v=4","gravatar_id":"","url":"https://api.github.com/users/krok55","html_url":"https://github.com/krok55","followers_url":"https://api.github.com/users/krok55/followers","following_url":"https://api.github.com/users/krok55/following{/other_user}","gists_url":"https://api.github.com/users/krok55/gists{/gist_id}","starred_url":"https://api.github.com/users/krok55/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/krok55/subscriptions","organizations_url":"https://api.github.com/users/krok55/orgs","repos_url":"https://api.github.com/users/krok55/repos","events_url":"https://api.github.com/users/krok55/events{/privacy}","received_events_url":"https://api.github.com/users/krok55/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/100701207","html_url":"https://github.com/google/ExoPlayer/issues/400#issuecomment-100701207","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/400","id":100701207,"node_id":"MDEyOklzc3VlQ29tbWVudDEwMDcwMTIwNw==","user":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","ty