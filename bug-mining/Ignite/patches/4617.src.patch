diff --git a/modules/tools/src/main/java/org/apache/ignite/tools/checkstyle/OverrideAnnotationOnTheSameLineCheck.java b/modules/tools/src/main/java/org/apache/ignite/tools/checkstyle/OverrideAnnotationOnTheSameLineCheck.java
new file mode 100644
index 0000000000..54a72171b5
--- /dev/null
+++ b/modules/tools/src/main/java/org/apache/ignite/tools/checkstyle/OverrideAnnotationOnTheSameLineCheck.java
@@ -0,0 +1,100 @@
+/*
