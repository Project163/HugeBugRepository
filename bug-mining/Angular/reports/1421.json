nes/82/labels","id":3045967,"node_id":"MDk6TWlsZXN0b25lMzA0NTk2Nw==","number":82,"title":"Backlog","description":"Milestone for triaged issues that have not yet been scheduled for resolution.","creator":{"login":"IgorMinar","id":216296,"node_id":"MDQ6VXNlcjIxNjI5Ng==","avatar_url":"https://avatars.githubusercontent.com/u/216296?v=4","gravatar_id":"","url":"https://api.github.com/users/IgorMinar","html_url":"https://github.com/IgorMinar","followers_url":"https://api.github.com/users/IgorMinar/followers","following_url":"https://api.github.com/users/IgorMinar/following{/other_user}","gists_url":"https://api.github.com/users/IgorMinar/gists{/gist_id}","starred_url":"https://api.github.com/users/IgorMinar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/IgorMinar/subscriptions","organizations_url":"https://api.github.com/users/IgorMinar/orgs","repos_url":"https://api.github.com/users/IgorMinar/repos","events_url":"https://api.github.com/users/IgorMinar/events{/privacy}","received_events_url":"https://api.github.com/users/IgorMinar/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":681,"closed_issues":22796,"state":"open","created_at":"2018-01-18T16:52:20Z","updated_at":"2026-03-11T09:12:24Z","due_on":null,"closed_at":null},"comments":12,"created_at":"2018-01-17T21:48:18Z","updated_at":"2022-03-05T16:06:10Z","closed_at":"2022-02-02T19:51:30Z","assignee":{"login":"jasonaden","id":516168,"node_id":"MDQ6VXNlcjUxNjE2OA==","avatar_url":"https://avatars.githubusercontent.com/u/516168?v=4","gravatar_id":"","url":"https://api.github.com/users/jasonaden","html_url":"https://github.com/jasonaden","followers_url":"https://api.github.com/users/jasonaden/followers","following_url":"https://api.github.com/users/jasonaden/following{/other_user}","gists_url":"https://api.github.com/users/jasonaden/gists{/gist_id}","starred_url":"https://api.github.com/users/jasonaden/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jasonaden/subscriptions","organizations_url":"https://api.github.com/users/jasonaden/orgs","repos_url":"https://api.github.com/users/jasonaden/repos","events_url":"https://api.github.com/users/jasonaden/events{/privacy}","received_events_url":"https://api.github.com/users/jasonaden/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Angular's router upgrade code provides a setUpLocationSync method which listens for AngularJS-initiated $locationChangeStart events, then calls Angular's router.navigateByUrl. The docs for this method state that \"History.pushState does not fire onPopState, so the Angular location doesn't detect it. The workaround is to attach a location change listener\"(https://github.com/angular/angular/blob/e4c53f8529b88ea574f41010b3277374a6f42fe1/packages/router/upgrade/src/upgrade.ts#L55). Without this code, the Angular router does not respond to location changes initiated by AngularJS, regardless of whether the pages themselves are associated w/ AngularJS or Angular content. For example, AngularJS-based navigation links would fail to trigger a routing event between two Angular pages.\r\n\r\nWhile this code works for AngularJS-initiated location changes, it currently produces duplicate NavigationStart, etc. events for Angular-initiated changes. The AngularJS router sees that the browser location has changed and triggers a location change event, which in turn triggers an additional NavigationStart event in Angular. It appears that we need some way to trigger Angular navigation only for location changes that originate in AngularJS.\r\n\r\nThis issue is currently causing duplicate router events for any Angular-driven page transition in dual-router apps, which is a performance issue.","closed_by":{"login":"jessicajaniuk","id":72768744,"node_id":"MDQ6VXNlcjcyNzY4NzQ0","avatar_url":"https://avatars.githubusercontent.com/u/72768744?v=4","gravatar_id":"","url":"https://api.github.com/users/jessicajaniuk","html_url":"https://github.com/jessicajaniuk","followers_url":"https://api.github.com/users/jessicajaniuk/followers","following_url":"https://api.github.com/users/jessicajaniuk/following{/other_user}","gists_url":"https://api.github.com/users/jessicajaniuk/gists{/gist_id}","starred_url":"https://api.github.com/users/jessicajaniuk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jessicajaniuk/subscriptions","organizations_url":"https://api.github.com/users/jessicajaniuk/orgs","repos_url":"https://api.github.com/users/jessicajaniuk/repos","events_url":"https://api.github.com/users/jessicajaniuk/events{/privacy}","received_events_url":"https://api.github.com/users/jessicajaniuk/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/21610/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/angular/angular/issues/21610/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}