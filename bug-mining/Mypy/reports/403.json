ncremental","name":"topic-fine-grained-incremental","color":"d93f0b","default":false,"description":null}],"state":"closed","locked":false,"assignee":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2018-03-13T10:29:51Z","updated_at":"2018-03-14T00:32:12Z","closed_at":"2018-03-14T00:32:12Z","author_association":"COLLABORATOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"This fine-grained incremental mode test case causes a crash:\r\n\r\n```\r\n[case testChangeFunctionToVariableAndRefreshUsingStaleDependency]\r\nimport a\r\nimport c\r\n[file a.py]\r\nimport c\r\ndef f() -> c.A: pass\r\n[file a.py.2]\r\nf = 1\r\n[file c.py]\r\nclass A: pass\r\n[file c.py.3]\r\n[out]\r\n==\r\n```\r\n\r\nHere's a traceback:\r\n\r\n```\r\n________________________ testChangeFunctionToVariableAndRefreshUsingStaleDependency _________________________\r\ndata: /Users/jukka/src/mypy/test-data/unit/fine-grained.test:2836:\r\n/Users/jukka/src/mypy/mypy/test/testfinegrained.py:112: in run_case\r\n    new_messages = self.run_check(server, sources)\r\n/Users/jukka/src/mypy/mypy/test/testfinegrained.py:172: in run_check\r\n    response = server.check(sources)\r\n/Users/jukka/src/mypy/mypy/dmypy_server.py:244: in check\r\n    return self.check_fine_grained(sources)\r\n/Users/jukka/src/mypy/mypy/dmypy_server.py:283: in check_fine_grained\r\n    return self.fine_grained_increment(sources)\r\n/Users/jukka/src/mypy/mypy/dmypy_server.py:352: in fine_grained_increment\r\n    messages = self.fine_grained_manager.update(changed, removed)\r\n/Users/jukka/src/mypy/mypy/server/update.py:239: in update\r\n    result = self.update_single(next_id, next_path, next_id in removed_set)\r\n/Users/jukka/src/mypy/mypy/server/update.py:318: in update_single\r\n    self.previous_targets_with_errors)\r\n/Users/jukka/src/mypy/mypy/server/update.py:694: in propagate_changes_using_dependencies\r\n    manager.modules, up_to_date_modules)\r\n/Users/jukka/src/mypy/mypy/server/update.py:761: in find_targets_recursive\r\n    deferred = lookup_target(modules, target)\r\n/Users/jukka/src/mypy/mypy/server/update.py:944: in lookup_target\r\n    OverloadedFuncDef)), 'unexpected type: %s' % type(node)\r\nE   AssertionError: unexpected type: <class 'mypy.nodes.Var'>\r\n```\r\n\r\nThe reason for the crash is that we are trying to refresh a function based on a stale dependency, but the function has been changed into a variable. The daemon doesn't expect to see a variable and dies. Instead, we should probably just ignore the variable node. Removing stale dependencies is probably not worth it.\r\n\r\nThe test case is derived from a real-world example.","closed_by":{"login":"msullivan","id":340349,"node_id":"MDQ6VXNlcjM0MDM0OQ==","avatar_url":"https://avatars.githubusercontent.com/u/340349?v=4","gravatar_id":"","url":"https://api.github.com/users/msullivan","html_url":"https://github.com/msullivan","followers_url":"https://api.github.com/users/msullivan/followers","following_url":"https://api.github.com/users/msullivan/following{/other_user}","gists_url":"https://api.github.com/users/msullivan/gists{/gist_id}","starred_url":"https://api.github.com/users/msullivan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/msullivan/subscriptions","organizations_url":"https://api.github.com/users/msullivan/orgs","repos_url":"https://api.github.com/users/msullivan/repos","events_url":"https://api.github.com/users/msullivan/events{/privacy}","received_events_url":"https://api.github.com/users/msullivan/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/python/mypy/issues/4723/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/mypy/issues/4723/timeline","performed_via_github_app":null,"state_reason":"completed"}