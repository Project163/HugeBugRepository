@@ -0,0 +1,20 @@
+package io.quarkus.it.mockbean;
+
+import java.util.concurrent.atomic.AtomicBoolean;
+
+import jakarta.annotation.PostConstruct;
+
+public class RequestScopedFooFromProducer {
+
+    static final AtomicBoolean CONSTRUCTED = new AtomicBoolean();
+
+    public String ping() {
+        return "bar";
+    }
+
+    @PostConstruct
+    void init() {
+        CONSTRUCTED.set(true);
+    }
+
+}
diff --git a/integration-tests/injectmock/src/main/java/io/quarkus/it/mockbean/RequestScopedProducer.java b/integration-tests/injectmock/src/main/java/io/quarkus/it/mockbean/RequestScopedProducer.java
