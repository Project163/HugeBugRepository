<item>
            <title>[IGNITE-17145] Fix handle BinaryObjectException at the thin JDBC</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-17145</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;I am trying to get enum field using sqlline, but failed with error Statement is closed.&lt;/p&gt;

&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
0: jdbc:ignite:thin:&lt;span class=&quot;code-comment&quot;&gt;//127.0.0.1&amp;gt; select status from nebulaclusterinfo;
&lt;/span&gt;Error: Statement is closed. (state=,code=0)
java.sql.SQLException: Statement is closed.
	at org.apache.ignite.internal.jdbc.thin.JdbcThinStatement.ensureNotClosed(JdbcThinStatement.java:950)
	at org.apache.ignite.internal.jdbc.thin.JdbcThinStatement.getWarnings(JdbcThinStatement.java:546)
	at sqlline.Commands.execute(Commands.java:849)
	at sqlline.Commands.sql(Commands.java:733)
	at sqlline.SqlLine.dispatch(SqlLine.java:795)
	at sqlline.SqlLine.begin(SqlLine.java:668)
	at sqlline.SqlLine.start(SqlLine.java:373)
	at sqlline.SqlLine.main(SqlLine.java:265)

0: jdbc:ignite:thin:&lt;span class=&quot;code-comment&quot;&gt;//127.0.0.1&amp;gt; select count(status) from nebulaclusterinfo;
&lt;/span&gt;+--------------------------------+
|         COUNT(STATUS)          |
+--------------------------------+
| 310                            |
+--------------------------------+
1 row selected (0.108 seconds)
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</description>
