es"},{"id":1419821900,"node_id":"MDU6TGFiZWwxNDE5ODIxOTAw","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/priority/medium","name":"priority/medium","color":"ffdc5e","default":false,"description":"Medium priority issue"}],"state":"closed","locked":false,"assignee":{"login":"spolitov","id":891914,"node_id":"MDQ6VXNlcjg5MTkxNA==","avatar_url":"https://avatars.githubusercontent.com/u/891914?v=4","gravatar_id":"","url":"https://api.github.com/users/spolitov","html_url":"https://github.com/spolitov","followers_url":"https://api.github.com/users/spolitov/followers","following_url":"https://api.github.com/users/spolitov/following{/other_user}","gists_url":"https://api.github.com/users/spolitov/gists{/gist_id}","starred_url":"https://api.github.com/users/spolitov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/spolitov/subscriptions","organizations_url":"https://api.github.com/users/spolitov/orgs","repos_url":"https://api.github.com/users/spolitov/repos","events_url":"https://api.github.com/users/spolitov/events{/privacy}","received_events_url":"https://api.github.com/users/spolitov/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"spolitov","id":891914,"node_id":"MDQ6VXNlcjg5MTkxNA==","avatar_url":"https://avatars.githubusercontent.com/u/891914?v=4","gravatar_id":"","url":"https://api.github.com/users/spolitov","html_url":"https://github.com/spolitov","followers_url":"https://api.github.com/users/spolitov/followers","following_url":"https://api.github.com/users/spolitov/following{/other_user}","gists_url":"https://api.github.com/users/spolitov/gists{/gist_id}","starred_url":"https://api.github.com/users/spolitov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/spolitov/subscriptions","organizations_url":"https://api.github.com/users/spolitov/orgs","repos_url":"https://api.github.com/users/spolitov/repos","events_url":"https://api.github.com/users/spolitov/events{/privacy}","received_events_url":"https://api.github.com/users/spolitov/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2025-07-17T15:48:16Z","updated_at":"2025-07-28T17:36:57Z","closed_at":"2025-07-28T17:36:57Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Jira Link: [DB-17621](https://yugabyte.atlassian.net/browse/DB-17621)\r\n### Description\n\nWhen postgres table cache is requested, the object to store result is passed to the cache.\nIf request contains multiple tables, but some table is failed to resolve, then whole cache request is finished with failure status for this table.\nWhen shared memory is used to execute Perform request the result object is allocated on the stack.\nSince stack is the same for this scenario, all result objects corresponding to the same postgres process are located at the same address.\nSo we could get into situation when the first request is failed and completed.\nBut there are could be pending resolutions for other tables.\nThen postgres sends a new request, that will allocate result at the same address.\nAs result resolutions from the previous request will work with result from previous request, writing wrong data there.\n\nWhen shared memory is not used, this bug does not happen, since result object is allocated and retained by the query object.\nAnd query object is retained as listener by running queries for other tables.\n\n\n### Issue Type\n\nkind/bug\n\n### Warning: Please confirm that this issue does not contain any sensitive information\n\n- [x] I confirm this issue does not contain any sensitive information.\n\n[DB-17621]: https://yugabyte.atlassian.net/browse/DB-17621?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","closed_by":{"login":"rthallamko3","id":17170123,"node_id":"MDQ6VXNlcjE3MTcwMTIz","avatar_url":"https://avatars.githubusercontent.com/u/17170123?v=4","gravatar_id":"","url":"https://api.github.com/users/rthallamko3","html_url":"https://github.com/rthallamko3","followers_url":"https://api.github.com/users/rthallamko3/followers","following_url":"https://api.github.com/users/rthallamko3/following{/other_user}","gists_url":"https://api.github.com/users/rthallamko3/gists{/gist_id}","starred_url":"https://api.github.com/users/rthallamko3/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rthallamko3/subscriptions","organizations_url":"https://api.github.com/users/rthallamko3/orgs","repos_url":"https://api.github.com/users/rthallamko3/repos","events_url":"https://api.github.com/users/rthallamko3/events{/privacy}","received_events_url":"https://api.github.com/users/rthallamko3/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/28001/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/28001/timeline","performed_via_github_app":null,"state_reason":"completed"}