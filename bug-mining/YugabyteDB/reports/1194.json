sers/abhinab-yb/repos","events_url":"https://api.github.com/users/abhinab-yb/events{/privacy}","received_events_url":"https://api.github.com/users/abhinab-yb/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2024-09-03T12:37:58Z","updated_at":"2024-09-06T04:53:20Z","closed_at":"2024-09-06T04:53:20Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Jira Link: [DB-12675](https://yugabyte.atlassian.net/browse/DB-12675)\r\n### Description\r\n\r\nPg stat statements doesn't track the execution of PREPARE, EXECUTE and DEALLOCATE\r\n\r\n```\r\nyugabyte=# create table n(a text, b int, c float);\r\nCREATE TABLE\r\nyugabyte=# insert into n values('abc',1,1.1);\r\nINSERT 0 1\r\nyugabyte=# insert into n values('abc',2,2.2);\r\nINSERT 0 1\r\nyugabyte=# prepare st(text, int, float) as select * from n where a = $1 and b = $2 and c = $3;\r\nPREPARE\r\nyugabyte=# execute st('abc',1,1.1);\r\n  a  | b |  c  \r\n-----+---+-----\r\n abc | 1 | 1.1\r\n(1 row)\r\n...\r\n```\r\n\r\nFrom tserver-ip:13000/statements\r\n```\r\n        {\r\n            \"userid\": 13256,\r\n            \"dbid\": 13257,\r\n            \"query_id\": -7085925952809948456,\r\n            \"query\": \"prepare st(text, int, float) as select * from n where a = $1 and b = $2 and c = $3\",\r\n            \"calls\": 13,\r\n            \"total_time\": 88.781079,\r\n            \"min_time\": 5.505667,\r\n            \"max_time\": 11.756292,\r\n            \"mean_time\": 6.829313769230769,\r\n            \"stddev_time\": 2.0772428070354058,\r\n            \"rows\": 13,\r\n            \"local_blks_hit\": 0,\r\n            \"local_blks_read\": 0,\r\n            \"local_blks_dirtied\": 0,\r\n            \"local_blks_written\": 0,\r\n            \"temp_blks_read\": 0,\r\n            \"temp_blks_written\": 0,\r\n            \"yb_latency_histogram\": [\r\n                {\r\n                    \"[5.2,5.6)\": 2\r\n                },\r\n                {\r\n                    \"[5.6,6.0)\": 4\r\n                },\r\n                {\r\n                    \"[6.0,6.4)\": 4\r\n                },\r\n                {\r\n                    \"[6.4,7.2)\": 1\r\n                },\r\n                {\r\n                    \"[11.2,12.0)\": 2\r\n                }\r\n            ]\r\n        },\r\n```\r\n\r\nThis is the only entry in pg_stat_statements, which is the underlying query that is executed by the executor hooks when EXECUTE is called.\r\n\r\nThis query id is not present in ASH if `pg_stat_statements.track`  is not set to `all`\r\n\r\n### Issue Type\r\n\r\nkind/bug\r\n\r\n### Warning: Please confirm that this issue does not contain any sensitive information\r\n\r\n- [X] I confirm this issue does not contain any sensitive information.\r\n\r\n[DB-12675]: https://yugabyte.atlassian.net/browse/DB-12675?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","closed_by":{"login":"abhinab-yb","id":121799035,"node_id":"U_kgDOB0KBew","avatar_url":"https://avatars.githubusercontent.com/u/121799035?v=4","gravatar_id":"","url":"https://api.github.com/users/abhinab-yb","html_url":"https://github.com/abhinab-yb","followers_url":"https://api.github.com/users/abhinab-yb/followers","following_url":"https://api.github.com/users/abhinab-yb/following{/other_user}","gists_url":"https://api.github.com/users/abhinab-yb/gists{/gist_id}","starred_url":"https://api.github.com/users/abhinab-yb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhinab-yb/subscriptions","organizations_url":"https://api.github.com/users/abhinab-yb/orgs","repos_url":"https://api.github.com/users/abhinab-yb/repos","events_url":"https://api.github.com/users/abhinab-yb/events{/privacy}","received_events_url"