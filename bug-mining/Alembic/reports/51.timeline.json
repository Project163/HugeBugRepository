eturn update_wrapper(decorated, fn)\n+        f2 = update_wrapper(decorated, fn)\n+        del f2.__wrapped__\n+        return f2\n \n     return decorate\n \n\n```\n\nand the issue in question is http://bugs.python.org/issue17482.\n\nhowever I can't get a simple reproduction case to fail and I've no idea why (I've tried much simpler forms of this, the one below is trying to duplicate as many elements of the real decorator as possible, no effect):\n\n```\nfrom functools import update_wrapper\n\ndef my_wrapper(fn):\n    def targ(*arg, **kw):\n        print(\"targ\")\n        return fn(*arg, **kw)\n    code = \"lambda self, x, y, z, **kw: target(x, y, z)\"\n    wrapper = eval(code, {\"target\": targ})\n    wrapper.__defaults__ = fn.__defaults__\n    wp = update_wrapper(wrapper, fn)\n    return wp\n\nclass MyClass(object):\n    @my_wrapper\n    def my_function(self, x, y, z=5):\n        print(x, y, z)\n\nMyClass().my_function(1, 2, z=5, q=9)\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sqlalchemy/alembic/issues/comments/441883709/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.gith