49,"watchers_count":13649,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":true,"has_discussions":true,"forks_count":1825,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1200,"license":{"key":"bsd-3-clause","name":"BSD 3-Clause \"New\" or \"Revised\" License","spdx_id":"BSD-3-Clause","url":"https://api.github.com/licenses/bsd-3-clause","node_id":"MDc6TGljZW5zZTU="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["dask","numpy","pandas","pydata","python","scikit-learn","scipy"],"visibility":"public","forks":1825,"open_issues":1200,"watchers":13649,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"I noticed this in CI this morning and I can't quite figure out what's going on. I think it has to be an issue with the dev pandas, but I don't understand what is happening. @jorisvandenbossche do you know of anything that would cause this kind of behavior?\r\n\r\n```python-traceback\r\n2021-04-26T14:31:05.3972588Z ___________________________ test_set_index_timestamp ___________________________\r\n2021-04-26T14:31:05.3972985Z \r\n2021-04-26T14:31:05.3973432Z     def test_set_index_timestamp():\r\n2021-04-26T14:31:05.3974533Z         df = pd.DataFrame({\"A\": pd.date_range(\"2000\", periods=12, tz=\"US/Central\"), \"B\": 1})\r\n2021-04-26T14:31:05.3975223Z         ddf = dd.from_pandas(df, 2)\r\n2021-04-26T14:31:05.3975669Z         divisions = (\r\n2021-04-26T14:31:05.3976597Z             pd.Timestamp(\"2000-01-01 00:00:00-0600\", tz=\"US/Central\", freq=\"D\"),\r\n2021-04-26T14:31:05.3977500Z             pd.Timestamp(\"2000-01-12 00:00:00-0600\", tz=\"US/Central\", freq=\"D\"),\r\n2021-04-26T14:31:05.3977999Z         )\r\n2021-04-26T14:31:05.3978325Z     \r\n2021-04-26T14:31:05.3978763Z         # Note: `freq` is lost during round trip\r\n2021-04-26T14:31:05.3979284Z         df2 = df.set_in