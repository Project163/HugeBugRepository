+    ((SELECT abs(min(i)) FROM (SELECT i FROM w2 LIMIT 4) l)) -- unreachable
+ON CONFLICT (i) DO UPDATE SET i = EXCLUDED.i + (SELECT max(i) FROM (SELECT i FROM w2 LIMIT 2) l) RETURNING i;
