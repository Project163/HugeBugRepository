ectorgcr","html_url":"https://github.com/hectorgcr","followers_url":"https://api.github.com/users/hectorgcr/followers","following_url":"https://api.github.com/users/hectorgcr/following{/other_user}","gists_url":"https://api.github.com/users/hectorgcr/gists{/gist_id}","starred_url":"https://api.github.com/users/hectorgcr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hectorgcr/subscriptions","organizations_url":"https://api.github.com/users/hectorgcr/orgs","repos_url":"https://api.github.com/users/hectorgcr/repos","events_url":"https://api.github.com/users/hectorgcr/events{/privacy}","received_events_url":"https://api.github.com/users/hectorgcr/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"hectorgcr","id":20052555,"node_id":"MDQ6VXNlcjIwMDUyNTU1","avatar_url":"https://avatars.githubusercontent.com/u/20052555?v=4","gravatar_id":"","url":"https://api.github.com/users/hectorgcr","html_url":"https://github.com/hectorgcr","followers_url":"https://api.github.com/users/hectorgcr/followers","following_url":"https://api.github.com/users/hectorgcr/following{/other_user}","gists_url":"https://api.github.com/users/hectorgcr/gists{/gist_id}","starred_url":"https://api.github.com/users/hectorgcr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hectorgcr/subscriptions","organizations_url":"https://api.github.com/users/hectorgcr/orgs","repos_url":"https://api.github.com/users/hectorgcr/repos","events_url":"https://api.github.com/users/hectorgcr/events{/privacy}","received_events_url":"https://api.github.com/users/hectorgcr/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":1,"created_at":"2018-08-08T23:31:19Z","updated_at":"2018-08-13T03:57:24Z","closed_at":"2018-08-13T03:55:30Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"We noticed remote bootstraps of several very large tablets (~180G) failed.\r\n\r\nWhen a peer is receiving a tablet (during a remote bootstrap), the leader keeps sending remote bootstrap requests, but the response from the peer (tablet bootstrap already in progress) gets ignored, and the time the leader last heard from the peer never gets updated. Eventually the leader thinks that the peer has become unresponsive and kicks it out of the config.\r\n\r\nWe need to handle remote bootstrap responses the same way we handle other responses: if the peer is still alive, we need to update the last time we received the response even if the response is an error.","closed_by":{"login":"hectorgcr","id":20052555,"node_id":"MDQ6VXNlcjIwMDUyNTU1","avatar_url":"https://avatars.githubusercontent.com/u/20052555?v=4","gravatar_id":"","url":"https://api.github.com/users/hectorgcr","html_url":"https://github.com/hectorgcr","followers_url":"https://api.github.com/users/hectorgcr/followers","following_url":"https://api.github.com/users/hectorgcr/following{/other_user}","gists_url":"https://api.github.com/users/hectorgcr/gists{/gist_id}","starred_url":"https://api.github.com/users/hectorgcr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hectorgcr/subscriptions","organizations_url":"https://api.github.com/users/hectorgcr/orgs","repos_url":"https://api.github.com/users/hectorgcr/repos","events_url":"https://api.github.com/users/hectorgcr/events{/privacy}","received_events_url":"https://api.github.com/users/hectorgcr/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/428/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/428/timeline","perf