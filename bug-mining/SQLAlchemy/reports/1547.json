d":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Discussed in https://github.com/sqlalchemy/sqlalchemy/discussions/12083\r\n\r\n```py\r\nfrom sqlalchemy import create_engine\r\nfrom sqlalchemy import lambda_stmt\r\nfrom sqlalchemy import select\r\nfrom sqlalchemy.orm import DeclarativeBase\r\nfrom sqlalchemy.orm import Mapped\r\nfrom sqlalchemy.orm import mapped_column\r\nfrom sqlalchemy.orm import Session\r\n\r\n\r\nclass Base(DeclarativeBase):\r\n    pass\r\n\r\n\r\nclass SomeModel(Base):\r\n    __tablename__ = \"some\"\r\n    id: Mapped[int] = mapped_column(primary_key=True)\r\n    foo: Mapped[str]\r\n    bar: Mapped[str]\r\n\r\n\r\ndef make_query(stmt, crit1, crit2):\r\n    stmt += lambda s: s.where(crit1)\r\n    stmt += lambda s: s.where(crit2)\r\n\r\n    return stmt\r\n\r\n\r\ndef main():\r\n    engine = create_engine(\"sqlite+pysqlite:///file.db\", echo='debug')\r\n    Base.metadata.drop_all(bind=engine)\r\n    Base.metadata.create_all(bind=engine)\r\n\r\n    with Session(bind=engine) as session:\r\n        session.add_all(\r\n            [\r\n                SomeModel(foo=\"one\", bar=\"one\"),\r\n                SomeModel(foo=\"two\", bar=\"two\"),\r\n            ]\r\n        )\r\n        session.commit()\r\n\r\n    for i in range(2):\r\n        # comment out to fix\r\n        engine = create_engine(\"sqlite+pysqlite:///file.db\", echo='debug')\r\n\r\n        with Session(bind=engine) as session:\r\n            stmt = lambda_stmt(lambda: select(SomeModel))\r\n            # create a filter criterion that will never match anything\r\n            stmt = make_query(\r\n                stmt,\r\n                SomeModel.foo == \"one\",\r\n                SomeModel.bar == \"two\",\r\n            )\r\n\r\n            assert len(session.scalars(stmt).all()) == 0\r\n\r\n\r\nmain()\r\n\r\n```","closed_by":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","