documentation issue\r\n\r\n**Database system/driver:**\r\n\r\n[ ] `cordova`\r\n[ ] `mongodb`\r\n[ ] `mssql`\r\n[ ] `mysql` / `mariadb`\r\n[x] `oracle`\r\n[ ] `postgres`\r\n[ ] `sqlite`\r\n[ ] `sqljs`\r\n[ ] `react-native`\r\n[ ] `expo`\r\n\r\n**TypeORM version:**\r\n\r\n[x] `latest`\r\n[ ] `@next`\r\n[ ] `0.x.x` (or put your version here)\r\n\r\n**Steps to reproduce or a small repository showing the problem:**\r\n\r\nWhen using query builder to perform multi row insert into oracle generates query which does not comply with oracle.\r\n\r\n```\r\n@Entity('ADM_USER')\r\nexport default class User {\r\n    @PrimaryGeneratedColumn({ name: 'ID' })\r\n    id: number;\r\n\r\n    @Column({ name: 'NAME' })\r\n    name: string;\r\n\r\n    @Column('simple-json', { name: 'PROFILE' })\r\n    profile: { age: number };\r\n\r\n    @Column({ name: 'CODE' })\r\n    code: string;\r\n\r\n    @CreateDateColumn({ name: 'CREATED_AT', type: 'timestamp with time zone' })\r\n    createdAt: Date;\r\n}\r\n\r\nthis.connection = await createConnection({\r\n      name: 'oracle',\r\n      type: \"oracle\",\r\n      host: \"****\",\r\n      port: 1521,\r\n      username: \"admin\",\r\n      password: \"***\",\r\n      extra: { poolMax: 10, poolMin: 1 },\r\n      sid: \"ORCL\",\r\n      entities: [User],\r\n      logger: 'simple-console',\r\n      logging: true\r\n    });\r\n   const queryBuilder = this.connection.createQueryBuilder();\r\n   await queryBuilder.insert().into(User).values([\r\n     { name: 'Prashant', code: 'usr001122' },\r\n     { name: 'Aniket', code: 'usr099999'}\r\n   ]).execute();\r\n```\r\nquery failed: INSERT INTO \"ADM_USER\"(\"ID\", \"NAME\", \"PROFILE\", \"CODE\", \"CREATED_AT\") VALUES (DEFAULT, :i0_NAME, DEFAULT, :i0_CODE, DEFAULT), (DEFAULT, :i1_NAME, DEFAULT, :i1_CODE, DEFAULT) RETURNING \"ID\", \"CREATED_AT\" INTO :output_ID, :output_CREATED_AT -- PARAMETERS: [\"Prashant\",\"usr001122\",\"Aniket\",\"usr099999\",{\"type\":2002,\"dir\":3003},{\"type\":2003,\"dir\":3003}]\r\nerror: { [Error: ORA-00933: SQL command not properly ended] errorNum: 933, offset: 124 }\r\n(node:14324) UnhandledPromiseRejectionWarning: QueryFailedError: ORA-00933: SQL command not properly ended\r\n","reactions":{"url":"https://api.github.com/repos/typeorm/typeorm/issues/2824/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/typeorm/typeorm/issues/2824/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":3843633153,"node_id":"MDEyOkxhYmVsZWRFdmVudDM4NDM2MzMxNTM=","url":"https://api.github.com/repos/typeorm/typeorm/issues/events/3843633153","actor":{"login":"imnotjames","id":1551593,"node_id":"MDQ6VXNlcjE1NTE1OTM=","avatar_url":"https://avatars.githubusercontent.com/u/1551593?v=4","gravatar_id":"","url":"https://api.github.com/users/imnotjames","html_url":"https://github.com/imnotjames","followers_url":"https://api.github.com/users/imnotjames/followers","following_url":"https://api.github.com/users/imnotjames/following{/other_user}","gists_url":"https://api.github.com/users/imnotjames/gists{/gist_id}","starred_url":"https://api.github.com/users/imnotjames/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/imnotjames/subscriptions","organizations_url":"https://api.github.com/users/imnotjames/orgs","repos_url":"https://api.github.com/users/imnotjames/repos","events_url":"https://api.github.com/users/imnotjames/events{/privacy}","received_events_url":"https://api.github.com/users/imnotjames/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2020-10-06T06:17:03Z","label":{"name":"bug","color":"fc2929"},"performed_via_github_app":null},{"id":3888871317,"node_id":"MDEyOkxhYmVsZWRFdmVudDM4ODg4NzEzMTc=","url":"https://api.github.com/repos/typeorm/typeorm/issues/events/3888871317","actor":{"login":"imnotjam