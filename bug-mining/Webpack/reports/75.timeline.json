ub.com/users/es6Test/orgs","repos_url":"https://api.github.com/users/es6Test/repos","events_url":"https://api.github.com/users/es6Test/events{/privacy}","received_events_url":"https://api.github.com/users/es6Test/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/webpack/webpack/issues/comments/244354934","html_url":"https://github.com/webpack/webpack/issues/2895#issuecomment-244354934","issue_url":"https://api.github.com/repos/webpack/webpack/issues/2895","id":244354934,"node_id":"MDEyOklzc3VlQ29tbWVudDI0NDM1NDkzNA==","user":{"login":"kaorun343","id":5625395,"node_id":"MDQ6VXNlcjU2MjUzOTU=","avatar_url":"https://avatars.githubusercontent.com/u/5625395?v=4","gravatar_id":"","url":"https://api.github.com/users/kaorun343","html_url":"https://github.com/kaorun343","followers_url":"https://api.github.com/users/kaorun343/followers","following_url":"https://api.github.com/users/kaorun343/following{/other_user}","gists_url":"https://api.github.com/users/kaorun343/gists{/gist_id}","starred_url":"https://api.github.com/users/kaorun343/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kaorun343/subscriptions","organizations_url":"https://api.github.com/users/kaorun343/orgs","repos_url":"https://api.github.com/users/kaorun343/repos","events_url":"https://api.github.com/users/kaorun343/events{/privacy}","received_events_url":"https://api.github.com/users/kaorun343/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-09-02T11:53:34Z","updated_at":"2016-09-02T12:14:18Z","body":"Hello.\nI have the same issue. \n\n``` javascript\nexport const a = 0\n```\n\nTo avoid this issue, I had to add semicolons manually.\nHow about this? When adding `\\n` to the exported string as well as #2221, it works well.\n\n``` javascript\n// lib/dependencies/HarmonyExportSpecifierDependency.js\n\n\nHarmonyExportSpecifierDependency.Template.prototype.apply = function(dep, source) {\n    var used = dep.originModule.isUsed(dep.name);\n    var active = HarmonyModulesHelpers.isActive(dep.originModule, dep);\n    var content;\n    if(!used) {\n        content = \"/* unused harmony export \" + (dep.name || \"namespace\") + \" */\";\n    } else if(!active) {\n        content = \"/* inactive harmony export \" + (dep.name || \"namespace\") + \" */\";\n    } else if(dep.immutable) {\n                // change here\n        // content = \"/* harmony export */ exports[\" + JSON.stringify(used) + \"] = \" + dep.id + \";\";\n        content = \"\\n/* harmony export */ exports[\" + JSON.stringify(used) + \"] = \" + dep.id + \";\";\n    } else {\n        content = \"\\n/* harmony export */ __webpack_require__.d(exports, \" + JSON.stringify(used) + \", function() { return \" + dep.id + \"; });\";\n    }\n    source.insert(dep.position, content);\n\n};\n\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/webpack/webpack/issues/comments/244354934/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"kaorun343","id":5625395,"node_id":"MDQ6VXNlcjU2MjUzOTU=","avatar_url":"https://avatars.githubusercontent.com/u/5625395?v=4","gravatar_id":"","url":"https://api.github.com/users/kaorun343","html_url":"https://github.com/kaorun343","followers_url":"https://api.github.com/users/kaorun343/followers","following_url":"https://api.github.com/users/kaorun343/following{/other_user}","gists_url":"https://api.github.com/users/kaorun343/gists{/gist_id}","starred_url":"https://api.github.com/users/kaorun343/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kaorun343/subscriptions","organizations_url":"https://api.github.com/users/kaorun343/orgs","repos_url":"https://api.github.com/users/kaorun343/repos","events_url":"https://api.github.com/users/kaorun343/events{/privacy}","received_events_url":