ify.git","clone_url":"https://github.com/fastify/fastify.git","svn_url":"https://github.com/fastify/fastify","homepage":"https://www.fastify.dev","size":9375,"stargazers_count":35183,"watchers_count":35183,"language":"JavaScript","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":2530,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":107,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":true,"topics":["hacktoberfest","nodejs","performance","speed","webframework"],"visibility":"public","forks":2530,"open_issues":107,"watchers":35183,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/fastify/fastify/pulls/6225","html_url":"https://github.com/fastify/fastify/pull/6225","diff_url":"https://github.com/fastify/fastify/pull/6225.diff","patch_url":"https://github.com/fastify/fastify/pull/6225.patch","merged_at":"2025-06-23T11:25:02Z"},"body":"## Summary\r\n\r\nThis PR fixes the documentation inconsistency identified in #6135 and discussed in #6146. The documentation incorrectly stated that the `onError` hook runs **after** custom error handlers, but the actual implementation runs it **before** error handlers.\r\n\r\nAs suggested by the maintainers in #6146, this PR updates the documentation to match the current implementation rather than changing the code (which would be a breaking change).\r\n\r\n## Changes Made\r\n\r\n- **`docs/Reference/Hooks.md`**: Updated onError hook description to clarify it runs **before** error handlers\r\n- **`docs/Reference/Lifecycle.md`**: Fixed Reply Lifecycle diagram to show correct execution order\r\n- **`docs/Reference/TypeScript.md`**: Updated TypeScript documentation to match\r\n- **`types/hooks.d.ts`**: Updated TypeScript type definitions documentation\r\n\r\n## Testing\r\n\r\n- ✅ Verified current behavior with test script (onError runs before setErrorHandler)\r\n- ✅ Linting passes (`npm run lint`)\r\n- ✅ Documentation now accurately reflects the actual implementation\r\n\r\n## Related Issues\r\n\r\n- Fixes: #6135\r\n- Related: #6146\r\n\r\n## Type of Change\r\n\r\n- [x] Documentation update\r\n- [ ] Bug fix\r\n- [ ] New feature\r\n- [ ] Breaking change","reactions":{"url":"https://api.github.com/repos/fastify/fastify/issues/6225/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/fastify/fastify/issues/6225/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":18271669922,"node_id":"CE_lADOBCRpgs63s_8lzwAAAARBE46i","url":"https://api.github.com/repos/fastify/fastify/issues/events/18271669922","actor":{"login":"Fdawgs","id":43814140,"node_id":"MDQ6VXNlcjQzODE0MTQw","avatar_url":"https://avatars.githubusercontent.com/u/43814140?v=4","gravatar_id":"","url":"https://api.github.com/users/Fdawgs","html_url":"https://github.com/Fdawgs","followers_url":"https://api.github.com/users/Fdawgs/followers","following_url":"https://api.github.com/users/Fdawgs/following{/other_user}","gists_url":"https://api.github.com/users/Fdawgs/gists{/gist_id}","starred_url":"https://api.github.com/users/Fdawgs/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Fdawgs/subscriptions","organizations_url":"https://api.github.com/users/Fdawgs/orgs","repos_url":"https://api.github.com/users/Fdawgs/repos","events_url":"https://api.github.com/users/Fdawgs/events{/privacy}","received_events_url":"https://api.github.com/users/Fdawgs/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2025-06-23T11:25:04Z","state_reason":null,"performed_via_github_ap