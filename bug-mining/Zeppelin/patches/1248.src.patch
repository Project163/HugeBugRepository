+          }.getType()
+      );
+      cells = new ArrayList<>();
+      for (String s : header) {
+        cells.add(retMap.getOrDefault(s, "null")
+            .replace("\n", "\\n")
+            .replace("\t", "\\t"));
+      }
+      rows.add(StringUtils.join(cells, "\t"));
+    }
+    return rows;
