lieve this rule is generic enough to be included\n\nRequesting a feature? Please be sure to include:\n1. The problem you want to solve (don't mention the solution)\n2. Your take on the correct solution to problem\n\nIncluding this information in your issue helps us to triage it and get you a response as quickly as possible.\n\nThanks!\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/eslint/eslint/issues/comments/123418812/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"eslintbot","id":13383618,"node_id":"MDQ6VXNlcjEzMzgzNjE4","avatar_url":"https://avatars.githubusercontent.com/u/13383618?v=4","gravatar_id":"","url":"https://api.github.com/users/eslintbot","html_url":"https://github.com/eslintbot","followers_url":"https://api.github.com/users/eslintbot/followers","following_url":"https://api.github.com/users/eslintbot/following{/other_user}","gists_url":"https://api.github.com/users/eslintbot/gists{/gist_id}","starred_url":"https://api.github.com/users/eslintbot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eslintbot/subscriptions","organizations_url":"https://api.github.com/users/eslintbot/orgs","repos_url":"https://api.github.com/users/eslintbot/repos","events_url":"https://api.github.com/users/eslintbot/events{/privacy}","received_events_url":"https://api.github.com/users/eslintbot/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":361451996,"node_id":"MDEyOkxhYmVsZWRFdmVudDM2MTQ1MTk5Ng==","url":"https://api.github.com/repos/eslint/eslint/issues/events/361451996","actor":{"login":"gyandeeps","id":5554486,"node_id":"MDQ6VXNlcjU1NTQ0ODY=","avatar_url":"https://avatars.githubusercontent.com/u/5554486?v=4","gravatar_id":"","url":"https://api.github.com/users/gyandeeps","html_url":"https://github.com/gyandeeps","followers_url":"https://api.github.com/us