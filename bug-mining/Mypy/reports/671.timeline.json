://github.com/python/mypy.git","ssh_url":"git@github.com:python/mypy.git","clone_url":"https://github.com/python/mypy.git","svn_url":"https://github.com/python/mypy","homepage":"https://www.mypy-lang.org/","size":77161,"stargazers_count":20064,"watchers_count":20064,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":3065,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":3124,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["linter","python","typechecker","types","typing"],"visibility":"public","forks":3065,"open_issues":3124,"watchers":20064,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/python/mypy/pulls/8212","html_url":"https://github.com/python/mypy/pull/8212","diff_url":"https://github.com/python/mypy/pull/8212.diff","patch_url":"https://github.com/python/mypy/pull/8212.patch","merged_at":"2020-01-14T13:00:54Z"},"body":"Fixes #8156 \r\n\r\nThis is a suggestion as to how we could handle getting the Typeddict context from a Union with more than one Typeddict. \r\n\r\nThe idea is that we check each of the Typeddict types to find one who's keys match that of the expression, if more than one match it's then ambiguous. The slightly weird thing is that this matching is only applied in the Union case, if there is only a single Typeddict it's returned as before. \r\n\r\nI'm not sure that I've put the tests in the most appropriate place, and suggestions would be great. ","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/8212/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/pyt