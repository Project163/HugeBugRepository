14]: Retried waiting for GCLocker too often allocating 1029 words\r\njava.lang.OutOfMemoryError: Java heap space\r\n```\n\n### Logs (if relevant)\n\n_No response_","closed_by":{"login":"pxsalehi","id":3340727,"node_id":"MDQ6VXNlcjMzNDA3Mjc=","avatar_url":"https://avatars.githubusercontent.com/u/3340727?v=4","gravatar_id":"","url":"https://api.github.com/users/pxsalehi","html_url":"https://github.com/pxsalehi","followers_url":"https://api.github.com/users/pxsalehi/followers","following_url":"https://api.github.com/users/pxsalehi/following{/other_user}","gists_url":"https://api.github.com/users/pxsalehi/gists{/gist_id}","starred_url":"https://api.github.com/users/pxsalehi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pxsalehi/subscriptions","organizations_url":"https://api.github.com/users/pxsalehi/orgs","repos_url":"https://api.github.com/users/pxsalehi/repos","events_url":"https://api.github.com/users/pxsalehi/events{/privacy}","received_events_url":"https://api.github.com/users/pxsalehi/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/92410/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/elastic/elasticsearch/issues/92410/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}