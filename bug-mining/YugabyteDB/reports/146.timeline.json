starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mbautin/subscriptions","organizations_url":"https://api.github.com/users/mbautin/orgs","repos_url":"https://api.github.com/users/mbautin/repos","events_url":"https://api.github.com/users/mbautin/events{/privacy}","received_events_url":"https://api.github.com/users/mbautin/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-03-29T02:19:22Z","updated_at":"2019-03-29T02:19:22Z","body":"In the `ps` output above, pid `25507` is the old postgres process that was started by the old tserver.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/477840237/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"mbautin","id":552936,"node_id":"MDQ6VXNlcjU1MjkzNg==","avatar_url":"https://avatars.githubusercontent.com/u/552936?v=4","gravatar_id":"","url":"https://api.github.com/users/mbautin","html_url":"https://github.com/mbautin","followers_url":"https://api.github.com/users/mbautin/followers","following_url":"https://api.github.com/users/mbautin/following{/other_user}","gists_url":"https://api.github.com/users/mbautin/gists{/gist_id}","starred_url":"https://api.github.com/users/mbautin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mbautin/subscriptions","organizations_url":"https://api.github.com/users/mbautin/orgs","repos_url":"https://api.github.com/users/mbautin/repos","events_url":"https://api.github.com/users/mbautin/events{/privacy}","received_events_url":"https://api.github.com/users/mbautin/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/478073550","html_url":"https://github.com/yugabyte/yugabyte-db/issues/1089#issuecomment-478073550","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/1089","id":478073550,"node_id":"MDEyOklzc3VlQ29tbWVudDQ3ODA3MzU1MA==","user":{"login":"robertpang","id":30942926,"node_id":"MDQ6VXNlcjMwOTQyOTI2","avatar_url":"https://avatars.githubusercontent.com/u/30942926?v=4","gravatar_id":"","url":"https://api.github.com/users/robertpang","html_url":"https://github.com/robertpang","followers_url":"https://api.github.com/users/robertpang/followers","following_url":"https://api.github.com/users/robertpang/following{/other_user}","gists_url":"https://api.github.com/users/robertpang/gists{/gist_id}","starred_url":"https://api.github.com/users/robertpang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/robertpang/subscriptions","organizations_url":"https://api.github.com/users/robertpang/orgs","repos_url":"https://api.github.com/users/robertpang/repos","events_url":"https://api.github.com/users/robertpang/events{/privacy}","received_events_url":"https://api.github.com/users/robertpang/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-03-29T16:59:02Z","updated_at":"2019-03-29T17:02:38Z","body":"When yb-tserver terminates a child process on Linux (in this case the `postgres` subprocess), it delivers a [`SIGTERM`](https://github.com/YugaByte/yugabyte-db/blob/master/src/yb/util/subprocess.cc#L310) signal. `SIGTERM` is the same signal `pg_ctl stop` delivers in [`SMART`](https://www.postgresql.org/docs/11/app-pg-ctl.html) mode, which waits for clients to disconnect. To stop the `postgres` process without waiting for client to disconnect ([`FAST`](https://www.postgresql.org/docs/11/app-pg-ctl.html) mode), `pg_ctl` delivers [`SIGINT`](https://github.com/YugaByte/yugabyte-db/blob/master/src/postgres/src/bin/pg_ctl/pg_ctl.c#L1983) instead. We should switch to deliver the `SIGINT` signal to stop `postgres` instead.\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/478073550/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"robertpang","id":30942926,"node_id":"MDQ6VXNlcjMwOTQyOTI2","avatar_url":"https://avatars.githubusercontent.com/u/30942926?v=4","gravatar_id":"","url":"https://api.github.com/users/robertpang","html_url":"https://github.com/robertpang","followers_url":"https://api.github.com/users/robertpang/followers","following_url":"https://api.github.com/users/robertpang/following{/other_user}","gists_url":"https://api.github.com/users/robertpang/gists{/gist_id}","starred_url":"https://api.github.com/users/robertpang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/robertpang/subscriptions","organizations_url":"https://api.github.com/users/robertpang/orgs","repos_url":"https://api.github.com/users/robertpang/repos","events_url":"https://api.github.com/users/robertpang/events{/privacy}","received_events_url":"https://api.github.com/users/robertpang/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/478209753","html_url":"https://github.com/yugabyte/yugabyte-db/issues/1089#issuecomment-478209753","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/1089","id":478209753,"node_id":"MDEyOklzc3VlQ29tbWVudDQ3ODIwOTc1Mw==","user":{"login":"kmuthukk","id":13615376,"node_id":"MDQ6VXNlcjEzNjE1Mzc2","avatar_url":"https://avatars.githubusercontent.com/u/13615376?v=4","gravatar_id":"","url":"https://api.github.com/users/kmuthukk","html_url":"https://github.com/kmuthukk","followers_url":"https://api.github.com/users/kmuthukk/followers","following_url":"https://api.github.com/users/kmuthukk/following{/other_user}","gists_url":"https://api.github.com/users/kmuthukk/gists{/gist_id}","starred_url":"https://api.github.com/users/kmuthukk/sta