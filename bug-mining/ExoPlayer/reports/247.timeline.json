com/dhanapal20","followers_url":"https://api.github.com/users/dhanapal20/followers","following_url":"https://api.github.com/users/dhanapal20/following{/other_user}","gists_url":"https://api.github.com/users/dhanapal20/gists{/gist_id}","starred_url":"https://api.github.com/users/dhanapal20/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dhanapal20/subscriptions","organizations_url":"https://api.github.com/users/dhanapal20/orgs","repos_url":"https://api.github.com/users/dhanapal20/repos","events_url":"https://api.github.com/users/dhanapal20/events{/privacy}","received_events_url":"https://api.github.com/users/dhanapal20/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-08-05T19:47:02Z","updated_at":"2017-08-05T19:47:02Z","body":"Hi\r\nThanks for your detailed analysis and timely response\r\nBut we have cross verified the media content and its presentation timestamp seems correct. (verified with MPEG2 TS format source content PES and its converted into iso bmff (mp4) video format with respect to monotonic clock resolution of 100 nano ticks time scale (10000000))\r\n\r\nWe upscaling 90 KHz PTS/DTS time reference to 100 nano ticks (10000000) time reference on MPEG2 TS to mp4 video conversion. Also we manually downscaled from 100 nano ticks to 90 KHz clock resolution and get back the original PTS/DTS values.\r\n\r\nI have attached the mp4 video file analysis report with respective duration and Composition time offset values and all segments contains 400000 nano ticks for every frame. The same MPEG2 TS content playback will not induce dropped buffer count on same exo player.\r\n\r\nSo you please kindly go through the mp4 segment file with respect to this nano ticks time scale and confirm us whether this time scale will induce any issue on player presentation time stamp calculation (may be data wrap on case, etc..)\r\n![mp4_sample](https://user-images.githubusercontent.com/29534307/28998257-f09bb882-7a43-11e7-8b69-9f8460e44c03.png)\r\n\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/320466431/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"dhanapal20","id":29534307,"node_id":"MDQ6VXNlcjI5NTM0MzA3","avatar_url":"https://avatars.githubusercontent.com/u/29534307?v=4","gravatar_id":"","url":"https://api.github.com/users/dhanapal20","html_url":"https://github.com/dhanapal20","followers_url":"https://api.github.com/users/dhanapal20/followers","following_url":"https://api.github.com/users/dhanapal20/following{/other_user}","gists_url":"https://api.github.com/users/dhanapal20/gists{/gist_id}","starred_url":"https://api.github.com/users/dhanapal20/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dhanapal20/subscriptions","organizations_url":"https://api.github.com/users/dhanapal20/orgs","repos_url":"https://api.github.com/users/dhanapal20/repos","events_url":"https://api.github.com/users/dhanapal20/events{/privacy}","received_events_url":"https://api.github.com/users/dhanapal20/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1194310311,"node_id":"MDEzOlJlb3BlbmVkRXZlbnQxMTk0MzEwMzEx","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/1194310311","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/s