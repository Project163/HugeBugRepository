diff --git a/src/xunit.v3.runner.utility.tests/Frameworks/v3/CaptureConsoleAttributeAcceptanceTests.cs b/src/xunit.v3.runner.utility.tests/Frameworks/v3/CaptureConsoleAttributeAcceptanceTests.cs
