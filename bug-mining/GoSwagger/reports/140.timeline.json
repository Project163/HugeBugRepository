s/go-swagger/go-swagger/pulls{/number}","milestones_url":"https://api.github.com/repos/go-swagger/go-swagger/milestones{/number}","notifications_url":"https://api.github.com/repos/go-swagger/go-swagger/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/go-swagger/go-swagger/labels{/name}","releases_url":"https://api.github.com/repos/go-swagger/go-swagger/releases{/id}","deployments_url":"https://api.github.com/repos/go-swagger/go-swagger/deployments","created_at":"2014-11-16T20:13:15Z","updated_at":"2025-12-12T12:05:28Z","pushed_at":"2025-12-04T16:10:09Z","git_url":"git://github.com/go-swagger/go-swagger.git","ssh_url":"git@github.com:go-swagger/go-swagger.git","clone_url":"https://github.com/go-swagger/go-swagger.git","svn_url":"https://github.com/go-swagger/go-swagger","homepage":"https://goswagger.io","size":55802,"stargazers_count":9891,"watchers_count":9891,"language":"Go","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":true,"has_discussions":true,"forks_count":1291,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":592,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["api","code-generator","go","golang","swagger-codegen","swagger-spec","swagger-specification"],"visibility":"public","forks":1291,"open_issues":592,"watchers":9891,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/go-swagger/go-swagger/pulls/1566","html_url":"https://github.com/go-swagger/go-swagger/pull/1566","diff_url":"https://github.com/go-swagger/go-swagger/pull/1566.diff","patch_url":"https://github.com/go-swagger/go-swagger/pull/1566.patch","merged_at":"2018-06-17T15:24:15Z"},"body":"## Render and validate maps in body parameters\r\n- fix incorrect rendering of maps in body param (i.e systematic `ìnterface{}` type)\r\n- validate maps (e.g. schema AdditionalProperties) in body parameter\r\n- render simple maps (e.g. `map[string][]map[string][][][]int64`) as inlined types\r\n- maps of schema does not create a schema of their own, just the complex part (e.g. `map[string][][]map[string]model.MyModel`)\r\n\r\n### Fixes\r\n\r\n- fixes #1556 \r\n- fixes #1562\r\n\r\n### Summary of changes\r\n\r\n- `operation.go`:**refactoring + new feature/fix**\r\n  - refactored body param processing\r\n  - treat anonymous maps as Child GenParameter structures (such as `[]map[string][][][]map[string]*model.MyMode`)\r\n  - extended body param validation strategy selection to maps\r\n  - fix: enums are considered slice validations, including for bod params\r\n  \r\n- `model.go`: **targeted fixes**\r\n  - refactored slice validations\r\n  - fix missing lift validation case for maps\r\n  - align nullable status for maps of primitives or arrays of primitives (#1562)\r\n  \r\n- `types.go`: **cosmetic**\r\n  - more comments in code (e.g. special nullability rules)\r\n  - outsource debug func\r\n  \r\n- `structs.go`: **enrichments**\r\n  - removed unused and unassigned `BodyParam` struct\r\n  - enriched GenParameters to support map constructs\r\n  \r\n- `templates/server/parameter.gotmpl`: **refactoring + new feature/fix**\r\n   - extended body param section to support maps as well as maps, with or without validations\r\n   - large refactoring of nested validations to merge slice and map validations\r\n   - follow guards as in models (IsZero | Required)\r\n   \r\n### Known issues\r\n\r\nKnown existing issues not resolved here:\r\n\r\n1. fully supporting `--skip-flatten` (e.g. anonymous types + extra schemas in the operation package)\r\n2. undue definitions created by flatten on maps of objects (non blocking)\r\n3. incorrect validations of Zero Values in slices and maps in some cases (e.g. skipping validation with IsZero())\r\n4. depending on the future solution to replace/remove IsZero|Required for slice and map elements, the nullability re-alignment above \r\nmay be easily modified and change nullable priorities\r\n5. Nice to have: nested array validations with slice validations should execute slice validation before, not after validating all elements","reactions":{"url":"https://api.github.com/repos/go-swagger/go-swagger/issues/1566/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/go-swagger/go-swagger/issues/1566/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":1664705625,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDE2NjQ3MDU2MjU=","url":"https://api.github.com/repos/go-swagger/go-swagger/issues/events/1664705625","actor":{"login":"fredbi","id":14262513,"node_id":"MDQ6VXNlcjE0MjYyNTEz","avatar_url":"https://avatars.githubusercontent.com/u/14262513?v=4","gravatar_id":"","url":"https://api.github.com/users/fredbi","html_url":"https://github.com/fredbi","followers_url":"https://api.github.com/users/fredbi/followers","following_url":"https://api.github.com/users/fredbi/following{/other_user}","gists_url":"https://api.github.com/users/fredbi/gists{/gist_id}","starred_url":"https://api.github.com/users/fredbi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fredbi/subscriptions","organizations_url":"https://api.github.com/users/fredbi/orgs","repos_url":"https://api.github.com/users/fredbi/repos","events_url":"https://api.github.com/users/fredbi/events{/privacy}","received_events_url":"https://api.github.com/users/fredbi/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"6a08ec72c2a34b45b2cdea325495b63aff6b39de","commit_url":"https://api.github.com/repos/fredbi/go-swagger/commits/6a08ec72c2a34b45b2cdea325495b63aff6b39de