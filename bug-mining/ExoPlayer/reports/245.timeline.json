hub.com/users/nerd-sj/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nerd-sj/subscriptions","organizations_url":"https://api.github.com/users/nerd-sj/orgs","repos_url":"https://api.github.com/users/nerd-sj/repos","events_url":"https://api.github.com/users/nerd-sj/events{/privacy}","received_events_url":"https://api.github.com/users/nerd-sj/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/319018611","html_url":"https://github.com/google/ExoPlayer/issues/3080#issuecomment-319018611","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/3080","id":319018611,"node_id":"MDEyOklzc3VlQ29tbWVudDMxOTAxODYxMQ==","user":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-07-31T09:39:41Z","updated_at":"2017-07-31T09:39:41Z","body":"I didn't spend much time looking at this, but the extractor isn't finding what it needs to seek within the file. Specifically, there doesn't seem to be an entry in the Meta Seek Information specifying the position of the Cues element (i.e. the index that enables efficient seeking). It looks like there is a Cues element at the end of the file, but because there's no corresponding entry in the Meta Seek Information at the start of the file, we're unable to find it until it's too late.\r\n\r\nWe do not support seeking in media unless the media is packaged to allow seeking in an efficient way, and have no plans to change this policy. To enable seeking, I think you should ensure the Cues element can be found by adding a corresponding Meta Seek Information entry.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/319018611/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1348769481,"node_id":"MDExOkxvY2tlZEV2ZW50MTM0ODc2OTQ4MQ==","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/1348769481","actor":{"login":"google","id":1342004,"node_id":"MDEyOk9yZ2FuaXphdGlvbjEzNDIwMDQ=","avatar_url":"https://avatars.githubusercontent.com/u/1342004?v=4","gravatar_id":