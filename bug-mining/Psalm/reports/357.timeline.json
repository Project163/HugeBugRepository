":"https://api.github.com/users/vimeo/subscriptions","organizations_url":"https://api.github.com/users/vimeo/orgs","repos_url":"https://api.github.com/users/vimeo/repos","events_url":"https://api.github.com/users/vimeo/events{/privacy}","received_events_url":"https://api.github.com/users/vimeo/received_events","type":"Organization","user_view_type":"public","site_admin":false},"html_url":"https://github.com/vimeo/psalm","description":"A PHP static analysis tool for finding errors and security vulnerabilities in PHP applications","fork":false,"url":"https://api.github.com/repos/vimeo/psalm","forks_url":"https://api.github.com/repos/vimeo/psalm/forks","keys_url":"https://api.github.com/repos/vimeo/psalm/keys{/key_id}","collaborators_url":"https://api.github.com/repos/vimeo/psalm/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/vimeo/psalm/teams","hooks_url":"https://api.github.com/repos/vimeo/psalm/hooks","issue_events_url":"https://api.github.com/repos/vimeo/psalm/issues/events{/number}","events_url":"https://api.github.com/repos/vimeo/psalm/events","assignees_url":"https://api.github.com/repos/vimeo/psalm/assignees{/user}","branches_url":"https://api.github.com/repos/vimeo/psalm/branches{/branch}","tags_url":"https://api.github.com/repos/vimeo/psalm/tags","blobs_url":"https://api.github.com/repos/vimeo/psalm/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/vimeo/psalm/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/vimeo/psalm/git/refs{/sha}","trees_url":"https://api.github.com/repos/vimeo/psalm/git/trees{/sha}","statuses_url":"https://api.github.com/repos/vimeo/psalm/statuses/{sha}","languages_url":"https://api.github.com/repos/vimeo/psalm/languages","stargazers_url":"https://api.github.com/repos/vimeo/psalm/stargazers","contributors_url":"https://api.github.com/repos/vimeo/psalm/contributors","subscribers_url":"https://api.github.com/repos/vimeo/psalm/subscribers","subscription_url":"https://api.github.com/repos/vimeo/psalm/subscription","commits_url":"https://api.github.com/repos/vimeo/psalm/commits{/sha}","git_commits_url":"https://api.github.com/repos/vimeo/psalm/git/commits{/sha}","comments_url":"https://api.github.com/repos/vimeo/psalm/comments{/number}","issue_comment_url":"https://api.github.com/repos/vimeo/psalm/issues/comments{/number}","contents_url":"https://api.github.com/repos/vimeo/psalm/contents/{+path}","compare_url":"https://api.github.com/repos/vimeo/psalm/compare/{base}...{head}","merges_url":"https://api.github.com/repos/vimeo/psalm/merges","archive_url":"https://api.github.com/repos/vimeo/psalm/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/vimeo/psalm/downloads","issues_url":"https://api.github.com/repos/vimeo/psalm/issues{/number}","pulls_url":"https://api.github.com/repos/vimeo/psalm/pulls{/number}","milestones_url":"https://api.github.com/repos/vimeo/psalm/milestones{/number}","notifications_url":"https://api.github.com/repos/vimeo/psalm/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/vimeo/psalm/labels{/name}","releases_url":"https://api.github.com/repos/vimeo/psalm/releases{/id}","deployments_url":"https://api.github.com/repos/vimeo/psalm/deployments","created_at":"2016-11-21T17:04:41Z","updated_at":"2025-12-12T13:56:46Z","pushed_at":"2025-12-11T08:59:09Z","git_url":"git://github.com/vimeo/psalm.git","ssh_url":"git@github.com:vimeo/psalm.git","clone_url":"https://github.com/vimeo/psalm.git","svn_url":"https://github.com/vimeo/psalm","homepage":"https://psalm.dev","size":116606,"stargazers_count":5784,"watchers_count":5784,"language":"PHP","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":684,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1949,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["hacktoberfest","php","security-analysis","static-analysis","taint-analysis","type-inference"],"visibility":"public","forks":684,"open_issues":1949,"watchers":5784,"default_branch":"6.x","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"In https://github.com/vimeo/psalm/issues/1143#issue-393718578 I suggested that\r\n\r\n```php\r\n<?php\r\n  \r\ninterface DefaultConstructable\r\n{\r\n    public function __construct();\r\n}\r\n\r\n/**\r\n * @template T as DefaultConstructable\r\n * @template-typeof T $defaultConstructableClass\r\n * @param T::class $defaultConstructableClass\r\n * @return T\r\n */\r\nfunction make($defaultConstructableClass)\r\n{\r\n    return new $defaultConstructableClass;\r\n}\r\n```\r\n\r\nmight be a candidate pattern for replacing `new $classString` when the exact `$classString` type isn't known, but we want to enforce that the type that is passed is constructable. This has the downside that the types we pass in must explicitly be defined to implement `DefaultConstructable`, and won't work very well when trying to combine types that we do not have direct definitional control over.\r\n\r\nThere are a few approaches taken to try to solve this problem by languages e.g.\r\n\r\n* In Go, any type which has the correct methods and properties to implement an interface is considered to implement it with no need to declare it explicitly in the definition\r\n* In Swift, types can have \"extension\"(s) written (not a subtype) that increases the surface area of the original type's interface: so that the original type can be extended with new methods or (computed) properties (if necessary) to implement interfaces (\"protocols\" in Swift).\r\n\r\nI don't think either approach would work here though, since we can't ever make PHP's runtime happy that an interface has been implemented unless it was explicitly defined that way.\r\n\r\nSo I would propose a new annotation/type could be added to Pslam, so as to restrict acceptable types to types that are \"like\" an interface (have the necessary interface, but don't explicitly have a subtyping relation).\r\n\r\nI originally thought it would be a good idea to write something like `@template T like DefaultConstructable` to mean that `T` has the same interface  as `DefaultConstructable`, but doesn't necessarily implement it.\r\nThis would already be a powerful feature, since it would allow all cases that previously used `new $classString` (without knowing what `$classString` was) to simply define an interface, and use this new notation in the function that accepts the class string without needing to redefine any other types to be aware of `DefaultConstructable`.\r\nWhat might be one step better, though. Is to have Psalm support a new type `Like<T>` where Psalm can check that if `Foo` has a compatible interface with `T`, then `Foo` is a subtype of `Like<T>`. Clearly `Foo` is a `Like<Foo>` but not necessarily the converse[1]. We could then write `@template T as Like<DefaultConstructable>`, but would also be able to use this annotation with non-generic types: i.e. write `@param Like<DefaultConstructable> $something` which should let us use the interface of `DefaultConstructable` when using `$something`, but we don't know whether `$something` is a `DefaultConstructable` (or anything else about it) within the function body.\r\n\r\n---\r\n\r\nSome rambling that might help with type deduction and simplifying type expressions:\r\n\r\n`Like<_>` is also a monad: Suppose that `T` has a method `foo(Bar $Bar): Baz` (w.l.o.g. due to properties only caring about covariance, which is covered by considering a method). Then any `Like<T>` has a method `foo(_Bar $Bar): Baz_` where `Bar` is a `_Bar` and `Baz_` is a `Baz`. Any `Like<Like<T>>` then has a method `foo(__Bar $Bar): Baz__` where `_Bar` is a `__Bar` and `Baz__` is a `Baz_`. Since any `Like<Like<T>>` has a compatible interface with `T`, then `Like<Like<T>>`  is a `Like<T>`. But also any `Like<T>` is a `Like<Like<T>>` (by [1]) and so `Like<Like<T>> = Like<T>`.\r\n\r\nWe can also note that `mixed` has no interface requirements, and so trivially any type is a `Like<mixed>`, and since any type is a `mixed`, `Like<mixed>` is a `mixed` so `Like<mixed> = mixed`.\r\n\r\nThere are also some nice properties with union and intersection types:\r\nAny `Like<T>|Like<U>` is a `Like<T>` or a `Like<U>`, so has a compatible interface with `T` or `U`, i.e. `Like<T>|Like<U>` is a `Like<T|U>` (similarly `Like<T|U>` is a `Like<T>|Like<U>`). Any `Like<T>&Like<U>` has a compatible interface with `T` and with `U`, so `Like<T>&Like<U>` is a `Like<T&U>` (similarly `Like<T&U>` is a `Like<T>&Like<U>`). i.e.  `Like<T|U> = Like<T>|Like<U>` and `Like<T&U> = Like<T>&Like<U>`.\r\n\r\n---\r\n\r\nI do keep meaning to have a proper read through the source, so that I can help out a bit more than just requesting features and reporting bugs ;-) Please let me know if I made any mistakes in the above!\r\n","reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/1166/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vimeo/psalm/issues/1166/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]