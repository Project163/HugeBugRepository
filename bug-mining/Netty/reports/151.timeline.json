013-04-16T18:59:48Z","performed_via_github_app":null},{"id":45419470,"node_id":"MDE1OlN1YnNjcmliZWRFdmVudDQ1NDE5NDcw","url":"https://api.github.com/repos/netty/netty/issues/events/45419470","actor":{"login":"trustin","id":173918,"node_id":"MDQ6VXNlcjE3MzkxOA==","avatar_url":"https://avatars.githubusercontent.com/u/173918?v=4","gravatar_id":"","url":"https://api.github.com/users/trustin","html_url":"https://github.com/trustin","followers_url":"https://api.github.com/users/trustin/followers","following_url":"https://api.github.com/users/trustin/following{/other_user}","gists_url":"https://api.github.com/users/trustin/gists{/gist_id}","starred_url":"https://api.github.com/users/trustin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/trustin/subscriptions","organizations_url":"https://api.github.com/users/trustin/orgs","repos_url":"https://api.github.com/users/trustin/repos","events_url":"https://api.github.com/users/trustin/events{/privacy}","received_events_url":"https://api.github.com/users/trustin/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2013-04-16T18:59:48Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/netty/netty/issues/comments/16561696","html_url":"https://github.com/netty/netty/issues/1266#issuecomment-16561696","issue_url":"https://api.github.com/repos/netty/netty/issues/1266","id":16561696,"node_id":"MDEyOklzc3VlQ29tbWVudDE2NTYxNjk2","user":{"login":"trustin","id":173918,"node_id":"MDQ6VXNlcjE3MzkxOA==","avatar_url":"https://avatars.githubusercontent.com/u/173918?v=4","gravatar_id":"","url":"https://api.github.com/users/trustin","html_url":"https://github.com/trustin","followers_url":"https://api.github.com/users/trustin/followers","following_url":"https://api.github.com/users/trustin/following{/other_user}","gists_url":"https://api.github.com/users/trustin/gists{/gist_id}","starred_url":"https://api.github.com/users/trustin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/trustin/subscriptions","organizations_url":"https://api.github.com/users/trustin/orgs","repos_url":"https://api.github.com/users/trustin/repos","events_url":"https://api.github.com/users/trustin/events{/privacy}","received_events_url":"https://api.github.com/users/trustin/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2013-04-18T07:33:21Z","updated_at":"2013-04-18T07:33:21Z","body":"Let's say we added three non-composite buffers to a composite buffer:\n\n```\nCompositeBuffer buf = Unpooled.compositeBuffer();\nByteBuf c1, c2, c3;\nbuf.addComponents(c1, c2, c3);\n```\n\nafter `addComponents()`, the reference count of `c1`, `c2`, `c3` stays same because `addComponents()` does not increase the reference count of the components.  It's because `CompositeByteBuf` assumes that the added buffer became a part of it.\n\nNow, let's create another `CompositeByteBuf` and add `buf` to it:\n\n```\nCompositeByteBuf buf2 = Unpooled.compositeBuffer();\nbuf2.addComponents(buf);\n```\n\nThis time, it should be interpreted that `buf` has become a part of `buf2`, and thus `buf` must be released when `buf2.release()` is called, just like it is for `c1`, `c2`, `c3` when `buf.release()` is called.\n\nThe problem is that it's not that simple because we do not keep `buf` but only keep `c1`, `c2`, `c3` in `buf2`.  `buf2.release()` will release `c1`, `c2`, and `c3`, but `buf` will not be released at all.  To fix this problem, `addComponent()` retains all components and then releases the `buf` so that the refCnt of the components stay same and a user doesn't need to worry about releasing `buf` later.\n\nI agree this is counter-intuitive.  What could be a proper fix?  \n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/netty/netty/issues/comments/16561696/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"trustin","id":173918,"node_id":"MDQ6VXNlcjE3MzkxOA==","avatar_url":"https://avatars.githubusercontent.com/u/173918?v=4","gravatar_id":"","url":"https://api.github.com/users/trustin","html_url":"https://github.com/trustin","followers_url":"https://api.github.com/users/trustin/followers","following_url":"https://api.github.com/users/trustin/following{/other_user}","gists_url":"https://api.github.com/users/trustin/gists{/gist_id}","starred_url":"https://api.github.com/users/trustin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/trustin/subscriptions","organizations_url":"https://api.github.com/users/trustin/orgs","repos_url":"https://api.github.com/users/trustin/repos","events_url":"https://api.github.com/users/trustin/events{/privacy}","received_events_url":"https://api.github.com/users/trustin/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/netty/netty/issues/comments/16562101","html_url":"https://github.com/netty/netty/issues/1266#issuecomment-16562101","issue_url":"https://api.github.com/repos/netty/netty/issues/1266","id":16562101,"node_id":"MDEyOklzc3VlQ29tbWVudDE2NTYyMTAx","user":{"login":"trustin","id":173918,"node_id":"MDQ6VXNlcjE3MzkxOA==","avatar_url":"https://avatars.githubusercontent.com/u/173918?v=4","gravatar_id":"","url":"https://api.github.com/users/trustin","html_url":"https://github.com/trustin","followers_url":"https://api.github.com/users/trustin/followers","following_url":"https://api.github.com/users/trustin/following{/other_user}","gists_url":"https://api.github.com/users/trustin/gists{/gist_id}","starred_url":"https://api.github.com/users/trustin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/trustin/subscriptions","organizations_url":"https://api.github.com/users/trustin/orgs","repos_url":"https://api.github.com/users/trustin/repos","events_url":"https://api.github.com/users/trustin/events{/privacy}","received_events_url":"https://api.github.com/users/trustin/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2013-04-18T07:45:45Z","updated_at":"2013-04-18T07:47:36Z","body":"One potential idea is to always increase the reference count of the component when it's added by `addComponent(s)`.  Instead, a user will have to release the buffer s/he specified with `addComponent(s)` by him/herself, which might be tedious.\n\nHowever, again, `addComponent` will not increase the reference count of the specified `CompositeByteBuf`, which might make things less predictable.\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/netty/netty/issues/comments/16562101/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"trustin","id":173918,"node_id":"MDQ6VXNlcjE3MzkxOA==","avatar_url":"https://avatars.githubusercontent.com/u/173918?v=4","gravatar_id":"","url":"https://api.github.com/users/trustin","html_url":"https://github.com/trustin","followers_url":"https://api.github.com/users/trustin/followers","following_url":"https://api.github.com/users/trustin/following{/other_user}","gists_url":"https://api.github.com/users/trustin/gists{/gist_id}","starred_url":"https://api.github.com/users/trustin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/trustin/subscriptions","organizations_url":"https://api.github.com/users/trustin/orgs","repos_url":"https://api.github.com/users/trustin/repos","events_url":"https://api.github.com/users/trustin/events{/privacy}","received_events_url":"https://api.github.com/users/trustin/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/netty/netty/issues/comments/16853931","html_url":"https://github.com/netty/netty/issues/1266#issuecomment-16853931","issue_url":"https://api.github.com/repos/netty/netty/issues/1266","id":16853931,"node_id":"MDEyOklzc3VlQ29tbWVudDE2ODUzOTMx","user":{"login":"trustin","id":173918,"node_id":"MDQ6VXNlcjE3MzkxOA==","avatar_url":"https://avatars.githubusercontent.com/u/173918?v=4","gravatar_id":"","url":"https://api.github.com/users/trustin","html_url":"https://github.com/trustin","followers_url":"https://api.github.com/users/trustin/followers","following_url":"https://api.github.com/users/trustin/following{/other_user}","gists_url":"https://api.github.com/users/trustin/gists{/gist_id}","starred_url":"https://api.github.com/users/trustin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/trustin/subscriptions","organizations_url":"https://api.github.com/users/trustin/orgs","repos_url":"https://api.github.com/users/trustin/repos","events_url":"https://api.github.com/users/trustin/events{/privacy}","received_events_url":"https://api.github.com/users/trustin/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2013-04-23T12:00:51Z","updated_at":"2013-04-23T12:00:51Z","body":"Some other ideas:\n- Instead of keeping its own reference counter in `DefaultCompositeByteBuf`, to make `retain()` and `release()` increment/decrement the reference counter of its components. The reference count of `DefaultCompositeByteBuf` could be the minimum reference count among its components.  There is obvious performance penalty in this idea though, especially the implementation `refCnt()`  requires an iteration over all its components to find the minimum.\n- Just don't unwrap.\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/netty/netty/issues/comments/16853931/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"trustin","id":173918,"node_id":"MDQ6VXNl