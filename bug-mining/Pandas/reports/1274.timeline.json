adrach/events{/privacy}","received_events_url":"https://api.github.com/users/rhshadrach/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"milestoned","commit_id":null,"commit_url":null,"created_at":"2021-02-11T02:35:32Z","milestone":{"title":"Contributions Welcome"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/pandas-dev/pandas/issues/comments/778919747","html_url":"https://github.com/pandas-dev/pandas/issues/36991#issuecomment-778919747","issue_url":"https://api.github.com/repos/pandas-dev/pandas/issues/36991","id":778919747,"node_id":"MDEyOklzc3VlQ29tbWVudDc3ODkxOTc0Nw==","user":{"login":"maroth96","id":72578587,"node_id":"MDQ6VXNlcjcyNTc4NTg3","avatar_url":"https://avatars.githubusercontent.com/u/72578587?v=4","gravatar_id":"","url":"https://api.github.com/users/maroth96","html_url":"https://github.com/maroth96","followers_url":"https://api.github.com/users/maroth96/followers","following_url":"https://api.github.com/users/maroth96/following{/other_user}","gists_url":"https://api.github.com/users/maroth96/gists{/gist_id}","starred_url":"https://api.github.com/users/maroth96/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/maroth96/subscriptions","organizations_url":"https://api.github.com/users/maroth96/orgs","repos_url":"https://api.github.com/users/maroth96/repos","events_url":"https://api.github.com/users/maroth96/events{/privacy}","received_events_url":"https://api.github.com/users/maroth96/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-02-15T03:51:14Z","updated_at":"2021-02-15T03:51:14Z","body":"The problem is in `_stack_multi_columns` (core/reshape/reshape.py)\r\n\r\nThe following line causes the dtypes to be lost:\r\n\r\n`new_columns = MultiIndex.from_tuples(unique_groups, names=new_names)`\r\n\r\nThe most straightforward solution is simply to add:\r\n\r\n```\r\nnew_columns = new_columns.set_levels([\r\n    new_columns.levels[i].astype(this.columns.levels[i].dtype)\r\n    for i in range(0, new_columns.size)\r\n])\r\n```\r\n\r\nThis causes my assertions to succeed. The additional conversions are not so elegant, however.\r\n\r\n@rhshadrach Shall I create such a change, or you see a better solution?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/pandas-dev/pandas/issues/comments/778919747/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"maroth96","id":72578587,"node_id":"MDQ6VXNlcjcyNTc4NTg3","avatar_url":"https://avatars.githubusercontent.com/u/72578587?v=4","gravatar_id":"","url":"https://api.github.com/users/maroth96","html_url":"https://github.com/maroth96","followers_url":"https://api.github.com/users/maroth96/followers","following_url":"https://api.github.com/users/maroth96/following{/other_user}","gists_url":"https://api.github.com/users/maroth96/gists{/gist_id}","starred_url":"https://api.github.com/users/maroth96/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/maroth96/subscriptions","organizations_url":"https://api.github.com/users/maroth96/orgs","repos_url":"https://api.github.com/users/maroth96/repos","events_url":"https://api.github.com/users/maroth96/events{/privacy}","received_events_url":"https://api.github.com/users/maroth96/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":4329621229,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50NDMyOTYyMTIyOQ==","url":"https://api.github.com/repos/pandas-dev/pandas/issues/events/4329621229","actor":{"login":"rhshadrach","id":45562402,"node_id":"MDQ6VXNlcjQ1NTYyNDAy","avatar_url":"https://avatars.githubusercontent.com/u/45562402?v=4","gravatar_id":"","url":"https://api.github.com/users/rhshadrach","html_url":"https://github.com/rhshadrach","followers_url":"https://api.github.com/users/rhshadrach/followers","following_url":"http