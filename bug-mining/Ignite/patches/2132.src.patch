diff --git a/modules/platforms/cpp/odbc/src/statement.cpp b/modules/platforms/cpp/odbc/src/statement.cpp
index 32f7c3f0c3..f1a577a2ad 100644
--- a/modules/platforms/cpp/odbc/src/statement.cpp
