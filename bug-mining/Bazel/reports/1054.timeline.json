er}","gists_url":"https://api.github.com/users/laszlocsomor/gists{/gist_id}","starred_url":"https://api.github.com/users/laszlocsomor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/laszlocsomor/subscriptions","organizations_url":"https://api.github.com/users/laszlocsomor/orgs","repos_url":"https://api.github.com/users/laszlocsomor/repos","events_url":"https://api.github.com/users/laszlocsomor/events{/privacy}","received_events_url":"https://api.github.com/users/laszlocsomor/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-01-25T15:05:14Z","updated_at":"2017-01-25T15:05:14Z","body":"(i'm looking at it)","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/275131562/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"laszlocsomor","id":10532244,"node_id":"MDQ6VXNlcjEwNTMyMjQ0","avatar_url":"https://avatars.githubusercontent.com/u/10532244?v=4","gravatar_id":"","url":"https://api.github.com/users/laszlocsomor","html_url":"https://github.com/laszlocsomor","followers_url":"https://api.github.com/users/laszlocsomor/followers","following_url":"https://api.github.com/users/laszlocsomor/following{/other_user}","gists_url":"https://api.github.com/users/laszlocsomor/gists{/gist_id}","starred_url":"https://api.github.com/users/laszlocsomor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/laszlocsomor/subscriptions","organizations_url":"https://api.github.com/users/laszlocsomor/orgs","repos_url":"https://api.github.com/users/laszlocsomor/repos","events_url":"https://api.github.com/users/laszlocsomor/events{/privacy}","received_events_url":"https://api.github.com/users/laszlocsomor/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/275183543","html_url":"https://github.com/bazelbuild/bazel/issues/2416#issuecomment-275183543","issue_url":"https://api.github.com/repos/bazelbuild/bazel/issues/2416","id":275183543,"node_id":"MDEyOklzc3VlQ29tbWVudDI3NTE4MzU0Mw==","user":{"login":"laszlocsomor","id":10532244,"node_id":"MDQ6VXNlcjEwNTMyMjQ0","avatar_url":"https://avatars.githubusercontent.com/u/10532244?v=4","gravatar_id":"","url":"https://api.github.com/users/laszlocsomor","html_url":"https://github.com/laszlocsomor","followers_url":"https://api.github.com/users/laszlocsomor/followers","following_url":"https://api.github.com/users/laszlocsomor/following{/other_user}","gists_url":"https://api.github.com/users/laszlocsomor/gists{/gist_id}","starred_url":"https://api.github.com/users/laszlocsomor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/laszlocsomor/subscriptions","organizations_url":"https://api.github.com/users/laszlocsomor/orgs","repos_url":"https://api.github.com/users/laszlocsomor/repos","events_url":"https://api.github.com/users/laszlocsomor/events{/privacy}","received_events_url":"https://api.github.com/users/laszlocsomor/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-01-25T18:00:23Z","updated_at":"2017-01-25T18:00:23Z","body":"Found the culprit. This is a funny one.\r\n\r\nThe failing test creates a params file and then asserts that the option parser recognizes that the flag is a path to a params file, parses the params file, and substitutes the args vector with the flags from the file.\r\n\r\nThis is the buggy line:\r\nhttps://github.com/bazelbuild/bazel/blob/54223b019817c329d7bff1c174d497ef3d64695a/src/main/java/com/google/devtools/common/options/ParamsFilePreProcessor.java#L70\r\n\r\nThe parser processes the file character-by-character, in order to handle multiline flag values, e.g. `--foo=line1\\nline2`. Problem is, Windows has CRLF line endings, so we terminate the arg parsing on the CR, and treat the LF as a standalone flag value, and push it into the args vector. So instead of [\"--baz\", \"oops\", \"--bar\", 17], we end up with [\"--baz\", \"\", \"oops\", \"\", \"--bar\", \"\", 17]","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/275183543/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"laszlocsomor","id":10532244,"node_id":"MDQ6VXNlcjEwNTMyMjQ0","avatar_url":"https://avatars.githubusercontent.com/u/10532244?v=4","gravatar_id":"","url":"https://api.github.com/users/laszlocsomor","html_url":"https://github.com/laszlocsomor","followers_url":"https://api.github.com/users/laszlocsomor/followers","following_url":"https://api.github.com/users/laszlocsomor/following{/other_user}","gists_url":"https://api.github.com/users/laszlocsomor/gists{/gist_id}","starred_url":"https://api.github.com/users/laszlocsomor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/laszlocsomor/subscriptions","organizations_url":"https://api.github.com/users/laszlocsomor/orgs","repos_url":"https://api.github.com/users/laszlocsomor/repos","events_url":"https://api.github.com/users/laszlocsomor/events{/privacy}","received_events_url":"https://api.github.com/users/laszlocsomor/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":936924669,"node_id":"MDExOkNsb3NlZEV2ZW50OTM2OTI0NjY5","url":"https://api.github.com/repos/bazelbuild/bazel/issues/events/936924669","actor":{"login":"bazel-io","id":15028808,"node_id":"MDQ6VXNlcjE1MDI4ODA4","avatar_url":"https://avatars.githubusercontent.com/u/15028808?v=4","gravatar_id":"","url":"https://api.github.com/users/bazel-io","html_url":"https://github.com/bazel-io","followers_url":"https://api.github.com/users/bazel-io/followers","following_url":"https://api.github.com/users/bazel-io/follow