orm/releases{/id}","deployments_url":"https://api.github.com/repos/typeorm/typeorm/deployments","created_at":"2016-02-29T07:41:14Z","updated_at":"2025-12-12T16:46:06Z","pushed_at":"2025-12-12T10:50:18Z","git_url":"git://github.com/typeorm/typeorm.git","ssh_url":"git@github.com:typeorm/typeorm.git","clone_url":"https://github.com/typeorm/typeorm.git","svn_url":"https://github.com/typeorm/typeorm","homepage":"http://typeorm.io","size":33014,"stargazers_count":36125,"watchers_count":36125,"language":"TypeScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":6469,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":540,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["active-record","cockroachdb","data-mapper","database","electron","hacktoberfest","javascript","mariadb","mysql","oracle","orm","postgresql","react-native","sap","sap-hana","sqlite","sqlserver","typeorm","typescript","websql"],"visibility":"public","forks":6469,"open_issues":540,"watchers":36125,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Thanks for the bug fix #159.\r\n\r\nBut, unfortunately, I came into another issue or I may not have configured it correctly. The cascading insert for a OneToOne from the base class doesn't propogate down.\r\n\r\nI'll be using the same example from #159, but added a field in the Person's Class\r\n\r\n```typescript\r\nimport {Table, Column, PrimaryGeneratedColumn, TableInheritance, DiscriminatorColumn, OneToOne, JoinColumn} from \"../src/index\";\r\nimport {Address} from \"./Address\";\r\n\r\n@Table()\r\n@TableInheritance(\"class-table\")\r\n@DiscriminatorColumn({ name: \"type\", type: \"string\"})\r\nexport class Person {\r\n\r\n    @PrimaryGeneratedColumn()\r\n    id: number;\r\n\r\n    @Column()\r\n    firstName: string;\r\n\r\n    @Column()\r\n    lastName: string;\r\n\r\n    @OneToOne((type) => Address, {cascadeInsert: true})\r\n    @JoinColumn({name: \"addressId\"})\r\n    address: Address;\r\n}\r\n```\r\n\r\n```typescript\r\nimport {ClassTableChild, Column, ManyToOne} from \"../src/index\";\r\nimport {Person} from \"./Person\";\r\nimport {Department} from \"./Department\";\r\n\r\n@ClassTableChild()\r\nexport class Employee extends Person {\r\n\r\n    @Column()\r\n    salary: number;\r\n}\r\n```\r\n\r\n```typescript\r\nimport {Table, Column, PrimaryGeneratedColumn} from \"../src/index\";\r\n\r\n@Table()\r\nexport class Address {\r\n    @PrimaryGeneratedColumn()\r\n    id: number;\r\n\r\n    @Column()\r\n    streetName: string;\r\n}\r\n```\r\n\r\n```typescript\r\nimport {Table, JoinColumn, Column, PrimaryGeneratedColumn, OneToMany} from \"../src/index\";\r\nimport {OneToOne} from \"../src/decorator/relations/OneToOne\";\r\nimport {Employee} from \"./Employee\";\r\n\r\n@Table()\r\nexport class Department {\r\n\r\n    @PrimaryGeneratedColumn()\r\n    id: number;\r\n\r\n    @Column()\r\n    name: string;\r\n\r\n    @OneToOne( (type) => Employee, { cascadeInsert: true, nullable: false})\r\n    @JoinColumn({name: \"managerId\"})\r\n    manager: Employee;\r\n}\r\n```\r\n\r\n```typescript\r\nrequire(\"reflect-metadata\");\r\nimport {createConnection, ConnectionOptions, Connection} from \"./src/index\";\r\nimport {Person} from \"./entities/Person\";\r\nimport {Department} from \"./entities/Department\";\r\nimport {Employee} from \"./entities/Employee\";\r\nimport {Address} from \"./entities/Address\";\r\n\r\nlet dbConnection = {\r\n    type: \"mysql\",\r\n    host: \"localhost\",\r\n    port: 3306,\r\n    username: \"root\",\r\n    password: \"root\",\r\n    database: \"test_dev\",\r\n};\r\n\r\ncreateConnection({\r\n    driver: dbConnection,\r\n    entities: [\r\n        // __dirname + \"/entities/*.js\",\r\n        Address, Person, Employee, Department,\r\n    ],\r\n    dropSchemaOnConnection: true,\r\n    autoSchemaSync: true,\r\n} as ConnectionOptions).then( async (connection: Connection) => {\r\n    let x = connection.entityManager;\r\n\r\n    let department = new Department();\r\n    department.name = \"Software\";\r\n\r\n    let employee1 = new Employee();\r\n    employee1.firstName = \"Hello\";\r\n    employee1.lastName = \"World\";\r\n    employee1.salary = 1;\r\n\r\n    let address1 = new Address();\r\n    address1.streetName = \"1234 Around the Globe\";\r\n\r\n    employee1.address = address1;\r\n    department.manager = employee1;\r\n\r\n    await x.persist(department);\r\n\r\n    console.log(\"Done!\");\r\n\r\n}).catch( (error) => {\r\n    console.log(`Error: ${error.message}`);\r\n});\r\n```\r\n\r\nI do not get any fields populated in the Address table nor an id for it to populate the Person's table.\r\n\r\nAlso if i put in the column options for address:\r\n ```\r\n{ cascadeInsert: true, nullable: false }\r\n```\r\nthen i get an error:\r\n\r\n> ER_NO_DEFAULT_FOR_FIELD: Field 'addressId' doesn't have a default value\r\n\r\nBut for now i can work with it being nullable.","reactions":{"url":"https://api.github.com/repos/typeorm/typeorm/issues/168/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/typeorm/typeorm/issues/168/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/typeorm/typeorm/issues/comments/270055839","html_url":"https://github.com/typeorm/typeorm/issues/159#issuecomment-270055839","issue_url":"https://api.github.com/repos/typeorm/typeorm/issues/159","id":270055839,"node_id":"MDEyOklzc3VlQ29tbWVudDI3MDA1NTgzOQ==","user":{"login":"jmai00","id":6107443,"node_id":"MDQ6VXNlcjYxMDc0NDM=","avatar_url":"https://avatars.githubusercontent.com/u/6107443?v=4