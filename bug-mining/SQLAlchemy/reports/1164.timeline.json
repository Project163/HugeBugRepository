rivacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-05-14T17:46:05Z","updated_at":"2021-05-14T17:46:05Z","body":"note also that LazyLoader is not using the strategy-local statement cache for loads that are not use_get, apparently.   We should likely move to having LazyLoader/SelectInLoader use the regular engine cache for statement caching and their own local cache just for the lambda part of it.   ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/841402590/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/842763387","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/6072#issuecomment-842763387","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/6072","id":842763387,"node_id":"MDEyOklzc3VlQ29tbWVudDg0Mjc2MzM4Nw==","user":{"login":"gj","id":17556281,"node_id":"MDQ6VXNlcjE3NTU2Mjgx","avatar_url":"https://avatars.githubusercontent.com/u/17556281?v=4","gravatar_id":"","url":"https://api.github.com/users/gj","html_url":"https://github.com/gj","followers_url":"https://api.github.com/users/gj/followers","following_url":"https://api.github.com/users/gj/following{/other_user}","gists_url":"https://api.github.com/users/gj/gists{/gist_id}","starred_url":"https://api.github.com/users/gj/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gj/subscriptions","organizations_url":"https://api.github.com/users/gj/orgs","repos_url":"https://api.github.com/users/gj/repos","events_url":"https://api.github.com/users/gj/events{/privacy}","received_events_url":"https://api.github.com/users/gj/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-05-18T01:54:37Z","updated_at":"2021-05-18T01:54:37Z","body":"> right now you can disable ORM query caching like this:\r\n> \r\n> ```\r\n> from sqlalchemy import event\r\n> @event.listens_for(Session, \"do_orm_execute\")\r\n> def do_orm_execute(execute_state):\r\n>     execute_state.update_execution_options(compiled_cache=None)\r\n> ```\r\n\r\nI'm trying to disable caching on 1.4.15, and I can't get the above to work. The `compiled_cache` option doesn't seem to be updated to `None`, and this breakpoint is hit:\r\n\r\n```py\r\n@event.listens_for(Session, \"do_orm_execute\")\r\ndef do_orm_execute(execute_state):\r\n    execute_state.update_execution_options(compiled_cache=None)\r\n    after = execute_state.execution_options.get(\"compiled_cache\")\r\n    if after is not None:\r\n        breakpoint()\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/842763387/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"gj","id":17556281,"node_id":"MDQ6VXNlcjE3NTU2Mjgx","avatar_url":"https://avatars.githubusercontent.com/u/17556281?v=4","gravatar_id":"","url":"https://api.github.com/users/gj","html_url":"https://github.com/gj","followers_url":"https://api.github.com/users/gj/followers","following_url":"https://api.github.com/users/gj/following{/other_user}","gists_url":"https://api.github.com/users/gj/gists{/gist_id}","starred_url":"https://api.github.com/users/gj/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gj/subscriptions","organizations_url":"https://api.github.com/users/gj/orgs","repos_url":"https://api.github.com/users/gj/repos","events_url":"https://api.github.com/users/gj/events{/privacy}","received_events_url":"https://api.github.com/users/gj/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/842766140","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/6072#issuecomment-842766140","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/6072","id":842766140,"node_id":"MDEyOklzc3VlQ29tbWVudDg0Mjc2NjE0MA==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-05-18T02:00:41Z","updated_at":"2021-05-18T02:02:43Z","body":"> I'm trying to disable caching on 1.4.15, and I can't get the above to work. The `compiled_cache` option doesn't seem to be updated to `None`, and this breakpoint is hit:\r\n\r\n\r\ncant reproduce, please run the test case below, modify it to produce an [MCVE](http://stackoverflow.com/help/mcve) illustrating how to make it fail:\r\n\r\n```python\r\nfrom sqlalchemy import Column\r\nfrom sqlalchemy import create_engine\r\nfrom sqlalchemy import event\r\nfrom sqlalchemy import ForeignKey\r\nfrom sqlalchemy import Integer\r\nfrom sqlalchemy import String\r\nfrom sqlalchemy.orm import declarative_base\r\nfrom sqlalchemy.orm import relationship\r\nfrom sqlalchemy.orm import Session\r\n\r\n\r\n@event.listens_for(Session, \"do_orm_execute\")\r\ndef do_orm_execute(execute_state):\r\n    execute_state.update_execution_options(compiled_cache=None)\r\n    after = execute_state.execution_options.get(\"compiled_cache\")\r\n    if after is not None:\r\n        breakpoint()\r\n\r\n\r\nBase = declarative_base()\r\n\r\n\r\nclass A(Base):\r\n    __tablename__ = \"a\"\r\n\r\n    id = Column(Integer, primary_key=True)\r\n    data = Column(String)\r\n\r\n    bs = relationship(\"B\")\r\n\r\n\r\nclass B(Base):\r\n    __tablename__ = 'b'\r\n    id = Column(Integer, primary_key=True)\r\n    a_id = Column(ForeignKey(\"a.id\"))\r\n    data = Column(String)\r\n\r\n\r\ne = create_engine(\"sqlite://\", echo=True)\r\nBase.metadata.create_all(e)\r\n\r\ns = Session(e)\r\n\r\ns.add(A(bs=[B()]))\r\n\r\ns.commit()\r\n\r\nfor a in s.query(A).all():\r\n    a.bs\r\n```\r\nthe assertion passes, output shows no caching:\r\n\r\n```sql\r\nSELECT a.id AS a_id, a.data AS a_data \r\nFROM a\r\n2021-05-17 21:59:37,201 INFO sqlalchemy.engine.Engine [caching disabled 0.00008s] ()\r\n2021-05-17 21:59:37,203 INFO sqlalchemy.engine.Engine SELECT b.id AS b_id, b.a_id AS b_a_id, b.data AS b_data \r\nFROM b \r\nWHERE ? = b.a_id\r\n2021-05-17 21:59:37,203 INFO sqlalchemy.engine.Engine [caching disabled 0.00009s] (1,)\r\n\r\n```\r\n\r\nalso, what is the reason you need to disable caching?   caching needs to be 100% bug free, and if not, you need to post an issue here describing what you are seeing.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/842766140/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/842790107","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/6072#issuecomment-842790107","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/6072","id":842790107,"node_id":"MDEyOklzc3VlQ29tbWVudDg0Mjc5MDEwNw==","user":{"login":"gj","id":17556281,"node_id":"MDQ6VXNlcjE3NTU2Mjgx","avatar_url":"https://avatars.githubusercontent.com/u/17556281?v=4","gravatar_id":"","url":"https://api.github.com/users/gj","html_url":"https://github.com/gj","followers_url":"https://api.github.com/users/gj/followers","following_url":"https://api.github.com/users/gj/following{/other_user}","gists_url":"https://api.github.com/users/gj/gists{/gist_id}","starred_url":"https://api.github.com/users/gj/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gj/subscriptions","organizations_url":"https://api.github.com/users/gj/orgs","repos_url":"https://api.github.com/users/gj/repos","events_url":"https://api.github.com/users/gj/events{/privacy}","received_events_url":"https://api.github.com/users/gj/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-05-18T03:04:45Z","updated_at":"2021-05-18T03:04:45Z","body":"> cant reproduce, please run the test case below, modify it to produce an [MCVE](http://stackoverflow.com/help/mcve) illustrating how to make it fail:\r\n\r\nCan't reproduce via modifying your snippet either — I'm probably doing something dumb in the actual code where I'm seeing the issue. Too tired to continue debugging now, but I'll update this thread tomorrow once I figure it out.\r\n\r\n> also, what is the reason you need to disable caching?\r\n\r\nBuilding authorization software (https://github.com/osohq/oso/tree/main/languages/python/sqlalchemy-oso) where query caching can lead to authorization bypass. On SQLAlchemy 1.3, I was able to get around this by setting `enable_baked_queries=False`, but I'm currently trying to update the library so that it supports SQLAlchemy 1.4 in addition to 1.3. This is one of a few assertions in the test suite that fails if baked queries are enabled on 1.3:\r\n\r\nhttps://github.com/osohq/oso/blob/1f8cbcf49f247451e4f8e427bab57f10c83ad8c0/languages/python/sqlalchemy-oso/tests/test_sqlalchemy.py#L331\r\n\r\nBasically, a lazy-loaded relationship is queried via a session that has no authorization applied:\r\n\r\nhttps://github.com/osohq/oso/blob/1f8cbcf49f247451e4f8e427bab57f10c83ad8c0/languages/python/sqlalchemy-oso/tests/test_sqlalchemy.py#L317-L318\r\n\r\nAnd then when a subsequent query is made via the `AuthorizedSession`, which subclasses `Session` and sets `enable_baked_queries=False`, the relationship query returns `None` since authorization is correctly enforced.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/842790107/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"gj","id":17556281,"node_id":"MDQ6VXNlcjE3NTU2Mjgx","avatar_url":"https://avatars.githubusercontent.com/u/17556281?v=4","gravatar_id":"","url":"https://api.github.com/users/gj","html_url":"https://github.com/gj","followers_url":"https://api.github.com/users/gj/followers","following_url":"https://api.github.com/users/gj/following{/other_user}","gists_url":"https://api.github.com/users/gj/gists{/gist_id}","starred_url":"https://api.github.com/users/gj/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gj/subscriptions","organizations_url":"https://api.github.com/users/gj/orgs","repos_url":"https://api.github.com/users/gj/repos","events_url":"https://api.github.com/users/gj/events{/privacy}","received_events_url":"https://api.github.com/users/gj/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/842792273","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/6072#issuecomment-842792273","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/6072","id":842792273,"node_id":"MDEyOklzc3VlQ29tbWVudDg0Mjc5MjI3Mw==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-05-18T03:11:11Z","updated_at":"2021-05-18T03:11:11Z","body":"1.3's baked queries had problems when events were used to modify them on the fly.  the new query caching with do_orm_execute() should solve this problem entirely.     you can modify the query in do_orm_execute() in any way that you'd like, and the cache key is only created **after** the query has been modified, so whatever modifications have been made will also be reflected in the cache key.   \r\n\r\nI really need you to show me a self-contained example of how you are altering the query in such a way that caching is providing a stale query.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/842792273/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/843399796","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/6072#issuecomment-843399796","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/6072","id":843399796,"node_id":"MDEyOklzc3VlQ29tbWVudDg0MzM5OTc5Ng==","user":{"login":"gj","id":17556281,"node_id":"MDQ6VXNlcjE3NTU2Mjgx","avatar_url":"https://avatars.githubusercontent.com/u/17556281?v=4","gravatar_id":"","url":"https://api.github.com/users/gj","html_url":"https://github.com/gj","followers_url":"https://api.github.com/users/gj/followers","following_url":"https://api.github.com/users/gj/following{/other_user}","gists_url":"https://api.github.com/users/gj/gists{/gist_id}","starred_url":"https://api.github.com/users/gj/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gj/subscriptions","organizations_url":"https://api.github.com/users/gj/orgs","repos_url":"https://api.github.com/users/gj/repos","events_url":"https://api.github.com/users/gj/events{/privacy}","received_events_url":"https://api.github.com/users/gj/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-05-18T17:48:27Z","updated_at":"2021-05-18T17:49:08Z","body":"Turns out — to no one's surprise — that it was late and I was being dumb. I missed this caveat in the `QueryEvents.before_compile` deprecation notice:\r\n\r\nhttps://github.com/sqlalchemy/sqlalchemy/blob/71a858817cb8c11451ae577c61329f4239fab46b/lib/sqlalchemy/orm/events.py#L2676-L2679\r\n\r\nPreviously, we were using the `QueryEvents.before_compile` hook to apply authorization both on top-level queries as well as relationship loads, but the event is no longer emitted for attribute loads in 1.4.\r\n\r\nSo the main failure I was seeing was caused by not applying authorization to attribute loads instead of incorrect caching. I _was_ still seeing some cases where there was a populated cache even after setting the `compiled_cache=None` execution option, but I'm assuming that's another PEBKAC. If I see that behavior again, I will try to modify your test case to reproduce it, but I'm assuming it's all related to my incomplete update from 1.3 -> 1.4.\r\n\r\nETA: sorry for the issue noise @zzzeek, and thanks for all of your hard work on SQLAlchemy!","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/843399796/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"gj","id":17556281,"node_id":"MDQ6VXNlcjE3NTU2Mjgx","avatar_url":"https://avatars.githubusercontent.com/u/17556281?v=4","gravatar_id":"","url":"https://api.github.com/users/gj","html_url":"https://github.com/gj","followers_url":"https://api.github.com/users/gj/followers","following_url":"https://api.github.com/users/gj/following{/other_user}","gists_url":"https://api.github.com/users/gj/gists{/gist_id}","starred_url":"https://api.github.com/users/gj/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gj/subscriptions","organizations_url":"https://api.github.com/users/gj/orgs","repos_url":"https://api.github.com/users/gj/repos","events_url":"https://api.github.com/users/gj/events{/privacy}","received_events_url":"https://api.github.com/users/gj/received_events"