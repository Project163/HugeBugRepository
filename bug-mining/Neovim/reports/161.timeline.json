[{"url":"https://api.github.com/repos/neovim/neovim/issues/comments/330440635","html_url":"https://github.com/neovim/neovim/issues/7291#issuecomment-330440635","issue_url":"https://api.github.com/repos/neovim/neovim/issues/7291","id":330440635,"node_id":"MDEyOklzc3VlQ29tbWVudDMzMDQ0MDYzNQ==","user":{"login":"justinmk","id":1359421,"node_id":"MDQ6VXNlcjEzNTk0MjE=","avatar_url":"https://avatars.githubusercontent.com/u/1359421?v=4","gravatar_id":"","url":"https://api.github.com/users/justinmk","html_url":"https://github.com/justinmk","followers_url":"https://api.github.com/users/justinmk/followers","following_url":"https://api.github.com/users/justinmk/following{/other_user}","gists_url":"https://api.github.com/users/justinmk/gists{/gist_id}","starred_url":"https://api.github.com/users/justinmk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/justinmk/subscriptions","organizations_url":"https://api.github.com/users/justinmk/orgs","repos_url":"https://api.github.com/users/justinmk/repos","events_url":"https://api.github.com/users/justinmk/events{/privacy}","received_events_url":"https://api.github.com/users/justinmk/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-09-19T06:17:49Z","updated_at":"2017-09-19T06:22:07Z","body":"It might be risky to try to remove one or the other and figure out the conditions or manage extra state to avoid showing the second one.\r\n\r\nMy favored approach for reducing error-message annoyance is to avoid the Press-Enter prompt entirely.  https://github.com/neovim/neovim/pull/1802 is related, but will take a different, more comprehensive direction.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/neovim/neovim/issues/comments/330440635/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"justinmk","id":1359421,"node_id":