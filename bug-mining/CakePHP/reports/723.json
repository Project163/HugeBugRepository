akephp/milestone/60","labels_url":"https://api.github.com/repos/cakephp/cakephp/milestones/60/labels","id":1314897,"node_id":"MDk6TWlsZXN0b25lMTMxNDg5Nw==","number":60,"title":"3.1.1","description":"Bugfixes and minor enhancements for 3.1.x","creator":{"login":"markstory","id":24086,"node_id":"MDQ6VXNlcjI0MDg2","avatar_url":"https://avatars.githubusercontent.com/u/24086?v=4","gravatar_id":"","url":"https://api.github.com/users/markstory","html_url":"https://github.com/markstory","followers_url":"https://api.github.com/users/markstory/followers","following_url":"https://api.github.com/users/markstory/following{/other_user}","gists_url":"https://api.github.com/users/markstory/gists{/gist_id}","starred_url":"https://api.github.com/users/markstory/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/markstory/subscriptions","organizations_url":"https://api.github.com/users/markstory/orgs","repos_url":"https://api.github.com/users/markstory/repos","events_url":"https://api.github.com/users/markstory/events{/privacy}","received_events_url":"https://api.github.com/users/markstory/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":69,"state":"closed","created_at":"2015-09-20T02:24:50Z","updated_at":"2018-02-22T20:36:08Z","due_on":null,"closed_at":"2015-10-07T02:15:33Z"},"comments":1,"created_at":"2015-09-17T20:28:59Z","updated_at":"2015-09-20T16:10:35Z","closed_at":"2015-09-20T16:10:35Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"The `$override` flag in `Cake\\ORM\\Query::contain()` doesn't reset existing associations as expected unless `contain()` is first called with no associations and then repopulated:\n\n```\nclass MyController extends AppController {\n    public function index() {\n        $query = $this->MyModel->find();\n        $query->contain(['OtherModel1', 'OtherModel2']);\n\n        // case 1 (broken):\n        $query->contain(['OtherModel1'], true); // OtherModel2 should be removed by this\n        debug($query->contain()); // OtherModel2 is still present - unexpected behaviour\n\n        // case 2 (working/workaround):\n        $query->contain(null, true); // trigger if (empty($associations) && $override) condition to remove all associations\n        $query->contain(['OtherModel1']);  // repopulate with only the associations we want\n        debug($query->contain()); // now OtherModel2 is gone as expected\n    }\n}\n```\n\nAffects version: 3.0.13\nReference: http://api.cakephp.org/3.0/class-Cake.ORM.Query.html#_contain\n","closed_by":{"login":"markstory","id":24086,"node_id":"MDQ6VXNlcjI0MDg2","avatar_url":"https://avatars.githubusercontent.com/u/24086?v=4","gravatar_id":"","url":"https://api.github.com/users/markstory","html_url":"https://github.com/markstory","followers_url":"https://api.github.com/users/markstory/followers","following_url":"https://api.github.com/users/markstory/following{/other_user}","gists_url":"https://api.github.com/users/markstory/gists{/gist_id}","starred_url":"https://api.github.com/users/markstory/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/markstory/subscriptions","organizations_url":"https://api.github.com/users/markstory/orgs","repos_url":"https://api.github.com/users/markstory/repos","events_url":"https://api.github.com/users/markstory/events{/privacy}","received_events_url":"https://api.github.com/users/markstory/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/7412/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/cakephp/cakephp/issues/7412/timeline","performed_via_github_app":null,"st