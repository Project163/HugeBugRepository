    &amp;lt;img width=&quot;560&quot; alt=&quot;clear-output-paragraph&quot; src=&quot;https://cloud.githubusercontent.com/assets/2031306/10750543/9d4c1754-7c9c-11e5-87a8-fa35b8457dfa.png&quot;&amp;gt;&lt;/p&gt;

