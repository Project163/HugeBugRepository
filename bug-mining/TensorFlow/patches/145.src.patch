+  BM_DiagDev(N, std::complex<float>, DT_COMPLEX64, cpu); \
+  BM_DiagDev(N, int, DT_INT32, gpu);                     \
+  BM_DiagDev(N, float, DT_FLOAT, gpu);                   \
