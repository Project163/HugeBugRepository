vents{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":{"url":"https://api.github.com/repos/g-truc/glm/milestones/6","html_url":"https://github.com/g-truc/glm/milestone/6","labels_url":"https://api.github.com/repos/g-truc/glm/milestones/6/labels","id":173769,"node_id":"MDk6TWlsZXN0b25lMTczNzY5","number":6,"title":"GLM 0.9.8","description":"","creator":{"login":"Groovounet","id":367227,"node_id":"MDQ6VXNlcjM2NzIyNw==","avatar_url":"https://avatars.githubusercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":91,"state":"open","created_at":"2012-09-12T10:39:31Z","updated_at":"2019-04-02T09:34:45Z","due_on":null,"closed_at":null},"comments":7,"created_at":"2017-02-05T21:14:27Z","updated_at":"2017-02-25T03:17:45Z","closed_at":"2017-02-16T00:27:30Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"When building on OSX using self-compiled clang or a clang package from MacPorts, glm gets the following kind of build errors (using clang 3.9.1):\r\n\r\n```\r\nglm/glm/detail/../simd/platform.h:157:5: error: \"GLM requires Clang 3.4 / Apple Clang 6.0 or higher\"\r\n#                       error \"GLM requires Clang 3.4 / Apple Clang 6.0 or higher\"\r\n```\r\n\r\nThe issue is that these kinds of clang builds use standard clang numbers rather than Apple's inflated clang version numbers.  I'm not sure whether it's possible to detect this using the preprocessor, and `__APPLE_CC__` and `__APPLE__` macros are still defined.\r\n\r\nWould it be possible to provide a mechanism to hint that clang is using standard version numbers on OSX?  I don't mind if I have to define another macro, like `GLM_MACPORTS_COMPILER` or something.","closed_by":{"login":"Groovounet","id":367227,"node_id":"MDQ6VXNlcjM2NzIyNw==","avatar_url":"https://avatars.githubusercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/g-truc/glm/issues/608/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/g-truc/glm/issues/608/timeline","performed