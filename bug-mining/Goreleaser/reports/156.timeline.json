 solved","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/goreleaser/goreleaser/issues/comments/734763890/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":1,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"gssbzn","id":461027,"node_id":"MDQ6VXNlcjQ2MTAyNw==","avatar_url":"https://avatars.githubusercontent.com/u/461027?v=4","gravatar_id":"","url":"https://api.github.com/users/gssbzn","html_url":"https://github.com/gssbzn","followers_url":"https://api.github.com/users/gssbzn/followers","following_url":"https://api.github.com/users/gssbzn/following{/other_user}","gists_url":"https://api.github.com/users/gssbzn/gists{/gist_id}","starred_url":"https://api.github.com/users/gssbzn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gssbzn/subscriptions","organizations_url":"https://api.github.com/users/gssbzn/orgs","repos_url":"https://api.github.com/users/gssbzn/repos","events_url":"https://api.github.com/users/gssbzn/events{/privacy}","received_events_url":"https://api.github.com/users/gssbzn/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/goreleaser/goreleaser/issues/comments/756259001","html_url":"https://github.com/goreleaser/goreleaser/issues/1804#issuecomment-756259001","issue_url":"https://api.github.com/repos/goreleaser/goreleaser/issues/1804","id":756259001,"node_id":"MDEyOklzc3VlQ29tbWVudDc1NjI1OTAwMQ==","user":{"login":"caarlos0","id":245435,"node_id":"MDQ6VXNlcjI0NTQzNQ==","avatar_url":"https://avatars.githubusercontent.com/u/245435?v=4","gravatar_id":"","url":"https://api.github.com/users/caarlos0","html_url":"https://github.com/caarlos0","followers_url":"https://api.github.com/users/caarlos0/followers","following_url":"https://api.github.com/users/caarlos0/following{/other_user}","gists_url":"https://api.github.com/users/caarlos0/gists{/gist_id}","starred_url":"https:/