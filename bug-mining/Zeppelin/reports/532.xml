&lt;p&gt;    Zeppelin sparkr only shows first element of all outputs due to invalid implementation&lt;/p&gt;

&lt;p&gt;    ```scala&lt;br/&gt;
    // &lt;a href=&quot;https://github.com/apache/zeppelin/blob/master/spark/src/main/scala/org/apache/zeppelin/spark/ZeppelinRDisplay.scala#L71&quot; class=&quot;external-link&quot; target=&quot;_blank&quot; rel=&quot;nofollow noopener&quot;&gt;https://github.com/apache/zeppelin/blob/master/spark/src/main/scala/org/apache/zeppelin/spark/ZeppelinRDisplay.scala#L71&lt;/a&gt;&lt;/p&gt;

&lt;p&gt;    private def textDisplay(body: Element): RDisplay = &lt;/p&gt;
{
      // we are extracting only the first element. it shouldn&apos;t
      RDisplay(body.getElementsByTag(&quot;p&quot;).first().html(), TEXT, SUCCESS)
    }
&lt;p&gt;    ```&lt;/p&gt;

&lt;ol&gt;
	&lt;li&gt;
	&lt;ol&gt;
		&lt;li&gt;
		&lt;ol&gt;
			&lt;li&gt;
