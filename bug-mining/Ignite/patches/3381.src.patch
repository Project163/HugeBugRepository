+                                    cache.put(r.nextInt(ENTRIES), new String(randBytes));
+
+                                    break;
+                                case 1:
+                                    cache.remove(r.nextInt(ENTRIES));
+
+                                    break;
+                                case 2:
+                                    cache.get(r.nextInt(ENTRIES));
+
+                                    break;
+                            }
+
+                            threadProgressTracker.compute(Thread.currentThread().getId(),
+                                (tId, ops) -> ops == null ? 1 : ops + 1);
