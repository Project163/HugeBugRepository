b.com/users/jnothman/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1988062268,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50MTk4ODA2MjI2OA==","url":"https://api.github.com/repos/scikit-learn/scikit-learn/issues/events/1988062268","actor":{"login":"jeremiedbb","id":34657725,"node_id":"MDQ6VXNlcjM0NjU3NzI1","avatar_url":"https://avatars.githubusercontent.com/u/34657725?v=4","gravatar_id":"","url":"https://api.github.com/users/jeremiedbb","html_url":"https://github.com/jeremiedbb","followers_url":"https://api.github.com/users/jeremiedbb/followers","following_url":"https://api.github.com/users/jeremiedbb/following{/other_user}","gists_url":"https://api.github.com/users/jeremiedbb/gists{/gist_id}","starred_url":"https://api.github.com/users/jeremiedbb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jeremiedbb/subscriptions","organizations_url":"https://api.github.com/users/jeremiedbb/orgs","repos_url":"https://api.github.com/users/jeremiedbb/repos","events_url":"https://api.github.com/users/jeremiedbb/events{/privacy}","received_events_url":"https://api.github.com/users/jeremiedbb/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"mentioned","commit_id":null,"commit_url":null,"created_at":"2018-11-26T22:21:47Z","performed_via_github_app":null},{"id":1988062270,"node_id":"MDE1OlN1YnNjcmliZWRFdmVudDE5ODgwNjIyNzA=","url":"https://api.github.com/repos/scikit-learn/scikit-learn/issues/events/1988062270","actor":{"login":"jeremiedbb","id":34657725,"node_id":"MDQ6VXNlcjM0NjU3NzI1","avatar_url":"https://avatars.githubusercontent.com/u/34657725?v=4","gravatar_id":"","url":"https://api.github.com/users/jeremiedbb","html_url":"https://github.com/jeremiedbb","followers_url":"https://api.github.com/users/jeremiedbb/followers","following_url":"https://api.github.com/users/jeremiedbb/following{/other_user}","gists_url":"https://api.github.com/users/jeremiedbb/gists{/gist_id}","starred_url":"https://api.github.com/users/jeremiedbb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jeremiedbb/subscriptions","organizations_url":"https://api.github.com/users/jeremiedbb/orgs","repos_url":"https://api.github.com/users/jeremiedbb/repos","events_url":"https://api.github.com/users/jeremiedbb/events{/privacy}","received_events_url":"https://api.github.com/users/jeremiedbb/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2018-11-26T22:21:47Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/scikit-learn/scikit-learn/issues/comments/443217075","html_url":"https://github.com/scikit-learn/scikit-learn/issues/12672#issuecomment-443217075","issue_url":"https://api.github.com/repos/scikit-learn/scikit-learn/issues/12672","id":443217075,"node_id":"MDEyOklzc3VlQ29tbWVudDQ0MzIxNzA3NQ==","user":{"login":"jeremiedbb","id":34657725,"node_id":"MDQ6VXNlcjM0NjU3NzI1","avatar_url":"https://avatars.githubusercontent.com/u/34657725?v=4","gravatar_id":"","url":"https://api.github.com/users/jeremiedbb","html_url":"https://github.com/jeremiedbb","followers_url":"https://api.github.com/users/jeremiedbb/followers","following_url":"https://api.github.com/users/jeremiedbb/following{/other_user}","gists_url":"https://api.github.com/users/jeremiedbb/gists{/gist_id}","starred_url":"https://api.github.com/users/jeremiedbb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jeremiedbb/subscriptions","organizations_url":"https://api.github.com/users/jeremiedbb/orgs","repos_url":"https://api.github.com/users/jeremiedbb/repos","events_url":"https://api.github.com/users/jeremiedbb/events{/privacy}","received_events_url":"https://api.github.com/users/jeremiedbb/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-11-30T14:19:38Z","updated_at":"2018-11-30T14:19:38Z","body":"Here is a reproducible example, only involving pairwise distances, which fails on master:\r\n```python\r\n@pytest.mark.parametrize(\"n_jobs\", [1, 2, -1])\r\n@pytest.mark.parametrize(\"metric\", [\"seuclidean\", \"mahalanobis\"])\r\n@pytest.mark.parametrize(\"dist_function\",\r\n                         [pairwise_distances, pairwise_distances_chunked])\r\n@pytest.mark.parametrize(\"y_is_x\", [True, False], ids=[\"Y==X\", \"Y!=X\"])\r\ndef test_pairwise_distances_data_derived_params(n_jobs, metric, dist_function,\r\n                                                y_is_x):\r\n    # check that pairwise_distances give the same result in sequential and\r\n    # parallel, when metric has data-derived parameters.\r\n    set_config(working_memory=0.1)  # to have more than 1 chunk\r\n\r\n    rng = np.random.RandomState(0)\r\n\r\n    X = rng.random_sample((1000, 10))\r\n\r\n    if y_is_x:\r\n        if n_jobs == 1:\r\n            expected_dist = squareform(pdist(X, metric=metric))\r\n        else:\r\n            expected_dist = cdist(X, metric=metric)\r\n        Y = X\r\n    else:\r\n        Y = rng.random_sample((1000, 10))\r\n        expected_dist = cdist(X, Y, metric=metric)\r\n\r\n    dist = np.vstack(dist_function(X, Y, metric=metric, n_jobs=n_jobs))\r\n\r\n    assert_allclose(dist, expected_dist)\r\n```\r\n\r\nThe test only passes with `pairwise_distances` when `n_jobs==1`. It fails with `pairwise_distances_chunked`, because data is processed by chunks, even with `n_jobs=1`.\r\n\r\nLooking at the code of `pairwise_distances`, I found something which does not seem optimal. When `Y==X`, if `n_jobs==1` pdist is used and otherwise cdist is used. When `Y==X`, only half of the computations is necessary. cdist is not the right function for that. Anyway, it allowed to discover a bug in scipy: `pdist(X)` and `cdist(X,X)` disagree for the same metrics, for similar reasons about differently computing metric params, see https://github.com/scipy/scipy/issues/9555.","author_association":"MEMBER","pin":null,"reac