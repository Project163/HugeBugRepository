i.github.com/repos/laravel/framework/issues/events{/number}","events_url":"https://api.github.com/repos/laravel/framework/events","assignees_url":"https://api.github.com/repos/laravel/framework/assignees{/user}","branches_url":"https://api.github.com/repos/laravel/framework/branches{/branch}","tags_url":"https://api.github.com/repos/laravel/framework/tags","blobs_url":"https://api.github.com/repos/laravel/framework/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/laravel/framework/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/laravel/framework/git/refs{/sha}","trees_url":"https://api.github.com/repos/laravel/framework/git/trees{/sha}","statuses_url":"https://api.github.com/repos/laravel/framework/statuses/{sha}","languages_url":"https://api.github.com/repos/laravel/framework/languages","stargazers_url":"https://api.github.com/repos/laravel/framework/stargazers","contributors_url":"https://api.github.com/repos/laravel/framework/contributors","subscribers_url":"https://api.github.com/repos/laravel/framework/subscribers","subscription_url":"https://api.github.com/repos/laravel/framework/subscription","commits_url":"https://api.github.com/repos/laravel/framework/commits{/sha}","git_commits_url":"https://api.github.com/repos/laravel/framework/git/commits{/sha}","comments_url":"https://api.github.com/repos/laravel/framework/comments{/number}","issue_comment_url":"https://api.github.com/repos/laravel/framework/issues/comments{/number}","contents_url":"https://api.github.com/repos/laravel/framework/contents/{+path}","compare_url":"https://api.github.com/repos/laravel/framework/compare/{base}...{head}","merges_url":"https://api.github.com/repos/laravel/framework/merges","archive_url":"https://api.github.com/repos/laravel/framework/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/laravel/framework/downloads","issues_url":"https://api.github.com/repos/laravel/framework/issues{/number}","pulls_url":"https://api.github.com/repos/laravel/framework/pulls{/number}","milestones_url":"https://api.github.com/repos/laravel/framework/milestones{/number}","notifications_url":"https://api.github.com/repos/laravel/framework/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/laravel/framework/labels{/name}","releases_url":"https://api.github.com/repos/laravel/framework/releases{/id}","deployments_url":"https://api.github.com/repos/laravel/framework/deployments","created_at":"2013-01-10T21:27:28Z","updated_at":"2025-12-12T11:43:01Z","pushed_at":"2025-12-12T03:08:29Z","git_url":"git://github.com/laravel/framework.git","ssh_url":"git@github.com:laravel/framework.git","clone_url":"https://github.com/laravel/framework.git","svn_url":"https://github.com/laravel/framework","homepage":"https://laravel.com","size":94640,"stargazers_count":34350,"watchers_count":34350,"language":"PHP","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":11731,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":118,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["framework","laravel","php"],"visibility":"public","forks":11731,"open_issues":118,"watchers":34350,"default_branch":"12.x","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"If you're building an Eloquent query from a model that has timestamps and you attempt to join table that also contains timestamps (ie. updated_at) and then call `update()` on the builder, then it will fail since updated_at is now ambigous. Since there's no way to change the updated_at field definition in an `update()` call, it's impossible to use `update()` when joining and using timestamps.\n\n**Example:**\n\n```\nprivate function getPackingScannerQuery($since) {\n    return ChipScan::where('is_processed', 0)\n    ->where(ChipScan::table().'.antenna_id', 1)\n    ->where(ChipScan::table().'.created_at', '>=', $since)\n    ->join(Chip::table().' AS c', 'c.id', '=', ChipScan::table().'.chip_id')\n    ->join(ChipData::table().' AS cd', 'cd.id', '=', 'c.chip_data_id'); \n}\n```\n\n`ChipScan::table()` returns the table name of the model. Laravel doesn't seem to have a shorthand for this. Both `ChipScan`, `Chip` and `ChipData` are timestamped with `created_at` and `updated_at`.\nThen method is called:\n\n```\n$scanned = $this->getPackingScannerQuery(...);\n$scanned->update(['is_processed' => 1]); // This will fail: column name \"updated_at\" is ambigous\n```\n\nMy current workaround is to select all ids from `ChipScan`, but even that cannot be done since `lists()` will strip table aliases, so I also employ a workaround for that (there's apparently a PR for that issue as well). Anyhow, to work around it I have to do all this:\n\n```\n// Laravel bug: Normally, we'd run a update(...) on the query, but Laravel adds updated_at which is ambigous because we're joining\n// So collect all ChipScan.id and manually update fields\n// Laravel bug: lists() will strip table name, so since it's a join, 'id' too is ambigous. Wtf, Taylor?!\n$scan_ids = $scanned->select(ChipScan::table().'.id AS _id')->lists('_id');\nChipScan::whereIn('id', $scan_ids ?: [null])->update(['is_processed' => 1]);\n```\n","reactions":{"url":"https://api.github.com/repos/laravel/framework/issues/5440/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/laravel/framework/issues/5440/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":657576968,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDY1NzU3Njk2OA==","url":"https://api.github.com/repos/laravel/framework/issues/events/657576968","actor":{"login":"samrap","id":5227553,"node_i