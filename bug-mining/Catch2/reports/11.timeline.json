porter_tap.hpp(180)`](https://github.com/philsquared/Catch/blob/c2b7bd15c092e2528f52bf26046e3c55ca629392/include/reporters/catch_reporter_tap.hpp#L180)\r\n- [`catch_reporter_xml.cpp(124)`](https://github.com/philsquared/Catch/blob/c2b7bd15c092e2528f52bf26046e3c55ca629392/include/reporters/catch_reporter_xml.cpp#L124)\r\n\r\n? Would it be ok for all reporters to change\r\n```\r\nreturn '!' + std::string(m_info.capturedExpression);\r\n```\r\nin\r\n```\r\nreturn \"!(\" + std::string(m_info.capturedExpression) + \")\";\r\n```\r\nc.f. AssertionResult::getExpressionInMacro() at [line 63](https://github.com/philsquared/Catch/blob/c2b7bd15c092e2528f52bf26046e3c55ca629392/include/internal/catch_assertionresult.cpp#L63).","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/catchorg/Catch2/issues/comments/336529677/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"martinmoene","id":1999290,"node_id":"MDQ6VXNlcjE5OTkyOTA=","avatar_url":"https://avatars.githubusercontent.com/u/1999290?v=4","gravatar_id":"","url":"https://api.github.com/users/martinmoene","html_url":"https://github.com/martinmoene","followers_url":"https://api.github.com/users/martinmoene/followers","following_url":"https://api.github.com/users/martinmoene/following{/other_user}","gists_url":"https://api.github.com/users/martinmoene/gists{/gist_id}","starred_url":"https://api.github.com/users/martinmoene/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/martinmoene/subscriptions","organizations_url":"https://api.github.com/users/martinmoene/orgs","repos_url":"https://api.github.com/users/martinmoene/repos","events_url":"https://api.github.com/users/martinmoene/events{/privacy}","received_events_url":"https://api.github.com/users/martinmoene/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1292785078