g-truc/glm/milestone/6","labels_url":"https://api.github.com/repos/g-truc/glm/milestones/6/labels","id":173769,"node_id":"MDk6TWlsZXN0b25lMTczNzY5","number":6,"title":"GLM 0.9.8","description":"","creator":{"login":"Groovounet","id":367227,"node_id":"MDQ6VXNlcjM2NzIyNw==","avatar_url":"https://avatars.githubusercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":91,"state":"open","created_at":"2012-09-12T10:39:31Z","updated_at":"2019-04-02T09:34:45Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2016-09-12T15:31:39Z","updated_at":"2016-09-12T22:24:59Z","closed_at":"2016-09-12T22:24:59Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### The problem\n\nI'm on Ubuntu 16.04LTS. I am required to build my product using gcc 4.8 (instead of default gcc 5.4) for binary compatibility reasons with older versions of Ubuntu.\n\nTo reproduce the problem, you will need to install gcc-4.8 on Ubuntu 16.04LTS:\n\n```\nsudo apt-get install gcc-4.8 g++-4.8\n```\n\nThen get my test source code:\n\n[Test.cpp.zip](https://github.com/g-truc/glm/files/467628/Test.cpp.zip)\n\nAssuming that GLM is cloned in git/glm-0.9.8, and checked-out on the 0.9.8 release tag, compile my test source code this way, using g++4.8 :\n\n```\n/usr/bin/g++-4.8 -Igit/glm-0.9.8 -std=c++11 -o Test.o -c Test.cpp\n```\n\nThis will generate the following error:\n\n```\nglm/glm/detail/type_vec4_simd.inl:446: error: redeclaration ‘constexpr glm::tvec4<T, P>::tvec4(A, B, C, D) [with A = int; B = int; C = int; D = int; T = int; glm::precision P = (glm::precision)5u]’ differs in ‘constexpr’\n  GLM_FUNC_QUALIFIER GLM_CONSTEXPR_SIMD tvec4<int32, aligned_lowp>::tvec4(int32 a, int32 b, int32 c, int32 d) :\n                                                                                                            ^\n```\n### Work-around\n\nSo far, I have 3 options:\n1. Downgrade to glm 0.9.7\n2. Downgrade Ubuntu to 14.04LTS\n3. Downgrade all my code to c++03 standard (-std=c++03)\n","closed_by":{"login":"Groovounet","id":367227,"node_id":"MDQ6VXNlcjM2NzIyNw==","avatar_url":"https://avatars.githubusercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/r