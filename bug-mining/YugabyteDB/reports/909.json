tps://api.github.com/repos/yugabyte/yugabyte-db/labels/priority/high","name":"priority/high","color":"ffdc5e","default":false,"description":"High Priority"},{"id":4199362411,"node_id":"LA_kwDOBlCVUc76TS9r","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/2.14%20Backport%20Required","name":"2.14 Backport Required","color":"bfdadc","default":false,"description":""},{"id":4721920290,"node_id":"LA_kwDOBlCVUc8AAAABGXLJIg","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/2.16%20Backport%20Required","name":"2.16 Backport Required","color":"24F4C7","default":false,"description":""},{"id":7034545669,"node_id":"LA_kwDOBlCVUc8AAAABo0qmBQ","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/2.14.8_blocker","name":"2.14.8_blocker","color":"ededed","default":false,"description":null}],"state":"closed","locked":false,"assignee":{"login":"yusong-yan","id":46516278,"node_id":"MDQ6VXNlcjQ2NTE2Mjc4","avatar_url":"https://avatars.githubusercontent.com/u/46516278?v=4","gravatar_id":"","url":"https://api.github.com/users/yusong-yan","html_url":"https://github.com/yusong-yan","followers_url":"https://api.github.com/users/yusong-yan/followers","following_url":"https://api.github.com/users/yusong-yan/following{/other_user}","gists_url":"https://api.github.com/users/yusong-yan/gists{/gist_id}","starred_url":"https://api.github.com/users/yusong-yan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yusong-yan/subscriptions","organizations_url":"https://api.github.com/users/yusong-yan/orgs","repos_url":"https://api.github.com/users/yusong-yan/repos","events_url":"https://api.github.com/users/yusong-yan/events{/privacy}","received_events_url":"https://api.github.com/users/yusong-yan/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"yusong-yan","id":46516278,"node_id":"MDQ6VXNlcjQ2NTE2Mjc4","avatar_url":"https://avatars.githubusercontent.com/u/46516278?v=4","gravatar_id":"","url":"https://api.github.com/users/yusong-yan","html_url":"https://github.com/yusong-yan","followers_url":"https://api.github.com/users/yusong-yan/followers","following_url":"https://api.github.com/users/yusong-yan/following{/other_user}","gists_url":"https://api.github.com/users/yusong-yan/gists{/gist_id}","starred_url":"https://api.github.com/users/yusong-yan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yusong-yan/subscriptions","organizations_url":"https://api.github.com/users/yusong-yan/orgs","repos_url":"https://api.github.com/users/yusong-yan/repos","events_url":"https://api.github.com/users/yusong-yan/events{/privacy}","received_events_url":"https://api.github.com/users/yusong-yan/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":2,"created_at":"2023-03-18T05:48:31Z","updated_at":"2024-12-17T04:29:57Z","closed_at":"2023-03-28T01:33:50Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Jira Link: [DB-5880](https://yugabyte.atlassian.net/browse/DB-5880)\r\n### Description\r\n\r\nWe use improved bank workload with insert, deletes and insert-delete operations in addition to updates.\r\nCurrently there is a memory leak that may consume lot of memory during long running execution\r\n\r\nWorkload recreates connection on each transaction:\r\n1. UPDADE-UPDATE (common bank workload statement)\r\n2. INSERT-UPDATE\r\n3. DELETE-UPDATE\r\n4. INSERT-DELETE\r\nAll this operations contains the invariant - overall sum must be the same.\r\n\r\n**Behavior**\r\nOn YugabyteDB versions 2.14+, we have observed a slow memory growth in workloads that constantly open new connections (rather than reuse long-lived connections for their work).\r\n\r\n**Issue**\r\nPgClientSession expiration logic had a bug - session_expiration_queue_ didn't successfully clean up the expired PgClientSession objects, because of a typo in the comparator, it made it a max heap instead of a min heap. As a result, if the most recent session is still alive, the expired sessions memory would never be reclaimed.\r\n\r\n**Fix**\r\nChange the priority queue comparator to make it a min heap, so that the top always has the shortest expiration time, and the expired PgClientSession's memory can always be successfully reclaimed.\r\n\r\n### Warning: Please confirm that this issue does not contain any sensitive information\r\n\r\n- [X] I confirm this issue does not contain any sensitive information.\r\n\r\n[DB-5880]: https://yugabyte.atlassian.net/browse/DB-5880?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","closed_by":{"login":"rthallamko3","id":17170123,"node_id":"MDQ6VXNlcjE3MTcwMTIz","avatar_url":"https://avatars.githubusercontent.com/u/17170123?v=4","gravatar_id":"","url":"https://api.github.com/users/rthallamko3","html_url":"https://github.com/rthallamko3","followers_url":"https://api.github.com/users/rthallamko3/followers","following_url":"https://api.github.com/users/rthallamko3/following{/other_user}","gists_url":"https://api.github.com/users/rthallamko3/gists{/gist_id}","starred_url":"https://api.github.com/users/rthallamko3/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rthallamko3/subscriptions","organizations_url":"https://api.github.com/users/rthallamko3/orgs","repos_url":"https://api.github.com/users/rthallamko3/repos","events_url":"https://api.github.com/users/rthallamko3/events{/privacy}","received_events_url":"https://api.github.com/users/rthallamko3/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/16474/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline