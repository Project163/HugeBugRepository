,\r\n    {'name': None},\r\n])\r\n\r\nquery = sa.select([Spam], bind=engine).where(Spam.name.op('REGEXP')(r'(\\w)\\1'))\r\n\r\nprint(query.execute().fetchall())\r\n```\r\n(found here: https://gist.githubusercontent.com/xflr6/c7c87befd9e88e8b1fcb0f042610eea4/raw/77506058a8c0f659fd7bd67e2bf7de23ae2c96c4/sa_sqlite3_regex.py)\r\n\r\n**Error**\r\n\r\n```\r\nTraceback (most recent call last):\r\n  File \"~/venv-le/lib/python3.8/site-packages/sqlalchemy/engine/base.py\", line 1617, in _execute_context\r\n    self.dialect.do_execute(\r\n  File \"~/venv-le/lib/python3.8/site-packages/sqlalchemy/engine/default.py\", line 662, in do_execute\r\n    cursor.execute(statement, parameters)\r\nsqlite3.OperationalError: user-defined function raised exception\r\n\r\nThe above exception was the direct cause of the following exception:\r\n\r\nTraceback (most recent call last):\r\n  File \"tests/sqlite_regex.py\", line 45, in <module>\r\n    print(query.execute().fetchall())\r\n  File \"<string>\", line 2, in execute\r\n  File \"~/venv-le/lib/python3.8/site-packages/sqlalchemy/util/deprecations.py\", line 347, in warned\r\n    return fn(*args, **kwargs)\r\n  File \"~/venv-le/lib/python3.8/site-packages/sqlalchemy/sql/base.py\", line 885, in execute\r\n    return e._execute_clauseelement(\r\n  File \"~/venv-le/lib/python3.8/site-packages/sqlalchemy/engine/base.py\", line 2889, in _execute_clauseelement\r\n    return connection._execute_clauseelement(\r\n  File \"~/venv-le/lib/python3.8/site-packages/sqlalchemy/engine/base.py\", line 1304, in _execute_clauseelement\r\n    ret = self._execute_context(\r\n  File \"~/venv-le/lib/python3.8/site-packages/sqlalchemy/engine/base.py\", line 1660, in _execute_context\r\n    self._handle_dbapi_exception(\r\n  File \"~/venv-le/lib/python3.8/site-packages/sqlalchemy/engine/base.py\", line 1841, in _handle_dbapi_exception\r\n    util.raise_(\r\n  File \"~/venv-le/lib/python3.8/site-packages/sqlalchemy/util/compat.py\", line 180, in raise_\r\n    raise 