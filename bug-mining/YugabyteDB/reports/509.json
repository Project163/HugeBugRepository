DQ6VXNlcjE2NzE1NzA0","avatar_url":"https://avatars.githubusercontent.com/u/16715704?v=4","gravatar_id":"","url":"https://api.github.com/users/jaki","html_url":"https://github.com/jaki","followers_url":"https://api.github.com/users/jaki/followers","following_url":"https://api.github.com/users/jaki/following{/other_user}","gists_url":"https://api.github.com/users/jaki/gists{/gist_id}","starred_url":"https://api.github.com/users/jaki/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jaki/subscriptions","organizations_url":"https://api.github.com/users/jaki/orgs","repos_url":"https://api.github.com/users/jaki/repos","events_url":"https://api.github.com/users/jaki/events{/privacy}","received_events_url":"https://api.github.com/users/jaki/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"jaki","id":16715704,"node_id":"MDQ6VXNlcjE2NzE1NzA0","avatar_url":"https://avatars.githubusercontent.com/u/16715704?v=4","gravatar_id":"","url":"https://api.github.com/users/jaki","html_url":"https://github.com/jaki","followers_url":"https://api.github.com/users/jaki/followers","following_url":"https://api.github.com/users/jaki/following{/other_user}","gists_url":"https://api.github.com/users/jaki/gists{/gist_id}","starred_url":"https://api.github.com/users/jaki/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jaki/subscriptions","organizations_url":"https://api.github.com/users/jaki/orgs","repos_url":"https://api.github.com/users/jaki/repos","events_url":"https://api.github.com/users/jaki/events{/privacy}","received_events_url":"https://api.github.com/users/jaki/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2021-05-10T23:45:37Z","updated_at":"2021-05-13T20:04:21Z","closed_at":"2021-05-11T18:51:40Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Yugabyte indexes cannot use access methods dedicated to postgres-backed storage.  Currently, this means Yugabyte indexes can only use the lsm access method.  There is a check in `indexcmds.c` to make sure of this.\r\n\r\nTemporary indexes cannot use access methods dedicated to Yugabyte-backed storage.  This means temporary indexes can use access methods like btree and hash but can't use lsm.  There is **no** check for this, so it is possible for a create index using lsm on temp table to go through.  An error should be thrown in this case.\r\n\r\nThere are a number of problems in allowing temp indexes to use Yugabyte access methods:\r\n\r\n- CREATE error:\r\n\r\n  ```sql\r\n  CREATE TEMP TABLE t (i int);\r\n  INSERT INTO t VALUES (1);\r\n  CREATE INDEX ON t USING lsm (i);\r\n  ```\r\n\r\n  ```\r\n  server closed the connection unexpectedly\r\n  ```\r\n\r\n  ```\r\n  TRAP: FailedAssertion(\"!(ybctid != 0)\", File: \"../../../../../../src/postgres/src/backend/executor/ybcModifyTable.c\", Line: 462)\r\n  ```\r\n\r\n- INSERT error:\r\n\r\n  ```sql\r\n  CREATE TEMP TABLE t (i int);\r\n  CREATE INDEX ON t USING lsm (i);\r\n  INSERT INTO t VALUES (1);\r\n  ```\r\n\r\n  ```\r\n  ERROR:  function aminsert is not defined for index t_i_idx\r\n  ```\r\n\r\n- SELECT error:\r\n\r\n  ```sql\r\n  CREATE TEMP TABLE t (i int);\r\n  CREATE INDEX ON t USING lsm (i);\r\n  SELECT * FROM t;\r\n  ```\r\n\r\n  ```\r\n  ERROR:  Not found: Error loading table with oid 16899 in database with oid 12463: Table with identifier 000030af000030008000000000004203 not found: OBJECT_NOT_FOUND (master error 3)\r\n  ```","closed_by":{"login":"jaki","id":16715704,"node_id":"MDQ6VXNlcjE2NzE1NzA0","avatar_url":"https://avatars.githubusercontent.com/u/16715704?v=4","gravatar_id":"","url":"https://api.github.com/users/jaki","html_url":"https://github.com/jaki","followers_url":"https://api.github.com/users/jaki/followers","following_url":"https://api.github.com/users/jaki/following{/other_user}","gists_url":"https://api.github.com/users/jaki/gists{/gist_id}","starred_url":"https://api.github.com/users/jaki/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jaki/subscriptions","organizations_url":"https://api.github.com/users/jaki/orgs","repos_url":"https://api.github.com/users/jaki/repos","events_url":"https://api.github.com/users/jaki/events{/privacy}","received_events_url":"https://api.github.com/users/jaki/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/8388/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/8388/timeline","performed_via_github_app":null,"state_reason":"completed"}