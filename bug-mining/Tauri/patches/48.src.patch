diff --git a/tauri/examples/multiwindow/src-tauri/src/build.rs b/tauri/examples/multiwindow/src-tauri/src/build.rs
deleted file mode 100644
index 83fb8f4d6..000000000
--- a/tauri/examples/multiwindow/src-tauri/src/build.rs
+++ /dev/null
@@ -1,16 +0,0 @@
-#[cfg(windows)]
-extern crate winres;
-
-#[cfg(windows)]
-fn main() {
-  if std::path::Path::new("icons/icon.ico").exists() {
-    let mut res = winres::WindowsResource::new();
-    res.set_icon_with_id("icons/icon.ico", "32512");
-    res.compile().expect("Unable to find visual studio tools");
-  } else {
-    panic!("No Icon.ico found. Please add one or check the path");
-  }
-}
-
-#[cfg(not(windows))]
-fn main() {}
