pi.github.com/users/pao214/gists{/gist_id}","starred_url":"https://api.github.com/users/pao214/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pao214/subscriptions","organizations_url":"https://api.github.com/users/pao214/orgs","repos_url":"https://api.github.com/users/pao214/repos","events_url":"https://api.github.com/users/pao214/events{/privacy}","received_events_url":"https://api.github.com/users/pao214/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/2878526043","html_url":"https://github.com/yugabyte/yugabyte-db/issues/27149#issuecomment-2878526043","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/27149","id":2878526043,"node_id":"IC_kwDOBlCVUc6rktJb","user":{"login":"pao214","id":16426043,"node_id":"MDQ6VXNlcjE2NDI2MDQz","avatar_url":"https://avatars.githubusercontent.com/u/16426043?v=4","gravatar_id":"","url":"https://api.github.com/users/pao214","html_url":"https://github.com/pao214","followers_url":"https://api.github.com/users/pao214/followers","following_url":"https://api.github.com/users/pao214/following{/other_user}","gists_url":"https://api.github.com/users/pao214/gists{/gist_id}","starred_url":"https://api.github.com/users/pao214/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pao214/subscriptions","organizations_url":"https://api.github.com/users/pao214/orgs","repos_url":"https://api.github.com/users/pao214/repos","events_url":"https://api.github.com/users/pao214/events{/privacy}","received_events_url":"https://api.github.com/users/pao214/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-14T03:30:11Z","updated_at":"2025-05-14T03:30:59Z","body":"This diff resolves the issue\n\n```\ndiff --git a/src/postgres/src/backend/parser/parse_relation.c b/src/postgres/src/backend/parser/parse_relation.c\nindex 0cd0ca20ad..e153161b7b 100644\n--- a/src/postgres/src/backend/parser/parse_relation.c\n+++ b/src/postgres/src/backend/parser/parse_relation.c\n@@ -39,6 +39,7 @@\n \n /* YB includes */\n #include \"pg_yb_utils.h\"\n+#include \"access/xact.h\"\n \n \n /*\n@@ -1454,6 +1455,14 @@ addRangeTableEntry(ParseState *pstate,\n        rte->relkind = rel->rd_rel->relkind;\n        rte->rellockmode = lockmode;\n \n+       /*\n+        * YB: Locking requires a txn and therefore an xid is assigned.\n+        * Inform YB that an xid might be assigned.\n+        */\n+       if (IsYugaByteEnabled() && lockmode == RowShareLock\n+               && rel->rd_rel->relpersistence == RELPERSISTENCE_TEMP)\n+               YbSetTxnWithPgOps(YB_TXN_USES_TEMPORARY_RELATIONS);\n+\n        /*\n         * Build the list of effective column names using user-supplied aliases\n         * and/or actual column names.\n```\n\nOutput:\n\n```\nyugabyte=# CREATE TEMP TABLE uctest(f1 int, f2 text);\nCREATE TABLE\nyugabyte=# INSERT INTO uctest VALUES (1, 'one'), (2, 'two'), (3, 'three');\nINSERT 0 3\nyugabyte=# SELECT * FROM uctest FOR UPDATE;\n f1 |  f2   \n----+-------\n  1 | one\n  2 | two\n  3 | three\n(3 rows)\n```\n\nHowever, a deeper analysis to understand the flow may be warranted. This will allow us to cleanup the xid business.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/2878526043/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"pao214","id":16426043,"node_id":"MDQ6VXNlcjE2NDI2MDQz","avatar_url":"https://avatars.githubusercontent.com/u/16426043?v=4","gravatar_id":"","url":"https://api.github.com/users/pao214","html_url":"https://github.com/pao214","followers_url":"https://api.github.com/users/pao214/followers","following_url":"https://api.github.com/users/pao214/following{/other_user}","gists_url":"https://api.github.com/users/p