byte/yugabyte-db/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/refs{/sha}","trees_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/trees{/sha}","statuses_url":"https://api.github.com/repos/yugabyte/yugabyte-db/statuses/{sha}","languages_url":"https://api.github.com/repos/yugabyte/yugabyte-db/languages","stargazers_url":"https://api.github.com/repos/yugabyte/yugabyte-db/stargazers","contributors_url":"https://api.github.com/repos/yugabyte/yugabyte-db/contributors","subscribers_url":"https://api.github.com/repos/yugabyte/yugabyte-db/subscribers","subscription_url":"https://api.github.com/repos/yugabyte/yugabyte-db/subscription","commits_url":"https://api.github.com/repos/yugabyte/yugabyte-db/commits{/sha}","git_commits_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/commits{/sha}","comments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/comments{/number}","issue_comment_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments{/number}","contents_url":"https://api.github.com/repos/yugabyte/yugabyte-db/contents/{+path}","compare_url":"https://api.github.com/repos/yugabyte/yugabyte-db/compare/{base}...{head}","merges_url":"https://api.github.com/repos/yugabyte/yugabyte-db/merges","archive_url":"https://api.github.com/repos/yugabyte/yugabyte-db/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/yugabyte/yugabyte-db/downloads","issues_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues{/number}","pulls_url":"https://api.github.com/repos/yugabyte/yugabyte-db/pulls{/number}","milestones_url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones{/number}","notifications_url":"https://api.github.com/repos/yugabyte/yugabyte-db/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels{/name}","releases_url":"https://api.github.com/repos/yugabyte/yugabyte-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Jira Link: [DB-3233](https://yugabyte.atlassian.net/browse/DB-3233)\r\n### Description\r\n\r\nThe second child tablet is completely ignored during read operation over a splitted parent tablet when `yb_enable_expression_pushdown=on`: after meta cache invalidation the read operation retry happens only over the first child tablet -- the one whose `partition_start_key` matches parent's `partition_start_key`. The issue is related to #12631, but the fix for #12631 will not cover this case as tablet may be still not splitted when the read requests are composed and sent at PGGate side, and tablet may begin splitting around the time the batcher handles these request at YBClient side.\r\n\r\nSteps to reproduce:\r\n```\r\n1. $ ./bin/yb-ctl start --master_flags=\"enable_automatic_tablet_splitting=false\"\r\n\r\n2. # create table t1(k1 text not null, v1 text, v2 int, primary key ((k1) hash)) split into 4 tablets;\r\n3. # insert into t1 select i::text, i::text, i from  generate_series(1,70000) as i;\r\n\r\n4. $ ./build/latest/bin/yb-admin -master_addresses localhost:7100 list_tablets ysql.yugabyte t1\r\n\r\nTablet-UUID                      \tRange                                                    \t\r\n62d22015d8084146908e62a99cff4024 \tpartition_key_start: \"\" partition_key_end: \"?\\377\"\t\r\nf7d3abcb9d724b9e92eebe5e1f06457d \tpartition_key_start: \"?\\377\" partition_key_end: \"\\177\\376\" \t\r\n0d57389b727443b9904793688088c93f \tpartition_key_start: \"\\177\\376\" partition_key_end: \"\\277\\375\" \t\r\nb89bc7a4f615428da6000bbb43fad561 \tpartition_key_start: \"\\277\\375\" partition_key_end: \"\" \t\r\n\r\n5. # set yb_enable_expression_pushdown=off;\r\n6. # select * from t1 where k1='49199' and v1='49199';\r\n  k1   |  v1   |  v2   \r\n-------+-------+-------\r\n 49199 | 49199 | 49199\r\n(1 row)\r\n\r\n7. # set yb_enable_expression_pushdown=on;\r\n8. # select * from t1 where k1='49199' and v1='49199';\r\n  k1   |  v1   |  v2   \r\n-------+-------+-------\r\n 49199 | 49199 | 49199\r\n(1 row)\r\n\r\n9. $ ./build/latest/bin/yb-ts-cli flush_tablet 0d57389b727443b9904793688088c93f\r\n10. $ ./build/latest/bin/yb-admin split_tablet -master_addresses localhost:7100 0d57389b727443b9904793688088c93f\r\n\r\n11. # set yb_enable_expression_pushdown=off;\r\n12. # select * from t1 where k1='49199' and v1='49199';\r\n  k1   |  v1   |  v2   \r\n-------+-------+-------\r\n 49199 | 49199 | 49199\r\n(1 row)\r\n\r\n13. # set yb_enable_expression_pushdown=on;\r\n14. # select * from t1 where k1='49199' and v1='49199';\r\n k1 | v1 | v2 \r\n----+----+----\r\n(0 rows)\r\n\r\n15. $ ./bin/yb-ctl stop && ./bin/yb-ctl start --master_flags=\"enable_automatic_tablet_splitting=fals\r\n\r\n16. # set yb_enable_expression_pushdown=on;\r\n17. # select * from t1 where k1='49199' and v1='49199';\r\n  k1   |  v1   |  v2   \r\n-------+-------+-------\r\n 49199 | 49199 | 49199\r\n(1 row)\r\n\r\n```\r\nNote: the value for k1 and v1 must be from the second child after split, its hash code should be in [\"\\240\\206\", \"\\277\\375\"); set_dump can be used to search for such value.\r\n\r\nFindings from the test:\r\n1. Due to \"pushdown\" specific, the read operation is executed over all tablets of the table\r\n2. The table was created with 4 partitions (== tablets)\r\n3. Due to optimizations, read operations are grouped into two batches (two read op in each batch), each read op has partition_key equal to the corresponding partition_key_start of a tablet\r\n4. Required row was located in the third tablet, then it's \"moved\" to the second child after the split\r\n5. Neither PGGate nor YBClient are aware of changed partitions during steps 11-14.\r\n6. The error is happening during validating the state of the third tablet as the tablet is in bad state (deleted | being splitted | splitting completed), table is marked as 'stale' and batcher reties the same read operation\r\n7. The metacache is invalidated and refreshed during next lookup and the lookup finds a valid tablet (the first child) by the original partition_key, the problem is that new tablet covers only the half of the original interval defined in the read request (hash_code / max_hash_code)\r\n8. Read operation successfully completed, but second child is completely ignored, and this child contains the required record. The request returns incomplete result.\r\n\r\nThe questions are:\r\n1. Does returning of paging state in the response for the operation help?\r\n2. If paging state is sent from DocDB, why PGGate does not handle it properly?\r\n\r\nRelated issues: #6719, #12648, #12631","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/13688/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/13688/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":7262338556,"node_id":"REFE_lADOBlCVUc5P_oPUzwAAAAGw3n38","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/7262338556","actor":{"login":"andrei-mart","id":1223507,"node_id":"MDQ6VXNlcjEyMjM1MDc=","avatar_url":"https://avatars.githubusercontent.com/u/1223507?v=4","gravatar_id":"","url":"https://api.github.com/users/andrei-mart","html_url":"https://github.com/andrei-mart","followers_url":"https://api.github.com/users/andrei-mart/followers","following_url":"https://api.github.com/users/andrei-mart/following{/other_user}","gists_url":"https://api.github.com/users/andrei-mart/gists{/gist_id}","starred_url":"https://api.github.com/users/andrei-mart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andrei-mart/subscriptions","organizations_url":"https://api.github.com/users/andrei-mart/orgs","repos_url":"https://api.github.com/users/andrei-mart/repos","events_url":"https://api.github.com/users/andrei-mart/events{/privacy}","received_events_url":"https://api.github.com/users/andrei-mart/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"3d6e20aebe5183d96b361f01e4328bab2dc833ab","commit_url":"https://api.github.com/repos/yugabyte/yugabyte-db/commits/3d6e20aebe5183d96b361f01e4328bab2dc833ab","created_at":"2022-08-25T19:42:01Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1227727794","html_url":"https://github.com/yugabyte/yugabyte-db/issues/13660#issuecomment-1227727794","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/13660","id":1227727794,"node_id":"IC_kwDOBlCVUc5JLaOy","user":{"login":"andrei-mart",