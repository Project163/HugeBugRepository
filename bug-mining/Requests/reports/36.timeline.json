ream read failure, the first response.content access raises but later accesses return empty content, which hides the original transport error and makes debugging difficult.\n\n## Validation\n- python -m pytest -q tests/test_issue_4965.py\n- python -m pytest -q tests/test_lowlevel.py -k chunked_encoding_error\n- python -m pytest -q tests/test_requests.py -k \"response_content or content\"\n","reactions":{"url":"https://api.github.com/repos/psf/requests/issues/7221/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/psf/requests/issues/7221/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":23191490885,"node_id":"REFE_lADOABTKOs4YSR91zwAAAAVmUhFF","url":"https://api.github.com/repos/psf/requests/issues/events/23191490885","actor":{"login":"Takrim-ScrubAI","id":156689437,"node_id":"U_kgDOCVbkHQ","avatar_url":"https://avatars.githubusercontent.com/u/156689437?v=4","gravatar_id":"","url":"https://api.github.com/users/Takrim-ScrubAI","html_url":"https://github.com/Takrim-ScrubAI","followers_url":"https://api.github.com/users/Takrim-ScrubAI/followers","following_url":"https://api.github.com/users/Takrim-ScrubAI/following{/other_user}","gists_url":"https://api.github.com/users/Takrim-ScrubAI/gists{/gist_id}","starred_url":"https://api.github.com/users/Takrim-ScrubAI/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Takrim-ScrubAI/subscriptions","organizations_url":"https://api.github.com/users/Takrim-ScrubAI/orgs","repos_url":"https://api.github.com/users/Takrim-ScrubAI/repos","events_url":"https://api.github.com/users/Takrim-ScrubAI/events{/privacy}","received_events_url":"https://api.github.com/users/Takrim-ScrubAI/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"b45f32c898d3295ad200dfed470a55b7fe4a0f45","commit_url":"https://api.github.com/rep