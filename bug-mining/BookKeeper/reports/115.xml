<item>
            <title>[BOOKKEEPER-263] ZK ledgers root path is hard coded</title>
                <link>https://issues.apache.org/jira/browse/BOOKKEEPER-263</link>
                <project id="12311293" key="BOOKKEEPER">Bookkeeper</project>
                    <description>&lt;p&gt;Currently the ZK ledger root path is not picked up from the config file (It is hardcoded). This patch fixes this. &lt;/p&gt;</description>
                <environment></environment>
        <key id="12556119">BOOKKEEPER-263</key>
            <summary>ZK ledgers root path is hard coded</summary>
                <type id="1" iconUrl="https://issues.apache.org/jira/secure/viewavatar?size=xsmall&amp;avatarId=21133&amp;avatarType=issuetype">Bug</type>
