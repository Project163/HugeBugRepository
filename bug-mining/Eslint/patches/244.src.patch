+
+    return {
+        "Program:exit": ensureWasAssigned,
+        "FunctionExpression:exit": ensureWasAssigned,
+        "FunctionDeclaration:exit": ensureWasAssigned,
+
+        "VariableDeclarator": function (node) {
+            if (node.init !== null) {
+                checkAssignment(node, node.id.name, node.init);
