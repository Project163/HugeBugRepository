diff --git a/test/github-issues/9477/issue-9477.ts b/test/github-issues/9477/issue-9477.ts
new file mode 100644
index 000000000..9f123b20a
--- /dev/null
+++ b/test/github-issues/9477/issue-9477.ts
@@ -0,0 +1,33 @@
+import "reflect-metadata"
+import { expect } from "chai"
+import { DataSource } from "../../../src"
+import {
+    closeTestingConnections,
+    createTestingConnections,
+    reloadTestingDatabases,
+} from "../../utils/test-utils"
+import { Test } from "./entity/Test"
+
+describe("github issues > #9477 Unsigned Integers Columns constantly dropped and recreated", () => {
+    let connections: DataSource[]
+    before(async () => {
+        connections = await createTestingConnections({
+            entities: [Test],
+            schemaCreate: true,
+            dropSchema: true,
+        })
+    })
+    beforeEach(() => reloadTestingDatabases(connections))
+    after(() => closeTestingConnections(connections))
+
+    it("should not create migrations for unsigned indices", () =>
+        Promise.all(
+            connections.map(async (connection) => {
+                const sqlInMemory = await connection.driver
+                    .createSchemaBuilder()
+                    .log()
+                expect(sqlInMemory.upQueries).to.eql([])
+                expect(sqlInMemory.downQueries).to.eql([])
+            }),
+        ))
+})
