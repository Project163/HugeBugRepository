 the macro I think I've found the issue:\r\n\r\nThe emitted version of the macro (one example)\r\n```rust\r\n#[allow(unused_mut)]\r\nimpl <T>bevy::reflect::GetTypeRegistration for NetSet<T>where T:'static+Send+Sync+Eq+Copy+core::hash::Hash HashSet<T> :bevy::reflect::Reflect,{\r\n  fn get_type_registration() -> bevy::reflect::TypeRegistration {\r\n    let mut registration = bevy::reflect::TypeRegistration::of:: <NetSet<T> >();\r\n    registration.insert:: <bevy::reflect::ReflectFromPtr>(bevy::reflect::FromType:: <NetSet<T> > ::from_type());\r\n    let ignored_indices =  ::core::iter::IntoIterator::into_iter([]);\r\n    registration.insert:: <bevy::reflect::serde::SerializationData>(bevy::reflect::serde::SerializationData::new(ignored_indices));\r\n    registration\r\n  }\r\n  ```\r\n  \r\n  there's a missing comma on the reflect emit it appears. gunna dig into the reflect proc macro and see if I can get it to work.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1461077517/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"CoffeeVampir3","id":48565901,"node_id":"MDQ6VXNlcjQ4NTY1OTAx","avatar_url":"https://avatars.githubusercontent.com/u/48565901?v=4","gravatar_id":"","url":"https://api.github.com/users/CoffeeVampir3","html_url":"https://github.com/CoffeeVampir3","followers_url":"https://api.github.com/users/CoffeeVampir3/followers","following_url":"https://api.github.com/users/CoffeeVampir3/following{/other_user}","gists_url":"https://api.github.com/users/CoffeeVampir3/gists{/gist_id}","starred_url":"https://api.github.com/users/CoffeeVampir3/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CoffeeVampir3/subscriptions","organizations_url":"https://api.github.com/users/CoffeeVampir3/orgs","repos_url":"https://api.github.com/users/CoffeeVampir3/repos","events_u