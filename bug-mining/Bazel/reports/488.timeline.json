el/issues/comments/342378723/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"philsc","id":1161442,"node_id":"MDQ6VXNlcjExNjE0NDI=","avatar_url":"https://avatars.githubusercontent.com/u/1161442?v=4","gravatar_id":"","url":"https://api.github.com/users/philsc","html_url":"https://github.com/philsc","followers_url":"https://api.github.com/users/philsc/followers","following_url":"https://api.github.com/users/philsc/following{/other_user}","gists_url":"https://api.github.com/users/philsc/gists{/gist_id}","starred_url":"https://api.github.com/users/philsc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/philsc/subscriptions","organizations_url":"https://api.github.com/users/philsc/orgs","repos_url":"https://api.github.com/users/philsc/repos","events_url":"https://api.github.com/users/philsc/events{/privacy}","received_events_url":"https://api.github.com/users/philsc/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/342582221","html_url":"https://github.com/bazelbuild/bazel/issues/1479#issuecomment-342582221","issue_url":"https://api.github.com/repos/bazelbuild/bazel/issues/1479","id":342582221,"node_id":"MDEyOklzc3VlQ29tbWVudDM0MjU4MjIyMQ==","user":{"login":"katre","id":326527,"node_id":"MDQ6VXNlcjMyNjUyNw==","avatar_url":"https://avatars.githubusercontent.com/u/326527?v=4","gravatar_id":"","url":"https://api.github.com/users/katre","html_url":"https://github.com/katre","followers_url":"https://api.github.com/users/katre/followers","following_url":"https://api.github.com/users/katre/following{/other_user}","gists_url":"https://api.github.com/users/katre/gists{/gist_id}","starred_url":"https://api.github.com/users/katre/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/katre/subscriptions","organizations_url":"https://api.github.com/users/katre/orgs","repos_url":"https://api.github.com/users/katre/repos","events_url":"https://api.github.com/users/katre/events{/privacy}","received_events_url":"https://api.github.com/users/katre/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-11-07T18:47:01Z","updated_at":"2017-11-07T18:47:01Z","body":"Outputs are evaluated before selects can be decided, which makes sense because the set of outputs needs to be deterministic in order for other targets to properly depend on them. The best we can do for this is to add a better error handling.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/342582221/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"katre","id":326527,"node_id":"MDQ6VXNlcjMyNjUyNw==","avatar_url":"https://avatars.githubusercontent.com/u/326527?v=4","gravatar_id":"","url":"https://api.github.com/users/katre","html_url":"https://github.com/katre","followers_url":"https://api.github.com/users/katre/followers","following_url":"https://api.github.com/users/katre/following{/other_user}","gists_url":"https://api.github.com/users/katre/gists{/gist_id}","starred_url":"https://api.github.com/users/katre/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/katre/subscriptions","organizations_url":"https://api.github.com/users/katre/orgs","repos_url":"https://api.github.com/users/katre/repos","events_url":"https://api.github.com/users/katre/events{/privacy}","received_events_url":"https://api.github.com/users/katre/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/343778611","html_url":"https://github.com/bazelbuild/bazel/issues/1479#issuecomment-343778611","issue_url":"https://api.github.com/repos/bazelbuild/bazel/issues/1479","id":343778611,"node_id":"MDEyOklzc3VlQ29tbWVudDM0Mzc3ODYxMQ==","user":{"login":"philsc","id":1161442,"node_id":"MDQ6VXNlcjExNjE0NDI=","avatar_url":"https://avatars.githubusercontent.com/u/1161442?v=4","gravatar_id":"","url":"https://api.github.com/users/philsc","html_url":"https://github.com/philsc","followers_url":"https://api.github.com/users/philsc/followers","following_url":"https://api.github.com/users/philsc/following{/other_user}","gists_url":"https://api.github.com/users/philsc/gists{/gist_id}","starred_url":"https://api.github.com/users/philsc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/philsc/subscriptions","organizations_url":"https://api.github.com/users/philsc/orgs","repos_url":"https://api.github.com/users/philsc/repos","events_url":"https://api.github.com/users/philsc/events{/privacy}","received_events_url":"https://api.github.com/users/philsc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-11-12T23:42:57Z","updated_at":"2017-11-12T23:42:57Z","body":"You're right. I do remember a few explaining that to me at the conference on Monday. Thank you very much for taking a look!\r\n\r\nAs a work around, Michael and one of the Johns (I can't remember last names) suggested the following workaround. This was for my use case of `select`ing on the CPU architecture:\r\n```python\r\n\r\ndef _adapter_suffix_rule_impl(ctx):\r\n  input_file = ctx.file.src\r\n  cfg_stuff = ctx.fragments.cpp.cpu\r\n  output_file = ctx.actions.declare_file(name_transformation(input_file.base_name, cfg_stuff), sibling=input_file)\r\n\r\n  args = ctx.action.args()\r\n  args.add(input_file)\r\n  args.add(output_file)\r\n  ctx.actions.run_shell(outputs=[output_file], inputs=[input_file], command=\"cp $1 $2\", arguments = args)\r\n  return [DefaultInfo(files=[output_file])]\r\n\r\nadapter_suffix_rule = rule(\r\n  implementation = adapter_suffix_rule_impl,\r\n  attrs = {\"src\": attr.label(), single_file=True},\r\n  fragments = [\"cpp]\",\r\n)\r\n```\r\nwhere `name_transoformation` is a function that changes the input file name somehow.\r\n\r\nA non-crash would be nice. In the long-term it'd be nice to be able to use a select-like syntax to change the file names based on things like architecture directly.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/343778611/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"philsc","id":1161442,"node_id":"MDQ6VXNlcjExNjE0NDI=","avatar_url":"https://avatars.githubusercontent.com/u/1161442?v=4","gravatar_id":"","url":"https://api.github.com/users/philsc","html_url":"https://github.com/philsc","followers_url":"https://api.github.com/users/philsc/followers","following_url":"https://api.github.com/users/philsc/following{/other_user}","gists_url":"https://api.github.com/users/philsc/gists{/gist_id}","starred_url":"https://api.github.com/users/philsc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/philsc/subscriptions","organizations_url":"https://api.github.com/users/philsc/orgs","repos_url":"https://api.github.com/users/philsc/repos","events_url":"https://api.github.com/users/philsc/events{/privacy}","received_events_url":"https://api.github.com/users/philsc/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1345669759,"node_id":"MDExOkNsb3NlZEV2ZW50MTM0NTY2OTc1OQ==","url":"https://api.github.com/repos/bazelbuild/bazel/issues/events/1345669759","actor":{"login":"bazel-io","id":15028808,"node_id":"MDQ6VXNlcjE1MDI4ODA4","avatar_url":"https://avatars.githubusercontent.com/u/15028808?v=4","gravatar_id":"","url":"https://api.github.com/users/bazel-io","html_url":"https://github.com/bazel-io","followers_url":"https://api.github.com/users/bazel-io/