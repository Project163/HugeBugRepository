ADmad/subscriptions","organizations_url":"https://api.github.com/users/ADmad/orgs","repos_url":"https://api.github.com/users/ADmad/repos","events_url":"https://api.github.com/users/ADmad/events{/privacy}","received_events_url":"https://api.github.com/users/ADmad/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-10-10T11:47:25Z","updated_at":"2014-10-10T11:47:25Z","body":"Actually the `'atomic'` value for `saveAll()` / `saveAssociated()` is being passed to `save()`. Can you provide some sample code and the queries generated to reproduced this issue.\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/58644976/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ADmad","id":142658,"node_id":"MDQ6VXNlcjE0MjY1OA==","avatar_url":"https://avatars.githubusercontent.com/u/142658?v=4","gravatar_id":"","url":"https://api.github.com/users/ADmad","html_url":"https://github.com/ADmad","followers_url":"https://api.github.com/users/ADmad/followers","following_url":"https://api.github.com/users/ADmad/following{/other_user}","gists_url":"https://api.github.com/users/ADmad/gists{/gist_id}","starred_url":"https://api.github.com/users/ADmad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ADmad/subscriptions","organizations_url":"https://api.github.com/users/ADmad/orgs","repos_url":"https://api.github.com/users/ADmad/repos","events_url":"https://api.github.com/users/ADmad/events{/privacy}","received_events_url":"https://api.github.com/users/ADmad/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/58648404","html_url":"https://github.com/cakephp/cakephp/issues/4852#issuecomment-58648404","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/4852","id":58648404,"node_id":"MDEyOklzc3VlQ29tbWVudDU4NjQ4NDA0","user":{"login":"vekakela","id":165419,"node_id":"MDQ6VXNlcjE2NTQxOQ==","avatar_url":"https://avatars.githubusercontent.com/u/165419?v=4","gravatar_id":"","url":"https://api.github.com/users/vekakela","html_url":"https://github.com/vekakela","followers_url":"https://api.github.com/users/vekakela/followers","following_url":"https://api.github.com/users/vekakela/following{/other_user}","gists_url":"https://api.github.com/users/vekakela/gists{/gist_id}","starred_url":"https://api.github.com/users/vekakela/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vekakela/subscriptions","organizations_url":"https://api.github.com/users/vekakela/orgs","repos_url":"https://api.github.com/users/vekakela/repos","events_url":"https://api.github.com/users/vekakela/events{/privacy}","received_events_url":"https://api.github.com/users/vekakela/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-10-10T12:26:26Z","updated_at":"2014-10-10T12:29:07Z","body":"I think the problem might be in the TranslateBehaviour afterSave function where $RuntimeModel->save call doesn't pass the atomic option to the model save function.\n\nExample code:\n\n``` php\n$data = array(\n    'Content' => array(\n        'id' => '53a1956f-dc3c-490a-b4d6-0f04cc383e02',\n        'translated_text' => array(\n            'fi_FI' => 'Terve',\n            'en_US' => 'Hello'\n        )\n    ),\n    'Comment' => array(\n        (int) 0 => array(\n            'content' => 'Test'\n        )\n    )\n);\n\n$this->Content->begin();\n\nif (!in_array(false, $this->Content->saveAssociated(data, array('atomic' => false)))) {\n    $this->Content->commit();\n} else {\n    $this->Content->rollback();\n}\n```\n\nQueries produced:\n\n``` mysql\nbegin\n\nINSERT INTO `demo_database`.`contents` (`id`) VALUES ('5437cc2f-8c14-4c72-8983-4a9dcc383e02')\n\nSELECT `Content`.`id`, (`I18n__translated_text`.`content`) AS `Content__i18n_translated_text`, (`I18n__translated_text`.`content`) AS `Content__translated_text` FROM `demo_database`.`contents` AS `Content` INNER JOIN `demo_database`.`content_i18ns` AS `I18n__translated_text` ON (`Content`.`id` = `I18n__translated_text`.`foreign_key` AND `I18n__translated_text`.`model` = 'Content' AND `I18n__translated_text`.`field` = 'name' AND `I18n__translated_text`.`locale` = 'fi_FI') \nWHERE `Content`.`id` = '5437cc2f-8c14-4c72-8983-4a9dcc383e02' LIMIT 1\n\nSELECT `ContentI18n`.`locale`, `ContentI18n`.`id` FROM `demo_database`.`content_i18ns` AS `ContentI18n` WHERE `model` = 'Content' AND `foreign_key` = '5437cc2f-8c14-4c72-8983-4a9dcc383e02' AND `field` = 'translated_text' AND `locale` = 'fi_FI'\n\nBEGIN\n\nINSERT INTO `demo_database`.`content_i18ns` (`model`, `foreign_key`, `field`, `locale`, `content`) VALUES ('Content', '5437cc2f-8c14-4c72-8983-4a9dcc383e02', 'translated_text', 'fi_FI', '')\n\nCOMMIT\n\ncommit\n```\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/58648404/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"vekakela","id":165419,"node_id":"MDQ6VXNlcjE2NTQxOQ==","avatar_url":"https://avatars.githubusercontent.com/u/165419?v=4","gravatar_id":"","url":"https://api.github.com/users/vekakela","html_url":"https://github.com/vekakela","followers_url":"https://api.github.com/users/vekakela/followers","following_url":"https://api.github.com/users/vekakela/following{/other_user}","gists_url":"https://api.github.com/users/vekakela/gists{/gist_id}","starred_url":"https://api.github.com/users/vekakela/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vekakela/subscriptions","organizations_url":"https://api.github.com/users/vekakela/orgs","repos_url":"https://api.github.com/users/vekakela/repos","events_u