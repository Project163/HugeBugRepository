ects":false,"has_downloads":true,"has_wiki":false,"has_pages":true,"has_discussions":true,"forks_count":823,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":58,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["c-sharp","dotnet","unit-testing","xunit"],"visibility":"public","forks":823,"open_issues":58,"watchers":4495,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Yesterday I stumbled upon an issue with our tests not finishing. I hunted it down to the fact, that, as long as a non-background thread is running, the test runner does not stop. Here is a minimal repro test. Maybe this is similar to #3447.\n\n```csharp\n[Fact]\npublic void Test()\n{\n    // arrange\n    using ManualResetEventSlim waiter = new ManualResetEventSlim();\n\n    // act\n    Thread thread = new Thread(() => {\n        waiter.Set(); // thread started\n        Thread.Sleep(Timeout.Infinite); // pretend to do a serious amount of work\n    });\n    //thread.IsBackground = true; // this workarounds the issue\n    thread.Start();\n\n    // wait for thread started\n    waiter.Wait(TestContext.Current.CancellationToken);\n\n    // assert\n}\n```\n\nI am using xunit.v3 in version 3.2.0 with the runner in version 3.1.5.","reactions":{"url":"https://api.github.com/repos/xunit/xunit/issues/3452/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/xunit/xunit/issues/3452/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":21214358947,"node_id":"SE_lADOAJbtsc7aO9gSzwAAAATweW2j","url":"https://api.github.com/repos/xunit/xunit/issues/events/21214358947","actor":{"login":"marcOcram","id":784604,"node_id":"MDQ6VXNlcjc4NDYwNA==","avatar_ur