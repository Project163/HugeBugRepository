:514,"watchers_count":514,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":true,"has_discussions":true,"forks_count":235,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":579,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["aiida","computational-science","data-provenance","database","provenance","scheduler","ssh","workflow","workflow-engine","workflows"],"visibility":"public","forks":235,"open_issues":579,"watchers":514,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"The [`ruff`](https://docs.astral.sh/ruff/) tool started out as a Python linter with the goal to improve the speed of existing linters such as `pylint`. It has been seeing a huge uptake in the Python community because it is orders of magnitude faster. I have been holding off on migrating to it since it was in rapid development and didn't have quite the level of coverage of rules as `pylint` does. However, that has improved significantly and now it also provides a formatter which is just as fast. Switching to `ruff` would allow us to drop `isort`, `yapf`, `pylint` and `pydocstyle` and have everything in one superfast tool. I have done the migration on `aiida-shell` and it has been buttery-smooth. I would propose to do the same for `aiida-core` (and probably all other Python packages in `aiidateam`).","reactions":{"url":"https://api.github.com/repos/aiidateam/aiida-core/issues/6178/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/aiidateam/aiida-core/issues/6178/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":14435170586,"node_id":"REFE_lADOCX47u85M3xUzzwAAAAN