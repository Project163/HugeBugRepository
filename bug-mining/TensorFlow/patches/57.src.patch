+def _indexedslice(x, noshape=False):
+  x = np.array(x)
+  dense_shape = x.shape
+  ndim = len(dense_shape)
+  indices = np.where(np.sum(x, tuple(range(1, ndim))))[0]
+  values = x[indices]
+  if noshape:
+    dense_shape = None
+  return tf.IndexedSlices(
+      indices=indices.tolist(), values=values, dense_shape=dense_shape)
+
