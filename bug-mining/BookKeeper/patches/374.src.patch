-IOServicePtr& EventDispatcher::getService() {
-  size_t next = 0;
-  {
-    boost::lock_guard<boost::mutex> lock(next_lock);
-    next = next_io_service;
-    next_io_service = (next_io_service + 1) % num_threads;
-  }
-  return services[next];
-}
