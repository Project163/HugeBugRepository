diff --git a/src/test/java/com/google/devtools/build/lib/rules/python/PyProviderTest.java b/src/test/java/com/google/devtools/build/lib/rules/python/PyProviderTest.java
new file mode 100644
index 0000000000..7af272b6c1
--- /dev/null
+++ b/src/test/java/com/google/devtools/build/lib/rules/python/PyProviderTest.java
@@ -0,0 +1,262 @@
+// Copyright 2018 The Bazel Authors. All rights reserved.
+//
