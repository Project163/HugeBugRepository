+++ b/tests/_files/TestGeneratorMaker.php
@@ -0,0 +1,11 @@
+<?php
+class TestGeneratorMaker
+{
+    public function create($array = [])
+    {
+        foreach ($array as $key => $value) {
+            yield $key => $value;
+        }
+    }
+}
+
