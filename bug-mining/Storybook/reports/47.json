dated_at":"2023-06-06T05:53:38Z","closed_at":null,"author_association":"MEMBER","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"When the user configures UI options on a per-story level, we need two separate behaviors for different kinds of options.\r\n- Theme options: e.g. Storybook name/logo should set that option globally, and it should be unset (set back to the default) when you navigate away from that story to a story where it's unset.\r\n- Stateful UI options: e.g. Selected panel should be updated when the user switches story with that option set, but should not change when the user switches to a story where it's unset.\r\n\r\nTODO:\r\n- [ ] figure out which options correspond to which behavior\r\n- [ ] update the code to handle these two types","closed_by":{"login":"matheo","id":260185,"node_id":"MDQ6VXNlcjI2MDE4NQ==","avatar_url":"https://avatars.githubusercontent.com/u/260185?v=4","gravatar_id":"","url":"https://api.github.com/users/matheo","html_url":"https://github.com/matheo","followers_url":"https://api.github.com/users/matheo/followers","following_url":"https://api.github.com/users/matheo/following{/other_user}","gists_url":"https://api.github.com/users/matheo/gists{/gist_id}","starred_url":"https://api.github.com/users/matheo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matheo/subscriptions","organizations_url":"https://api.github.com/users/matheo/orgs","repos_url":"https://api.github.com/users/matheo/repos","events_url":"https://api.github.com/users/matheo/events{/privacy}","received_events_url":"https://api.github.com/users/matheo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/storybookjs/storybook/issues/5857/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused"