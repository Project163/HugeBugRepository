_admin":false}},{"id":89234728,"node_id":"MDExOkNsb3NlZEV2ZW50ODkyMzQ3Mjg=","url":"https://api.github.com/repos/cakephp/cakephp/issues/events/89234728","actor":{"login":"lorenzo","id":37621,"node_id":"MDQ6VXNlcjM3NjIx","avatar_url":"https://avatars.githubusercontent.com/u/37621?v=4","gravatar_id":"","url":"https://api.github.com/users/lorenzo","html_url":"https://github.com/lorenzo","followers_url":"https://api.github.com/users/lorenzo/followers","following_url":"https://api.github.com/users/lorenzo/following{/other_user}","gists_url":"https://api.github.com/users/lorenzo/gists{/gist_id}","starred_url":"https://api.github.com/users/lorenzo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lorenzo/subscriptions","organizations_url":"https://api.github.com/users/lorenzo/orgs","repos_url":"https://api.github.com/users/lorenzo/repos","events_url":"https://api.github.com/users/lorenzo/events{/privacy}","received_events_url":"https://api.github.com/users/lorenzo/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2014-01-28T22:49:10Z","state_reason":null,"performed_via_github_app":null},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/33537147","html_url":"https://github.com/cakephp/cakephp/issues/2722#issuecomment-33537147","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/2722","id":33537147,"node_id":"MDEyOklzc3VlQ29tbWVudDMzNTM3MTQ3","user":{"login":"darxmac","id":139267,"node_id":"MDQ6VXNlcjEzOTI2Nw==","avatar_url":"https://avatars.githubusercontent.com/u/139267?v=4","gravatar_id":"","url":"https://api.github.com/users/darxmac","html_url":"https://github.com/darxmac","followers_url":"https://api.github.com/users/darxmac/followers","following_url":"https://api.github.com/users/darxmac/following{/other_user}","gists_url":"https://api.github.com/users/darxmac/gists{/gist_id}","starred_url":"https://api.github.com/users/darxmac/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/darxmac/subscriptions","organizations_url":"https://api.github.com/users/darxmac/orgs","repos_url":"https://api.github.com/users/darxmac/repos","events_url":"https://api.github.com/users/darxmac/events{/privacy}","received_events_url":"https://api.github.com/users/darxmac/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-01-28T22:54:09Z","updated_at":"2014-01-28T22:54:09Z","body":"I'll pipe in with regard to the ORM :)\n\nI love it, but it looks like quite an undertaking to migrate a largish 2.x App to 3.x ?\n\nAny strategies to consider ?\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/33537147/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"darxmac","id":139267,"node_id":"MDQ6VXNlcjEzOTI2Nw==","avatar_url":"https://avatars.githubusercontent.com/u/139267?v=4","gravatar_id":"","url":"https://api.github.com/users/darxmac","html_url":"https://github.com/darxmac","followers_url":"https://api.github.com/users/darxmac/followers","following_url":"https://api.github.com/users/darxmac/following{/other_user}","gists_url":"https://api.github.com/users/darxmac/gists{/gist_id}","starred_url":"https://api.github.com/users/darxmac/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/darxmac/subscriptions","organizations_url":"https://api.github.com/users/darxmac/orgs","repos_url":"https://api.github.com/users/darxmac/repos","events_url":"https://api.github.com/users/darxmac/events{/privacy}","received_events_url":"https://api.github.com/users/darxmac/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/33538518","html_url":"https://github.com/cakephp/cakephp/issues/2722#issuecomment-33538518","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/2722","id":33538518,"node_id":"MDEyOklzc3VlQ29tbWVudDMzNTM4NTE4","user":{"login":"lorenzo","id":37621,"node_id":"MDQ6VXNlcjM3NjIx","avatar_url":"https://avatars.githubusercontent.com/u/37621?v=4","gravatar_id":"","url":"https://api.github.com/users/lorenzo","html_url":"https://github.com/lorenzo","followers_url":"https://api.github.com/users/lorenzo/followers","following_url":"https://api.github.com/users/lorenzo/following{/other_user}","gists_url":"https://api.github.com/users/lorenzo/gists{/gist_id}","starred_url":"https://api.github.com/users/lorenzo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lorenzo/subscriptions","organizations_url":"https://api.github.com/users/lorenzo/orgs","repos_url":"https://api.github.com/users/lorenzo/repos","events_url":"https://api.github.com/users/lorenzo/events{/privacy}","received_events_url":"https://api.github.com/users/lorenzo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-01-28T23:10:16Z","updated_at":"2014-01-28T23:10:16Z","body":"Hey @darxmac I'm glad you are liking it. I'm going to paste the answer that I gave to another person in the facebook group:\n\nThe best way you can prepare yourself is by abstracting as much as you can the logic in your controller and cleaning up as much as you can the logic in your models. Here are few tips: \n- Start using composer now: You can find some information about it in the cakephp book and in getcomposer.org\n- Completely abstract the logic in your controllers by using someting like the crud plugin. This way if anything is changed in the controllers you will only need to upgrade the plugin and it should still be working. You can find out more about it in http://friendsofcake.com/crud/docs . This plugin is already functional with 3.0 and abstracts away pretty good the changes from 2.x\n- If you have an API, use the ApiTransform listener that comes in the CrudPlugin. It'll make your api respond in a format that will be the very similar, if not the same to the one in 3.0\n- All your finding logic should be in the models as custom finders. Migrating finders from 2.x will be quite straight forward, as you can use the options array in a 3.x query and expect the same behavior. I have migrated a few models from a project of mined and changing the logic in custom finders was rather trivial.\n- Start using CakeEntity. It is a port of the cakephp 3.0 ORM for 2.x that is compatible with the the old ORM. https://github.com/josegonzalez/cakephp-entity\n- Or, you can start using cake 3 now! Import it to your 2.x app using composer and pick classes to use from it, including the ORM. A good way to migrate could be to slowly move pieces of your current app to use the ORM while it still lives in your old codebase. \n\nMigrating from 2.x will definitely be some piece of work, but totally worth it and I don't consider it to be worse than migrating from 1.3 to 2.x\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/33538518/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"lorenzo","id":37621,"node_id":"MDQ6VXNlcjM3NjIx","avatar_url":"https://avatars.githubusercontent.com/u/37621?v=4","gravatar_id":"","url":"https://api.github.com/users/lorenzo","html_url":"https://github.com/lorenzo","followers_url":"https://api.github.com/users/lorenzo/followers","following_url":"https://api.github.com/users/lorenzo/following{/other_user}","gists_url":"https://api.github.com/users/lorenzo/gists{/gist_id}","starred_url":"https://api.github.com/users/lorenzo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lorenzo/subscriptions","organizations_url":"https://api.github.com/users/lorenzo/orgs","repos_url":"https://api.github.com/users/lorenzo/repos","events_url":"https://api.github.com/users/lorenzo/events{/privacy}","received_events_url":"https://api.github.com/users/lorenzo/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":89240427,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50ODkyNDA0Mjc=","url":"https://api.github.com/repos/cakephp/cakephp/issues/events/89240427","actor":{"login":"darxmac","id":139267,"node_id":"MDQ6VXNlcjEzOTI2Nw==","avatar_url":"https://avatars.githubusercontent.com/u/139267?v=4","gravatar_id":"","url":"https://api.github.com/users/darxmac","html_url":"https://github.com/darxmac","followers_url":"https://api.github.com/users/darxmac/followers","following_url":"https://api.github.com/users/darxmac/following{/other_user}","gists_url":"https://api.github.com/users/darxmac/gists{/gist_id}","starred_url":"https://api.github.com/users/darxmac/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/darxmac/subscriptions","organizations_url":"https://api.github.com/users/darxmac/orgs","repos_url":"https://api.github.com/users/darxmac/repos","events_url":"https://api.github.com/users/darxmac/events{/privacy}","received_events_url":"https://api.github.com/users/darxmac/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"mentioned","commit_id":null,"commit_url":null,"created_at":"2014-01-28T23:10:16Z","performed_via_github_app":null},{"id":89240428,"node_id":"MDE1OlN1YnNjcmliZWRFdmVudDg5MjQwNDI4","url":"https://api.github.com/repos/cakephp/cakephp/issues/events/89240428","actor":{"login":"darxmac","id":139267,"node_id":"MDQ6VXNlcjEzOTI2Nw==","avatar_url":"https://avatars.githubusercontent.com/u/139267?v=4","gravatar_id":"","url":"https://api.github.com/users/darxmac","html_url":"https://github.com/darxmac","followers_url":"https://api.github.com/users/darxmac/followers","following_url":"https://api.github.com/users/darxmac/following{/other_user}","gists_url":"https://api.github.com/users/darxmac/gists{/gist_id}","starred_url":"https://api.github.com/users/darxmac/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/darxmac/subscriptions","organizations_url":"https://api.github.com/users/darxmac/orgs","repos_url":"https://api.github.com/users/darxmac/repos","events_url":"https://api.github.com/users/darxmac/events{/privacy}","received_events_url":"https://api.github.com/users/darxmac/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2014-01-28T23:10:16Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/33539467","html_url":"https://github.com/cakephp/cakephp/issues/2722#issuecomment-33539467","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/2722","id":33539467,"node_id":"MDEyOklzc3VlQ29tbWVudDMzNTM5NDY3","user":{"login":"Grafikart","id":395137,"node_id":"MDQ6VXNlcjM5NTEzNw==","avatar_url":"https://avatars.githubusercontent.com/u/395137?v=4","gravatar_id":"","url":"https://api.github.com/users/Grafikart","html_url":"https://github.com/Grafikart","followers_url":"https://api.github.com/users/Grafikart/followers","following_url":"https://api.github.com/users/Grafikart/following{/other_user}","gists_url":"https://api.github.com/users/Grafikart/gists{/gist_id}","starred_url":"https://api.github.com/users/Grafikart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Grafikart/subscriptions","organizations_url":"https://api.github.com/users/Grafikart/orgs","repos_url":"https://api.github.com/users/Grafikart/repos","events_url":"https://api.github.com/users/Grafikart/events{/privacy}","received_events_url":"https://api.github.com/users/Grafikart/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-01-28T23:21:53Z","updated_at":"2014-01-28T23:21:53Z","body":"@lorenzo I was expecting a change to the ORM a long time ago and I'm happy to see all the work already done. But I find this very odd to pluralize my Table names (I'm still used to CakePHP 1/2 conventions) and it seems a bit unnatural to write $this->belongsTo('Posts');. I would be interested to know why this Singular convention was changed for the new ORM.\n\nAlso how will you manage the viewCaching with <!--nocache--> if Cake\\ORM\\Query are sent to the view ?\n\nI'm now trying to figure out the Entities (it's a bit annoying to create 2 files Entity + Table but i'm sure it will be faster with cake bake). The Entity is a great idea it will avoid the big \"afterFind\" methods and will allow \"cleaner\" code.\n\nI'm trying to code an app (not for production) with the piece already working. I'll keep diggin into the ORM to find new bugs :)\n\n@darxmac In my opinion there is too much trouble migrating (it is the same when other framework evolves). You can still work on CakePHP2.X even when CakePHP3.x will be released.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/33539467/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Grafikart","id":395137,"node_id":"MDQ6VXNlcjM5NTEzNw==","avatar_url":"https://avatars.githubusercontent.com/u/395137?v=4","gravatar_id":"","url":"https://api.github.com/users/Grafikart","html_url":"https://github.com/Grafikart","followers_url":"https://api.github.com/users/Grafikart/followers","following_url":"https://api.github.com/users/Grafikart/following{/other_user}","gists_url":"https://api.github.com/users/Grafikart/gists{/gist_id}","starred_url":"https://api.github.com/users/Grafikart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Grafikart/subscriptions","organizations_url":"https://api.github.com/users/Grafikart/orgs","repos_url":"https://api.github.com/use