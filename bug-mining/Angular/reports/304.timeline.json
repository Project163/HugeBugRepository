/matsko/subscriptions","organizations_url":"https://api.github.com/users/matsko/orgs","repos_url":"https://api.github.com/users/matsko/repos","events_url":"https://api.github.com/users/matsko/events{/privacy}","received_events_url":"https://api.github.com/users/matsko/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"milestoned","commit_id":null,"commit_url":null,"created_at":"2016-09-20T03:25:53Z","milestone":{"title":"2.0.1"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/angular/angular/issues/comments/248994696","html_url":"https://github.com/angular/angular/issues/11712#issuecomment-248994696","issue_url":"https://api.github.com/repos/angular/angular/issues/11712","id":248994696,"node_id":"MDEyOklzc3VlQ29tbWVudDI0ODk5NDY5Ng==","user":{"login":"caroso1222","id":3689856,"node_id":"MDQ6VXNlcjM2ODk4NTY=","avatar_url":"https://avatars.githubusercontent.com/u/3689856?v=4","gravatar_id":"","url":"https://api.github.com/users/caroso1222","html_url":"https://github.com/caroso1222","followers_url":"https://api.github.com/users/caroso1222/followers","following_url":"https://api.github.com/users/caroso1222/following{/other_user}","gists_url":"https://api.github.com/users/caroso1222/gists{/gist_id}","starred_url":"https://api.github.com/users/caroso1222/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/caroso1222/subscriptions","organizations_url":"https://api.github.com/users/caroso1222/orgs","repos_url":"https://api.github.com/users/caroso1222/repos","events_url":"https://api.github.com/users/caroso1222/events{/privacy}","received_events_url":"https://api.github.com/users/caroso1222/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-09-22T18:52:56Z","updated_at":"2016-09-22T18:52:56Z","body":"I know this will be solved in v2.0.1 but I wanted to share a workaround I found to get this working. \n\nSo, when changing variables inside the `done` callback, you'll have to _apply_ this changes to the template by manually _detecting changes_ using the `ChangeDetectorRef`.\n\n``` typescript\nimport { ChangeDetectorRef } from '@angular/core';\n...\nexport class AppComponent{\nchangeDetectorRef: ChangeDetectorRef\n...\nconstructor(changeDetectorRef: ChangeDetectorRef) {\n    this.changeDetectorRef = changeDetectorRef;\n  }\n...\nmyAnimationDoneCallback(event){\n    this.dataBoundInTemplate = 'new data'\n    this.changeDetectorRef.detectChanges(); //This does the trick\n  }\n}\n```\n\nI've made a new fork of the plunker demo. You can visit it here: https://plnkr.co/edit/e3P4irdBaPt90ubOwxlX\n\nCredit: Check Ben Nadel's [tutorial on Angular2 animations](http://www.bennadel.com/blog/3139-experimenting-with-conditional-enter-leave-animations-in-angular-2-rc-6.htm)\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/comments/248994696/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"caroso1222","id":3689856,"node_id":"MDQ6VXNlcjM2ODk4NTY=","avatar_url":"https://avatars.githubusercontent.com/u/3689856?v=4","gravatar_id":"","url":"https://api.github.com/users/caroso1222","html_url":"https://github.com/caroso1222","followers_url":"https://api.github.com/users/caroso1222/followers","following_url":"https://api.github.com/users/caroso1222/following{/other_user}","gists_url":"https://api.github.com/users/caroso1222/gists{/gist_id}","starred_url":"https://api.github.com/users/caroso1222/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/caroso1222/subscriptions","organizations_url":"https://api.github.com/users/caroso1222/orgs","repos_url":"https://api.github.com/users/caroso1222/repos","events_url":"https://api.github.com/users/caroso1222/events{/privacy}","received_events_url":"https://api.github.com/users/caroso1222/rec