+        // test some special cases around 0.0
+        query = new DoubleScriptFieldRangeQuery(randomScript(), leafFactory, "test", Double.NEGATIVE_INFINITY, -0.0);
+        assertTrue(query.matches(new double[] { -0.0 }, 1));
