eslint/commits{/sha}","git_commits_url":"https://api.github.com/repos/eslint/eslint/git/commits{/sha}","comments_url":"https://api.github.com/repos/eslint/eslint/comments{/number}","issue_comment_url":"https://api.github.com/repos/eslint/eslint/issues/comments{/number}","contents_url":"https://api.github.com/repos/eslint/eslint/contents/{+path}","compare_url":"https://api.github.com/repos/eslint/eslint/compare/{base}...{head}","merges_url":"https://api.github.com/repos/eslint/eslint/merges","archive_url":"https://api.github.com/repos/eslint/eslint/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/eslint/eslint/downloads","issues_url":"https://api.github.com/repos/eslint/eslint/issues{/number}","pulls_url":"https://api.github.com/repos/eslint/eslint/pulls{/number}","milestones_url":"https://api.github.com/repos/eslint/eslint/milestones{/number}","notifications_url":"https://api.github.com/repos/eslint/eslint/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/eslint/eslint/labels{/name}","releases_url":"https://api.github.com/repos/eslint/eslint/releases{/id}","deployments_url":"https://api.github.com/repos/eslint/eslint/deployments","created_at":"2013-06-29T23:59:48Z","updated_at":"2025-12-12T07:58:06Z","pushed_at":"2025-12-11T20:07:33Z","git_url":"git://github.com/eslint/eslint.git","ssh_url":"git@github.com:eslint/eslint.git","clone_url":"https://github.com/eslint/eslint.git","svn_url":"https://github.com/eslint/eslint","homepage":"https://eslint.org","size":51012,"stargazers_count":26698,"watchers_count":26698,"language":"JavaScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":4866,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":103,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["ecmascript","eslint","javascript","linter","static-code-analysis"],"visibility":"public","forks":4866,"open_issues":103,"watchers":26698,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"ESLint has a lot of tests (according to Mocha, over 13000 at the moment). However, even with those tests, it seems like we occasionally introduce regressions. It's too easy to forget about a particular edge case in the tests for a particular rule, and while we are sometimes able to use our own codebase as a safety net to catch issues that a rule's tests miss, this isn't effective for special cases that apply to coding styles which are forbidden in our codebase. (For example, we didn't notice https://github.com/eslint/eslint/issues/7305 until we released and someone reported it, because our codebase doesn't use spread properties.)\r\n\r\nI think we can greatly reduce the number of regressions in our releases by adding tests that lint other codebases with different styleguides. There are a huge number of open-source projects that use ESLint, so we should be able to install a large corpus of code and ensure that it still lints successfully with any given patch applied to ESLint.\r\n\r\nI'd like to start working on this, but I have a few logistical concerns about integrating this with the test suite. Adding all the projects to the ESLint repo would significantly increase its size (I'm hoping to include at least 100 projects or so). We could download the repositories on the fly as part of the test suite, but that would mean that the test suite would require internet access, which isn't ideal.\r\n\r\nI think the best approach might be to have a separate task that runs in CI, and clones a bunch of repos that are known to have a passing lint build at a particular commit. I know the Standard repo has a [similar script](https://github.com/feross/standard/blob/2b9afb6e49fb72d7043916b66e310f802f29f6cf/test/clone.js) (although it's used for a slightly different purpose). This would allow us to have a much wider suite of regression tests to catch issues before they land on master, while still allowing the tests to be run locally in a reasonable amount of time.","reactions":{"url":"https://api.github.com/repos/eslint/eslint/issues/7874/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/eslint/eslint/issues/7874/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":1461165833,"node_id":"MDExOkxvY2tlZEV2ZW50MTQ2MTE2NTgzMw==","url":"https://api.github.com/repos/eslint/eslint/issues/events/1461165833","actor":{"login":"eslint-deprecated[bot]","id":29966797,"node_id":"MDM6Qm90Mjk5NjY3OTc=","avatar_url":"https://avatars.githubusercontent.com/in/3565?v=4","gravatar_id":"","url":"https://api.github.com/users/eslint-deprecated%5Bbot%5D","html_url":"https://github.com/apps/eslint-deprecated","followers_url":"https://api.github.com/users/eslint-deprecated%5Bbot%5D/followers","following_url":"https://api.github.com/users/eslint-deprecated%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/eslint-deprecated%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/eslint-deprecated%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eslint-deprecated%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/eslint-deprecated%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/eslint-deprecated%5Bbot%5D/repos","events_url":"https://api.github.com/users/eslint-deprecated%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/eslint-deprecated%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"event":"locked","commit_id":null,"commit_url":null,"created_at":"2018-02