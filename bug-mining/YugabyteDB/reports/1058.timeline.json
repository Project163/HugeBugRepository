rred_url":"https://api.github.com/users/FranckPachot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/FranckPachot/subscriptions","organizations_url":"https://api.github.com/users/FranckPachot/orgs","repos_url":"https://api.github.com/users/FranckPachot/repos","events_url":"https://api.github.com/users/FranckPachot/events{/privacy}","received_events_url":"https://api.github.com/users/FranckPachot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-11-09T13:57:11Z","updated_at":"2023-11-09T13:57:11Z","body":"Adding a similar case:\r\n\r\n```\r\ndrop table test;\r\ncreate table test (\r\n    id   uuid NOT NULL,\r\n    num  int4 NOT NULL,\r\n    PRIMARY KEY ((id)HASH, num DESC)\r\n);\r\ninsert into test(id, num) VALUES \r\n('774cee8f-f0e9-4c46-8f3d-3b5e7db8b836'::uuid, 1);\r\n\r\nexplain\r\n/*+ Set(yb_bnl_batch_size 2) */\r\nselect * from test t1\r\njoin test t2 on (t1.id = t2.id and t1.num = t2.num)\r\nwhere t1.id in (\r\n\t'774cee8f-f0e9-4c46-8f3d-3b5e7db8b836'::uuid, \r\n\t'884cee8f-f0e9-4c46-8f3d-3b5e7db8b847'::uuid);\r\n\r\n                                                       QUERY PLAN\r\n------------------------------------------------------------------------------------------------------------------------\r\n YB Batched Nested Loop Join  (cost=0.00..15.25 rows=2 width=40)\r\n   Join Filter: ((t1.id = t2.id) AND (t1.num = t2.num))\r\n   ->  Index Scan using test_pkey on test t1  (cost=0.00..15.25 rows=100 width=20)\r\n         Index Cond: (id = ANY ('{774cee8f-f0e9-4c46-8f3d-3b5e7db8b836,884cee8f-f0e9-4c46-8f3d-3b5e7db8b847}'::uuid[]))\r\n   ->  Index Scan using test_pkey on test t2  (cost=0.00..0.19 rows=1 width=20)\r\n         Index Cond: (ROW(id, num) = ANY (ARRAY[ROW(t1.id, t1.num), ROW($1, $3)]))\r\n(6 rows)\r\n\r\n/*+ Set(yb_bnl_batch_size 2) */\r\nselect * from test t1\r\njoin test t2 on (t1.id = t2.id and t1.num = t2.num)\r\nwhere t1.id in (\r\n\t'774cee8f-f0e9-4c46-8f3d-3b5e7db8b836'::uuid, \r\n\t'884cee8f-f0e9-4c46-8f3d-3b5e7db8b847'::uuid);\r\n\r\nERROR:  Attribute value type does not match column type: 3 vs 10\r\n\r\n\r\n\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1803880579/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"FranckPachot","id":33070466,"node_id":"MDQ6VXNlcjMzMDcwNDY2","avatar_url":"https://avatars.githubusercontent.com/u/33070466?v=4","gravatar_id":"","url":"https://api.github.com/users/FranckPachot","html_url":"https://github.com/FranckPachot","followers_url":"https://api.github.com/users/FranckPachot/followers","following_url":"https://api.github.com/users/FranckPachot/following{/other_user}","gists_url":"https://api.github.com/users/FranckPachot/gists{/gist_id}","starred_url":"https://api.github.com/users/FranckPachot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/FranckPachot/subscriptions","organizations_url":"https://api.github.com/users/FranckPachot/orgs","repos_url":"https://api.github.com/users/FranckPachot/repos","events_url":"https://api.github.com/users/FranckPachot/events{/privacy}","received_events_url":"https://api.github.com/users/FranckPachot/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":10988154081,"node_id":"REFE_lADOBlCVUc51bdXFzwAAAAKO8ezh","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/10988154081","actor":{"login":"tanujnay112","id":3924842,"node_id":"MDQ6VXNlcjM5MjQ4NDI=","avatar_url":"https://avatars.githubusercontent.com/u/3924842?v=4","gravatar_id":"","url":"https://api.github.com/users/tanujnay112","html_url":"https://github.com/tanujnay112","followers_url":"https://api.github.com/users/tanujnay112/followers","following_url":"https://api.github.com/users/tanujnay112/following{/other_user}","gists_url":