pi.github.com/users/yugabyte/events{/privacy}","received_events_url":"https://api.github.com/users/yugabyte/received_events","type":"Organization","user_view_type":"public","site_admin":false},"html_url":"https://github.com/yugabyte/yugabyte-db","description":"YugabyteDB - the cloud native distributed SQL database for mission-critical applications.","fork":false,"url":"https://api.github.com/repos/yugabyte/yugabyte-db","forks_url":"https://api.github.com/repos/yugabyte/yugabyte-db/forks","keys_url":"https://api.github.com/repos/yugabyte/yugabyte-db/keys{/key_id}","collaborators_url":"https://api.github.com/repos/yugabyte/yugabyte-db/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/yugabyte/yugabyte-db/teams","hooks_url":"https://api.github.com/repos/yugabyte/yugabyte-db/hooks","issue_events_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events{/number}","events_url":"https://api.github.com/repos/yugabyte/yugabyte-db/events","assignees_url":"https://api.github.com/repos/yugabyte/yugabyte-db/assignees{/user}","branches_url":"https://api.github.com/repos/yugabyte/yugabyte-db/branches{/branch}","tags_url":"https://api.github.com/repos/yugabyte/yugabyte-db/tags","blobs_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/refs{/sha}","trees_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/trees{/sha}","statuses_url":"https://api.github.com/repos/yugabyte/yugabyte-db/statuses/{sha}","languages_url":"https://api.github.com/repos/yugabyte/yugabyte-db/languages","stargazers_url":"https://api.github.com/repos/yugabyte/yugabyte-db/stargazers","contributors_url":"https://api.github.com/repos/yugabyte/yugabyte-db/contributors","subscribers_url":"https://api.github.com/repos/yugabyte/yugabyte-db/subscribers","subscription_url":"https://api.github.com/repos/yugabyte/yugabyte-db/subscription","commits_url":"https://api.github.com/repos/yugabyte/yugabyte-db/commits{/sha}","git_commits_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/commits{/sha}","comments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/comments{/number}","issue_comment_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments{/number}","contents_url":"https://api.github.com/repos/yugabyte/yugabyte-db/contents/{+path}","compare_url":"https://api.github.com/repos/yugabyte/yugabyte-db/compare/{base}...{head}","merges_url":"https://api.github.com/repos/yugabyte/yugabyte-db/merges","archive_url":"https://api.github.com/repos/yugabyte/yugabyte-db/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/yugabyte/yugabyte-db/downloads","issues_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues{/number}","pulls_url":"https://api.github.com/repos/yugabyte/yugabyte-db/pulls{/number}","milestones_url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones{/number}","notifications_url":"https://api.github.com/repos/yugabyte/yugabyte-db/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels{/name}","releases_url":"https://api.github.com/repos/yugabyte/yugabyte-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Jira Link: [DB-14044](https://yugabyte.atlassian.net/browse/DB-14044)\r\n### Description\r\n\r\nSchema:\r\n```sql\r\nCREATE TABLE t (a text, b int, c int);\r\nINSERT INTO t SELECT '', i, j FROM generate_series(1, 1000) i, generate_series(1, 1000) j;\r\nCREATE INDEX ON t (b ASC) WHERE c = 1;\r\nANALYZE t;\r\n\r\nSET yb_enable_bitmapscan = true;\r\nSET yb_enable_base_scans_cost_model = true;\r\n\r\nEXPLAIN (ANALYZE, DIST) SELECT * FROM t WHERE c = 1 AND b < 500; -- chooses bitmap scan instead of index scan\r\n```\r\n\r\nBasic idea: if we have a small partial index, but a large table, then the cost of scanning the table is significantly more than the cost of scanning the index. \r\n\r\nA bitmap scan breaks these two phases into two different plan nodes, so its easier to see its thought process. \r\n```\r\nEXPLAIN (ANALYZE, DIST, DEBUG, SUMMARY OFF) SELECT * FROM t WHERE c = 1 AND b < 500;\r\n                                                      QUERY PLAN\r\n-----------------------------------------------------------------------------------------------------------------------\r\n YB Bitmap Table Scan on t  (cost=8294.51..20351.55 rows=497 width=9) (actual time=5.818..5.936 rows=499 loops=1)\r\n   Storage Table Read Requests: 1\r\n   Storage Table Read Execution Time: 3.745 ms\r\n   Storage Table Rows Scanned: 499\r\n   Metric rocksdb_number_db_seek: 499.000\r\n   Metric rocksdb_number_db_next: 1005.000\r\n   Metric rocksdb_number_db_seek_found: 499.000\r\n   Metric rocksdb_number_db_next_found: 1005.000\r\n   Metric rocksdb_iter_bytes_read: 122035.000\r\n   Metric docdb_keys_found: 499.000\r\n   Metric ql_read_latency: sum: 4496.000, count: 2.000\r\n   Average ybctid Size: 40 B\r\n   Estimated Seeks: 497\r\n   Estimated Nexts: 1491\r\n   Estimated Docdb Result Width: 20\r\n   ->  Bitmap Index Scan on t_b_idx  (cost=0.00..2584.71 rows=497 width=0) (actual time=1.845..1.845 rows=499 loops=1)\r\n         Index Cond: (b < 500)\r\n         Storage Index Read Requests: 1\r\n         Storage Index Read Execution Time: 1.460 ms\r\n         Storage Index Rows Scanned: 499\r\n         Metric rocksdb_number_db_seek: 1.000\r\n         Metric rocksdb_number_db_next: 499.000\r\n         Metric rocksdb_number_db_seek_found: 1.000\r\n         Metric rocksdb_number_db_next_found: 499.000\r\n         Metric rocksdb_iter_bytes_read: 28247.000\r\n         Metric docdb_keys_found: 499.000\r\n         Metric ql_read_latency: sum: 367.000, count: 1.000\r\n         Estimated Seeks: 740\r\n         Estimated Nexts: 1736\r\n         Estimated Docdb Result Width: 46\r\n(30 rows)\r\n```\r\n\r\nBut the index scan costs are still much higher:\r\n```\r\n/*+ IndexScan(t) */ EXPLAIN (ANALYZE, DIST, DEBUG, SUMMARY OFF) SELECT * FROM t WHERE c = 1 AND b < 500;\r\n                                                      QUERY PLAN\r\n-----------------------------------------------------------------------------------------------------------------------\r\n Index Scan using t_b_idx on t  (cost=2464.23..951821.39 rows=497 width=9) (actual time=5.805..5.964 rows=499 loops=1)\r\n   Index Cond: (b < 500)\r\n   Storage Table Read Requests: 1\r\n   Storage Table Read Execution Time: 4.028 ms\r\n   Storage Table Rows Scanned: 499\r\n   Storage Index Read Requests: 1\r\n   Storage Index Read Execution Time: 1.333 ms\r\n   Storage Index Rows Scanned: 499\r\n   Metric rocksdb_number_db_seek: 500.000\r\n   Metric rocksdb_number_db_next: 1506.000\r\n   Metric rocksdb_number_db_seek_found: 500.000\r\n   Metric rocksdb_number_db_next_found: 1506.000\r\n   Metric rocksdb_iter_bytes_read: 150456.000\r\n   Metric docdb_keys_found: 998.000\r\n   Metric ql_read_latency: sum: 5948.000, count: 3.000\r\n   Estimated Seeks: 740\r\n   Estimated Nexts: 1736\r\n   Estimated Docdb Result Width: 20\r\n(18 rows)\r\n```\r\n\r\nQuestions: \r\n* why are the estimated seeks of the Bitmap Index Scan and the Index Scan the same? There should be\r\n   * 1 seek for looking up the row from the index\r\n   * 500 nexts for finding the next matches from the index\r\n   * 500 seeks for finding the rows from the main table (this would appear in the Bitmap Table Scan). \r\n* Why is the index scan costed so highly? \r\n\r\n### Issue Type\r\n\r\nkind/bug\r\n\r\n### Warning: Please confirm that this issue does not contain any sensitive information\r\n\r\n- [X] I confirm this issue does not contain any sensitive information.\r\n\r\n[DB-14044]: https://yugabyte.atlassian.net/browse/DB-14044?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/24913/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/24913/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":15348024832,"node_id":"REFE_lADOBlCVUc6ehvQYzwAAAAOS0EYA","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/15348024832","actor":{"login":"gauravk-in","id":564644,"node_id":"MDQ6VXNlcjU2NDY0NA==","avatar_url":"https://avatars.githubusercontent.com/u/564644?v=4","gravatar_id":"","url":"https://api.github.com/users/gauravk-in","html_url":"https://github.com/gauravk-in","followers_url":"https://api.github.com/users/gauravk-in/f