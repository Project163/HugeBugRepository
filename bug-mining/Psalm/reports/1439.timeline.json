ject<I:AnEntity as AnId>, type O:AnEntityRepository as AnObject<I:AnEntityRepository as AnId> given\n```\n</details>\n\n<details>\n<summary>https://psalm.dev/r/ad8477b7ea</summary>\n\n```php\n<?php\n\n// DATA MODEL\n/** @template T */\ninterface AnId\n{\n\t/**\n\t * Getter for the internal value.\n\t *\n\t * @return T Internal value.\n\t */\n\tpublic function getValue();\n}\n\n/** @template I of AnId */\nabstract class AnObject\n{\n   \t/**\n\t * Getter for the identifier.\n\t *\n\t * @psalm-return I The identifier\n\t */\n\tabstract public function getId();\n}\n\n// PERSISTENCE\n\n/** @template T of object */\ninterface DbEntity\n{\n\t/**\n\t * Maps this entity to a data-model object\n\t *\n\t * @return object Data-model object to which this entity maps.\n\t * @psalm-return T\n\t */\n\tpublic function toModel(): object;\n}\n\n/**\n * Interface for all entities that map to data model object with an identifier.\n *\n * @template I of AnId\n * @template O of AnObject<I>\n * @extends DbEntity<O>\n */\ninterface AnEntity\nextends DbEntity {}\n\n/**\n * Repository of database entities.\n * @template T of object\n * @template E of DbEntity<T>\n */\nabstract class DbEntityRepository {}\n\n/**\n * Repository of database entities that maps to data model objects with identifiers.\n * @template I of AnId\n * @template O of AnObject<I>\n * @template E of AnEntity<I, O>\n */\nabstract class AnEntityRepository\n{}\n```\n\n```\nPsalm output (using commit 8f39de9):\n\nNo issues!\n```\n</details>\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/comments/1326274258/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"psalm-github-bot[bot]","id":58627613,"node_id":"MDM6Qm90NTg2Mjc2MTM=","avatar_url":"https://avatars.githubusercontent.com/in/48546?v=4","gravatar_id":"","url":"https://api.github.com/users/psalm-githu