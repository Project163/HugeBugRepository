orm/typeorm/deployments","created_at":"2016-02-29T07:41:14Z","updated_at":"2025-12-12T16:46:06Z","pushed_at":"2025-12-12T10:50:18Z","git_url":"git://github.com/typeorm/typeorm.git","ssh_url":"git@github.com:typeorm/typeorm.git","clone_url":"https://github.com/typeorm/typeorm.git","svn_url":"https://github.com/typeorm/typeorm","homepage":"http://typeorm.io","size":33014,"stargazers_count":36125,"watchers_count":36125,"language":"TypeScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":6469,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":540,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["active-record","cockroachdb","data-mapper","database","electron","hacktoberfest","javascript","mariadb","mysql","oracle","orm","postgresql","react-native","sap","sap-hana","sqlite","sqlserver","typeorm","typescript","websql"],"visibility":"public","forks":6469,"open_issues":540,"watchers":36125,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/typeorm/typeorm/pulls/7005","html_url":"https://github.com/typeorm/typeorm/pull/7005","diff_url":"https://github.com/typeorm/typeorm/pull/7005.diff","patch_url":"https://github.com/typeorm/typeorm/pull/7005.patch","merged_at":"2021-03-08T13:10:11Z"},"body":"Fixes #7002\r\n\r\n### Description of change\r\n- correctly get the value for joinColumn from referencedColumn in `getEntityValueMap`.\r\n\r\nSuppose an entity below\r\n```typescript\r\n@Entity()\r\nexport class Foo {\r\n    @PrimaryColumn()\r\n    id: number;\r\n\r\n    @Column()\r\n    text: string;\r\n\r\n    @OneToOne(() => Bar, b => b.foo, { primary: true })\r\n    @JoinColumn({ name: \"id\", referencedColumnName: \"id\" })\r\n    bar: Bar;\r\n\r\n    @CreateDateColumn()\r\n    d: Date;\r\n}\r\n```\r\nnow we can get entity id of foo `1` from `Foo { bar: { id: 1 }, text: \"a\" }` by `EntityMetadata#getEntityIdMap()`\r\n\r\n\r\n\r\n### Pull-Request Checklist\r\n\r\n<!--\r\n  Please make sure to review and check all of the following.\r\n\r\n  If an item is not applicable, you can add \"N/A\" to the end.\r\n-->\r\n\r\n- [x] Code is up-to-date with the `master` branch\r\n- [x] `npm run lint` passes with this change\r\n- [x] `npm run test` passes with this change\r\n- [x] This pull request links relevant issues as `Fixes #0000`\r\n- [x] There are new or updated unit tests validating the change\r\n- [ ] Documentation has been updated to reflect this change\r\n- [x] The new commits follow conventions explained in [CONTRIBUTING.md](https://github.com/typeorm/typeorm/blob/master/CONTRIBUTING.md)\r\n\r\n<!--\r\n  🎉 Thank you for contributing and making TypeORM even better!\r\n-->\r\n","reactions":{"url":"https://api.github.com/repos/typeorm/typeorm/issues/7005/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/typeorm/typeorm/issues/7005/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":4421190691,"node_id":"MDExOkNsb3NlZEV2ZW50NDQyMTE5MDY5MQ==","url":"https://api.github.com/repos/typeorm/typeorm/issues/events/4421190691","actor":{"login":"AlexMesser","id":17142628,"node_id":"MDQ6VXNlcjE3MTQyNjI4","avatar_url":"https://avatars.githubusercontent.com/u/17142628?v=4","gravatar_id":"","url":"https://api.github.com/users/AlexMesser","html_url":"https://github.com/AlexMesser","followers_url":"https://api.github.com/users/AlexMesser/followers","following_url":"https://api.github.com/users/AlexMesser/following{/other_user}","gists_url":"https://api.github.com/users/AlexMesser/gists{/gist_id}","starred_url":"https://api.github.com