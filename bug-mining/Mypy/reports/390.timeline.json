ssum/orgs","repos_url":"https://api.github.com/users/gvanrossum/repos","events_url":"https://api.github.com/users/gvanrossum/events{/privacy}","received_events_url":"https://api.github.com/users/gvanrossum/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-02-10T02:17:39Z","updated_at":"2018-02-10T02:17:39Z","body":"The interface hash is just a hash of the cache file written. This is clearly wrong and will be tricky to fix.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/364618390/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"gvanrossum","id":2894642,"node_id":"MDQ6VXNlcjI4OTQ2NDI=","avatar_url":"https://avatars.githubusercontent.com/u/2894642?v=4","gravatar_id":"","url":"https://api.github.com/users/gvanrossum","html_url":"https://github.com/gvanrossum","followers_url":"https://api.github.com/users/gvanrossum/followers","following_url":"https://api.github.com/users/gvanrossum/following{/other_user}","gists_url":"https://api.github.com/users/gvanrossum/gists{/gist_id}","starred_url":"https://api.github.com/users/gvanrossum/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gvanrossum/subscriptions","organizations_url":"https://api.github.com/users/gvanrossum/orgs","repos_url":"https://api.github.com/users/gvanrossum/repos","events_url":"https://api.github.com/users/gvanrossum/events{/privacy}","received_events_url":"https://api.github.com/users/gvanrossum/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/python/mypy/issues/comments/364623307","html_url":"https://github.com/python/mypy/issues/4562#issuecomment-364623307","issue_url":"https://api.github.com/repos/python/mypy/issues/4562","id":364623307,"node_id":"MDEyOklzc3VlQ29tbWVudDM2NDYyMzMwNw==","user":{"login":"msullivan","id":340349,"node_id":"MDQ6VXNlcjM0MDM0OQ==","avatar_url":"https://avatars.githubusercontent.com/u/340349?v=4","gravatar_id":"","url":"https://api.github.com/users/msullivan","html_url":"https://github.com/msullivan","followers_url":"https://api.github.com/users/msullivan/followers","following_url":"https://api.github.com/users/msullivan/following{/other_user}","gists_url":"https://api.github.com/users/msullivan/gists{/gist_id}","starred_url":"https://api.github.com/users/msullivan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/msullivan/subscriptions","organizations_url":"https://api.github.com/users/msullivan/orgs","repos_url":"https://api.github.com/users/msullivan/repos","events_url":"https://api.github.com/users/msullivan/events{/privacy}","received_events_url":"https://api.github.com/users/msullivan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-02-10T03:44:43Z","updated_at":"2018-02-10T03:44:43Z","body":"Here is a very related test case that also fails:\r\n```\r\n[case testIncrementalLotsOfInheritance]\r\nimport a\r\n[file a.py]\r\nfrom b import B\r\nfrom d import D\r\ndef take(d: D) -> None: pass\r\ndef foo() -> None:\r\n    take(B())\r\n[file b.py]\r\nfrom c import C\r\nclass B(C): pass\r\n\r\n[file c.py]\r\nfrom d import D\r\nclass C(D): pass\r\n\r\n[file c.py.2]\r\nfrom d import D\r\nclass C: pass\r\n\r\n[file d.py]\r\nclass D: pass\r\n[out]\r\n[out2]\r\ntmp/a.py:5: error: Argument 1 to \"take\" has incompatible type \"B\"; expected \"D\"\r\n```\r\n\r\nThe problem in both of these cases is that we fail to detect the indirect dependencies that `a` has on `c` (which we *do* correctly do if `get` is annotated in the first test). We shouldn't need `b`'s interface hash to change if the indirect dependencies are properly calculated.\r\n\r\nIn the first test case, we fail to detect the indirect dependencies because the `CallableType`s assigned to unannotated methods lack a `definition` field, so `TypeIndirectionVisitor` can't find that it is defined in `C`.\r\n\r\nTo get the second test case right, `a` needs to indirectly depend on every class in `Baz`'s mro, so that it can detect mro changes. Doing this also fixes the unannotated method failure.\r\n","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/364623307/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"msullivan","id":340349,"node_id":"MDQ6VXNlcjM0MDM0OQ==","avatar_url":"https://avatars.githubusercontent.com/u/340349?v=4","gravatar_id":"","url":"https://api.github.com/users/msullivan","html_url":"https://github.com/msullivan","followers_url":"https://api.github.com/users/msullivan/followers","following_url":"https://api.github.com/users/msullivan/following{/other_user}","gists_url":"https://api.github.com/users/msullivan/gists{/gist_id}","starred_url":"https://api.github.com/users/msullivan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/msullivan/subscriptions","organizations_url":"https://api.github.com/users/msullivan/orgs","repos_url":"https://api.github.com/users/msullivan/repos","events_url":"https://api.github.com/users/msullivan/events{/privacy}","received_events_url":"https://api.github.com/users/msullivan/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/python/mypy/issues/comments/364627454","html_url":"https://github.com/python/mypy/issues/4562#issuecomment-364627454","issue_url":"https://api.github.com/repos/python/mypy/issues/4562","id":364627454,"node_id":"MDEyOklzc3VlQ29tbWVudDM2NDYyNzQ1NA==","user":{"login":"gvanrossum","id":2894642,"node_id":"MDQ6VXNlcjI4OTQ2NDI=","avatar_url":"https://avatars.githubusercontent.com/u/2894642?v=4","gravatar_id":"","url":"https://api.github