+          const auto shared_tablet = peer->shared_tablet();
+          if (shared_tablet) {
+            current_size = shared_tablet->GetCurrentVersionSstFilesSize();
+          } else {
+            split_happened = true;
+          }
           break;
         }
       }
+      if (split_happened) {
+        break;
+      }
     }
     RETURN_NOT_OK(WaitForTabletSplitCompletion(
       /* expected_non_split_tablets =*/ cur_num_tablets + 1));
