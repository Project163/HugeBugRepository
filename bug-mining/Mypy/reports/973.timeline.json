nt\r\n  File \"mypy/checker.py\", line 3294, in check_simple_assignment\r\n  File \"mypy/checker.py\", line 5203, in check_subtype\r\n  File \"mypy/subtypes.py\", line 94, in is_subtype\r\n  File \"mypy/subtypes.py\", line 151, in _is_subtype\r\n  File \"mypy/types.py\", line 1328, in accept\r\n  File \"mypy/subtypes.py\", line 357, in visit_callable_type\r\n  File \"mypy/subtypes.py\", line 205, in _is_subtype\r\n  File \"mypy/subtypes.py\", line 94, in is_subtype\r\n  File \"mypy/subtypes.py\", line 151, in _is_subtype\r\n  File \"mypy/types.py\", line 1065, in accept\r\n  File \"mypy/subtypes.py\", line 286, in visit_instance\r\n  File \"mypy/subtypes.py\", line 588, in is_protocol_implementation\r\nAssertionError: \r\ncrash_mypy.py:9: : note: use --pdb to drop into pdb\r\n```\r\n<!--\r\n  Did something go wrong?\r\n  Is something broken, or not behaving as you expected?\r\n-->\r\n\r\n**Your Environment**\r\n\r\n- Mypy version used: 0.942\r\n- Mypy command-line flags: either none or `--show-traceback`\r\n- Mypy configuration options from `mypy.ini` (and other config files): none\r\n- Python version used: 3.9\r\n- Operating system and version: Debian 11","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/12642/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/mypy/issues/12642/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":6471054454,"node_id":"LE_lADOAGuhRc42Rv5CzwAAAAGBtHR2","url":"https://api.github.com/repos/python/mypy/issues/events/6471054454","actor":{"login":"AlexWaygood","id":66076021,"node_id":"MDQ6VXNlcjY2MDc2MDIx","avatar_url":"https://avatars.githubusercontent.com/u/66076021?v=4","gravatar_id":"","url":"https://api.github.com/users/AlexWaygood","html_url":"https://github.com/AlexWaygood","followers_url":"https://api.github.com/users/AlexWaygood/followers","following_url":