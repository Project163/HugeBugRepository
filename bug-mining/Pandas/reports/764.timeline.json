[{"url":"https://api.github.com/repos/pandas-dev/pandas/issues/comments/20391767","html_url":"https://github.com/pandas-dev/pandas/issues/3334#issuecomment-20391767","issue_url":"https://api.github.com/repos/pandas-dev/pandas/issues/3334","id":20391767,"node_id":"MDEyOklzc3VlQ29tbWVudDIwMzkxNzY3","user":{"login":"guyrt","id":1184478,"node_id":"MDQ6VXNlcjExODQ0Nzg=","avatar_url":"https://avatars.githubusercontent.com/u/1184478?v=4","gravatar_id":"","url":"https://api.github.com/users/guyrt","html_url":"https://github.com/guyrt","followers_url":"https://api.github.com/users/guyrt/followers","following_url":"https://api.github.com/users/guyrt/following{/other_user}","gists_url":"https://api.github.com/users/guyrt/gists{/gist_id}","starred_url":"https://api.github.com/users/guyrt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/guyrt/subscriptions","organizations_url":"https://api.github.com/users/guyrt/orgs","repos_url":"https://api.github.com/users/guyrt/repos","events_url":"https://api.github.com/users/guyrt/events{/privacy}","received_events_url":"https://api.github.com/users/guyrt/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2013-07-03T02:18:21Z","updated_at":"2013-07-03T02:18:21Z","body":"I've traced this bug to the type of index we have on the columns of the pivoted table. The pivoted table is first constructed here:\n\nhttps://github.com/pydata/pandas/blob/master/pandas/tools/pivot.py#L100\n\nIf the rows and columns account for the entire frame, then the index is a single level index. Otherwise, it's multilevel with nlevels=2. This difference causes problems later when we group by column:\n\nhttps://github.com/pydata/pandas/blob/master/pandas/tools/pivot.py#L156\n\nRather than grouping by level 0 of a multi-index, we are grouping by the only level in a single index. This picks up a particular value in a column rather than the level 0 value in the index, which was the name of a column.\n\nI'll try to push a fix tomorrow or the next day pending time to work on it. We may need to handle this case specially.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/pandas-dev/pandas/issues/comments/20391767/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"guyrt","id":1184478,"node_id":"MDQ6VXNlcjExODQ0Nzg=","avatar_url":"https://avatars.githubusercontent.com/u/1184478?v=4","gravatar_id":"","url":"https://api.github.com/users/guyrt","html_url":"https://github.com/guyrt","followers_url":"https://api.github.com/users/guyrt/followers","following_url":"https://api.github.com/users/guyrt/following{/other_user}","gists_url":"https://api.github.com/users/guyrt/gists{/gist_id}","starred_url":"https://api.github.com/users/guyrt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/guyrt/subscriptions","organizations_url":"https://api.github.com/users/guyrt/orgs","repos_url":"https://api.github.com/users/guyrt/repos","events_url":"https://api.github.com/users/guyrt/events{/privacy}","received_events_url":"https://api.github.com/users/guyrt/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/pandas-dev/pandas/issues/comments/20392778","html_url":"https://github.com/pandas-dev/pandas/issues/3334#issuecomment-20392778","issue_url":"https://api.github.com/repos/pandas-dev/pandas/issues/3334","id":20392778,"node_id":"MDEyOklzc3VlQ29tbWVudDIwMzkyNzc4","user":{"login":"guyrt","id":1184478,"node_id":"MDQ6VXNlcjExODQ0Nzg=","avatar_url":"https://avatars.githubusercontent.com/u/1184478?v=4","gravatar_id":"","url":"https://api.github.com/users/guyrt","html_url":"https://github.com/guyrt","followers_url":"https://api.github.com/users/guyrt/followers","following_url":"https://api.github.com/users/guyrt/following{/other_user}","gists_url":"https://