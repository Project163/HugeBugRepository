org.eclipse.jetty.websocket.api.UpgradeException: Didn&apos;t switch protocols&lt;br/&gt;
	at org.eclipse.jetty.websocket.client.io.UpgradeConnection.validateResponse(UpgradeConnection.java:314)&lt;br/&gt;
	at org.eclipse.jetty.websocket.client.io.UpgradeConnection.read(UpgradeConnection.java:241)&lt;br/&gt;
	at org.eclipse.jetty.websocket.client.io.UpgradeConnection.onFillable(UpgradeConnection.java:163)&lt;br/&gt;
