y/codacy-pylint/downloads","issues_url":"https://api.github.com/repos/codacy/codacy-pylint/issues{/number}","pulls_url":"https://api.github.com/repos/codacy/codacy-pylint/pulls{/number}","milestones_url":"https://api.github.com/repos/codacy/codacy-pylint/milestones{/number}","notifications_url":"https://api.github.com/repos/codacy/codacy-pylint/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/codacy/codacy-pylint/labels{/name}","releases_url":"https://api.github.com/repos/codacy/codacy-pylint/releases{/id}","deployments_url":"https://api.github.com/repos/codacy/codacy-pylint/deployments","created_at":"2015-08-04T10:19:47Z","updated_at":"2024-08-02T17:18:41Z","pushed_at":"2025-12-08T00:35:08Z","git_url":"git://github.com/codacy/codacy-pylint.git","ssh_url":"git@github.com:codacy/codacy-pylint.git","clone_url":"https://github.com/codacy/codacy-pylint.git","svn_url":"https://github.com/codacy/codacy-pylint","homepage":"","size":524,"stargazers_count":17,"watchers_count":17,"language":"Python","has_issues":false,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":11,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":[],"visibility":"public","forks":11,"open_issues":1,"watchers":17,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/codacy/codacy-pylint/pulls/3","html_url":"https://github.com/codacy/codacy-pylint/pull/3","diff_url":"https://github.com/codacy/codacy-pylint/pull/3.diff","patch_url":"https://github.com/codacy/codacy-pylint/pull/3.patch","merged_at":"2016-01-05T23:20:42Z"},"body":"Apart of incrementing the pylint version, the changeset involved modifying the way in which the messages were parsed from pylint. Previously they were formatted with a hand crafted message template, which resulted in potentially invalid JSON, especially for messages which put additional quotes into the message (for instance expression-not-assigned). This was dropped in favor of building\nmanually the issue class from the parsed message lines. The test files were also updated so that they could work on the new release. Other things which were updated were removed message ids or message ids which now have a different value, as it is the case for E0235, which is now E0302 (unexpected-special-method-signature).\n\nAlmost all of the tests should be fixed when running them with codacy-plugins-tests, but there's only one left which fails with this approach (C0326). This is happening because we're working line by line, but for C0326, the message of the check goes on more lines. I would leave this like this, since in a couple of days we could change it to use \"pylint -fjson\", which should output directly the text in the JSON format. Unfortunately, it's not properly working now due to https://github.com/PyCQA/pylint/issues/766\n\n(FT-1054)\n","reactions":{"url":"https://api.github.com/repos/codacy/codacy-pylint/issues/3/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/codacy/codacy-pylint/issues/3/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":508855292,"node_id":"MDEyOkxhYmVsZWRFdmVudDUwODg1NTI5Mg==","url":"https://api.github.com/repos/pylint-dev/pylint/issues/events/508855292","actor":{"login":"PCManticore","id":448166,"node_id":"MDQ6VXNlcjQ0ODE2Ng==","avatar_url":"https://avatars.githubusercontent.com/u/448166?v=4","gravatar_id":"","url":"https://api.github.com/users/PCManticore","html_url":"https://github.com/PCManticore","followers_url":"https://api.github.com/users/PCManticore/