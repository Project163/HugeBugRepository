+        $config_xml = Config::loadFromXML(
+            (string) getcwd(),
+            <<<XML
+            <?xml version="1.0"?>
+            <psalm>
+                <issueHandlers>
+                    <TooManyArguments>
+                        <errorLevel type="suppress">
+                            <referencedFunction name="Foo\Bar::baz" />
+                        </errorLevel>
+                    </TooManyArguments>
+                </issueHandlers>
+            </psalm>
+            XML,
+        );
