/repos/celery/celery/pulls{/number}","milestones_url":"https://api.github.com/repos/celery/celery/milestones{/number}","notifications_url":"https://api.github.com/repos/celery/celery/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/celery/celery/labels{/name}","releases_url":"https://api.github.com/repos/celery/celery/releases{/id}","deployments_url":"https://api.github.com/repos/celery/celery/deployments","created_at":"2009-04-24T11:31:24Z","updated_at":"2026-03-11T11:08:53Z","pushed_at":"2026-03-10T15:04:28Z","git_url":"git://github.com/celery/celery.git","ssh_url":"git@github.com:celery/celery.git","clone_url":"https://github.com/celery/celery.git","svn_url":"https://github.com/celery/celery","homepage":"https://docs.celeryq.dev","size":36397,"stargazers_count":28268,"watchers_count":28268,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":4989,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":773,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["amqp","python","python-library","python3","queue-tasks","queue-workers","queued-jobs","redis","redis-queue","sqs","sqs-queue","task-manager","task-runner","task-scheduler"],"visibility":"public","forks":4989,"open_issues":773,"watchers":28268,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/celery/celery/pulls/6853","html_url":"https://github.com/celery/celery/pull/6853","diff_url":"https://github.com/celery/celery/pull/6853.diff","patch_url":"https://github.com/celery/celery/pull/6853.patch","merged_at":"2021-07-13T11:04:58Z"},"body":"## Allow to set `worker_concurrency` option through `user_preload_options` signal mechanism.\r\n\r\n### Current behaviour\r\n\r\n1. `click.option` decorator for `--concurrency` option is executed, its callback returns `0` when evaluating https://github.com/celery/celery/blob/5fd182417d9a6cb1b5aebe29916814d7a725e62a/celery/bin/worker.py#L188 with the values `None or 0`; this default `0` comes from: https://github.com/celery/celery/blob/5fd182417d9a6cb1b5aebe29916814d7a725e62a/celery/app/defaults.py#L297\r\n\r\n2. Celery `user_preload_options` signal is processed, then    `app.conf.worker_concurrency` value is correctly updated through `Settings.update`.\r\n\r\n3. Celery `worker.worker.WorkController.setup_defaults` kicks off and `concurrency` attribute is resolved with https://github.com/celery/celery/blob/5fd182417d9a6cb1b5aebe29916814d7a725e62a/celery/worker/worker.py#L376\r\n\r\n4. `either` method chains calls to `first` function with `None` as predicate (returns the first item that's not `None`): https://github.com/celery/celery/blob/5fd182417d9a6cb1b5aebe29916814d7a725e62a/celery/app/base.py#L925 in our case `first(None, defaults)` (defaults is `(0,)`) will take precedence and `0` will be returned, whatever value is in `app.conf.worker_concurrency`.\r\n\r\n### Proposed solution\r\n\r\nThis fix changes `worker_concurrency` default from `0` to `None` allowing `either` method to correctly resolve in favor of `app.conf.worker_concurrency` value.\r\n\r\nThe final value used as _concurrency_ is resolved in https://github.com/celery/celery/blob/5fd182417d9a6cb1b5aebe29916814d7a725e62a/celery/worker/worker.py#L109 thus having `None` as default value for `self.concurrency` doesn't break things.\r\n\r\nFixes: #6836","reactions":{"url":"https://api.github.com/repos/celery/celery/issues/6853/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/celery/celery/issues/6853/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":5007640065,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDUwMDc2NDAwNjU=","url":"https://api.github.com/repos/celery/celery/issues/events/5007640065","actor":{"login":"alesolda","id":43531535,"node_id":"MDQ6VXNlcjQzNTMxNTM1","avatar_url":"https://avatars.githubusercontent.com/u/43531535?v=4","gravatar_id":"","url":"https://api.github.com/users/alesolda","html_url":"https://github.com/alesolda","followers_url":"https://api.github.com/users/alesolda/followers","following_url":"https://api.github.com/users/alesolda/following{/other_user}","gists_url":"https://api.github.com/users/alesolda/gists{/gist_id}","starred_url":"https://api.github.com/users/alesolda/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alesolda/subscriptions","organizations_url":"https://api.github.com/users/alesolda/orgs","repos_url":"https://api.github.com/users/alesolda/repos","events_url":"https://api.github.com/users/alesolda/events{/privacy}","received_events_url":"https://api.github.com/users/alesolda/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"486f5becc0441610b3e5a20a0862f80ee274e51e","commit_url":"https://api.github.com/repos/alesolda/celery/commits/486f5becc0441610b3e5a20a0862f80ee274e51e","created_at":"2021-07-12T13:47:25Z","performed_via_github_app":null},{"id":5013044554,"node_id":"MDExOkNsb3NlZEV2ZW50NTAxMzA0NDU1NA==","url":"https://api.github.com/repos/celery/celery/issues/events/5013044554","actor":{"login":"auvipy","id":6212603,"node_id":"MDQ6VXNlcjYyMTI2MDM=","avatar_url":"https://avatars.githubusercontent.com/u/6212603?v=4","gravatar_id":"","url":"https://api.github.com/users/auvipy","html_url":"https://github.com/auvipy","followers_url":"https://api.github.com/users/auvipy/followers","following_url":"https://api.github.com/users/auvipy/following{/other_user}","gists_url":"https://api.github.com/users/auvipy/gists{/gist_id}","sta