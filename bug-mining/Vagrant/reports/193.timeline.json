ercontent.com/u/3476391?v=4","gravatar_id":"","url":"https://api.github.com/users/Stromweld","html_url":"https://github.com/Stromweld","followers_url":"https://api.github.com/users/Stromweld/followers","following_url":"https://api.github.com/users/Stromweld/following{/other_user}","gists_url":"https://api.github.com/users/Stromweld/gists{/gist_id}","starred_url":"https://api.github.com/users/Stromweld/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Stromweld/subscriptions","organizations_url":"https://api.github.com/users/Stromweld/orgs","repos_url":"https://api.github.com/users/Stromweld/repos","events_url":"https://api.github.com/users/Stromweld/events{/privacy}","received_events_url":"https://api.github.com/users/Stromweld/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/hashicorp/vagrant/issues/comments/3138932286","html_url":"https://github.com/hashicorp/vagrant/issues/13698#issuecomment-3138932286","issue_url":"https://api.github.com/repos/hashicorp/vagrant/issues/13698","id":3138932286,"node_id":"IC_kwDOAAdaUM67GE4-","user":{"login":"taru-garg-hashicorp","id":199579441,"node_id":"U_kgDOC-VXMQ","avatar_url":"https://avatars.githubusercontent.com/u/199579441?v=4","gravatar_id":"","url":"https://api.github.com/users/taru-garg-hashicorp","html_url":"https://github.com/taru-garg-hashicorp","followers_url":"https://api.github.com/users/taru-garg-hashicorp/followers","following_url":"https://api.github.com/users/taru-garg-hashicorp/following{/other_user}","gists_url":"https://api.github.com/users/taru-garg-hashicorp/gists{/gist_id}","starred_url":"https://api.github.com/users/taru-garg-hashicorp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/taru-garg-hashicorp/subscriptions","organizations_url":"https://api.github.com/users/taru-garg-hashicorp/orgs","repos_url":"https://api.github.com/users/taru-garg-hashicorp/repos","events_url":"https://api.github.com/users/taru-garg-hashicorp/events{/privacy}","received_events_url":"https://api.github.com/users/taru-garg-hashicorp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-31T04:55:00Z","updated_at":"2025-07-31T07:57:54Z","body":"I tried building a box with bento and then running the test command, it failed as you had raised, however, once I ran a box add command for e.g. `vagrant box add <boxfile> --provider vmware_desktop --architecture arm64 --name <name>` and tried to normally bring up a VM with that box using a simple Vagrantfile like below it works\n\n```ruby\nVagrant.configure(\"2\") do |config|\n    config.vm.box = '<name>'\nend\n```\n\nCould you try adding the box and then running the up command ? While I have not investigated any further I wonder if there's a difference in how the box is getting added in both scenarios, let me know if the `box add` approach works for you while I look why there's a difference.\n\nEdit: I think its the architecture in the `Vagrantfile` that's causing the issue could you try the same `Vagrantfile` with the `box_architecture` removed, and tell if it works, it works fine for me. Will update in case I have more details to share\n\nEdit: Thanks for the report, I was able to find the issue, as in the earlier edit it is to do with `box_architecture`, the parameter was getting passed incorrectly to the `box add action` when adding a box directly from a file, I will raise a PR for the same and hopefully get it merged before the next release. Also I will transition this issue to Vagrant as that is where the issue is.\n\nCheers!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/hashicorp/vagrant/issues/comments/3138932286/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"taru-garg-hashicorp","id":199579441,"node_id":"U_kgDOC-VXMQ