2[0])\r\nd2[0] = 'newstr' # This generates an error, this should not error in my opinion\r\n\r\nD2 = Dict[int, Union[str, int, bool, float]]\r\n\r\nd3: D2 = {\r\n    0: 1,\r\n    1: 2\r\n}\r\n\r\nreveal_type(d3[0])\r\nd3[0] = 1\r\nd3[0] = 'asdf' # This is ok, but I don't want to be able to change the type of a value like this\r\n\r\n```\r\n\r\nmypy output\r\n```\r\ntest.py:10: note: Revealed type is 'Union[builtins.str*, builtins.float*]'\r\ntest.py:11: error: Incompatible types in assignment (expression has type \"int\", target has type \"str\")\r\ntest.py:11: error: Incompatible types in assignment (expression has type \"int\", target has type \"bool\")\r\ntest.py:18: note: Revealed type is 'Union[builtins.str*, builtins.float*]'\r\ntest.py:19: error: Incompatible types in assignment (expression has type \"str\", target has type \"bool\")\r\ntest.py:28: note: Revealed type is 'Union[builtins.str, builtins.int, builtins.bool, builtins.float]'\r\n```\r\n\r\nThe revealed type on line 10 and 18 also don't seem to be right.","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/7244/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/mypy/issues/7244/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/python/mypy/issues/comments/1522842730","html_url":"https://github.com/python/mypy/issues/6168#issuecomment-1522842730","issue_url":"https://api.github.com/repos/python/mypy/issues/6168","id":1522842730,"node_id":"IC_kwDOAGuhRc5axLxq","user":{"login":"hauntsaninja","id":12621235,"node_id":"MDQ6VXNlcjEyNjIxMjM1","avatar_url":"https://avatars.githubusercontent.com/u/12621235?v=4","gravatar_id":"","url":"https://api.github.com/users/hauntsaninja","html_url":"https://github.com/hauntsaninja","followers_url":"https://api.github.com/users/hauntsaninja/followers","following_url"