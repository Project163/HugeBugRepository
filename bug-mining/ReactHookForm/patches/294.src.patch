+        ...fieldState,
+        ...(_proxyFormState.isValid && formOptions.resolver ? { isValid } : {}),
+        errors: _formState.errors,
+        name,
+      };
+
+      _formState = {
+        ..._formState,
+        ...updatedFormState,
+      };
+
+      _subjects.state.next(isWatched ? { name } : updatedFormState);
+    }
+
+    _subjects.state.next({
+      isValidating: false,
