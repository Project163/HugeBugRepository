-    }
-
-    // Accumulate transformations.
-
-    for (int i = 0; i < n - 1; i++) {
-      v.setQuick(n - 1, i, v.getQuick(i, i));
-      v.setQuick(i, i, 1.0);
-      double h = d.getQuick(i + 1);
-      if (h != 0.0) {
-        for (int k = 0; k <= i; k++) {
-          d.setQuick(k, v.getQuick(k, i + 1) / h);
-        }
-        for (int j = 0; j <= i; j++) {
-          double g = 0.0;
-          for (int k = 0; k <= i; k++) {
-            g += v.getQuick(k, i + 1) * v.getQuick(k, j);
-          }
-          for (int k = 0; k <= i; k++) {
-            v.setQuick(k, j, v.getQuick(k, j) - g * d.getQuick(k));
