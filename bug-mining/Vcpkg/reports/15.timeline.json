mpare/{base}...{head}","merges_url":"https://api.github.com/repos/microsoft/vcpkg/merges","archive_url":"https://api.github.com/repos/microsoft/vcpkg/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/microsoft/vcpkg/downloads","issues_url":"https://api.github.com/repos/microsoft/vcpkg/issues{/number}","pulls_url":"https://api.github.com/repos/microsoft/vcpkg/pulls{/number}","milestones_url":"https://api.github.com/repos/microsoft/vcpkg/milestones{/number}","notifications_url":"https://api.github.com/repos/microsoft/vcpkg/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/microsoft/vcpkg/labels{/name}","releases_url":"https://api.github.com/repos/microsoft/vcpkg/releases{/id}","deployments_url":"https://api.github.com/repos/microsoft/vcpkg/deployments","created_at":"2016-09-15T16:40:50Z","updated_at":"2025-12-13T05:34:58Z","pushed_at":"2025-12-13T03:27:24Z","git_url":"git://github.com/microsoft/vcpkg.git","ssh_url":"git@github.com:microsoft/vcpkg.git","clone_url":"https://github.com/microsoft/vcpkg.git","svn_url":"https://github.com/microsoft/vcpkg","homepage":"","size":96040,"stargazers_count":26254,"watchers_count":26254,"language":"CMake","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":7235,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1320,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["c","cmake","cplusplus","cpp","libraries","package-manager","packages","vcpkg","visual-studio","windows"],"visibility":"public","forks":7235,"open_issues":1320,"watchers":26254,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"As from the subject, static linking of boost libraries is currently broken.\r\nThis commit https://github.com/Microsoft/vcpkg/commit/7811ef602ecd963ae333e3427c82629d1c8e9f34 is the source of the problems: why renaming static libraries, if those are the names that CMake is then really looking for?\r\nAs an example, now we rename \r\n```\r\nx86-windows-static/libboost_thread-vc140-mt-s-1_64.lib\r\n```\r\ninto\r\n```\r\nx86-windows-static/boost_thread-vc140-mt-1_64.lib.\r\n```\r\nBut this is wrong: boost_thread-vc140-mt-1_64.lib is known to CMake to be the filename of an import library (allowing dynamic linking with boost_thread-vc140-mt-1_64.dll), while *libboost_thread-vc140-mt-s-1_64.lib* should be the name of the static library (also with the -s, meaning it's statically linked with CRT).\r\nIn this way, if I configure CMake to look for static linking with boost, it cannot find the libraries.\r\n\r\nWhat is the original reason of this renaming? Since CMake looks for these filenames, while should we break it?","reactions":{"url":"https://api.github.com/repos/microsoft/vcpkg/issues/1338/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/microsoft/vcpkg/issues/1338/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":4326287030,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDQzMjYyODcwMzA=","url":"https://api.github.com/repos/microsoft/vcpkg/issues/events/4326287030","actor":{"login":"bartholmberg","id":7365093,"node_id":"MDQ6VXNlcjczNjUwOTM=","avatar_url":"https://avatars.githubusercontent.com/u/7365093?v=4","gravatar_id":"","url":"https://api.github.com/users/bartholmberg","html_url":"https://github.com/bartholmberg","followers_url":"https://api.github.com/users/bartholmberg/followers","following_url":"https://api.github.com/users/bartholmberg/following{/other_user}","gists_url":"https://api.github.com/users/bartholmberg/gists{/gist_id}","starred_url":"https://api.github.com/users/bartholmberg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bartholmberg/subscriptions","organizations_url":"https://api.github.com/users/bartholmberg/orgs","repos_url":"https://api.github.com/users/bartholmberg/repos","events_url":"https://api.github.com/users/bartholmberg/events{/privacy}","received_events_url":"https://api.github.com/users/bartholmberg/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"1396c94d22e4b34bdeda4a12f6ad0efd8088f8cf","commit_url":"https://api.github.com/repos/bartholmberg/vcpkg/commits/1396c94d22e4b34bdeda4a12f6ad0efd8088f8cf","created_at":"2021-02-12T19:07:22Z","performed_via_github_app":null}]