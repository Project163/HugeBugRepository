-        // ping-pong-ing back and forth between regions with subscriptions
-        // to each other without termination (or in any other cyclic
-        // configuration).
-        if (isHubSubscriber && !message.getSrcRegion().equals(subscriberRegion)) {
-            return false;
-        } else {
-            return true;
-        }
-    }
