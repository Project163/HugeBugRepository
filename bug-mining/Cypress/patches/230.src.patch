+const props = defineProps<{
+  campaign: string
+}>()
+
+const { t } = useI18n()
+
+const guideUrl = computed(() => {
+  return getUrlWithParams({
+    url: 'https://on.cypress.io/recording-project-runs',
+    params: {
+      utm_campaign: props.campaign,
+      utm_medium: RUNS_TAB_MEDIUM,
+    },
+  })
+})
+</script>
