0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"https://getpsalm.org/r/75a3ca4851\r\n```php\r\n<?php\r\n  namespace NS;\r\n  use Countable;\r\n\r\n  /** @template T */\r\n  class Collection {\r\n    /** @psalm-var iterable<T> */\r\n    private $data;\r\n    \r\n    /** @psalm-param iterable<T> $data */\r\n    public function __construct(iterable $data) {\r\n      $this->data = $data;\r\n    }\r\n  }\r\n\r\n  class Item {}\r\n  /** @psalm-param Collection<Item> $c */\r\n  function takesCollectionOfItems(Collection $c): void {}\r\n  \r\n  /** @psalm-var iterable<Item> $data2 */\r\n  $data2 = [];\r\n  takesCollectionOfItems(new Collection($data2)); // does not fail already\r\n  \r\n  /** @psalm-var iterable<Item>&Countable $data */\r\n  $data = [];\r\n  if (count($data)) {\r\n    takesCollectionOfItems(new Collection($data)); // should not fail\r\n  }\r\n```\r\nHere I expect psalm to infer that parameter of `takesCollectionOfItems()` is actually `Collection<Item>` for both calls, but psalm thinks it's `Collection<mixed>` when it's constructed from the intersection type.","closed_by":{"login":"muglug","id":2292638,"node_id":"MDQ6VXNlcjIyOTI2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/2292638?v=4","gravatar_id":"","url":"https://api.github.com/users/muglug","html_url":"https://github.com/muglug","followers_url":"https://api.github.com/users/muglug/followers","following_url":"https://api.github.com/users/muglug/following{/other_user}","gists_url":"https://api.github.com/users/muglug/gists{/gist_id}","starred_url":"https://api.github.com/users/muglug/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/muglug/subscriptions","organizations_url":"https://api.github.com/users/muglug/orgs","repos_url":"https://api.github.com/users/muglug/repos","events_url":"https://api.github.com/users/muglug/events{/privacy}","received_events_url":"https://api.github.com/u