-  }
-
-  private static int[] reversePivotPermutation(int[] pivot) {
-    int[] unpivot1 = new int[pivot.length];
-    for (int i = 0; i < pivot.length; i++) {
-      unpivot1[pivot[i]] = i;
-    }
-    return unpivot1;
-  }
