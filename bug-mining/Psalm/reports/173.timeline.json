eo/psalm/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/vimeo/psalm/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/vimeo/psalm/git/refs{/sha}","trees_url":"https://api.github.com/repos/vimeo/psalm/git/trees{/sha}","statuses_url":"https://api.github.com/repos/vimeo/psalm/statuses/{sha}","languages_url":"https://api.github.com/repos/vimeo/psalm/languages","stargazers_url":"https://api.github.com/repos/vimeo/psalm/stargazers","contributors_url":"https://api.github.com/repos/vimeo/psalm/contributors","subscribers_url":"https://api.github.com/repos/vimeo/psalm/subscribers","subscription_url":"https://api.github.com/repos/vimeo/psalm/subscription","commits_url":"https://api.github.com/repos/vimeo/psalm/commits{/sha}","git_commits_url":"https://api.github.com/repos/vimeo/psalm/git/commits{/sha}","comments_url":"https://api.github.com/repos/vimeo/psalm/comments{/number}","issue_comment_url":"https://api.github.com/repos/vimeo/psalm/issues/comments{/number}","contents_url":"https://api.github.com/repos/vimeo/psalm/contents/{+path}","compare_url":"https://api.github.com/repos/vimeo/psalm/compare/{base}...{head}","merges_url":"https://api.github.com/repos/vimeo/psalm/merges","archive_url":"https://api.github.com/repos/vimeo/psalm/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/vimeo/psalm/downloads","issues_url":"https://api.github.com/repos/vimeo/psalm/issues{/number}","pulls_url":"https://api.github.com/repos/vimeo/psalm/pulls{/number}","milestones_url":"https://api.github.com/repos/vimeo/psalm/milestones{/number}","notifications_url":"https://api.github.com/repos/vimeo/psalm/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/vimeo/psalm/labels{/name}","releases_url":"https://api.github.com/repos/vimeo/psalm/releases{/id}","deployments_url":"https://api.github.com/repos/vimeo/psalm/deployments","created_at":"2016-11-21T17:04:41Z","updated_at":"2025-12-12T13:56:46Z","pushed_at":"2025-12-11T08:59:09Z","git_url":"git://github.com/vimeo/psalm.git","ssh_url":"git@github.com:vimeo/psalm.git","clone_url":"https://github.com/vimeo/psalm.git","svn_url":"https://github.com/vimeo/psalm","homepage":"https://psalm.dev","size":116606,"stargazers_count":5784,"watchers_count":5784,"language":"PHP","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":684,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1949,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["hacktoberfest","php","security-analysis","static-analysis","taint-analysis","type-inference"],"visibility":"public","forks":684,"open_issues":1949,"watchers":5784,"default_branch":"6.x","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"I'm not sure if I'm doing something wrong, but it seems that psalm has some issues getting type information for functions defined in autoloaded files via configuration or include files from autoloaded composer files.\r\n\r\nTo illustrate, let's say that we have a project with following files\r\n\r\n* `src/functions.php`\r\n* `src/MyClass.php`\r\n* `autoload.php`\r\n* `composer.json`\r\n\r\nThe `src/functions.php` is defined like:\r\n\r\n```php\r\n<?php\r\n\r\nnamespace TestSpace\\Stuff;\r\n\r\n/**\r\n * @return string[]\r\n */\r\nfunction getStrings(): array\r\n{\r\n    return ['foo', 'bar'];\r\n}\r\n```\r\n\r\nThe `src/MyClass.php` as:\r\n\r\n```php\r\n<?php\r\n\r\nnamespace TestSpace\\Stuff;\r\n\r\nclass MyClass\r\n{\r\n    public function outputString(): void\r\n    {\r\n        $values = getStrings();\r\n\r\n        foreach ($values as $value) {\r\n            $this->output($value);\r\n        }\r\n    }\r\n\r\n    private function output(string $string): void\r\n    {\r\n        echo $string;\r\n    }\r\n}\r\n```\r\n\r\nThe `autoload.php` as:\r\n\r\n```php\r\n<?php\r\n\r\nrequire_once __DIR__ . '/src/functions.php';\r\n```\r\n\r\n And finally the `composer.json` as:\r\n\r\n```json\r\n{\r\n  \"autoload\": {\r\n    \"psr-4\": {\r\n      \"TestSpace\\\\Stuff\\\\\": \"src/\"\r\n    },\r\n    \"files\": [\r\n      \"autoload.php\"\r\n    ]\r\n  }\r\n}\r\n```\r\n\r\nWith this setup, if we run `psalm --init src 1` and run the analysis, we get the following errors:\r\n\r\n```\r\n$ psalm\r\nScanning files...\r\nAnalyzing files...\r\n\r\nERROR: MixedAssignment - src/MyClass.php:11:29 - Cannot assign $value to a mixed type\r\n        foreach ($values as $value) {\r\n\r\n\r\nERROR: MixedArgument - src/MyClass.php:12:27 - Argument 1 of TestSpace\\Stuff\\MyClass::output cannot be mixed, expecting string\r\n            $this->output($value);\r\n\r\n\r\n------------------------------\r\n2 errors found\r\n------------------------------\r\n```\r\n\r\n**However**, if we change the composer `files` autoloader entry to load the `functions.php` directly (i.e. via `\"files\": [\"src/functions.php\"]`, we won't get any errors.\r\n\r\nAlso, if we dropped the the \"files\" entry entirely from the autoloader and used either `autoload=\"autoload.php\"` or `autoload=\"src/functions.php\"` xml configuration instead, we will also get the errors. Whether the file is included or not directly via a `<file>` tag seems to have no effect.\r\n\r\nIt seems an odd inconsistency that adding the file directly to the autoloaded files will result in the types being detected correctly, but it no other case they are.\r\n\r\nI've attached the sample test case where typing `psalm` will result in the errors: \r\n[psalm-types.tar.gz](https://github.com/vimeo/psalm/files/2148592/psalm-types.tar.gz)","reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/848/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vimeo/psalm/issues/848/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]