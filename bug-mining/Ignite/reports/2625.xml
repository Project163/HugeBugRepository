                            <comment id="16070040" author="ptupitsyn" created="Fri, 30 Jun 2017 12:46:49 +0000"  >&lt;p&gt;Resulting lookup list:&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;        &lt;span class=&quot;code-keyword&quot;&gt;private&lt;/span&gt; &lt;span class=&quot;code-keyword&quot;&gt;static&lt;/span&gt; readonly string[] JvmDllLookupPaths =
        {
            &lt;span class=&quot;code-comment&quot;&gt;// JRE paths
&lt;/span&gt;            @&lt;span class=&quot;code-quote&quot;&gt;&quot;bin\server&quot;&lt;/span&gt;,
            @&lt;span class=&quot;code-quote&quot;&gt;&quot;bin\client&quot;&lt;/span&gt;,

            &lt;span class=&quot;code-comment&quot;&gt;// JDK paths
&lt;/span&gt;            @&lt;span class=&quot;code-quote&quot;&gt;&quot;jre\bin\server&quot;&lt;/span&gt;,
            @&lt;span class=&quot;code-quote&quot;&gt;&quot;jre\bin\client&quot;&lt;/span&gt;,
            @&lt;span class=&quot;code-quote&quot;&gt;&quot;jre\bin\&lt;span class=&quot;code-keyword&quot;&gt;default&lt;/span&gt;&quot;&lt;/span&gt;
        };
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</comment>
