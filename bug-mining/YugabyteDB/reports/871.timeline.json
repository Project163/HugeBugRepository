ting}","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels{/name}","releases_url":"https://api.github.com/repos/yugabyte/yugabyte-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Jira Link: [DB-5371](https://yugabyte.atlassian.net/browse/DB-5371)\r\n### Description\n\nCode in process_tree_supervisor\r\n```\r\ndef handle_termination(self):\r\n    def handle_termination(self):\r\n        killed_pids = []\r\n        for pid in self.pid_set:\r\n            if pid != self.ancestor_pid:\r\n                process = get_process_by_pid(pid)\r\n                if process is None:\r\n                    logging.info(\"Child pid %d seems to have terminated on its own\", pid)\r\n                else:\r\n                    self.report_stray_process(process, will_kill=self.args.terminate_subtree)\r\n                    if self.args.terminate_subtree:\r\n                        os.kill(process.pid, signal.SIGKILL)\r\n                        killed_pids.append(process.pid)\r\n```\r\nProcess tree supervisor makes a list of stray processes that have not died when the test ended. It then reports these stray processes and tries to kill them. However, sometimes, the os.kill command crashes with exception because the process is no longer found. It can happen that the process can die in the time gap between being detected as a stray process and actually getting killed. \r\n\r\nThis issue was seen quite often while running YSQL tests with TSAN. The fix is simple:\r\n\r\n```\r\n                    if self.args.terminate_subtree:\r\n                        try:\r\n                            os.kill(process.pid, signal.SIGKILL)\r\n                            killed_pids.append(process.pid)\r\n                        except ProcessLookupError:\r\n                            logging.info(\"Child pid %d seems to have terminated on its own\", pid)\r\n```\n\n[DB-5371]: https://yugabyte.atlassian.net/browse/DB-5371?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/15962/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/15962/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":8485515447,"node_id":"CE_lADOBlCVUc5SQaWZzwAAAAH5xrC3","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/8485515447","actor":{"login":"hari90","id":12418230,"node_id":"MDQ6VXNlcjEyNDE4MjMw","avatar_url":"https://avatars.githubusercontent.com/u/12418230?v=4","gravatar_id":"","url":"https://api.github.com/users/