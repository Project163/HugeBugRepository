+    return GetConvolutionCustomCallConfigs(
+        custom_call_instr, custom_call_instr->GetModule(), stream_executor(),
+        /* stream */ nullptr);
+  }
   return std::vector<std::unique_ptr<BackendConfig>>();
 }
 
