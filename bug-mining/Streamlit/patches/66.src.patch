+# Copyright 2019 Streamlit Inc. All rights reserved.
+# -*- coding: utf-8 -*-
+
+"""st.caching unit tests."""
+
+import unittest
+
+import streamlit as st
+
+
+class CacheTest(unittest.TestCase):
+    def test_args(self):
+        called = [False]
+
+        @st.cache
+        def f(x):
+            called[0] = True
+            return x
+
+        self.assertFalse(called[0])
+        f(0)
+
+        self.assertTrue(called[0])
+
+        called = [False]  # Reset called
+
+        f(0)
+        self.assertFalse(called[0])
+
+        f(1)
+        self.assertTrue(called[0])
