@@ -1979,6 +2000,22 @@ YbBindScanKeys(YbScanDesc ybScan, YbScanPlan scan_plan, bool is_for_precheck)
 					end[idx] = key->sk_argument;
 					end_inclusive[idx] = bound_inclusive;
 					end_valid[idx] = true;
+					end_cmp_fn[idx] = &key->sk_func;
+				}
+
+				if (start_valid[idx])
