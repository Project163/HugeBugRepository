url":"https://api.github.com/repos/streamlit/streamlit/labels{/name}","releases_url":"https://api.github.com/repos/streamlit/streamlit/releases{/id}","deployments_url":"https://api.github.com/repos/streamlit/streamlit/deployments","created_at":"2019-08-24T00:14:52Z","updated_at":"2025-12-13T03:51:18Z","pushed_at":"2025-12-13T01:35:43Z","git_url":"git://github.com/streamlit/streamlit.git","ssh_url":"git@github.com:streamlit/streamlit.git","clone_url":"https://github.com/streamlit/streamlit.git","svn_url":"https://github.com/streamlit/streamlit","homepage":"https://streamlit.io","size":797696,"stargazers_count":42660,"watchers_count":42660,"language":"Python","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":3962,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1304,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["data-analysis","data-science","data-visualization","deep-learning","developer-tools","machine-learning","python","streamlit"],"visibility":"public","forks":3962,"open_issues":1304,"watchers":42660,"default_branch":"develop","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/streamlit/streamlit/pulls/3863","html_url":"https://github.com/streamlit/streamlit/pull/3863","diff_url":"https://github.com/streamlit/streamlit/pull/3863.diff","patch_url":"https://github.com/streamlit/streamlit/pull/3863.patch","merged_at":"2021-10-21T03:29:20Z"},"body":"---\r\n\r\n**Issue:** https://github.com/streamlit/streamlit/issues/3839\r\n\r\n**Description:** All Streamlit widgets and elements fade when the app is rerun. Now `st.expander` also fades.\r\n\r\nThe issue existed because there was no code present that faded on `isStale` for `st.expander`.\r\n\r\n To get around that, the simplest way to go would be adding the fade css on the outermost div for `st.expander` but since the `st.write` inside did fade from the beginning, this resulted in `st.write` fading twice essentially. \r\n\r\n**Irregular Fade:**\r\n<img width=\"1392\" alt=\"Screenshot 2021-09-28 at 11 35 27 PM\" src=\"https://user-images.githubusercontent.com/8018018/135161279-327bcfe3-14ed-494e-9aa0-76205896936b.png\">\r\n\r\nHence, the header section of `st.expander` and the border both separately got added an `isStale` css snippet to solve the issue. \r\n\r\n**Final Result:**\r\n<img width=\"1392\" alt=\"Screenshot 2021-09-29 at 1 42 44 AM\" src=\"https://user-images.githubusercontent.com/8018018/135161096-8f1d4e9b-300e-4e53-a827-3daf8586435b.png\">\r\n<img width=\"1392\" alt=\"Screenshot 2021-09-29 at 1 42 55 AM\" src=\"https://user-images.githubusercontent.com/8018018/135161118-ac6211de-3a1d-4fc8-8844-e6b5428c256d.png\">\r\n\r\n---\r\n","reactions":{"url":"https://api.github.com/repos/streamlit/streamlit/issues/3863/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/streamlit/streamlit/issues/3863/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":5426120084,"node_id":"UNLE_lADODCoeTs478aENzwAAAAFDbAWU","url":"https://api.github.com/repos/streamlit/streamlit/issues/events/5426120084","actor":{"login":"vdonato","id":3144420,"node_id":"MDQ6VXNlcjMxNDQ0MjA=","avatar_url":"https://avatars.githubusercontent.com/u/3144420?v=4","gravatar_id":"","url":"https://api.github.com/users/vdonato","html_url":"https://github.com/vdonato","followers_url":"https://api.github.com/users/vdonato/followers","following_url":"https://api.github.com/users/vdonato/following{/other_user}","gists_url":"https://api.github.com/users/vdonato/gists{/gist_id}","starred_url":"