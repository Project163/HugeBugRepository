pi.github.com/users/katre/followers","following_url":"https://api.github.com/users/katre/following{/other_user}","gists_url":"https://api.github.com/users/katre/gists{/gist_id}","starred_url":"https://api.github.com/users/katre/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/katre/subscriptions","organizations_url":"https://api.github.com/users/katre/orgs","repos_url":"https://api.github.com/users/katre/repos","events_url":"https://api.github.com/users/katre/events{/privacy}","received_events_url":"https://api.github.com/users/katre/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/240252907","html_url":"https://github.com/bazelbuild/bazel/issues/1592#issuecomment-240252907","issue_url":"https://api.github.com/repos/bazelbuild/bazel/issues/1592","id":240252907,"node_id":"MDEyOklzc3VlQ29tbWVudDI0MDI1MjkwNw==","user":{"login":"katre","id":326527,"node_id":"MDQ6VXNlcjMyNjUyNw==","avatar_url":"https://avatars.githubusercontent.com/u/326527?v=4","gravatar_id":"","url":"https://api.github.com/users/katre","html_url":"https://github.com/katre","followers_url":"https://api.github.com/users/katre/followers","following_url":"https://api.github.com/users/katre/following{/other_user}","gists_url":"https://api.github.com/users/katre/gists{/gist_id}","starred_url":"https://api.github.com/users/katre/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/katre/subscriptions","organizations_url":"https://api.github.com/users/katre/orgs","repos_url":"https://api.github.com/users/katre/repos","events_url":"https://api.github.com/users/katre/events{/privacy}","received_events_url":"https://api.github.com/users/katre/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-08-16T21:59:06Z","updated_at":"2016-08-16T21:59:06Z","body":"I've written a shell test that catches this error, and debugged through the PackageFunction, PackageLookupFunction, and LocalRepositoryFunction code that is involved. I'm not sure we have enough data to catch this currently.\n\nCurrently, we have a mapping of \"repository name\"->\"repository directory\" which is used to load the package. In order to catch this case, we'd need the reverse mapping, and we'd have to check it for every package (which means a lot more skyframe nodes to cache the data).\n\nWould it be acceptable to simply disallow local_repository for a path that is a child of the workspace? If that was the case, then the example above would be an error (in the local_repository rule), but the case where your local_repository is outside the workspace (and which seems to be the more common usecase) would be fine.\n\nIn the documentation for local_repository, we're already requiring (although not enforcing) that this be an absolute path: http://bazel.io/docs/be/workspace.html#local_repository\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/240252907/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"katre","id":326527,"node_id":"MDQ6VXNlcjMyNjUyNw==","avatar_url":"https://avatars.githubusercontent.com/u/326527?v=4","gravatar_id":"","url":"https://api.github.com/users/katre","html_url":"https://github.com/katre","followers_url":"https://api.github.com/users/katre/followers","following_url":"https://api.github.com/users/katre/following{/other_user}","gists_url":"https://api.github.com/users/katre/gists{/gist_id}","starred_url":"https://api.github.com/users/katre/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/katre/subscriptions","organizations_url":"https://api.github.com/users/katre/orgs","repos_url":"https://api.github.com/users/katre/repos","events_url":"https://api.github.com/users/katre/events{/privacy}","received_events_url":"https://api.github.com/users/katre/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/240431912","html_url":"https://github.com/bazelbuild/bazel/issues/1592#issuecomment-240431912","issue_url":"https://api.github.com/repos/bazelbuild/bazel/issues/1592","id":240431912,"node_id":"MDEyOklzc3VlQ29tbWVudDI0MDQzMTkxMg==","user":{"login":"kchodorow","id":17042,"node_id":"MDQ6VXNlcjE3MDQy","avatar_url":"https://avatars.githubusercontent.com/u/17042?v=4","gravatar_id":"","url":"https://api.github.com/users/kchodorow","html_url":"https://github.com/kchodorow","followers_url":"https://api.github.com/users/kchodorow/followers","following_url":"https://api.github.com/users/kchodorow/following{/other_user}","gists_url":"https://api.github.com/users/kchodorow/gists{/gist_id}","starred_url":"https://api.github.com/users/kchodorow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kchodorow/subscriptions","organizations_url":"https://api.github.com/users/kchodorow/orgs","repos_url":"https://api.github.com/users/kchodorow/repos","events_url":"https://api.github.com/users/kchodorow/events{/privacy}","received_events_url":"https://api.github.com/users/kchodorow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-08-17T14:36:14Z","updated_at":"2016-08-17T14:36:14Z","body":"Keeping repository directory->repo name mapping seems like the most reasonable solution to me: we can generate it when the WORKSPACE file is parsed and I don't think it would be too many more skyframe nodes. One other thought is that ContainingPackageLookupFunction.java already does something sort of similar, perhaps we could hook in there without too much of a performance penalty?\n\nOne part of this that might be easier/sufficient-for-now is to forbid //... (and globbing **) from descending into workspaces.\n\nThe documentation is out 