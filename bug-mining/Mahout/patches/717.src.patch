-            updater.update(currentEigen, corpus.viewRow(corpusRow), state);
-          }
-        }
-        state.setFirstPass(false);
-        if (DEBUG) {
-          if (previousEigen == null) {
-            previousEigen = currentEigen.clone();
-          } else {
