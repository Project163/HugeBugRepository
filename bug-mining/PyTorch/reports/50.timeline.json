ch/labels{/name}","releases_url":"https://api.github.com/repos/pytorch/pytorch/releases{/id}","deployments_url":"https://api.github.com/repos/pytorch/pytorch/deployments","created_at":"2016-08-13T05:26:41Z","updated_at":"2026-03-11T11:23:33Z","pushed_at":"2026-03-11T11:24:59Z","git_url":"git://github.com/pytorch/pytorch.git","ssh_url":"org-21003710@github.com:pytorch/pytorch.git","clone_url":"https://github.com/pytorch/pytorch.git","svn_url":"https://github.com/pytorch/pytorch","homepage":"https://pytorch.org","size":1267772,"stargazers_count":98201,"watchers_count":98201,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":27143,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":18135,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["autograd","deep-learning","gpu","machine-learning","neural-network","numpy","python","tensor"],"visibility":"public","forks":27143,"open_issues":18135,"watchers":98201,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/pytorch/pytorch/pulls/82833","html_url":"https://github.com/pytorch/pytorch/pull/82833","diff_url":"https://github.com/pytorch/pytorch/pull/82833.diff","patch_url":"https://github.com/pytorch/pytorch/pull/82833.patch","merged_at":"2022-08-24T20:04:22Z"},"body":"### Description\r\nThe PR fixes the issue #81409. To fix the issue the procedure of determining start and end indices for adaptive max pooling and average pooling is modified towards integer-only arithmetic. \r\n\r\n### Testing\r\nThe testing of the new functions is straightforward:\r\n\r\n```\r\n#include <iostream>\r\n#include <cassert>\r\n#include <cmath>\r\n\r\nint64_t start_index(int64_t a, int64_t b, int64_t c) {\r\n  return (int64_t)std::floor((float)(a * c) / b);\r\n}\r\n\r\nint64_t end_index(int64_t a, int64_t b, int64_t c) {\r\n  return (int64_t)std::ceil((float)((a + 1) * c) / b);\r\n}\r\n\r\n\r\nint64_t start_index_new(int64_t a, int64_t b, int64_t c) {\r\n  return (a * c) / b;\r\n}\r\n\r\nint64_t end_index_new(int64_t a, int64_t b, int64_t c) {\r\n  return 1 + ((a + 1) * c - 1) / b;\r\n}\r\n\r\n\r\nint main() {\r\n    size_t N = 2<<24;\r\n    std::cout<<N<<'\\n';\r\n    int64_t c = 1;\r\n\r\n    for(int64_t i=1; i<N; i++) {\r\n        for(int64_t j=1; j<N; j++) {\r\n            int64_t s_id0 = start_index(i, j, c);\r\n            int64_t s_id1 = start_index_new(i, j, c);\r\n            assert(s_id0 == s_id1);\r\n        }\r\n    }\r\n\r\n    for(int64_t i=1; i<N; i++) {\r\n        for(int64_t j=1; j<N; j++) {\r\n            int64_t e_id0 = end_index(i, j, c);\r\n            int64_t e_id1 = end_index_new(i, j, c);\r\n            assert(e_id0 == e_id1);\r\n        }\r\n    }\r\n}\r\n``` \r\n\r\n","reactions":{"url":"https://api.github.com/repos/pytorch/pytorch/issues/82833/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/pytorch/pytorch/issues/82833/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"actor":{"login":"Aidyn-A","id":31858918,"node_id":"MDQ6VXNlcjMxODU4OTE4","avatar_url":"https://avatars.githubusercontent.com/u/31858918?v=4","gravatar_id":"","url":"https://api.github.com/users/Aidyn-A","html_url":"https://github.com/Aidyn-A","followers_url":"https://api.github.com/users/Aidyn-A/followers","following_url":"https://api.github.com/users/Aidyn-A/following{/other_user}","gists_url":"https://api.github.com/users/Aidyn-A/gists{/gist_id}","starred_url":"https://api.github.com/users/Aidyn-A/starred{/owner}{/repo}","subscriptions_url":"https