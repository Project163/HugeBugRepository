lse\r\n\r\n[character]\r\nsuccess_symbol = \"[➜](bold green)\"\r\nerror_symbol = \"[➜](bold red)\"\r\n```\r\n","reactions":{"url":"https://api.github.com/repos/starship/starship/issues/1916/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/starship/starship/issues/1916/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]