&lt;p&gt;    &lt;a href=&quot;https://github.com/apache/incubator-zeppelin/pull/485&quot; class=&quot;external-link&quot; target=&quot;_blank&quot; rel=&quot;nofollow noopener&quot;&gt;https://github.com/apache/incubator-zeppelin/pull/485&lt;/a&gt;&lt;/p&gt;

&lt;p&gt;    &lt;a href=&quot;https://issues.apache.org/jira/browse/ZEPPELIN-469&quot; title=&quot;Interpreter process loads unnecessary classes&quot; class=&quot;issue-link&quot; data-issue-key=&quot;ZEPPELIN-469&quot;&gt;&lt;del&gt;ZEPPELIN-469&lt;/del&gt;&lt;/a&gt; Interpreter process loads unnecessary classes&lt;/p&gt;

&lt;p&gt;    Addresses issue &lt;a href=&quot;https://issues.apache.org/jira/browse/ZEPPELIN-469&quot; class=&quot;external-link&quot; rel=&quot;nofollow&quot;&gt;https://issues.apache.org/jira/browse/ZEPPELIN-469&lt;/a&gt;&lt;/p&gt;

