                            <comment id="16655038" author="ignitetcbot" created="Thu, 18 Oct 2018 10:46:02 +0000"  >&lt;div class=&quot;panel&quot; style=&quot;border-color: #ccc;border-style: dashed;border-width: 1px;&quot;&gt;&lt;div class=&quot;panelHeader&quot; style=&quot;border-bottom-width: 1px;border-bottom-style: dashed;border-bottom-color: #ccc;background-color: #D6F7C1;&quot;&gt;&lt;b&gt;No blockers found!&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;
