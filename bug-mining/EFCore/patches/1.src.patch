+        public int OrderId { get; set; }
+        public OrderItemType Type { get; set; }
+        public double Price { get; set; }
+    }
+
+    protected enum OrderItemType
+    {
+        Undefined = 0,
+        MyType1 = 1,
+        MyType2 = 2
+    }
 }
