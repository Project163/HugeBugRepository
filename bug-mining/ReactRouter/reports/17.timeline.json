ls{/name}","releases_url":"https://api.github.com/repos/remix-run/react-router/releases{/id}","deployments_url":"https://api.github.com/repos/remix-run/react-router/deployments","created_at":"2014-05-16T22:22:51Z","updated_at":"2025-12-12T17:24:42Z","pushed_at":"2025-12-12T16:06:45Z","git_url":"git://github.com/remix-run/react-router.git","ssh_url":"git@github.com:remix-run/react-router.git","clone_url":"https://github.com/remix-run/react-router.git","svn_url":"https://github.com/remix-run/react-router","homepage":"https://reactrouter.com","size":44323,"stargazers_count":56017,"watchers_count":56017,"language":"TypeScript","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":10809,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":145,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":[],"visibility":"public","forks":10809,"open_issues":145,"watchers":56017,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"In react router 1.0 the plus sign now seems to be decoded to whitespace in paths.  The plus sign is only supposed to be decoded in query parameters, not in paths.  This is a regression from earlier versions.\n","reactions":{"url":"https://api.github.com/repos/remix-run/react-router/issues/2426/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/remix-run/react-router/issues/2426/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/remix-run/react-router/issues/comments/152647383","html_url":"https://github.com/remix-run/react-router/issues/2407#issuecomment-152647383","issue_url":"https://api.github.com/repos/remix-run/react-router/issues/2407","id":152647383,"node_id":"MDEyOklzc3VlQ29tbWVudDE1MjY0NzM4Mw==","user":{"login":"mjackson","id":92839,"node_id":"MDQ6VXNlcjkyODM5","avatar_url":"https://avatars.githubusercontent.com/u/92839?v=4","gravatar_id":"","url":"https://api.github.com/users/mjackson","html_url":"https://github.com/mjackson","followers_url":"https://api.github.com/users/mjackson/followers","following_url":"https://api.github.com/users/mjackson/following{/other_user}","gists_url":"https://api.github.com/users/mjackson/gists{/gist_id}","starred_url":"https://api.github.com/users/mjackson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mjackson/subscriptions","organizations_url":"https://api.github.com/users/mjackson/orgs","repos_url":"https://api.github.com/users/mjackson/repos","events_url":"https://api.github.com/users/mjackson/events{/privacy}","received_events_url":"https://api.github.com/users/mjackson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-10-30T20:46:39Z","updated_at":"2015-10-30T20:46:39Z","body":"You're right, we should be using `%20` in the pathname portion of the URL. We already have [a test](https://github.com/rackt/react-router/blob/e2a979e08fcbb4c253bf351b1b2f0a71fa522bca/modules/__tests__/formatPattern-test.js#L60) that appears to be testing the wrong thing.\n\nI'd like to use `+` instead of `%20` in the query string. From [the URI spec](http://www.w3.org/Addressing/URL/uri-spec.html):\n\n> Within the query string, the plus sign is reserved as shorthand notation for a space. Therefore, real plus signs must be encoded. This method was used to make query URIs easier to pass in systems which did not allow spaces.\n\nBut that logic belongs in the history package (i.e. useQueries), not here.\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/remix-run/react-router/issues/comments/152647383/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"mjackson","id":92839,"node_id":"MDQ6VXNlcjkyODM5","avatar_url":"https://avatars.githubusercontent.com/u/92839?v=4","gravatar_id":"","url":"https://api.github.com/users/mjackson","html_url":"https://github.com/mjackson","followers_url":"https://api.github.com/users/mjackson/followers","following_url":"https://api.github.com/users/mjackson/following{/other_user}","gists_url":"https://api.github.com/users/mjackson/gists{/gist_id}","starred_url":"https://api.github.com/users/mjackson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mjackson/subscriptions","organizations_url":"https://api.github.com/users/mjackson/orgs","repos_url":"https://api.github.com/users/mjackson/repos","events_url":"https://api.github.com/users/mjackson/events{/privacy}","received_events_url":"https://api.github.com/users/mjackson/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":450837294,"node_id":"MDExOkNsb3NlZEV2ZW50NDUwODM3Mjk0","url":"https://api.github.com/repos/remix-run/react-router/issues/events/450837294","actor":{"login":"mjackson","id":92839,"node_id":"MDQ6VXNlcjkyODM5","avatar_url":"https://avatars.githubusercontent.com/u/92839?v=4","gravatar_id":"","url":"https://api.github.com/users/mjackson","html_url":"https://github.com/mjackson","followers_url":"https://api.github.com/users/mjackson/followers","following_url":"https://api.github.com/users/mjackson/following{/other_user}","gists_url":"https://api.github.com/users/mjackson/gists{/gist_id}","starred_url":"https://api.github.com/users/mjackson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mjackson/subscriptions","organizations_url":"https://api.github.com/users/mjackson/orgs","repos_url":"https://api.github.com/users/mjackson/repos","events_url":"https://api.github.com/users/mjackson/events{/privacy}","received_events_url":"https://api.github.com/users/mjackson/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":"fbc109c0218508a301caae36469c8fc5d70de5fa","commit_url":"https://api.github.com/repos/remix-run/react-router/commits/fbc109c0218508a301caae36469c8fc5d70de5fa","created_at":"2015-10-30T20:47:47Z","state_reason":null,"performed_via_github_app":null},{"url":"https://api.github.com/repos/remix-run/react-router/issues/comments/167168916","html_url":"https://github.com/remix-run/react-router/issues/2407#issuecomment-167168916","issue_url":"https://api.github.com/repos/remix-run/react-router/issues/2407","id":167168916,"node_id":"MDEyOklzc3VlQ29tbWVudDE2NzE2ODkxNg==","user":{"login":"Download","id":153391,"node_id":"MDQ6VXNlcjE1MzM5MQ==","avatar_url":"https://avatars.githubusercontent.com/u/153391?v=4","gravatar_id":"","url":"https://api.github.com/users/Download","html_url":"https://github.com/Download","followers_url":"https://api.github.com/users/Download/followers","following_url":"https://api.github.com/users/Download/following{/other_user}","gists_url":"https://api.github.com/users/Download/gists{/gist_id}","starred_url":"https://api.github.com/users/Download/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Download/subscriptions","organizations_url":"https://api.github.com/users/Download/orgs","repos_url":"https://api.github.com/users/Download/repos","events_url":"https://api.github.com/users/Download/events{/privacy}","received_events_url":"https://api.github.com/users/Download/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-12-24T23:54:06Z","updated_at":"2015-12-24T23:54:06Z","body":"I have a route like this:\n\n``` xml\n<Route path=\"near/:city\" component={StoresNear} />\n```\n\nIn `StoresNear`, I print the `:city` parameter, like this:\n\n``` xml\n<h2>Stores near {this.props.params.city}</h2>\n```\n\nI enter this URL into the address bar of the browser:\n\n`http://localhost:8080/near/My+City`\n\nI then get this header:\n\n> Stores near My+City\n\nIf I change the URL to use a percent-encoded space\n\n`http://localhost:8080/near/My%20City`\n\nit works:\n\n> Stores near My City\n\n**Question:**\nIs this expected behavior? I have been reading this bug report, as well as [this old one](https://github.com/rackt/react-router/issues/716) and [this more recent one](https://github.com/rackt/react-router/issues/2426), but I can't figure it out.\n\nI didn't want to create a new issue so I hope you guys don't mind me reviving this one.\n\nTo me it feels like a bug that the plus symbol does not get decoded, but it might be a feature? I don't get it though because afaik, all servers will decode it to space...\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/remix-run/react-router/issues/comments/167168916/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Download","id":153391,"node_id":"MDQ6VXNlcjE1MzM5MQ==","avatar_url":"https://avatars.githubusercontent.com/u/153391?v=4","gravatar_id":"","url":"https://api.github.com/users/Download","html_url":"https://github.com/Download","followers_url":"https://api.github.com/users/Download/followers","following_url":"https://api.github.com/users/Download/following{/other_user}","gists_url":"https://api.github.com/users/Download/gists{/gist_id}","starred_url":"https://api.github.com/users/Download/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Download/subscriptions","organizations_url":"https://api.github.com/users/Download/orgs","repos_url":"https://api.github.com/users/Download/repos","events_url":"https://api.github.com/users/Download/events{/privacy}","received_events_url":"https://api.github.com/users/Download/received_events","ty