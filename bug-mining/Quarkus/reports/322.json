s/43/labels","id":4810978,"node_id":"MDk6TWlsZXN0b25lNDgxMDk3OA==","number":43,"title":"1.1.0.CR1","description":"","creator":{"login":"Sanne","id":42573,"node_id":"MDQ6VXNlcjQyNTcz","avatar_url":"https://avatars.githubusercontent.com/u/42573?v=4","gravatar_id":"","url":"https://api.github.com/users/Sanne","html_url":"https://github.com/Sanne","followers_url":"https://api.github.com/users/Sanne/followers","following_url":"https://api.github.com/users/Sanne/following{/other_user}","gists_url":"https://api.github.com/users/Sanne/gists{/gist_id}","starred_url":"https://api.github.com/users/Sanne/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sanne/subscriptions","organizations_url":"https://api.github.com/users/Sanne/orgs","repos_url":"https://api.github.com/users/Sanne/repos","events_url":"https://api.github.com/users/Sanne/events{/privacy}","received_events_url":"https://api.github.com/users/Sanne/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":378,"state":"closed","created_at":"2019-11-04T09:29:45Z","updated_at":"2020-02-03T17:11:20Z","due_on":null,"closed_at":"2019-12-10T18:58:25Z"},"comments":2,"created_at":"2019-11-07T14:19:53Z","updated_at":"2019-11-15T12:03:45Z","closed_at":"2019-11-08T19:02:51Z","author_association":"MEMBER","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**Describe the bug**\r\nThe `io.quarkus.dynamodb.deployment.DynamodbProcessor` class accesses `io.quarkus.dynamodb.runtime.DynamodbConfig` from non-recorder steps.  The run time configuration is not normally available during build and this functionality will fail in upcoming releases.  Run time configuration must be checked at run time only.  Build time configuration must be defined as a build time configuration object.\r\n\r\n**Fix options**\r\n1. Change `io.quarkus.dynamodb.runtime.DynamodbConfig` to have a phase of `ConfigPhase#BUILD_AND_RUN_TIME_FIXED`.\r\n2. Skip the check in `io.quarkus.dynamodb.deployment.DynamodbProcessor#setup` and possibly do the check at run time instead.\r\n3. After the config update is merged, go back and use the various built-in validation constructs (optional and required properties and config groups) to validate instead of using an explicit check method\r\n\r\n/cc @marcinczeczko\r\n","closed_by":{"login":"dmlloyd","id":124581,"node_id":"MDQ6VXNlcjEyNDU4MQ==","avatar_url":"https://avatars.githubusercontent.com/u/124581?v=4","gravatar_id":"","url":"https://api.github.com/users/dmlloyd","html_url":"https://github.com/dmlloyd","followers_url":"https://api.github.com/users/dmlloyd/followers","following_url":"https://api.github.com/users/dmlloyd/following{/other_user}","gists_url":"https://api.github.com/users/dmlloyd/gists{/gist_id}","starred_url":"https://api.github.com/users/dmlloyd/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dmlloyd/subscriptions","organizations_url":"https://api.github.com/users/dmlloyd/orgs","repos_url":"https://api.github.com/users/dmlloyd/repos","events_url":"https://api.github.com/users/dmlloyd/events{/privacy}","received_events_url":"https://api.github.com/users/dmlloyd/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/5286/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/quarkusio/quarkus/issues/5286/timeline","performed_via_github_app":null,"state_reason":"completed"}