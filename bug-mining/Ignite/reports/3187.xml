<item>
            <title>[IGNITE-7879] SQL query with group by and distinct in subquery produces JdbcSQLException</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-7879</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;SQL initial script:&lt;/p&gt;

&lt;p&gt;CREATE TABLE Person(id INTEGER PRIMARY KEY, company_id INTEGER);&lt;br/&gt;
CREATE TABLE Company(id INTEGER PRIMARY KEY, name VARCHAR);&lt;br/&gt;
INSERT INTO Person(id,company_id) VALUES (1, 1), (2, 2), (3, 3);&lt;br/&gt;
INSERT INTO Company(id,name) VALUES (1,&apos;n1&apos;), (2,&apos;n2&apos;), (3,&apos;n3&apos;);&lt;/p&gt;

&lt;p&gt;SQL query:&lt;/p&gt;

&lt;p&gt;SELECT p.id,sum(p.id) FROM person p&lt;br/&gt;
LEFT JOIN (select DISTINCT id from company) as c on c.id=p.company_id&lt;br/&gt;
group by p.id&lt;/p&gt;

&lt;p&gt;Result:&lt;/p&gt;

&lt;p&gt;Caused by: org.h2.jdbc.JdbcSQLException: Column &quot;P__Z0.ID&quot; must be in the GROUP BY list; SQL statement:&lt;br/&gt;
SELECT&lt;br/&gt;
P__Z0.ID __C0_0,&lt;br/&gt;
P__Z0.COMPANY_ID __C0_1,&lt;br/&gt;
SUM(P__Z0.ID) __C0_2&lt;br/&gt;
FROM PUBLIC.PERSON P__Z0 &lt;span class=&quot;error&quot;&gt;&amp;#91;90016-195&amp;#93;&lt;/span&gt;&lt;/p&gt;

&lt;p&gt;&#160;&lt;/p&gt;

&lt;p&gt;&#160;&lt;/p&gt;</description>
