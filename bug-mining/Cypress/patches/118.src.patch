diff --git a/packages/server/lib/util/terminal-size.js b/packages/server/lib/util/terminal-size.js
new file mode 100644
index 0000000000..b32f4cdd28
--- /dev/null
+++ b/packages/server/lib/util/terminal-size.js
@@ -0,0 +1,17 @@
+const termSize = require('term-size')
+const env = require('./env')
+
+const get = () => {
+  const obj = termSize()
+
+  if (env.get('CI')) {
+    // reset to 100
+    obj.columns = 100
+  }
+
+  return obj
+}
+
+module.exports = {
+  get,
+}
