":"https://api.github.com/repos/webpack/webpack/issues{/number}","pulls_url":"https://api.github.com/repos/webpack/webpack/pulls{/number}","milestones_url":"https://api.github.com/repos/webpack/webpack/milestones{/number}","notifications_url":"https://api.github.com/repos/webpack/webpack/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/webpack/webpack/labels{/name}","releases_url":"https://api.github.com/repos/webpack/webpack/releases{/id}","deployments_url":"https://api.github.com/repos/webpack/webpack/deployments","created_at":"2012-03-10T10:08:14Z","updated_at":"2025-12-12T13:58:30Z","pushed_at":"2025-12-12T20:40:56Z","git_url":"git://github.com/webpack/webpack.git","ssh_url":"git@github.com:webpack/webpack.git","clone_url":"https://github.com/webpack/webpack.git","svn_url":"https://github.com/webpack/webpack","homepage":"https://webpack.js.org","size":75289,"stargazers_count":65817,"watchers_count":65817,"language":"JavaScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":9188,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":210,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["amd","build-tool","commonjs","compiler","es2015","es6","esm","javascript","javascript-compiler","javascript-modules","loaders","module-bundler","plugins","web","web-performance","webpack"],"visibility":"public","forks":9188,"open_issues":210,"watchers":65817,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Hello,\r\n\r\nI have an entryjs where jQuery and Bootstrap is imported.\r\n\r\nThis is the old require mechanism which is working fine:\r\n```\r\n'use strict';\r\n\r\nwindow.$ = window.jQuery = require('jquery');\r\n\r\nrequire(\"bootstrap-sass/assets/javascripts/bootstrap.min.js\");\r\nrequire(\"bootstrap-sass/assets/stylesheets/_bootstrap.scss\");\r\n```\r\n\r\nWebpack generates this code:\r\n\r\n```\r\n/***/ 14:\r\n/* unknown exports provided */\r\n/* all exports used */\r\n/*!******************************!*\\\r\n  !*** ./src/entries/basic.js ***!\r\n  \\******************************/\r\n/***/ (function(module, exports, __webpack_require__) {\r\n\r\n\"use strict\";\r\n\r\n\r\nwindow.$ = window.jQuery = __webpack_require__(/*! jquery */ 8);\r\n\r\n__webpack_require__(/*! bootstrap-sass/assets/javascripts/bootstrap.min.js */ 6);\r\n__webpack_require__(/*! bootstrap-sass/assets/stylesheets/_bootstrap.scss */ 7);\r\n\r\n/***/ }),\r\n```\r\n\r\nIf i convert my entry.js to the new ES6 import syntax bootstrap.min.js complains that there is no jQuery.\r\n\r\n```\r\nimport * as jQuery from 'jquery';\r\n\r\nconsole.log(jQuery);\r\n\r\nwindow.$ = window.jQuery = jQuery;\r\n\r\nimport 'bootstrap-sass/assets/javascripts/bootstrap.min.js';\r\nimport 'bootstrap-sass/assets/stylesheets/_bootstrap.scss';\r\n```\r\n\r\n```\r\n/***/ 14:\r\n/* unknown exports provided */\r\n/* all exports used */\r\n/*!******************************!*\\\r\n  !*** ./src/entries/basic.js ***!\r\n  \\******************************/\r\n/***/ (function(module, __webpack_exports__, __webpack_require__) {\r\n\r\n\"use strict\";\r\nObject.defineProperty(__webpack_exports__, \"__esModule\", { value: true });\r\n/* harmony import */ var __WEBPACK_IMPORTED_MODULE_0_jquery__ = __webpack_require__(/*! jquery */ 8);\r\n/* harmony import */ var __WEBPACK_IMPORTED_MODULE_0_jquery___default = __webpack_require__.n(__WEBPACK_IMPORTED_MODULE_0_jquery__);\r\n/* harmony import */ var __WEBPACK_IMPORTED_MODULE_1_bootstrap_sass_assets_javascripts_bootstrap_min_js__ = __webpack_require__(/*! bootstrap-sass/assets/javascripts/bootstrap.min.js */ 6);\r\n/* harmony import */ var __WEBPACK_IMPORTED_MODULE_1_bootstrap_sass_assets_javascripts_bootstrap_min_js___default = __webpack_require__.n(__WEBPACK_IMPORTED_MODULE_1_bootstrap_sass_assets_javascripts_bootstrap_min_js__);\r\n/* harmony import */ var __WEBPACK_IMPORTED_MODULE_2_bootstrap_sass_assets_stylesheets_bootstrap_scss__ = __webpack_require__(/*! bootstrap-sass/assets/stylesheets/_bootstrap.scss */ 7);\r\n/* harmony import */ var __WEBPACK_IMPORTED_MODULE_2_bootstrap_sass_assets_stylesheets_bootstrap_scss___default = __webpack_require__.n(__WEBPACK_IMPORTED_MODULE_2_bootstrap_sass_assets_stylesheets_bootstrap_scss__);\r\n\r\n\r\nconsole.log(__WEBPACK_IMPORTED_MODULE_0_jquery__);\r\n\r\nwindow.$ = window.jQuery = __WEBPACK_IMPORTED_MODULE_0_jquery__;\r\n\r\n/***/ }),\r\n```\r\n\r\nThe problem is that the ordering in the entry.js file is not respected. Bootstrap is required before jQuery is added to the window object.","reactions":{"url":"https://api.github.com/repos/webpack/webpack/issues/4120/reactions","total_count":8,"+1":8,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/webpack/webpack/issues/4120/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]