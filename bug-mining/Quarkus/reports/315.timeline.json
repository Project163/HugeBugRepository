,participating}","labels_url":"https://api.github.com/repos/redhat-developer/vscode-quarkus/labels{/name}","releases_url":"https://api.github.com/repos/redhat-developer/vscode-quarkus/releases{/id}","deployments_url":"https://api.github.com/repos/redhat-developer/vscode-quarkus/deployments","created_at":"2019-06-19T14:36:00Z","updated_at":"2025-12-09T13:35:00Z","pushed_at":"2025-12-11T13:55:28Z","git_url":"git://github.com/redhat-developer/vscode-quarkus.git","ssh_url":"git@github.com:redhat-developer/vscode-quarkus.git","clone_url":"https://github.com/redhat-developer/vscode-quarkus.git","svn_url":"https://github.com/redhat-developer/vscode-quarkus","homepage":"https://quarkus.io","size":22973,"stargazers_count":75,"watchers_count":75,"language":"TypeScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":31,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":70,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":[],"visibility":"public","forks":31,"open_issues":70,"watchers":75,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/redhat-developer/vscode-quarkus/pulls/135","html_url":"https://github.com/redhat-developer/vscode-quarkus/pull/135","diff_url":"https://github.com/redhat-developer/vscode-quarkus/pull/135.diff","patch_url":"https://github.com/redhat-developer/vscode-quarkus/pull/135.patch","merged_at":"2019-11-06T18:16:44Z"},"body":"Fixes #112 \r\n\r\nTo test, create a Gradle project using the Quarkus Maven plugin as explained in [the guide](https://quarkus.io/guides/gradle-tooling#project-creation):\r\n```\r\nmvn io.quarkus:quarkus-maven-plugin:0.28.1:create \\\r\n    -DprojectGroupId=my-groupId \\\r\n    -DprojectArtifactId=my-artifactId \\\r\n    -DprojectVersion=my-version \\\r\n    -DclassName=\"org.my.group.MyResource\" \\\r\n    -Dextensions=\"resteasy-jsonb\" \\\r\n    -DbuildTool=gradle\r\n```\r\n\r\nOpen the Gradle project in vscode\r\nCall the `Add extensions to current project` command in the command palette\r\nChoose extension(s). (I'm not sure if multiple extensions will work yet, they've made the fix recently: https://github.com/quarkusio/quarkus/issues/5224)\r\nThe command to add extension(s) should run in the terminal.\r\n\r\nIf Gradle wrapper exists, Gradle wrapper will be used for the command.\r\n\r\nI have 13 commits for the PR for now, I will squash them into one when we are sure  everything works. \r\n\r\nI did not test this on Windows yet.","reactions":{"url":"https://api.github.com/repos/redhat-developer/vscode-quarkus/issues/135/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/redhat-developer/vscode-quarkus/issues/135/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":2799801095,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDI3OTk4MDEwOTU=","url":"https://api.github.com/repos/quarkusio/quarkus/issues/events/2799801095","actor":{"login":"gsmet","id":1279749,"node_id":"MDQ6VXNlcjEyNzk3NDk=","avatar_url":"https://avatars.githubusercontent.com/u/1279749?v=4","gravatar_id":"","url":"https://api.github.com/users/gsmet","html_url":"https://github.com/gsmet","followers_url":"https://api.github.com/users/gsmet/followers","following_url":"https://api.github.com/users/gsmet/following{/other_user}","gists_url":"https://api.github.com/users/gsmet/gists{/gist_id}","starred_url":"https://api.github.com/users/gsmet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gsmet/subscriptions","organizations_url":"https://api.github.com/users/gsmet/or