e, currently, after running:\r\n```\r\npostgres=# create table foo(a int);\r\nCREATE TABLE\r\npostgres=# alter table foo rename to bar;\r\nALTER TABLE\r\npostgres=# select * from bar;\r\n a\r\n---\r\n(0 rows)\r\n\r\npostgres=# \\d\r\n        List of relations\r\n Schema | Name | Type  |  Owner\r\n--------+------+-------+----------\r\n public | bar  | table | postgres\r\n(1 row)\r\n\r\n```\r\nThe UI will still show the old name:\r\n\r\n![image](https://user-images.githubusercontent.com/4038003/61404852-47cd4200-a88d-11e9-9336-b2e34203e8d0.png)\r\n","closed_by":{"login":"ndeodhar","id":15746068,"node_id":"MDQ6VXNlcjE1NzQ2MDY4","avatar_url":"https://avatars.githubusercontent.com/u/15746068?v=4","gravatar_id":"","url":"https://api.github.com/users/ndeodhar","html_url":"https://github.com/ndeodhar","followers_url":"https://api.github.com/users/ndeodhar/followers","following_url":"https://api.github.com/users/ndeodhar/following{/other_user}","gists_url":"https://api.github.com/users/ndeodhar/gists{/gist_id}","starred_url":"https://api.github.com/users/ndeodhar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ndeodhar/subscriptions","organizations_url":"https://api.github.com/users/ndeodhar/orgs","repos_url":"https://api.github.com/users/ndeodhar/repos","events_url":"https://api.github.com/users/ndeodhar/events{/privacy}","received_events_url":"https://api.github.com/users/ndeodhar/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/2280/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/2280/timeline","performed_via_github_app":null,"state_reason":"completed"}