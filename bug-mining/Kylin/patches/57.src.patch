+public interface ISmartApplicationListenerForSystem extends SmartApplicationListener {
+
+    @Override
+    default boolean supportsEventType(Class<? extends ApplicationEvent> eventType) {
+        return eventType == ApplicationReadyEvent.class || eventType == ContextClosedEvent.class;
+    }
