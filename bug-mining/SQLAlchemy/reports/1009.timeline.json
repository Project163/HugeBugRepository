tocommit=True)\r\n\r\ncnxn.execute(f\"DROP DATABASE IF EXISTS {db_name}\")\r\ncnxn.execute(f\"CREATE DATABASE {db_name} COLLATE Latin1_General_100_CI_AI_SC\")\r\ncnxn.execute(f\"USE {db_name}\")\r\ncnxn.execute(\r\n    f\"CREATE TABLE {table_name} (id int PRIMARY KEY, txt nvarchar(max))\"\r\n)\r\ncnxn.close()\r\n\r\nsqlalchemy_uri = \"mssql+pyodbc:///?odbc_connect=\" + urllib.parse.quote_plus(\r\n    get_connection_string(db_name)\r\n)\r\nengine = sa.create_engine(sqlalchemy_uri)\r\ntable1 = sa.Table(table_name, sa.MetaData(), autoload_with=engine)\r\nwith engine.begin() as conn:\r\n    conn.execute(table1.insert(), {\"id\": 1, \"txt\": \"x\" * 2001})\r\n\"\"\"console output:\r\nsqlalchemy.exc.ProgrammingError: (pyodbc.ProgrammingError) ('42000', \r\n\"[42000] [Microsoft][ODBC Driver 17 for SQL Server][SQL Server]\r\nCannot convert to text/ntext or collate to 'Latin1_General_100_CI_AI_SC' \r\nbecause these legacy LOB types do not support the Unicode supplementary \r\ncharacters whose codepoints are U+10000 or greater. Use types varchar(max), \r\nnvarchar(max), or a collation which does not have the _SC flag. (4189) \r\n(SQLParamData)\")\r\n\"\"\"\r\n```\r\n\r\n","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5651/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5651/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/800288639","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/5649#issuecomment-800288639","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5649","id":800288639,"node_id":"MDEyOklzc3VlQ29tbWVudDgwMDI4ODYzOQ==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4",