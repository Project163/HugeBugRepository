+
+            final ClassLoader oldCl = Thread.currentThread().getContextClassLoader();
+            final ClassLoader newCl = getExternalClassLoader();
+
+            Thread.currentThread().setContextClassLoader(newCl);
+
+            for (int i = 0; i < 10; i++)
