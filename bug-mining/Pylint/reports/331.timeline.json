//bugs.gentoo.org/878651\r\n\r\nRan the full test-ng test suite in Ubuntu container with python3.8 as its failing on my host machine for unrelated reasons in current HEAD. Haven't looked further on that. Pytest and toml.sh pass just fine.\r\n\r\nArch appears to be on python3.11 so it should just need tomli-w.","reactions":{"url":"https://api.github.com/repos/deadc0de6/dotdrop/issues/395/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/deadc0de6/dotdrop/issues/395/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"}]