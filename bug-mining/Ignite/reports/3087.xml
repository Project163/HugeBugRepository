<item>
            <title>[IGNITE-7477] Ignite.NET does not work on Java 9</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-7477</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;Ignite.NET does not work properly on Java 9 (&lt;a href=&quot;https://issues.apache.org/jira/browse/IGNITE-6730&quot; title=&quot;Java 9: fix project build procedure&quot; class=&quot;issue-link&quot; data-issue-key=&quot;IGNITE-6730&quot;&gt;&lt;del&gt;IGNITE-6730&lt;/del&gt;&lt;/a&gt;).&lt;br/&gt;
Some additional JVM settings are required:&lt;/p&gt;

&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
--add-exports java.base/jdk.internal.misc=ALL-UNNAMED --add-exports java.base/sun.nio.ch=ALL-UNNAMED --add-exports java.management/com.sun.jmx.mbeanserver=ALL-UNNAMED --add-exports jdk.internal.jvmstat/sun.jvmstat.monitor=ALL-UNNAMED
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</description>
                <environment></environment>
        <key id="13132176">IGNITE-7477</key>
