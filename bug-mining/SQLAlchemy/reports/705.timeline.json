:03Z","updated_at":"2025-12-12T09:08:20Z","pushed_at":"2025-12-10T20:45:00Z","git_url":"git://github.com/sqlalchemy/sqlalchemy.git","ssh_url":"git@github.com:sqlalchemy/sqlalchemy.git","clone_url":"https://github.com/sqlalchemy/sqlalchemy.git","svn_url":"https://github.com/sqlalchemy/sqlalchemy","homepage":"https://www.sqlalchemy.org","size":99269,"stargazers_count":11252,"watchers_count":11252,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":1606,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":205,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["python","sql","sqlalchemy"],"visibility":"public","forks":1606,"open_issues":205,"watchers":11252,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"**Migrated issue, originally created by Julio César Gázquez ([@shulai](https://github.com/shulai))**\n\nI did adapt my model as suggested by @zzzeek in the mailing list and documented in Bitbucket issue #4078, declaring relationships as `viewonly=True` in a superclass and overriding them as viewonly=False in subclasses as needed.\n\nThen I found that when doing a query on a subclass eager loading one of those relationships works fine. However doing the same query on the superclass results in the SQL query correctly issued, but the related objects for one of those relationships are missing (not accesible through the relationship attribute, and not even loaded in the session).\n\nI can only add that this isn't a regression as I get the same results on 1.1.14 and 0.9.9, and that removing the relationship overload in the subclass (and removing viewonly=True in the superclass) I got it working normally. The bug is database agnostic, tested with PostgreSQL and SQLite.\n\nTest case attached.\n\n----------------------------------------\nAttachments: [superclass_eager_loading.py](../wiki/imported_issue_attachments/4094/superclass_eager_loading.py)\n\n","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/4094/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/4094/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]