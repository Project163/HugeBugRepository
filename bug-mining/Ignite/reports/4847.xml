            <title>[IGNITE-13848] Premature update SegmentReservationStorage#minReserveIdx during truncate of  segments</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-13848</link>
                <project id="12315922" key="IGNITE">Ignite</project>
