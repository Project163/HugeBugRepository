/following{/other_user}","gists_url":"https://api.github.com/users/cescoffier/gists{/gist_id}","starred_url":"https://api.github.com/users/cescoffier/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cescoffier/subscriptions","organizations_url":"https://api.github.com/users/cescoffier/orgs","repos_url":"https://api.github.com/users/cescoffier/repos","events_url":"https://api.github.com/users/cescoffier/events{/privacy}","received_events_url":"https://api.github.com/users/cescoffier/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2022-04-27T05:51:09Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/1110718605","html_url":"https://github.com/quarkusio/quarkus/issues/25185#issuecomment-1110718605","issue_url":"https://api.github.com/repos/quarkusio/quarkus/issues/25185","id":1110718605,"node_id":"IC_kwDOCFbutM5CNDiN","user":{"login":"ozangunalp","id":294765,"node_id":"MDQ6VXNlcjI5NDc2NQ==","avatar_url":"https://avatars.githubusercontent.com/u/294765?v=4","gravatar_id":"","url":"https://api.github.com/users/ozangunalp","html_url":"https://github.com/ozangunalp","followers_url":"https://api.github.com/users/ozangunalp/followers","following_url":"https://api.github.com/users/ozangunalp/following{/other_user}","gists_url":"https://api.github.com/users/ozangunalp/gists{/gist_id}","starred_url":"https://api.github.com/users/ozangunalp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ozangunalp/subscriptions","organizations_url":"https://api.github.com/users/ozangunalp/orgs","repos_url":"https://api.github.com/users/ozangunalp/repos","events_url":"https://api.github.com/users/ozangunalp/events{/privacy}","received_events_url":"https://api.github.com/users/ozangunalp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-04-27T08:38:27Z","updated_at":"2022-04-27T08:38:27Z","body":"Thank you for the issue!\r\n\r\nI am guessing you are using `com.fasterxml.jackson.databind.JsonNode` as payload type. \r\nI think what is happening is because there is no Serde found for `JsonNode` Quarkus is generating one using Jackson `ObjectMapperDeserializer`.\r\nYou should see a log saying `Generating Jackson deserializer...`.\r\n\r\nIf you are willing to use a generic Json type you can use `io.vertx.core.json.JsonObject` OOTB. \r\nThis will detect the type and configure your application to use `JsonObjectDeserializer`. (Just beware that, that class will be replaced in a future release #22295)\r\n\r\nThat being said there is a bug in Jackson serde generation. If a serde is already generated it doesn't take it into account in configuration.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/1110718605/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ozangunalp","id":294765,"node_id":"MDQ6VXNlcjI5NDc2NQ==","avatar_url":"https://avatars.githubusercontent.com/u/294765?v=4","gravatar_id":"","url":"https://api.github.com/users/ozangunalp","html_url":"https://github.com/ozangunalp","followers_url":"https://api.github.com/users/ozangunalp/followers","following_url":"https://api.github.com/users/ozangunalp/following{/other_user}","gists_url":"https://api.github.com/users/ozangunalp/gists{/gist_id}","starred_url":"https://api.github.com/users/ozangunalp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ozangunalp/subscriptions","organizations_url":"https://api.github.com/users/ozangunalp/orgs","repos_url":"https://api.github.com/users/ozangunalp/repos","events_url":"https://api.github.com/users/ozangunalp/events{/privacy}","received_events_url":"https://api.github.com/users/ozangunalp/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/1110796516","html_url":"https://github.com/quarkusio/quarkus/issues/25185#issuecomment-1110796516","issue_url":"https://api.github.com/repos/quarkusio/quarkus/issues/25185","id":1110796516,"node_id":"IC_kwDOCFbutM5CNWjk","user":{"login":"ertanden","id":97019,"node_id":"MDQ6VXNlcjk3MDE5","avatar_url":"https://avatars.githubusercontent.com/u/97019?v=4","gravatar_id":"","url":"https://api.github.com/users/ertanden","html_url":"https://github.com/ertanden","followers_url":"https://api.github.com/users/ertanden/followers","following_url":"https://api.github.com/users/ertanden/following{/other_user}","gists_url":"https://api.github.com/users/ertanden/gists{/gist_id}","starred_url":"https://api.github.com/users/ertanden/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ertanden/subscriptions","organizations_url":"https://api.github.com/users/ertanden/orgs","repos_url":"https://api.github.com/users/ertanden/repos","events_url":"https://api.github.com/users/ertanden/events{/privacy}","received_events_url":"https://api.github.com/users/ertanden/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-04-27T09:46:11Z","updated_at":"2022-04-27T09:46:11Z","body":"Thanks for the reply. \r\n\r\nYep, the payload type is `com.fasterxml.jackson.databind.JsonNode`. In fact the generation of a serializer seems to work when I combine the two Kafka topics into a single incoming channel, like the following;\r\n\r\n```\r\nmp.messaging.incoming.channel-combined.connector=smallrye-kafka\r\nmp.messaging.incoming.channel-combined.topics=topic-1,topic-2\r\n```\r\n\r\nThe problem is still when you separate the channels.\r\n\r\nI see this log message in both cases\r\n\r\n```\r\nGenerating Jackson deserializer for type com.fasterxml.jackson.databind.JsonNode\r\n```\r\n\r\n","author_association":"NONE","reactions