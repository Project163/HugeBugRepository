+            self.classes.Dingaling,
+            self.classes.HasDingaling,
+        )
+        s = Session()
+        d = Dingaling()
+        s.add(d)
+        s.flush()
+        s.commit()
+        d.id
+        s.expire(d, ["data"])
+        s.expunge(d)
+        assert "data" not in d.__dict__
+        assert "id" in d.__dict__
+
