.com/thc202","followers_url":"https://api.github.com/users/thc202/followers","following_url":"https://api.github.com/users/thc202/following{/other_user}","gists_url":"https://api.github.com/users/thc202/gists{/gist_id}","starred_url":"https://api.github.com/users/thc202/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thc202/subscriptions","organizations_url":"https://api.github.com/users/thc202/orgs","repos_url":"https://api.github.com/users/thc202/repos","events_url":"https://api.github.com/users/thc202/events{/privacy}","received_events_url":"https://api.github.com/users/thc202/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"thc202","id":4639210,"node_id":"MDQ6VXNlcjQ2MzkyMTA=","avatar_url":"https://avatars.githubusercontent.com/u/4639210?v=4","gravatar_id":"","url":"https://api.github.com/users/thc202","html_url":"https://github.com/thc202","followers_url":"https://api.github.com/users/thc202/followers","following_url":"https://api.github.com/users/thc202/following{/other_user}","gists_url":"https://api.github.com/users/thc202/gists{/gist_id}","starred_url":"https://api.github.com/users/thc202/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thc202/subscriptions","organizations_url":"https://api.github.com/users/thc202/orgs","repos_url":"https://api.github.com/users/thc202/repos","events_url":"https://api.github.com/users/thc202/events{/privacy}","received_events_url":"https://api.github.com/users/thc202/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":4,"created_at":"2017-12-20T15:14:29Z","updated_at":"2021-07-12T07:07:51Z","closed_at":"2021-03-26T16:00:10Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"I was originally starting with running zap-full-scan.py scans against a number of hosts, one of which was https://observatory.mozilla.org and the active scan was seeming running indefinitely.  I moved to the UI to try and get more information on this and I worked with @thc202 a fair bit in #websectools trying to debug this.  We ultimately didn't find a resolution, but putting all my debug information/intel here in the hopes it eventually finds a root cause and we can work past this.\r\n\r\nReproduction Steps\r\n\r\n1. Open up the ZAP UI (I was running 2.7.0 release on Mac OS Sierra)\r\n2. URL to Attack: https://observatory.mozilla.org\r\n3. You will then witness it move through and complete the Spider quite quickly and move on to the Active Scan\r\n4. In the active scan it will start with the Path Traversal plugin, make up to about ~50 requests and then the request counter will stop increasing.\r\n\r\nTroubleshooting/Debug Context\r\n\r\n1. We originally thought this was some IPS/WAF solution, but I have verified with the service owner this is not the case and I verified with other MiTM proxies and this behavior was not observed there.  We believe we ruled this out.\r\n\r\n2. We ran ZAP and got stack traces from all the threads.  Based on this @thc202 concluded that the scanner was waiting, not timing out\r\n\r\nhttps://irccloud.mozilla.com/pastebin/0MYRL5jb/\r\n\r\n3.  @thc202 also just realized that http://observatory.mozilla.org/images/favicons which redirects to http://observatory.mozilla.org:58443/images/favicons/ and believes this is the source of the issue.","closed_by":{"login":"thc202","id":4639210,"node_id":"MDQ6VXNlcjQ2MzkyMTA=","avatar_url":"https://avatars.githubusercontent.com/u/4639210?v=4","gravatar_id":"","url":"https://api.github.com/users/thc202","html_url":"https://github.com/thc202","followers_url":"https://api.github.com/users/thc202/followers","following_url":"https://api.github.com/users/thc202/following{/other_user}","gists_url":"https://api.github.com/users/thc202/gists{/gist_id}","starred_url":"https://api.github.com/users/thc202/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thc202/subscriptions","organizations_url":"https://api.github.com/users/thc202/orgs","repos_url":"https://api.github.com/users/thc202/repos","events_url":"https://api.github.com/users/thc202/events{/privacy}","received_events_url":"https://api.github.com/users/thc202/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/zaproxy/zaproxy/issues/4171/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/zaproxy/zaproxy/issues/4171/timeline","performed_via_github_app":null,"state_reason":"completed"}