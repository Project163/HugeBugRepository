ured/rest-assured/pull/1397.patch","merged_at":"2020-11-06T14:18:44Z"},"body":"See https://github.com/quarkusio/quarkus/issues/12913 for more details.\r\n\r\nThe old `json-schema-validator` version uses an old `jackson-coreutils` and is not compatible with the one we now use on Quarkus.\r\n\r\nIf you have the ability to release a 4.3.2 with this fix, that would be awesome!\r\n\r\nThanks!","reactions":{"url":"https://api.github.com/repos/rest-assured/rest-assured/issues/1397/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/rest-assured/rest-assured/issues/1397/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/716467876","html_url":"https://github.com/quarkusio/quarkus/issues/12913#issuecomment-716467876","issue_url":"https://api.github.com/repos/quarkusio/quarkus/issues/12913","id":716467876,"node_id":"MDEyOklzc3VlQ29tbWVudDcxNjQ2Nzg3Ng==","user":{"login":"gsmet","id":1279749,"node_id":"MDQ6VXNlcjEyNzk3NDk=","avatar_url":"https://avatars.githubusercontent.com/u/1279749?v=4","gravatar_id":"","url":"https://api.github.com/users/gsmet","html_url":"https://github.com/gsmet","followers_url":"https://api.github.com/users/gsmet/followers","following_url":"https://api.github.com/users/gsmet/following{/other_user}","gists_url":"https://api.github.com/users/gsmet/gists{/gist_id}","starred_url":"https://api.github.com/users/gsmet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gsmet/subscriptions","organizations_url":"https://api.github.com/users/gsmet/orgs","repos_url":"https://api.github.com/users/gsmet/repos","events_url":"https://api.github.com/users/gsmet/events{/privacy}","received_events_url":"https://api.github.com/users/gsmet/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-10-26T10:49:29Z","updated_at":"2020-10-26T10:49:29Z","body":"The issue is an incompatibility of `jackson-coreutils` versions. It got upgraded in RESTEasy and `com.github.java-json-tools:json-schema-core` doesn't support this upgrade.\r\n\r\nI fixed it by adding the following to your project:\r\n```\r\n        <groupId>com.github.java-json-tools</groupId>\r\n\t    <artifactId>json-schema-validator</artifactId>\r\n\t    <version>2.2.14</version>\r\n\t</dependency>\r\n```\r\n\r\nI created https://github.com/rest-assured/rest-assured/pull/1397 in the REST Assured project.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/716467876/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"gsmet","id":1279749,"node_id":"MDQ6VXNlcjEyNzk3NDk=","avatar_url":"https://avatars.githubusercontent.com/u/1279749?v=4","gravatar_id":"","url":"https://api.github.com/users/gsmet","html_url":"https://github.com/gsmet","followers_url":"https://api.github.com/users/gsmet/followers","following_url":"https://api.github.com/users/gsmet/following{/other_user}","gists_url":"https://api.github.com/users/gsmet/gists{/gist_id}","starred_url":"https://api.github.com/users/gsmet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gsmet/subscriptions","organizations_url":"https://api.github.com/users/gsmet/orgs","repos_url":"https://api.github.com/users/gsmet/repos","events_url":"https://api.github.com/users/gsmet/events{/privacy}","received_events_url":"https://api.github.com/users/gsmet/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":3920068072,"node_id":"MDEyOkxhYmVsZWRFdmVudDM5MjAwNjgwNzI=","url":"https://api.github.com/repos/quarkusio/quarkus/issues/events/3920068072","actor":{"login":"gsmet","id":1279749,"node_id":"MDQ6VXNlcjEyNzk3NDk=","avatar_url":"https://avatars.git