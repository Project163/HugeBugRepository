ers;\n\nuse Yii;\nuse yii\\console\\Controller;\n\nclass XmlController extends Controller\n{\n    /**\n     * @var string controller default action ID.\n     */\n    public $defaultAction = 'actalibra';\n\n    /**\n     * @var boolean whether to run the command interactively.\n     */\n    public $interactive = false;\n\n\n    public function actionActalibra() {\n        Console::stdout('Test');\n    }\n\n} \n```\n\nI also updated the main.php config file of my console app:\n\n```\n    'controllerNamespace' => 'console\\controllers',\n    'controllerMap' => [\n        'xml' => [\n            'class' => 'console\\controllers\\XmlController'\n        ],\n    ]\n```\n\nWhen I run `php yii help` the xml command is listed among the available commands, but when I try to run my newly created xml controller using `php yii xml`, I get the following error:\n\n```\nexception 'ReflectionException' with message 'Class console\\controllers\\XmlController does not exist' in /Users/username/Sites/projectname/vendor/yiisoft/yii2/yii/BaseYii.php:374\n\nStack trace:\n#0 /Users/username/Sites/projectname/vendor/yiisoft/yii2/yii/BaseYii.php(374): ReflectionClass->__construct('console\\control...')\n#1 /Users/username/Sites/projectname/vendor/yiisoft/yii2/yii/base/Module.php(625): yii\\BaseYii::createObject(Array, 'xml', Object(yii\\console\\Application))\n#2 /Users/username/Sites/projectname/vendor/yiisoft/yii2/yii/base/Module.php(579): yii\\base\\Module->createController('xml')\n#3 /Users/username/Sites/projectname/vendor/yiisoft/yii2/yii/console/Application.php(131): yii\\base\\Module->runAction('xml', Array)\n#4 /Users/username/Sites/projectname/vendor/yiisoft/yii2/yii/console/Application.php(99): yii\\console\\Application->runAction('xml', Array)\n#5 /Users/username/Sites/projectname/vendor/yiisoft/yii2/yii/base/Application.php(288): yii\\console\\Application->handleRequest(Object(yii\\console\\Request))\n#6 /Users/username/Sites/projectname/yii-dev(22): yii\\base\\Application->run()\n#7 {main}\n```\n\nI checked the file permissions, the file is 100% sure in the right directory, and the namespace seems correct to me. Anyone got an idea why this won't run?\n\nThanks!\n","closed_by":{"login":"samdark","id":47294,"node_id":"MDQ6VXNlcjQ3Mjk0","avatar_url":"https://avatars.githubusercontent.com/u/47294?v=4","gravatar_id":"","url":"https://api.github.com/users/samdark","html_url":"https://github.com/samdark","followers_url":"https://api.github.com/users/samdark/followers","following_url":"https://api.github.com/users/samdark/following{/other_user}","gists_url":"https://api.github.com/users/samdark/gists{/gist_id}","starred_url":"https://api.github.com/users/samdark/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/samdark/subscriptions","organizations_url":"https://api.github.com/users/samdark/orgs","repos_url":"https://api.github.com/users/samdark/repos","events_url":"https://api.github.com/users/samdark/events{/privacy}","received_events_url":"https://api.github.com/users/samdark/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yiisoft/yii2/issues/1324/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yiisoft/yii2/issues/1324/timeline","performed_via_github_app":null,"state_reason":"completed"}