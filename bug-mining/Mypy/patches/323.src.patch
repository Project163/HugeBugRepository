+<span class="line-empty"></span>
+<span class="line-precise">old_stdout = sys.stdout</span>
+</pre></td>
+</tr></tbody>
+</table>
+</body>
+</html>
+
+[case testAnyExprReportIncludesDeadCode]
+# cmd: mypy --any-exprs-report report i.py j.py
+
+[file i.py]
+def bar(x):
+    # type: (str) -> None
+    print(x)
+    assert False
+    print(x)  # dead code!
+
+[file j.py]
+def bar(x):
+    # type: (str) -> None
