aurer","html_url":"https://github.com/normanmaurer","followers_url":"https://api.github.com/users/normanmaurer/followers","following_url":"https://api.github.com/users/normanmaurer/following{/other_user}","gists_url":"https://api.github.com/users/normanmaurer/gists{/gist_id}","starred_url":"https://api.github.com/users/normanmaurer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/normanmaurer/subscriptions","organizations_url":"https://api.github.com/users/normanmaurer/orgs","repos_url":"https://api.github.com/users/normanmaurer/repos","events_url":"https://api.github.com/users/normanmaurer/events{/privacy}","received_events_url":"https://api.github.com/users/normanmaurer/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"normanmaurer","id":439362,"node_id":"MDQ6VXNlcjQzOTM2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/439362?v=4","gravatar_id":"","url":"https://api.github.com/users/normanmaurer","html_url":"https://github.com/normanmaurer","followers_url":"https://api.github.com/users/normanmaurer/followers","following_url":"https://api.github.com/users/normanmaurer/following{/other_user}","gists_url":"https://api.github.com/users/normanmaurer/gists{/gist_id}","starred_url":"https://api.github.com/users/normanmaurer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/normanmaurer/subscriptions","organizations_url":"https://api.github.com/users/normanmaurer/orgs","repos_url":"https://api.github.com/users/normanmaurer/repos","events_url":"https://api.github.com/users/normanmaurer/events{/privacy}","received_events_url":"https://api.github.com/users/normanmaurer/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":{"url":"https://api.github.com/repos/netty/netty/milestones/141","html_url":"https://github.com/netty/netty/milestone/141","labels_url":"https://api.github.com/repos/netty/netty/milestones/141/labels","id":1682502,"node_id":"MDk6TWlsZXN0b25lMTY4MjUwMg==","number":141,"title":"4.0.37.Final","description":"","creator":{"login":"normanmaurer","id":439362,"node_id":"MDQ6VXNlcjQzOTM2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/439362?v=4","gravatar_id":"","url":"https://api.github.com/users/normanmaurer","html_url":"https://github.com/normanmaurer","followers_url":"https://api.github.com/users/normanmaurer/followers","following_url":"https://api.github.com/users/normanmaurer/following{/other_user}","gists_url":"https://api.github.com/users/normanmaurer/gists{/gist_id}","starred_url":"https://api.github.com/users/normanmaurer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/normanmaurer/subscriptions","organizations_url":"https://api.github.com/users/normanmaurer/orgs","repos_url":"https://api.github.com/users/normanmaurer/repos","events_url":"https://api.github.com/users/normanmaurer/events{/privacy}","received_events_url":"https://api.github.com/users/normanmaurer/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":122,"state":"closed","created_at":"2016-04-04T16:35:57Z","updated_at":"2018-03-28T19:13:06Z","due_on":null,"closed_at":"2016-06-07T19:16:15Z"},"comments":3,"created_at":"2016-05-03T15:05:39Z","updated_at":"2016-05-04T19:55:11Z","closed_at":"2016-05-04T19:18:03Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Netty version: 4.0.33.Final, 4.1.0.Final-SNAPSHOT\n\nContext:\nWhen the HttpPostRequest decoder receives an invalid structured `application/x-www-form-urlencoded` data, it throws an `IllegalArgumentException` while I think it should throw a `ErrorDataDecoderException`.\n\nThis behavior crashes for example vert.x as it [only catches](https://github.com/eclipse/vert.x/blob/2363b3e46fe964643be048e75807a31134883fdf/src/main/java/io/vertx/core/http/impl/HttpServerRequestImpl.java#L367) `ErrorDataDecoderException` and is similar to #2305.\n\nI reproduced it with the following test:\n\n``` java\n@Test\npublic void testFormEncodeIncorrect() throws Exception {\n    String payload = \"town=794649819&&town=784444184\";\n    DefaultHttpRequest req = new DefaultHttpRequest(HttpVersion.HTTP_1_1, HttpMethod.POST, \"/\");\n    HttpPostRequestDecoder decoder = new HttpPostRequestDecoder(req);\n    try {\n        decoder.offer(new DefaultLastHttpContent(Unpooled.wrappedBuffer(payload.getBytes())));\n        fail(\"Was expecting an ErrorDataDecoderException\");\n    } catch (HttpPostRequestDecoder.ErrorDataDecoderException e) {\n        assertTrue(e.getCause() instanceof IllegalArgumentException);\n    }\n}\n```\n\nWhich produces the following stacktrace:\n\n```\njava.lang.IllegalArgumentException: empty name\n    at io.netty.handler.codec.http.multipart.AbstractHttpData.<init>(AbstractHttpData.java:51)\n    at io.netty.handler.codec.http.multipart.AbstractMemoryHttpData.<init>(AbstractMemoryHttpData.java:42)\n    at io.netty.handler.codec.http.multipart.MemoryAttribute.<init>(MemoryAttribute.java:41)\n    at io.netty.handler.codec.http.multipart.MixedAttribute.<init>(MixedAttribute.java:45)\n    at io.netty.handler.codec.http.multipart.DefaultHttpDataFactory.createAttribute(DefaultHttpDataFactory.java:133)\n    at io.netty.handler.codec.http.multipart.HttpPostStandardRequestDecoder.parseBodyAttributes(HttpPostStandardRequestDecoder.java:549)\n    at io.netty.handler.codec.http.multipart.HttpPostStandardRequestDecoder.parseBody(HttpPostStandardRequestDecoder.java:372)\n    at io.netty.handler.codec.http.multipart.HttpPostStandardRequestDecoder.offer(HttpPostStandardRequestDecoder.java:301)\n    at io.netty.handler.codec.http.multipart.HttpPostStandardRequestDecoder.offer(HttpPostStandardRequestDecoder.java:46)\n    at io.netty.handler.codec.http.multipart.HttpPostRequestDecoder.offer(HttpPostRequestDecoder.java:228)\n    at io.netty.handler.codec.http.multipart.HttpPostRequestDecoderTest.testFormEncodeIncorrect(HttpPostRequestDecoderTest.java:274)\n```\n","closed_by":{"login":"normanmaurer","id":439362,"node_id":"MDQ6VXNlcjQzOTM2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/439362?v=4","gravatar_id":"","url":"https://api.github.com/users/normanmaurer","html_url":"https://github.com/normanmaurer","followers_url":"https://api.github.com/users/normanmaurer/followers","following_url":"https://api.github.com/users/normanmaurer/following{/other_user}","gists_url":"https://api.github.com/users/normanmaurer/gists{/gist_id}","starred_url":"https://api.github.com/users/normanmaurer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/normanmaurer/subscriptions","organizations_url":"https://api.github.com/users/normanmaurer/orgs","repos_url":"https://api.github.com/users/normanmaurer/repos","events_url":"https://api.github.com/users/normanmaurer/events{/privacy}","received_events_url":"https://api.github.com/users/normanmaurer/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/netty/netty/issues/5202/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/netty/netty/issues/5202/timeline","performed_via_github_app":null,"state_reason":"completed"}