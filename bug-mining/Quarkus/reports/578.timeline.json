rcontent.com/u/18569562?v=4","gravatar_id":"","url":"https://api.github.com/users/elamotte7","html_url":"https://github.com/elamotte7","followers_url":"https://api.github.com/users/elamotte7/followers","following_url":"https://api.github.com/users/elamotte7/following{/other_user}","gists_url":"https://api.github.com/users/elamotte7/gists{/gist_id}","starred_url":"https://api.github.com/users/elamotte7/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elamotte7/subscriptions","organizations_url":"https://api.github.com/users/elamotte7/orgs","repos_url":"https://api.github.com/users/elamotte7/repos","events_url":"https://api.github.com/users/elamotte7/events{/privacy}","received_events_url":"https://api.github.com/users/elamotte7/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/580775864","html_url":"https://github.com/quarkusio/quarkus/issues/6105#issuecomment-580775864","issue_url":"https://api.github.com/repos/quarkusio/quarkus/issues/6105","id":580775864,"node_id":"MDEyOklzc3VlQ29tbWVudDU4MDc3NTg2NA==","user":{"login":"camboui","id":10075865,"node_id":"MDQ6VXNlcjEwMDc1ODY1","avatar_url":"https://avatars.githubusercontent.com/u/10075865?v=4","gravatar_id":"","url":"https://api.github.com/users/camboui","html_url":"https://github.com/camboui","followers_url":"https://api.github.com/users/camboui/followers","following_url":"https://api.github.com/users/camboui/following{/other_user}","gists_url":"https://api.github.com/users/camboui/gists{/gist_id}","starred_url":"https://api.github.com/users/camboui/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/camboui/subscriptions","organizations_url":"https://api.github.com/users/camboui/orgs","repos_url":"https://api.github.com/users/camboui/repos","events_url":"https://api.github.com/users/camboui/events{/privacy}","received_events_url":"https://api.github.com/users/camboui/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-01-31T15:19:54Z","updated_at":"2020-01-31T15:20:17Z","body":"Hi, \r\n\r\nI had the same issue and I've been digging in debug mode into your repo.\r\nI found out that there's a default RestEasy RoleBasedSecurityFilter but it's not even registered by default. So you won't manage to override it.\r\n\r\nYou can enable its registration by adding the following to your \"appliccation.properties\" file\r\n`resteasy.role.based.security=true`\r\nand voilà, tests are passing !","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/580775864/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"camboui","id":10075865,"node_id":"MDQ6VXNlcjEwMDc1ODY1","avatar_url":"https://avatars.githubusercontent.com/u/10075865?v=4","gravatar_id":"","url":"https://api.github.com/users/camboui","html_url":"https://github.com/camboui","followers_url":"https://api.github.com/users/camboui/followers","following_url":"https://api.github.com/users/camboui/following{/other_user}","gists_url":"https://api.github.com/users/camboui/gists{/gist_id}","starred_url":"https://api.github.com/users/camboui/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/camboui/subscriptions","organizations_url":"https://api.github.com/users/camboui/orgs","repos_url":"https://api.github.com/users/camboui/repos","events_url":"https://api.github.com/users/camboui/events{/privacy}","received_events_url":"https://api.github.com/users/camboui/received_events","type":"User","user_view_type":"public","site_admin":false}}]