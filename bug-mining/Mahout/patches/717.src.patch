-
-  /** Removes all values associations from the receiver. Implicitly calls <tt>trimToSize()</tt>. */
-  @Override
-  public void clear() {
-    Arrays.fill(this.state, 0, state.length - 1, FREE);
-    distinct = 0;
-    freeEntries = table.length; // delta
