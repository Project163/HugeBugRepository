8-06-12T13:49:36Z","updated_at":"2026-03-09T09:46:33Z","pushed_at":"2026-03-09T09:56:33Z","git_url":"git://github.com/vuejs/core.git","ssh_url":"git@github.com:vuejs/core.git","clone_url":"https://github.com/vuejs/core.git","svn_url":"https://github.com/vuejs/core","homepage":"https://vuejs.org/","size":40047,"stargazers_count":53172,"watchers_count":53172,"language":"TypeScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":9062,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":985,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":9062,"open_issues":985,"watchers":53172,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"### Vue version\n\n^3.2.34\n\n### Link to minimal reproduction\n\nhttps://sfc.vuejs.org/#__DEV__\n\n### Steps to reproduce\n\nOpen the link and see the maximum callstack exceeded error\n\n### What is expected?\n\nThe component should correctly resolve the `<component is=\"button\">` to a native button element as it did for 3.2.33\n\n### What is actually happening?\n\nThe `<component>` tag tries to load the `Button.vue` component itself which leads to recursion.\r\n\r\nNote that the error goes away if you have an empty script tag\n\n### System Info\n\n```shell\nSystem:\r\n    OS: Windows 10 10.0.19044\r\n    CPU: (8) x64 Intel(R) Core(TM) i7-4702MQ CPU @ 2.20GHz\r\n    Memory: 4.46 GB / 15.88 GB\r\n  Binaries:\r\n    Node: 17.1.0 - D:\\Programme\\nodejs\\node.EXE\r\n    Yarn: 1.22.15 - C:\\Program Files (x86)\\Yarn\\bin\\yarn.CMD\r\n    npm: 8.3.0 - D:\\Programme\\nodejs\\npm.CMD\r\n  Browsers:\r\n    Chrome: 102.0.5005.62\r\n    Edge: Spartan (44.19041.1266.0), Chromium (101.0.1210.53)\r\n    Internet Explorer: 11.0.19041.1566\r\n\r\nFF is missing (100.0.2 64bit)\n```\n\n\n### Any additional comments?\n\nI think this is some variant of https://github.com/vuejs/core/issues/6027\r\n\r\nI understand that the example I provided is ambiguous and vue can only guess what is meant when writing it like that.\r\n\r\n**However**: If `<button>` works, `<component :is=\"'button'\">` should behave the exact same way. I am fine with both of them leading to recursion but only one is not consistent and also a breaking change","reactions":{"url":"https://api.github.com/repos/vuejs/core/issues/6029/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vuejs/core/issues/6029/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/vuejs/core/issues/comments/1147049837","html_url":"https://github.com/vuejs/core/issues/5965#issuecomment-1147049837","issue_url":"https://api.github.com/repos/vuejs/core/issues/5965","id":1147049837,"node_id":"IC_kwDOCCum185EXpdt","user":{"login":"jbg","id":39903,"node_id":"MDQ6VXNlcjM5OTAz","avatar_url":"https://avatars.githubusercontent.com/u/39903?v=4","gravatar_id":"","url":"https://api.github.com/users/jbg","html_url":"https://github.com/jbg","followers_url":"https://api.github.com/users/jbg/followers","following_url":"https://api.github.com/users/jbg/following{/other_user}","gists_url":"https://api.github.com/users/jbg/gists{/gist_id}","starred_url":"https://api.github.com/users/jbg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jbg/subscriptions","organizations_url":"https://api.github.com/users/jbg/orgs","repos_url":"https://api.github.com/users/jbg/repos","events_url":"https://api.github.com/users/jbg/events{/privacy}","received_events_url"