github.com/users/hectorgcr/events{/privacy}","received_events_url":"https://api.github.com/users/hectorgcr/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2020-03-24T21:10:10Z","updated_at":"2020-03-25T16:26:13Z","closed_at":"2020-03-25T16:26:13Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Currently the following statements cause an incorrect error:\r\n```[cqlsh 5.0.1 | Cassandra 3.9-SNAPSHOT | CQL spec 3.4.2 | Native protocol v4]\r\nUse HELP for help.\r\ncassandra@cqlsh> CREATE KEYSPACE k;\r\ncassandra@cqlsh> USE k;\r\ncassandra@cqlsh:k> CREATE TABLE k.t (id BIGINT, s TEXT, PRIMARY KEY(id));\r\ncassandra@cqlsh:k> CREATE ROLE r1 WITH PASSWORD = 'p' AND LOGIN = true;\r\ncassandra@cqlsh:k> CREATE ROLE r2 WITH PASSWORD = 'p' AND LOGIN = true;\r\ncassandra@cqlsh:k> GRANT r1 TO r2;\r\ncassandra@cqlsh:k> GRANT SELECT ON t TO r2;\r\ncassandra@cqlsh:k> CREATE ROLE r3 WITH PASSWORD = 'p' AND LOGIN = true;\r\ncassandra@cqlsh:k> GRANT r2 TO r3;\r\ncassandra@cqlsh:k> GRANT MODIFY ON t TO r3;\r\ncassandra@cqlsh:k> LOGIN r3;\r\nPassword: \r\nr3@cqlsh:k> INSERT INTO t (id,s) VALUES (123, 'abc');\r\nUnauthorized: Error from server: code=2100 [Unauthorized] message=\"Unauthorized. User r3 has no MODIFY permission on <table k.t> or any of its parents\r\nINSERT INTO t (id,s) VALUES (123, 'abc');\r\n       ^^^^\r\n (ql error -4)\"\r\nr3@cqlsh:k> \r\n```\r\n\r\nBut removing statement `GRANT r2 TO r3;` fixes the issue:\r\n\r\n```Connected to local cluster at 127.0.0.1:9042.\r\n[cqlsh 5.0.1 | Cassandra 3.9-SNAPSHOT | CQL spec 3.4.2 | Native protocol v4]\r\nUse HELP for help.\r\ncassandra@cqlsh> CREATE KEYSPACE k;\r\ncassandra@cqlsh> USE k;\r\ncassandra@cqlsh:k> CREATE TABLE k.t (id BIGINT, s TEXT, PRIMARY KEY(id));\r\ncassandra@cqlsh:k> CREATE ROLE r1 WITH PASSWORD = 'p' AND LOGIN = true;\r\ncassandra@cqlsh:k> CREATE ROLE r2 WITH PASSWORD = 'p' AND LOGIN = true;\r\ncassandra@cqlsh:k> GRANT r1 TO r2;\r\ncassandra@cqlsh:k> GRANT SELECT ON t TO r2;\r\ncassandra@cqlsh:k> CREATE ROLE r3 WITH PASSWORD = 'p' AND LOGIN = true;\r\ncassandra@cqlsh:k> GRANT MODIFY ON t TO r3;\r\ncassandra@cqlsh:k> LOGIN r3;\r\nPassword: \r\nr3@cqlsh:k> INSERT INTO t (id,s) VALUES (123, 'abc');\r\nr3@cqlsh:k> \r\n```","closed_by":{"login":"hectorgcr","id":20052555,"node_id":"MDQ6VXNlcjIwMDUyNTU1","avatar_url":"https://avatars.githubusercontent.com/u/20052555?v=4","gravatar_id":"","url":"https://api.github.com/users/hectorgcr","html_url":"https://github.com/hectorgcr","followers_url":"https://api.github.com/users/hectorgcr/followers","following_url":"https://api.github.com/users/hectorgcr/following{/other_user}","gists_url":"https://api.github.com/users/hectorgcr/gists{/gist_id}","starred_url":"https://api.github.com/users/hectorgcr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hectorgcr/subscriptions","organizations_url":"https://api.github.com/users/hectorgcr/orgs","repos_url":"https://api.github.com/users/hectorgcr/repos","events_url":"https://api.github.com/users/hectorgcr/events{/privacy}","received_events_url":"https://api.github.com/users/hectorgcr/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/4062/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/4062/timeline","performed_via_github_app":null,"state_reason":"completed"}