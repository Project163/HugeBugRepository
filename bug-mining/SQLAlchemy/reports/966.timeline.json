github.com:sqlalchemy/sqlalchemy.git","clone_url":"https://github.com/sqlalchemy/sqlalchemy.git","svn_url":"https://github.com/sqlalchemy/sqlalchemy","homepage":"https://www.sqlalchemy.org","size":99269,"stargazers_count":11252,"watchers_count":11252,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":1606,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":205,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["python","sql","sqlalchemy"],"visibility":"public","forks":1606,"open_issues":205,"watchers":11252,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Under `1.4.0b1` some `CHECK` constraints seem to be missing for the `sqlite` dialect, e.g.:\r\n```python\r\n>>> import sqlalchemy as sa\r\n>>> sa.__version__\r\n'1.4.0b1'\r\n>>> import sqlalchemy.orm\r\n>>>  class Spam(sa.orm.declarative_base()):\r\n\r\n    __tablename__ = 'spam'\r\n\r\n    id = sa.Column(sa.Integer, primary_key=True)\r\n\r\n    boolean = sa.Column(sa.Boolean)\r\n\r\n    enum = sa.Column(sa.Enum('a', 'b', 'c'))\r\n\r\n>>> engine = sa.create_engine('sqlite://', echo=True)\r\n>>> Spam.metadata.create_all(engine)\r\n(...)\r\nCREATE TABLE spam (\r\n\tid INTEGER NOT NULL, \r\n\tboolean BOOLEAN, \r\n\tenum VARCHAR(1), \r\n\tPRIMARY KEY (id)\r\n)\r\n(...)\r\n```\r\n\r\nSame SQL for the table when looked up via `engine.scalar(sa.select(sa.column('sql')).select_from(sa.text('sqlite_master')).where(sa.text(\"type = 'table' and name = 'spam'\")`\r\n\r\nExpected behaviour in `1.3` (has `CHECK`s for `boolean` and `enum` columns):\r\n\r\n```python\r\nIn [1]: import sqlalchemy as sa\r\n\r\nIn [2]: sa.__version__\r\nOut[2]: '1.3.20'\r\n\r\nIn [3]: import sqlalchemy.ext.declarative\r\n\r\nIn [4]: class Spam(sa.ext.declarative.declarative_base()):\r\n   ...: \r\n   ...:     __tablename__ = 'spam'\r\n   ...: \r\n   ...:     id = sa.Column(sa.Integer, primary_key=True)\r\n   ...: \r\n   ...:     boolean = sa.Column(sa.Boolean)\r\n   ...: \r\n   ...:     enum = sa.Column(sa.Enum('a', 'b', 'c'))\r\n\r\nIn [5]: engine = sa.create_engine('sqlite://', echo=True)\r\n(...)\r\nCREATE TABLE spam (\r\n\tid INTEGER NOT NULL, \r\n\tboolean BOOLEAN, \r\n\tenum VARCHAR(1), \r\n\tPRIMARY KEY (id), \r\n\tCHECK (boolean IN (0, 1)), \r\n\tCHECK (enum IN ('a', 'b', 'c'))\r\n)\r\n(...)\r\n```","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5701/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5701/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":3997565961,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDM5OTc1NjU5NjE=","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/3997565961","actor":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/event