diff --git a/lib/rules/vars-on-top.js b/lib/rules/vars-on-top.js
index 6c38fc06e..3eebc525d 100644
--- a/lib/rules/vars-on-top.js
+++ b/lib/rules/vars-on-top.js
@@ -18,6 +18,15 @@ module.exports = function (context) {
     // Helpers
     //--------------------------------------------------------------------------
 
+    /**
+     * @param {ASTNode} node - any node
+     * @returns {Boolean} whether the given node structurally represents a directive
+     */
+    function looksLikeDirective(node) {
+       return node.type === "ExpressionStatement" &&
+           node.expression.type === "Literal" && typeof node.expression.value === "string";
+    }
+
     /**
      * Checks whether this variable is on top of the block body
      * @param {ASTNode} node - The node to check
@@ -25,18 +34,23 @@ module.exports = function (context) {
      * @returns {Boolean} True if var is on top otherwise false
      */
     function isVarOnTop (node, statements) {
-        var cnt;
+        var i = 0, l = statements.length;
 
-        for (cnt = 0; cnt < statements.length; cnt++) {
-            if (statements[cnt].type !== "VariableDeclaration") {
+        // skip over directives
+        for (; i < l; ++i) {
+            if (!looksLikeDirective(statements[i])) {
+                break;
+            }
+        }
+
+        for (; i < l; ++i) {
+            if (statements[i].type !== "VariableDeclaration") {
                 return false;
             }
-            if (statements[cnt] === node) {
+            if (statements[i] === node) {
                 return true;
             }
         }
-
-        return false;
     }
 
     /**
