y/commits{/sha}","git_commits_url":"https://api.github.com/repos/python/mypy/git/commits{/sha}","comments_url":"https://api.github.com/repos/python/mypy/comments{/number}","issue_comment_url":"https://api.github.com/repos/python/mypy/issues/comments{/number}","contents_url":"https://api.github.com/repos/python/mypy/contents/{+path}","compare_url":"https://api.github.com/repos/python/mypy/compare/{base}...{head}","merges_url":"https://api.github.com/repos/python/mypy/merges","archive_url":"https://api.github.com/repos/python/mypy/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/python/mypy/downloads","issues_url":"https://api.github.com/repos/python/mypy/issues{/number}","pulls_url":"https://api.github.com/repos/python/mypy/pulls{/number}","milestones_url":"https://api.github.com/repos/python/mypy/milestones{/number}","notifications_url":"https://api.github.com/repos/python/mypy/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/python/mypy/labels{/name}","releases_url":"https://api.github.com/repos/python/mypy/releases{/id}","deployments_url":"https://api.github.com/repos/python/mypy/deployments","created_at":"2012-12-07T13:30:23Z","updated_at":"2025-12-12T11:48:01Z","pushed_at":"2025-12-11T20:11:30Z","git_url":"git://github.com/python/mypy.git","ssh_url":"git@github.com:python/mypy.git","clone_url":"https://github.com/python/mypy.git","svn_url":"https://github.com/python/mypy","homepage":"https://www.mypy-lang.org/","size":77161,"stargazers_count":20064,"watchers_count":20064,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":3065,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":3124,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["linter","python","typechecker","types","typing"],"visibility":"public","forks":3065,"open_issues":3124,"watchers":20064,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"I apologize for the unspecific title, but I haven't yet really dug into this issue. Using `master` (@7b3ad9d and python/typeshed@23c44d3e respectively) on the following example:\n\n```\nbin/mypy -s --disallow-untyped-calls --disallow-untyped-defs test.py\n```\n\n``` python\n# test.py\nfrom typing import Any\n\ndef printception(*args: Any, **kwargs: Any) -> None:\n    print(*args, **kwargs)\n\ndef myfunc(*args: Any, **kwargs: Any) -> None:\n    pass\n\ndef funception(*args: Any, **kwargs: Any) -> None:\n    myfunc(*args, **kwargs)\n```\n\nleads to the following result:\n\n```\ntest.py: note: In function \"printception\":\ntest.py:4: error: Too many positional arguments for \"print\"\n```\n\n`print()` is defined in [builtins.py#L709](https://github.com/python/typeshed/blob/23c44d3e3617a0d59e29d1cf40457d39c7924a72/stdlib/3/builtins.pyi#L709)\n\n``` python\ndef print(*values: Any, sep: str = ' ', end: str = '\\n', file: IO[str] = None, flush: bool = False) -> None: ...\n```\n\nSince `*values: Any` and `*args: Any` should be equal, this leads me to believe that there's a bug.\n","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/2081/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/mypy/issues/2081/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]