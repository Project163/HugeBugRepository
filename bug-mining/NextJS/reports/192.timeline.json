e}","releases_url":"https://api.github.com/repos/vercel/next.js/releases{/id}","deployments_url":"https://api.github.com/repos/vercel/next.js/deployments","created_at":"2016-10-05T23:32:51Z","updated_at":"2025-12-12T14:51:52Z","pushed_at":"2025-12-12T14:29:08Z","git_url":"git://github.com/vercel/next.js.git","ssh_url":"git@github.com:vercel/next.js.git","clone_url":"https://github.com/vercel/next.js.git","svn_url":"https://github.com/vercel/next.js","homepage":"https://nextjs.org","size":2429859,"stargazers_count":136480,"watchers_count":136480,"language":"JavaScript","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":30029,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":3156,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["blog","browser","compiler","components","hybrid","nextjs","node","react","server-rendering","ssg","static","static-site-generator","universal","vercel"],"visibility":"public","forks":30029,"open_issues":3156,"watchers":136480,"default_branch":"canary","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/vercel/next.js/pulls/39397","html_url":"https://github.com/vercel/next.js/pull/39397","diff_url":"https://github.com/vercel/next.js/pull/39397.diff","patch_url":"https://github.com/vercel/next.js/pull/39397.patch","merged_at":"2022-08-09T22:58:41Z"},"body":"### 📖 What's in there?\r\n\r\nWhen used to enforce accesses, Middleware matchers can be confusing: users legitimately expect a matcher of  `/` to also match `/index` (which is often a 404, but still), since the Vercel platform resolves `/index` requests to `/`. \r\n\r\nA proposal was to augment `/` matcher with `/index` on middleware.\r\nIn this implementation, it also applies when using i18n and/or a basePath.\r\n\r\nThis PR also fixes #39396\r\n\r\n### 🧪 How to test?\r\n\r\nIt's fully covered with unit tests:\r\n\r\n```shell\r\npnpm testheadless --testPathPattern middleware-matcher\r\n```\r\n\r\nTo try it live, make an application with:\r\n```js\r\n// test-app/middleware.js\r\nimport { NextResponse } from 'next/server'\r\n\r\nexport default async function middleware(req) {\r\n  const response = NextResponse.next()\r\n  response.headers.append('x-from-middleware', true)\r\n  return response\r\n}\r\n\r\nexport const config = { matcher: '/' }\r\n\r\n// test-app/pages/index.js\r\nexport default () => <p>Hello World!</p>\r\n```\r\nAfter you build your next.js version, run `pnpm next dev test-app`, and then use `curl -I http://localhost:3000` and `curl -I http://localhost:3000/index`\r\n\r\nBoth should return `x-from-middleware` response header. Please note the second call has a status of 404.","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/39397/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/vercel/next.js/issues/39397/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":7148806257,"node_id":"REFE_lADOBC3Cis5PZLkCzwAAAAGqGiBx","url":"https://api.github.com/repos/vercel/next.js/issues/events/7148806257","actor":{"login":"feugy","id":186268,"node_id":"MDQ6VXNlcjE4NjI2OA==","avatar_url":"https://avatars.githubusercontent.com/u/186268?v=4","gravatar_id":"","url":"https://api.github.com/users/feugy","html_url":"https://github.com/feugy","followers_url":"https://api.github.com/users/feugy/followers","following_url":"https://api.github.com/users/feugy/following{/other_user}","gists_url":"https://api.github.com/users/feugy/gists{/gist_id}","starred_url":"https://api.github.com/users/feugy/starred{/owner}{/repo}","subscriptions_url":"https