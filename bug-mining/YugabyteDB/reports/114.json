s/m-iancu/followers","following_url":"https://api.github.com/users/m-iancu/following{/other_user}","gists_url":"https://api.github.com/users/m-iancu/gists{/gist_id}","starred_url":"https://api.github.com/users/m-iancu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/m-iancu/subscriptions","organizations_url":"https://api.github.com/users/m-iancu/orgs","repos_url":"https://api.github.com/users/m-iancu/repos","events_url":"https://api.github.com/users/m-iancu/events{/privacy}","received_events_url":"https://api.github.com/users/m-iancu/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"nocaway","id":31016169,"node_id":"MDQ6VXNlcjMxMDE2MTY5","avatar_url":"https://avatars.githubusercontent.com/u/31016169?v=4","gravatar_id":"","url":"https://api.github.com/users/nocaway","html_url":"https://github.com/nocaway","followers_url":"https://api.github.com/users/nocaway/followers","following_url":"https://api.github.com/users/nocaway/following{/other_user}","gists_url":"https://api.github.com/users/nocaway/gists{/gist_id}","starred_url":"https://api.github.com/users/nocaway/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nocaway/subscriptions","organizations_url":"https://api.github.com/users/nocaway/orgs","repos_url":"https://api.github.com/users/nocaway/repos","events_url":"https://api.github.com/users/nocaway/events{/privacy}","received_events_url":"https://api.github.com/users/nocaway/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":1,"created_at":"2019-01-08T18:54:21Z","updated_at":"2019-02-12T07:02:30Z","closed_at":"2019-02-12T07:02:30Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Test case:\r\n```\r\nCREATE TABLE tab(char_col CHAR[10] PRIMARY KEY, int_col INTEGER);\r\nINSERT INTO tab VALUES('one', 1);\r\nINSERT INTO tab VALUES('two', 2);\r\nINSERT INTO tab VALUES('three', 3);\r\n## Insert as many rows as needed\r\nSELECT * FROM tab WHERE char_col = 'two';\r\n```\r\n\r\nWhen passing data to PostgreSQL engine to process, YugaByte doesn't serialize the values properly for character-based datatypes. Currently, we use BINARY FunctionOID for these types while each of these types actually has its own FuncOID for this task.\r\n\r\nTo fix this bug, when preparing fields to read from YugaByte, we need to setup the appropriate function pointer (FuncOID) to do the serialization as it is not one FuncOID fits all character types.","closed_by":{"login":"nocaway","id":31016169,"node_id":"MDQ6VXNlcjMxMDE2MTY5","avatar_url":"https://avatars.githubusercontent.com/u/31016169?v=4","gravatar_id":"","url":"https://api.github.com/users/nocaway","html_url":"https://github.com/nocaway","followers_url":"https://api.github.com/users/nocaway/followers","following_url":"https://api.github.com/users/nocaway/following{/other_user}","gists_url":"https://api.github.com/users/nocaway/gists{/gist_id}","starred_url":"https://api.github.com/users/nocaway/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nocaway/subscriptions","organizations_url":"https://api.github.com/users/nocaway/orgs","repos_url":"https://api.github.com/users/nocaway/repos","events_url":"https://api.github.com/users/nocaway/events{/privacy}","received_events_url":"https://api.github.com/users/nocaway/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/715/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/715/timeline","performed_via_github_app":null,"state_reason":"completed"}