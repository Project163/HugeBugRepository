/netty/issues/4707. \r\nIt makes `jzlib` dependency redundant, as JDK based implmentation is used. If someone needs to use `jzlib` dependency, then it's required to set the corresponding netty flag and to add this library explicitly to the local project dependencies.","reactions":{"url":"https://api.github.com/repos/valfirst/browserup-proxy/issues/465/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/valfirst/browserup-proxy/issues/465/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":16151048929,"node_id":"REFE_lADOABA-c84HjVHczwAAAAPCrXLh","url":"https://api.github.com/repos/netty/netty/issues/events/16151048929","actor":{"login":"valfirst","id":5081226,"node_id":"MDQ6VXNlcjUwODEyMjY=","avatar_url":"https://avatars.githubusercontent.com/u/5081226?v=4","gravatar_id":"","url":"https://api.github.com/users/valfirst","html_url":"https://github.com/valfirst","followers_url":"https://api.github.com/users/valfirst/followers","following_url":"https://api.github.com/users/valfirst/following{/other_user}","gists_url":"https://api.github.com/users/valfirst/gists{/gist_id}","starred_url":"https://api.github.com/users/valfirst/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/valfirst/subscriptions","organizations_url":"https://api.github.com/users/valfirst/orgs","repos_url":"https://api.github.com/users/valfirst/repos","events_url":"https://api.github.com/users/valfirst/events{/privacy}","received_events_url":"https://api.github.com/users/valfirst/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"eb5707d13661579dcc205ac324ffbdacc9e003e2","commit_url":"https://api.github.com/repos/valfirst/browserup-proxy/commits/eb5707d13661579dcc205ac324ffbdacc9e003e2","created_at":"2025-02-01T20:59:28Z","performed_via_github_app":null}]