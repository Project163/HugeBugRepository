+    name = 'platform_bar',
+    constraint_values = [':value_bar'],
+)
+EOF
+
+  cat >> WORKSPACE <<EOF
+register_toolchains('//${pkg}/platform:all')
+register_execution_platforms('//${pkg}/platform:all')
