` branch unless they are specific to current release. Storybook maintainers cherry-pick bug and documentation fixes into the `master` branch as part of the release process, so you shouldn't need to worry about this.\r\n\r\nMaintainers: Please tag your pull request with at least one of the following:\r\n`[\"cleanup\", \"BREAKING CHANGE\", \"feature request\", \"bug\", \"documentation\", \"maintenance\", \"dependencies\", \"other\"]`\r\n\r\n-->\r\n","reactions":{"url":"https://api.github.com/repos/storybookjs/storybook/issues/12389/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/storybookjs/storybook/issues/12389/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":3732953945,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDM3MzI5NTM5NDU=","url":"https://api.github.com/repos/storybookjs/storybook/issues/events/3732953945","actor":{"login":"nknapp","id":636150,"node_id":"MDQ6VXNlcjYzNjE1MA==","avatar_url":"https://avatars.githubusercontent.com/u/636150?v=4","gravatar_id":"","url":"https://api.github.com/users/nknapp","html_url":"https://github.com/nknapp","followers_url":"https://api.github.com/users/nknapp/followers","following_url":"https://api.github.com/users/nknapp/following{/other_user}","gists_url":"https://api.github.com/users/nknapp/gists{/gist_id}","starred_url":"https://api.github.com/users/nknapp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nknapp/subscriptions","organizations_url":"https://api.github.com/users/nknapp/orgs","repos_url":"https://api.github.com/users/nknapp/repos","events_url":"https://api.github.com/users/nknapp/events{/privacy}","received_events_url":"https://api.github.com/users/nknapp/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"1e802aaf9c36bd4c32af30a2ca7ab268366721b5","commit_url":"https://api.github.com/repos