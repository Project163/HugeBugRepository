as_pages":false,"has_discussions":true,"forks_count":9808,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":2246,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["angular","components","design-systems","documentation","html","javascript","react","react-native","stories","storybook","styleguide","svelte","testing","typescript","ui","vite","vue","web-components","webpack","workshop"],"visibility":"public","forks":9808,"open_issues":2246,"watchers":88816,"default_branch":"next","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/storybookjs/storybook/pulls/2588","html_url":"https://github.com/storybookjs/storybook/pull/2588","diff_url":"https://github.com/storybookjs/storybook/pull/2588.diff","patch_url":"https://github.com/storybookjs/storybook/pull/2588.patch","merged_at":"2017-12-28T03:00:00Z"},"body":"For #2587\r\n\r\nIssue:\r\n\r\nTo avoid unnecessarily re-rendering stories we don't re-render if the story name+kind haven't changed.\r\n\r\nHowever on HMR, this leads to not rerendering / breakage, as in this case the name/kind haven't changed, but the store's implementation itself changed.\r\n\r\n## What I did\r\n\r\nI added the concept of a revision to the storystore. This implies that the same name+kind can be different as the store itself has changed. I got the idea from styleguidist which I think saw something similar in when I was reading their source ;)\r\n\r\nMoving forward, if we want dynamic stores (yes please!) we may need to generalise the concept of revision to meaning more just \"incrementing on each HMR\". \r\n\r\n## How to test\r\n\r\nTry changing stories implementations in the kitchen sink.\r\n\r\nIs this testable with jest or storyshots? No\r\n\r\nDoes this need a new example in the kitchen sink apps? No\r\n\r\nDoes this need an update to the documentation? No\r\n\r\n**We should ensure this is merged into https://github.com/storybooks/storybook/pull/2241**","reactions":{"url":"https://api.github.com/repos/storybookjs/storybook/issues/2588/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/storybookjs/storybook/issues/2588/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/storybookjs/storybook/issues/comments/354204702","html_url":"https://github.com/storybookjs/storybook/issues/2587#issuecomment-354204702","issue_url":"https://api.github.com/repos/storybookjs/storybook/issues/2587","id":354204702,"node_id":"MDEyOklzc3VlQ29tbWVudDM1NDIwNDcwMg==","user":{"login":"tmeasday","id":132554,"node_id":"MDQ6VXNlcjEzMjU1NA==","avatar_url":"https://avatars.githubusercontent.com/u/132554?v=4","gravatar_id":"","url":"https://api.github.com/users/tmeasday","html_url":"https://github.com/tmeasday","followers_url":"https://api.github.com/users/tmeasday/followers","following_url":"https://api.github.com/users/tmeasday/following{/other_user}","gists_url":"https://api.github.com/users/tmeasday/gists{/gist_id}","starred_url":"https://api.github.com/users/tmeasday/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tmeasday/subscriptions","organizations_url":"https://api.github.com/users/tmeasday/orgs","repos_url":"https://api.github.com/users/tmeasday/repos","events_url":"https://api.github.com/users/tmeasday/events{/privacy}","received_events_url":"https://api.github.com/users/tmeasday/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-12-28T00:39:18Z","updated_at":"2017-12-28T00:39:18Z","body":"See https://github.com/storybooks/storybook/pull/2588","author_association":"MEMBER","reactions":{"url":"https://api.g