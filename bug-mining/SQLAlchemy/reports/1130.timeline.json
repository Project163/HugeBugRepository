/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/823378368","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/6326#issuecomment-823378368","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/6326","id":823378368,"node_id":"MDEyOklzc3VlQ29tbWVudDgyMzM3ODM2OA==","user":{"login":"jdavcs","id":6132258,"node_id":"MDQ6VXNlcjYxMzIyNTg=","avatar_url":"https://avatars.githubusercontent.com/u/6132258?v=4","gravatar_id":"","url":"https://api.github.com/users/jdavcs","html_url":"https://github.com/jdavcs","followers_url":"https://api.github.com/users/jdavcs/followers","following_url":"https://api.github.com/users/jdavcs/following{/other_user}","gists_url":"https://api.github.com/users/jdavcs/gists{/gist_id}","starred_url":"https://api.github.com/users/jdavcs/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jdavcs/subscriptions","organizations_url":"https://api.github.com/users/jdavcs/orgs","repos_url":"https://api.github.com/users/jdavcs/repos","events_url":"https://api.github.com/users/jdavcs/events{/privacy}","received_events_url":"https://api.github.com/users/jdavcs/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-04-20T15:42:57Z","updated_at":"2021-04-20T16:04:00Z","body":"[EDIT: this comment was written and posted before the updates above]\r\nThanks for the fast response! Yes, I assumed the eager loaders change was contributing to this (one key difference I noticed is that, unlike 1.3, which expired column-oriented attributes, 1.4 also expired *all relationship() attributes*. Manually removing the offending relationship attribute key from `expired_attributes` would prevent that relationship from eager loading on attribute access).\r\n\r\n> autocommit=True is going to be removed from SQLAlchemy within a year, so it might be worthwhile to modernize your application before even moving to 1.4 if setting expire_on_commit=False is not an option.\r\n\r\nOh yes, we are modernizing and `autocommit=True` will go away. Thank you for the suggestion - our initial intent was to update that incrementally (on dev, not production), but now that you mention it, I suppose we may do this before even merging into dev. Thanks!\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/823378368/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"jdavcs","id":6132258,"node_id":"MDQ6VXNlcjYxMzIyNTg=","avatar_url":"https://avatars.githubusercontent.com/u/6132258?v=4","gravatar_id":"","url":"https://api.github.com/users/jdavcs","html_url":"https://github.com/jdavcs","followers_url":"https://api.github.com/users/jdavcs/followers","following_url":"https://api.github.com/users/jdavcs/following{/other_user}","gists_url":"https://api.github.com/users/jdavcs/gists{/gist_id}","starred_url":"https://api.github.com/users/jdavcs/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jdavcs/subscriptions","organizations_url":"https://api.github.com/users/jdavcs/orgs","repos_url":"https://api.github.com/users/jdavcs/repos","events_url":"https://api.github.com/users/jdavcs/events{/privacy}","received_events_url":"https://api.github.com/users/jdavcs/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":4620473068,"node_id":"MDEx