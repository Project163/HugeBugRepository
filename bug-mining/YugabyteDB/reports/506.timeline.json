1, k2);\r\nSELECT ... WHERE h = 1 and r1 =1 and k1 =1\r\n```\r\nFor PRIMARY PATH, the above SELECT has number key-count as ```2```\r\nFor SECONDARY PATH, the above SELECT has number key-count as ```3```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/806503661/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"nocaway","id":31016169,"node_id":"MDQ6VXNlcjMxMDE2MTY5","avatar_url":"https://avatars.githubusercontent.com/u/31016169?v=4","gravatar_id":"","url":"https://api.github.com/users/nocaway","html_url":"https://github.com/nocaway","followers_url":"https://api.github.com/users/nocaway/followers","following_url":"https://api.github.com/users/nocaway/following{/other_user}","gists_url":"https://api.github.com/users/nocaway/gists{/gist_id}","starred_url":"https://api.github.com/users/nocaway/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nocaway/subscriptions","organizations_url":"https://api.github.com/users/nocaway/orgs","repos_url":"https://api.github.com/users/nocaway/repos","events_url":"https://api.github.com/users/nocaway/events{/privacy}","received_events_url":"https://api.github.com/users/nocaway/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":4542461682,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDQ1NDI0NjE2ODI=","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/4542461682","actor":{"login":"nocaway","id":31016169,"node_id":"MDQ6VXNlcjMxMDE2MTY5","avatar_url":"https://avatars.githubusercontent.com/u/31016169?v=4","gravatar_id":"","url":"https://api.github.com/users/nocaway","html_url":"https://github.com/nocaway","followers_url":"https://api.github.com/users/nocaway/followers","following_url":"https://api.github.com/users/nocaway/following{/other_user}","gists_url":"https://api.github.com/