tps://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":"a06d1526216f651f415e9aff56f8d7a725501dc8","commit_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/commits/a06d1526216f651f415e9aff56f8d7a725501dc8","created_at":"2023-06-19T14:32:13Z","state_reason":null,"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1611266328","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/9963#issuecomment-1611266328","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/9963","id":1611266328,"node_id":"IC_kwDOCX5JB85gCfkY","user":{"login":"Daverball","id":5726519,"node_id":"MDQ6VXNlcjU3MjY1MTk=","avatar_url":"https://avatars.githubusercontent.com/u/5726519?v=4","gravatar_id":"","url":"https://api.github.com/users/Daverball","html_url":"https://github.com/Daverball","followers_url":"https://api.github.com/users/Daverball/followers","following_url":"https://api.github.com/users/Daverball/following{/other_user}","gists_url":"https://api.github.com/users/Daverball/gists{/gist_id}","starred_url":"https://api.github.com/users/Daverball/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Daverball/subscriptions","organizations_url":"https://api.github.com/users/Daverball/orgs","repos_url":"https://api.github.com/users/Daverball/repos","events_url":"https://api.github.com/users/Daverball/events{/privacy}","received_events_url":"https://api.github.com/users/Daverball/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-28T11:54:36Z","updated_at":"2023-06-28T11:54:36Z","body":"@zzzeek Is it possible this change broke mapping enums derived from `enum.Enum` directly, without adding an explicit entry into the type annotation map? I have been getting the exact error this was trying to avoid since upgrading and it was working fine before as far as I can tell.\r\n\r\nHaving to add an explicit entry for each enum type seems a bit cumbersome. There's a good chance each enum type will only be used in one table, so if I have to create an entry into the type annotation map, I might as well pass in the `sqlalchemy.Enum` type into `mapped_column`, I just move the code from one place to another.\r\n\r\nIt also causes circular dependency issues unless the enum definition is moved outside the file that defined the model, which is trying to use the enum, since the base class needs to import the enum and the model needs to import the base class.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1611266328/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Daverball","id":5726519,"node_id":"MDQ6VXNlcjU3MjY1MTk=","avatar_url":"https://avatars.githubusercontent.com/u/5726519?v=4","gravatar_id":"","url":"https://api.github.com/users/Daverball","html_url":"https://github.com/Daverball","followers_url":"https://api.github.com/users/Daverball/followers","following_url":"https://api.github.com/users/Daverball/following{/other_user}","gists_url":"https://api.github.com/users/Daverball/gists{/gist_id}","starred_url":"https://api.github.com/users/Daverball/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Daverball/subscriptions","organizations_url":"https://api.github.com/users/Daverball/orgs","repos_url":"https://api.github.com/users/Daverball/repos","events_url":"https://api.github.com/users/Daverball/events{/privacy}","received_events_url":"https://api.github.com/users/Daverball/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":9663705230,"node_id":"MEE_lADOCX5JB85o4bLzzwAAAAJAAHCO","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/9663705230","actor":{"login":"zz