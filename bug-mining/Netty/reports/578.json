escription":"","creator":{"login":"normanmaurer","id":439362,"node_id":"MDQ6VXNlcjQzOTM2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/439362?v=4","gravatar_id":"","url":"https://api.github.com/users/normanmaurer","html_url":"https://github.com/normanmaurer","followers_url":"https://api.github.com/users/normanmaurer/followers","following_url":"https://api.github.com/users/normanmaurer/following{/other_user}","gists_url":"https://api.github.com/users/normanmaurer/gists{/gist_id}","starred_url":"https://api.github.com/users/normanmaurer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/normanmaurer/subscriptions","organizations_url":"https://api.github.com/users/normanmaurer/orgs","repos_url":"https://api.github.com/users/normanmaurer/repos","events_url":"https://api.github.com/users/normanmaurer/events{/privacy}","received_events_url":"https://api.github.com/users/normanmaurer/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":68,"state":"closed","created_at":"2016-10-14T09:12:18Z","updated_at":"2017-01-12T11:35:43Z","due_on":null,"closed_at":"2017-01-12T11:35:43Z"},"comments":5,"created_at":"2016-11-15T20:42:43Z","updated_at":"2016-11-21T17:24:22Z","closed_at":"2016-11-21T06:50:02Z","author_association":"MEMBER","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"LastInboundHandler maintains 2 queues which may contain \"inbound messages\". 1 queue which just contains \"inbound messages\" (`inboundMessages` [1]) and another queue that contains \"inbound messages\" and \"user events\" (`inboundMessagesAndUserEvents` [2]). The `readInbound()` method attempts to de-dup from these 2 queues by assuming that if an event is on the  `inboundMessages` queue it will also be the next element on the `inboundMessagesAndUserEvents` queue. It seems like this assumption does not necessarily hold and can lead to unexpected interactions in unit tests (`Http2FrameCodecTest#entityRequestEntityResponse`) where an `Http2DataFrame` is read via `readInbound()`, popped from the `inboundMessages`, but still remains in the `inboundMessagesAndUserEvents` queue. The side effect of this is `Http2DataFrame` cannot be released by the caller of `readInbound()` because it may be released later by `finishAndReleaseAll` [4].\r\n\r\nOriginally discussed here:\r\nhttps://github.com/netty/netty/pull/5996#discussion_r87312089\r\n\r\n[1] https://github.com/netty/netty/blob/4.1/codec-http2/src/test/java/io/netty/handler/codec/http2/LastInboundHandler.java#L36\r\n[2] https://github.com/netty/netty/blob/4.1/codec-http2/src/test/java/io/netty/handler/codec/http2/LastInboundHandler.java#L38\r\n[3] https://github.com/netty/netty/blob/4.1/codec-http2/src/test/java/io/netty/handler/codec/http2/LastInboundHandler.java#L103\r\n[4] https://github.com/netty/netty/blob/4.1/codec-http2/src/test/java/io/netty/handler/codec/http2/LastInboundHandler.java#L153","closed_by":{"login":"normanmaurer","id":439362,"node_id":"MDQ6VXNlcjQzOTM2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/439362?v=4","gravatar_id":"","url":"https://api.github.com/users/normanmaurer","html_url":"https://github.com/normanmaurer","followers_url":"https://api.github.com/users/normanmaurer/followers","following_url":"https://api.github.com/users/normanmaurer/following{/other_user}","gists_url":"https://api.github.com/users/normanmaurer/gists{/gist_id}","starred_url":"https://api.github.com/users/normanmaurer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/normanmaurer/subscriptions","organizations_url":"https://api.github.com/users/normanmaurer/orgs","repos_url":"https://api.github.com/users/normanmaurer/repos","events_url":"https://api.github.com/users/normanmaurer/events{/privacy}","received_events_url":"https://api.github.com/users/normanmaurer/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/netty/netty/issues/6023/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/netty/netty/issues/6023/timeline","performed_via_github_app":null,"state_reason":"completed"}