<item>
            <title>[IGNITE-1863] IgniteAtomicReference.compareAndSet does not work for nulls</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-1863</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;IgniteAtomicReference allows null as a value, but when current value is null, compareAndSet does not work:&lt;/p&gt;

&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;        IgniteAtomicReference&amp;lt;&lt;span class=&quot;code-object&quot;&gt;String&lt;/span&gt;&amp;gt; atomic = ignite.atomicReference(atomicName, &lt;span class=&quot;code-keyword&quot;&gt;null&lt;/span&gt;, &lt;span class=&quot;code-keyword&quot;&gt;true&lt;/span&gt;);

        assertEquals(&lt;span class=&quot;code-keyword&quot;&gt;null&lt;/span&gt;, atomic.get());

        &lt;span class=&quot;code-object&quot;&gt;boolean&lt;/span&gt; res = atomic.compareAndSet(&lt;span class=&quot;code-keyword&quot;&gt;null&lt;/span&gt;, &lt;span class=&quot;code-quote&quot;&gt;&quot;x&quot;&lt;/span&gt;);

        assertTrue(res);                    &lt;span class=&quot;code-comment&quot;&gt;// fail
&lt;/span&gt;        assertEquals(&lt;span class=&quot;code-quote&quot;&gt;&quot;x&quot;&lt;/span&gt;, atomic.get());    &lt;span class=&quot;code-comment&quot;&gt;// fail
&lt;/span&gt;
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</description>
