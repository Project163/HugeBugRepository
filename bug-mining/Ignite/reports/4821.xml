<item>
            <title>[IGNITE-13756] Node crash if select uses index field with wrong type</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-13756</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;Steps to reproduce:&lt;/p&gt;

&lt;p&gt;1. Start node with cache configuration:&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
 &amp;lt;bean name=&lt;span class=&quot;code-quote&quot;&gt;&quot;endpoint-cache&quot;&lt;/span&gt; class=&lt;span class=&quot;code-quote&quot;&gt;&quot;org.apache.ignite.configuration.CacheConfiguration&quot;&lt;/span&gt;&amp;gt;
 &amp;lt;property name=&lt;span class=&quot;code-quote&quot;&gt;&quot;name&quot;&lt;/span&gt; value=&lt;span class=&quot;code-quote&quot;&gt;&quot;endpoint-cache&quot;&lt;/span&gt;/&amp;gt;
 &amp;lt;property name=&lt;span class=&quot;code-quote&quot;&gt;&quot;cacheMode&quot;&lt;/span&gt; value=&lt;span class=&quot;code-quote&quot;&gt;&quot;REPLICATED&quot;&lt;/span&gt;/&amp;gt;
 &amp;lt;property name=&lt;span class=&quot;code-quote&quot;&gt;&quot;atomicityMode&quot;&lt;/span&gt; value=&lt;span class=&quot;code-quote&quot;&gt;&quot;TRANSACTIONAL&quot;&lt;/span&gt;/&amp;gt;

&amp;lt;property name=&lt;span class=&quot;code-quote&quot;&gt;&quot;queryEntities&quot;&lt;/span&gt;&amp;gt;
 &amp;lt;list&amp;gt;
 &amp;lt;bean class=&lt;span class=&quot;code-quote&quot;&gt;&quot;org.apache.ignite.cache.QueryEntity&quot;&lt;/span&gt;&amp;gt;
 &amp;lt;property name=&lt;span class=&quot;code-quote&quot;&gt;&quot;keyType&quot;&lt;/span&gt; value=&lt;span class=&quot;code-quote&quot;&gt;&quot;java.lang.&lt;span class=&quot;code-object&quot;&gt;String&lt;/span&gt;&quot;&lt;/span&gt;/&amp;gt;
 &amp;lt;property name=&lt;span class=&quot;code-quote&quot;&gt;&quot;valueType&quot;&lt;/span&gt; value=&lt;span class=&quot;code-quote&quot;&gt;&quot;endpoints.EndpointCacheValue&quot;&lt;/span&gt;/&amp;gt;

&amp;lt;property name=&lt;span class=&quot;code-quote&quot;&gt;&quot;fields&quot;&lt;/span&gt;&amp;gt;
 &amp;lt;map&amp;gt;
 &amp;lt;entry key=&lt;span class=&quot;code-quote&quot;&gt;&quot;sendTime&quot;&lt;/span&gt; value=&lt;span class=&quot;code-quote&quot;&gt;&quot;java.lang.&lt;span class=&quot;code-object&quot;&gt;Long&lt;/span&gt;&quot;&lt;/span&gt;/&amp;gt;
 &amp;lt;entry key=&lt;span class=&quot;code-quote&quot;&gt;&quot;createdOn&quot;&lt;/span&gt; value=&lt;span class=&quot;code-quote&quot;&gt;&quot;java.lang.&lt;span class=&quot;code-object&quot;&gt;Long&lt;/span&gt;&quot;&lt;/span&gt;/&amp;gt;
 &amp;lt;entry key=&lt;span class=&quot;code-quote&quot;&gt;&quot;userId&quot;&lt;/span&gt; value=&lt;span class=&quot;code-quote&quot;&gt;&quot;java.lang.&lt;span class=&quot;code-object&quot;&gt;Long&lt;/span&gt;&quot;&lt;/span&gt;/&amp;gt;
 &amp;lt;entry key=&lt;span class=&quot;code-quote&quot;&gt;&quot;srvReqId&quot;&lt;/span&gt; value=&lt;span class=&quot;code-quote&quot;&gt;&quot;java.lang.&lt;span class=&quot;code-object&quot;&gt;String&lt;/span&gt;&quot;&lt;/span&gt;/&amp;gt;
 &amp;lt;entry key=&lt;span class=&quot;code-quote&quot;&gt;&quot;processed&quot;&lt;/span&gt; value=&lt;span class=&quot;code-quote&quot;&gt;&quot;java.lang.&lt;span class=&quot;code-object&quot;&gt;Boolean&lt;/span&gt;&quot;&lt;/span&gt;/&amp;gt;
 &amp;lt;/map&amp;gt;
 &amp;lt;/property&amp;gt;

&amp;lt;property name=&lt;span class=&quot;code-quote&quot;&gt;&quot;indexes&quot;&lt;/span&gt;&amp;gt;
 &amp;lt;list&amp;gt;
 &amp;lt;bean class=&lt;span class=&quot;code-quote&quot;&gt;&quot;org.apache.ignite.cache.QueryIndex&quot;&lt;/span&gt;&amp;gt;
 &amp;lt;constructor-arg value=&lt;span class=&quot;code-quote&quot;&gt;&quot;createdOn&quot;&lt;/span&gt;/&amp;gt;
 &amp;lt;/bean&amp;gt;
 &amp;lt;bean class=&lt;span class=&quot;code-quote&quot;&gt;&quot;org.apache.ignite.cache.QueryIndex&quot;&lt;/span&gt;&amp;gt;
 &amp;lt;constructor-arg value=&lt;span class=&quot;code-quote&quot;&gt;&quot;sendTime&quot;&lt;/span&gt;/&amp;gt;
 &amp;lt;/bean&amp;gt;
 &amp;lt;bean class=&lt;span class=&quot;code-quote&quot;&gt;&quot;org.apache.ignite.cache.QueryIndex&quot;&lt;/span&gt;&amp;gt;
 &amp;lt;constructor-arg value=&lt;span class=&quot;code-quote&quot;&gt;&quot;userId&quot;&lt;/span&gt;/&amp;gt;
 &amp;lt;/bean&amp;gt;
 &amp;lt;bean class=&lt;span class=&quot;code-quote&quot;&gt;&quot;org.apache.ignite.cache.QueryIndex&quot;&lt;/span&gt;&amp;gt;
 &amp;lt;constructor-arg value=&lt;span class=&quot;code-quote&quot;&gt;&quot;srvReqId&quot;&lt;/span&gt;/&amp;gt;
 &amp;lt;/bean&amp;gt;
 &amp;lt;bean class=&lt;span class=&quot;code-quote&quot;&gt;&quot;org.apache.ignite.cache.QueryIndex&quot;&lt;/span&gt;&amp;gt;
 &amp;lt;constructor-arg value=&lt;span class=&quot;code-quote&quot;&gt;&quot;processed&quot;&lt;/span&gt;/&amp;gt;
 &amp;lt;/bean&amp;gt;
 &amp;lt;/list&amp;gt;
 &amp;lt;/property&amp;gt;
 &amp;lt;/bean&amp;gt;
 &amp;lt;/list&amp;gt;
 &amp;lt;/property&amp;gt;
 &amp;lt;/bean&amp;gt;
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;2. Insert some data using SQL thin client:&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
0: jdbc:ignite:thin:&lt;span class=&quot;code-comment&quot;&gt;//127.0.0.1:10800&amp;gt; insert into &lt;span class=&quot;code-quote&quot;&gt;&quot;endpoint-cache&quot;&lt;/span&gt;.ENDPOINTCACHEVALUE (_key, SENDTIME,CREATEDON,USERID,SRVREQID,PROCESSED) values (1, 12345, 12345, 123456789, &lt;span class=&quot;code-quote&quot;&gt;&apos;POST&apos;&lt;/span&gt;, True);
&lt;/span&gt;1 row affected (0.206 seconds)
0: jdbc:ignite:thin:&lt;span class=&quot;code-comment&quot;&gt;//127.0.0.1:10800&amp;gt; insert into &lt;span class=&quot;code-quote&quot;&gt;&quot;endpoint-cache&quot;&lt;/span&gt;.ENDPOINTCACHEVALUE (_key, SENDTIME,CREATEDON,USERID,SRVREQID,PROCESSED) values (2, 12345, 12345, 123456789, &lt;span class=&quot;code-quote&quot;&gt;&apos;POST&apos;&lt;/span&gt;, True);
&lt;/span&gt;1 row affected (0.016 seconds)
0: jdbc:ignite:thin:&lt;span class=&quot;code-comment&quot;&gt;//127.0.0.1:10800&amp;gt; insert into &lt;span class=&quot;code-quote&quot;&gt;&quot;endpoint-cache&quot;&lt;/span&gt;.ENDPOINTCACHEVALUE (_key, SENDTIME,CREATEDON,USERID,SRVREQID,PROCESSED) values (3, 12345, 12345, 123456789, &lt;span class=&quot;code-quote&quot;&gt;&apos;POST&apos;&lt;/span&gt;, True);&lt;/span&gt;
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;3. Run select:&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
SELECT CREATEDON,USERID,SRVREQID,PROCESSED FROM &lt;span class=&quot;code-quote&quot;&gt;&quot;endpoint-cache&quot;&lt;/span&gt;.ENDPOINTCACHEVALUE p where SRVREQID=123;
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

