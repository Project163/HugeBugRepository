_url":"https://api.github.com/users/phpeng-ms/subscriptions","organizations_url":"https://api.github.com/users/phpeng-ms/orgs","repos_url":"https://api.github.com/users/phpeng-ms/repos","events_url":"https://api.github.com/users/phpeng-ms/events{/privacy}","received_events_url":"https://api.github.com/users/phpeng-ms/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-02-27T19:29:55Z","updated_at":"2015-02-27T19:32:16Z","body":"@ojw28 Thanks for the explanation. For your second bullet point, if we were to reformat our manifest to follow the 5.4.1 example 6, (i.e. baseUri = https://foobar.com/video/ABCD1234), would the merge be correct with the current ExoPlayer master branch logic or would we still have to wait for a fix? Is there any combination that would give the expected merged URI with the current implementation?\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/76456313/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"phpeng-ms","id":11049484,"node_id":"MDQ6VXNlcjExMDQ5NDg0","avatar_url":"https://avatars.githubusercontent.com/u/11049484?v=4","gravatar_id":"","url":"https://api.github.com/users/phpeng-ms","html_url":"https://github.com/phpeng-ms","followers_url":"https://api.github.com/users/phpeng-ms/followers","following_url":"https://api.github.com/users/phpeng-ms/following{/other_user}","gists_url":"https://api.github.com/users/phpeng-ms/gists{/gist_id}","starred_url":"https://api.github.com/users/phpeng-ms/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/phpeng-ms/subscriptions","organizations_url":"https://api.github.com/users/phpeng-ms/orgs","repos_url":"https://api.github.com/users/phpeng-ms/repos","events_url":"https://api.github.com/users/phpeng-ms/events{/privacy}","received_events_url":"https://