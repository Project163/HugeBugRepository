mer_id=c.customer_id\r\n       LIMIT 10;\r\n\r\n\r\nFor more, go to https://docs.yugabyte.com/latest/sample-data/northwind/\r\n\r\nysqlsh (11.2-YB-2.15.1.0-b0)\r\nType \"help\" for help.\r\n\r\nyb_demo_northwind=# SELECT c.customer_id, c.company_name, o.order_id, o.order_date\r\nyb_demo_northwind-#        FROM orders o INNER JOIN customers c ON o.customer_id=c.customer_id\r\nyb_demo_northwind-#        LIMIT 10;\r\nERROR:  relation \"orders\" does not exist\r\nLINE 2:        FROM orders o INNER JOIN customers c ON o.customer_id...\r\n```","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/14586/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/14586/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]