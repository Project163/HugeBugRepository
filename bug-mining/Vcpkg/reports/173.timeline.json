ge-manager","packages","vcpkg","visual-studio","windows"],"visibility":"public","forks":7235,"open_issues":1320,"watchers":26254,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/microsoft/vcpkg/pulls/18068","html_url":"https://github.com/microsoft/vcpkg/pull/18068","diff_url":"https://github.com/microsoft/vcpkg/pull/18068.diff","patch_url":"https://github.com/microsoft/vcpkg/pull/18068.patch","merged_at":"2021-11-09T19:51:17Z"},"body":"- #### What does your PR fix?  \r\n  This PR fixes 2 include issues with the zstr port that were causing compile errors on projects that used it. It also adds an usage file, so users are directed to put the more sensible `find_path(ZSTR_INCLUDE_DIRS \"zstr.hpp\")` in their CMakeLists instead of `find_path(ZSTR_INCLUDE_DIRS \"strict_fstream.hpp\")`.\r\n  Fixes #16402\r\n  Fixes #18067\r\n\r\n- #### Which triplets are supported/not supported? Have you updated the [CI baseline](https://github.com/microsoft/vcpkg/blob/master/scripts/ci.baseline.txt)?  \r\n  No, zstr is a header only library.\r\n\r\n- #### Does your PR follow the [maintainer guide](https://github.com/microsoft/vcpkg/blob/master/docs/maintainers/maintainer-guide.md)?  \r\n  Yes.\r\n\r\n- #### If you have added/updated a port: Have you run `./vcpkg x-add-version --all` and committed the result?  \r\n  I haven't yet, I'm making this as a draft PR. This is my first PR for vcpkg and i'm not sure whether my fix for #18067 is acceptable or not.\r\n","reactions":{"url":"https://api.github.com/repos/microsoft/vcpkg/issues/18068/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/microsoft/vcpkg/issues/18068/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/microsoft/vcpkg/issues/comments/846498143","html_url":"https://github.com/microsoft/vcpkg/issues/16402#issuecomment-846498143","issue_url":"https://api.github.com/repos/microsoft/vcpkg/issues/16402","id":846498143,"node_id":"MDEyOklzc3VlQ29tbWVudDg0NjQ5ODE0Mw==","user":{"login":"dg0yt","id":13567791,"node_id":"MDQ6VXNlcjEzNTY3Nzkx","avatar_url":"https://avatars.githubusercontent.com/u/13567791?v=4","gravatar_id":"","url":"https://api.github.com/users/dg0yt","html_url":"https://github.com/dg0yt","followers_url":"https://api.github.com/users/dg0yt/followers","following_url":"https://api.github.com/users/dg0yt/following{/other_user}","gists_url":"https://api.github.com/users/dg0yt/gists{/gist_id}","starred_url":"https://api.github.com/users/dg0yt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dg0yt/subscriptions","organizations_url":"https://api.github.com/users/dg0yt/orgs","repos_url":"https://api.github.com/users/dg0yt/repos","events_url":"https://api.github.com/users/dg0yt/events{/privacy}","received_events_url":"https://api.github.com/users/dg0yt/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-05-23T04:04:27Z","updated_at":"2021-05-23T16:09:35Z","body":"> I think the following is the wrong approach:\r\n> \r\n> > ```cmake\r\n> > find_path(ZSTR_INCLUDE_DIRS \"zstr/strict_fstream.hpp\")\r\n> > ```\r\n> \r\n> because you will get the directory were \"zstr/strict_fstream.hpp\" is. But you seem to need the directory where \"strict_fstream.hpp\" is. How about the following:\r\n> \r\n> ```cmake\r\n> find_path(ZSTR_INCLUDE_DIRS \"zstr.hpp\" PATH_SUFFIXES \"zstr\")\r\n> ```\r\n> \r\n> (Note: the public header, not the implementation detail.)\r\n> \r\n> Then you can also use\r\n> \r\n> ```c\r\n> #include <zstr.hpp>\r\n> ```\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/microsoft/vcpkg/issues/comments/846498143/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart"