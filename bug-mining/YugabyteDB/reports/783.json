er_view_type":"public","site_admin":false}],"milestone":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones/2","html_url":"https://github.com/yugabyte/yugabyte-db/milestone/2","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones/2/labels","id":3291123,"node_id":"MDk6TWlsZXN0b25lMzI5MTEyMw==","number":2,"title":"Future","description":"The future work in the longer term roadmap.","creator":{"login":"rkarthik007","id":9641328,"node_id":"MDQ6VXNlcjk2NDEzMjg=","avatar_url":"https://avatars.githubusercontent.com/u/9641328?v=4","gravatar_id":"","url":"https://api.github.com/users/rkarthik007","html_url":"https://github.com/rkarthik007","followers_url":"https://api.github.com/users/rkarthik007/followers","following_url":"https://api.github.com/users/rkarthik007/following{/other_user}","gists_url":"https://api.github.com/users/rkarthik007/gists{/gist_id}","starred_url":"https://api.github.com/users/rkarthik007/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rkarthik007/subscriptions","organizations_url":"https://api.github.com/users/rkarthik007/orgs","repos_url":"https://api.github.com/users/rkarthik007/repos","events_url":"https://api.github.com/users/rkarthik007/events{/privacy}","received_events_url":"https://api.github.com/users/rkarthik007/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":33,"closed_issues":22,"state":"open","created_at":"2018-04-23T21:49:20Z","updated_at":"2024-07-24T18:53:13Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2020-09-29T06:52:09Z","updated_at":"2022-11-01T23:19:50Z","closed_at":"2022-11-01T23:19:50Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Jira Link: [DB-2430](https://yugabyte.atlassian.net/browse/DB-2430)\r\nWhen an error that returns a YB Status occurs in the (metrics) webserver process, we use `HandleYBStatus` to report it.\r\nBut `HandleYBStatus` will use `YBCPalloc` internally when copying over the error string.\r\nBut we do not call `YBCInit` for the webserver (only for the connection backends) so `g_palloc_fn` (the implementation of `YBCPalloc`) is not set.\r\nAs a result, instead of reporting the correct error, the server will fatal due to the `CHECK` above.\r\n\r\nWe should be able to replicate this by introducing a bad status in any function wrapped with `HandleYBStatus` in `yb_pg_metrics.c`.\r\nTo fix, we can probably make sure we initialize g_palloc_fn in the webserver too, otherwise we can handle the statuses (i.e. error reporting) differently there. \r\n","closed_by":{"login":"tedyu","id":235188,"node_id":"MDQ6VXNlcjIzNTE4OA==","avatar_url":"https://avatars.githubusercontent.com/u/235188?v=4","gravatar_id":"","url":"https://api.github.com/users/tedyu","html_url":"https://github.com/tedyu","followers_url":"https://api.github.com/users/tedyu/followers","following_url":"https://api.github.com/users/tedyu/following{/other_user}","gists_url":"https://api.github.com/users/tedyu/gists{/gist_id}","starred_url":"https://api.github.com/users/tedyu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tedyu/subscriptions","organizations_url":"https://api.github.com/users/tedyu/orgs","repos_url":"https://api.github.com/users/tedyu/repos","events_url":"https://api.github.com/users/tedyu/events{/privacy}","received_events_url":"https://api.github.com/users/tedyu/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/5862/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/5862/timeline","performed_via_github_app":null,"state_reason":"co