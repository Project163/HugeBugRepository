github.com/repos/eslint/eslint/labels/accepted","name":"accepted","color":"0052cc","default":false,"description":"There is consensus among the team that this change meets the criteria for inclusion"},{"id":829215248,"node_id":"MDU6TGFiZWw4MjkyMTUyNDg=","url":"https://api.github.com/repos/eslint/eslint/labels/archived%20due%20to%20age","name":"archived due to age","color":"eeeeee","default":false,"description":"This issue has been archived; please open a new issue for any further discussion"}],"state":"closed","locked":true,"assignee":null,"assignees":[],"milestone":null,"comments":7,"created_at":"2015-12-18T12:24:44Z","updated_at":"2018-02-06T23:55:59Z","closed_at":"2015-12-19T02:49:11Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"eslint: v1.10.3\nConfig: `{\"rules\": { \"no-constant-condition\": 2, \"no-array-constructor\": 2 }}`\n\n**Problem:**\n`no-constant-condition` gives a false positive result for the following code:\n\n``` js\nif ( 'every' in [] ) { /* browser supports every */ }\n```\n\nUsing `Array()` instead of `[]` will not result in the error but I have `no-array-constructor` so it still doesn't pass linting.\n\n**Expected:**\nThe results for `[]` and `Array()` are consistent, linting passes.\n\n**Actual:**\nLinting fails.\n\n**Example Code:**\n\n``` js\nif ( 'every' in [] ) { console.log( 1 ) } // → no-constant-condition error\n\nif ( 'every' in Array() ) { console.log( 2 ) } // → no-array-constructor error\n\n/* eslint-disable no-array-constructor */\nif ( 'every' in Array() ) { console.log( 3 ) } // → pass\n/* eslint-enable no-array-constructor */\n\nif ( typeof [].every === 'function' ) { console.log( 4 ) } // → pass\n```\n\n**ESLint Output:**\n\n```\n1:1   error  Unexpected constant condition                 no-constant-condition\n3:17  error  The array literal notation [] is preferrable  no-array-constructor\n```\n","closed_by":{"login":"alberto","id":72561,"node_id":"MDQ6VXNlcjcyNTYx","avatar_url":"https://avatars.githubusercontent.com/u/72561?v=4","gravatar_id":"","url":"https://api.github.com/users/alberto","html_url":"https://github.com/alberto","followers_url":"https://api.github.com/users/alberto/followers","following_url":"https://api.github.com/users/alberto/following{/other_user}","gists_url":"https://api.github.com/users/alberto/gists{/gist_id}","starred_url":"https://api.github.com/users/alberto/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alberto/subscriptions","organizations_url":"https://api.github.com/users/alberto/orgs","repos_url":"https://api.github.com/users/alberto/repos","events_url":"https://api.github.com/users/alberto/events{/privacy}","received_events_url":"https://api.github.com/users/alberto/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/eslint/eslint/issues/4737/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/eslint/eslint/issues/4737/timeline","performed_via_github_app":null,"state_reason":"completed"}