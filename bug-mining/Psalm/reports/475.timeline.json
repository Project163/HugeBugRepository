_type":"public","site_admin":false},"event":"closed","commit_id":"95b986d2d4fbb88e0bc39d0563b7ad62d20c7fcf","commit_url":"https://api.github.com/repos/vimeo/psalm/commits/95b986d2d4fbb88e0bc39d0563b7ad62d20c7fcf","created_at":"2019-03-11T03:38:36Z","state_reason":null,"performed_via_github_app":null},{"url":"https://api.github.com/repos/vimeo/psalm/issues/comments/471395588","html_url":"https://github.com/vimeo/psalm/issues/1367#issuecomment-471395588","issue_url":"https://api.github.com/repos/vimeo/psalm/issues/1367","id":471395588,"node_id":"MDEyOklzc3VlQ29tbWVudDQ3MTM5NTU4OA==","user":{"login":"muglug","id":2292638,"node_id":"MDQ6VXNlcjIyOTI2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/2292638?v=4","gravatar_id":"","url":"https://api.github.com/users/muglug","html_url":"https://github.com/muglug","followers_url":"https://api.github.com/users/muglug/followers","following_url":"https://api.github.com/users/muglug/following{/other_user}","gists_url":"https://api.github.com/users/muglug/gists{/gist_id}","starred_url":"https://api.github.com/users/muglug/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/muglug/subscriptions","organizations_url":"https://api.github.com/users/muglug/orgs","repos_url":"https://api.github.com/users/muglug/repos","events_url":"https://api.github.com/users/muglug/events{/privacy}","received_events_url":"https://api.github.com/users/muglug/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-03-11T03:50:06Z","updated_at":"2019-03-11T03:50:06Z","body":"After about four hours' work I've fixed for the special case where the array is `array<array-key, mixed>` (i.e. no further types).\r\n\r\nBeyond that, it's a hard problem as Psalm only has two ways of representing arrays - generic (`array<foo, bar>`) and objectlike (`array{somefoo:bar,otherfoo:bar}`). Objectlike arrays decompose to generic arrays whenever they're combined with generic arrays:\r\n\r\n```\r\nobjectlike + objectlike => objectlike\r\nobjectlike + generic => generic\r\ngeneric + generic => generic\r\n```\r\n\r\nIn order to support the following, more refined example:\r\n\r\n```php\r\n/**\r\n * @param array<int, Exception> $ret\r\n * @return array{0:InvalidArgumentException,1:InvalidArgumentException}\r\n */\r\nfunction foo(array $ret): array {\r\n    assert($ret[0] instanceof InvalidArgumentException);\r\n    assert($ret[1] instanceof InvalidArgumentException);\r\n    return $ret;\r\n}\r\n```\r\n\r\nhttps://psalm.dev/r/6ce308f46c\r\n\r\nI'd have to allow `objectlike` types to also have generic parameters, and that logic would be _super_ convoluted, so I'd really rather not.\r\n","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/comments/471395588/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"muglug","id":2292638,"node_id":"MDQ6VXNlcjIyOTI2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/2292638?v=4","gravatar_id":"","url":"https://api.github.com/users/muglug","html_url":"https://github.com/muglug","followers_url":"https://api.github.com/users/muglug/followers","following_url":"https://api.github.com/users/muglug/following{/other_user}","gists_url":"https://api.github.com/users/muglug/gists{/gist_id}","starred_url":"https://api.github.com/users/muglug/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/muglug/subscriptions","organizations_url":"https://api.github.com/users/muglug/orgs","repos_url":"https://api.github.com/users/muglug/repos","events_url":"https://api.github.com/users/muglug/events{/privacy}","received_events_url":"https://api.github.com/users/muglug/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/vimeo/psalm/issues/comments/471636898","html_url":"https://github.com/vime