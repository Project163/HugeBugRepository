03-11T11:23:33Z","pushed_at":"2026-03-11T11:26:45Z","git_url":"git://github.com/pytorch/pytorch.git","ssh_url":"org-21003710@github.com:pytorch/pytorch.git","clone_url":"https://github.com/pytorch/pytorch.git","svn_url":"https://github.com/pytorch/pytorch","homepage":"https://pytorch.org","size":1267772,"stargazers_count":98201,"watchers_count":98201,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":27143,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":18135,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["autograd","deep-learning","gpu","machine-learning","neural-network","numpy","python","tensor"],"visibility":"public","forks":27143,"open_issues":18135,"watchers":98201,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"### 🐛 Describe the bug\n\nWhen `groups=0` is passed to `torch.native_channel_shuffle`, CPU used to crash with `FPE`, but it was reported and fixed under [#142453](https://github.com/pytorch/pytorch/issues/142453).\n\nHowever, on latest versions, the cuda version is crashing with `groups=0`.\n\n**Minimal reproduction**\n```python\nimport torch\n\nprint(f\"Torch version: {torch.__version__}\", flush=True)\ngroups = 0\n\ntry:\n    cpu_inp = torch.full((1, 4, 10, 10,), 0.5, dtype=torch.float64, requires_grad=False, device='cpu')\n    torch.native_channel_shuffle(cpu_inp, groups) # no crash\nexcept Exception as e:\n    print(f\"CPU raised an exception: {e}\", flush=True)\n\ntry:\n    gpu_inp = torch.full((1, 4, 10, 10,), 0.5, dtype=torch.float64, requires_grad=False, device='cuda')\n    torch.native_channel_shuffle(gpu_inp, groups) # FPE\nexcept Exception as e:\n    print(f\"GPU raised an exception: {e}\", flush=True)\n```\n\n**Output**\n```\nTorch version: 2.9.0+cu126\nCPU raised an exception: Number of groups to divide channels in must be positive. Value of groups:0\nFloating point exception (core dumped)\n```\n\n### Versions\n\nCollecting environment information...\nPyTorch version: 2.9.0+cu126\nIs debug build: False\nCUDA used to build PyTorch: 12.6\nROCM used to build PyTorch: N/A\n\nOS: Ubuntu 22.04.4 LTS (x86_64)\nGCC version: (Ubuntu 11.4.0-1ubuntu1~22.04.2) 11.4.0\nClang version: Could not collect\nCMake version: version 3.31.10\nLibc version: glibc-2.35\n\nPython version: 3.12.12 (main, Oct 10 2025, 08:52:57) [GCC 11.4.0] (64-bit runtime)\nPython platform: Linux-6.6.105+-x86_64-with-glibc2.35\nIs CUDA available: True\nCUDA runtime version: 12.5.82\nCUDA_MODULE_LOADING set to: \nGPU models and configuration: GPU 0: Tesla T4\nNvidia driver version: 550.54.15\ncuDNN version: Probably one of the following:\n/usr/lib/x86_64-linux-gnu/libcudnn.so.9.2.1\n/usr/lib/x86_64-linux-gnu/libcudnn_adv.so.9.2.1\n/usr/lib/x86_64-linux-gnu/libcudnn_cnn.so.9.2.1\n/usr/lib/x86_64-linux-gnu/libcudnn_engines_precompiled.so.9.2.1\n/usr/lib/x86_64-linux-gnu/libcudnn_engines_runtime_compiled.so.9.2.1\n/usr/lib/x86_64-linux-gnu/libcudnn_graph.so.9.2.1\n/usr/lib/x86_64-linux-gnu/libcudnn_heuristic.so.9.2.1\n/usr/lib/x86_64-linux-gnu/libcudnn_ops.so.9.2.1\nIs XPU available: False\nHIP runtime version: N/A\nMIOpen runtime version: N/A\nIs XNNPACK available: True\n\nCPU:\nArchitecture:                            x86_64\nCPU op-mode(s):                          32-bit, 64-bit\nAddress sizes:                           46 bits physical, 48 bits virtual\nByte Order:                              Little Endian\nCPU(s):                                  2\nOn-line CPU(s) list:                     0,1\nVendor ID:                               GenuineIntel\nModel name:                              Intel(R) Xeon(R) CPU @ 2.20GHz\nCPU family:             