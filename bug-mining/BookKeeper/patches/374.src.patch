-            ;;
-	Linux)
-	    echo "Clearing delay"
-	    sudo tc qdisc del dev lo root
-	    ;;
-	*)
-	    echo "Unknown system type, $UNAME, only Linux, Darwin & FreeBSD supported"
-	    ;;
-    esac
-}
