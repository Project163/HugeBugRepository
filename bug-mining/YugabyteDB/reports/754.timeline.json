epo}","subscriptions_url":"https://api.github.com/users/yugabyte-ci/subscriptions","organizations_url":"https://api.github.com/users/yugabyte-ci/orgs","repos_url":"https://api.github.com/users/yugabyte-ci/repos","events_url":"https://api.github.com/users/yugabyte-ci/events{/privacy}","received_events_url":"https://api.github.com/users/yugabyte-ci/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"unlabeled","commit_id":null,"commit_url":null,"created_at":"2022-09-27T20:54:17Z","label":{"name":"status/awaiting-triage","color":"E33F0D"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1270628386","html_url":"https://github.com/yugabyte/yugabyte-db/issues/14178#issuecomment-1270628386","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/14178","id":1270628386,"node_id":"IC_kwDOBlCVUc5LvEAi","user":{"login":"bmatican","id":395011,"node_id":"MDQ6VXNlcjM5NTAxMQ==","avatar_url":"https://avatars.githubusercontent.com/u/395011?v=4","gravatar_id":"","url":"https://api.github.com/users/bmatican","html_url":"https://github.com/bmatican","followers_url":"https://api.github.com/users/bmatican/followers","following_url":"https://api.github.com/users/bmatican/following{/other_user}","gists_url":"https://api.github.com/users/bmatican/gists{/gist_id}","starred_url":"https://api.github.com/users/bmatican/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bmatican/subscriptions","organizations_url":"https://api.github.com/users/bmatican/orgs","repos_url":"https://api.github.com/users/bmatican/repos","events_url":"https://api.github.com/users/bmatican/events{/privacy}","received_events_url":"https://api.github.com/users/bmatican/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-10-06T20:15:32Z","updated_at":"2022-10-06T20:15:32Z","body":"Copying part of the Slack note\r\n```\r\n it looks like a timing issue, rather than a resource issue! The test fails with\r\n\r\n../../ent/src/yb/integration-tests/cdc_service-int-test.cc:1862: Failure\r\nExpected equality of these values:\r\n  tablet_peer->log()->cdc_min_replicated_index()\r\n    Which is: 0\r\n  std::numeric_limits<int64_t>::max()\r\n    Which is: 9223372036854775807\r\n\r\nThe test code has this assumption\r\n\r\n  // Before any cdc request, the min index should be max value.\r\n  ASSERT_EQ(tablet_peer->log()->cdc_min_replicated_index(), std::numeric_limits<int64_t>::max());\r\n  ASSERT_EQ(tablet_peer->tablet_metadata()->cdc_min_replicated_index(),\r\n            std::numeric_limits<int64_t>::max());\r\n\r\nBut from the logs, it seems that as soon as we create the cdc stream, the bg metrics update thread will be able to run CDCServiceImpl::UpdatePeersAndMetrics -> CDCServiceImpl::UpdateTabletPeersWithMinReplicatedIndex -> tablet_peer->set_cdc_min_replicated_index , which changes the index to 0!\r\n```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1270628386/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"bmatican","id":395011,"node_id":"MDQ6VXNlcjM5NTAxMQ==","avatar_url":"https://avatars.githubusercontent.com/u/395011?v=4","gravatar_id":"","url":"https://api.github.com/users/bmatican","html_url":"https://github.com/bmatican","followers_url":"https://api.github.com/users/bmatican/followers","following_url":"https://api.github.com/users/bmatican/following{/other_user}","gists_url":"https://api.github.com/users/bmatican/gists{/gist_id}","starred_url":"https://api.github.com/users/bmatican/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bmatican/subscriptions","organizations_url":"https://api.github.com/users/bmatican/orgs","repos_url":"https://api.github.com/users/bmatican/repos","events_url":"https://api.github.com/users/bmatican/events{/privacy}","received_events_url":"https://api.github.com/users/bmatican/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1270756056","html_url":"https://github.com/yugabyte/yugabyte-db/issues/14178#issuecomment-1270756056","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/14178","id":1270756056,"node_id":"IC_kwDOBlCVUc5LvjLY","user":{"login":"nspiegelberg","id":53198280,"node_id":"MDQ6VXNlcjUzMTk4Mjgw","avatar_url":"https://avatars.githubusercontent.com/u/53198280?v=4","gravatar_id":"","url":"https://api.github.com/users/nspiegelberg","html_url":"https://github.com/nspiegelberg","followers_url":"https://api.github.com/users/nspiegelberg/followers","following_url":"https://api.github.com/users/nspiegelberg/following{/other_user}","gists_url":"https://api.github.com/users/nspiegelberg/gists{/gist_id}","starred_url":"https://api.github.com/users/nspiegelberg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nspiegelberg/subscriptions","organizations_url":"https://api.github.com/users/nspiegelberg/orgs","repos_url":"https://api.github.com/users/nspiegelberg/repos","events_url":"https://api.github.com/users/nspiegelberg/events{/privacy}","received_events_url":"https://api.github.com/users/nspiegelberg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-10-06T22:16:37Z","updated_at":"2022-10-06T22:16:37Z","body":"@nspiegelberg \r\n> I think this is the result of changed behavior.  The background thread used to start upon the first GetChanges request.\r\n> int64::max() would mean that log GC works normal (e.g. CDC is absent) until the first read sets the OpID.\r\n> 0 would mean that log GC retains OpID 0.0, so the first entry. \r\n@hulien22 \r\n> I think this was changed as part of a change for additional producer side metrics (since otherwis