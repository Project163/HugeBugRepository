[{"id":4554103080,"node_id":"MDEyOkxhYmVsZWRFdmVudDQ1NTQxMDMwODA=","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/4554103080","actor":{"login":"JunyuanChen","id":75352049,"node_id":"MDQ6VXNlcjc1MzUyMDQ5","avatar_url":"https://avatars.githubusercontent.com/u/75352049?v=4","gravatar_id":"","url":"https://api.github.com/users/JunyuanChen","html_url":"https://github.com/JunyuanChen","followers_url":"https://api.github.com/users/JunyuanChen/followers","following_url":"https://api.github.com/users/JunyuanChen/following{/other_user}","gists_url":"https://api.github.com/users/JunyuanChen/gists{/gist_id}","starred_url":"https://api.github.com/users/JunyuanChen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JunyuanChen/subscriptions","organizations_url":"https://api.github.com/users/JunyuanChen/orgs","repos_url":"https://api.github.com/users/JunyuanChen/repos","events_url":"https://api.github.com/users/JunyuanChen/events{/privacy}","received_events_url":"https://api.github.com/users/JunyuanChen/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2021-04-06T01:51:27Z","label":{"name":"requires triage","color":"ffff00"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/813767575","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/6204#issuecomment-813767575","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/6204","id":813767575,"node_id":"MDEyOklzc3VlQ29tbWVudDgxMzc2NzU3NQ==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-04-06T01:59:34Z","updated_at":"2021-04-06T01:59:34Z","body":"> **Describe the bug**\r\n> \r\n> When using `sqlalchemy.literal` in a CTE with SQLite3, sqlite3 module complains about incorrect number of bindings.\r\n> However, without using a CTE everything will work just fine.\r\n> \r\n> ```python\r\n> import sqlalchemy\r\n> \r\n> \r\n> engine = sqlalchemy.create_engine(\"sqlite://\")\r\n> literal = sqlalchemy.literal(1)  # DEMO\r\n> cte = sqlalchemy.select([literal]).cte()  # (1)\r\n> engine.execute(cte)  #=> Error\r\n\r\nthere's a bug in SQLAlchemy here however it's that it's failing ungracefully; you should not be able to \"execute\" a CTE because it's not a SELECT statement, it's only a fragment of one.\r\n\r\nto fix your application ensure you execute a SELECT statement:\r\n\r\n```\r\nwith engine.connect() as conn:\r\n    conn.execute(cte.select())\r\n\r\n```\r\n\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/813767575/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/us