eager, declarative_base, joinedload, relationship\n\nBase = declarative_base()\n\n\nclass A(Base):\n    __tablename__ = \"a\"\n    id = Column(Integer, primary_key=True)\n    bs = relationship(\"B\")\n\n    latest_b = relationship(\n        lambda: B,\n        primaryjoin=lambda: and_(\n            A.id == B.a_id,\n            B.date\n            == select(func.max(B.date))\n            .where(B.a_id == A.id)\n            .correlate(A.__table__)\n            .scalar_subquery(),\n        ),\n        viewonly=True,\n    )\n\n\nclass B(Base):\n    __tablename__ = \"b\"\n    id = Column(Integer, primary_key=True)\n    a_id = Column(Integer, ForeignKey(\"a.id\"))\n    date = Column(Date)\n\n    def __repr__(self):\n        return f\"B(date={repr(self.date)})\"\n\n\nsubq = (\n    select(B.a_id, func.max(B.date).label(\"date\"))\n    .group_by(B.a_id)\n    .subquery()\n)\nb_subq = aliased(B, subq)\n\nstmt = (\n    select(A)\n    .join(A.bs)\n    .join(A.bs.of_type(b_subq))\n    .where(b_subq.date == B.date)\n)\nprint(stmt)\n\n```\n\nthe above usage needs adapt_on_names to work correctly:\n\n```\nSELECT a.id \nFROM a JOIN b ON a.id = b.a_id JOIN (SELECT b.a_id AS a_id, max(b.date) AS date \nFROM b GROUP BY b.a_id) AS anon_1 ON a.id = anon_1.a_id \nWHERE b.date = b.date\n\n```\n\nbut nobody knows how to do that.  add a warning that lets them know","closed_by":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalc