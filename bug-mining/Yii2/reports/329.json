ex.php\ngo to `index.php?r=site%2Fajax-hello`, make sure it works\n\n``` diff\ndiff --git a/controllers/SiteController.php b/controllers/SiteController.php\nindex f959941..9c92bba 100644\n--- a/controllers/SiteController.php\n+++ b/controllers/SiteController.php\n@@ -93,4 +93,10 @@ class SiteController extends Controller\n     {\n         return $this->render('about');\n     }\n+\n+    public function actionAjaxHello()\n+    {\n+        \\Yii::$app->response->format = \\yii\\web\\Response::FORMAT_JSON;\n+        return ['hello'=>'world'];\n+    }\n }\ndiff --git a/web/index.php b/web/index.php\nindex d1e070a..7960bb4 100644\n--- a/web/index.php\n+++ b/web/index.php\n@@ -10,3 +10,5 @@ require(__DIR__ . '/../vendor/yiisoft/yii2/Yii.php');\n $config = require(__DIR__ . '/../config/web.php');\n\n (new yii\\web\\Application($config))->run();\n+\n+## Just trigger notice\n+$no['no'];\n\\ No newline at end of file\n```\n\nHow i made sure it's `ob_start()` stuff - this kludge turns AJAX back on:\n\n``` diff\ndiff --git a/web/Response.php b/web/Response.php\nindex 7cbc831..e7efda0 100644\n--- a/web/Response.php\n+++ b/web/Response.php\n@@ -388,6 +388,11 @@ class Response extends \\yii\\base\\Response\n     protected function sendContent()\n     {\n         if ($this->stream === null) {\n+\n+            while( ob_get_level() ) {\n+                ob_end_flush();\n+            }\n+\n             echo $this->content;\n\n             return;\n```\n","closed_by":{"login":"qiangxue","id":993322,"node_id":"MDQ6VXNlcjk5MzMyMg==","avatar_url":"https://avatars.githubusercontent.com/u/993322?v=4","gravatar_id":"","url":"https://api.github.com/users/qiangxue","html_url":"https://github.com/qiangxue","followers_url":"https://api.github.com/users/qiangxue/followers","following_url":"https://api.github.com/users/qiangxue/following{/other_user}","gists_url":"https://api.github.com/users/qiangxue/gists{/gist_id}","starred_url":"https://api.github.com/users/qiangxue/starred{/owner}{/repo}","su