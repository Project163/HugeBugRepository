[{"id":10195281512,"node_id":"LE_lADOBC3Cis5vTl_AzwAAAAJfr6Zo","url":"https://api.github.com/repos/vercel/next.js/issues/events/10195281512","actor":{"login":"jd-carroll","id":1885864,"node_id":"MDQ6VXNlcjE4ODU4NjQ=","avatar_url":"https://avatars.githubusercontent.com/u/1885864?v=4","gravatar_id":"","url":"https://api.github.com/users/jd-carroll","html_url":"https://github.com/jd-carroll","followers_url":"https://api.github.com/users/jd-carroll/followers","following_url":"https://api.github.com/users/jd-carroll/following{/other_user}","gists_url":"https://api.github.com/users/jd-carroll/gists{/gist_id}","starred_url":"https://api.github.com/users/jd-carroll/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jd-carroll/subscriptions","organizations_url":"https://api.github.com/users/jd-carroll/orgs","repos_url":"https://api.github.com/users/jd-carroll/repos","events_url":"https://api.github.com/users/jd-carroll/events{/privacy}","received_events_url":"https://api.github.com/users/jd-carroll/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2023-08-25T17:08:45Z","label":{"name":"template: bug","color":"fddf99"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1693685276","html_url":"https://github.com/vercel/next.js/issues/54571#issuecomment-1693685276","issue_url":"https://api.github.com/repos/vercel/next.js/issues/54571","id":1693685276,"node_id":"IC_kwDOBC3Cis5k85Yc","user":{"login":"jd-carroll","id":1885864,"node_id":"MDQ6VXNlcjE4ODU4NjQ=","avatar_url":"https://avatars.githubusercontent.com/u/1885864?v=4","gravatar_id":"","url":"https://api.github.com/users/jd-carroll","html_url":"https://github.com/jd-carroll","followers_url":"https://api.github.com/users/jd-carroll/followers","following_url":"https://api.github.com/users/jd-carroll/following{/other_user}","gists_url":"https://api.github.com/users