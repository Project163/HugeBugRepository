        'allowNullableNulls' => true,\r\n            'message' => 'will error with array_combine warning']));\r\n        $this->assertInstanceOf('Cake\\ORM\\Entity', $table->saveMany($entities));\r\n    }\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/377507684/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Nic0tiN","id":978619,"node_id":"MDQ6VXNlcjk3ODYxOQ==","avatar_url":"https://avatars.githubusercontent.com/u/978619?v=4","gravatar_id":"","url":"https://api.github.com/users/Nic0tiN","html_url":"https://github.com/Nic0tiN","followers_url":"https://api.github.com/users/Nic0tiN/followers","following_url":"https://api.github.com/users/Nic0tiN/following{/other_user}","gists_url":"https://api.github.com/users/Nic0tiN/gists{/gist_id}","starred_url":"https://api.github.com/users/Nic0tiN/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nic0tiN/subscriptions","organizations_url":"https://api.github.com/users/Nic0tiN/orgs","repos_url":"https://api.github.com/users/Nic0tiN/repos","events_url":"https://api.github.com/users/Nic0tiN/events{/privacy}","received_events_url":"https://api.github.com/users/Nic0tiN/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1549791477,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDE1NDk3OTE0Nzc=","url":"https://api.github.com/repos/cakephp/cakephp/issues/events/1549791477","actor":{"login":"Nic0tiN","id":978619,"node_id":"MDQ6VXNlcjk3ODYxOQ==","avatar_url":"https://avatars.githubusercontent.com/u/978619?v=4","gravatar_id":"","url":"https://api.github.com/users/Nic0tiN","html_url":"https://github.com/Nic0tiN","followers_url":"https://api.github.com/users/Nic0tiN/followers","following_url":"https://api.github.com/users/Nic0tiN/following{/other_user}","gists_url":"https://api.github.com/users/Nic0tiN/gi