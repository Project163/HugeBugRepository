+    def test_sql_stamp_revision_as_kw(self):
+        with capture_context_buffer() as buf:
+            command.stamp(self.cfg, revision="head", sql=True)
+        assert (
+            "INSERT INTO alembic_version (version_num) VALUES ('%s')" % self.c
+            in buf.getvalue()
