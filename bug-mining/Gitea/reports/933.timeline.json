thub.com/repos/go-gitea/gitea/commits/b878155b8741c2769b6aa50a80609c36822451c9","created_at":"2023-01-08T18:25:30Z","performed_via_github_app":null},{"id":8176937302,"node_id":"RTE_lADOBFIx285a31BvzwAAAAHnYilW","url":"https://api.github.com/repos/go-gitea/gitea/issues/events/8176937302","actor":{"login":"zeripath","id":1824502,"node_id":"MDQ6VXNlcjE4MjQ1MDI=","avatar_url":"https://avatars.githubusercontent.com/u/1824502?v=4","gravatar_id":"","url":"https://api.github.com/users/zeripath","html_url":"https://github.com/zeripath","followers_url":"https://api.github.com/users/zeripath/followers","following_url":"https://api.github.com/users/zeripath/following{/other_user}","gists_url":"https://api.github.com/users/zeripath/gists{/gist_id}","starred_url":"https://api.github.com/users/zeripath/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zeripath/subscriptions","organizations_url":"https://api.github.com/users/zeripath/orgs","repos_url":"https://api.github.com/users/zeripath/repos","events_url":"https://api.github.com/users/zeripath/events{/privacy}","received_events_url":"https://api.github.com/users/zeripath/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2023-01-08T18:26:19Z","rename":{"from":"SPELLING: The word 'CAN NOT' IS SPELLED 'CANNOT'","to":"`CANNOT` is almost always preferred to 'CAN NOT'"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/go-gitea/gitea/issues/comments/1374900253","html_url":"https://github.com/go-gitea/gitea/issues/22371#issuecomment-1374900253","issue_url":"https://api.github.com/repos/go-gitea/gitea/issues/22371","id":1374900253,"node_id":"IC_kwDOBFIx285R81Ad","user":{"login":"zeripath","id":1824502,"node_id":"MDQ6VXNlcjE4MjQ1MDI=","avatar_url":"https://avatars.githubusercontent.com/u/1824502?v=4","gravatar_id":"","url":"https://api.github.com/users/zeripath","html_url":"https://github.com/zeripath","followers_url":"https://api.github.com/users/zeripath/followers","following_url":"https://api.github.com/users/zeripath/following{/other_user}","gists_url":"https://api.github.com/users/zeripath/gists{/gist_id}","starred_url":"https://api.github.com/users/zeripath/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zeripath/subscriptions","organizations_url":"https://api.github.com/users/zeripath/orgs","repos_url":"https://api.github.com/users/zeripath/repos","events_url":"https://api.github.com/users/zeripath/events{/privacy}","received_events_url":"https://api.github.com/users/zeripath/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-01-08T18:40:52Z","updated_at":"2023-01-08T18:40:52Z","body":"As a native British English speaker - I can assure you that `CAN NOT` is valid English. However, in modern contexts it's almost always only used when you want to expressly present something as an option, usually in a sarcastic way.\r\n\r\nFor example, `You can NOT get into arguments about grammar and spelling, it's far from obligatory...` So yes I would argue we should switch to `CANNOT` over `CAN NOT`.\r\n\r\nNow, generally `CAN'T` has been thought of as being informal - but it's definitely sneaked its way into formal arenas and is taking over from `CANNOT` except where you want to express emphasis or where there is no personal pronoun. It might be the case that we want: `You can't do X` instead of `You cannot do X` for at least some of the cases. However, I'm sure you would agree that the sentence `CAN'T do X` would be too informal in comparison to `CANNOT do X` (note no `you` in these).","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/go-gitea/gitea/issues/comments/1374900253/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zeripath","id":1824502,"node_id":"MDQ6VXNlcjE4MjQ1MDI=","avatar_url":"https://avatars.githubusercontent.com/u/1824502?v=4","gravatar_id":"","url":"https://api.github.com/users/zeripath","html_url":"https://github.com/zeripath","followers_url":"https://api.github.com/users/zeripath/followers","following_url":"https://api.github.com/users/zeripath/following{/other_user}","gists_url":"https://api.github.com/users/zeripath/gists{/gist_id}","starred_url":"https://api.github.com/users/zeripath/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zeripath/subscriptions","organizations_url":"https://api.github.com/users/zeripath/orgs","repos_url":"https://api.github.com/users/zeripath/repos","events_url":"https://api.github.com/users/zeripath/events{/privacy}","received_events_url":"https://api.github.com/users/zeripath/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":8345787780,"node_id":"REFE_lADOBFIx285a31BvzwAAAAHxcp2E","url":"https://api.github.com/repos/go-gitea/gitea/issues/events/8345787780","actor":{"login":"fsologureng","id":5055343,"node_id":"MDQ6VXNlcjUwNTUzNDM=","avatar_url":"https://avatars.githubusercontent.com/u/5055343?v=4","gravatar_id":"","url":"https://api.github.com/users/fsologureng","html_url":"https://github.com/fsologureng","followers_url":"https://api.github.com/users/fsologureng/followers","following_url":"https://api.github.com/users/fsologureng/following{/other_user}","gists_url":"https://api.github.com/users/fsologureng/gists{/gist_id}","starred_url":"https://api.github.com/users/fsologureng/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fsologureng/subscriptions","organizations_url":"https://api.github.com/users/fsologureng/orgs","repos_url":"https://api.github.com/users/fsologureng/repos","events_url":"https://api.github.com/users/fsologureng/events{/privacy}","received_events_url":"https://api.github.com/users/fsologureng/received_events","type":"User","user_view_type":"public