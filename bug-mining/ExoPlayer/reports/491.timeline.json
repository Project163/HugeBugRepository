029779?v=4","gravatar_id":"","url":"https://api.github.com/users/nightwolf738","html_url":"https://github.com/nightwolf738","followers_url":"https://api.github.com/users/nightwolf738/followers","following_url":"https://api.github.com/users/nightwolf738/following{/other_user}","gists_url":"https://api.github.com/users/nightwolf738/gists{/gist_id}","starred_url":"https://api.github.com/users/nightwolf738/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nightwolf738/subscriptions","organizations_url":"https://api.github.com/users/nightwolf738/orgs","repos_url":"https://api.github.com/users/nightwolf738/repos","events_url":"https://api.github.com/users/nightwolf738/events{/privacy}","received_events_url":"https://api.github.com/users/nightwolf738/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-05-14T18:07:47Z","updated_at":"2019-05-14T18:07:47Z","body":"Update\r\n\r\nUsing OkHttp extension resolves the problem in `Sony E5553 Android 6.0, API 23`. I only changed my code from this:\r\n\r\n```\r\npublic HttpDataSource.Factory buildHttpDataSourceFactory() {\r\n    return new DefaultHttpDataSourceFactory(userAgent);\r\n}\r\n```\r\n\r\nto this:\r\n\r\n```\r\npublic HttpDataSource.Factory buildHttpDataSourceFactory() {\r\n        return new OkHttpDataSourceFactory(new OkHttpClient(), userAgent);\r\n }\r\n```\r\n\r\nWe appreciate when other easy-to-fix bugs are resolved.\r\n\r\nThank you.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/492347071/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"nightwolf738","id":16029779,"node_id":"MDQ6VXNlcjE2MDI5Nzc5","avatar_url":"https://avatars.githubusercontent.com/u/16029779?v=4","gravatar_id":"","url":"https://api.github.com/users/nightwolf738","html_url":"https://github.com/nig