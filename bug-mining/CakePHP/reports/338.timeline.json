  (\n        )\n\n    [_accessible:protected] => Array\n        (\n            [*] => 1\n        )\n\n    [_repositoryAlias:protected] => Articles\n)\n```\n\nAgain, if I take out `$this->Article->locale('en_us');` it works, but the `body` field doesn't get saved to the i18n table, which makes sense because it doesn't know what locale it should be saving as.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/47234709/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"patrickconroy","id":954577,"node_id":"MDQ6VXNlcjk1NDU3Nw==","avatar_url":"https://avatars.githubusercontent.com/u/954577?v=4","gravatar_id":"","url":"https://api.github.com/users/patrickconroy","html_url":"https://github.com/patrickconroy","followers_url":"https://api.github.com/users/patrickconroy/followers","following_url":"https://api.github.com/users/patrickconroy/following{/other_user}","gists_url":"https://api.github.com/users/patrickconroy/gists{/gist_id}","starred_url":"https://api.github.com/users/patrickconroy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/patrickconroy/subscriptions","organizations_url":"https://api.github.com/users/patrickconroy/orgs","repos_url":"https://api.github.com/users/patrickconroy/repos","events_url":"https://api.github.com/users/patrickconroy/events{/privacy}","received_events_url":"https://api.github.com/users/patrickconroy/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/47248102","html_url":"https://github.com/cakephp/cakephp/issues/3803#issuecomment-47248102","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/3803","id":47248102,"node_id":"MDEyOklzc3VlQ29tbWVudDQ3MjQ4MTAy","user":{"login":"markstory","id":24086,"node_id":"MDQ6VXNlcjI0MD