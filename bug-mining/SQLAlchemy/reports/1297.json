25-06-19T15:15:28Z","due_on":null,"closed_at":null},"comments":4,"created_at":"2022-04-05T17:49:59Z","updated_at":"2022-05-03T20:18:44Z","closed_at":"2022-05-03T20:18:44Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Describe the bug\r\n\r\nSince the `URL` object is a named tuple, passing it to this style string formatting causes an error\r\nhttps://github.com/sqlalchemy/sqlalchemy/blob/3b4d62f4f72e8dfad7f38db192a6a90a8551608c/lib/sqlalchemy/testing/provision.py#L380-L382\r\nleading to:\r\n```\r\nTypeError: not all arguments converted during string formatting\r\n```\r\n\r\n### To Reproduce\r\n\r\n```python\r\nfrom sqlalchemy.engine import make_url\r\nraise NotImplementedError(\r\n        \"no temp table keyword args routine for cfg: %s\" % make_url(\"sqllite:///\")\r\n    )\r\n```\r\n\r\n\r\n### Error\r\n\r\n```\r\nTraceback (most recent call last):\r\n  File \"/Users/alex/.pyenv/versions/3.10.2/envs/apsw-db-api/lib/python3.10/site-packages/sqlalchemy/testing/suite/test_reflection.py\", line 304, in define_tables\r\n    cls.define_reflected_tables(metadata, None)\r\n  File \"/Users/alex/.pyenv/versions/3.10.2/envs/apsw-db-api/lib/python3.10/site-packages/sqlalchemy/testing/suite/test_reflection.py\", line 450, in define_reflected_tables\r\n    cls.define_temp_tables(metadata)\r\n  File \"/Users/alex/.pyenv/versions/3.10.2/envs/apsw-db-api/lib/python3.10/site-packages/sqlalchemy/testing/suite/test_reflection.py\", line 454, in define_temp_tables\r\n    kw = temp_table_keyword_args(config, config.db)\r\n  File \"/Users/alex/.pyenv/versions/3.10.2/envs/apsw-db-api/lib/python3.10/site-packages/sqlalchemy/testing/provision.py\", line 47, in __call__\r\n    return self.fns[\"*\"](cfg, *arg)\r\n  File \"/Users/alex/.pyenv/versions/3.10.2/envs/apsw-db-api/lib/python3.10/site-packages/sqlalchemy/testing/provision.py\", line 380, in temp_table_keyword_args\r\n    \"no temp table keyword args routine for cfg: %s\" % eng.url\r\nTypeError: not all arguments converted during string formatting\r\n``` \r\n\r\n### Versions\r\n\r\n- OS: MacOS\r\n- Python: 3.10.2\r\n- SQLAlchemy: 1.4.34\r\n- Database: n/a\r\n- DBAPI (eg: psycopg, cx_oracle, mysqlclient): custom but also the base code looks broken\r\n\r\n\r\n### Additional context\r\n\r\n_No response_","closed_by":{"login":"CaselIT","id":16175304,"node_id":"MDQ6VXNlcjE2MTc1MzA0","avatar_url":"https://avatars.githubusercontent.com/u/16175304?v=4","gravatar_id":"","url":"https://api.github.com/users/CaselIT","html_url":"https://github.com/CaselIT","followers_url":"https://api.github.com/users/CaselIT/followers","following_url":"https://api.github.com/users/CaselIT/following{/other_user}","gists_url":"https://api.github.com/users/CaselIT/gists{/gist_id}","starred_url":"https://api.github.com/users/CaselIT/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CaselIT/subscriptions","organizations_url":"https://api.github.com/users/CaselIT/orgs","repos_url":"https://api.github.com/users/CaselIT/repos","events_url":"https://api.github.com/users/CaselIT/events{/privacy}","received_events_url":"https://api.github.com/users/CaselIT/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/7902/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/7902/timeline","performed_via_github_app":null,"state_reason":"completed"}