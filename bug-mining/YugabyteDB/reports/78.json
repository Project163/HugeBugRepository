"url":"https://api.github.com/users/hectorgcr","html_url":"https://github.com/hectorgcr","followers_url":"https://api.github.com/users/hectorgcr/followers","following_url":"https://api.github.com/users/hectorgcr/following{/other_user}","gists_url":"https://api.github.com/users/hectorgcr/gists{/gist_id}","starred_url":"https://api.github.com/users/hectorgcr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hectorgcr/subscriptions","organizations_url":"https://api.github.com/users/hectorgcr/orgs","repos_url":"https://api.github.com/users/hectorgcr/repos","events_url":"https://api.github.com/users/hectorgcr/events{/privacy}","received_events_url":"https://api.github.com/users/hectorgcr/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"hectorgcr","id":20052555,"node_id":"MDQ6VXNlcjIwMDUyNTU1","avatar_url":"https://avatars.githubusercontent.com/u/20052555?v=4","gravatar_id":"","url":"https://api.github.com/users/hectorgcr","html_url":"https://github.com/hectorgcr","followers_url":"https://api.github.com/users/hectorgcr/followers","following_url":"https://api.github.com/users/hectorgcr/following{/other_user}","gists_url":"https://api.github.com/users/hectorgcr/gists{/gist_id}","starred_url":"https://api.github.com/users/hectorgcr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hectorgcr/subscriptions","organizations_url":"https://api.github.com/users/hectorgcr/orgs","repos_url":"https://api.github.com/users/hectorgcr/repos","events_url":"https://api.github.com/users/hectorgcr/events{/privacy}","received_events_url":"https://api.github.com/users/hectorgcr/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2018-11-28T05:41:30Z","updated_at":"2018-12-05T06:51:10Z","closed_at":"2018-12-05T06:51:10Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"During remote bootstrap, currently, it is possible to hit an intermittent/rare issue where we can send log (WAL) files that are behind RocksDB files, and when this happens, the TServer receiving the files fatals with this message:\r\n    \r\n```\r\nCheck failed: state.prev_op_id.term() >= state.committed_op_id.term() && state.prev_op_id.index() >= state.committed_op_id.index()\r\n```\r\n    \r\nThis happens because we currently allow any entry that has been appended to the log (and Sync'ed by majority, but not necessarily Sync'ed in the tablet server's \"own\" local log) to be flushed by RocksDB; and because a RocksDB checkpoint internally results in a flush, it is possible that the RocksDB files that we send to the new node during a Remote Bootstrap session are ahead of the log files that we send to the same node.\r\n","closed_by":{"login":"hectorgcr","id":20052555,"node_id":"MDQ6VXNlcjIwMDUyNTU1","avatar_url":"https://avatars.githubusercontent.com/u/20052555?v=4","gravatar_id":"","url":"https://api.github.com/users/hectorgcr","html_url":"https://github.com/hectorgcr","followers_url":"https://api.github.com/users/hectorgcr/followers","following_url":"https://api.github.com/users/hectorgcr/following{/other_user}","gists_url":"https://api.github.com/users/hectorgcr/gists{/gist_id}","starred_url":"https://api.github.com/users/hectorgcr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hectorgcr/subscriptions","organizations_url":"https://api.github.com/users/hectorgcr/orgs","repos_url":"https://api.github.com/users/hectorgcr/repos","events_url":"https://api.github.com/users/hectorgcr/events{/privacy}","received_events_url":"https://api.github.com/users/hectorgcr/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/608/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/608/timeline","performed_via_github_app":null,"state_reason":"completed"}