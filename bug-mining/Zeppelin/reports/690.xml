&lt;p&gt;    &lt;a href=&quot;https://issues.apache.org/jira/browse/ZEPPELIN-2520&quot; title=&quot;Add bottom-margin for markdown table&quot; class=&quot;issue-link&quot; data-issue-key=&quot;ZEPPELIN-2520&quot;&gt;&lt;del&gt;ZEPPELIN-2520&lt;/del&gt;&lt;/a&gt;(&lt;a href=&quot;https://issues.apache.org/jira/browse/ZEPPELIN-2520&quot; class=&quot;external-link&quot; rel=&quot;nofollow&quot;&gt;https://issues.apache.org/jira/browse/ZEPPELIN-2520&lt;/a&gt;)&lt;/p&gt;

