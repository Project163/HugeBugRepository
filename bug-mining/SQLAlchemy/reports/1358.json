ocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"```py\r\nfrom sqlalchemy import Column\r\nfrom sqlalchemy import func\r\nfrom sqlalchemy import insert\r\nfrom sqlalchemy import Integer\r\nfrom sqlalchemy import select\r\nfrom sqlalchemy import String\r\nfrom sqlalchemy import TypeDecorator\r\nfrom sqlalchemy.orm import declarative_base\r\nBase = declarative_base()\r\n\r\n\r\nclass MyThing(TypeDecorator):\r\n    impl = String\r\n\r\n    def column_expression(self, column):\r\n        return func.lower(column)\r\n\r\nclass A(Base):\r\n    __tablename__ = 'a'\r\n\r\n    id = Column(Integer, primary_key=True)\r\n    data = Column(MyThing)\r\n\r\nprint(insert(A.__table__).returning(A.__table__.c.data))\r\n\r\nprint(select(A.__table__))\r\n\r\nprint(insert(A).returning(A))\r\n\r\nprint(insert(A).returning(A.__table__))\r\n\r\n\r\n```\r\n\r\nfrom https://github.com/geoalchemy/geoalchemy2/issues/409\r\n\r\nwe render the colname as label name in select but not Insert..returning\r\n\r\n```\r\n$ python test3.py \r\nINSERT INTO a (id, data) VALUES (:id, :data) RETURNING lower(a.data) AS data_1\r\nSELECT a.id, lower(a.data) AS data \r\nFROM a\r\nINSERT INTO a (id, data) VALUES (:id, :data) RETURNING a.id, lower(a.data) AS data_1\r\nINSERT INTO a (id, data) VALUES (:id, :data) RETURNING a.id, lower(a.data) AS data_1\r\n\r\n```\r\n\r\nthis is said to have changed in 673ca806b323f47ef7064dd64ffc98240818b93 and seems unnecessary, even though in 2.0 we get the right column back for ORM round trips.","closed_by":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users