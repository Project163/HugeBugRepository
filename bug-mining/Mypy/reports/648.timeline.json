":"https://api.github.com/users/ilevkivskyi/events{/privacy}","received_events_url":"https://api.github.com/users/ilevkivskyi/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"assigned","commit_id":null,"commit_url":null,"created_at":"2018-03-28T09:26:46Z","assignee":{"login":"ilevkivskyi","id":12005495,"node_id":"MDQ6VXNlcjEyMDA1NDk1","avatar_url":"https://avatars.githubusercontent.com/u/12005495?v=4","gravatar_id":"","url":"https://api.github.com/users/ilevkivskyi","html_url":"https://github.com/ilevkivskyi","followers_url":"https://api.github.com/users/ilevkivskyi/followers","following_url":"https://api.github.com/users/ilevkivskyi/following{/other_user}","gists_url":"https://api.github.com/users/ilevkivskyi/gists{/gist_id}","starred_url":"https://api.github.com/users/ilevkivskyi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ilevkivskyi/subscriptions","organizations_url":"https://api.github.com/users/ilevkivskyi/orgs","repos_url":"https://api.github.com/users/ilevkivskyi/repos","events_url":"https://api.github.com/users/ilevkivskyi/events{/privacy}","received_events_url":"https://api.github.com/users/ilevkivskyi/received_events","type":"User","user_view_type":"public","site_admin":false},"performed_via_github_app":null},{"url":"https://api.github.com/repos/python/mypy/issues/comments/376826968","html_url":"https://github.com/python/mypy/issues/4812#issuecomment-376826968","issue_url":"https://api.github.com/repos/python/mypy/issues/4812","id":376826968,"node_id":"MDEyOklzc3VlQ29tbWVudDM3NjgyNjk2OA==","user":{"login":"Jym77","id":19969498,"node_id":"MDQ6VXNlcjE5OTY5NDk4","avatar_url":"https://avatars.githubusercontent.com/u/19969498?v=4","gravatar_id":"","url":"https://api.github.com/users/Jym77","html_url":"https://github.com/Jym77","followers_url":"https://api.github.com/users/Jym77/followers","following_url":"https://api.github.com/users/Jym77/following{/other_user}","gists_url":"https://api.github.com/users/Jym77/gists{/gist_id}","starred_url":"https://api.github.com/users/Jym77/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Jym77/subscriptions","organizations_url":"https://api.github.com/users/Jym77/orgs","repos_url":"https://api.github.com/users/Jym77/repos","events_url":"https://api.github.com/users/Jym77/events{/privacy}","received_events_url":"https://api.github.com/users/Jym77/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-03-28T09:45:14Z","updated_at":"2018-03-28T09:45:14Z","body":"Same problem (I guess), but even less intuitive:\r\n```\r\nfrom mypy_extensions import TypedDict\r\nfrom typing import Any, List\r\n\r\nBar = List[Any]\r\n\r\nclass Foo(TypedDict):\r\n    foo: 'Toto'\r\n    bar: Bar\r\n    baz: Bar\r\n\r\nToto = int\r\n```\r\nThis causes an incorrect Recursive Types detection.\r\nRemoving any of the fields in Foo makes the Recursive Type detection disappear. Moving Toto up also does that.\r\n\r\nSo it needs both a type being used more than once, and a forward reference, but not necessarily on the same type. And the duplicated type need to be complex enough (`Bar = int` is OK).","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/376826968/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Jym77","id":19969498,"node_id":"MDQ6VXNlcjE5OTY5NDk4","avatar_url":"https://avatars.githubusercontent.com/u/19969498?v=4","gravatar_id":"","url":"https://api.github.com/users/Jym77","html_url":"https://github.com/Jym77","followers_url":"https://api.github.com/users/Jym77/followers","following_url":"https://api.github.com/users/Jym77/following{/other_user}","gists_url":"https://api.github.com/users/Jym77/gists{/gist_id}","starred_url":"https://api.github.com/users/Jym77/starred{/owner}{/repo}","subscriptions