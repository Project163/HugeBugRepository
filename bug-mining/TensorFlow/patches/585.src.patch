diff --git a/third_party/xla/xla/hlo/ir/hlo_instruction.cc b/third_party/xla/xla/hlo/ir/hlo_instruction.cc
index a8b1a377d83..bc375c570b0 100644
--- a/third_party/xla/xla/hlo/ir/hlo_instruction.cc
