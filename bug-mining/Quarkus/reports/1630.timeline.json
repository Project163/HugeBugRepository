ceived_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2022-03-30T12:36:36Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/1083100428","html_url":"https://github.com/quarkusio/quarkus/issues/24637#issuecomment-1083100428","issue_url":"https://api.github.com/repos/quarkusio/quarkus/issues/24637","id":1083100428,"node_id":"IC_kwDOCFbutM5Ajs0M","user":{"login":"loicmathieu","id":1819009,"node_id":"MDQ6VXNlcjE4MTkwMDk=","avatar_url":"https://avatars.githubusercontent.com/u/1819009?v=4","gravatar_id":"","url":"https://api.github.com/users/loicmathieu","html_url":"https://github.com/loicmathieu","followers_url":"https://api.github.com/users/loicmathieu/followers","following_url":"https://api.github.com/users/loicmathieu/following{/other_user}","gists_url":"https://api.github.com/users/loicmathieu/gists{/gist_id}","starred_url":"https://api.github.com/users/loicmathieu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/loicmathieu/subscriptions","organizations_url":"https://api.github.com/users/loicmathieu/orgs","repos_url":"https://api.github.com/users/loicmathieu/repos","events_url":"https://api.github.com/users/loicmathieu/events{/privacy}","received_events_url":"https://api.github.com/users/loicmathieu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-03-30T12:50:39Z","updated_at":"2022-03-30T12:50:39Z","body":"MongoDB with Panache uses an annotation processor, if you declare your own annotation processor this will exclude the panache one.\r\n\r\nSo you need to add the Panache annotation processor:\r\n\r\n```xml\r\n        <annotationProcessorPath>\r\n          <groupId>io.quarkus</groupId>\r\n          <artifactId>quarkus-panache-common</artifactId>\r\n          <version>${quarkus.platform.version}</version>\r\n        </annotationProcessorPath>\r\n```\r\n\r\nMaybe this should be documented somewhere, the following section explain that an annotation processor is used but don't tell that it must be configured manually if another one is used:https://quarkus.io/guides/mongodb-panache#defining-entities-in-external-projects-or-jars","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/1083100428/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"loicmathieu","id":1819009,"node_id":"MDQ6VXNlcjE4MTkwMDk=","avatar_url":"https://avatars.githubusercontent.com/u/1819009?v=4","gravatar_id":"","url":"https://api.github.com/users/loicmathieu","html_url":"https://github.com/loicmathieu","followers_url":"https://api.github.com/users/loicmathieu/followers","following_url":"https://api.github.com/users/loicmathieu/following{/other_user}","gists_url":"https://api.github.com/users/loicmathieu/gists{/gist_id}","starred_url":"https://api.github.com/users/loicmathieu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/loicmathieu/subscriptions","organizations_url":"https://api.github.com/users/loicmathieu/orgs","repos_url":"https://api.github.com/users/loicmathieu/repos","events_url":"https://api.github.com/users/loicmathieu/events{/privacy}","received_events_url":"https://api.github.com/users/loicmathieu/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/1083113997","html_url":"https://github.com/quarkusio/quarkus/issues/24637#issuecomment-1083113997","issue_url":"https://api.github.com/repos/quarkusio/quarkus/issues/24637","id":1083113997,"node_id":"IC_kwDOCFbutM5AjwIN","user":{"login":"edeandrea","id":363447,"node_id":"MDQ6VXNlcjM2MzQ0Nw==","avatar_url":"https://avatars.githubusercontent.com/u/363447?v=4","gravatar_id":"","url":"ht