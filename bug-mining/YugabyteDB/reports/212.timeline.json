nal::ArenaTraits> > const&, yb::ql::TnodeContext*) eval_where.cc:245\r\nyb::ql::Executor::ExecPTNode(yb::ql::PTSelectStmt const*, yb::ql::TnodeContext*) executor.cc:715\r\nyb::ql::Executor::ExecTreeNode(yb::ql::TreeNode const*) executor.cc:243\r\nyb::ql::Executor::Execute(yb::ql::ParseTree const&, yb::ql::StatementParameters const&) executor.cc:176\r\nyb::ql::Executor::ExecuteAsync(yb::ql::ParseTree const&, yb::ql::StatementParameters const&, yb::Callback<void (yb::Status const&, std::__1::shared_ptr<yb::ql::ExecutedResult> const&)>) executor.cc:90\r\nyb::ql::QLProcessor::ExecuteAsync(yb::ql::ParseTree const&, yb::ql::StatementParameters const&, yb::Callback<void (yb::Status const&, std::__1::shared_ptr<yb::ql::ExecutedResult> const&)>) ql_processor.cc:354\r\nyb::ql::QLProcessor::RunAsync(std::__1::basic_string<char, std::__1::char_traits<char>, std::__1::allocator<char> > const&, yb::ql::StatementParameters const&, yb::Callback<void (yb::Status const&, std::__1::shared_ptr<yb::ql::ExecutedResult> const&)>, bool) ql_processor.cc:372\r\nyb::cqlserver::CQLProcessor::ProcessRequest(yb::cqlserver::QueryRequest const&) cql_processor.cc:313\r\nyb::cqlserver::CQLProcessor::ProcessRequest(yb::cqlserver::CQLRequest const&) cql_processor.cc:221\r\nyb::cqlserver::CQLProcessor::ProcessCall(std::__1::shared_ptr<yb::rpc::InboundCall>) cql_processor.cc:175\r\nyb::cqlserver::CQLServiceImpl::Handle(std::__1::shared_ptr<yb::rpc::InboundCall>) cql_service.cc:142\r\n```\r\nCrash point:\r\n```\r\nCHECKED_STATUS Executor::PTExprToPB(const PTBindVar *bind_pt, QLExpressionPB *expr_pb) {\r\n  QLValue ql_bind;\r\n  RETURN_NOT_OK(exec_context_->params().GetBindVariable(bind_pt->name()->c_str(),  <<<<<<<<<<<<<\r\n                                                        bind_pt->pos(),\r\n                                                        bind_pt->ql_type(),\r\n                                                        &ql_bind));\r\n  *expr_pb->mutable_value() = std::move(*ql_bind.mutable_value());\r\n  return Status::OK();\r\n}\r\n```\r\nReason: _name is NULL in bind_pt.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/511746347/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"OlegLoginov","id":31254529,"node_id":"MDQ6VXNlcjMxMjU0NTI5","avatar_url":"https://avatars.githubusercontent.com/u/31254529?v=4","gravatar_id":"","url":"https://api.github.com/users/OlegLoginov","html_url":"https://github.com/OlegLoginov","followers_url":"https://api.github.com/users/OlegLoginov/followers","following_url":"https://api.github.com/users/OlegLoginov/following{/other_user}","gists_url":"https://api.github.com/users/OlegLoginov/gists{/gist_id}","starred_url":"https://api.github.com/users/OlegLoginov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/OlegLoginov/subscriptions","organizations_url":"https://api.github.com/users/OlegLoginov/orgs","repos_url":"https://api.github.com/users/OlegLoginov/repos","events_url":"https://api.github.com/users/OlegLoginov/events{/privacy}","received_events_url":"https://api.github.com/users/OlegLoginov/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/511850134","html_url":"https://github.com/yugabyte/yugabyte-db/issues/1800#issuecomment-511850134","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/1800","id":511850134,"node_id":"MDEyOklzc3VlQ29tbWVudDUxMTg1MDEzNA==","user":{"login":"allesklarbeidir","id":24321406,"node_id":"MDQ6VXNlcjI0MzIxNDA2","avatar_url":"https://avatars.githubusercontent.com/u/24321406?v=4","gravatar_id":"","url":"https://api.github.com/users/allesklarbeidir","html_url":"https://github.com/allesklarbeidir","followers_url":"https://api.github.com/users/allesklarbeidir/followe