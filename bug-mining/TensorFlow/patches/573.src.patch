+          kCudnnfMHAScaleBiasMaskSoftmaxDropoutBackwardCallTarget;
+    // no bias
+    if (fwd_fmha_call->custom_call_target() ==
+        kCudnnfMHAScaleMaskSoftmaxDropoutCallTarget)
