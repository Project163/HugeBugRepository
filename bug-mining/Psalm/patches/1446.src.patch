+                            'Call to is_a always return false when first argument is string '
+                            . 'unless third argument is true',
+                            new CodeLocation($statements_analyzer, $function_name),
+                        ));
+                    } else {
+                        IssueBuffer::maybeAdd(new RedundantFunctionCall(
+                            'Call to is_a always return false when first argument is string '
+                            . 'unless third argument is true',
+                            new CodeLocation($statements_analyzer, $function_name),
