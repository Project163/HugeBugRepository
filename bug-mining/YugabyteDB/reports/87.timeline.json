.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"A recent test highlighted this TServer failure (and pod restart) on startup:\r\n```\r\nE0103 21:20:37.935828     1 main_util.cc:22] Network error (yb/util/net/net_util.cc:194): Couldn't resolve master service address 'yb-master-1.yb-masters.yb-itest-gsched-testk8sops-k8s-rf3-20190103-195606:7100': Unable to resolve address yb-master-1.yb-masters.yb-itest-gsched-testk8sops-k8s-rf3-20190103-195606, getaddrinfo returned -2 (EAI_NONAME): Name or service not known\r\n```\r\n\r\nA bit of digging and this is traced to:\r\n```\r\nsrc/yb/tserver/tablet_server.cc\r\n148 Status TabletServer::ValidateMasterAddressResolution() const {\r\n149   for (const auto& list : *opts_.GetMasterAddresses()) {\r\n150     for (const auto& master_addr : list) {\r\n151       RETURN_NOT_OK_PREPEND(master_addr.ResolveAddresses(nullptr),\r\n152                             Format(\"Couldn't resolve master service address '$0'\", master_addr));\r\n153     }\r\n154   }\r\n155   return Status::OK();\r\n156 }\r\n...\r\n219 Status TabletServer::Init() {\r\n220   CHECK(!initted_.load(std::memory_order_acquire));\r\n221\r\n222   // Validate that the passed master address actually resolves.\r\n223   // We don't validate that we can connect at this point -- it should\r\n224   // be allowed to start the TS and the master in whichever order --\r\n225   // our heartbeat thread will loop until successfully connecting.\r\n226   RETURN_NOT_OK(ValidateMasterAddressResolution());\r\n```\r\n\r\nSome options on how to proceed here would be:\r\n- remove the validation and confirm that the Heartbeater will just block until the masters are actually resolvable and can then make progress\r\n- enhance this validation to have a retry loop like we did on the master side in #677, so that we can still gracefully fail in the startup phase, in case this is a legitimate issue in a deployment\r\n\r\ncc @kmuthukk @spolitov @mbautin ","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/696/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/696/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]