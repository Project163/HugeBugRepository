_64-pc-linux-gnu) libcurl/7.85.0 OpenSSL/3.0.5 zlib/1.2.11 brotli/1.0.9 zstd/1.5.2 libidn2/2.3.3 libpsl/0.21.0 (+libidn2/2.3.0) libssh2/1.10.0 nghttp2/1.50.0 librtmp/2.3\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/curl/curl/issues/comments/1279789917/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"pratik-mahamuni","id":64231439,"node_id":"MDQ6VXNlcjY0MjMxNDM5","avatar_url":"https://avatars.githubusercontent.com/u/64231439?v=4","gravatar_id":"","url":"https://api.github.com/users/pratik-mahamuni","html_url":"https://github.com/pratik-mahamuni","followers_url":"https://api.github.com/users/pratik-mahamuni/followers","following_url":"https://api.github.com/users/pratik-mahamuni/following{/other_user}","gists_url":"https://api.github.com/users/pratik-mahamuni/gists{/gist_id}","starred_url":"https://api.github.com/users/pratik-mahamuni/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pratik-mahamuni/subscriptions","organizations_url":"https://api.github.com/users/pratik-mahamuni/orgs","repos_url":"https://api.github.com/users/pratik-mahamuni/repos","events_url":"https://api.github.com/users/pratik-mahamuni/events{/privacy}","received_events_url":"https://api.github.com/users/pratik-mahamuni/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":7595284969,"node_id":"MEE_lADOAAiu0c5T4lsQzwAAAAHEttnp","url":"https://api.github.com/repos/curl/curl/issues/events/7595284969","actor":{"login":"bagder","id":177011,"node_id":"MDQ6VXNlcjE3NzAxMQ==","avatar_url":"https://avatars.githubusercontent.com/u/177011?v=4","gravatar_id":"","url":"https://api.github.com/users/bagder","html_url":"https://github.com/bagder","followers_url":"https://api.github.com/users/bagder/followers","following_url":"https://api.github.com/users/bagder/following{/other_user}","gists_url"