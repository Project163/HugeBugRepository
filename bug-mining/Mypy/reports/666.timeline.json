ked":false,"assignee":null,"assignees":[],"milestone":null,"comments":4,"created_at":"2019-12-10T15:49:15Z","updated_at":"2020-04-03T02:03:01Z","closed_at":null,"author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"repository":{"id":78470807,"node_id":"MDEwOlJlcG9zaXRvcnk3ODQ3MDgwNw==","name":"pyquil","full_name":"rigetti/pyquil","private":false,"owner":{"login":"rigetti","id":16469771,"node_id":"MDEyOk9yZ2FuaXphdGlvbjE2NDY5Nzcx","avatar_url":"https://avatars.githubusercontent.com/u/16469771?v=4","gravatar_id":"","url":"https://api.github.com/users/rigetti","html_url":"https://github.com/rigetti","followers_url":"https://api.github.com/users/rigetti/followers","following_url":"https://api.github.com/users/rigetti/following{/other_user}","gists_url":"https://api.github.com/users/rigetti/gists{/gist_id}","starred_url":"https://api.github.com/users/rigetti/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rigetti/subscriptions","organizations_url":"https://api.github.com/users/rigetti/orgs","repos_url":"https://api.github.com/users/rigetti/repos","events_url":"https://api.github.com/users/rigetti/events{/privacy}","received_events_url":"https://api.github.com/users/rigetti/received_events","type":"Organization","user_view_type":"public","site_admin":false},"html_url":"https://github.com/rigetti/pyquil","description":"A Python library for quantum programming using Quil.","fork":false,"url":"https://api.github.com/repos/rigetti/pyquil","forks_url":"https://api.github.com/repos/rigetti/pyquil/forks","keys_url":"https://api.github.com/repos/rigetti/pyquil/keys{/key_id}","collaborators_url":"https://api.github.com/repos/rigetti/pyquil/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/rigetti/pyquil/teams","hooks_url":"https://api.github.com/repos/rigetti/pyquil/hooks","issue_events_url":"https://api.github.com/repos/rigetti/pyquil/issues/events{/number}","events_url":"https://api.github.com/repos/rigetti/pyquil/events","assignees_url":"https://api.github.com/repos/rigetti/pyquil/assignees{/user}","branches_url":"https://api.github.com/repos/rigetti/pyquil/branches{/branch}","tags_url":"https://api.github.com/repos/rigetti/pyquil/tags","blobs_url":"https://api.github.com/repos/rigetti/pyquil/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/rigetti/pyquil/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/rigetti/pyquil/git/refs{/sha}","trees_url":"https://api.github.com/repos/rigetti/pyquil/git/trees{/sha}","statuses_url":"https://api.github.com/repos/rigetti/pyquil/statuses/{sha}","languages_url":"https://api.github.com/repos/rigetti/pyquil/languages","stargazers_url":"https://api.github.com/repos/rigetti/pyquil/stargazers","contributors_url":"https://api.github.com/repos/rigetti/pyquil/contributors","subscribers_url":"https://api.github.com/repos/rigetti/pyquil/subscribers","subscription_url":"https://api.github.com/repos/rigetti/pyquil/subscription","commits_url":"https://api.github.com/repos/rigetti/pyquil/commits{/sha}","git_commits_url":"https://api.github.com/repos/rigetti/pyquil/git/commits{/sha}","comments_url":"https://api.github.com/repos/rigetti/pyquil/comments{/number}","issue_comment_url":"https://api.github.com/repos/rigetti/pyquil/issues/comments{/number}","contents_url":"https://api.github.com/repos/rigetti/pyquil/contents/{+path}","compare_url":"https://api.github.com/repos/rigetti/pyquil/compare/{base}...{head}","merges_url":"https://api.github.com/repos/rigetti/pyquil/merges","archive_url":"https://api.github.com/repos/rigetti/pyquil/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/rigetti/pyquil/downloads","issues_url":"https://api.github.com/repos/rigetti/pyquil/issues{/number}","pulls_url":"https://api.github.com/repos/rigetti/pyquil/pulls{/number}","milestones_url":"https://api.github.com/repos/rigetti/pyquil/milestones{/number}","notifications_url":"https://api.github.com/repos/rigetti/pyquil/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/rigetti/pyquil/labels{/name}","releases_url":"https://api.github.com/repos/rigetti/pyquil/releases{/id}","deployments_url":"https://api.github.com/repos/rigetti/pyquil/deployments","created_at":"2017-01-09T21:30:22Z","updated_at":"2025-12-10T14:56:03Z","pushed_at":"2025-10-08T21:31:44Z","git_url":"git://github.com/rigetti/pyquil.git","ssh_url":"git@github.com:rigetti/pyquil.git","clone_url":"https://github.com/rigetti/pyquil.git","svn_url":"https://github.com/rigetti/pyquil","homepage":"http://docs.rigetti.com","size":83022,"stargazers_count":1476,"watchers_count":1476,"language":"Python","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":355,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":237,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["forest","quantum-computing","quantum-programming","quil"],"visibility":"public","forks":355,"open_issues":237,"watchers":1476,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"In #1119 @erichulburd noticed that `make typecheck` was failing with mypy 0.750 and so pinned our mypy dependency to 0.740 as a workaround.\r\n\r\nThe type errors on mypy 0.750 stem from the definition of `ExpressionDesignator` in `quilatom.py`, which is a nested `Union` type like so:\r\n\r\n```python\r\nExpressionValueDesignator = Union[int, float, complex]\r\nExpressionDesignator = Union['Expression', ExpressionValueDesignator]\r\n```\r\n\r\nLong story short, mypy 0.750 doesn't like the nested `ExpressionValueDesignator`.\r\n\r\nAs a workaround, flattening the `Union` like so resolves the issue:\r\n\r\n```diff\r\nExpressionValueDesignator = Union[int, float, complex]\r\n-ExpressionDesignator = Union['Expression', ExpressionValueDesignator]\r\n+ExpressionDesignator = Union['Expression', int, float, complex]\r\n```\r\n\r\nI've opened [a mypy issue upstream](https://github.com/python/mypy/issues/8125).\r\n\r\nFor now we should just keep mypy pinned to 0.740, but when/if the above mypy issue is addressed, we me might consider upgrading, or else apply the above patch if the mypy issue is resolved as \"wont fix\".","reactions":{"url":"https://api.github.com/repos/rigetti/pyquil/issues/1124/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/rigetti/pyquil/issues/1124/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":2876334948,"node_id":"MDEyOkxhYmVsZWRFdmVudDI4NzYzMzQ5NDg=","url":"https://api.github.com/repos/python/mypy/issues/events/2876334948","actor":{"login":"msullivan","id":340349,"node_id":"MDQ6VXNlcjM0MDM0OQ==","avatar_url":"https://avatars.githubusercontent.com/u/340349?v=4","gravatar_id":"","url":"https://api.github.com/users/msullivan","html_url":"https://github.com/msullivan","followers_url":"https://api.github.com/users/msullivan/followers","following_url":"https://api.github.com/users/msullivan/following{/other_user}","gists_url":"https://api.github.com/users/msullivan/gists{/gist_id}","starred_url":"https://api.github.com/users/msullivan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/msullivan/subscriptions","organizations_url":"https://api.github.com/users/msullivan/orgs","repos_url":"https://api.github.com/users/msullivan/repos","events_url":"https://api.github.com/users/msullivan/events{/privacy}","received_events_url":"https://api.github.com/users/msullivan/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2019-12-12T01:34:19Z","label":{"name":"bug","color":"fc2929"},"performed_via_github_app":null},{"id":2876334949,"node_id":"MDEyOkxhYmVsZWRFdmVudDI4NzYzMzQ5NDk=","url":"https://api.github.com/repos/python/mypy/issues/events/2876334949","actor":{"login":"msullivan","id":340349,"node_id":"MDQ6VXNlcjM0MDM0OQ==","avatar_url":"https://avatars.githubusercontent.com/u/340349?v=4","gravatar_id":"","url":"https://api.github.com/users/msullivan","html_url":"https://github.com/msullivan","followers_url":"https://api.github.com/users/msullivan/followers","following_url":"https://api.github.com/users/msullivan/following{/other_user}","gists_url":"https://api.github.com/users/msullivan/gists{/gist_id}","starred_url":"https://api.github.com/users/msullivan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/msullivan/subscriptions","organizations_url":"https://api.github.com/users/msullivan/orgs","repos_url":"https://api.github.com/users/msullivan/repos","events_url":"https://api.github.com/users/msullivan/events{/privacy}","received_events_url":"https://api.github.com/users/msullivan/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2019-12-12T01:34:19Z","label":{"name":"priority-1-normal","color":"fef2c0"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/python/mypy/issues/comments/564810386","html_url":"https://github.com/python/mypy/issues/8125#issuecomment-564810386","issue_url":"https://api.github.com/repos/python/mypy/issues/8125","id":564810386,"node_id":"MDEyOklzc3VlQ29tbWVudDU2NDgxMDM4Ng==","user":{"login":"msullivan","id":340349,"node_id":"MDQ6VXNlcjM0MDM0OQ==","avatar_url":"https://avatars.githubusercontent.com/u/340349?v=4","gravatar_id":"","url":"https://api.github.com/users/msullivan","html_url":"https://github.com/msullivan","followers_url":"https://api.github.com/users/msullivan/followers","following_url":"https://api.github.com/users/msullivan/following{/other_user}","gists_url":"https://api.github.com/users/msullivan/gists{/gist_id}","starred_url":"https://api.github.com/users/msullivan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/msullivan/subscriptions","organizations_url":"https://api.github.com/users/msullivan/orgs","repos_url":"https://api.github.com/users/msullivan/repos","events_url":"https://api.github.com/users/msullivan/events{/privacy}","received_events_url":"https://api.github.com/users/msullivan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-12-12T01:37:00Z","updated_at":"2019-12-12T01:37:00Z","body":"It looks like the issue is that in `check_op` in `mypy/checkexpr.py`, it collects all of the union elements into `left_variants` and `right_variants`, but should flatten out any unions inside those as well.\r\n\r\nInterested in submitting a PR?","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/564810386/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"msullivan","id":340349,"node_id":"MDQ6VXNlcjM0MDM0OQ==","avatar_url":"https://avatars.githubusercontent.com/u/340349?v=4","gravatar_id":"","url":"https://api.github.com/users/msullivan","html_url":"https://github.com/msullivan","followers_url":"https://api.github.com/users/msullivan/followers","following_url":"https://api.github.com/users/msullivan/following{/other_user}","gists_url":"https://api.github.com/users/msullivan/gists{/gist_id}","starred_url":"https://api.github.com/users/msullivan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/msullivan/subscriptions","organizations_url":"https://api.github.com/users/msullivan/orgs","repos_url":"https://api.github.com/users/msullivan/repos","events_url":"https://api.github.com/users/msullivan/events{/privacy}","received_events_url":"https://api.github.com/users/msullivan/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/python/mypy/issues/comments/565108811","html_url":"https://github.com/python/mypy/issues/8125#issuecomment-565108811","issue_url":"https://api.github.com/repos/python/mypy/issues/8125","id":565108811,"node_id":"MDEyOklzc3VlQ29tbWVudDU2NTEwODgxMQ==","user":{"login":"appleby","id":86076,"node_id":"MDQ6VXNlcjg2MDc2","avatar_url":"https://avatars.githubusercontent.com/u/86076?v=4","gravatar_id":"","url":"https://api.github.com/users/appleby","html_url":"https://github.com/appleby","followers_url":"https://api.github.com/users/appleby/followers","following_url":"https://api.github.com/users/appleby/following{/other_user}","gists_url":"https://api.github.com/users/appleby/gists{/gist_id}","starred_url":"https://api.github.com/users/appleby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/appleby/subscriptions","organizations_url":"https://api.github.com/users/appleby/orgs","repos_url":"https://api.github.com/users/appleby/repos","events_url":"https://api.github.com/users/appleby/events{/privacy}","received_events_url":"https://api.github.com/users/appleby/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-12-12T17:37:54Z","updated_at":"2019-12-12T17:37:54Z","body":"> It looks like the issue is that in `check_op` in `mypy/checkexpr.py`, it collects all of the union elements into `left_variants` and `right_variants`, but should flatten out any unions inside those as well.\r\n> \r\n> Interested in submitting a PR?\r\n\r\nNot at this time, no. I spent a few minutes looking into it, but being new to the mypy codebase, I suspect it'll take longer than I want to spend on it. For now, I'm happy to stick with mypy 0.740.\r\n\r\nHere are some notes in case it's useful for whoever picks this up (maybe future me). Warning: I have no understanding of mypy internals and didn't attempt to properly debug this, just skimmed the source code.\r\n\r\nAt first I was confused because `UnionType` does [call `flatten_nested_unions` in it's constructor](https://github.com/python/mypy/blob/a2ab97badc0db97b6d639af0157a12357c12c91d/mypy/types.py#L1684) (#3196, #3298). But then I noticed that `UnionType` is a subclass of `ProperType` and the `ProperType` docstring says `Every type except TypeAliasType must inherit from this type.`\r\n\r\nSince my example above is using nested type aliases, I assume these get turned into [`TypeAliasType`s](https://github.com/python/mypy/blob/a2ab97badc0db97b6d639af0157a12357c12c91d/mypy/types.py#L152)? The docstring for `TypeAliasType` warns `NOTE: this is not being used yet, and the implementation is still incomplete`, but a quick grep seems to indicate that it is used and the docstring might just be out of date.\r\n\r\nFollowing on with @msullivan's tip about `check_op` in `mypy/checkexpr.py`, I notice that `get_proper_type` is called before expanding the actual `UnionType` for both the [`left_variants`](https://github.com/python/mypy/blob/a2ab97badc0db97b6d639af0157a12357c12c91d/mypy/checkexpr.py#L2514) and the [`right_variants`](https://github.com/python/mypy/blob/a2ab97badc0db97b6d639af0157a12357c12c91d/mypy/checkexpr.py#L2556). However,\r\n\r\n1. [`get_proper_type`](https://github.com/python/mypy/blob/a2ab97badc0db97b6d639af0157a12357c12c91d/mypy/types.py#L1902) only does a single expansion of the type alias by calling [`TypeAlias._expand_once`](https://github.com/python/mypy/blob/a2ab97badc0db97b6d639af0157a12357c12c91d/mypy/types.py#L1902) which doesn't do a full expansion of nested aliases, and\r\n\r\n2. The call to `flatten_nested_unions` in `UnionType.__init__` only [recursively flattens nested `ProperType`s](https://github.com/python/mypy/blob/a2ab97badc0db97b6d639af0157a12357c12c91d/mypy/types.py#L2241), not nested `TypeAliasType`s.\r\n\r\nI'm am not sure what the right fix would be here, whether it's (a) flattening nested type alias Unions \"by hand\" in `ExpressionChecker.check_op`, or (b) updating `flatten_nested_unions` to also flatten nested `TypeAliasType`s, or (c) updating `get_proper_type` to `expand_all_if_possible` rather than `_expand_once`, or (d) something else.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/565108811/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"appleby","id":86076,"node_id":"MDQ6VXNlcjg2MDc2","avatar_url":"https://avatars.githubusercontent.com/u/86076?v=4","gravatar_id":"","url":"https://api.github.com/users/appleby","html_url":"https://github.com/appleby","followers_url":"https://api.github.com/users/appleby/followers","following_url":"https://api.github.com/users/appleby/following{/other_user}","gists_url":"https://api.github.com/users/appleby/gists{/gist_id}","starred_url":"https://api.github.com/users/appleby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/appleby/subscriptions","organizations_url":"https://api.github.com/users/appleby/orgs","repos_url":"https://api.github.com/users/appleby/repos","events_url":"https://api.github.com/users/appleby/events{/privacy}","received_events_url":"https://api.github.com/users/appleby/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":2878795523,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50Mjg3ODc5NTUyMw==","url":"https://api.github.com/repos/python/mypy/issues/events/2878795523","actor":{"login":"msullivan","id":340349,"node_id":"MDQ6VXNlcjM0MDM0OQ==","avatar_url":"https://avatars.githubusercontent.com/u/340349?v=4","gravatar_id":"","u