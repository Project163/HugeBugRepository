+
+export const shell = async (
+  command: string,
+  args?: string[],
+  options?: execa.Options,
+  log: boolean = false
+) => {
+  try {
+    if (options && options.shell === true) {
+      const stringCommand = [command, ...(!args ? [] : args)].join(" ");
