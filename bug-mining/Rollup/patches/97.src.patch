--- /dev/null
+++ b/test/function/samples/reassign-object-literal-1/main.js
@@ -0,0 +1,19 @@
+let triggered = false;
+
+const obj = {
+	reassigned() {}
+};
+
+let y = obj;
+reassign();
+y = null;
+
+function reassign() {
+	y.reassigned = function() {
+		triggered = true;
+	};
+}
+
+obj.reassigned();
+
+assert.ok(triggered);
