does it.  If you change the c in line 8 to C, the error you get is different because the Foreign Key is then there.  Maybe it's as simple as having the code that throws that exception suggest \"Ensure that columns are created with .Column() and not .column().\"  I like the idea of making it easier for others who make the same error find the solution more quickly than I did.\n\n```\nfrom flask import Flask\nfrom flask_sqlalchemy import SQLAlchemy\ndb = SQLAlchemy()\nclass Resource(db.Model):\n    __tablename__ = 'resources'\n    id = db.Column(db.Integer, primary_key=True)\n    name = db.Column(db.String(500), index=True)\n    locale_id = db.column(db.Integer, db.ForeignKey('locales.id', ondelete='CASCADE'))\n    locale = db.relationship(\n        'Locale',\n        back_populates='resources')\n\nclass Locale(db.Model):\n    __tablename__ = 'locales'\n    id = db.Column(db.Integer, primary_key=True)\n    subdomain = db.Column(db.String)\n    sponsor = db.Column(db.String(500), default=\"Foster for life\")\n    manager = db.Column(db.String(500), default=\"Foster for life\")\n    resources = db.relationship(\n        'Resource',\n        back_populates='locale',\n        cascade='all, delete-orphan'\n    )\n\nLocale.query.first()\n```\n","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/441943360/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github