<item>
            <title>[IGNITE-10301] GridToStringBuilder is broken for classes with inheritance</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-10301</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;Given the following class hierarchy&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
    &lt;span class=&quot;code-comment&quot;&gt;/** */&lt;/span&gt;
    &lt;span class=&quot;code-keyword&quot;&gt;private&lt;/span&gt; &lt;span class=&quot;code-keyword&quot;&gt;static&lt;/span&gt; &lt;span class=&quot;code-keyword&quot;&gt;class &lt;/span&gt;Parent {
        &lt;span class=&quot;code-comment&quot;&gt;/** */&lt;/span&gt;
        &lt;span class=&quot;code-keyword&quot;&gt;private&lt;/span&gt; &lt;span class=&quot;code-object&quot;&gt;int&lt;/span&gt; a;

        &lt;span class=&quot;code-comment&quot;&gt;/** {@inheritDoc} */&lt;/span&gt;
        @Override &lt;span class=&quot;code-keyword&quot;&gt;public&lt;/span&gt; &lt;span class=&quot;code-object&quot;&gt;String&lt;/span&gt; toString() {
            &lt;span class=&quot;code-keyword&quot;&gt;return&lt;/span&gt; S.toString(Parent.class, &lt;span class=&quot;code-keyword&quot;&gt;this&lt;/span&gt;);
        }
    }

    &lt;span class=&quot;code-comment&quot;&gt;/** */&lt;/span&gt;
    &lt;span class=&quot;code-keyword&quot;&gt;private&lt;/span&gt; &lt;span class=&quot;code-keyword&quot;&gt;static&lt;/span&gt; &lt;span class=&quot;code-keyword&quot;&gt;class &lt;/span&gt;Child &lt;span class=&quot;code-keyword&quot;&gt;extends&lt;/span&gt; Parent {
        &lt;span class=&quot;code-comment&quot;&gt;/** */&lt;/span&gt;
        &lt;span class=&quot;code-keyword&quot;&gt;private&lt;/span&gt; &lt;span class=&quot;code-object&quot;&gt;int&lt;/span&gt; b;

        &lt;span class=&quot;code-comment&quot;&gt;/** {@inheritDoc} */&lt;/span&gt;
        @Override &lt;span class=&quot;code-keyword&quot;&gt;public&lt;/span&gt; &lt;span class=&quot;code-object&quot;&gt;String&lt;/span&gt; toString() {
            &lt;span class=&quot;code-keyword&quot;&gt;return&lt;/span&gt; S.toString(Child.class, &lt;span class=&quot;code-keyword&quot;&gt;this&lt;/span&gt;, &lt;span class=&quot;code-keyword&quot;&gt;super&lt;/span&gt;.toString());
        }
    }

    &lt;span class=&quot;code-keyword&quot;&gt;private&lt;/span&gt; &lt;span class=&quot;code-keyword&quot;&gt;static&lt;/span&gt; &lt;span class=&quot;code-keyword&quot;&gt;class &lt;/span&gt;Wrapper {
        &lt;span class=&quot;code-comment&quot;&gt;/** */&lt;/span&gt;
        @GridToStringInclude
        Parent p = &lt;span class=&quot;code-keyword&quot;&gt;new&lt;/span&gt; Child();

        &lt;span class=&quot;code-comment&quot;&gt;/** {@inheritDoc} */&lt;/span&gt;
        @Override &lt;span class=&quot;code-keyword&quot;&gt;public&lt;/span&gt; &lt;span class=&quot;code-object&quot;&gt;String&lt;/span&gt; toString() {
            &lt;span class=&quot;code-keyword&quot;&gt;return&lt;/span&gt; S.toString(Wrapper.class, &lt;span class=&quot;code-keyword&quot;&gt;this&lt;/span&gt;);
        }
    }
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;p&gt;the next test fails:&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
    /**
     */
    &lt;span class=&quot;code-keyword&quot;&gt;public&lt;/span&gt; void testHierarchy() {
        Wrapper w = &lt;span class=&quot;code-keyword&quot;&gt;new&lt;/span&gt; Wrapper();
        Parent p = w.p;

        &lt;span class=&quot;code-object&quot;&gt;String&lt;/span&gt; wS = w.toString();
        &lt;span class=&quot;code-object&quot;&gt;String&lt;/span&gt; pS = p.toString();

        &lt;span class=&quot;code-comment&quot;&gt;// Expect wS to be &lt;span class=&quot;code-quote&quot;&gt;&quot;Wrapper [p=&quot;&lt;/span&gt; + pS + &lt;span class=&quot;code-quote&quot;&gt;&apos;]&apos;&lt;/span&gt;.
&lt;/span&gt;        assertEquals(&lt;span class=&quot;code-quote&quot;&gt;&quot;Wrapper [p=&quot;&lt;/span&gt; + pS + &lt;span class=&quot;code-quote&quot;&gt;&apos;]&apos;&lt;/span&gt;, wS);
    }
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
Expected :Wrapper [p=Child [b=0, &lt;span class=&quot;code-keyword&quot;&gt;super&lt;/span&gt;=Parent [a=0]]]
Actual   :Wrapper [p=Parent [a=0]Child [b=0, &lt;span class=&quot;code-keyword&quot;&gt;super&lt;/span&gt;=]]
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;This is a regression from &lt;a href=&quot;https://issues.apache.org/jira/browse/IGNITE-602&quot; title=&quot;[Test] GridToStringBuilder is vulnerable for StackOverflowError caused by infinite recursion&quot; class=&quot;issue-link&quot; data-issue-key=&quot;IGNITE-602&quot;&gt;&lt;del&gt;IGNITE-602&lt;/del&gt;&lt;/a&gt;. We need to fix this in 2.7 or revert &lt;a href=&quot;https://issues.apache.org/jira/browse/IGNITE-602&quot; title=&quot;[Test] GridToStringBuilder is vulnerable for StackOverflowError caused by infinite recursion&quot; class=&quot;issue-link&quot; data-issue-key=&quot;IGNITE-602&quot;&gt;&lt;del&gt;IGNITE-602&lt;/del&gt;&lt;/a&gt;.&lt;/p&gt;</description>
