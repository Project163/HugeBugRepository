                print(t);
                stmt.execute(&lt;span class=&quot;code-quote&quot;&gt;&quot;drop table &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; exists \&quot;&lt;/span&gt;PUBLIC\&lt;span class=&quot;code-quote&quot;&gt;&quot;.t&quot;&lt;/span&gt; + t);
