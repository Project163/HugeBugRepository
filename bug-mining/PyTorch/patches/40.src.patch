+static std::string parentdir(const std::string& name) {
+  size_t end = name.find_last_of('/');
+  if(end == std::string::npos)
+    end = name.find_last_of('\\');
+
+  if(end == std::string::npos)
+    return "";
+
+  return name.substr(0, end);
+}
