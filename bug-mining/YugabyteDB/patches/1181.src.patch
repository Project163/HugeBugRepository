+   CTE w
+     ->  Insert on a a_1
+           Conflict Resolution: UPDATE
+           Conflict Arbiter Indexes: a_i_key
+           ->  Result
+   CTE x
+     ->  Insert on a a_2
+           Conflict Resolution: UPDATE
+           Conflict Arbiter Indexes: a_i_key
+           ->  Result
+   InitPlan 3 (returns $4)
+     ->  CTE Scan on w
+   ->  Result
+(16 rows)
+
+with w(i) as (
+    insert into a values (1) on conflict on constraint a_i_key do update set i = 10 returning i
