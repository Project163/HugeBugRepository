9:55:10Z","updated_at":"2019-07-03T09:55:10Z","body":"What was the reason? This output shouldn't be possible.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/prometheus/prometheus/issues/comments/508026426/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"brian-brazil","id":7115638,"node_id":"MDQ6VXNlcjcxMTU2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/7115638?v=4","gravatar_id":"","url":"https://api.github.com/users/brian-brazil","html_url":"https://github.com/brian-brazil","followers_url":"https://api.github.com/users/brian-brazil/followers","following_url":"https://api.github.com/users/brian-brazil/following{/other_user}","gists_url":"https://api.github.com/users/brian-brazil/gists{/gist_id}","starred_url":"https://api.github.com/users/brian-brazil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brian-brazil/subscriptions","organizations_url":"https://api.github.com/users/brian-brazil/orgs","repos_url":"https://api.github.com/users/brian-brazil/repos","events_url":"https://api.github.com/users/brian-brazil/events{/privacy}","received_events_url":"https://api.github.com/users/brian-brazil/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/prometheus/prometheus/issues/comments/508641205","html_url":"https://github.com/prometheus/prometheus/issues/5731#issuecomment-508641205","issue_url":"https://api.github.com/repos/prometheus/prometheus/issues/5731","id":508641205,"node_id":"MDEyOklzc3VlQ29tbWVudDUwODY0MTIwNQ==","user":{"login":"xinyu7git","id":3701997,"node_id":"MDQ6VXNlcjM3MDE5OTc=","avatar_url":"https://avatars.githubusercontent.com/u/3701997?v=4","gravatar_id":"","url":"https://api.github.com/users/xinyu7git","html_url":"https://github.com/xinyu7git","followers_url":"https://api.github.com/users/xinyu7git/followers","following_url":"https://api.github.com/users/xinyu7git/following{/other_user}","gists_url":"https://api.github.com/users/xinyu7git/gists{/gist_id}","starred_url":"https://api.github.com/users/xinyu7git/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xinyu7git/subscriptions","organizations_url":"https://api.github.com/users/xinyu7git/orgs","repos_url":"https://api.github.com/users/xinyu7git/repos","events_url":"https://api.github.com/users/xinyu7git/events{/privacy}","received_events_url":"https://api.github.com/users/xinyu7git/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-07-05T06:06:49Z","updated_at":"2019-07-05T06:12:45Z","body":"> What was the reason? This output shouldn't be possible.\r\n\r\nIn our self-developed distributed cluster based on the influxdb oss version, there are some errors in the read and write logic of prometheus. Prometheus will take the label of `__name__` when writing data to influxdb, and we used some codes in remote_storage_adapter when reading data from influxdb, it will automatically add a label of `__name__` , so there are two `__name__`  in the data returned to prometheus.\r\n\r\nthe prometheus remote_storage_adapter receive data from prometheus ,and then remove `__name__`  label and then write points to influxdb, but the influxdb(1.7.6) servicePromWrite API didnot remove the label , so points in influxdb have `__name__`  label(we didnot modify this part).  Influxdb servicePromRead API didnot use same logic like prometheus remote_storage_adapter, so we have encountered this error.\r\n\r\ne.... same codes:\r\n![image](https://user-images.githubusercontent.com/3701997/60701444-5e3ed980-9f2e-11e9-932a-506c9e198797.png)\r\n\r\n\r\nThe above code is the code in prometheus remote_storage_adapter example（influxdb/client.go)  . The tag of `__name__`  is added to the code. If you add the tag of `__name__`  repeatedly, you will have the same problem.\r\n\r\n![image](https://user-images.githubusercontent.com/3701997/60701420-4e26fa00-9f2e-11e9-8e9b-425253410b77.png)\r\n\r\nso finially ,we remove this line in our codes for our self-developed distributed cluster :\r\n![image](https://user-images.githubusercontent.com/3701997/60701605-e8873d80-9f2e-11e9-99a7-817ebb40fa74.png)\r\n\r\n\r\nIf I have made it clear?\r\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/prometheus/prometheus/issues/comments/508641205/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"xinyu7git","id":3701997,"node_id":"MDQ6VXNlcjM3MDE5OTc=","avatar_url":"https://avatars.githubusercontent.com/u/3701997?v=4","gravatar_id":"","url":"https://api.github.com/users/xinyu7git","html_url":"https://github.com/xinyu7git","followers_url":"https://api.github.com/users/xinyu7git/followers","following_url":"https://api.github.com/users/xinyu7git/following{/other_user}","gists_url":"https://api.github.com/users/xinyu7git/gists{/gist_id}","starred_url":"https://api.github.com/users/xinyu7git/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xinyu7git/subscriptions","organizations_url":"https://api.github.com/users/xinyu7git/orgs","repos_url":"https://api.github.com/users/xinyu7git/repos","events_url":"https://api.github.com/users/xinyu7git/events{/privacy}","received_events_url":"https://api.github.com/users/xinyu7git/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/prometheus/prometheus/issues/comments/508681790","html_url":"https://github.com/prometheus/prometheus/issues/5731#issuecomment-508681790","issue_url":"https://api.github.com/repos/prometheus/prometheus/issues/5731","id":508681790,"node_id":"MDEyOklzc3VlQ29tbWVudDUwODY4MTc5MA==","user":{"login":"brian-brazil","id":7115638,"node_id":"MD