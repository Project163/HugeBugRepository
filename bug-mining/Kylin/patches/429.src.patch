+                        "aggMap");
+        Supplier<? extends AggImplementor> calciteSumImplementorSupplier = aggMap.get(SqlStdOperatorTable.SUM);
+        aggMap.put(KYLIN_SUM, calciteSumImplementorSupplier);
+    }
