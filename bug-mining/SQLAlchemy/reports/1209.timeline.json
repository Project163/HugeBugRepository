[{"id":4599970883,"node_id":"MDEyOkxhYmVsZWRFdmVudDQ1OTk5NzA4ODM=","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/4599970883","actor":{"login":"wmolicki","id":3396702,"node_id":"MDQ6VXNlcjMzOTY3MDI=","avatar_url":"https://avatars.githubusercontent.com/u/3396702?v=4","gravatar_id":"","url":"https://api.github.com/users/wmolicki","html_url":"https://github.com/wmolicki","followers_url":"https://api.github.com/users/wmolicki/followers","following_url":"https://api.github.com/users/wmolicki/following{/other_user}","gists_url":"https://api.github.com/users/wmolicki/gists{/gist_id}","starred_url":"https://api.github.com/users/wmolicki/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wmolicki/subscriptions","organizations_url":"https://api.github.com/users/wmolicki/orgs","repos_url":"https://api.github.com/users/wmolicki/repos","events_url":"https://api.github.com/users/wmolicki/events{/privacy}","received_events_url":"https://api.github.com/users/wmolicki/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2021-04-15T15:17:48Z","label":{"name":"requires triage","color":"ffff00"},"performed_via_github_app":null},{"id":4600209912,"node_id":"MDEyOkxhYmVsZWRFdmVudDQ2MDAyMDk5MTI=","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/4600209912","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2021-04-15T16:00:52Z","label":{"name":"question","color":"d876e3"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/820552300","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/6284#issuecomment-820552300","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/6284","id":820552300,"node_id":"MDEyOklzc3VlQ29tbWVudDgyMDU1MjMwMA==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-04-15T16:11:07Z","updated_at":"2021-04-15T16:11:26Z","body":"hey there -\r\n\r\nthe issue is that you're using an unusual and not currently defined pattern to invoke this query, and also repurposing with_expression() in a way that was also not part of its current usage contract:\r\n\r\n```\r\n   q = session.query(...)\r\n   result = session.execute(q)\r\n```\r\n\r\nI would not expect ORM loader options to take effect for such a query in 1.3, but it seems you're relying upon the fact that query() would add the column in any case before running in this way.\r\n\r\nThe behavior of session.execute() with ORM-enabled SELECT statements [has changed in 1.4](https://docs.sqlalchemy.org/en/14/changelog/migration_14.html#orm-query-is-internally-unified-with-select-update-delete-2-0-style-execution-available).  So if we run your thing in 1.3, the result looks like:\r\n\r\n```\r\n(Pdb) result.fetchall()\r\n[('github', 1, 'bogdan')]\r\n```\r\n\r\nif we run in 1.4, the result is:\r\n\r\n```\r\n(Pdb) result.fetchall()\r\n[(<__main__.User object at 0x7fe7a3626220>,)]\r\n```\r\n\r\nso already, things are very different here.   \r\n\r\nThe Session should be doing something more \"defined\" here, like a warning, or an error, or \"just working\" most likely, to get the option to take effect in 1.4 looks like:\r\n\r\n    result = session.execute(q.statement)\r\n\r\nbut that still gives you a User object in a row, not a row with plain columns.\r\n\r\nThe error it's supposed to raise is in fact this:\r\n\r\n     sqlalchemy.exc.ObjectNotExecutableError: Not an executable object: <sqlalchemy.orm.query.Query object at 0x7f437344e970>\r\n\r\n*anyway*, what you want here is 1. core-style execution against your 2. ORM-enabled query.  it will work if you do it like this:\r\n\r\n    result = session.connection().execute(q.statement)\r\n\r\nnote above that this is still not the \"main purpose\" of with_expression().  if you want a certain expression in a Core select you just ask for it, that is, the \"legit\" way to write your query would be:\r\n\r\n    stmt = select(User.id, User.name, literal(\"github\").label(\"company_name\"))\r\n    result = session.execute(stmt)\r\n\r\n\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/820552300/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":4600268407,"node_id":"MDE3OlJlbmFtZWRUaXRsZUV2ZW50NDYwMDI2ODQwNw==","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/4600268407","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2021-04-15T16:12:20Z","rename":{"from":"1.4.7 query_expression value not added to result when executing session.query","to":"warn when running session.execute(Query)"},"performed_via_github_app":null},{"id":4600270032,"node_id":"MDE0OlVubGFiZWxlZEV2ZW50NDYwMDI3MDAzMg==","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/4600270032","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"unlabeled","commit_id":null,"commit_url":null,"created_at":"2021-04-15T16:12:38Z","label":{"name":"question","color":"d876e3"},"performed_via_github_app":null},{"id":4600270035,"node_id":"MDE0OlVubGFiZWxlZEV2ZW50NDYwMDI3MDAzNQ==","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/4600270035","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4",