[{"id":1074741059,"node_id":"MDEyOkxhYmVsZWRFdmVudDEwNzQ3NDEwNTk=","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/1074741059","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2017-05-09T14:52:12Z","label":{"name":"bug","color":"fc2929"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/300804250","html_url":"https://github.com/google/ExoPlayer/issues/2795#issuecomment-300804250","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/2795","id":300804250,"node_id":"MDEyOklzc3VlQ29tbWVudDMwMDgwNDI1MA==","user":{"login":"ba-a","id":28408467,"node_id":"MDQ6VXNlcjI4NDA4NDY3","avatar_url":"https://avatars.githubusercontent.com/u/28408467?v=4","gravatar_id":"","url":"https://api.github.com/users/ba-a","html_url":"https://github.com/ba-a","followers_url":"https://api.github.com/users/ba-a/followers","following_url":"https://api.github.com/users/ba-a/following{/other_user}","gists_url":"https://api.github.com/users/ba-a/gists{/gist_id}","starred_url":"https://api.github.com/users/ba-a/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ba-a/subscriptions","organizations_url":"https://api.github.com/users/ba-a/orgs","repos_url":"https://api.github.com/users/ba-a/repos","events_url":"https://api.github.com/users/ba-a/events{/privacy}","received_events_url":"https://api.github.com/users/ba-a/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-05-11T14:20:26Z","updated_at":"2017-05-11T14:27:09Z","body":"I can be a little bit more specific about the crash now. It happens due to an error in the playout of the stream which results in an incorrect dash manifest.\r\nIn the attachment I provided what one of these broken manifests looks like and for comparison a correct one.\r\n\r\nDue to the playout error the manifest contains only the video AdaptionSet but none for the audio. It seems that the player currently does no check there but just assumes that at least two sets are included. We will fix the bug on the server side but I think the ExoPlayer should be able to handle the situation as well.\r\n\r\n[Broken Manifest mpd.txt](https://github.com/google/ExoPlayer/files/993262/Broken.Manifest.mpd.txt)\r\n[Correct Manifest mpd.txt](https://github.com/google/ExoPlayer/files/993261/Correct.Manifest.mpd.txt)\r\n\r\nIf you need more information just let us know.\r\n ","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/300804250/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ba-a","id":28408467,"node_id":"MDQ6VXNlcjI4NDA4NDY3","avatar_url":"https://avatars.githubusercontent.com/u/28408467?v=4","gravatar_id":"","url":"https://api.github.com/users/ba-a","html_url":"https://github.com/ba-a","followers_url":"https://api.github.com/users/ba-a/followers","following_url":"https://api.github.com/users/ba-a/following{/other_user}","gists_url":"https://api.github.com/users/ba-a/gists{/gist_id}","starred_url":"https://api.github.com/users/ba-a/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ba-a/subscriptions","organizations_url":"https://api.github.com/users/ba-a/orgs","repos_url":"https://api.github.com/users/ba-a/repos","events_url":"https://api.github.com/users/ba-a/events{/privacy}","received_events_url":"https://api.github.com/users/ba-a/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/300824394","html_url":"https://github.com/google/ExoPlayer/issues/2795#issuecomment-300824394","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/2795","id":300824394,"node_id":"MDEyOklzc3VlQ29tbWVudDMwMDgyNDM5NA==","user":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-05-11T15:23:49Z","updated_at":"2017-05-11T15:24:19Z","body":"Yup, understood. It's pretty difficult (and a lot of extra code) to validate all parts of all media for correctness, so we have a pretty broad `try { ... } catch ( ... ) { propagate as playback failure }` to handle unexpected cases without killing the process. There are however a few specific callbacks that aren't covered by this logic, one of which is the `ManifestCallback.onLoad*` callbacks.\r\n\r\nWe'll use this issue to track getting them covered correctly, after which the `IndexOutOfBoundsException` will be propagated out the front of the player as a playback failure, but will not cause process death.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/300824394/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/301052971","html_url":"https://github.com/google/ExoPlayer/issues/2795#issuecomment-301052971","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/2795","id":301052971,"node_id":"MDEyOklzc3VlQ29tbWVudDMwMTA1Mjk3MQ==","user":{"login":"ba-a","id":28408467,"node_id":"MDQ6VXNlcjI4NDA4NDY3","avatar_url"