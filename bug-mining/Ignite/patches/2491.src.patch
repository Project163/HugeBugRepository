+/**
+ *
+ */
+public class WalRecoveryTxLogicalRecordsTest extends GridCommonAbstractTest {
+    /** Cache name. */
+    private static final String CACHE_NAME = "cache";
+
+    /** */
+    public static final int PARTS = 32;
+
+    /** */
+    public static final int WAL_HIST_SIZE = 30;
+
+    /** */
