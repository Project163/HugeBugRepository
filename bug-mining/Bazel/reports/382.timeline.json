6VXNlcjExMzY1MDU5","avatar_url":"https://avatars.githubusercontent.com/u/11365059?v=4","gravatar_id":"","url":"https://api.github.com/users/davideleoni90","html_url":"https://github.com/davideleoni90","followers_url":"https://api.github.com/users/davideleoni90/followers","following_url":"https://api.github.com/users/davideleoni90/following{/other_user}","gists_url":"https://api.github.com/users/davideleoni90/gists{/gist_id}","starred_url":"https://api.github.com/users/davideleoni90/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/davideleoni90/subscriptions","organizations_url":"https://api.github.com/users/davideleoni90/orgs","repos_url":"https://api.github.com/users/davideleoni90/repos","events_url":"https://api.github.com/users/davideleoni90/events{/privacy}","received_events_url":"https://api.github.com/users/davideleoni90/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-05-12T15:46:26Z","updated_at":"2017-05-12T15:47:13Z","body":"I solved it making two small modifications:\r\n\r\n1- added \r\n       default_toolchain {\r\n  \t  cpu: \"ppc64\"\r\n  \t  toolchain_identifier: \"local_linux\"\r\n\t}\r\n\r\n   to tools/cpp/CROSSTOOL\r\n\r\n2- in the file \"tools/cpp/cc_configure.bzl\" changed \r\n\r\n    \"if result.stdout.strip() in [\"power\", \"ppc64le\", \"ppc\"]:\"\r\n\r\n    into\r\n\r\n   \"if result.stdout.strip() in [\"power\", \"ppc64le\", \"ppc\", \"ppc64\"]:\"\r\n\r\nI am not sure if both the modifications are actually necessary, but that's what I did and I successfully built bazel","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/301113105/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"davideleoni90","id":11365059,"node_id":"MDQ6VXNlcjExMzY1MDU5","avatar_url":"https://avatars.githubusercon