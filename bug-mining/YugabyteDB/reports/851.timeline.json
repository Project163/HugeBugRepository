users/yugabyte-ci/gists{/gist_id}","starred_url":"https://api.github.com/users/yugabyte-ci/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yugabyte-ci/subscriptions","organizations_url":"https://api.github.com/users/yugabyte-ci/orgs","repos_url":"https://api.github.com/users/yugabyte-ci/repos","events_url":"https://api.github.com/users/yugabyte-ci/events{/privacy}","received_events_url":"https://api.github.com/users/yugabyte-ci/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2023-01-27T16:15:17Z","label":{"name":"priority/medium","color":"ffdc5e"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1406727463","html_url":"https://github.com/yugabyte/yugabyte-db/issues/15863#issuecomment-1406727463","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/15863","id":1406727463,"node_id":"IC_kwDOBlCVUc5T2PUn","user":{"login":"OlegLoginov","id":31254529,"node_id":"MDQ6VXNlcjMxMjU0NTI5","avatar_url":"https://avatars.githubusercontent.com/u/31254529?v=4","gravatar_id":"","url":"https://api.github.com/users/OlegLoginov","html_url":"https://github.com/OlegLoginov","followers_url":"https://api.github.com/users/OlegLoginov/followers","following_url":"https://api.github.com/users/OlegLoginov/following{/other_user}","gists_url":"https://api.github.com/users/OlegLoginov/gists{/gist_id}","starred_url":"https://api.github.com/users/OlegLoginov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/OlegLoginov/subscriptions","organizations_url":"https://api.github.com/users/OlegLoginov/orgs","repos_url":"https://api.github.com/users/OlegLoginov/repos","events_url":"https://api.github.com/users/OlegLoginov/events{/privacy}","received_events_url":"https://api.github.com/users/OlegLoginov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-01-27T16:20:04Z","updated_at":"2023-01-27T16:37:31Z","body":"Failed feature: Index Backfilling.\r\n\r\nRoot cause: in the method `Tablet::FlushWriteIndexBatch` - the `YBMetaDataCache` object can be destroyed between 2 calls of `Tablet::YBMetaDataCache()`.\r\n\r\nFix: 2 calls of `Tablet::YBMetaDataCache()` should be replaced by a single one.\r\n\r\nCode:\r\n```\r\nStatus Tablet::FlushWriteIndexBatch(\r\n    const HybridTime write_time,\r\n    const CoarseTimePoint deadline,\r\n    docdb::IndexRequests* index_requests,\r\n    std::unordered_set<TableId>* failed_indexes) {\r\n  if (!client_future_.valid()) {\r\n    return STATUS_FORMAT(IllegalState, \"Client future is not set up for $0\", tablet_id());\r\n  } else if (!YBMetaDataCache()) {       <<<<<< CALL-1, the result is checked\r\n    return STATUS(IllegalState, \"Table metadata cache is not present for index update\");\r\n  }\r\n  std::shared_ptr<YBSession> session = VERIFY_RESULT(GetSessionForVerifyOrBackfill(deadline));\r\n\r\n  std::unordered_set<\r\n      client::YBqlWriteOpPtr, client::YBqlWritePrimaryKeyComparator,\r\n      client::YBqlWritePrimaryKeyComparator>\r\n      ops_by_primary_key;\r\n  std::vector<shared_ptr<client::YBqlWriteOp>> write_ops;\r\n\r\n  constexpr int kMaxNumRetries = 10;\r\n  auto metadata_cache = YBMetaDataCache(); <<<<<< CALL-2, `metadata_cache`==NULL by the moment\r\n```\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1406727463/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"OlegLoginov","id":31254529,"node_id":"MDQ6VXNlcjMxMjU0NTI5","avatar_url":"https://avatars.githubusercontent.com/u/31254529?v=4","gravatar_id":"","url":"https://api.github.com/users/OlegLoginov","html_url":"https://github.com/OlegLoginov","followers_url":"https://api.github.com/users/OlegLoginov/followers","following_url":"https://api.github.com/users/OlegLoginov/following{/other_user}","gists_url":"https://api.github.com/users/OlegLoginov/gists{/gist_id}","starred_url":"https://api.github.com/users/OlegLoginov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/OlegLoginov/subscriptions","organizations_url":"https://api.github.com/users/OlegLoginov/orgs","repos_url":"https://api.github.com/users/OlegLoginov/repos","events_url":"https://api.github.com/users/OlegLoginov/events{/privacy}","received_events_url":"https://api.github.com/users/OlegLoginov/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":8375114507,"node_id":"LE_lADOBlCVUc5c_CSTzwAAAAHzMhsL","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/8375114507","actor":{"login":"OlegLoginov","id":31254529,"node_id":"MDQ6VXNlcjMxMjU0NTI5","avatar_url":"https://avatars.githubusercontent.com/u/31254529?v=4","gravatar_id":"","url":"https://api.github.com/users/OlegLoginov","html_url":"https://github.com/OlegLoginov","followers_url":"https://api.github.com/users/OlegLoginov/followers","following_url":"https://api.github.com/users/OlegLoginov/following{/other_user}","gists_url":"https://api.github.com/users/OlegLoginov/gists{/gist_id}","starred_url":"https://api.github.com/users/OlegLoginov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/OlegLoginov/subscriptions","organizations_url":"https://api.github.com/users/OlegLoginov/orgs","repos_url":"https://api.github.com/users/OlegLoginov/repos","events_url":"https://api.github.com/users/OlegLoginov/events{/privacy}","received_events_url":"https://api.github.com/users/OlegLoginov/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2023-01-27T16:36:32Z","label":{"name":"2.12 Backport Required","color":"28C7A1"},"performed_via_github_app":null},{"id":8376455822,"node_id":"REFE_lADOBlC