/repo}","subscriptions_url":"https://api.github.com/users/react-native-bot/subscriptions","organizations_url":"https://api.github.com/users/react-native-bot/orgs","repos_url":"https://api.github.com/users/react-native-bot/repos","events_url":"https://api.github.com/users/react-native-bot/events{/privacy}","received_events_url":"https://api.github.com/users/react-native-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2019-07-23T06:05:03Z","label":{"name":"Component: FlatList","color":"fef2c0"},"performed_via_github_app":null},{"id":2501885775,"node_id":"MDEyOkxhYmVsZWRFdmVudDI1MDE4ODU3NzU=","url":"https://api.github.com/repos/facebook/react-native/issues/events/2501885775","actor":{"login":"react-native-bot","id":32686087,"node_id":"MDQ6VXNlcjMyNjg2MDg3","avatar_url":"https://avatars.githubusercontent.com/u/32686087?v=4","gravatar_id":"","url":"https://api.github.com/users/react-native-bot","html_url":"https://github.com/react-native-bot","followers_url":"https://api.github.com/users/react-native-bot/followers","following_url":"https://api.github.com/users/react-native-bot/following{/other_user}","gists_url":"https://api.github.com/users/react-native-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/react-native-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/react-native-bot/subscriptions","organizations_url":"https://api.github.com/users/react-native-bot/orgs","repos_url":"https://api.github.com/users/react-native-bot/repos","events_url":"https://api.github.com/users/react-native-bot/events{/privacy}","received_events_url":"https://api.github.com/users/react-native-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2019-07-23T06:05:03Z","label":{"name":"Platform: iOS","color":"bfd4f2"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/facebook/react-native/issues/comments/515040936","html_url":"https://github.com/facebook/react-native/issues/25775#issuecomment-515040936","issue_url":"https://api.github.com/repos/facebook/react-native/issues/25775","id":515040936,"node_id":"MDEyOklzc3VlQ29tbWVudDUxNTA0MDkzNg==","user":{"login":"mrspeaker","id":129330,"node_id":"MDQ6VXNlcjEyOTMzMA==","avatar_url":"https://avatars.githubusercontent.com/u/129330?v=4","gravatar_id":"","url":"https://api.github.com/users/mrspeaker","html_url":"https://github.com/mrspeaker","followers_url":"https://api.github.com/users/mrspeaker/followers","following_url":"https://api.github.com/users/mrspeaker/following{/other_user}","gists_url":"https://api.github.com/users/mrspeaker/gists{/gist_id}","starred_url":"https://api.github.com/users/mrspeaker/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrspeaker/subscriptions","organizations_url":"https://api.github.com/users/mrspeaker/orgs","repos_url":"https://api.github.com/users/mrspeaker/repos","events_url":"https://api.github.com/users/mrspeaker/events{/privacy}","received_events_url":"https://api.github.com/users/mrspeaker/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-07-25T13:22:07Z","updated_at":"2019-07-25T18:52:55Z","body":"[EDIT: I decided to repost this as a separate issue as it is in a different version, and I think is not related to scrolling: https://github.com/facebook/react-native/issues/25825]\r\n\r\nI'm not sure if it's related, but after seeing some very laggy performance with a FlatList, I made a simple test case to see how things are rendered. It seems like it was rendering repeatedly, and too much data - but I don't know how it works \"under the hood\", so perhaps the behaviour is expected.\r\n\r\nI am using a FlatList to render an array of 400 strings (`const data = [...Array(400)].map((_, i) => `a-${i}`);`) into text elements:\r\n```\r\nconst App = () => {\r\n  return (\r\n    <View style={{ height: 400 }}>\r\n      <FlatList\r\n        data={data}\r\n        renderItem={({ item, index }) => {\r\n          console.log(item, index);\r\n          return (\r\n            <Text>\r\n              {item}:{index}\r\n            </Text>\r\n          );\r\n        }}\r\n        keyExtractor={(item, index) => item}\r\n      />\r\n    </View>\r\n  );\r\n};\r\n```\r\nThe `console.log` statement is logging many times. First it logs from index 0 to 9 (the first 10 elements of the array) then it immediately logs again from 0 to 30 (which is more than enough to fill the view), then immediately again from 0 to 180, and immediately again from 0 to 226.\r\n\r\nDoes that mean each item is re-rendered multiple times, and 226 elements are all rendered on the first page load - or is that just a \"first pass\" and rendering is somehow deferred? Or is the act of console.logging causing the rerenders?\r\n\r\nI'm using RN version 0.60. You can see the console.login action here: https://www.youtube.com/watch?v=kTXgZcm0cvg\r\n\r\nAlso interesting, setting `disableVirtualization: true` makes the component work \"correctly\" - only rendering the first chunk until you scroll down... but I don't think that is recommended!\r\n\r\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/facebook/react-native/issues/comments/515040936/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"mrspeaker","id":129330,"node_id":"MDQ6VXNlcjEyOTMzMA==","avatar_url":"https://avatars.githubusercontent.com/u/129330?v=4","gravatar_id":"","url":"https://api.github.com/users/mrspeaker","html_url":"https://github.com/mrspeaker","followers_url":"https://api.github.com/users/mrspeaker/followers","following_url":"https://api.github.com/users/mrspeaker/following{/other_user}","gists_url":"https://api.github.com/users/mrspeaker/gists{/gist_id}","starred_url":"https://api.github.com/users/mrspeaker/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrspeaker/subscriptions","organizations_url":"https://api.github.com/users/mrspeaker/orgs","repos_url":"https://api.github.com/users/mrspeaker/repos","events_url":"https://api.github.com/users/mrspeaker/events{/privacy}","received_events_url":"https://api.github.com/users/mrspeaker/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/facebook/react-native/issues/comments/515365398","html_url":"https://github.com/facebook/react-native/issues/25775#issuecomment-515365398","issue_url":"https://api.github.com/repos/facebook/react-native/issues/25775","id":515365398,"node_id":"MDEyOklzc3VlQ29tbWVudDUxNTM2NTM5OA==","user":{"login":"nfcampos","id":56902,"node_id":"MDQ6VXNlcjU2OTAy","avatar_url":"https://avatars.githubusercontent.com/u/56902?v=4","gravatar_id":"","url":"https://api.github.com/users/nfcampos","html_url":"https://github.com/nfcampos","followers_url":"https://api.github.com/users/nfcampos/followers","following_url":"https://api.github.com/users/nfcampos/following{/other_user}","gists_url":"https://api.github.com/users/nfcampos/gists{/gist_id}","starred_url":"https://api.github.com/users/nfcampos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nfcampos/subscriptions","organizations_url":"https://api.github.com/users/nfcampos/orgs","repos_url":"https://api.github.com/users/nfcampos/repos","events_url":"https://api.github.com/users/nfcampos/events{/privacy}","received_events_url":"https://api.github.com/users/nfcampos/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-07-26T08:43:58Z","updated_at":"2019-07-26T08:43:58Z","body":"I think it might be for measuring size of each item, which can be avoided by specifying `getItemLayout` https://facebook.github.io/react-native/docs/flatl