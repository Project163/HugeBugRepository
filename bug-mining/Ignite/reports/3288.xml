 ClientTcpSslMultiThreadedSelfTest.testMultithreadedTaskRun -&amp;gt; &lt;a href=&quot;https://ci.ignite.apache.org/viewLog.html?buildId=1166079&amp;amp;tab=buildResultsDiv&amp;amp;buildTypeId=IgniteTests24Java8_IgniteJavaClient&quot; class=&quot;external-link&quot; target=&quot;_blank&quot; rel=&quot;nofollow noopener&quot;&gt;succesfull after rerun&lt;/a&gt;&lt;br/&gt;
