ner}{/repo}","subscriptions_url":"https://api.github.com/users/DaveCTurner/subscriptions","organizations_url":"https://api.github.com/users/DaveCTurner/orgs","repos_url":"https://api.github.com/users/DaveCTurner/repos","events_url":"https://api.github.com/users/DaveCTurner/events{/privacy}","received_events_url":"https://api.github.com/users/DaveCTurner/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-09-21T20:36:07Z","updated_at":"2023-09-21T20:36:07Z","body":":+1:\r\n\r\nI was thinking more that for `ApiFilteringActionFilter` specifically we should be able to move to a single `ActionFilter` instance which holds a map of the individual filters keyed by action name, from which it does a single lookup each time through. Clearly some engineering effort to change how these API filters are registered.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/comments/1730262026/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"DaveCTurner","id":5058284,"node_id":"MDQ6VXNlcjUwNTgyODQ=","avatar_url":"https://avatars.githubusercontent.com/u/5058284?v=4","gravatar_id":"","url":"https://api.github.com/users/DaveCTurner","html_url":"https://github.com/DaveCTurner","followers_url":"https://api.github.com/users/DaveCTurner/followers","following_url":"https://api.github.com/users/DaveCTurner/following{/other_user}","gists_url":"https://api.github.com/users/DaveCTurner/gists{/gist_id}","starred_url":"https://api.github.com/users/DaveCTurner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DaveCTurner/subscriptions","organizations_url":"https://api.github.com/users/DaveCTurner/orgs","repos_url":"https://api.github.com/users/DaveCTurner/repos","events_url":"https://api.github.com/users/DaveCTurner/events{/privacy}","received_events_url":"https://api.github.com/users/DaveCTurner/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/comments/1730436783","html_url":"https://github.com/elastic/elasticsearch/issues/99784#issuecomment-1730436783","issue_url":"https://api.github.com/repos/elastic/elasticsearch/issues/99784","id":1730436783,"node_id":"IC_kwDOAAe_f85nJF6v","user":{"login":"rjernst","id":289412,"node_id":"MDQ6VXNlcjI4OTQxMg==","avatar_url":"https://avatars.githubusercontent.com/u/289412?v=4","gravatar_id":"","url":"https://api.github.com/users/rjernst","html_url":"https://github.com/rjernst","followers_url":"https://api.github.com/users/rjernst/followers","following_url":"https://api.github.com/users/rjernst/following{/other_user}","gists_url":"https://api.github.com/users/rjernst/gists{/gist_id}","starred_url":"https://api.github.com/users/rjernst/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rjernst/subscriptions","organizations_url":"https://api.github.com/users/rjernst/orgs","repos_url":"https://api.github.com/users/rjernst/repos","events_url":"https://api.github.com/users/rjernst/events{/privacy}","received_events_url":"https://api.github.com/users/rjernst/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-09-21T22:35:41Z","updated_at":"2023-09-21T22:35:41Z","body":"That sounds possible, but it will still require some re-engineering since currently the ApiFilteringActionFilter is what is returned by each plugin. We would need an SPI API for registering these implementations (might be tricky since they have dependencies), then have a single plugin return the main action filter.\r\n\r\nWhile the above might be doable, I wonder if there is a middle ground where a \"mapped action filter\" concept is added, which ApiFilteringActionFilter implements. Then in server we can do the meta mapping within a single action filter, where we collection all the action filters that are mapped, and shove them into one filter. I'll play with this idea.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/comments/1730436783/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"rjernst","id":289412,"node_id":"MDQ6VXNlcjI4OTQxMg==","avatar_url":"https://avatars.githubusercontent.com/u/289412?v=4","gravatar_id":"","url":"https://api.github.com/users/rjernst","html_url":"https://github.com/rjernst","followers_url":"https://api.github.com/users/rjernst/followers","following_url":"https://api.github.com/users/rjernst/following{/other_user}","gists_url":"https://api.github.com/users/rjernst/gists{/gist_id}","starred_url":"https://api.github.com/users/rjernst/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rjernst/subscriptions","organizations_url":"https://api.github.com/users/rjernst/orgs","repos_url":"https://api.github.com/users/rjernst/repos","events_url":"https://api.github.com/users/rjernst/events{/privacy}","received_events_url":"https://api.github.com/users/rjernst/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/comments/1731996161","html_url":"https://github.com/elastic/elasticsearch/issues/99784#issuecomment-1731996161","issue_url":"https://api.github.com/repos/elastic/elasticsearch/issues/99784","id":1731996161,"node_id":"IC_kwDOAAe_f85nPCoB","user":{"login":"rjernst","id":289412,"node_id":"MDQ6VXNlcjI4OTQxMg==","avatar_url":"https://avatars.githubusercontent.com/u/289412?v=4","gravatar_id":"","url":"https://api.github.com/users/rjernst","html_url":"https://github.com/rjernst","followers_url":"https://api.github.com/users/rjernst/followers","following_url":"https://api.github.com/use