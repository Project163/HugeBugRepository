+class CdcTabletSplitThreeMastersITest : public CdcTabletSplitITest {
+ protected:
+  MiniClusterOptions GetClusterOptions(const string& cluster_id) {
+    MiniClusterOptions opts;
+    opts.num_tablet_servers = 3;
