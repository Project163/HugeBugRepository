+
+  .help-footer-btn.shown {
+    bottom: 150px;
+  }
+  
+  .help-footer-menu {
+    position: fixed;
+    background-color: #fcfcfc;
+    border-left: 1px solid #f2f2f2;
+    border-right: 1px solid #f2f2f2;
+    padding: 5px 20px 10px 20px;
+    bottom: -150px;
+    right: 60px;
+    z-index: 500;
+    width: 140px;
+    font-size: 11px;
