s/tvernum/orgs","repos_url":"https://api.github.com/users/tvernum/repos","events_url":"https://api.github.com/users/tvernum/events{/privacy}","received_events_url":"https://api.github.com/users/tvernum/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Elasticsearch Version\n\n8.8.1\n\n### Installed Plugins\n\n_No response_\n\n### Java Version\n\n_bundled_\n\n### OS Version\n\nLinux LAPTOP-85G6IQGC 5.15.90.1-microsoft-standard-WSL2 #1 SMP Fri Jan 27 02:56:13 UTC 2023 x86_64 x86_64 x86_64 GNU/Linux\n\n### Problem Description\n\nElasticsearch Certutil generates certificates (which are invalid) when the provided ca.key does not match the ca.crt. The expected behavior is that no certificates are generated and that the tool exit with an error clearly saying that ca.key does not match ca.crt. Similarly to what does openssl already.\r\n\r\n\n\n### Steps to Reproduce\n\n1. Generate two new CA key-certificate pairs:\r\n  - `./bin/elasticsearch-certutil ca --ca-dn \"CN=A\" --keysize 4096 --pem --out A.zip`\r\n  - `./bin/elasticsearch-certutil ca --ca-dn \"CN=B\" --keysize 4096 --pem --out B.zip`\r\n2. Unzip the files\r\n  - `unzip A.zip -d A`\r\n  - `unzip B.zip -d B`\r\n3. Generate a certificate by using the ca.crt of A and the ca.key of B:\r\n  - `./bin/elasticsearch-certutil cert --ca-cert ./A/ca/ca.crt --ca-key ./B/ca.key --dns=test.it --pem --name test.it --out testit.zip`\r\n4. Unzip the certificate\r\n  - `unzip testit.zip`\r\n5. Check that the certificate is not valid:\r\n  - `openssl verify -CAfile ../certs/caA/ca.crt ./test.it.crt`\r\n\r\n\r\nThe result is:\r\n\r\n> error 7 at 0 depth lookup: certificate signature failure\r\nerror ./test.it.crt: verification failed\r\n80CB474EA67F0000:error:0200008A:rsa routines:RSA_padding_check_PKCS1_type_1:invalid padding:../crypto/rsa/rsa_pk1.c:75:\r\n80CB474EA67F0000:error:02000072:rsa routines:rsa_ossl_public_decrypt:padding check failed:../crypto/rsa/rsa_ossl.c:598:\r\n80CB474EA67F0000:error:1C880004:Provider routines:rsa_verify:RSA lib:../providers/implementations/signature/rsa_sig.c:774:\r\n80CB474EA67F0000:error:06880006:asn1 encoding routines:ASN1_item_verify_ctx:EVP lib:../crypto/asn1/a_verify.c:217:\r\n\r\n\r\nTrying to do the same with openssl results as expected in an error:\r\n\r\n`openssl req -newkey rsa:4096 -nodes -keyout key.pem -x509 -out ./certificate.pem -CA ./certs/A/ca/ca.crt -CAkey ./certs/caB/ca.key`\r\n\r\n> Issuer CA certificate and key do not match\r\n806BE8552B7F0000:error:05800074:x509 certificate routines:X509_check_private_key:key values mismatch:../crypto/x509/x509_cmp.c:405:\r\n\n\n### Logs (if relevant)\n\n_No response_","closed_by":{"login":"elasticsearchmachine","id":58790826,"node_id":"MDQ6VXNlcjU4NzkwODI2","avatar_url":"https://avatars.githubusercontent.com/u/58790826?v=4","gravatar_id":"","url":"https://api.github.com/users/elasticsearchmachine","html_url":"https://github.com/elasticsearchmachine","followers_url":"https://api.github.com/users/elasticsearchmachine/followers","following_url":"https://api.github.com/users/elasticsearchmachine/following{/other_user}","gists_url":"https://api.github.com/users/elasticsearchmachine/gists{/gist_id}","starred_url":"https://api.github.com/users/elasticsearchmachine/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elasticsearchmachine/subscriptions","organizations_url":"https://api.github.com/users/elasticsearchmachine/orgs","repos_url":"https://api.github.com/users/elasticsearchmachine/repos","events_url":"https://api.github.com/users/elasticsearchmachine/events{/privacy}","received_events_url":"https://api.github.com/users/elasticsearchmachine/received_events","type":"User","user_view_type":"public","site_admin":false},