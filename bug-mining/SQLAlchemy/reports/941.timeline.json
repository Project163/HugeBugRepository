[{"id":3071926505,"node_id":"MDEyOkxhYmVsZWRFdmVudDMwNzE5MjY1MDU=","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/3071926505","actor":{"login":"gordthompson","id":15894006,"node_id":"MDQ6VXNlcjE1ODk0MDA2","avatar_url":"https://avatars.githubusercontent.com/u/15894006?v=4","gravatar_id":"","url":"https://api.github.com/users/gordthompson","html_url":"https://github.com/gordthompson","followers_url":"https://api.github.com/users/gordthompson/followers","following_url":"https://api.github.com/users/gordthompson/following{/other_user}","gists_url":"https://api.github.com/users/gordthompson/gists{/gist_id}","starred_url":"https://api.github.com/users/gordthompson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gordthompson/subscriptions","organizations_url":"https://api.github.com/users/gordthompson/orgs","repos_url":"https://api.github.com/users/gordthompson/repos","events_url":"https://api.github.com/users/gordthompson/events{/privacy}","received_events_url":"https://api.github.com/users/gordthompson/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2020-02-26T02:47:23Z","label":{"name":"sqlite","color":"E0D0A0"},"performed_via_github_app":null},{"id":3071926507,"node_id":"MDEyOkxhYmVsZWRFdmVudDMwNzE5MjY1MDc=","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/3071926507","actor":{"login":"gordthompson","id":15894006,"node_id":"MDQ6VXNlcjE1ODk0MDA2","avatar_url":"https://avatars.githubusercontent.com/u/15894006?v=4","gravatar_id":"","url":"https://api.github.com/users/gordthompson","html_url":"https://github.com/gordthompson","followers_url":"https://api.github.com/users/gordthompson/followers","following_url":"https://api.github.com/users/gordthompson/following{/other_user}","gists_url":"https://api.github.com/users/gordthompson/gists{/gist_id}","starred_url":"https://api.github.com/users/gordthompson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gordthompson/subscriptions","organizations_url":"https://api.github.com/users/gordthompson/orgs","repos_url":"https://api.github.com/users/gordthompson/repos","events_url":"https://api.github.com/users/gordthompson/events{/privacy}","received_events_url":"https://api.github.com/users/gordthompson/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2020-02-26T02:47:23Z","label":{"name":"tests","color":"20A050"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/591548609","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/5168#issuecomment-591548609","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5168","id":591548609,"node_id":"MDEyOklzc3VlQ29tbWVudDU5MTU0ODYwOQ==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-02-26T17:34:03Z","updated_at":"2020-02-26T17:34:03Z","body":"we can see in the setup for LogParamsTest it is assuming that a new engine will mean a brand new database, it's hardcoded to sqlite memory semantics:\r\n```\r\n\r\n    def setup(self):\r\n        self.eng = engines.testing_engine(options={\"echo\": True})\r\n        self.no_param_engine = engines.testing_engine(\r\n            options={\"echo\": True, \"hide_parameters\": True}\r\n        )\r\n        self.eng.execute(\"create table foo (data string)\")\r\n        self.no_param_engine.execute(\"create table foo (data string)\")\r\n        self.buf = logging.handlers.BufferingHandler(100)\r\n        for log in [logging.getLogger(\"sqlalchemy.engine\")]:\r\n            log.addHandler(self.buf)\r\n```\r\n\r\nthis fixes that, seems like SQLite supports \"IF NOT EXISTS\" now, however, I've not tested if the older SQLite that is on our centos jenkins CI supports this syntax\r\n\r\n\r\n```\r\n\r\ndiff --git a/test/engine/test_logging.py b/test/engine/test_logging.py\r\nindex 14b49e5e8..fe4ff44a7 100644\r\n--- a/test/engine/test_logging.py\r\n+++ b/test/engine/test_logging.py\r\n@@ -29,14 +29,16 @@ class LogParamsTest(fixtures.TestBase):\r\n         self.no_param_engine = engines.testing_engine(\r\n             options={\"echo\": True, \"hide_parameters\": True}\r\n         )\r\n-        self.eng.execute(\"create table foo (data string)\")\r\n-        self.no_param_engine.execute(\"create table foo (data string)\")\r\n+        self.eng.execute(\"create table if not exists foo (data string)\")\r\n+        self.no_param_engine.execute(\r\n+            \"create table if not exists foo (data string)\"\r\n+        )\r\n         self.buf = logging.handlers.BufferingHandler(100)\r\n         for log in [logging.getLogger(\"sqlalchemy.engine\")]:\r\n             log.addHandler(self.buf)\r\n \r\n     def teardown(self):\r\n-        self.eng.execute(\"drop table foo\")\r\n+        self.eng.execute(\"drop table if exists foo\")\r\n         for log in [logging.getLogger(\"sqlalchemy.engine\")]:\r\n             log.removeHandler(self.buf)\r\n \r\n\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/591548609/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/591551974","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/5168#issuecomment-591551974","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5168","id":591551974,"node_id":"MDEyOklzc3VlQ29tbWVudDU5MTU1MTk3NA==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-02-26T17:41:38Z","updated_at":"2020-02-26T17:41:38Z","body":"the next tests that fail are the autocommit tests, because SQLite file uses a nullpool, it's closing the connection.  one fix would be this one:\r\n\r\n```\r\ndiff --git a/test/engine/test_execute.py b/test/engine/test_execute.py\r\nindex 5acd14177..d5d5a7f12 100644\r\n--- a/test/engine/test_execute.py\r\n+++ b/test/engine/test_execute.py\r\n@@ -2767,8 +2767,14 @@ class AutocommitTextTest(fixtures.TestBase):\r\n                 )\r\n             )\r\n         )\r\n+        from sqlalchemy.pool import QueuePool\r\n+\r\n         engine = engines.testing_engine(\r\n-            options={\"_initialize\": False, \"pool_reset_on_return\": None}\r\n+            options={\r\n+                \"_initialize\": False,\r\n+                \"pool_reset_on_return\": None,\r\n+                \"poolclass\": QueuePool,\r\n+            },\r\n         )\r\n         engine.dialect.dbapi = dbapi\r\n         engine.execute(\"%s something table something\" % keyword)\r\n\r\n```\r\n\r\nbut that means we're using a QueuePool with sqlite memory and file databases and that's a little weird.   a better way, test the mocks before we actually release the connection:\r\n\r\n```\r\ndiff --git a/test/engine/test_execute.py b/test/engine/test_execute.py\r\nindex 5acd14177..8c4a5cce2 100644\r\n--- a/test/engine/test_execute.py\r\n+++ b/test/engine/test_execute.py\r\n@@ -2771,11 +2771,14 @@ class AutocommitTextTest(fixtures.TestBase):\r\n             options={\"_initialize\": False, \"pool_reset_on_return\": None}\r\n         )\r\n         engine.dialect.dbapi = dbapi\r\n-        engine.execute(\"%s something table something\" % keyword)\r\n-        if expected:\r\n-            eq_(dbapi.connect().mock_calls, [call.cursor(), call.commit()])\r\n-        else:\r\n-            eq_(dbapi.connect().mock_calls, [call.cursor()])\r\n+\r\n+        with engine.connect() as conn:\r\n+            conn.execute(\"%s something table something\" % keyword)\r\n+\r\n+            if expected:\r\n+                eq_(dbapi.connect().mock_calls, [call.cursor(), call.commit()])\r\n+            else:\r\n+                eq_(dbapi.connect().mock_calls, [call.cursor()])\r\n \r\n     def test_update(self):\r\n         self._test_keyword(\"UPDATE\")\r\n\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/591551974/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":3074752991,"node_id":"MDEyOkxhYmVsZWRFdmVudDMwNzQ3NTI5OT