.github.com/users/bmatican/subscriptions","organizations_url":"https://api.github.com/users/bmatican/orgs","repos_url":"https://api.github.com/users/bmatican/repos","events_url":"https://api.github.com/users/bmatican/events{/privacy}","received_events_url":"https://api.github.com/users/bmatican/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2018-12-20T23:16:17Z","rename":{"from":"[k8s-deployment] when creating two clusters on shared worker nodes exception is thrown on 2nd clusters bootstrap","to":"[k8s-deployment] Master process can fail on startup if FQDN is not resolvable yet"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/449171882","html_url":"https://github.com/yugabyte/yugabyte-db/issues/677#issuecomment-449171882","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/677","id":449171882,"node_id":"MDEyOklzc3VlQ29tbWVudDQ0OTE3MTg4Mg==","user":{"login":"bmatican","id":395011,"node_id":"MDQ6VXNlcjM5NTAxMQ==","avatar_url":"https://avatars.githubusercontent.com/u/395011?v=4","gravatar_id":"","url":"https://api.github.com/users/bmatican","html_url":"https://github.com/bmatican","followers_url":"https://api.github.com/users/bmatican/followers","following_url":"https://api.github.com/users/bmatican/following{/other_user}","gists_url":"https://api.github.com/users/bmatican/gists{/gist_id}","starred_url":"https://api.github.com/users/bmatican/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bmatican/subscriptions","organizations_url":"https://api.github.com/users/bmatican/orgs","repos_url":"https://api.github.com/users/bmatican/repos","events_url":"https://api.github.com/users/bmatican/events{/privacy}","received_events_url":"https://api.github.com/users/bmatican/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-12-20T23:25:20Z","updated_at":"2018-12-20T23:25:20Z","body":"Dug into this a bit, seems like the log error is a bit of a throw off. What happens is that the master fails to come up the first time around, but creates enough state for us to think we've successfully come up, but not all the state we need to successfully load the CatalogManager data and run normally.\r\n\r\nDigging into the actual logs from the initial failure:\r\n```\r\nE1220 22:00:08.072484    28 master.cc:222] Master@10.32.1.11:7100: Unable to init master catalog manager: Configuration error (yb/master/catalog_manager.cc:1393): Unable to initialize catalog manager: Failed to initialize sys tables async: Could not resolve address of yb-master-0.yb-masters.yb-dev-bogdan-test1:7100\r\nE1220 22:00:08.073012     1 main_util.cc:22] Configuration error (yb/master/catalog_manager.cc:1393): Unable to initialize catalog manager: Failed to initialize sys tables async: Could not resolve address of yb-master-0.yb-masters.yb-dev-bogdan-test1:7100\r\n```\r\n\r\nThis clearly highlights the startup sequence where it failed:\r\n\r\nCatalogManager init code:\r\n```\r\n1412 Status CatalogManager::InitSysCatalogAsync(bool is_first_run) {\r\n...\r\n1421     RETURN_NOT_OK(CheckLocalHostInMasterAddresses());\r\n```\r\n\r\nUnderlying CatalogManager call that ends up causing the initial failure:\r\n```\r\n1364 Status CatalogManager::CheckLocalHostInMasterAddresses() {\r\n...\r\n1379   auto master_addresses_shared_ptr = master_->opts().GetMasterAddresses();\r\n1380   const auto kResolveSleepInterval = 1s;\r\n1381   const auto kResolveMaxIterations = 5;\r\n1382   for (const auto& list : *master_addresses_shared_ptr) {\r\n1383     for (const HostPort& peer_addr : list) {\r\n1384       std::vector<Endpoint> addresses;\r\n1385       // Ignore resolve errors for this check.\r\n1386       int numIters = 0;\r\n1387       Status s = peer_addr.ResolveAddresses(&addresses);\r\n1388       while (!s.ok()) {\r\n1389         numIters++;\r\n1390         if (numIters > kResolveMaxIterations) {\r\n1391           return STATUS_FORMAT(ConfigurationError, \"Could not resolve address of $0\",\r\n1392               peer_addr.ToString());\r\n1393         }\r\n1394         std::this_thread::sleep_for(kResolveSleepInterval);\r\n1395         s = peer_addr.ResolveAddresses(&addresses);\r\n1396       }\r\n```\r\n\r\nBasically, we're doing a 5x1s loop to try to resolve the master peers. If that fails, we fail to start, but we're in a section where we've still not written all our startup info yet...\r\n\r\nWe should probably just make the retry count a GFLAG and make it longer.\r\n\r\ncc @spolitov, @mbautin ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/449171882/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"bmatican","id":395011,"node_id":"MDQ6VXNlcjM5NTAxMQ==","avatar_url":"https://avatars.githubusercontent.com/u/395011?v=4","gravatar_id":"","url":"https://api.github.com/users/bmatican","html_url":"https://github.com/bmatican","followers_url":"https://api.github.com/users/bmatican/followers","following_url":"https://api.github.com/users/bmatican/following{/other_user}","gists_url":"https://api.github.com/users/bmatican/gists{/gist_id}","starred_url":"https://api.github.com/users/bmatican/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bmatican/subscriptions","organizations_url":"https://api.github.com/users/bmatican/orgs","repos_url":"https://api.github.com/users/bmatican/repos","events_url":"https://api.github.com/users/bmatican/events{/privacy}","received_events_url":"https://api.github.com/users/bmatican/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":2039637591,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50MjAzOTYzNzU5MQ==","url":"https://api.github.com/repos/yugabyte/yugaby