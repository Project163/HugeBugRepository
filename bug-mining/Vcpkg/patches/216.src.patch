+ 
++PCL_MAKE_PKGCONFIG(pcl_io_ply COMPONENT ${SUBSYS_NAME} DESC "${SUBSYS_DESC}, PLY" PCL_DEPS common)
++
+ set(srcs
+   src/debayer.cpp
+   src/pcd_grabber.cpp
+@@ -432,7 +434,7 @@ if(WITH_ENSENSO)
+   list(APPEND EXT_DEPS ensenso)
+ endif()
+ 
