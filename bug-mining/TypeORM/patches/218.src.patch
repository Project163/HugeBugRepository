+                        // build queries
+                        let up =
+                            `ALTER TABLE ${this.escapePath(
+                                table,
+                            )} DROP FOREIGN KEY \`${
+                                foreignKey.name
+                            }\`, ADD CONSTRAINT \`${newForeignKeyName}\` FOREIGN KEY (${columnNames}) ` +
+                            `REFERENCES ${this.escapePath(
+                                this.getTablePath(foreignKey),
+                            )}(${referencedColumnNames})`
