scription":"High Priority"},{"id":3108235291,"node_id":"MDU6TGFiZWwzMTA4MjM1Mjkx","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/area/cdcsdk","name":"area/cdcsdk","color":"6C1C93","default":false,"description":"CDC SDK"},{"id":4199362411,"node_id":"LA_kwDOBlCVUc76TS9r","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/2.14%20Backport%20Required","name":"2.14 Backport Required","color":"bfdadc","default":false,"description":""},{"id":4721920290,"node_id":"LA_kwDOBlCVUc8AAAABGXLJIg","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/2.16%20Backport%20Required","name":"2.16 Backport Required","color":"24F4C7","default":false,"description":""}],"state":"closed","locked":false,"assignee":{"login":"adithya-kb","id":24984282,"node_id":"MDQ6VXNlcjI0OTg0Mjgy","avatar_url":"https://avatars.githubusercontent.com/u/24984282?v=4","gravatar_id":"","url":"https://api.github.com/users/adithya-kb","html_url":"https://github.com/adithya-kb","followers_url":"https://api.github.com/users/adithya-kb/followers","following_url":"https://api.github.com/users/adithya-kb/following{/other_user}","gists_url":"https://api.github.com/users/adithya-kb/gists{/gist_id}","starred_url":"https://api.github.com/users/adithya-kb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adithya-kb/subscriptions","organizations_url":"https://api.github.com/users/adithya-kb/orgs","repos_url":"https://api.github.com/users/adithya-kb/repos","events_url":"https://api.github.com/users/adithya-kb/events{/privacy}","received_events_url":"https://api.github.com/users/adithya-kb/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"adithya-kb","id":24984282,"node_id":"MDQ6VXNlcjI0OTg0Mjgy","avatar_url":"https://avatars.githubusercontent.com/u/24984282?v=4","gravatar_id":"","url":"https://api.github.com/users/adithya-kb","html_url":"https://github.com/adithya-kb","followers_url":"https://api.github.com/users/adithya-kb/followers","following_url":"https://api.github.com/users/adithya-kb/following{/other_user}","gists_url":"https://api.github.com/users/adithya-kb/gists{/gist_id}","starred_url":"https://api.github.com/users/adithya-kb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adithya-kb/subscriptions","organizations_url":"https://api.github.com/users/adithya-kb/orgs","repos_url":"https://api.github.com/users/adithya-kb/repos","events_url":"https://api.github.com/users/adithya-kb/events{/privacy}","received_events_url":"https://api.github.com/users/adithya-kb/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":1,"created_at":"2023-02-17T08:26:31Z","updated_at":"2023-03-04T05:23:56Z","closed_at":"2023-03-04T05:23:56Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Jira Link: [DB-5583](https://yugabyte.atlassian.net/browse/DB-5583)\r\nIf a cluster is upgraded from any version lesser than 2.14 to 2.14 or greater there is an issue with the initialisation of CDCSDK checkpoint per tablet. The value is initialised from the \"cdc_sdk_min_checkpoint_op_id\" field of raft superblock. \r\nIn cases for tablets created before the upgrade, after the update this value defaults to OpId() (term: 0, index: 0). This has side-effects since if this checkpoint has any other value than -1.-1 we assume CDC has been enabled for the tablet. \r\nAs a fix, whenever we see that 'cdc_sdk_min_checkpoint_op_id_' will be set to  the OpId 0.0 , we instead set it to -1.-1. \n\n[DB-5583]: https://yugabyte.atlassian.net/browse/DB-5583?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","closed_by":{"login":"yugabyte-ci","id":17281578,"node_id":"MDQ6VXNlcjE3MjgxNTc4","avatar_url":"https://avatars.githubusercontent.com/u/17281578?v=4","gravatar_id":"","url":"https://api.github.com/users/yugabyte-ci","html_url":"https://github.com/yugabyte-ci","followers_url":"https://api.github.com/users/yugabyte-ci/followers","following_url":"https://api.github.com/users/yugabyte-ci/following{/other_user}","gists_url":"https://api.github.com/users/yugabyte-ci/gists{/gist_id}","starred_url":"https://api.github.com/users/yugabyte-ci/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yugabyte-ci/subscriptions","organizations_url":"https://api.github.com/users/yugabyte-ci/orgs","repos_url":"https://api.github.com/users/yugabyte-ci/repos","events_url":"https://api.github.com/users/yugabyte-ci/events{/privacy}","received_events_url":"https://api.github.com/users/yugabyte-ci/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/16147/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/16147/timeline","performed_via_github_app":null,"state_reason":"completed"}