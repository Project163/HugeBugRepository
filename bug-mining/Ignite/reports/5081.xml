            <title>[IGNITE-15943] Regression: Ignite node crash(CorruptedTreeException: B+Tree is corrupted)</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-15943</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;create table test1(id varchar primary key, flag long);&lt;/p&gt;

&lt;p&gt;create index index_test1_flag on test1 ( flag );&lt;/p&gt;

&lt;p&gt;insert into test1(id, flag) values(&apos;a1&apos;, 1);&lt;/p&gt;

&lt;p&gt;select * from test1 where flag&amp;lt;100*0.5;&lt;/p&gt;

&lt;p&gt;then ignite crashed.&lt;/p&gt;</description>
