dencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Geometries having Face4's with MeshFaceMaterial assigned will throw a \"map error\" after merging vertices with Geometry.mergeVertices.\n\nReason is obvious: mergeVertices triangulates the Face4 to two Face3's but doesn't copy over Face4.materialIndex.\n\nSo after mergeVertices the geometry contains Face3's without Face3.materialIndex set. \nThen of course MeshFaceMaterial can't find its material.\n","closed_by":{"login":"timknip","id":48036,"node_id":"MDQ6VXNlcjQ4MDM2","avatar_url":"https://avatars.githubusercontent.com/u/48036?v=4","gravatar_id":"","url":"https://api.github.com/users/timknip","html_url":"https://github.com/timknip","followers_url":"https://api.github.com/users/timknip/followers","following_url":"https://api.github.com/users/timknip/following{/other_user}","gists_url":"https://api.github.com/users/timknip/gists{/gist_id}","starred_url":"https://api.github.com/users/timknip/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timknip/subscriptions","organizations_url":"https://api.github.com/users/timknip/orgs","repos_url":"https://api.github.com/users/timknip/repos","events_url":"https://api.github.com/users/timknip/events{/privacy}","received_events_url":"https://api.github.com/users/timknip/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/mrdoob/three.js/issues/2175/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/mrdoob/three.js/issues/2175/timeline","performed_via_github_app":null,"state_reason":"completed"}