17.0.1/bin/node\r\n    npm: 8.13.1 - ~/.nvm/versions/node/v17.0.1/bin/npm\r\n  Browsers:\r\n    Chrome: 104.0.5112.101\r\n    Safari: 15.5\n```\n\n\n### Any additional comments?\n\n_No response_","reactions":{"url":"https://api.github.com/repos/vuejs/core/issues/6613/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vuejs/core/issues/6613/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}},"event":"cross-referenced"},{"id":7352682687,"node_id":"REFE_lADOCCum185Qn922zwAAAAG2QQi_","url":"https://api.github.com/repos/vuejs/core/issues/events/7352682687","actor":{"login":"wmfgerrit","id":2539292,"node_id":"MDQ6VXNlcjI1MzkyOTI=","avatar_url":"https://avatars.githubusercontent.com/u/2539292?v=4","gravatar_id":"","url":"https://api.github.com/users/wmfgerrit","html_url":"https://github.com/wmfgerrit","followers_url":"https://api.github.com/users/wmfgerrit/followers","following_url":"https://api.github.com/users/wmfgerrit/following{/other_user}","gists_url":"https://api.github.com/users/wmfgerrit/gists{/gist_id}","starred_url":"https://api.github.com/users/wmfgerrit/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wmfgerrit/subscriptions","organizations_url":"https://api.github.com/users/wmfgerrit/orgs","repos_url":"https://api.github.com/users/wmfgerrit/repos","events_url":"https://api.github.com/users/wmfgerrit/events{/privacy}","received_events_url":"https://api.github.com/users/wmfgerrit/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"6287f4873c05a1b89e97234cadcf7f26b226c2fb","commit_url":"https://api.github.com/repos/wikimedia/design-codex/commits/6287f4873c05a1b89e97234cadcf7f26b226c2fb","created_at":"2022-09-09T02:14:55Z","performed_via_github_app":null},{"id":8005481850,"node_id":"REFE_lADOCCum185Qn922zwAAAAHdKfV6","url":"https://api.github