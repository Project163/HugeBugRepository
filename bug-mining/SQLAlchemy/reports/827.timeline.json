 AS people_1_person_id, \"\r\n+            \"people_1.type AS people_1_type, \"\r\n+            \"managers_1.person_id AS managers_1_person_id, \"\r\n+            \"managers_1.status AS managers_1_status \"\r\n+            \"FROM people AS people_1 \"\r\n+            \"LEFT OUTER JOIN managers AS managers_1 \"\r\n+            \"ON people_1.person_id = managers_1.person_id\",\r\n+        )\r\n+\r\n+        # now from relationship w of_type\r\n+\r\n+        # doesn't fail\r\n+        q = s.query(Company).options(\r\n+            joinedload(Company.employees.of_type(wp)).load_only(Manager.status)\r\n+        )\r\n+\r\n+        q = s.query(Company).options(\r\n+            joinedload(Company.employees.of_type(wp)).load_only(wp.Manager.status)\r\n+        )\r\n+\r\n+        self.assert_compile(\r\n+            q,\r\n+            # should at least not have manager_name in it\r\n+            \"SELECT companies.company_id AS companies_company_id, \"\r\n+            \"companies.name AS companies_name, \"\r\n+            \"people_1.person_id AS people_1_person_id, \"\r\n+            \"people_1.type AS people_1_type, \"\r\n+            \"managers_1.person_id AS managers_1_person_id, \"\r\n+            \"managers_1.status AS managers_1_status \"\r\n+            \"FROM companies LEFT OUTER JOIN \"\r\n+            \"(people AS people_1 LEFT OUTER JOIN managers AS managers_1 \"\r\n+            \"ON people_1.person_id = managers_1.person_id) \"\r\n+            \"ON companies.company_id = people_1.company_id \"\r\n+            \"ORDER BY people_1.person_id\",\r\n+        )\r\n+\r\n \r\n class WithExpressionTest(fixtures.DeclarativeMappedTest):\r\n     @classmethod\r\n\r\n```","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/4469/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/4469/timeline","performed_via_github_app":null,"s