ammapy/gammapy/deployments","created_at":"2013-05-15T07:50:40Z","updated_at":"2025-12-12T17:59:11Z","pushed_at":"2025-12-12T22:37:04Z","git_url":"git://github.com/gammapy/gammapy.git","ssh_url":"git@github.com:gammapy/gammapy.git","clone_url":"https://github.com/gammapy/gammapy.git","svn_url":"https://github.com/gammapy/gammapy","homepage":"https://gammapy.org","size":52500,"stargazers_count":269,"watchers_count":269,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":224,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":245,"license":{"key":"bsd-3-clause","name":"BSD 3-Clause \"New\" or \"Revised\" License","spdx_id":"BSD-3-Clause","url":"https://api.github.com/licenses/bsd-3-clause","node_id":"MDc6TGljZW5zZTU="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["astronomy","astropy","awesome","numpy","python"],"visibility":"public","forks":224,"open_issues":245,"watchers":269,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Triggered by https://github.com/PyCQA/pylint/issues/2410#issuecomment-415026690 I had a look at `table_psf_in_energy_band` and have some suggestions.\r\n\r\nhttps://github.com/gammapy/gammapy/blob/cb993b580e8a54a776ed9fcaf534eddd320e79e4/gammapy/irf/psf_table.py#L520-L521\r\n\r\nCurrently there are two ways to define the spectrum to use for weighting. Pass a `spectrum` or a `spectral_index`. Passing a `spectrum` is completely untested, and given the complex way it's implemented with the min energy could be broken. See callers:\r\n\r\n```\r\n$ ack table_psf_in_energy_band gammapy\r\ngammapy/irf/tests/test_psf_table.py\r\n115:        psf_band = self.psf.table_psf_in_energy_band(energy_band)\r\n\r\ngammapy/irf/psf_table.py\r\n518:    def table_psf_in_energy_band(self, energy_band, spectral_index=2,\r\n\r\ngammapy/data/tests/test_observations.py\r\n113:    psf1_int = psf1.table_psf_in_energy_band(energy_band, spectral_index=2.3)\r\n114:    psf2_int = psf2.table_psf_in_energy_band(energy_band, spectral_index=2.3)\r\n117:    psf_tot_int = psf_tot.table_psf_in_energy_band(energy_band, spectral_index=2.3)\r\n```\r\n\r\nMy suggestions would be to remove the `spectral_index` option, and to only keep the `spectrum=None` option and to make a `spectrum = PowerLaw(index=2.0)` as default, like @registerrier did here:\r\nhttps://github.com/gammapy/gammapy/blob/ce4fe8a77d9bf8aded002234f0a50d136bdc63fa/gammapy/cube/exposure.py#L48\r\n\r\nI'm not attempting this now, because the current implementation of `table_psf_in_energy_band` is pretty complex and has three TODO comments. I think it should be possible to compute the weights using Numpy array expressions, and also to apply them using a Numpy array expression, i.e. this should reduce to ~ 5 lines.\r\n\r\n@registerrier or anyone - interested in this task?","reactions":{"url":"https://api.github.com/repos/gammapy/gammapy/issues/1740/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/gammapy/gammapy/issues/1740/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":3081371070,"node_id":"MDExOkNsb3NlZEV2ZW50MzA4MTM3MTA3MA==","url":"https://api.github.com/repos/pylint-dev/pylint/issues/events/3081371070","actor":{"login":"PCManticore","id":448166,"node_id":"MDQ6VXNlcjQ0ODE2Ng==","avatar_url":"https://avatars.githubusercontent.com/u/448166?v=4","gravatar_id":"","url":"https://api.github.com/users/PCManticore","html_url":"https://github.com/PCManticore","followers_url":"https://api.github.com/users/PCManticore/followers","following_url":"https://api.github.com/users/PCManticore/following{/other_user}","gists_url":"https://api.github.com/users/PCManticore/gists{/gist_id}","starred_url":"https://api.github.co