@@ -1143,6 +1143,8 @@ class TypeChecker(NodeVisitor[Type]):
         if len(s.lvalues) > 1:
             # Chained assignment (e.g. x = y = ...).
             # Make sure that rvalue type will not be reinferred.
+            if s.rvalue not in self.type_map:
