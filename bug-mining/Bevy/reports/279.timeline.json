the adapter supports the features which will cause a panic.\r\n\r\nWe really need to break up wgpu creation to allow users to query the adapter for supported features before creating the device, as there are going to be times where you don't want to run if an adapter doesn't support a feature, and times where it's fine and you can just fall back to a different path (eg. think using Int16 in shaders as an optimization, and falling back to Int32 if Int16 is unsupported).","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1405690869/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Elabajaba","id":177631,"node_id":"MDQ6VXNlcjE3NzYzMQ==","avatar_url":"https://avatars.githubusercontent.com/u/177631?v=4","gravatar_id":"","url":"https://api.github.com/users/Elabajaba","html_url":"https://github.com/Elabajaba","followers_url":"https://api.github.com/users/Elabajaba/followers","following_url":"https://api.github.com/users/Elabajaba/following{/other_user}","gists_url":"https://api.github.com/users/Elabajaba/gists{/gist_id}","starred_url":"https://api.github.com/users/Elabajaba/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Elabajaba/subscriptions","organizations_url":"https://api.github.com/users/Elabajaba/orgs","repos_url":"https://api.github.com/users/Elabajaba/repos","events_url":"https://api.github.com/users/Elabajaba/events{/privacy}","received_events_url":"https://api.github.com/users/Elabajaba/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1405890519","html_url":"https://github.com/bevyengine/bevy/issues/7374#issuecomment-1405890519","issue_url":"https://api.github.com/repos/bevyengine/bevy/issues/7374","id":1405890519,"node_id":"IC_kwDODf6-U85TzC_X","user