aker::Lorem.paragraph(1)\n    short_desc Faker::Lorem.paragraph(3).to_s\n    long_desc Faker::Lorem.paragraphs(3).to_s\n    specs Faker::Lorem.paragraphs(3).to_s\n    featured_photo {\n      Photo.create\n    }\n    account {\n      FactoryGirl.create(:account)\n    }\n  end\n\n  factory :product_with_wordpress_content, parent: :product do\n    long_desc \"<div class=\\\"post_content\\\"> \\n\\t\\t\\t<p>Madera seca cepillada clasificada según su resistencia. Especialmente indicada para usos de envigados, tijerales, escaleras, muros estructurales y estructuras en general.</p>\\n<p><span id=\\\"more-5993\\\"></span></p>\\n<h3>Características</h3>\\n<ul>\\n<li>Madera clasificada de acuerdo a la norma chilena NCh1207 – Clasificación visual para uso estructural o alternativamente graduada mecánicamente según la norma europea BS EN – 519:1995.</li>\\n<li>Seco en cámara.</li>\\n<li>Timbre en cada pieza que garantiza su resistencia.</li>\\n<li>Contenido de humedad de 15% promedio.</li>\\n<li>Terminación cepillada en las 4 caras</li>\\n</ul>\\n<h3>Ventajas del MSD Estructural</h3>\\n<ul>\\n<li>La madera estructural tiene asignados valores de resistencia que permiten calcular estructuras con eficiencia y seguridad.</li>\\n<li>Diseñada especialmente para usos donde se requiere cubrir luces hasta 4,88m, como vigas y tijerales.</li>\\n<li>Mejor retención de fijaciones.</li>\\n<li>Se eliminan problemas de deformación y agrietamiento de revestimientos de muros y cielos.</li>\\n</ul>\\n<p><img class=\\\"imageframe\\\" src=\\\"http://static.plataformaarquitectura.cl/wp-content/uploads/2008/02/649967642_arauco_msd_estructural_caracteristicas.jpg\\\" alt=\\\"649967642_arauco_msd_estructural_caracteristicas.jpg\\\" width=\\\"530\\\" height=\\\"464\\\"></p>\\n<h3><strong>Obras en Plataforma Arquitectura donde se ha usado MSD Estructural<br></strong></h3>\\n<p>DUOC Puente Alto<br>\\nArquitectos: <strong>Sabbagh Arquitectos </strong>(<a href=\\\"http://www.sabbagharquitectos.cl\\\">www.sabbagharquitectos.cl</a>)</p>\\n<p><a title=\\\"2025638124_img_6842.JPG\\\" href=\\\"http://static.plataformaarquitectura.cl/wp-content/uploads/2008/02/2025638124_img_6842.JPG\\\" target=\\\"_blank\\\"><img class=\\\"imageframe\\\" src=\\\"http://static.plataformaarquitectura.cl/wp-content/uploads/2008/02/2025638124_img_6842.thumbnail.JPG\\\" alt=\\\"2025638124_img_6842.JPG\\\" width=\\\"125\\\" height=\\\"125\\\"></a> <a title=\\\"1843495170_img_a1279.JPG\\\" href=\\\"http://static.plataformaarquitectura.cl/wp-content/uploads/2008/02/1843495170_img_a1279.JPG\\\" target=\\\"_blank\\\"><img class=\\\"imageframe\\\" src=\\\"http://static.plataformaarquitectura.cl/wp-content/uploads/2008/02/1843495170_img_a1279.thumbnail.JPG\\\" alt=\\\"1843495170_img_a1279.JPG\\\" width=\\\"125\\\" height=\\\"125\\\"></a> <a title=\\\"1316292679_img_a1307.JPG\\\" href=\\\"http://static.plataformaarquitectura.cl/wp-content/uploads/2008/02/1316292679_img_a1307.JPG\\\" target=\\\"_blank\\\"><img class=\\\"imageframe\\\" src=\\\"http://static.plataformaarquitectura.cl/wp-content/uploads/2008/02/1316292679_img_a1307.thumbnail.JPG\\\" alt=\\\"1316292679_img_a1307.JPG\\\" width=\\\"125\\\" height=\\\"125\\\"></a> <a title=\\\"599221959_img_1340.JPG\\\" href=\\\"http://static.plataformaarquitectura.cl/wp-content/uploads/2008/02/599221959_img_1340.JPG\\\" target=\\\"_blank\\\"><img class=\\\"imageframe\\\" src=\\\"http://static.plataformaarquitectura.cl/wp-content/uploads/2008/02/599221959_img_1340.thumbnail.JPG\\\" alt=\\\"599221959_img_1340.JPG\\\" width=\\\"125\\\" height=\\\"125\\\"></a></p>\\n<h3>Más información sobre este producto</h3>\\n<ul>\\n<li><a title=\\\"Ficha técnica (PDF)\\\" href=\\\"http://static.plataformaarquitectura.cl/wp-content/uploads/2008/02/58937410_msd_estructural.pdf\\\">Ficha técnica (PDF)</a></li>\\n<li><a href=\\\"http://www.construyaenmadera.cl/\\\">Constuya en Madera – Arauco</a></li>\\n</ul>\\n</div>\"\n    featured_photo{\n      Photo.create(image_name: '649967642_arauco_msd_estructural_caracteristicas.jpg' )\n    }\n  end\n\n  factory :product_in_step_media, parent: :product do\n    step_status \"media\"\n  end\n\n  factory :product_in_step_categories, parent: :product do\n    step_status \"categories\"\n  end\n\n  factory :product_in_step_content, parent: :product do\n    step_status \"content\"\n  end\n\n  factory :product_in_step_complete, parent: :product do\n    step_status \"complete\"\n  end\n\nend\n\n```\n\nThanks.\n","closed_by":{"login":"justinmk","id":1359421,"node_id":"MDQ6VXNlcjEzNTk0MjE=","avatar_url":"https://avatars.githubusercontent.com/u/1359421?v=4","gravatar_id":"","url":"https://api.github.com/users/justinmk","html_url":"https://github.com/justinmk","followers_url":"https://api.github.com/users/justinmk/followers","following_url":"https://api.github.com/users/justinmk/following{/other_user}","gists_url":"https://api.github.com/users/justinmk/gists{/gist_id}","starred_url":"https://api.github.com/users/justinmk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/justinmk/subscriptions","organizations_url":"https://api.github.com/users/justinmk/orgs","repos_url":"https://api.github.com/users/justinmk/repos","events_url":"https://api.github.com/users/justinmk/events{/privacy}","received_events_url":"https://api.github.com/users/justinmk/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/neovim/neovim/issues/2472/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/neovim/neovim/issues/2472/timeline","performed_via_github_app":null,"state_reason":"completed"}