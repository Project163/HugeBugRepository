{/other_user}","gists_url":"https://api.github.com/users/davecarlson/gists{/gist_id}","starred_url":"https://api.github.com/users/davecarlson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/davecarlson/subscriptions","organizations_url":"https://api.github.com/users/davecarlson/orgs","repos_url":"https://api.github.com/users/davecarlson/repos","events_url":"https://api.github.com/users/davecarlson/events{/privacy}","received_events_url":"https://api.github.com/users/davecarlson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-08-10T09:13:08Z","updated_at":"2023-08-10T09:13:29Z","body":"Try adding this to \r\nnode_modiles/next/dist/server/lib/server-ipc/utils.js\r\nhttps://github.com/vercel/next.js/blob/d4ff236f4888c11ad36fe46de15b6b1c01098818/packages/next/src/server/lib/server-ipc/utils.ts\r\n\r\nBefore:\r\n```\r\nconst filterReqHeaders = (headers, forbiddenHeaders)=>{\r\n    \r\n    for (const [key, value] of Object.entries(headers)){\r\n        if (forbiddenHeaders.includes(key) || !(Array.isArray(value) || typeof value === \"string\")) {\r\n            delete headers[key];\r\n        }\r\n    }\r\n    return headers;\r\n};\r\n```\r\n\r\nAfter:\r\n```\r\nconst filterReqHeaders = (headers, forbiddenHeaders)=>{\r\n\r\n    if (headers['content-length'] && headers['content-length'] === '0') {\r\n        delete headers['content-length']\r\n    }\r\n    \r\n    for (const [key, value] of Object.entries(headers)){\r\n        if (forbiddenHeaders.includes(key) || !(Array.isArray(value) || typeof value === \"string\")) {\r\n            delete headers[key];\r\n        }\r\n    }\r\n    return headers;\r\n};\r\n```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1672854155/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor"