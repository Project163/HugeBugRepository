e/yugabyte-db/events","assignees_url":"https://api.github.com/repos/yugabyte/yugabyte-db/assignees{/user}","branches_url":"https://api.github.com/repos/yugabyte/yugabyte-db/branches{/branch}","tags_url":"https://api.github.com/repos/yugabyte/yugabyte-db/tags","blobs_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/refs{/sha}","trees_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/trees{/sha}","statuses_url":"https://api.github.com/repos/yugabyte/yugabyte-db/statuses/{sha}","languages_url":"https://api.github.com/repos/yugabyte/yugabyte-db/languages","stargazers_url":"https://api.github.com/repos/yugabyte/yugabyte-db/stargazers","contributors_url":"https://api.github.com/repos/yugabyte/yugabyte-db/contributors","subscribers_url":"https://api.github.com/repos/yugabyte/yugabyte-db/subscribers","subscription_url":"https://api.github.com/repos/yugabyte/yugabyte-db/subscription","commits_url":"https://api.github.com/repos/yugabyte/yugabyte-db/commits{/sha}","git_commits_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/commits{/sha}","comments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/comments{/number}","issue_comment_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments{/number}","contents_url":"https://api.github.com/repos/yugabyte/yugabyte-db/contents/{+path}","compare_url":"https://api.github.com/repos/yugabyte/yugabyte-db/compare/{base}...{head}","merges_url":"https://api.github.com/repos/yugabyte/yugabyte-db/merges","archive_url":"https://api.github.com/repos/yugabyte/yugabyte-db/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/yugabyte/yugabyte-db/downloads","issues_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues{/number}","pulls_url":"https://api.github.com/repos/yugabyte/yugabyte-db/pulls{/number}","milestones_url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones{/number}","notifications_url":"https://api.github.com/repos/yugabyte/yugabyte-db/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels{/name}","releases_url":"https://api.github.com/repos/yugabyte/yugabyte-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Jira Link: [DB-830](https://yugabyte.atlassian.net/browse/DB-830)\r\n### Description\n\nSome time ago I discovered a potential RBS+local bootstrap issue: https://github.com/yugabyte/yugabyte-db/issues/9500.\r\n\r\nWhen working on fixes for https://github.com/yugabyte/yugabyte-db/issues/10301 I looked more deeply into that and it turned out we don’t even need tablet splitting and/or RBS to hit the issue due to the local bootstrap optimizer.\r\n\r\nIn addition to the fact that “During RBS we don’t fetch the Raft log index and then during local bootstrap optimizer can skip log index recreation for some of the first raft log segments, so the Raft log index might be incomplete.” mentioned in 9500 there is also the following:\r\n- Raft log index is managed by `LogIndex` class that has two most used API functions: `AddEntry` (used during Raft log write to add an entry offset to the log index) and `GetEntry` (used to get the offset of specific Raft log entry by index).\r\n- `LogIndex` class is implemented in a way that on `AddEntry` call it updates log index in mmaped file (actually it uses multiple files - chunks, multiple entries per chunk file). And `LogIndex` maintains a map of mmaped files in memory (`LogIndex::open_chunks_ `).\r\n- `LogIndex::GetEntry` is looking for log index chunk inside `LogIndex::open_chunks_` and returns not found error if chunk is not opened even if chunk is on disk.\r\n- So, looks like `LogIndex` class is not designed to be durable and survive restarts and is intended to be rebuilt on restarts, this is also in line with the following comments:\r\n```\r\n// An on-disk structure which indexes from OpId index to the specific position in the WAL\r\n// which contains the latest ReplicateMsg for that index.\r\n//\r\n// This structure is on-disk but *not durable*. We use mmap()ed IO to write it out, and\r\n// never sync it to disk. Its only purpose is to allow random-reading earlier entries from\r\n// the log to serve to Raft followers.\r\n```\r\n\r\nBefore we implemented the local bootstrap optimizer - this was working fine, because the whole Raft log was replayed at opening the tablet and we were rebuilding `LogIndex` from scratch as part of it. But now, the local bootstrap optimizer can skip replaying the first segments of the Raft log.\r\n\r\nSo, we can have the following scenario (and I confirmed this by test):\r\n1. RF=3, 3-node cluster.\r\n2. Tablet X has replicas on TS1, …, TS3\r\n3. TS3 goes offline. TS1 is a leader.\r\n4. Write enough data into X on TS1. This creates multiple Raft log segments and multiple Raft log index chunks.\r\n5. Flush tablet X - this updates flushed_op_id inside RocksDB.\r\n6. Restart TS1 and TS2.\r\n7. On local tablet bootstrap TS1 (and TS2) replays only last Raft log segment, because of local bootstrap optimizer logic.\r\n8. `LogIndex::open_chunks_` only has the last log index chunks for entries been replayed by local bootstrap.\r\n9. TS3 goes online.\r\n10. Leader (ts-2 in my test run) is trying to include Raft operations from Raft log into `UpdateConsensus` RPC for TS3 and uses the following calls sequence for it:\r\n```\r\n[ts-2]     @     0x7fc85a03a028  yb::log::LogIndex::GetChunkForIndex(long, bool, scoped_refptr<yb::log::LogIndex::IndexChunk>*) (src/yb/consensus/log_index.cc:223)\r\n[ts-2]     @     0x7fc85a03a7fa  yb::log::LogIndex::GetEntry(long, yb::log::LogIndexEntry*) (src/yb/consensus/log_index.cc:265)\r\n[ts-2]     @     0x7fc85a042b8e  yb::log::LogReader::LookupOpId(long) const (src/yb/consensus/log_reader.cc:518)\r\n[ts-2]     @     0x7fc85a4f2889  yb::consensus::LogCache::LookupOpId(long) const (src/yb/consensus/log_cache.cc:273)\r\n[ts-2]     @     0x7fc85a4f2c11  yb::consensus::LogCache::ReadOps(long, long, int, std::chrono::time_point<yb::CoarseMonoClock, std::chrono::duration<long, std::ratio<1l, 1000000000l> > >) (src/yb/consensus/log_cache.cc:304)\r\n[ts-2]     @     0x7fc85a4b160b  yb::consensus::PeerMessageQueue::ReadFromLogCache(long, long, int, std::__cxx11::basic_string<char, std::char_traits<char>, std::allocator<char> > const&, std::chrono::time_point<yb::CoarseMonoC\r\nlock, std::chrono::duration<long, std::ratio<1l, 1000000000l> > >) (src/yb/consensus/consensus_queue.cc:659)\r\n[ts-2]     @     0x7fc85a4b04f2  yb::consensus::PeerMessageQueue::RequestForPeer(std::__cxx11::basic_string<char, std::char_traits<char>, std::allocator<char> > const&, yb::consensus::ConsensusRequestPB*, yb::consensus::Replica\r\nteMsgsHolder*, bool*, yb::consensus::RaftPeerPB_MemberType*, bool*) (src/yb/consensus/consensus_queue.cc:568)\r\n[ts-2]     @     0x7fc85a49e1b3  yb::consensus::Peer::SendNextRequest(yb::consensus::RequestTriggerMode) (src/yb/consensus/consensus_peers.cc:221)\r\n```\r\n\r\nSince `LogIndex::open_chunks_` doesn’t contain first chunks, leader thinks it doesn’t have old Raft log operations, so we have an error:\r\n```\r\n[ts-2] I1222 19:19:06.309705 14843 consensus_peers.cc:226] T 4d16ddf05d7642f2be6492c12f8f875f P 100c6bd465fc415e829f781a4ebb0171 -> Peer bbbf730f78754dfdab1f34367cbe825a ([host: \"127.55.232.0\" port: 18581], []): Could not obtain request from queue for peer: Not found (yb/consensus/log_index.cc:224): Failed to read log index for op 1: chunk 0 not found for index 1\r\n[ts-2] I1222 19:19:06.310084 14845 raft_consensus.cc:1457] T 4d16ddf05d7642f2be6492c12f8f875f P 100c6bd465fc415e829f781a4ebb0171 [term 3 LEADER]: Attempting to remove follower bbbf730f78754dfdab1f34367cbe825a from the Raft config at commit index -1. Reason: The logs necessary to catch up peer bbbf730f78754dfdab1f34367cbe825a have been garbage collected. The follower will never be able to catch up (Not found (yb/consensus/log_index.cc:224): Failed to read log index for op 1: chunk 0 not found for index 1)\r\n```\r\n\r\nAfter that I suppose it will do RBS for ts-2 and as a result of RBS it will also have a missing Raft log index on ts-2, but it will probably be the issue in RF>=5, so we can have another lagging follower that will fail to catchup.\r\n\r\nBut the main conclusion is that `LogIndex` was not designed to be durable and was designed to be rebuilt on local tablet bootstrap and with bootstrap optimization we are breaking this logic.\r\n\r\nAnother potential issue is that since LogIndex is not durable, its latest state might be not synced/flushed to the disk and tserver restart, we will read garbage from the part of log index chunk/file that wasn’t rebuilt during tablet bootstrap. And then this garbage will be used as an offset to where to read Raft log entry from.\r\n","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/10960/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/10960/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"actor":{"login":"ttyusupov","id":903044,"node_id":"MDQ6VXNlcjkwMzA0NA==","avatar_url":"https://avatars.githubusercontent.com/u/903044?v=4","gravatar_id":"","url":"https://api.github.com/users/ttyusupov","html_url":"https://github.com/ttyusupov","followers_url":"https://api.github.com/users/ttyusupov/followers","following_url":"https://api.github.com/users/ttyusupov/following{/other_user}","gists_url":"https://api.github.com/users/ttyusupov/gists{/gist_id}","starred_url":"https://api.github.com/users/ttyusupov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ttyusupov/subscriptions","organizations_url":"https://api.github.com/users/ttyusupov/orgs","repos_url":"https://api.github.com/users/ttyusupov/repos","events_url":"https://api.github.com/users/ttyusupov/events{/privacy}","received_events_url":"https://api.github.com/users/ttyusupov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-01-20T12:05:37Z","updated_at":"2022-01-20T12:05:37Z","source":{"type":"issue","issue":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/11148","repository_url":"https://api.github.com/repos/yugabyte/yugabyte-db","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/11148/labels{/name}","comments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/11148/comments","events_url":"https://api.github.com/repos/yug