ient/async-http-client.git","svn_url":"https://github.com/AsyncHttpClient/async-http-client","homepage":"","size":19168,"stargazers_count":6397,"watchers_count":6397,"language":"Java","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":true,"has_discussions":true,"forks_count":1592,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":106,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["ahc","async","asynchttpclient","http-client","java","netty"],"visibility":"public","forks":1592,"open_issues":106,"watchers":6397,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"`AllowAllHostnameVerifier` is used if user does not explicitly set another `HostnameVerifier`. \n\nI consider this to be a security issue and think this should be an opt-in setting instead. If there are any good reasons to do so, then default behavior should at least be clearly indicated in user guide.\n","reactions":{"url":"https://api.github.com/repos/AsyncHttpClient/async-http-client/issues/197/reactions","total_count":2,"+1":1,"-1":0,"laugh":1,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/AsyncHttpClient/async-http-client/issues/197/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/netty/netty/issues/comments/40694546","html_url":"https://github.com/netty/netty/issues/1823#issuecomment-40694546","issue_url":"https://api.github.com/repos/netty/netty/issues/1823","id":40694546,"node_id":"MDEyOklzc3VlQ29tbWVudDQwNjk0NTQ2","user":{"login":"zoltan-tornoczky","id":2588563,"node_id":"MDQ6VXNlcjI1ODg1NjM=","avatar_url":"https://avatars.githubusercontent.com/u/2588563?v=4","gravatar_id":"","url":"https://api.github.com/users/zoltan-tornoczky","html_url":"https://github.com/zoltan-tornoczky","followers_url":"https://api.github.com/users/zoltan-tornoczky/followers","following_url":"https://api.github.com/users/zoltan-tornoczky/following{/other_user}","gists_url":"https://api.github.com/users/zoltan-tornoczky/gists{/gist_id}","starred_url":"https://api.github.com/users/zoltan-tornoczky/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zoltan-tornoczky/subscriptions","organizations_url":"https://api.github.com/users/zoltan-tornoczky/orgs","repos_url":"https://api.github.com/users/zoltan-tornoczky/repos","events_url":"https://api.github.com/users/zoltan-tornoczky/events{/privacy}","received_events_url":"https://api.github.com/users/zoltan-tornoczky/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-04-17T09:00:53Z","updated_at":"2014-04-18T08:18:55Z","body":"Found a workaround, it is based on this fix in another project: https://github.com/jkeljo/restlet-framework-java/commit/e704f93c16da127780722bc1abba214a680a1dd9\nIt says that Android skips the FINISHED handshake event and gives NOT_HANDSHAKING. That fix just assumes finished on the first NOT_HANDSHAKING message when the wrapper's state is handshaking.\n\nHere's a simple fix, I don't know if it's complete, or even if it's OK for every situation, but it works. Sorry for not making a pull request, I copy-pasted the SSLHandler source and fixed in my own class, didn't wanted to clone and build the entire netty. Change case NOT_HANDSHAKING in SslHandler.unwrap(ChannelHandlerContext ctx, ByteBuffer packet, List<Object> out) (line 865 currently in master) to this:\n\n``` java\n                        case NOT_HANDSHAKING:\n\n                        // FIX Android could skip FINISHED and go directly to NOT_HANDSHAKING, bypass this\n                        // If the handler does not know about handshake finish, set finished\n                        if (!handshakeFuture().isDone()) {\n                            setHandshakeSuccess();\n                            wrapLater = true;\n                            continue;\n                        }\n\n                        break;\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/netty/netty/issues/comments/40694546/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zoltan-tornoczky","id":2588563,"node_id":"MDQ6VXNlcjI1ODg1NjM=","avatar_url":"https://avatars.githubusercontent.com/u/2588563?v=4","gravatar_id":"","url":"https://api.github.com/users/zoltan-tornoczky","html_url":"https://github.com/zoltan-tornoczky","followers_url":"https://api.github.com/users/zoltan-tornoczky/followers","following_url":"https://api.github.com/users/zoltan-tornoczky/following{/other_user}","gists_url":"https://api.github.com/users/zoltan-tornoczky/gists{/gist_id}","starred_url":"https://api.github.com/users/zoltan-tornoczky/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zoltan-tornoczky/subscriptions","organizations_url":"https://api.github.com/users/zoltan-tornoczky/orgs","repos_url":"https://api.github.com/users/zoltan-tornoczky/repos","events_url":"https://api.github.com/users/zoltan-tornoczky/events{/privacy}","received_events_url":"https://api.github.com/users/zoltan-tornoczky/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":113010688,"node_id":"MDE1Ok1pbGVzdG9uZWRFdmVudDExMzAxMDY4OA==","url":"https://api.github.com/repos/netty/netty/issues/events/113010688","actor":{"login":"trustin","id":173918,"node_id":"MDQ6VXNlcjE3MzkxOA==","avatar_url":"https://avatars.githubusercontent.com/u/173918?v=4","gravatar_id":"","url":"https://api.github.com/users/trustin","html_url":"https://github.com/trustin","followers_url":"https://api.github.com/users/trustin/followers","following_url":"htt