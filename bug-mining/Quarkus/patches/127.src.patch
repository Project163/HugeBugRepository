diff --git a/extensions/smallrye-rest-client/deployment/src/test/java/io/quarkus/smallrye/restclient/ft/RestClientFallbackTest.java b/extensions/smallrye-rest-client/deployment/src/test/java/io/quarkus/smallrye/restclient/ft/RestClientFallbackTest.java
