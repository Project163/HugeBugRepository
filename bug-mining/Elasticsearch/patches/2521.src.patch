+            }
+
+            @Override
+            protected boolean doHasCurrent() {
+                return true;
+            }
+
+            @Override
+            protected boolean doNext() {
+                return rowCounter < dataSize;
+            }
+
+            @Override
+            protected void doReset() {
+            }
+
+            @Override
