+    static StringBuilder appendEscapedAsciiDoc(StringBuilder sb, String text) {
+        boolean escaping = false;
+        for (int i = 0; i < text.length(); i++) {
+            final char ch = text.charAt(i);
+            switch (ch) {
+                case '#':
+                case '*':
+                case '\\':
+                case '{':
+                case '}':
+                case '[':
+                case ']':
+                    if (!escaping) {
+                        sb.append("++");
+                        escaping = true;
+                    }
+                    sb.append(ch);
+                    break;
+                case '+':
+                    if (escaping) {
+                        sb.append("++");
+                        escaping = false;
+                    }
+                    sb.append("{plus}");
+                    break;
+                default:
+                    if (escaping) {
+                        sb.append("++");
+                        escaping = false;
+                    }
+                    sb.append(ch);
+            }
+        }
+        if (escaping) {
+            sb.append("++");
+        }
+        return sb;
+    }
