ons_url":"https://api.github.com/users/lukewhiting/subscriptions","organizations_url":"https://api.github.com/users/lukewhiting/orgs","repos_url":"https://api.github.com/users/lukewhiting/repos","events_url":"https://api.github.com/users/lukewhiting/events{/privacy}","received_events_url":"https://api.github.com/users/lukewhiting/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","type":{"id":656002,"node_id":"IT_kwDOAGc3Zs4ACgKC","name":"Bug","description":"An unexpected problem or behavior","color":"red","created_at":"2024-01-25T10:19:15Z","updated_at":"2024-07-26T10:13:23Z","is_enabled":true},"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"A user reported an issue with the `result.input.chain` part of Watcher history documents being `dynamic:true` and accumulating large numbers of indexed fields over time. This caused failures relating to hitting indexed field limits.\r\n\r\nUnless there's a particularly good business reason for indexing this data could we add this exclusion to the index template for watcher-history indices?\r\n\r\n```\r\n          \"disabled_result_input_chain_fields\" : {\r\n            \"path_match\" : \"result.input.chain\",\r\n            \"mapping\" : {\r\n              \"type\" : \"object\",\r\n              \"enabled\" : false\r\n            }\r\n          }\r\n```","closed_by":{"login":"lukewhiting","id":897881,"node_id":"MDQ6VXNlcjg5Nzg4MQ==","avatar_url":"https://avatars.githubusercontent.com/u/897881?v=4","gravatar_id":"","url":"https://api.github.com/users/lukewhiting","html_url":"https://github.com/lukewhiting","followers_url":"https://api.github.com/users/lukewhiting/followers","following_url":"https://api.github.com/users/lukewhiting/following{/other_user}","gists_url":"https://api.github.com/users/lukewhiting/gists{/gi