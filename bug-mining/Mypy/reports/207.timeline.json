/michaellee/Work/mypy/mypy/__main__.py\", line 5, in <module>\n    main(None)\n  File \"/Users/michaellee/Work/mypy/mypy/main.py\", line 40, in main\n    res = type_check_only(sources, bin_dir, options)\n  File \"/Users/michaellee/Work/mypy/mypy/main.py\", line 81, in type_check_only\n    options=options)\n  File \"/Users/michaellee/Work/mypy/mypy/build.py\", line 178, in build\n    dispatch(sources, manager)\n  File \"/Users/michaellee/Work/mypy/mypy/build.py\", line 1325, in dispatch\n    process_graph(graph, manager)\n  File \"/Users/michaellee/Work/mypy/mypy/build.py\", line 1466, in process_graph\n    process_fresh_scc(graph, scc)\n  File \"/Users/michaellee/Work/mypy/mypy/build.py\", line 1525, in process_fresh_scc\n    graph[id].fix_cross_refs()\n  File \"/Users/michaellee/Work/mypy/mypy/build.py\", line 1188, in fix_cross_refs\n    fixup_module_pass_one(self.tree, self.manager.modules)\n  File \"/Users/michaellee/Work/mypy/mypy/fixup.py\", line 17, in fixup_module_pass_one\n    node_fixer.visit_symbol_table(tree.names)\n  File \"/Users/michaellee/Work/mypy/mypy/fixup.py\", line 82, in visit_symbol_table\n    self.visit_type_info(value.node)\n  File \"/Users/michaellee/Work/mypy/mypy/fixup.py\", line 51, in visit_type_info\n    self.visit_symbol_table(info.names)\n  File \"/Users/michaellee/Work/mypy/mypy/fixup.py\", line 75, in visit_symbol_table\n    stnode = lookup_qualified_stnode(self.modules, cross_ref)\n  File \"/Users/michaellee/Work/mypy/mypy/fixup.py\", line 247, in lookup_qualified_stnode\n    assert key in names, \"Cannot find %s for %s\" % (key, name)\nAssertionError: Cannot find FooBar for test.FooBar\n```\n\nMypy reports no errors if you get rid of the `--silent-imports` flag (and add the `foo.py` file).\n\nThis may possibly be related to https://github.com/python/mypy/issues/1839.\n","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/1931/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"roc