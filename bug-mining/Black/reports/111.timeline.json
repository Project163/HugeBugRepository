48fef6da689e85b752f39557\r\n\r\nhttps://github.com/vbarbaresi/black/runs/4061992219?check_suite_focus=true\r\nThough it took ~12 min to build instead of 4 min, so I don't think it's a good solution.\r\nIt would be good as a workaround in case some dependency is missing wheels again","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/psf/black/issues/comments/955795788/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"vbarbaresi","id":5553380,"node_id":"MDQ6VXNlcjU1NTMzODA=","avatar_url":"https://avatars.githubusercontent.com/u/5553380?v=4","gravatar_id":"","url":"https://api.github.com/users/vbarbaresi","html_url":"https://github.com/vbarbaresi","followers_url":"https://api.github.com/users/vbarbaresi/followers","following_url":"https://api.github.com/users/vbarbaresi/following{/other_user}","gists_url":"https://api.github.com/users/vbarbaresi/gists{/gist_id}","starred_url":"https://api.github.com/users/vbarbaresi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vbarbaresi/subscriptions","organizations_url":"https://api.github.com/users/vbarbaresi/orgs","repos_url":"https://api.github.com/users/vbarbaresi/repos","events_url":"https://api.github.com/users/vbarbaresi/events{/privacy}","received_events_url":"https://api.github.com/users/vbarbaresi/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/psf/black/issues/comments/955806480","html_url":"https://github.com/psf/black/issues/2568#issuecomment-955806480","issue_url":"https://api.github.com/repos/psf/black/issues/2568","id":955806480,"node_id":"IC_kwDOB3dpmM44-HMQ","user":{"login":"cooperlees","id":3005596,"node_id":"MDQ6VXNlcjMwMDU1OTY=","avatar_url":"https://avatars.githubusercontent.com/u/3005596?v=4","gravatar_id":"","url":"https://api.github.com/users/cooperlees","ht