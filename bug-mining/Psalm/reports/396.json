mpleted":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Follow up to #758 \r\nhttps://getpsalm.org/r/ef9ce3fc48\r\n```php\r\n<?php\r\n  namespace NS;\r\n  use Closure;\r\n  /** @param Closure(int):bool $c */\r\n  function acceptsIntToBool(Closure $c): void {}\r\n  \r\n  class NamedInvokable { public function __invoke(int $p): bool { return $p > 0; }}\r\n  $anonInvokable = new class { public function __invoke(int $p): bool { return $p > 0; }};\r\n\r\n  acceptsIntToBool(Closure::fromCallable($anonInvokable));\r\n  acceptsIntToBool(Closure::fromCallable(new NamedInvokable));\r\n```\r\nSame as in linked ticket, psalm could keep signature of `__invoke` here.","closed_by":{"login":"muglug","id":2292638,"node_id":"MDQ6VXNlcjIyOTI2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/2292638?v=4","gravatar_id":"","url":"https://api.github.com/users/muglug","html_url":"https://github.com/muglug","followers_url":"https://api.github.com/users/muglug/followers","following_url":"https://api.github.com/users/muglug/following{/other_user}","gists_url":"https://api.github.com/users/muglug/gists{/gist_id}","starred_url":"https://api.github.com/users/muglug/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/muglug/subscriptions","organizations_url":"https://api.github.com/users/muglug/orgs","repos_url":"https://api.github.com/users/muglug/repos","events_url":"https://api.github.com/users/muglug/events{/privacy}","received_events_url":"https://api.github.com/users/muglug/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/760/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vimeo/psalm/issues/760/timeline","performed_via_github_app":null,"state_reason":"completed"}