[{"id":8453547394,"node_id":"LE_lADOCX47u85dywJkzwAAAAH33uWC","url":"https://api.github.com/repos/sqlalchemy/alembic/issues/events/8453547394","actor":{"login":"mgorven","id":183923,"node_id":"MDQ6VXNlcjE4MzkyMw==","avatar_url":"https://avatars.githubusercontent.com/u/183923?v=4","gravatar_id":"","url":"https://api.github.com/users/mgorven","html_url":"https://github.com/mgorven","followers_url":"https://api.github.com/users/mgorven/followers","following_url":"https://api.github.com/users/mgorven/following{/other_user}","gists_url":"https://api.github.com/users/mgorven/gists{/gist_id}","starred_url":"https://api.github.com/users/mgorven/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mgorven/subscriptions","organizations_url":"https://api.github.com/users/mgorven/orgs","repos_url":"https://api.github.com/users/mgorven/repos","events_url":"https://api.github.com/users/mgorven/events{/privacy}","received_events_url":"https://api.github.com/users/mgorven/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2023-02-07T02:42:08Z","label":{"name":"requires triage","color":"ffff00"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/alembic/issues/comments/1420174750","html_url":"https://github.com/sqlalchemy/alembic/issues/1167#issuecomment-1420174750","issue_url":"https://api.github.com/repos/sqlalchemy/alembic/issues/1167","id":1420174750,"node_id":"IC_kwDOCX47u85UpiWe","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-02-07T04:13:52Z","updated_at":"2023-02-07T04:13:52Z","body":"it's ....not really that simple.   alembic knows how to render 2.0's variants, but this has to do with your datatype not being part of SQLAlchemy, and there seems to be a whole codepath that isn't taken for variants that are not within sqlalchemy's modules .  it \"works\" in 1.4 because your type becomes Variant, which is in the normal module path.\r\n\r\nbut then...it is that simple?  because this is is all it needs..\r\n\r\n```diff\r\ndiff --git a/alembic/autogenerate/render.py b/alembic/autogenerate/render.py\r\nindex 41903d8..0a5c3dc 100644\r\n--- a/alembic/autogenerate/render.py\r\n+++ b/alembic/autogenerate/render.py\r\n@@ -837,6 +837,8 @@ def _repr_type(\r\n             prefix = _sqlalchemy_autogenerate_prefix(autogen_context)\r\n             return \"%s%r\" % (prefix, type_)\r\n     else:\r\n+        if not _skip_variants and sqla_compat._type_has_variants(type_):\r\n+            return _render_Variant_type(type_, autogen_context)\r\n         prefix = _user_autogenerate_prefix(autogen_context, type_)\r\n         return \"%s%r\" % (prefix, type_)\r\n \r\n\r\n```\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/alembic/issues/comments/1420174750/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avat