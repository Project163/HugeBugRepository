+        assertPartitionsSame(idleVerify(client, DEFAULT_CACHE_NAME));
+
+        assertCountersSame(PARTITION_ID, true);
+
+        startGrid(txTops.get(PARTITION_ID).get1().name());
+
+        awaitPartitionMapExchange();
+
+        // TODO assert with expected lwm value.
+        assertCountersSame(PARTITION_ID, true);
+
+        assertPartitionsSame(idleVerify(client, DEFAULT_CACHE_NAME));
+    }
