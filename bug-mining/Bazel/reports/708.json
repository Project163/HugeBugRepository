ype":"public","site_admin":false}],"milestone":{"url":"https://api.github.com/repos/bazelbuild/bazel/milestones/7","html_url":"https://github.com/bazelbuild/bazel/milestone/7","labels_url":"https://api.github.com/repos/bazelbuild/bazel/milestones/7/labels","id":1717216,"node_id":"MDk6TWlsZXN0b25lMTcxNzIxNg==","number":7,"title":"1.0","description":"","creator":{"login":"damienmg","id":3721087,"node_id":"MDQ6VXNlcjM3MjEwODc=","avatar_url":"https://avatars.githubusercontent.com/u/3721087?v=4","gravatar_id":"","url":"https://api.github.com/users/damienmg","html_url":"https://github.com/damienmg","followers_url":"https://api.github.com/users/damienmg/followers","following_url":"https://api.github.com/users/damienmg/following{/other_user}","gists_url":"https://api.github.com/users/damienmg/gists{/gist_id}","starred_url":"https://api.github.com/users/damienmg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/damienmg/subscriptions","organizations_url":"https://api.github.com/users/damienmg/orgs","repos_url":"https://api.github.com/users/damienmg/repos","events_url":"https://api.github.com/users/damienmg/events{/privacy}","received_events_url":"https://api.github.com/users/damienmg/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":111,"state":"closed","created_at":"2016-04-19T15:08:01Z","updated_at":"2020-05-12T11:11:49Z","due_on":"2018-06-30T00:00:00Z","closed_at":"2020-05-12T11:11:49Z"},"comments":3,"created_at":"2016-03-12T14:14:20Z","updated_at":"2019-04-05T14:53:58Z","closed_at":"2019-04-05T14:53:57Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"The documentation says this about pkg_deb's built_using:\n\n> String or File, default to 'Bazel'\n> The tool that were used to build this package provided either inline (with <code>built_using</code>) or from a file (with <code>built_using_file</code>).\n\nThis is not what Built-Using is for in Debian. Please read §7.8 on [https://www.debian.org/doc/debian-policy/ch-relationships.html]:\n\n> Some binary packages incorporate parts of other packages when built but do not have to depend on those packages. […] A Built-Using field must list the corresponding source package for any such binary package incorporated during the build […]\n\nSomething like \"Bazel\" should certainly not be stored there, as it's not a package name. (Although I did not actually find the default in the code, maybe I'm blind.) \"bazel (0.1.1)\" as suggested in the overview would be technically ok (and should not cause the package to be rejected if bazel exists) but is not really the thing we'd need to list there. `make` would not need to be listed there either.\n\nIt's nice to have the field available, but it should never be set automatically. Thanks.\n","closed_by":{"login":"aiuto","id":3044252,"node_id":"MDQ6VXNlcjMwNDQyNTI=","avatar_url":"https://avatars.githubusercontent.com/u/3044252?v=4","gravatar_id":"","url":"https://api.github.com/users/aiuto","html_url":"https://github.com/aiuto","followers_url":"https://api.github.com/users/aiuto/followers","following_url":"https://api.github.com/users/aiuto/following{/other_user}","gists_url":"https://api.github.com/users/aiuto/gists{/gist_id}","starred_url":"https://api.github.com/users/aiuto/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aiuto/subscriptions","organizations_url":"https://api.github.com/users/aiuto/orgs","repos_url":"https://api.github.com/users/aiuto/repos","events_url":"https://api.github.com/users/aiuto/events{/privacy}","received_events_url":"https://api.github.com/users/aiuto/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/1037/reactions","total_coun