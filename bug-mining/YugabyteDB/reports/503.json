percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"As a result of the fix for https://github.com/yugabyte/yugabyte-db/issues/6890 there was introduced a potential perf issue for the first lookup of tablet by key for colocated tables. Instead of sending 1 RPC when doing the first lookup for colocated table and then reusing the result for all tables co-located with the first one, MetaCache is sending 1 RPC for each table (but only for the first time, after that it reuses results).\r\n\r\n","closed_by":{"login":"ttyusupov","id":903044,"node_id":"MDQ6VXNlcjkwMzA0NA==","avatar_url":"https://avatars.githubusercontent.com/u/903044?v=4","gravatar_id":"","url":"https://api.github.com/users/ttyusupov","html_url":"https://github.com/ttyusupov","followers_url":"https://api.github.com/users/ttyusupov/followers","following_url":"https://api.github.com/users/ttyusupov/following{/other_user}","gists_url":"https://api.github.com/users/ttyusupov/gists{/gist_id}","starred_url":"https://api.github.com/users/ttyusupov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ttyusupov/subscriptions","organizations_url":"https://api.github.com/users/ttyusupov/orgs","repos_url":"https://api.github.com/users/ttyusupov/repos","events_url":"https://api.github.com/users/ttyusupov/events{/privacy}","received_events_url":"https://api.github.com/users/ttyusupov/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/7413/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/7413/timeline","performed_via_github_app":null,"state_reason":"completed"}