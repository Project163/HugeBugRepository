-  public boolean isAssociativeAndCommutative() {
-    return isAssociative() && isCommutative();
-  }
-
-  /**
-   * @return true iff f(0, 0) != 0
-   */
-  public boolean isDensifying() {
-    return apply(0.0, 0.0) != 0.0;
-  }
