-   * thus this likely would require about 2 times the RDD memory
-    *
-    * @return
-   */
-  def collect: Matrix = {
-
-    val intRowIndices = classTag[K] == ClassTag.Int
-
-    val cols = ncol
-    val rows = safeToNonNegInt(nrow)
