-          // Implicit QL transformation.
-
-          p = d.getQuick(m);
-          double c = 1.0;
-          double c2 = c;
-          double c3 = c;
-          double el1 = e.getQuick(l + 1);
-          double s = 0.0;
-          double s2 = 0.0;
-          for (int i = m - 1; i >= l; i--) {
-            c3 = c2;
-            c2 = c;
-            s2 = s;
