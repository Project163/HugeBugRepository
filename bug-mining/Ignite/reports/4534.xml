            <title>[IGNITE-12569] Can&apos;t set serialized enum to a BinaryObject&apos;s field</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-12569</link>
                <project id="12315922" key="IGNITE">Ignite</project>
