126","reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/92851/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/elastic/elasticsearch/issues/92851/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":8220704873,"node_id":"CE_lADOAAe_f85MuV6mzwAAAAHp_gBp","url":"https://api.github.com/repos/elastic/elasticsearch/issues/events/8220704873","actor":{"login":"DaveCTurner","id":5058284,"node_id":"MDQ6VXNlcjUwNTgyODQ=","avatar_url":"https://avatars.githubusercontent.com/u/5058284?v=4","gravatar_id":"","url":"https://api.github.com/users/DaveCTurner","html_url":"https://github.com/DaveCTurner","followers_url":"https://api.github.com/users/DaveCTurner/followers","following_url":"https://api.github.com/users/DaveCTurner/following{/other_user}","gists_url":"https://api.github.com/users/DaveCTurner/gists{/gist_id}","starred_url":"https://api.github.com/users/DaveCTurner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DaveCTurner/subscriptions","organizations_url":"https://api.github.com/users/DaveCTurner/orgs","repos_url":"https://api.github.com/users/DaveCTurner/repos","events_url":"https://api.github.com/users/DaveCTurner/events{/privacy}","received_events_url":"https://api.github.com/users/DaveCTurner/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2023-01-13T13:11:28Z","state_reason":null,"performed_via_github_app":null},{"id":8220705135,"node_id":"REFE_lADOAAe_f85MuV6mzwAAAAHp_gFv","url":"https://api.github.com/repos/elastic/elasticsearch/issues/events/8220705135","actor":{"login":"DaveCTurner","id":5058284,"node_id":"MDQ6VXNlcjUwNTgyODQ=","avatar_url":"https://avatars.githubusercontent.com/u/5058284?v=4","gravatar_id":"","url":"https://api.github.com/users/DaveCTurner","html_url":"ht