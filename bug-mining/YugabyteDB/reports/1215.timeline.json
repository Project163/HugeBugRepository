/failing-test\n\n### Warning: Please confirm that this issue does not contain any sensitive information\n\n- [x] I confirm this issue does not contain any sensitive information.\n\n[DB-15428]: https://yugabyte.atlassian.net/browse/DB-15428?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/26096/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/26096/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":17543224284,"node_id":"REFE_lADOBlCVUc6YF3rxzwAAAAQVqFvc","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/17543224284","actor":{"login":"jasonyb","id":93959687,"node_id":"U_kgDOBZm2Bw","avatar_url":"https://avatars.githubusercontent.com/u/93959687?v=4","gravatar_id":"","url":"https://api.github.com/users/jasonyb","html_url":"https://github.com/jasonyb","followers_url":"https://api.github.com/users/jasonyb/followers","following_url":"https://api.github.com/users/jasonyb/following{/other_user}","gists_url":"https://api.github.com/users/jasonyb/gists{/gist_id}","starred_url":"https://api.github.com/users/jasonyb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jasonyb/subscriptions","organizations_url":"https://api.github.com/users/jasonyb/orgs","repos_url":"https://api.github.com/users/jasonyb/repos","events_url":"https://api.github.com/users/jasonyb/events{/privacy}","received_events_url":"https://api.github.com/users/jasonyb/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"d5c7ed5c7544a92680772bf7bdd59f6e8d08f9d8","commit_url":"https://api.github.com/repos/yugabyte/yugabyte-db/commits/d5c7ed5c7544a92680772bf7bdd59f6e8d08f9d8","created_at":"2025-05-06T19:31:29Z","pe