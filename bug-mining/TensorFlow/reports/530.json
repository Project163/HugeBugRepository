Layer(tf.keras.layers.Layer):\r\n    def __init__(self):\r\n        super(CustomDepthwiseConv2DLayer, self).__init__()\r\n    def build(self, input_shape):\r\n        pass\r\n    def call(self, input, filter, strides, padding, explicit_paddings, dilations):\r\n        return tf.raw_ops.DepthwiseConv2dNative(\r\n    input=input,\r\n    filter=filter,\r\n    strides=strides,\r\n    padding=padding,\r\n    explicit_paddings=explicit_paddings,\r\n    dilations=dilations\r\n)\r\n\r\n# Model\r\ninputs = tf.keras.Input(shape=(3, 3, 3))\r\n\r\nfilter_shape = (2, 2, 3, 1)\r\nfilter = tf.ones(filter_shape)\r\nstrides = [1, 1, 1, 1]\r\npadding = \"VALID\"\r\nexplicit_paddings = []\r\n\r\n# Enter any dilation value here. It has no effect!\r\ndilations = [1, 1, 1, 1]\r\n#dilations = [1, 2, 2, 1]\r\noperator = CustomDepthwiseConv2DLayer()\r\noutputs = operator(inputs, filter, strides, padding, explicit_paddings, dilations)\r\n\r\nmodel = tf.keras.Model(inputs=inputs, outputs=outputs)\r\n\r\n# Prediction\r\nx = np.arange(1, 28)\r\nx = np.reshape(x, (1, 3, 3, 3))\r\nx = tf.convert_to_tensor(x, dtype=tf.float32)\r\n\r\ny = model.predict(x)\r\n\r\nprint(y.shape)\r\nprint(y)\n```\n\n\n### Relevant log output\n\n_No response_</details>","closed_by":{"login":"pranshupant","id":32600304,"node_id":"MDQ6VXNlcjMyNjAwMzA0","avatar_url":"https://avatars.githubusercontent.com/u/32600304?v=4","gravatar_id":"","url":"https://api.github.com/users/pranshupant","html_url":"https://github.com/pranshupant","followers_url":"https://api.github.com/users/pranshupant/followers","following_url":"https://api.github.com/users/pranshupant/following{/other_user}","gists_url":"https://api.github.com/users/pranshupant/gists{/gist_id}","starred_url":"https://api.github.com/users/pranshupant/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pranshupant/subscriptions","organizations_url":"https://api.github.com/users/pranshupant/orgs","repos_url":"https://api.github.com/users/pranshupant/re