ttps://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["hacktoberfest","php","security-analysis","static-analysis","taint-analysis","type-inference"],"visibility":"public","forks":684,"open_issues":1949,"watchers":5784,"default_branch":"6.x","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"psalm.xml:\r\n\r\n```\r\n<?xml version=\"1.0\"?>\r\n<psalm>\r\n\t<projectFiles>\r\n\t\t<directory name=\".\" />\r\n\t\t<ignoreFiles>\r\n\t\t\t<directory name=\"vendor\" />\r\n\t\t\t<directory name=\"stubs\" />\r\n\t\t</ignoreFiles>\r\n\t</projectFiles>\r\n\t<stubs>\r\n\t\t<file name=\"stubs/couchbase/toplevel.php\" preloadClasses=\"true\"/>\r\n\t\t<file name=\"stubs/couchbase/couchbase.php\" preloadClasses=\"true\"/>\r\n\t</stubs>\r\n</psalm>\r\n```\r\n\r\nstub files downloaded from here: https://github.com/JetBrains/phpstorm-stubs/tree/master/couchbase\r\n\r\napp.php:\r\n\r\n```\r\n<?php\r\n\r\nnew CouchbaseCluster(\"foo\");\r\n```\r\n\r\nRunning psalm on this throws \"Could not get class storage for couchbasecluster\". Changing it to `new Couchbase\\Cluster` works fine.\r\n\r\nYou can reproduce the issue with this Dockerfile:\r\n\r\n```\r\nFROM php:7.4\r\n\r\nRUN apt update\r\nRUN curl -O http://packages.couchbase.com/releases/couchbase-release/couchbase-release-1.0-8-amd64.deb\r\nRUN apt install -y lsb-release gpg unzip git\r\nRUN dpkg -i couchbase-release-1.0-8-amd64.deb\r\nRUN apt update\r\nRUN apt install -y libcouchbase-dev\r\nRUN pecl install couchbase-2.6.2\r\nRUN echo \"extension=couchbase.so\" > /usr/local/etc/php/conf.d/couchbase.ini\r\nRUN mkdir app\r\nWORKDIR /app\r\nRUN php -r \"copy('https://getcomposer.org/installer', 'composer-setup.php');\"\r\nRUN php composer-setup.php\r\nRUN php -r \"unlink('composer-setup.php');\"\r\nRUN php composer.phar init -n -s dev  --name=test/test\r\nRUN php composer.phar require --dev psalm/phar\r\n# RUN php composer.phar require --dev psalm/phar:dev-master # dev-master doesn't work either\r\nRUN echo '<?xml version=\"1.0\"?><psalm><projectFiles><directory name=\".\" /><ignoreFiles><directory name=\"vendor\" /><directory name=\"stubs\" /></ignoreFiles></projectFiles><stubs><file name=\"stubs/couchbase/toplevel.php\" preloadClasses=\"true\"/><file name=\"stubs/couchbase/couchbase.php\" preloadClasses=\"true\"/></stubs></psalm>' > psalm.xml\r\nRUN mkdir -p stubs/couchbase\r\nWORKDIR /app/stubs/couchbase\r\nRUN curl -O https://raw.githubusercontent.com/JetBrains/phpstorm-stubs/master/couchbase/toplevel.php\r\nRUN curl -O https://raw.githubusercontent.com/JetBrains/phpstorm-stubs/master/couchbase/couchbase.php\r\nWORKDIR /app\r\nRUN echo '<?php' > app.php\r\nRUN echo 'new CouchbaseCluster(\"foo\");' >> app.php\r\n# RUN echo 'new Couchbase\\Cluster(\"foo\");' >> app.php # this works\r\nRUN cat app.php && php vendor/bin/psalm.phar --debug\r\n```","reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/6203/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vimeo/psalm/issues/6203/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"actor":{"login":"orklah","id":9605520,"node_id":"MDQ6VXNlcjk2MDU1MjA=","avatar_url":"https://avatars.githubusercontent.com/u/9605520?v=4","gravatar_id":"","url":"https://api.github.com/users/orklah","html_url":"https://github.com/orklah","followers_url":"https://api.github.com/users/orklah/followers","following_url":"https://api.github.com/users/orklah/following{/other_user}","gists_url":"https://api.github.com/users/orklah/gists{/gist_id}","starred_url":"https://api.github.com/users/orklah/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/orklah/subscriptions","organizations_url":"https://api.github.com/users/orklah/orgs","repos_url":"https://api.github.com