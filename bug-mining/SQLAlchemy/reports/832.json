:28:50Z"},"comments":7,"created_at":"2019-01-30T03:59:18Z","updated_at":"2019-12-18T15:48:28Z","closed_at":"2019-02-07T03:55:04Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"For the PostgreSQL dialect, `Index()` takes a `postgresql_using=` parameter to specify the index type. However, the generated SQL is wrong if the parameter value is uppercase:\r\n```\r\nfrom sqlalchemy import create_engine\r\nfrom sqlalchemy.ext import declarative\r\nfrom sqlalchemy.schema import CreateTable, CreateIndex\r\nfrom sqlalchemy.sql import schema, sqltypes\r\n\r\nBase = declarative.declarative_base()\r\n\r\nclass MyTable(Base):\r\n    __tablename__ = 'my_table'\r\n    some_column = schema.Column(sqltypes.String(), primary_key=True)\r\n    __table_args__ = (\r\n        schema.Index('my_index', some_column, postgresql_using='BTREE'),\r\n    )\r\n\r\nengine = create_engine('postgresql://')\r\nprint(CreateTable(MyTable.__table__).compile(engine))\r\nfor index in MyTable.__table__.indexes:\r\n    print(CreateIndex(index).compile(engine))\r\n```\r\n\r\nThis produces the SQL:\r\n`CREATE INDEX my_index ON my_table USING \"BTREE\" (some_column)`\r\nwhich is invalid because `\"BTREE\"` is quoted.\r\n\r\nHowever, if we change it to lowercase: `postgresql_using='btree'`, then it produces valid SQL.\r\n\r\nIs the `postgresql_using` argument supposed to be case-sensitive like that?","closed_by":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/4473/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/4473/timeline","performed_via_github_app":null,"state_reason":"completed"}