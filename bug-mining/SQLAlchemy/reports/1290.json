,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"going to change this in 2.0 and have a warning emit for 1.4 as this is a behavioral change.\r\n\r\n```py\r\nfrom sqlalchemy import all_\r\nfrom sqlalchemy import Column\r\nfrom sqlalchemy import create_engine\r\nfrom sqlalchemy import Integer\r\nfrom sqlalchemy import select\r\nfrom sqlalchemy import String\r\nfrom sqlalchemy.orm import declarative_base\r\nfrom sqlalchemy.orm import Session\r\nBase = declarative_base()\r\n\r\n\r\nclass A(Base):\r\n    __tablename__ = 'a'\r\n\r\n    id = Column(Integer, primary_key=True)\r\n    data = Column(String)\r\n\r\ne = create_engine(\"sqlite://\", echo=True)\r\nBase.metadata.create_all(e)\r\n\r\ns = Session(e)\r\n\r\na1, a2, a3 = [A(data='x') for i in range(3)]\r\ns.add_all([a1, a2, a3])\r\ns.commit()\r\n\r\n\r\n# correct\r\nresult = s.execute(select(A))\r\n\r\nall_ = result.scalars(0).all()\r\nassert all_ == [a1, a2, a3], all_\r\n\r\n\r\n# incorrect\r\nresult = s.execute(select(A))\r\n\r\nall_ = result.columns(0).all()\r\nassert all_ == [a1, a2, a3], all_ # current incorrect behaviour\r\nassert all_ == [(a1, ), (a2, ), (a3, )], all_ # expected behaviour\r\n```","closed_by":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"ht