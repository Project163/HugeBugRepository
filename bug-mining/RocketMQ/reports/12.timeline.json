d}","merges_url":"https://api.github.com/repos/jepsen-io/jepsen/merges","archive_url":"https://api.github.com/repos/jepsen-io/jepsen/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/jepsen-io/jepsen/downloads","issues_url":"https://api.github.com/repos/jepsen-io/jepsen/issues{/number}","pulls_url":"https://api.github.com/repos/jepsen-io/jepsen/pulls{/number}","milestones_url":"https://api.github.com/repos/jepsen-io/jepsen/milestones{/number}","notifications_url":"https://api.github.com/repos/jepsen-io/jepsen/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/jepsen-io/jepsen/labels{/name}","releases_url":"https://api.github.com/repos/jepsen-io/jepsen/releases{/id}","deployments_url":"https://api.github.com/repos/jepsen-io/jepsen/deployments","created_at":"2013-04-14T19:20:27Z","updated_at":"2026-03-08T21:32:16Z","pushed_at":"2026-02-24T19:33:31Z","git_url":"git://github.com/jepsen-io/jepsen.git","ssh_url":"git@github.com:jepsen-io/jepsen.git","clone_url":"https://github.com/jepsen-io/jepsen.git","svn_url":"https://github.com/jepsen-io/jepsen","homepage":"","size":47603,"stargazers_count":7327,"watchers_count":7327,"language":"Clojure","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":true,"has_discussions":false,"forks_count":743,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":69,"license":null,"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":743,"open_issues":69,"watchers":7327,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Hi Jepsen Community,\r\n\r\nI wrote two jepsen tests about [openmessaging-storage-dledger](https://github.com/openmessaging/openmessaging-storage-dledger) and [apache rocketmq](https://github.com/apache/rocketmq).\r\n\r\nDLedger is a raft-based commitlog, which could act as the persistent layer for distributed storage system. I used set checker to verify its consistency and fix the related bugs.\r\nhttps://github.com/openmessaging/openmessaging-storage-dledger/pull/37\r\nhttps://github.com/openmessaging/openmessaging-storage-dledger/pull/39\r\n\r\nApache RocketMQ is a distributed messaging and streaming platform. Since RocketMQ 4.5.0, RocketMQ supports the dledger deployment, like a raft-based  distributed message queue. I used total-queue checker to verify its consistency and fix the related bugs.\r\nhttps://github.com/apache/rocketmq/issues/1464\r\nhttps://github.com/apache/rocketmq/issues/1470\r\n\r\nThese have attracted some attention in the Apache RocketMQ community and openmessaging community. \r\n\r\nSome friends in the community asked me why there was no relevant code in jepsen repository, so could I submit the relevant code to jepsen repository?","reactions":{"url":"https://api.github.com/repos/jepsen-io/jepsen/issues/425/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/jepsen-io/jepsen/issues/425/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}},"event":"cross-referenced"},{"id":3383223759,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDMzODMyMjM3NTk=","url":"https://api.github.com/repos/apache/rocketmq/issues/events/3383223759","actor":{"login":"JiaMingLiu93","id":9409916,"node_id":"MDQ6VXNlcjk0MDk5MTY=","avatar_url":"https://avatars.githubusercontent.com/u/9409916?v=4","gravatar_id":"","url":"https://api.github.com/users/JiaMingLiu93","html_url":"https://github.com/JiaMingLiu93","followers_url":"https://api.github.com/users/JiaMingLiu93/followers","following_url":"https://api.github.com/users/JiaMingLiu93/following{/other_user}","gists_url":"https://api.github.com/users/JiaMingLiu93/gists{/gist_id}","starred_url":"https://api.github.com/users/JiaMi