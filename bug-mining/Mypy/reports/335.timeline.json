hecker","types","typing"],"visibility":"public","forks":3065,"open_issues":3124,"watchers":20064,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/python/mypy/pulls/3954","html_url":"https://github.com/python/mypy/pull/3954","diff_url":"https://github.com/python/mypy/pull/3954.diff","patch_url":"https://github.com/python/mypy/pull/3954.patch","merged_at":"2017-09-14T02:49:56Z"},"body":"Fixes #3892.\r\n\r\nEverywhere we infer the correct type for a partially-typed variable,\r\nwe do two things: set var.type and delete var from partial_tyes.\r\nHowever in one place (try_infer_partial_type_from_indexed_assignment())\r\nthe var.type assignment was skipped if the current node was deferred\r\nbut the deletion was done unconditionally.  This caused the partial\r\ntype to remain in a place where serialization could not handle it.","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/3954/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/mypy/issues/3954/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":1248408820,"node_id":"MDExOkNsb3NlZEV2ZW50MTI0ODQwODgyMA==","url":"https://api.github.com/repos/python/mypy/issues/events/1248408820","actor":{"login":"gvanrossum","id":2894642,"node_id":"MDQ6VXNlcjI4OTQ2NDI=","avatar_url":"https://avatars.githubusercontent.com/u/2894642?v=4","gravatar_id":"","url":"https://api.github.com/users/gvanrossum","html_url":"https://github.com/gvanrossum","followers_url":"https://api.github.com/users/gvanrossum/followers","following_url":"https://api.github.com/users/gvanrossum/following{/other_user}","gists_url":"https://api.github.com/users/gvanrossum/gists{/gist_id}","starred_url":"https://api.github.com/users/gvanrossum/starred{/owner}{/repo}","subscriptions_url":