oman","followers_url":"https://api.github.com/users/Sampoman/followers","following_url":"https://api.github.com/users/Sampoman/following{/other_user}","gists_url":"https://api.github.com/users/Sampoman/gists{/gist_id}","starred_url":"https://api.github.com/users/Sampoman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sampoman/subscriptions","organizations_url":"https://api.github.com/users/Sampoman/orgs","repos_url":"https://api.github.com/users/Sampoman/repos","events_url":"https://api.github.com/users/Sampoman/events{/privacy}","received_events_url":"https://api.github.com/users/Sampoman/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/mrdoob/three.js/issues/comments/70535394","html_url":"https://github.com/mrdoob/three.js/issues/5933#issuecomment-70535394","issue_url":"https://api.github.com/repos/mrdoob/three.js/issues/5933","id":70535394,"node_id":"MDEyOklzc3VlQ29tbWVudDcwNTM1Mzk0","user":{"login":"Sampoman","id":501845,"node_id":"MDQ6VXNlcjUwMTg0NQ==","avatar_url":"https://avatars.githubusercontent.com/u/501845?v=4","gravatar_id":"","url":"https://api.github.com/users/Sampoman","html_url":"https://github.com/Sampoman","followers_url":"https://api.github.com/users/Sampoman/followers","following_url":"https://api.github.com/users/Sampoman/following{/other_user}","gists_url":"https://api.github.com/users/Sampoman/gists{/gist_id}","starred_url":"https://api.github.com/users/Sampoman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sampoman/subscriptions","organizations_url":"https://api.github.com/users/Sampoman/orgs","repos_url":"https://api.github.com/users/Sampoman/repos","events_url":"https://api.github.com/users/Sampoman/events{/privacy}","received_events_url":"https://api.github.com/users/Sampoman/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-01-19T18:00:44Z","updated_at":"2015-01-19T18:07:40Z","body":"Edit: I tried messing around with the software rendering test - there's a fundamental problem in the vertex pipeline in the software renderer if morphing is used, this is not a trivial case to fix. \n\nThe problem is that morphing only selected materials should create duplicate vertices for those faces which use the material, which currently does not work. Now the engine tries to blend renderable vertices with unprojected ones, going through the same vertices many times, which messes up the whole pipeline, leading to distortions (which get worse if the transforms are stacked).\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/mrdoob/three.js/issues/comments/70535394/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Sampoman","id":501845,"node_id":"MDQ6VXNlcjUwMTg0NQ==","avatar_url":"https://avatars.githubusercontent.com/u/501845?v=4","gravatar_id":"","url":"https://api.github.com/users/Sampoman","html_url":"https://github.com/Sampoman","followers_url":"https://api.github.com/users/Sampoman/followers","following_url":"https://api.github.com/users/Sampoman/following{/other_user}","gists_url":"https://api.github.com/users/Sampoman/gists{/gist_id}","starred_url":"https://api.github.com/users/Sampoman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sampoman/subscriptions","organizations_url":"https://api.github.com/users/Sampoman/orgs","repos_url":"https://api.github.com/users/Sampoman/repos","events_url":"https://api.github.com/users/Sampoman/events{/privacy}","received_events_url":"https://api.github.com/users/Sampoman/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":221250920,"node_id":"MDEyOkxhYmVsZWRFdmVudDIyMTI1MDkyMA==","url":"https://api.github.com/repos/mrdoob/three.js/issues/events/221250920","actor":{"login":"mrdoob","id":97088,"node_id"