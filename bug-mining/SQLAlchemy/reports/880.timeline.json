.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2019-08-11T14:34:08Z","label":{"name":"orm","color":"20C0B0"},"performed_via_github_app":null},{"id":2548663804,"node_id":"MDE1Ok1pbGVzdG9uZWRFdmVudDI1NDg2NjM4MDQ=","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/2548663804","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"milestoned","commit_id":null,"commit_url":null,"created_at":"2019-08-11T14:34:11Z","milestone":{"title":"1.3.xx"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/520233523","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/4803#issuecomment-520233523","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/4803","id":520233523,"node_id":"MDEyOklzc3VlQ29tbWVudDUyMDIzMzUyMw==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-08-11T14:40:37Z","updated_at":"2019-08-11T14:40:37Z","body":"hi there -\r\n\r\nthanks for the great amount of effort in reporting this issue.  For future reference, we have access to Postgresql databases, as well as MySQL, Oracle, SQL Server so there's no need to illustrate container setups.   Additionally, if you show the code that makes the error, and the stack trace, that's all we need to provide for a fix, provided the issue is in fact a bug.\r\n\r\nin this case, the code you've identified is a sort of one-line conditional that is common in many programming languages, but in Python once the ternary conditional was introduced, they became unnecessary, as the ternary operator (\"foo if bar else bat\") makes the intent much more clear.  In SQLAlchemy, most \"return x or y\" types of operations should be replaced with real ternaries and as you've observed, places where clause objects are checked need to be compared against None.  In this case, allowing a SQL expression for \"offset\" was a relatively late feature add, and additionally usage of \"first()\" did not expect that limit/offset would already be applied to the query.\r\n\r\nthe reproducer for this issue is three lines:\r\n\r\n```\r\n>>> from sqlalchemy.orm import Session\r\n>>> from sqlalchemy import column\r\n>>> Session().query(column('foo')).offset(column('bar')).first()\r\n\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/520233523/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/520234664","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/4803#issuecomment-520234664","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/4803","id":520234664,"node_id":"MDEyOklzc3VlQ29tbWVudDUyMDIzNDY2NA==","user":{"login":"sqla-tester","id":8250554,"node_id":"MDQ6VXNlcjgyNTA1NTQ=","avatar_url":"https://avatars.githubusercontent.com/u/8250554?v=4","gravatar_id":"","url":"https://api.github.com/us