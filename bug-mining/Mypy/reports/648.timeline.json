JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2018-11-16T12:56:38Z","label":{"name":"topic-import-cycles","color":"c2e0c6"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/python/mypy/issues/comments/439385111","html_url":"https://github.com/python/mypy/issues/4812#issuecomment-439385111","issue_url":"https://api.github.com/repos/python/mypy/issues/4812","id":439385111,"node_id":"MDEyOklzc3VlQ29tbWVudDQzOTM4NTExMQ==","user":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-11-16T12:57:11Z","updated_at":"2018-11-16T12:57:11Z","body":"This can probably also happen in import cycles -- added the label.","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/439385111/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/python/mypy/issues/comments/445492033","html_url":"https://github.com/python/mypy/issues/4812#issuecomment-445492033","issue_url":"https://api.github.com/repos/python/mypy/issues/4812","id":445492033,"node_id":"MDEyOklzc3VlQ29tbWVudDQ0NTQ5MjAzMw==","user":{"login":"cmekik","id":2177804,"node_id":"MDQ6VXNlcjIxNzc4MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/2177804?v=4","gravatar_id":"","url":"https://api.github.com/users/cmekik","html_url":"https://github.com/cmekik","followers_url":"https://api.github.com/users/cmekik/followers","following_url":"https://api.github.com/users/cmekik/following{/other_user}","gists_url":"https://api.github.com/users/cmekik/gists{/gist_id}","starred_url":"https://api.github.com/users/cmekik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cmekik/subscriptions","organizations_url":"https://api.github.com/users/cmekik/orgs","repos_url":"https://api.github.com/users/cmekik/repos","events_url":"https://api.github.com/users/cmekik/events{/privacy}","received_events_url":"https://api.github.com/users/cmekik/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-12-08T21:40:56Z","updated_at":"2018-12-08T21:40:56Z","body":"I seem to have run into a similar issue, here is a minimal example:\r\n```python\r\n# python 3.7 w/ mypy 0.650 (as linter)\r\nfrom typing import Union, Hashable, Any, Mapping, Set, NamedTuple\r\n\r\n# In my actual code, MyBaseTuple is imported; but problem appears even w/o import\r\nclass MyBaseTuple(NamedTuple):\r\n\r\n    base_field_1: Hashable\r\n    base_field_2: Hashable\r\n\r\n\r\nMyBaseTupleMapping = Mapping[MyBaseTuple, Any]\r\nMyBaseTupleSet = Set[MyBaseTuple]\r\n\r\n# Recursive types not fully supported yet, nested types replaced with \"Any\"\r\nMyTupleUnion = Union['MyTupleA', 'MyTupleB']\r\n\r\n\r\nclass MyTupleA(NamedTuple):\r\n    \r\n    field_1: MyBaseTupleMapping\r\n    field_2: MyBaseTuple\r\n\r\n\r\nclass MyTupleB(NamedTuple):\r\n    \r\n    field_1: MyBaseTupleMapping\r\n    field_2: MyBaseTupleSet\r\n    field_3: MyBaseTuple\r\n```\r\nMoving `MyTupleUnion` definition to after definition of `MyTupleA`, `MyTupleB` removes error.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/445492033/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"cmekik","id":217