jg3OTA2OTEz","avatar_url":"https://avatars.githubusercontent.com/u/87906913?v=4","gravatar_id":"","url":"https://api.github.com/users/GabenGar","html_url":"https://github.com/GabenGar","followers_url":"https://api.github.com/users/GabenGar/followers","following_url":"https://api.github.com/users/GabenGar/following{/other_user}","gists_url":"https://api.github.com/users/GabenGar/gists{/gist_id}","starred_url":"https://api.github.com/users/GabenGar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/GabenGar/subscriptions","organizations_url":"https://api.github.com/users/GabenGar/orgs","repos_url":"https://api.github.com/users/GabenGar/repos","events_url":"https://api.github.com/users/GabenGar/events{/privacy}","received_events_url":"https://api.github.com/users/GabenGar/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-08-18T18:50:26Z","updated_at":"2023-08-18T18:51:02Z","body":"@shuding \r\nOne of the more annoying parts of running type checks with `next build` is it runs linter beforehand (which isn't very fast to begin with and I know its output after the first run) and bails out on the first type error and then, on success, runs an entire build chain. Especially annoying when I only care about broken types after a refactor, as I know for a fact it won't build until I fix them. IMO if `next` is abstracting typescript away it should provide a command to run it separately, or at least in `next lint` after linting.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1684312434/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"GabenGar","id":87906913,"node_id":"MDQ6VXNlcjg3OTA2OTEz","avatar_url":"https://avatars.githubusercontent.com/u/87906913?v=4","gravatar_id":"","url":"https://api.github.com/users/GabenGar","h