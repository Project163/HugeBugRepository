142,"watchers_count":26142,"language":"JavaScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":1656,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":611,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":[],"visibility":"public","forks":1656,"open_issues":611,"watchers":26142,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/rollup/rollup/pulls/2194","html_url":"https://github.com/rollup/rollup/pull/2194","diff_url":"https://github.com/rollup/rollup/pull/2194.diff","patch_url":"https://github.com/rollup/rollup/pull/2194.patch","merged_at":"2018-05-16T14:41:13Z"},"body":"After some deliberation, this is the lowest impact fix I could come up with to resolve #2191. Basically as far as I am aware, this issue can only arise for `return` statements and `yield` expressions when there is no space between the keyword and the subsequent expression and the nested expression changes due to some simplification.\r\n\r\nE.g. `return!1||true` -> `return true`.\r\n\r\nFor `await` expressions this is not an issue as operator precedence is different here (`await!1||true` is equivalent to `(await !1) || true`)\r\n\r\nThe solution is to insert a space if the argument of the `return` statement starts directly after the last letter of `return`, similarly for `yield`.","reactions":{"url":"https://api.github.com/repos/rollup/rollup/issues/2194/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/rollup/rollup/issues/2194/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.githu