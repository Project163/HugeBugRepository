re\n         ax0 = self.obj._get_axis(0)\n-        if isinstance(ax0, MultiIndex):\n+        if isinstance(ax0, MultiIndex) and self.name != 'iloc':\n             result = self._handle_lowerdim_multi_index_axis0(tup)\n             if result is not None:\n                 return result\n```\n\nWhat is the next step?\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/pandas-dev/pandas/issues/comments/239778690/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ygriku","id":20615034,"node_id":"MDQ6VXNlcjIwNjE1MDM0","avatar_url":"https://avatars.githubusercontent.com/u/20615034?v=4","gravatar_id":"","url":"https://api.github.com/users/ygriku","html_url":"https://github.com/ygriku","followers_url":"https://api.github.com/users/ygriku/followers","following_url":"https://api.github.com/users/ygriku/following{/other_user}","gists_url":"https://api.github.com/users/ygriku/gists{/gist_id}","starred_url":"https://api.github.com/users/ygriku/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ygriku/subscriptions","organizations_url":"https://api.github.com/users/ygriku/orgs","repos_url":"https://api.github.com/users/ygriku/repos","events_url":"https://api.github.com/users/ygriku/events{/privacy}","received_events_url":"https://api.github.com/users/ygriku/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/pandas-dev/pandas/issues/comments/239785512","html_url":"https://github.com/pandas-dev/pandas/issues/13797#issuecomment-239785512","issue_url":"https://api.github.com/repos/pandas-dev/pandas/issues/13797","id":239785512,"node_id":"MDEyOklzc3VlQ29tbWVudDIzOTc4NTUxMg==","user":{"login":"jreback","id":953992,"node_id":"MDQ6VXNlcjk1Mzk5Mg==","avatar_url":"https://avatars.githubusercontent.com/u/953992?v=4","gravatar_id":"","url":"https://