diff --git a/packages/common/test/directives/styling_differ_spec.ts b/packages/common/test/directives/styling_differ_spec.ts
new file mode 100644
index 0000000000..0a9c9da53f
--- /dev/null
+++ b/packages/common/test/directives/styling_differ_spec.ts
@@ -0,0 +1,113 @@
+/**
