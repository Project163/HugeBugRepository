be/repos","events_url":"https://api.github.com/users/ocombe/events{/privacy}","received_events_url":"https://api.github.com/users/ocombe/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":441,"closed_issues":10002,"state":"open","created_at":"2018-02-26T14:22:18Z","updated_at":"2026-03-11T08:40:05Z","due_on":null,"closed_at":null},"comments":9,"created_at":"2020-05-28T11:58:04Z","updated_at":"2021-03-26T16:08:49Z","closed_at":"2021-02-23T21:15:55Z","assignee":{"login":"cesperian","id":61225472,"node_id":"MDQ6VXNlcjYxMjI1NDcy","avatar_url":"https://avatars.githubusercontent.com/u/61225472?v=4","gravatar_id":"","url":"https://api.github.com/users/cesperian","html_url":"https://github.com/cesperian","followers_url":"https://api.github.com/users/cesperian/followers","following_url":"https://api.github.com/users/cesperian/following{/other_user}","gists_url":"https://api.github.com/users/cesperian/gists{/gist_id}","starred_url":"https://api.github.com/users/cesperian/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cesperian/subscriptions","organizations_url":"https://api.github.com/users/cesperian/orgs","repos_url":"https://api.github.com/users/cesperian/repos","events_url":"https://api.github.com/users/cesperian/events{/privacy}","received_events_url":"https://api.github.com/users/cesperian/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"# 📚 Docs or angular.io bug report\r\n\r\n### Description\r\n\r\nThe PipeTransform's `transform` parameters are unclear as it can now support multiple individual parameters or a rest param. It should be clarified how you can pass multiple parameters to the transform method. I suggest adding an additional example with multiple parameters as both of these ways of invoking the method are valid:\r\n\r\n```ts\r\nexport class MyPipe implements PipeTransform { \r\n    // specify every argument individually   \r\n    transform(value: any, arg1: any, arg2: any, arg3: any): any { }\r\n    // or use a rest parameter\r\n    transform(value: any, ...args: any[]): any { }\r\n}\r\n```\r\nExample addition suggestion:\r\n\r\n```ts\r\n@Pipe({\r\n    name: 'truncate'\r\n})\r\nexport class TruncatePipe implements PipeTransform {\r\n\r\n    transform(value: string, limit: number, trail: string): string {\r\n        return value.substring(0, limit) + trail;\r\n    }\r\n\r\n}\r\n```\r\n\r\nInvoking {{ 'Truncate me' | truncate:8:'!' }} in a template produces Truncate!.\r\n\r\nAdditionally, it would be nice to document how to write a unit test for a pipe with multiple parameters. Similar to this:\r\n\r\n```ts\r\nit('should support multiple pipe parameters in the template', () => {\r\n        @Component({\r\n          template: `{{ text | truncate:8:'...' }}`,\r\n        })\r\n        class App {\r\n          text = 'Truncate me';\r\n        }\r\n\r\n        TestBed.configureTestingModule({declarations: [App, TruncatePipe]});\r\n        const fixture = TestBed.createComponent(App);\r\n        fixture.detectChanges();\r\n\r\n        expect(fixture.nativeElement.textContent).toEqual('Truncate...');\r\n    });\r\n```\r\n\r\n### What's the affected URL?**\r\nhttps://angular.io/api/core/PipeTransform\r\n\r\n## 📷Screenshot\r\n<img width=\"1021\" alt=\"Screen Shot 2020-05-28 at 11 57 35\" src=\"https://user-images.githubusercontent.com/60604010/83127644-b2205700-a0da-11ea-9eab-2f8b63e71495.png\">\r\n\r\n<img width=\"1026\" alt=\"Screen Shot 2020-05-28 at 12 09 19\" src=\"https://user-images.githubusercontent.com/60604010/83128723-1bed3080-a0dc-11ea-851c-5288908bee1d.png\">\r\n\r\n</code></pre>\r\n\r\nCan I open up a PR to make this change?","closed_by":{"login":"atscott","id":479713,"node_id":"MDQ6VXNlcjQ3OTcxMw==","avatar_url":"https://avatars.githubusercontent.com/u/479713?v=4","gravatar_id":"","url":"https://api.github.com/users/atscott","html_url":"https://github.com/atscott","followers_url":"https://api.github.com/users/atscott/followers","following_url":"https://api.github.com/users/atscott/following{/other_user}","gists_url":"https://api.github.com/users/atscott/gists{/gist_id}","starred_url":"https://api.github.com/users/atscott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/atscott/subscriptions","organizations_url":"https://api.github.com/users/atscott/orgs","repos_url":"https://api.github.com/users/atscott/repos","events_url":"https://api.github.com/users/atscott/events{/privacy}","received_events_url":"https://api.github.com/users/atscott/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/37321/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/angular/angular/issues/37321/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}