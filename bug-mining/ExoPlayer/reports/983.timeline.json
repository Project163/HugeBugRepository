users/christosts/repos","events_url":"https://api.github.com/users/christosts/events{/privacy}","received_events_url":"https://api.github.com/users/christosts/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"711fa44d56678ebdb5c1c3a48f940fa71810c510","commit_url":"https://api.github.com/repos/google/ExoPlayer/commits/711fa44d56678ebdb5c1c3a48f940fa71810c510","created_at":"2023-02-14T18:07:21Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/1431112853","html_url":"https://github.com/google/ExoPlayer/issues/10971#issuecomment-1431112853","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/10971","id":1431112853,"node_id":"IC_kwDOAT2ozs5VTQyV","user":{"login":"microkatz","id":45770613,"node_id":"MDQ6VXNlcjQ1NzcwNjEz","avatar_url":"https://avatars.githubusercontent.com/u/45770613?v=4","gravatar_id":"","url":"https://api.github.com/users/microkatz","html_url":"https://github.com/microkatz","followers_url":"https://api.github.com/users/microkatz/followers","following_url":"https://api.github.com/users/microkatz/following{/other_user}","gists_url":"https://api.github.com/users/microkatz/gists{/gist_id}","starred_url":"https://api.github.com/users/microkatz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/microkatz/subscriptions","organizations_url":"https://api.github.com/users/microkatz/orgs","repos_url":"https://api.github.com/users/microkatz/repos","events_url":"https://api.github.com/users/microkatz/events{/privacy}","received_events_url":"https://api.github.com/users/microkatz/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-02-15T10:35:57Z","updated_at":"2023-02-15T10:35:57Z","body":"Hello @Anioz,\r\n\r\nThank you for reporting your issue! We submitted a fix into the dev-v2 branch for the app crashes related to your camera's RTSP DescribeResponse's invalid fmpt attribute. The app should no longer crash as a result. That being said, your cameras do not provide sprop-parameter-sets values which are required for decoding the H264 stream. Therefore the camera streams will not be supported. \r\n\r\nSome suggestions:\r\n- You can file a bug with Foscam and Hikvision for them to start providing the values via a firmware update. Also check if there currently are any firmware updates for your devices. \r\n- Try changing the stream media type to mjpeg and see if that enables your cameras.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/1431112853/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"microkatz","id":45770613,"node_id":"MDQ6VXNlcjQ1NzcwNjEz","avatar_url":"https://avatars.githubusercontent.com/u/45770613?v=4","gravatar_id":"","url":"https://api.github.com/users/microkatz","html_url":"https://github.com/microkatz","followers_url":"https://api.github.com/users/microkatz/followers","following_url":"https://api.github.com/users/microkatz/following{/other_user}","gists_url":"https://api.github.com/users/microkatz/gists{/gist_id}","starred_url":"https://api.github.com/users/microkatz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/microkatz/subscriptions","organizations_url":"https://api.github.com/users/microkatz/orgs","repos_url":"https://api.github.com/users/microkatz/repos","events_url":"https://api.github.com/users/microkatz/events{/privacy}","received_events_url":"https://api.github.com/users/microkatz/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":8524556376,"node_id":"CE_lADOAT2ozs5d8fJFzwAAAAH8GmhY","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/8524556376","actor":{"login":"microkatz","id":45770613,"node_id":"MDQ6VXNlcjQ1NzcwNjEz","avatar_url":"https: