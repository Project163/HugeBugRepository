://avatars.githubusercontent.com/u/54320150?v=4","gravatar_id":"","url":"https://api.github.com/users/kim-vde","html_url":"https://github.com/kim-vde","followers_url":"https://api.github.com/users/kim-vde/followers","following_url":"https://api.github.com/users/kim-vde/following{/other_user}","gists_url":"https://api.github.com/users/kim-vde/gists{/gist_id}","starred_url":"https://api.github.com/users/kim-vde/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kim-vde/subscriptions","organizations_url":"https://api.github.com/users/kim-vde/orgs","repos_url":"https://api.github.com/users/kim-vde/repos","events_url":"https://api.github.com/users/kim-vde/events{/privacy}","received_events_url":"https://api.github.com/users/kim-vde/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"kim-vde","id":54320150,"node_id":"MDQ6VXNlcjU0MzIwMTUw","avatar_url":"https://avatars.githubusercontent.com/u/54320150?v=4","gravatar_id":"","url":"https://api.github.com/users/kim-vde","html_url":"https://github.com/kim-vde","followers_url":"https://api.github.com/users/kim-vde/followers","following_url":"https://api.github.com/users/kim-vde/following{/other_user}","gists_url":"https://api.github.com/users/kim-vde/gists{/gist_id}","starred_url":"https://api.github.com/users/kim-vde/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kim-vde/subscriptions","organizations_url":"https://api.github.com/users/kim-vde/orgs","repos_url":"https://api.github.com/users/kim-vde/repos","events_url":"https://api.github.com/users/kim-vde/events{/privacy}","received_events_url":"https://api.github.com/users/kim-vde/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":8,"created_at":"2020-07-02T14:07:16Z","updated_at":"2020-10-04T01:04:44Z","closed_at":"2020-08-04T15:22:28Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Sometimes the ByteBuffer buffer variable in ```processOutputBuffer``` of ```MediaCodecRenderer```/```MediaCodecVideoRenderer```/```MediaCodecAudioRenderer``` can be null. In Kotlin, this triggers a runtime error of:\r\n```java.lang.IllegalArgumentException: Parameter specified as non-null is null: method kotlin.jvm.internal.Intrinsics.checkParameterIsNotNull, parameter buffer```\r\n\r\nI believe adding ```@Nullable``` to the java will ensure these parameters are considered as a ```ByteBuffer?``` instead of a ```ByteBuffer```(ie. nullable) in Kotlin.\r\n\r\nCurrent work around is to completely disable the intrinsic checkParameterIsNotNull check for the whole project in proguard by adding:\r\n-assumenosideeffects class kotlin.jvm.internal.Intrinsics {\r\n    public static void checkParameterIsNotNull(java.lang.Object, java.lang.String);\r\n}","closed_by":{"login":"kim-vde","id":54320150,"node_id":"MDQ6VXNlcjU0MzIwMTUw","avatar_url":"https://avatars.githubusercontent.com/u/54320150?v=4","gravatar_id":"","url":"https://api.github.com/users/kim-vde","html_url":"https://github.com/kim-vde","followers_url":"https://api.github.com/users/kim-vde/followers","following_url":"https://api.github.com/users/kim-vde/following{/other_user}","gists_url":"https://api.github.com/users/kim-vde/gists{/gist_id}","starred_url":"https://api.github.com/users/kim-vde/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kim-vde/subscriptions","organizations_url":"https://api.github.com/users/kim-vde/orgs","repos_url":"https://api.github.com/users/kim-vde/repos","events_url":"https://api.github.com/users/kim-vde/events{/privacy}","received_events_url":"https://api.github.com/users/kim-vde/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/google/ExoPl