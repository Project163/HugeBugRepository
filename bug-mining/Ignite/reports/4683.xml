<item>
            <title>[IGNITE-13128] IgniteLock throws NullPointerException when removed before use</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-13128</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;Reproducer: &lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
    &lt;span class=&quot;code-keyword&quot;&gt;public&lt;/span&gt; void testClosedLockThrowsIgniteException() {
        &lt;span class=&quot;code-keyword&quot;&gt;final&lt;/span&gt; &lt;span class=&quot;code-object&quot;&gt;String&lt;/span&gt; lockName = &lt;span class=&quot;code-quote&quot;&gt;&quot;testRemovedLockThrowsIgniteException&quot;&lt;/span&gt;;

        Ignite srv = ignite(0);

        IgniteLock lock1 = srv.reentrantLock(lockName, &lt;span class=&quot;code-keyword&quot;&gt;false&lt;/span&gt;, &lt;span class=&quot;code-keyword&quot;&gt;false&lt;/span&gt;, &lt;span class=&quot;code-keyword&quot;&gt;true&lt;/span&gt;);
        IgniteLock lock2 = srv.reentrantLock(lockName, &lt;span class=&quot;code-keyword&quot;&gt;false&lt;/span&gt;, &lt;span class=&quot;code-keyword&quot;&gt;false&lt;/span&gt;, &lt;span class=&quot;code-keyword&quot;&gt;true&lt;/span&gt;);

        lock1.close();
        lock2.lock();
    }
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;This does not happen if we add any lock2 call before lock1.close(). The following works as expected, returning &quot;Failed to find reentrant lock with given name&quot; exception:&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
    &lt;span class=&quot;code-keyword&quot;&gt;public&lt;/span&gt; void testClosedLockThrowsIgniteException() {
        &lt;span class=&quot;code-keyword&quot;&gt;final&lt;/span&gt; &lt;span class=&quot;code-object&quot;&gt;String&lt;/span&gt; lockName = &lt;span class=&quot;code-quote&quot;&gt;&quot;testRemovedLockThrowsIgniteException&quot;&lt;/span&gt;;

        Ignite srv = ignite(0);

        IgniteLock lock1 = srv.reentrantLock(lockName, &lt;span class=&quot;code-keyword&quot;&gt;false&lt;/span&gt;, &lt;span class=&quot;code-keyword&quot;&gt;false&lt;/span&gt;, &lt;span class=&quot;code-keyword&quot;&gt;true&lt;/span&gt;);
        IgniteLock lock2 = srv.reentrantLock(lockName, &lt;span class=&quot;code-keyword&quot;&gt;false&lt;/span&gt;, &lt;span class=&quot;code-keyword&quot;&gt;false&lt;/span&gt;, &lt;span class=&quot;code-keyword&quot;&gt;true&lt;/span&gt;);
        lock2.isLocked();

        lock1.close();
        lock2.lock();
    }
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</description>
