 one = Node(name=\"one\")\r\n    two = Node(name=\"two\")\r\n    two.parent = one\r\n    session.add(one)\r\n    session.add(two)\r\n    await session.commit()\r\n\r\n\r\nasync def crash():\r\n    session = get_sessionmaker()()\r\n    two = (\r\n        await session.scalars(sa.select(Node).filter(Node.name == \"two\"))\r\n    ).one_or_none()\r\n\r\n    print(two.children)\r\n\r\n    print(two.parent)\r\n\r\n    await session.close()\r\n\r\nasync def main():\r\n    await create_db()\r\n    await populate_db()\r\n    await crash()\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    asyncio.run(main())\r\n\r\n```\r\n\r\noutput:\r\n\r\n```\r\n{}\r\nLoaderCallableStatus.PASSIVE_NO_RESULT\r\n\r\n```\r\n\r\nwoah.   That's pretty wrong even if immediateload is not that great","closed_by":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/10139/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"h