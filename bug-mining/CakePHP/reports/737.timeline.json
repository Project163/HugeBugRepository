sers/dakota/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dakota/subscriptions","organizations_url":"https://api.github.com/users/dakota/orgs","repos_url":"https://api.github.com/users/dakota/repos","events_url":"https://api.github.com/users/dakota/events{/privacy}","received_events_url":"https://api.github.com/users/dakota/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/157052671","html_url":"https://github.com/cakephp/cakephp/issues/7697#issuecomment-157052671","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/7697","id":157052671,"node_id":"MDEyOklzc3VlQ29tbWVudDE1NzA1MjY3MQ==","user":{"login":"dakota","id":83255,"node_id":"MDQ6VXNlcjgzMjU1","avatar_url":"https://avatars.githubusercontent.com/u/83255?v=4","gravatar_id":"","url":"https://api.github.com/users/dakota","html_url":"https://github.com/dakota","followers_url":"https://api.github.com/users/dakota/followers","following_url":"https://api.github.com/users/dakota/following{/other_user}","gists_url":"https://api.github.com/users/dakota/gists{/gist_id}","starred_url":"https://api.github.com/users/dakota/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dakota/subscriptions","organizations_url":"https://api.github.com/users/dakota/orgs","repos_url":"https://api.github.com/users/dakota/repos","events_url":"https://api.github.com/users/dakota/events{/privacy}","received_events_url":"https://api.github.com/users/dakota/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-11-16T14:42:04Z","updated_at":"2015-11-16T14:42:04Z","body":"PHP's `is_int()` returns false for negative stringy integers\n\nWhich means that the following assert fails:\n\n``` php\n        $result = $this->type->marshal('-105', $this->driver);\n        $this->assertSame(-105, $result);\n```\n\nSo, the simple fix that I thought of for this was to add a `is_numeric` check. However, this causes these two asserts to fail.\n\n``` php\n        $result = $this->type->marshal('1.25', $this->driver);\n        $this->assertSame('1.25', $result);\n\n        $result = $this->type->marshal('2 monkeys', $this->driver);\n        $this->assertSame('2 monkeys', $result);\n```\n\nSo it seems like the expected behaviour is to only typecast to integer if phps internal type check is that of integer, otherwise return the same string as was passed in.\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/157052671/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"dakota","id":83255,"node_id":"MDQ6VXNlcjgzMjU1","avatar_url":"https://avatars.githubusercontent.com/u/83255?v=4","gravatar_id":"","url":"https://api.github.com/users/dakota","html_url":"https://github.com/dakota","followers_url":"https://api.github.com/users/dakota/followers","following_url":"https://api.github.com/users/dakota/following{/other_user}","gists_url":"https://api.github.com/users/dakota/gists{/gist_id}","starred_url":"https://api.github.com/users/dakota/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dakota/subscriptions","organizations_url":"https://api.github.com/users/dakota/orgs","repos_url":"https://api.github.com/users/dakota/repos","events_url":"https://api.github.com/users/dakota/events{/privacy}","received_events_url":"https://api.github.com/users/dakota/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/157074535","html_url":"https://github.com/cakephp/cakephp/issues/7697#issuecomment-157074535","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/7697","id":157074535,"node_id":"MDEyOklzc3VlQ29tbWVudDE1NzA3NDUzNQ==","user":{"logi