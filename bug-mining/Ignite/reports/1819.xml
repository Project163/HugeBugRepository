<item>
            <title>[IGNITE-2970] .NET: CompiledQuery fails with embedded const parameters</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-2970</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;This works:&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;&lt;span class=&quot;code-keyword&quot;&gt;var&lt;/span&gt; qry = CompiledQuery.Compile((&lt;span class=&quot;code-object&quot;&gt;int&lt;/span&gt; x) =&amp;gt; cache.Where(x =&amp;gt; x.Key &amp;lt; x));
qry(5).GetAll();
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;And this fails:&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;&lt;span class=&quot;code-keyword&quot;&gt;var&lt;/span&gt; qry = CompiledQuery.Compile(() =&amp;gt; cache.Where(x =&amp;gt; x.Key &amp;lt; 5));
qry().GetAll();
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</description>
                <environment></environment>
        <key id="12957639">IGNITE-2970</key>
