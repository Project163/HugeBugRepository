-learn/scikit-learn","homepage":"https://scikit-learn.org","size":180063,"stargazers_count":65403,"watchers_count":65403,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":26756,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":2143,"license":{"key":"bsd-3-clause","name":"BSD 3-Clause \"New\" or \"Revised\" License","spdx_id":"BSD-3-Clause","url":"https://api.github.com/licenses/bsd-3-clause","node_id":"MDc6TGljZW5zZTU="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["data-analysis","data-science","machine-learning","python","statistics"],"visibility":"public","forks":26756,"open_issues":2143,"watchers":65403,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/scikit-learn/scikit-learn/pulls/23572","html_url":"https://github.com/scikit-learn/scikit-learn/pull/23572","diff_url":"https://github.com/scikit-learn/scikit-learn/pull/23572.diff","patch_url":"https://github.com/scikit-learn/scikit-learn/pull/23572.patch","merged_at":"2022-06-29T12:57:03Z"},"body":"<!--\r\nThanks for contributing a pull request! Please ensure you have taken a look at\r\nthe contribution guidelines: https://github.com/scikit-learn/scikit-learn/blob/main/CONTRIBUTING.md\r\n-->\r\n\r\n#### Reference Issues/PRs\r\n<!--\r\nExample: Fixes #1234. See also #3456.\r\nPlease use keywords (e.g., Fixes) to create link to the issues or pull requests\r\nyou resolved, so that they will automatically be closed when your pull request\r\nis merged. See https://github.com/blog/1506-closing-issues-via-pull-requests\r\n-->\r\n\r\nFixes #23566.\r\n\r\n#### What does this implement/fix? Explain your changes.\r\n\r\nAs mentioned by @jeremiedbb in [this comment](https://github.com/scikit-learn/scikit-learn/issues/23566#issuecomment-1149962749), the `\"kmeans++\"` init picks centroids with proba inverse to square distance, which means it will pick points extremely isolated if there are any, which then stay their own centroids all along.\r\n\r\nInstead of increasing the default value of `n_init`, we agreed on a small committee to warn the users to avoid using the `\"kmeans++\"` init with sparse high dimensional datasets.\r\n\r\n#### Any other comments?\r\n\r\nMaybe we should wait until #23528 is merged before merging the present PR.\r\n\r\nSide effect: fixes small typo `k_init` -> `n_init` in `KMeans` docstring.\r\n\r\n<!--\r\nPlease be aware that we are a loose team of volunteers so patience is\r\nnecessary; assistance handling other issues is very welcome. We value\r\nall user contributions, no matter how minor they are. If we are slow to\r\nreview, either the pull request needs some benchmarking, tinkering,\r\nconvincing, etc. or more likely the reviewers are simply busy. In either\r\ncase, we ask for your understanding during the review process.\r\nFor more information, see our FAQ on this topic:\r\nhttp://scikit-learn.org/dev/faq.html#why-is-my-pull-request-not-getting-any-attention.\r\n\r\nThanks for contributing!\r\n-->\r\n","reactions":{"url":"https://api.github.com/repos/scikit-learn/scikit-learn/issues/23572/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/scikit-learn/scikit-learn/issues/23572/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":6790200589,"node_id":"UNLE_lADOAAzd1s5LXoXizwAAAAGUuj0N","url":"https://api.github.com/repos/scikit-learn/scikit-learn/issues/events/6790200589","actor":{"login":"thomasjpfan","id":5402633,"node_id":"MDQ6VXNlcjU0MDI2MzM=","avatar_url":"https://avatars.githubusercontent.com/u/5402633?v=4","gravatar_id":"","url":"https://api.github.com/users/thomasjpfan",