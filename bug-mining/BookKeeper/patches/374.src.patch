-                                                     Callback<Versioned<LedgerRanges>> callback, Object ctx) {
-            try {
-                Versioned<LedgerRanges> ranges = new Versioned<LedgerRanges>(LedgerRanges.parseFrom(data),
-                                                                             new ZkVersion(version));
-                callback.operationFinished(ctx, ranges);
