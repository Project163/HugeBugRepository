t_has_table(self):\r\n         with config.db.begin() as conn:\r\n             is_true(config.db.dialect.has_table(conn, \"test_table\"))\r\n@@ -78,6 +91,11 @@ class HasTableTest(fixtures.TablesTest):\r\n                 )\r\n             )\r\n \r\n+    @testing.requires.view_reflection\r\n+    def test_has_table_views(self):\r\n+        with config.db.begin() as conn:\r\n+            is_true(config.db.dialect.has_table(conn, \"test_table_v\"))\r\n+\r\n \r\n class HasIndexTest(fixtures.TablesTest):\r\n     __backend__ = True\r\n\r\n```\r\n\r\n","closed_by":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/8700/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/8700/timeline","performed_via_github_app":null,"state_reason":"completed"}