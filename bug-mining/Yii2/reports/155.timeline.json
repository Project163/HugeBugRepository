other_user}","gists_url":"https://api.github.com/users/eresik/gists{/gist_id}","starred_url":"https://api.github.com/users/eresik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eresik/subscriptions","organizations_url":"https://api.github.com/users/eresik/orgs","repos_url":"https://api.github.com/users/eresik/repos","events_url":"https://api.github.com/users/eresik/events{/privacy}","received_events_url":"https://api.github.com/users/eresik/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-02-23T12:27:52Z","updated_at":"2014-02-23T12:27:52Z","body":"`$this->_messages[$key]` is array of translated messages.\nI.e. `$this->messages[$key]['blablabla']` is translated message blablabla\nIf doing `$this->messages[$key]=$message` then `$this->messages[$key]['blablabla']` is undefined.\n\nIn my case if I attach event EVENT_MISSING_TRANSLATION, than after first untranslated message all another messages still untranslated.\n\nExample:\nassume that \nstring1,string2 - have translations\nstring3 - has not translation\n\n```\n\\yii\\base\\Event::on(\n    \\yii\\i18n\\DbMessageSource::className(),\n    \\yii\\i18n\\DbMessageSource::EVENT_MISSING_TRANSLATION,\n    function($event) { return $event;  }\n);\n\nYii::t('app','string1'); //translated\nYii::t('app','string3'); //not translated (has not translation)\nYii::t('app','string2'); //HAS TRANSLATION, BUT NOT TRANSLATED!\nYii::t('app','string1'); //HAS TRANSLATION, BUT NOT TRANSLATED!\n```\n\nIf dont attach event than all works properly.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/yiisoft/yii2/issues/comments/35830497/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"eresik","id":2630268,"node_id":"MDQ6VXNlcjI2MzAyNjg=","avatar_url":"https://avatars.githubusercontent.com/u/2630268?v=4","gravatar_id":