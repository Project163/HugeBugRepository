man-surfsara/repos","events_url":"https://api.github.com/users/wlohman-surfsara/events{/privacy}","received_events_url":"https://api.github.com/users/wlohman-surfsara/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-06-17T09:26:18Z","updated_at":"2019-06-17T09:26:18Z","body":"Ah nice, thank you!\r\nI've been running some tests, and the simple append test I'd been using now goes flawlessly. It still encounters the same 'file locked' situations, but the retry does the trick. Also, the data inside the file is as expected (no missing lines or so)\r\n\r\n```\r\n2019/06/17 09:59:58 DEBUG : &{rclone_appending-latest-beta.txt (rw)}: Flush: \r\n2019/06/17 09:59:58 DEBUG : rclone_appending-latest-beta.txt(0xc0004f9aa0): close: \r\n2019/06/17 09:59:58 DEBUG : rclone_appending-latest-beta.txt: Sizes differ (src 1096 vs dst 1089)\r\n2019/06/17 09:59:58 DEBUG : pacer: low level retry 1/1 (error \"rclone_appending-latest-beta.txt\" is locked: OCA\\DAV\\Connector\\Sabre\\Exception\\FileLocked: 423 Locked)\r\n2019/06/17 09:59:58 DEBUG : pacer: Rate limited, increasing sleep to 20ms\r\n2019/06/17 10:00:11 DEBUG : pacer: Reducing sleep to 15ms\r\n2019/06/17 10:00:11 DEBUG : rclone_appending-latest-beta.txt: Received error: \"rclone_appending-latest-beta.txt\" is locked: OCA\\DAV\\Connector\\Sabre\\Exception\\FileLocked: 423 Locked - low level retry 1/10\r\n2019/06/17 10:00:15 DEBUG : pacer: Reducing sleep to 11.25ms\r\n2019/06/17 10:00:15 DEBUG : pacer: Reducing sleep to 10ms\r\n2019/06/17 10:00:15 INFO  : rclone_appending-latest-beta.txt: Copied (replaced existing)\r\n2019/06/17 10:00:15 DEBUG : rclone_appending-latest-beta.txt: transferred to remote\r\n2019/06/17 10:00:15 DEBUG : rclone_appending-latest-beta.txt(0xc0004f9aa0): >close: err=<nil>\r\n2019/06/17 10:00:15 DEBUG : &{rclone_appending-latest-beta.txt (rw)}: >Flush: err=<nil>\r\n2019/06/17 10:00:15 DEBUG : fuse: -> [ID=0x211] Flush\r\n```\r\nI ran this a couple of times without issues, and so now I've also tried appending to a bigger file, one that's bigger than the chunk size of the objectstore backend (ie. 150MB) because I already know that is slow. And that's also going fine now with the retries.\r\n\r\nSo I can confirm, the issue is gone. Thanks again for your quick responses and action :)","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/rclone/rclone/issues/comments/502606635/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"wlohman-surfsara","id":40830735,"node_id":"MDQ6VXNlcjQwODMwNzM1","avatar_url":"https://avatars.githubusercontent.com/u/40830735?v=4","gravatar_id":"","url":"https://api.github.com/users/wlohman-surfsara","html_url":"https://github.com/wlohman-surfsara","followers_url":"https://api.github.com/users/wlohman-surfsara/followers","following_url":"https://api.github.com/users/wlohman-surfsara/following{/other_user}","gists_url":"https://api.github.com/users/wlohman-surfsara/gists{/gist_id}","starred_url":"https://api.github.com/users/wlohman-surfsara/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wlohman-surfsara/subscriptions","organizations_url":"https://api.github.com/users/wlohman-surfsara/orgs","repos_url":"https://api.github.com/users/wlohman-surfsara/repos","events_url":"https://api.github.com/users/wlohman-surfsara/events{/privacy}","received_events_url":"https://api.github.com/users/wlohman-surfsara/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":2416977881,"node_id":"MDExOkNsb3NlZEV2ZW50MjQxNjk3Nzg4MQ==","url":"https://api.github.com/repos/rclone/rclone/issues/events/2416977881","actor":{"login":"wlohman-surfsara","id":40830735,"node_id":"MDQ6VXNlcjQwODMwNzM1","avatar_url":"https://avatars.githubusercontent.com/u/40830735?v=4","gravatar_id":"","url":"https://api.github.com/users/wlohman-surfsara"