+    public static final String MEDIUMINT = "MEDIUMINT";
+
+    /** Keyword: NCHAR. */
+    public static final String NCHAR = "NCHAR";
+
+    /** Keyword: NOT. */
+    public static final String NOT = "NOT";
+
+    /** Keyword: NUMBER. */
+    public static final String NUMBER = "NUMBER";
+
+    /** Keyword: NUMERIC. */
