nsitive to the exact byte-for-byte contents of strings returned from the Intl APIs because there is no guarantee it will be the same across runtimes and platforms (or even from day-to-day as the underlying locale data gets updated).\n\nHere's the Chakra bug if you'd like to give feedback on this: https://github.com/Microsoft/ChakraCore/issues/599.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/comments/240277092/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"bterlson","id":11236,"node_id":"MDQ6VXNlcjExMjM2","avatar_url":"https://avatars.githubusercontent.com/u/11236?v=4","gravatar_id":"","url":"https://api.github.com/users/bterlson","html_url":"https://github.com/bterlson","followers_url":"https://api.github.com/users/bterlson/followers","following_url":"https://api.github.com/users/bterlson/following{/other_user}","gists_url":"https://api.github.com/users/bterlson/gists{/gist_id}","starred_url":"https://api.github.com/users/bterlson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bterlson/subscriptions","organizations_url":"https://api.github.com/users/bterlson/orgs","repos_url":"https://api.github.com/users/bterlson/repos","events_url":"https://api.github.com/users/bterlson/events{/privacy}","received_events_url":"https://api.github.com/users/bterlson/received_events","type":"User","user_view_type":"public","site_admin":false}},{"actor":{"login":"jdalton","id":4303,"node_id":"MDQ6VXNlcjQzMDM=","avatar_url":"https://avatars.githubusercontent.com/u/4303?v=4","gravatar_id":"","url":"https://api.github.com/users/jdalton","html_url":"https://github.com/jdalton","followers_url":"https://api.github.com/users/jdalton/followers","following_url":"https://api.github.com/users/jdalton/following{/other_user}","gists_url":"https://api.github.com/users/jdalton/