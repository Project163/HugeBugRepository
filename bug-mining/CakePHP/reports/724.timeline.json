ub.com/users/markstory","html_url":"https://github.com/markstory","followers_url":"https://api.github.com/users/markstory/followers","following_url":"https://api.github.com/users/markstory/following{/other_user}","gists_url":"https://api.github.com/users/markstory/gists{/gist_id}","starred_url":"https://api.github.com/users/markstory/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/markstory/subscriptions","organizations_url":"https://api.github.com/users/markstory/orgs","repos_url":"https://api.github.com/users/markstory/repos","events_url":"https://api.github.com/users/markstory/events{/privacy}","received_events_url":"https://api.github.com/users/markstory/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-10-16T01:45:35Z","updated_at":"2015-10-16T01:45:35Z","body":"What does your route definition look like? I attempted to reproduce this issue in the test suite, and was not able to reproduce the incorrectly generate URL of `Controller/getDealerDefaultState.json/id=47`.  \n\nThe suggested modifications cannot be applied as it will remove the ability to use `.` in path segments which will break existing applications.\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/148572255/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"markstory","id":24086,"node_id":"MDQ6VXNlcjI0MDg2","avatar_url":"https://avatars.githubusercontent.com/u/24086?v=4","gravatar_id":"","url":"https://api.github.com/users/markstory","html_url":"https://github.com/markstory","followers_url":"https://api.github.com/users/markstory/followers","following_url":"https://api.github.com/users/markstory/following{/other_user}","gists_url":"https://api.github.com/users/markstory/gists{/gist_id}","starred_url":"https://api.github.com/users/markstory/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/markstory/subscriptions","organizations_url":"https://api.github.com/users/markstory/orgs","repos_url":"https://api.github.com/users/markstory/repos","events_url":"https://api.github.com/users/markstory/events{/privacy}","received_events_url":"https://api.github.com/users/markstory/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/148608854","html_url":"https://github.com/cakephp/cakephp/issues/7554#issuecomment-148608854","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/7554","id":148608854,"node_id":"MDEyOklzc3VlQ29tbWVudDE0ODYwODg1NA==","user":{"login":"heavykevy","id":5417900,"node_id":"MDQ6VXNlcjU0MTc5MDA=","avatar_url":"https://avatars.githubusercontent.com/u/5417900?v=4","gravatar_id":"","url":"https://api.github.com/users/heavykevy","html_url":"https://github.com/heavykevy","followers_url":"https://api.github.com/users/heavykevy/followers","following_url":"https://api.github.com/users/heavykevy/following{/other_user}","gists_url":"https://api.github.com/users/heavykevy/gists{/gist_id}","starred_url":"https://api.github.com/users/heavykevy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/heavykevy/subscriptions","organizations_url":"https://api.github.com/users/heavykevy/orgs","repos_url":"https://api.github.com/users/heavykevy/repos","events_url":"https://api.github.com/users/heavykevy/events{/privacy}","received_events_url":"https://api.github.com/users/heavykevy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-10-16T05:05:52Z","updated_at":"2015-10-16T05:05:52Z","body":"Mark,\n\nI am not sure I understand your question...\n\nMy application tracks the sales of vehicles by a dealer.\nThe sales person field is an autocomplete field.\nIf a dealer is adding a purchase, the autocomplete list is generated by the\nadd method, but if an admin account adds the purchase for a dealer, the\ndealer needs to be selected and an AJAX call used to filter the sales\npeople.\n\nWhen I generated the url as such:\nPurchases/getSalesPersonList.json/47\n\nthe .json was not detected and the application complained that it could not\nfind the getSalesPersonList.json() method.\n\nIf the URL is passed without the parameter, then the .json was found and\nremoved by the code that I pointed out.\nI don't understand why the suggested modification breaks anything if the\ncurrent code would remove the .json anyway?\n\nOn Fri, Oct 16, 2015 at 8:45 AM, Mark Story notifications@github.com\nwrote:\n\n> What does your route definition look like? I attempted to reproduce this\n> issue in the test suite, and was not able to reproduce the incorrectly\n> generate URL of Controller/getDealerDefaultState.json/id=47.\n> \n> The suggested modifications cannot be applied as it will remove the\n> ability to use . in path segments which will break existing applications.\n> \n> —\n> Reply to this email directly or view it on GitHub\n> https://github.com/cakephp/cakephp/issues/7554#issuecomment-148572255.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/148608854/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"heavykevy","id":5417900,"node_id":"MDQ6VXNlcjU0MTc5MDA=","avatar_url":"https://avatars.githubusercontent.com/u/5417900?v=4","gravatar_id":"","url":"https://api.github.com/users/heavykevy","html_url":"https://github.com/heavykevy","followers_url":"https://api.github.com/users/heavykevy/followers","following_url":"https://api.github.com/users/heavykevy/following{/other_user}","gists_url":"https://api.github.com/users/heavykevy/gists{/gist_id}","starred_url":"https://api.github.com/users/heavykevy/starred{/owner}{/repo}","subs