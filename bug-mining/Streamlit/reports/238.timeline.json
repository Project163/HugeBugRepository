ls_url":"https://api.github.com/repos/streamlit/streamlit/labels{/name}","releases_url":"https://api.github.com/repos/streamlit/streamlit/releases{/id}","deployments_url":"https://api.github.com/repos/streamlit/streamlit/deployments","created_at":"2019-08-24T00:14:52Z","updated_at":"2025-12-13T03:51:18Z","pushed_at":"2025-12-13T01:35:43Z","git_url":"git://github.com/streamlit/streamlit.git","ssh_url":"git@github.com:streamlit/streamlit.git","clone_url":"https://github.com/streamlit/streamlit.git","svn_url":"https://github.com/streamlit/streamlit","homepage":"https://streamlit.io","size":797696,"stargazers_count":42660,"watchers_count":42660,"language":"Python","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":3962,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1304,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["data-analysis","data-science","data-visualization","deep-learning","developer-tools","machine-learning","python","streamlit"],"visibility":"public","forks":3962,"open_issues":1304,"watchers":42660,"default_branch":"develop","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/streamlit/streamlit/pulls/9186","html_url":"https://github.com/streamlit/streamlit/pull/9186","diff_url":"https://github.com/streamlit/streamlit/pull/9186.diff","patch_url":"https://github.com/streamlit/streamlit/pull/9186.patch","merged_at":"2024-08-05T08:31:07Z"},"body":"## Describe your changes\r\n\r\nCloses https://github.com/streamlit/streamlit/issues/9158\r\n\r\nSo far we seemed to have missed the case where we can have stale widgets in the same fragment we are currently running which stem from a previous run. This PR closes this gap by removing widget nodes that belong to the current fragment but an old run. \r\nIt looks like the reason why this is happening for tabs (and probably other containers) and not for other elements is that in for a tab delta, the `scriptRunId` is updated to the current run, so the existing pruning logic does not work; the new approach also considers the child's `scriptRunId`!\r\n\r\nThe following screenshot shows this (taken without the fix):\r\n<img width=\"1728\" alt=\"Screenshot 2024-07-31 at 16 34 11\" src=\"https://github.com/user-attachments/assets/178f455b-bc0c-448c-b9bc-013eae1a2920\">\r\n\r\n## GitHub Issue Link (if applicable)\r\n\r\n## Testing Plan\r\n\r\n- Explanation of why no additional tests are needed\r\n- Unit Tests (JS and/or Python)\r\n  - Extended unit test to simulate this issue\r\n- E2E Tests\r\n  - Add e2e test with example app from #9158\r\n- Any manual testing needed?\r\n\r\n---\r\n\r\n**Contribution License Agreement**\r\n\r\nBy submitting this pull request you agree that all contributions to this project are made under the Apache 2.0 license.\r\n","reactions":{"url":"https://api.github.com/repos/streamlit/streamlit/issues/9186/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/streamlit/streamlit/issues/9186/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/streamlit/streamlit/issues/comments/2264718006","html_url":"https://github.com/streamlit/streamlit/issues/9158#issuecomment-2264718006","issue_url":"https://api.github.com/repos/streamlit/streamlit/issues/9158","id":2264718006,"node_id":"IC_kwDODCoeTs6G_Nq2","user":{"login":"Amrit02102004","id":114827768,"node_id":"U_kgDOBtgh-A","avatar_url":"https://avatars.githubusercontent.com/u/114827768?v=4","gravatar_id":"","url":"https://api.github.com/users/Amrit02102004","html_u