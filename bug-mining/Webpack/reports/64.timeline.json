rs/sokra/orgs","repos_url":"https://api.github.com/users/sokra/repos","events_url":"https://api.github.com/users/sokra/events{/privacy}","received_events_url":"https://api.github.com/users/sokra/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/webpack/webpack/issues/comments/225828591","html_url":"https://github.com/webpack/webpack/issues/2528#issuecomment-225828591","issue_url":"https://api.github.com/repos/webpack/webpack/issues/2528","id":225828591,"node_id":"MDEyOklzc3VlQ29tbWVudDIyNTgyODU5MQ==","user":{"login":"maxhr","id":2169660,"node_id":"MDQ6VXNlcjIxNjk2NjA=","avatar_url":"https://avatars.githubusercontent.com/u/2169660?v=4","gravatar_id":"","url":"https://api.github.com/users/maxhr","html_url":"https://github.com/maxhr","followers_url":"https://api.github.com/users/maxhr/followers","following_url":"https://api.github.com/users/maxhr/following{/other_user}","gists_url":"https://api.github.com/users/maxhr/gists{/gist_id}","starred_url":"https://api.github.com/users/maxhr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/maxhr/subscriptions","organizations_url":"https://api.github.com/users/maxhr/orgs","repos_url":"https://api.github.com/users/maxhr/repos","events_url":"https://api.github.com/users/maxhr/events{/privacy}","received_events_url":"https://api.github.com/users/maxhr/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-06-14T09:31:11Z","updated_at":"2016-06-14T09:31:11Z","body":"Found the problem - \nFor some reason, Babel's compilation puts `import { foo } from './module';` after the declaration of `notExportedAsync`\n\nHere is the output of Babel, before Webpack, notice `import { foo }` in the middle.\nWebpack won't rename symbols occuring before their import.\nIs it a proper behavior?\n\n```\nimport _regeneratorRuntime from 'babel-runtime/regenerator';\nimport _asyncToGenerator from 'babel-runtime/helpers/asyncToGenerator';\n// will rename foo() to __WEBPACK_IMPORTED_MODULE_2__module__[\"a\"].bind()()\n\nvar notExportedAsync = function () {\n    var ref = _asyncToGenerator(_regeneratorRuntime.mark(function _callee2() {\n        return _regeneratorRuntime.wrap(function _callee2$(_context2) {\n            while (1) {\n                switch (_context2.prev = _context2.next) {\n                    case 0:\n                        foo(); // WILL NOT rename foo() <<<<======\n\n                    case 1:\n                    case 'end':\n                        return _context2.stop();\n                }\n            }\n        }, _callee2, this);\n    }));\n\n    return function notExportedAsync() {\n        return ref.apply(this, arguments);\n    };\n}();\n\nimport { foo } from './module';\n// will transform to:\n// /* harmony import */ var __WEBPACK_IMPORTED_MODULE_2__module__ = __webpack_require__(50);\n\nexport var exportedAsync = function () {\n    var ref = _asyncToGenerator(_regeneratorRuntime.mark(function _callee() {\n        return _regeneratorRuntime.wrap(function _callee$(_context) {\n            while (1) {\n                switch (_context.prev = _context.next) {\n                    case 0:\n                        _context.next = 2;\n                        return foo();\n\n                    case 2:\n                    case 'end':\n                        return _context.stop();\n                }\n            }\n        }, _callee, this);\n    }));\n\n    return function exportedAsync() {\n        return ref.apply(this, arguments);\n    };\n}();\n\nexport function exportedNotAsync() {\n    foo(); // rename OK\n}\n\nfunction notExportedNotAsync() {\n    foo(); // rename OK\n}\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/webpack/webpack/issues/comments/225828591/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","act