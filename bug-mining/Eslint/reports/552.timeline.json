[{"url":"https://api.github.com/repos/eslint/eslint/issues/comments/137995488","html_url":"https://github.com/eslint/eslint/issues/3672#issuecomment-137995488","issue_url":"https://api.github.com/repos/eslint/eslint/issues/3672","id":137995488,"node_id":"MDEyOklzc3VlQ29tbWVudDEzNzk5NTQ4OA==","user":{"login":"eslintbot","id":13383618,"node_id":"MDQ6VXNlcjEzMzgzNjE4","avatar_url":"https://avatars.githubusercontent.com/u/13383618?v=4","gravatar_id":"","url":"https://api.github.com/users/eslintbot","html_url":"https://github.com/eslintbot","followers_url":"https://api.github.com/users/eslintbot/followers","following_url":"https://api.github.com/users/eslintbot/following{/other_user}","gists_url":"https://api.github.com/users/eslintbot/gists{/gist_id}","starred_url":"https://api.github.com/users/eslintbot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eslintbot/subscriptions","organizations_url":"https://api.github.com/users/eslintbot/orgs","repos_url":"https://api.github.com/users/eslintbot/repos","events_url":"https://api.github.com/users/eslintbot/events{/privacy}","received_events_url":"https://api.github.com/users/eslintbot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-09-05T21:30:34Z","updated_at":"2015-09-05T21:30:34Z","body":"Thanks for the issue! We get a lot of issues, so this message is automatically posted to each one to help you check that you've included all of the information we need to help you.\n\nReporting a bug? Please be sure to include:\n1. The version of ESLint you are using (run `eslint -v`)\n2. The source code that caused the problem\n3. The configuration you're using (for the rule or your entire config file)\n4. The actual ESLint output complete with line numbers\n\nRequesting a new rule? Please be sure to include:\n1. The use case for the rule - what is it trying to prevent or flag?\n2. Whether the rule is trying to prevent an error or is purely stylistic\n3. Why you believe this rule is generic enough to be included\n\nRequesting a feature? Please be sure to include:\n1. The problem you want to solve (don't mention the solution)\n2. Your take on the correct solution to problem\n\nIncluding this information in your issue helps us to triage it and get you a response as quickly as possible.\n\nThanks!\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/eslint/eslint/issues/comments/137995488/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"eslintbot","id":13383618,"node_id":"MDQ6VXNlcjEzMzgzNjE4","avatar_url":"https://avatars.githubusercontent.com/u/13383618?v=4","gravatar_id":"","url":"https://api.github.com/users/eslintbot","html_url":"https://github.com/eslintbot","followers_url":"https://api.github.com/users/eslintbot/followers","following_url":"https://api.github.com/users/eslintbot/following{/other_user}","gists_url":"https://api.github.com/users/eslintbot/gists{/gist_id}","starred_url":"https://api.github.com/users/eslintbot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eslintbot/subscriptions","organizations_url":"https://api.github.com/users/eslintbot/orgs","repos_url":"https://api.github.com/users/eslintbot/repos","events_url":"https://api.github.com/users/eslintbot/events{/privacy}","received_events_url":"https://api.github.com/users/eslintbot/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":401977356,"node_id":"MDEyOkxhYmVsZWRFdmVudDQwMTk3NzM1Ng==","url":"https://api.github.com/repos/eslint/eslint/issues/events/401977356","actor":{"login":"eslintbot","id":13383618,"node_id":"MDQ6VXNlcjEzMzgzNjE4","avatar_url":"https://avatars.githubusercontent.com/u/13383618?v=4","gravatar_id":"","url":"https://api.github.com/users/eslintbot","html_url":"https://github.com/eslintbot","followers_url":"https://api.github.com/