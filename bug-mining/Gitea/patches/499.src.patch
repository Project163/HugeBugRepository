+
+func TestAddLdapSSHPublicKeys(t *testing.T) {
+	assert.NoError(t, PrepareTestDatabase())
+
+	user := AssertExistsAndLoadBean(t, &User{ID: 2}).(*User)
+	s := &LoginSource{ID: 1}
+
+	testCases := []struct {
+		keyString   string
+		number      int
+		keyContents []string
+	}{
+		{
+			keyString: "ssh-rsa  nocomment\n",
+			number:    1,
+			keyContents: []string{
+				"ssh-rsa ",
+			},
+		},
+		{
+			keyString: `ssh-rsa  nocomment
+ssh-dss  nocomment`,
+			number: 2,
+			keyContents: []string{
+				"ssh-rsa ",
+				"ssh-dss ",
+			},
+		},
+		{
+			keyString: `ssh-rsa  nocomment
+# comment asmdna,ndp
+ssh-dss  nocomment`,
+			number: 2,
+			keyContents: []string{
+				"ssh-rsa ",
+				"ssh-dss ",
+			},
+		},
+		{
+			keyString: `ssh-rsa  nocomment
+382488320jasdj1lasmva/vasodifipi4193-fksma.cm
+ssh-dss  nocomment`,
+			number: 2,
+			keyContents: []string{
+				"ssh-rsa ",
+				"ssh-dss ",
+			},
+		},
+	}
+
+	for i, kase := range testCases {
+		s.ID = int64(i) + 20
+		addLdapSSHPublicKeys(user, s, []string{kase.keyString})
+		keys, err := ListPublicLdapSSHKeys(user.ID, s.ID)
+		assert.NoError(t, err)
+		if err != nil {
+			continue
+		}
+		assert.Equal(t, kase.number, len(keys))
+
+		for _, key := range keys {
+			assert.Contains(t, kase.keyContents, key.Content)
+		}
+		for _, key := range keys {
+			DeletePublicKey(user, key.ID)
+		}
+	}
+}
