&lt;ol&gt;
	&lt;li&gt;
	&lt;ol&gt;
		&lt;li&gt;
		&lt;ol&gt;
			&lt;li&gt;What is the Jira issue?&lt;br/&gt;
    &lt;a href=&quot;https://issues.apache.org/jira/browse/ZEPPELIN-2106&quot; title=&quot;Provide ability to create charts through REST API&quot; class=&quot;issue-link&quot; data-issue-key=&quot;ZEPPELIN-2106&quot;&gt;&lt;del&gt;ZEPPELIN-2106&lt;/del&gt;&lt;/a&gt;(&lt;a href=&quot;https://issues.apache.org/jira/browse/ZEPPELIN-2106&quot; class=&quot;external-link&quot; rel=&quot;nofollow&quot;&gt;https://issues.apache.org/jira/browse/ZEPPELIN-2106&lt;/a&gt;)&lt;/li&gt;
		&lt;/ol&gt;
