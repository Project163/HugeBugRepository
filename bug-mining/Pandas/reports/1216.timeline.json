.com/users/Batalex/subscriptions","organizations_url":"https://api.github.com/users/Batalex/orgs","repos_url":"https://api.github.com/users/Batalex/repos","events_url":"https://api.github.com/users/Batalex/events{/privacy}","received_events_url":"https://api.github.com/users/Batalex/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-04-28T14:49:58Z","updated_at":"2019-04-28T14:49:58Z","body":"I have looked a bit into this, but I am not satisfied with what I got. My understanding is that as of today `numpy.core.fromnumeric._wrapreduction` will first look for `<func>` in the object's attributes instead of using `__array_ufunc__` duck array. This means that we cannot fix this issue for now by implementing `__array_ufunc__` in `pandas.core.indexes.base.Index`.\r\n\r\nA dirty fix is to add a kwargs passthrough arg to `IndexOpsMixin`'s `min` & `max`  implementations like this :\r\n```\r\nmax(self, axis=None, skipna=True, **kwargs)\r\n```\r\nIt does not break tests, but it is a public interface modification 👎 ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/pandas-dev/pandas/issues/comments/487386164/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Batalex","id":11004857,"node_id":"MDQ6VXNlcjExMDA0ODU3","avatar_url":"https://avatars.githubusercontent.com/u/11004857?v=4","gravatar_id":"","url":"https://api.github.com/users/Batalex","html_url":"https://github.com/Batalex","followers_url":"https://api.github.com/users/Batalex/followers","following_url":"https://api.github.com/users/Batalex/following{/other_user}","gists_url":"https://api.github.com/users/Batalex/gists{/gist_id}","starred_url":"https://api.github.com/users/Batalex/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Batalex/subscriptions","organizations_url":"https://api.github.com/us