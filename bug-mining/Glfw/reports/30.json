estones/2/labels","id":325603,"node_id":"MDk6TWlsZXN0b25lMzI1NjAz","number":2,"title":"3.1","description":"","creator":{"login":"elmindreda","id":133714,"node_id":"MDQ6VXNlcjEzMzcxNA==","avatar_url":"https://avatars.githubusercontent.com/u/133714?v=4","gravatar_id":"","url":"https://api.github.com/users/elmindreda","html_url":"https://github.com/elmindreda","followers_url":"https://api.github.com/users/elmindreda/followers","following_url":"https://api.github.com/users/elmindreda/following{/other_user}","gists_url":"https://api.github.com/users/elmindreda/gists{/gist_id}","starred_url":"https://api.github.com/users/elmindreda/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elmindreda/subscriptions","organizations_url":"https://api.github.com/users/elmindreda/orgs","repos_url":"https://api.github.com/users/elmindreda/repos","events_url":"https://api.github.com/users/elmindreda/events{/privacy}","received_events_url":"https://api.github.com/users/elmindreda/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":109,"state":"closed","created_at":"2013-05-02T14:52:21Z","updated_at":"2015-02-25T03:23:01Z","due_on":null,"closed_at":"2015-01-18T20:33:36Z"},"comments":0,"created_at":"2014-01-05T01:01:39Z","updated_at":"2015-01-04T15:54:58Z","closed_at":"2015-01-04T15:54:58Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Calling glfwGetWindowAttrib() with GLFW_ICONIFIED does not always/immediately return the correct state on Windows. The problem appears to be the Win+D workaround in win32_window.c, where \"iconified\" is set to FALSE, although the window is in fact still iconified. It can be observed by maximizing a window from the taskbar and comparing glfwGetWindowAttrib()'s result with ::IsIconic() using the window handle exposed from the native interface.\n\nThis is a serious issue because it can make the application freeze if GLFW_ICONIFIED is queried to determine whether SwapBuffers() shall be called or not!\n\nAs a workaround, I'm currently checking ::IsIconic() directly before attempting to render stuff. When I remove the Win+D workaround, everything behaves correctly except, well, the Win+D case :)\n\nEDIT: I just noticed that this is related to Issue #189 \n","closed_by":{"login":"elmindreda","id":133714,"node_id":"MDQ6VXNlcjEzMzcxNA==","avatar_url":"https://avatars.githubusercontent.com/u/133714?v=4","gravatar_id":"","url":"https://api.github.com/users/elmindreda","html_url":"https://github.com/elmindreda","followers_url":"https://api.github.com/users/elmindreda/followers","following_url":"https://api.github.com/users/elmindreda/following{/other_user}","gists_url":"https://api.github.com/users/elmindreda/gists{/gist_id}","starred_url":"https://api.github.com/users/elmindreda/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elmindreda/subscriptions","organizations_url":"https://api.github.com/users/elmindreda/orgs","repos_url":"https://api.github.com/users/elmindreda/repos","events_url":"https://api.github.com/users/elmindreda/events{/privacy}","received_events_url":"https://api.github.com/users/elmindreda/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/glfw/glfw/issues/204/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/glfw/glfw/issues/204/timeline","performed_via_github_app":null,"state_reason":"completed"}