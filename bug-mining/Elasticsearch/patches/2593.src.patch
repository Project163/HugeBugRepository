+
+        query = new DoubleScriptFieldRangeQuery(randomScript(), leafFactory, "test", -0.0, Double.POSITIVE_INFINITY);
+        assertTrue(query.matches(new double[] { -0.0 }, 1));
+        assertTrue(query.matches(new double[] { 0.0 }, 1));
+
+        query = new DoubleScriptFieldRangeQuery(randomScript(), leafFactory, "test", 0.0, Double.POSITIVE_INFINITY);
