-              echo Thread dumps are taken for analysis at $fileName
-              echo forcefully stopping $command
-              kill -9 $TARGET_PID >/dev/null 2>&1
-              echo Successfully stopped the process
-        fi
-      else
-        echo no $command to stop
-      fi
-      rm $pid
-    else
-      echo no $command to stop
-    fi
-    ;;
-
-  (*)
-    usage
-    exit 1
-    ;;
-esac
