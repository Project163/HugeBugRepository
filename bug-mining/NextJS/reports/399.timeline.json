ercel/next.js","homepage":"https://nextjs.org","size":2429859,"stargazers_count":136480,"watchers_count":136480,"language":"JavaScript","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":30029,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":3156,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["blog","browser","compiler","components","hybrid","nextjs","node","react","server-rendering","ssg","static","static-site-generator","universal","vercel"],"visibility":"public","forks":30029,"open_issues":3156,"watchers":136480,"default_branch":"canary","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/vercel/next.js/pulls/51510","html_url":"https://github.com/vercel/next.js/pull/51510","diff_url":"https://github.com/vercel/next.js/pull/51510.diff","patch_url":"https://github.com/vercel/next.js/pull/51510.patch","merged_at":"2023-06-19T19:45:51Z"},"body":"Currently an \"action module\" (files with `\"use server\"` on top) can be imported by both the server and client layers. In that case, we can't fork that action module into two modules (one on the server layer, one on the action layer), but only create it once on the server layer.\r\n\r\nThis ensures that the action module instance doesn't get forked.\r\n\r\nCloses #50801.\nfix NEXT-1265","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/51510/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vercel/next.js/issues/51510/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":9571870514,"node_id":"CE_lADOB