org/subscriptions","organizations_url":"https://api.github.com/users/LinusBorg/orgs","repos_url":"https://api.github.com/users/LinusBorg/repos","events_url":"https://api.github.com/users/LinusBorg/events{/privacy}","received_events_url":"https://api.github.com/users/LinusBorg/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2021-10-26T19:00:20Z","label":{"name":":lady_beetle:  bug","color":"fcba03"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/vuejs/core/issues/comments/952229729","html_url":"https://github.com/vuejs/core/issues/4859#issuecomment-952229729","issue_url":"https://api.github.com/repos/vuejs/core/issues/4859","id":952229729,"node_id":"IC_kwDOCCum1844wd9h","user":{"login":"LinusBorg","id":1444526,"node_id":"MDQ6VXNlcjE0NDQ1MjY=","avatar_url":"https://avatars.githubusercontent.com/u/1444526?v=4","gravatar_id":"","url":"https://api.github.com/users/LinusBorg","html_url":"https://github.com/LinusBorg","followers_url":"https://api.github.com/users/LinusBorg/followers","following_url":"https://api.github.com/users/LinusBorg/following{/other_user}","gists_url":"https://api.github.com/users/LinusBorg/gists{/gist_id}","starred_url":"https://api.github.com/users/LinusBorg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LinusBorg/subscriptions","organizations_url":"https://api.github.com/users/LinusBorg/orgs","repos_url":"https://api.github.com/users/LinusBorg/repos","events_url":"https://api.github.com/users/LinusBorg/events{/privacy}","received_events_url":"https://api.github.com/users/LinusBorg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-10-26T19:07:40Z","updated_at":"2021-11-03T08:52:50Z","body":"This is caused by two things:\r\n\r\n1. You needlessly binding `$attrs` to the root element, as Vue will do that on its own already (called \"attribute fallthrough\") *and* have an additional single @click listener defined.\r\n2. A failure on Vue's part to detect that the same click event will be added twice when merging attrs in this fallthrough behavior. This only happens in this specific scenario where you already have two click events (which are combined in an array), and then Vue adds fallthrough events on its own.\r\n\r\nTo be precise, this line doesn't account for event arrays: \r\n\r\nhttps://github.com/vuejs/vue-next/blob/ebd0baca98b618945fba223b94833c2b34cdf6a2/packages/runtime-core/src/vnode.ts#L794\r\n\r\nSolution/Workaround for OP:\r\n\r\nEither remove `v-bind=\"$attrs\"` as it's not needed to assign attrs to the root element, or properly add the `inheritAttrs: false` option if you want to assign $attrs manually.\r\n\r\nWe still should fix this thoug, as this incomplete check in `mergerProps` could potentially affect other scenarios as well I would assume.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/vuejs/core/issues/comments/952229729/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"LinusBorg","id":1444526,"node_id":"MDQ6VXNlcjE0NDQ1MjY=","avatar_url":"https://avatars.githubusercontent.com/u/1444526?v=4","gravatar_id":"","url":"https://api.github.com/users/LinusBorg","html_url":"https://github.com/LinusBorg","followers_url":"https://api.github.com/users/LinusBorg/followers","following_url":"https://api.github.com/users/LinusBorg/following{/other_user}","gists_url":"https://api.github.com/users/LinusBorg/gists{/gist_id}","starred_url":"https://api.github.com/users/LinusBorg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LinusBorg/subscriptions","organizations_url":"https://api.github.com/users/LinusBorg/orgs","repos_url":"https://api.github.com/users/LinusBorg/repos","events_url":"https://api.github.com/users/LinusBorg/events{/privacy}","received_events_url":"https://api.github.com/users/LinusBorg/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/vuejs/core/issues/comments/957181562","html_url":"https://github.com/vuejs/core/issues/4859#issuecomment-957181562","issue_url":"https://api.github.com/repos/vuejs/core/issues/4859","id":957181562,"node_id":"IC_kwDOCCum1845DW56","user":{"login":"soulsam480","id":35460828,"node_id":"MDQ6VXNlcjM1NDYwODI4","avatar_url":"https://avatars.githubusercontent.com/u/35460828?v=4","gravatar_id":"","url":"https://api.github.com/users/soulsam480","html_url":"https://github.com/soulsam480","followers_url":"https://api.github.com/users/soulsam480/followers","following_url":"https://api.github.com/users/soulsam480/following{/other_user}","gists_url":"https://api.github.com/users/soulsam480/gists{/gist_id}","starred_url":"https://api.github.com/users/soulsam480/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/soulsam480/subscriptions","organizations_url":"https://api.github.com/users/soulsam480/orgs","repos_url":"https://api.github.com/users/soulsam480/repos","events_url":"https://api.github.com/users/soulsam480/events{/privacy}","received_events_url":"https://api.github.com/users/soulsam480/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-11-02T08:01:35Z","updated_at":"2021-11-02T08:01:35Z","body":"just discovered this issue where the handler is getting fired two time.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/vuejs/core/issues/comments/957181562/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"soulsam480","id":35460828,"node_id":"MDQ6VXNlcjM1NDYwODI4","avatar_url":"https://avatars.githubusercontent.com/u/35460828?v=4","gravatar_id":"","url":"https://api