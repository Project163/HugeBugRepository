doob/three.js/issues/7947#issuecomment-171693379","issue_url":"https://api.github.com/repos/mrdoob/three.js/issues/7947","id":171693379,"node_id":"MDEyOklzc3VlQ29tbWVudDE3MTY5MzM3OQ==","user":{"login":"arodic","id":708984,"node_id":"MDQ6VXNlcjcwODk4NA==","avatar_url":"https://avatars.githubusercontent.com/u/708984?v=4","gravatar_id":"","url":"https://api.github.com/users/arodic","html_url":"https://github.com/arodic","followers_url":"https://api.github.com/users/arodic/followers","following_url":"https://api.github.com/users/arodic/following{/other_user}","gists_url":"https://api.github.com/users/arodic/gists{/gist_id}","starred_url":"https://api.github.com/users/arodic/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arodic/subscriptions","organizations_url":"https://api.github.com/users/arodic/orgs","repos_url":"https://api.github.com/users/arodic/repos","events_url":"https://api.github.com/users/arodic/events{/privacy}","received_events_url":"https://api.github.com/users/arodic/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-01-14T16:36:12Z","updated_at":"2016-01-14T16:36:12Z","body":"To rotate around Y axis, for example, the control casts a ray through XZ plane and determines the angle between drag start and drag end vector in that plane. When camera is at 0, 0 it is perfectly aligned with XZ and YZ plane and it doesn't make sense to project into those planes. This also makes the rotation difficult when camera is almost aligned. I noticed that many rotation gizmos suffer from this problem including tools such as Autodesk Maya.\n\nSome time ago, I refactored and greatly simplified [TransformControls](https://github.com/arodic/ree.js/blob/master/app/js/controls/Transform.js) and also fixed bunch of bugs such as this one (by improving the angle calculation math and hiding the rotation handles when perfectly aligned to the plane). However, this improved version cannot be easily merged back into three.js since it relies on shared [Control](https://github.com/arodic/ree.js/blob/master/app/js/controls/Control.js) superclass (also used by improved [EditorContols](https://github.com/arodic/ree.js/blob/master/app/js/controls/Viewport.js)).\n\nIf there is interest to pull this back into three.js I can help with that.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/mrdoob/three.js/issues/comments/171693379/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"arodic","id":708984,"node_id":"MDQ6VXNlcjcwODk4NA==","avatar_url":"https://avatars.githubusercontent.com/u/708984?v=4","gravatar_id":"","url":"https://api.github.com/users/arodic","html_url":"https://github.com/arodic","followers_url":"https://api.github.com/users/arodic/followers","following_url":"https://api.github.com/users/arodic/following{/other_user}","gists_url":"https://api.github.com/users/arodic/gists{/gist_id}","starred_url":"https://api.github.com/users/arodic/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arodic/subscriptions","organizations_url":"https://api.github.com/users/arodic/orgs","repos_url":"https://api.github.com/users/arodic/repos","events_url":"https://api.github.com/users/arodic/events{/privacy}","received_events_url":"https://api.github.com/users/arodic/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/mrdoob/three.js/issues/comments/171698152","html_url":"https://github.com/mrdoob/three.js/issues/7947#issuecomment-171698152","issue_url":"https://api.github.com/repos/mrdoob/three.js/issues/7947","id":171698152,"node_id":"MDEyOklzc3VlQ29tbWVudDE3MTY5ODE1Mg==","user":{"login":"WestLangley","id":1000017,"node_id":"MDQ6VXNlcjEwMDAwMTc=","avatar_url":"https://avatars.githubusercontent.com/u/1000017?v=4","gravatar_id":"","url":"https://ap