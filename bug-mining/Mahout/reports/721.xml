                            <comment id="17021632" author="andrew_palumbo" created="Wed, 22 Jan 2020 23:59:03 +0000"  >&lt;p&gt;it is the maven &lt;tt&gt;source-release-assembly&lt;/tt&gt; plugin in the &lt;tt&gt;Apache pom.xml v.18&lt;/tt&gt; that we call from our root pom..&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
&amp;lt;plugin&amp;gt;
  &amp;lt;groupId&amp;gt;org.apache.maven.plugins&amp;lt;/groupId&amp;gt;
  &amp;lt;artifactId&amp;gt;maven-assembly-plugin&amp;lt;/artifactId&amp;gt;
  &amp;lt;dependencies&amp;gt;
    &amp;lt;dependency&amp;gt;
      &amp;lt;groupId&amp;gt;org.apache.apache.resources&amp;lt;/groupId&amp;gt;
      &amp;lt;artifactId&amp;gt;apache-source-release-assembly-descriptor&amp;lt;/artifactId&amp;gt;
      &amp;lt;version&amp;gt;1.0.6&amp;lt;/version&amp;gt;
    &amp;lt;/dependency&amp;gt;
  &amp;lt;/dependencies&amp;gt;
  &amp;lt;executions&amp;gt;
    &amp;lt;execution&amp;gt;
      &amp;lt;id&amp;gt;source-release-assembly&amp;lt;/id&amp;gt;
      &amp;lt;phase&amp;gt;&lt;span class=&quot;code-keyword&quot;&gt;package&lt;/span&gt;&amp;lt;/phase&amp;gt;
      &amp;lt;goals&amp;gt;
        &amp;lt;goal&amp;gt;single&amp;lt;/goal&amp;gt;
      &amp;lt;/goals&amp;gt;
      &amp;lt;configuration&amp;gt;
        &amp;lt;runOnlyAtExecutionRoot&amp;gt;&lt;span class=&quot;code-keyword&quot;&gt;true&lt;/span&gt;&amp;lt;/runOnlyAtExecutionRoot&amp;gt;
        &amp;lt;descriptorRefs&amp;gt;
          &amp;lt;descriptorRef&amp;gt;${sourceReleaseAssemblyDescriptor}&amp;lt;/descriptorRef&amp;gt;
        &amp;lt;/descriptorRefs&amp;gt;
        &amp;lt;tarLongFileMode&amp;gt;gnu&amp;lt;/tarLongFileMode&amp;gt;
      &amp;lt;/configuration&amp;gt;
    &amp;lt;/execution&amp;gt;
  &amp;lt;/executions&amp;gt;
&amp;lt;/plugin&amp;gt; &lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</comment>
                            <comment id="17022159" author="andrew_palumbo" created="Thu, 23 Jan 2020 14:48:11 +0000"  >&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
 &amp;lt;plugin&amp;gt;
 &amp;lt;groupId&amp;gt;org.apache.maven.plugins&amp;lt;/groupId&amp;gt;
 &amp;lt;artifactId&amp;gt;maven-assembly-plugin&amp;lt;/artifactId&amp;gt;
 &amp;lt;dependencies&amp;gt;
 &amp;lt;dependency&amp;gt;
 &amp;lt;groupId&amp;gt;org.apache.apache.resources&amp;lt;/groupId&amp;gt;
 &amp;lt;artifactId&amp;gt;apache-source-release-assembly-descriptor&amp;lt;/artifactId&amp;gt;
 &amp;lt;version&amp;gt;1.0.6&amp;lt;/version&amp;gt;
 &amp;lt;/dependency&amp;gt;
 &amp;lt;/dependencies&amp;gt;
 &amp;lt;executions&amp;gt;
 &amp;lt;execution&amp;gt;
 &amp;lt;id&amp;gt;source-release-assembly&amp;lt;/id&amp;gt;
 &amp;lt;phase&amp;gt;dont execute&amp;lt;/phase&amp;gt; &amp;lt;!---- &lt;span class=&quot;code-keyword&quot;&gt;do&lt;/span&gt; not run &lt;span class=&quot;code-keyword&quot;&gt;this&lt;/span&gt; -&amp;gt;
 &amp;lt;goals&amp;gt;
 &amp;lt;goal&amp;gt;single&amp;lt;/goal&amp;gt;
 &amp;lt;/goals&amp;gt;
 &amp;lt;configuration&amp;gt;
 &amp;lt;runOnlyAtExecutionRoot&amp;gt;&lt;span class=&quot;code-keyword&quot;&gt;true&lt;/span&gt;&amp;lt;/runOnlyAtExecutionRoot&amp;gt;
 &amp;lt;descriptorRefs&amp;gt;
 &amp;lt;descriptorRef&amp;gt;${sourceReleaseAssemblyDescriptor}&amp;lt;/descriptorRef&amp;gt;
 &amp;lt;/descriptorRefs&amp;gt;
