+const HEADINGS = ['h1', 'h2', 'h3', 'h4', 'h5', 'h6'];
+const NO_ANCHOR_CLASS = 'no-anchor';
+
+const clone = obj => JSON.parse(JSON.stringify(obj));
+const hasClass = (node, cls) => {
