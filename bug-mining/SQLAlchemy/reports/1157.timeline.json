  ]\r\n)\r\n\r\nengine = create_engine(\"postgresql://scott:tiger@localhost/test\", echo='debug',\r\n    executemany_mode=\"values\"\r\n)\r\nBase.metadata.drop_all(engine)\r\nBase.metadata.create_all(engine)\r\n\r\nsession = Session(engine)\r\nstmt = sqlalchemy.dialects.postgresql.insert(User.__table__).on_conflict_do_nothing()\r\nsession.execute(stmt,     [\r\n        dict(name=\"sandy\", fullname=\"Sandy Cheeks\"),\r\n        dict(name=\"squidward\", fullname=\"Squidward Tentacles\"),\r\n        dict(name=\"spongebob\", fullname=\"Spongebob Squarepants\"),\r\n    ]\r\n)\r\n\r\n\r\n```\r\n\r\nin the pg server logs:\r\n\r\n    INSERT INTO \"user\" (name, fullname) VALUES ('sandy', 'Sandy Cheeks'),('squidward', 'Squidward Tentacles'),('spongebob', 'Spongebob Squarepants') ON CONFLICT DO NOTHING\r\n\r\nfor 1.3 only.  in 1.4 it sends them individualy","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/7880/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/7880/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]