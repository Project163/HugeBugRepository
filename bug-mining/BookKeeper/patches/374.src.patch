-    }
-
-    protected void setUp() throws Exception {
-        super.setAutoFail(autoFail);
-        super.setUp();
-    }
-
-    protected void tearDown() throws Exception {
-        for (Iterator<Connection> iter = connections.iterator(); iter.hasNext();) {
-            Connection conn = iter.next();
-            try {
