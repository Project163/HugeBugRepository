          }\n                foreach ($this->children as &$children) {\n                    if (isset($children[$name])) {\n                        $children[$item->name] = $children[$name];\n                        unset($children[$name]);\n                    }\n                }\n                foreach ($this->assignments as &$assignments) {\n                    if (isset($assignments[$name])) {\n                        $assignments[$item->name] = $assignments[$name];\n                        $assignments[$item->name]->roleName = $item->name; // add this\n                        unset($assignments[$name]);\n                    }\n                }\n                $this->saveAssignments();  // and this\n            }\n        }\n\n        $this->items[$item->name] = $item;\n        $this->saveItems();\n        return true;\n    }\n```\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yiisoft/yii2/issues/comments/141104718/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"rezident","id":6260425,"node_id":"MDQ6VXNlcjYyNjA0MjU=","avatar_url":"https://avatars.githubusercontent.com/u/6260425?v=4","gravatar_id":"","url":"https://api.github.com/users/rezident","html_url":"https://github.com/rezident","followers_url":"https://api.github.com/users/rezident/followers","following_url":"https://api.github.com/users/rezident/following{/other_user}","gists_url":"https://api.github.com/users/rezident/gists{/gist_id}","starred_url":"https://api.github.com/users/rezident/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rezident/subscriptions","organizations_url":"https://api.github.com/users/rezident/orgs","repos_url":"https://api.github.com/users/rezident/repos","events_url":"https://api.github.com/users/rezident/events{/privacy}","received_events_url":"https://api.github.com/users/rezident/re