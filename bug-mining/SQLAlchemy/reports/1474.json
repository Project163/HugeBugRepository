l,"closed_at":null},"comments":4,"created_at":"2023-08-13T14:21:42Z","updated_at":"2024-01-17T22:54:36Z","closed_at":"2023-08-14T22:35:30Z","author_association":"MEMBER","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"this starts with #10230 where selectinload / immediateload / subqueryload(?) do not receive an execution option from `session.execute()` for disabling the cache.  however **no** options are passed, including really important ones like `schema_translate_map`.   \r\n\r\npropose **all** options are passed along here, including user-defined ones\r\n\r\n```py\r\nfrom __future__ import annotations\r\n\r\nfrom sqlalchemy import annotations\r\nfrom sqlalchemy import create_engine\r\nfrom sqlalchemy import ForeignKey\r\nfrom sqlalchemy import select\r\nfrom sqlalchemy.orm import annotations\r\nfrom sqlalchemy.orm import DeclarativeBase\r\nfrom sqlalchemy.orm import Mapped\r\nfrom sqlalchemy.orm import mapped_column\r\nfrom sqlalchemy.orm import relationship\r\nfrom sqlalchemy.orm import selectinload\r\nfrom sqlalchemy.orm import Session\r\n\r\n\r\nclass Base(DeclarativeBase):\r\n    pass\r\n\r\n\r\nclass A(Base):\r\n    __tablename__ = \"a\"\r\n\r\n    id: Mapped[int] = mapped_column(primary_key=True)\r\n    bs: Mapped[list[B]] = relationship(\"B\")\r\n\r\n    __table_args__ = {\"schema\": \"foo\"}\r\n\r\nclass B(Base):\r\n    __tablename__ = \"b\"\r\n    id: Mapped[int] = mapped_column(primary_key=True)\r\n    a_id: Mapped[int] = mapped_column(ForeignKey(\"foo.a.id\"))\r\n\r\n    __table_args__ = {\"schema\": \"foo\"}\r\n\r\n\r\ne = create_engine(\"sqlite://\", echo=True)\r\nBase.metadata.create_all(e.execution_options(schema_translate_map= {\"foo\": None}))\r\n\r\nwith Session(e.execution_options(schema_translate_map= {\"foo\": None})) as s:\r\n    s.add(A(bs=[B()]))\r\n    s.commit()\r\n\r\nwith Session(e) as s:\r\n\r\n    s.execute(\r\n        select(A).options(selectinload(A.bs)),\r\n        execution_options={\r\n            \"compiled_cache\": None,\r\n            \"schema_translate_map\": {\"foo\": None},\r\n        },\r\n    ).all()\r\n\r\n```","closed_by":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/10231/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/10231/timeline","performed_via_github_app":null,"state_reason":"completed"}