iki":false,"has_pages":false,"has_discussions":false,"forks_count":25807,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":5588,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["elasticsearch","java","search-engine"],"visibility":"public","forks":25807,"open_issues":5588,"watchers":76300,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/elastic/elasticsearch/pulls/10883","html_url":"https://github.com/elastic/elasticsearch/pull/10883","diff_url":"https://github.com/elastic/elasticsearch/pull/10883.diff","patch_url":"https://github.com/elastic/elasticsearch/pull/10883.patch","merged_at":"2015-04-29T16:10:21Z"},"body":"If you define exactly the same date range query using either `DATE+0200` notation or `DATE` and set `timezone: +0200`, elasticsearch gives back different results:\n\n```\nDELETE foo\nPUT /foo\n{\n  \"mapping\": {\n    \"tweets\": {\n      \"properties\": {\n        \"tweet_date\": {\n          \"type\": \"date\"\n        }\n      }\n    }\n  }\n}\n\nPOST /foo/tweets/1/\n{\n  \"tweet_date\": \"2015-04-05T23:00:00+0000\"\n}\nPOST /foo/tweets/2/\n{\n  \"tweet_date\": \"2015-04-06T00:00:00+0000\"\n}\n\nGET /foo/tweets/_search?pretty\n{\n    \"query\": {\n        \"query_string\": {\n            \"query\": \"tweet_date:[2015-04-06T00:00:00+0200 TO 2015-04-06T23:00:00+0200]\"\n        }\n    }\n}\nGET /foo/tweets/_search?pretty\n{\n    \"query\": {\n        \"query_string\": {\n            \"query\": \"tweet_date:[2015-04-06T00:00:00 TO 2015-04-06T23:00:00]\",\n            \"time_zone\": \"+0200\"\n        }\n    }\n}\n```\n\nThis PR fixes it and will also allow us to add the same feature to simple_query_string as well in another PR.\n\nCloses #10477.\n","reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/10883/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/elastic/elasticsearch/issues/10883/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":293161617,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDI5MzE2MTYxNw==","url":"https://api.github.com/repos/elastic/elasticsearch/issues/events/293161617","actor":{"login":"dadoonet","id":274222,"node_id":"MDQ6VXNlcjI3NDIyMg==","avatar_url":"https://avatars.githubusercontent.com/u/274222?v=4","gravatar_id":"","url":"https://api.github.com/users/dadoonet","html_url":"https://github.com/dadoonet","followers_url":"https://api.github.com/users/dadoonet/followers","following_url":"https://api.github.com/users/dadoonet/following{/other_user}","gists_url":"https://api.github.com/users/dadoonet/gists{/gist_id}","starred_url":"https://api.github.com/users/dadoonet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dadoonet/subscriptions","organizations_url":"https://api.github.com/users/dadoonet/orgs","repos_url":"https://api.github.com/users/dadoonet/repos","events_url":"https://api.github.com/users/dadoonet/events{/privacy}","received_events_url":"https://api.github.com/users/dadoonet/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"e88a646137f30600236efb84ded179e42df399ad","commit_url":"https://api.github.com/repos/elastic/elasticsearch/commits/e88a646137f30600236efb84ded179e42df399ad","created_at":"2015-04-29T16:10:20Z","performed_via_github_app":null},{"id":293161980,"node_id":"MDExOkNsb3NlZEV2ZW50MjkzMTYxOTgw","url":"https://api.github.com/repos/elastic/elasticsearch/issues/events/293161980","actor":{"login":"dadoonet","id":274222,"node_id":"MDQ6VXNlcjI3NDIyMg==","avatar_url":"https://avatars.githubuser