-// Copy of cheap integer to fixed-width decimal to ascii from logger.
-func itoa(buf *[]byte, i, wid int) {
-	var logger [20]byte
-	bp := len(logger) - 1
-	for i >= 10 || wid > 1 {
-		wid--
-		q := i / 10
-		logger[bp] = byte('0' + i - q*10)
-		bp--
-		i = q
-	}
-	// i < 10
-	logger[bp] = byte('0' + i)
-	*buf = append(*buf, logger[bp:]...)
-}
