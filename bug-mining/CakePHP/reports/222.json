User(1);\n        $user2 = $this->_getUser(2);\n        $this->assertEquals(1, $user1->get('post_count'));\n        $this->assertEquals(2, $user2->get('post_count'));\n```\n\nI'm working on a PR for this\n","closed_by":{"login":"antograssiot","id":4977112,"node_id":"MDQ6VXNlcjQ5NzcxMTI=","avatar_url":"https://avatars.githubusercontent.com/u/4977112?v=4","gravatar_id":"","url":"https://api.github.com/users/antograssiot","html_url":"https://github.com/antograssiot","followers_url":"https://api.github.com/users/antograssiot/followers","following_url":"https://api.github.com/users/antograssiot/following{/other_user}","gists_url":"https://api.github.com/users/antograssiot/gists{/gist_id}","starred_url":"https://api.github.com/users/antograssiot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/antograssiot/subscriptions","organizations_url":"https://api.github.com/users/antograssiot/orgs","repos_url":"https://api.github.com/users/antograssiot/repos","events_url":"https://api.github.com/users/antograssiot/events{/privacy}","received_events_url":"https://api.github.com/users/antograssiot/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/4797/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/cakephp/cakephp/issues/4797/timeline","performed_via_github_app":null,"state_reason":"completed"}