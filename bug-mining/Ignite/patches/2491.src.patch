+
+            // Invokes ClearTask with new class loader
+            cache.clear();
+
+            Thread.currentThread().setContextClassLoader(oldCl);
+
+            for (int i = 0; i < 10; i++)
+                cache.put(i, i % 2 == 0 ? EnumVal.VAL1 : EnumVal.VAL2);
+
+            for (int i = 0; i < 10; i++)
+                assert cache.containsKey(i);
+        }
+        finally {
+            stopAllGrids();
+        }
