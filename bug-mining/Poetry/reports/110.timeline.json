025-12-12T16:57:24Z","git_url":"git://github.com/python-poetry/poetry.git","ssh_url":"git@github.com:python-poetry/poetry.git","clone_url":"https://github.com/python-poetry/poetry.git","svn_url":"https://github.com/python-poetry/poetry","homepage":"https://python-poetry.org","size":23953,"stargazers_count":34109,"watchers_count":34109,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":2388,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":588,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["dependency-manager","package-manager","packaging","poetry","python"],"visibility":"public","forks":2388,"open_issues":588,"watchers":34109,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/python-poetry/poetry/pulls/4643","html_url":"https://github.com/python-poetry/poetry/pull/4643","diff_url":"https://github.com/python-poetry/poetry/pull/4643.diff","patch_url":"https://github.com/python-poetry/poetry/pull/4643.patch","merged_at":"2021-11-15T01:37:36Z"},"body":"Fixes: #2153\r\n\r\nWhen running `poetry update`, during the download phase when `PYTHONWARNINGS=\"default\"` environment variable is set, multiple different sessions trigger resource warnings. These are caused by leaving a session (aka not explicitly closing it) that uses keep alive behavior after a request has been issued. \r\n\r\n```\r\n/Users/username/Library/Application Support/pypoetry/venv/lib/python3.10/site-packages/poetry/installation/executor.py:594: ResourceWarning: unclosed <ssl.SSLSocket fd=5, family=AddressFamily.AF_INET, type=SocketKind.SOCK_STREAM, proto=0, laddr=('REDACTED', 59025), raddr=('140.108.3.33', 80)>\r\n```\r\n\r\nThis line references:\r\n```\r\n 593   │             try:\r\n 594   │                 archive = self._download_archive(operation, link)\r\n 595   │             except BaseException:\r\n 596   │                 cache_directory = self._chef.get_cache_directory_for_link(link)\r\n```\r\n\r\nThis also fixes:\r\n\r\n```\r\n/Users/username/Library/Application Support/pypoetry/venv/lib/python3.10/site-packages/poetry/repositories/pypi_repository.py:241: ResourceWarning: unclosed <ssl.SSLSocket fd=13, family=AddressFamily.AF_INET, type=SocketKind.SOCK_STREAM, proto=0, laddr=('REDACTED', 59721), raddr=('148.131.15.33', 80)>\r\n  json_data = self._get(\"pypi/{}/{}/json\".format(package.name, package.version))\r\nResourceWarning: Enable tracemalloc to get the object allocation traceback\r\n```\r\n\r\nThe issue is being caused because the session is being left open when the class is later cleaned up. By adding a destructor method, we can close the session if it exists, preventing this error.\r\n\r\n# Pull Request Check List\r\n\r\nI have not added tests or documentation as this should be covered more broadly already. It's unclear to me what specifically should be tested in this instance as it occurs specifically at the class destruction time. I don't think calling `__del__` directly is a proper test of what is being fixed, as it's related to the warnings generated at the time the class instance destruction occurs rather than simply verifying that the session is closable.\r\n\r\n- [ ] Added **tests** for changed code.\r\n- [ ] Updated **documentation** for changed code.\r\n\r\n<!-- If you have *any* questions to *any* of the points above, just **submit and ask**!  This checklist is here to *help* you, not to deter you from contributing! -->\r\n","reactions":{"url":"https://api.github.com/repos/python-poetry/poetry/issues/4643/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python-poetry/poetry/issues/4643/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":5468348634,"node_id":"REFE_lADOB1l16s4ibLY6zwAAAAFF8GDa","url":"https://api.github.com/repos/python-poetry/poetry/issues/events/5468348634","actor":{"login":"kkirsche","id":947110,"node_id":"MDQ6VXNlcjk0NzExMA==","avatar_url":"https://avatars.githubusercontent.com/u/947110?v=4","gravatar_id":"","url":"https://api.github.com/users/kkirsche","html_url":"https://github.com/kkirsche","followers_url":"https://api.github.com/users/kkirsche/followers","following_url":"https://api.github.com/users/kkirsche/following{/other_user}","gists_url":"https://api.github.com/users/kkirsche/gists{/gist_id}","starred_url":"https://api.github.com/users/kkirsche/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kkirsche/subscriptions","organizations_url":"https://api.github.com/users/kkirsche/orgs","repos_url":"https://api.github.com/users/kkirsche/repos","events_url":"https://api.github.com/users/kkirsche/events{/privacy}","received_events_url":"https://api.github.com/users/kkirsche/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"666c448c495cf1703e7a53260ec584856fbf6514","commit_url":"https://api.github.com/repos/kkirsche/poetry/commits/666c448c495cf1703e7a53260ec584856fbf6514","created_at":"2021-10-15T08:10:39Z","performed_via_github_app":null},{"id":5468380783,"node_id":"REFE_lADOB1l16s4ibLY6zwAAAAFF8N5v","url":"https://api.github.com/repos/python-poetry/poetry/issues/events/5468380783","actor":{"login":"kkirsche","id":947110,"node_id":"MDQ6VXNlcjk0NzExMA==","avatar_url":"https://avatars.githubusercontent.com/u/947110?v=4","gravatar_id":"","url":"https://api.github.com/users/kkirsche","html_url":"https://github.com/kkirsche","followers_url":"https://api.github.com/users/kkirsche/followers","following_url":"https://api.github.com/users/kkirsche/following{