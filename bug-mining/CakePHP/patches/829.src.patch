+    protected function digestHeader($data)
+    {
+        $data += [
+            'username' => 'mariano',
+            'realm' => 'localhost',
+            'opaque' => '123abc'
+        ];
+        $digest = <<<DIGEST
+Digest username="mariano",
+realm="{$data['realm']}",
+nonce="{$data['nonce']}",
+uri="{$data['uri']}",
+qop={$data['qop']},
+nc={$data['nc']},
+cnonce="{$data['cnonce']}",
+response="{$data['response']}",
+opaque="{$data['opaque']}"
+DIGEST;
+        return $digest;
