+        IOException ioExc = new IOException(npe);
+
+        IgniteException exc = new IgniteException(ioExc);
+
+        npe.initCause(exc);
+
+        assertEquals(npe, X.cause(exc, NullPointerException.class));
+
+        assertTrue(X.hasCause(exc, NullPointerException.class));
