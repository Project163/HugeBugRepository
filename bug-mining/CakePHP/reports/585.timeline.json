rn $this->Entry->find('all');\n    }\n}\nclass Entry extends AppModel {\n    public $sequence = 'entry_id_seq';\n}\n```\n\nPHP Warning: `Notice: Undefined offset: 1 in /lib/Cake/Model/Datasource/Database/Postgres.php on line 355`\n\n``` php\nlist($schema, $sequence) = explode('.', $sequence);\n```\n\n`$sequence` may not contain `'.'` in case:\n\nPostgres.php:275\n\n``` php\nif (isset($model->sequence)) {\n    $this->_sequenceMap[$table][$model->primaryKey] = $model->sequence;\n}\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/51289606/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"vietvq","id":3970604,"node_id":"MDQ6VXNlcjM5NzA2MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/3970604?v=4","gravatar_id":"","url":"https://api.github.com/users/vietvq","html_url":"https://github.com/vietvq","followers_url":"https://api.github.com/users/vietvq/followers","following_url":"https://api.github.com/users/vietvq/following{/other_user}","gists_url":"https://api.github.com/users/vietvq/gists{/gist_id}","starred_url":"https://api.github.com/users/vietvq/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vietvq/subscriptions","organizations_url":"https://api.github.com/users/vietvq/orgs","repos_url":"https://api.github.com/users/vietvq/repos","events_url":"https://api.github.com/users/vietvq/events{/privacy}","received_events_url":"https://api.github.com/users/vietvq/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/51672495","html_url":"https://github.com/cakephp/cakephp/issues/4168#issuecomment-51672495","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/4168","id":51672495,"node_id":"MDEyOklzc3VlQ29tbWVudDUxNjcyNDk1","user":{"login":"marksto