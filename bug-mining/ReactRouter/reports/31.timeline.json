in":false},"created_at":"2015-05-07T04:43:59Z","updated_at":"2015-05-07T04:52:19Z","body":"Yes, I noticed this as well.\n\n`router.replaceWith('something/?a=b')` will result in `something/a=b` **(INCORRECT)**, while `router.replaceWith('something?a=b')` will result in `something?a=b` **(CORRECT)**.\n\nBoth should technically be the same, but the trailing slash seems to mess it up currently.\n\n---\n\nA temporary hack is to remove the trailing slash in your code:\n\n``` js\n// var nextPath = '/something/?a=b';\nvar qLoc = nextPath.lastIndexOf('?');\nif (qLoc !== -1 && nextPath.charAt(qLoc - 1) === '/') {\n  nextPath = nextPath.slice(0, qLoc-1) + nextPath.slice(qLoc, nextPath.length);\n}\nrouter.replaceWith(nextPath); // or: router.transitionTo(nextPath);\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/remix-run/react-router/issues/comments/99714181/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"idolizesc","id":11580931,"node_id":"MDQ6VXNlcjExNTgwOTMx","avatar_url":"https://avatars.githubusercontent.com/u/11580931?v=4","gravatar_id":"","url":"https://api.github.com/users/idolizesc","html_url":"https://github.com/idolizesc","followers_url":"https://api.github.com/users/idolizesc/followers","following_url":"https://api.github.com/users/idolizesc/following{/other_user}","gists_url":"https://api.github.com/users/idolizesc/gists{/gist_id}","starred_url":"https://api.github.com/users/idolizesc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/idolizesc/subscriptions","organizations_url":"https://api.github.com/users/idolizesc/orgs","repos_url":"https://api.github.com/users/idolizesc/repos","events_url":"https://api.github.com/users/idolizesc/events{/privacy}","received_events_url":"https://api.github.com/users/idolizesc/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/remix-run/react-router/issues/comments/99722118","html_url":"https://github.com/remix-run/react-router/issues/1070#issuecomment-99722118","issue_url":"https://api.github.com/repos/remix-run/react-router/issues/1070","id":99722118,"node_id":"MDEyOklzc3VlQ29tbWVudDk5NzIyMTE4","user":{"login":"MrEfrem","id":3146234,"node_id":"MDQ6VXNlcjMxNDYyMzQ=","avatar_url":"https://avatars.githubusercontent.com/u/3146234?v=4","gravatar_id":"","url":"https://api.github.com/users/MrEfrem","html_url":"https://github.com/MrEfrem","followers_url":"https://api.github.com/users/MrEfrem/followers","following_url":"https://api.github.com/users/MrEfrem/following{/other_user}","gists_url":"https://api.github.com/users/MrEfrem/gists{/gist_id}","starred_url":"https://api.github.com/users/MrEfrem/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MrEfrem/subscriptions","organizations_url":"https://api.github.com/users/MrEfrem/orgs","repos_url":"https://api.github.com/users/MrEfrem/repos","events_url":"https://api.github.com/users/MrEfrem/events{/privacy}","received_events_url":"https://api.github.com/users/MrEfrem/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-05-07T05:20:25Z","updated_at":"2015-05-07T05:20:25Z","body":"You didn't understand. I intentionally add trailing slash. Because I need to proxy the requests beginning on http://my/test/ and with trailing slash.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/remix-run/react-router/issues/comments/99722118/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"MrEfrem","id":3146234,"node_id":"MDQ6VXNlcjMxNDYyMzQ=","avatar_url":"https://avatars.githubusercontent.com/u/3146234?v=4","gravatar_id":"","url":"https://api.github.com/users/MrEfrem","html_url":"https://github.com/Mr