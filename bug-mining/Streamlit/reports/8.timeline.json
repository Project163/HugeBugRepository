sh":false,"triage":false,"pull":true}},"body":"The `ignore_hash` argument in `@st.cache(ignore_hash=True)` is misnamed, since it does not ignore hashes in all places where `st.cache` uses them. See [this](https://github.com/streamlit/streamlit/issues/157#issuecomment-533831071) for more information.\r\n\r\nWe should rename `ignore_hash` to `allow_output_mutation` to make it clearer.\r\n\r\nAlso: to ease people's migration to the new name we should throw a nice error when users use the old `ignore_hash` kwarg. Something like:\r\n```\r\nThe `ignore_hash` argument has been renamed to `allow_output_mutation`.\r\n\r\n[traceback]\r\n```","reactions":{"url":"https://api.github.com/repos/streamlit/streamlit/issues/412/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/streamlit/streamlit/issues/412/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/streamlit/streamlit/issues/comments/542248040","html_url":"https://github.com/streamlit/streamlit/issues/359#issuecomment-542248040","issue_url":"https://api.github.com/repos/streamlit/streamlit/issues/359","id":542248040,"node_id":"MDEyOklzc3VlQ29tbWVudDU0MjI0ODA0MA==","user":{"login":"jrhone","id":699897,"node_id":"MDQ6VXNlcjY5OTg5Nw==","avatar_url":"https://avatars.githubusercontent.com/u/699897?v=4","gravatar_id":"","url":"https://api.github.com/users/jrhone","html_url":"https://github.com/jrhone","followers_url":"https://api.github.com/users/jrhone/followers","following_url":"https://api.github.com/users/jrhone/following{/other_user}","gists_url":"https://api.github.com/users/jrhone/gists{/gist_id}","starred_url":"https://api.github.com/users/jrhone/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jrhone/subscriptions","organizations_url":"https://api.github.com/users/jrhone/orgs","repos_url":"https://api.github.com/us