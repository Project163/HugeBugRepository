+def is_inside_lambda(node):
+    # type: (astroid.NodeNG) -> bool
+    """Return true if given node is inside lambda"""
+    parent = node.parent
+    while parent is not None:
+        if isinstance(parent, astroid.Lambda):
+            return True
+        parent = parent.parent
+    return False
+
