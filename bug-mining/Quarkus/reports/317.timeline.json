arkusio/quarkus/labels{/name}","releases_url":"https://api.github.com/repos/quarkusio/quarkus/releases{/id}","deployments_url":"https://api.github.com/repos/quarkusio/quarkus/deployments","created_at":"2018-07-06T00:44:20Z","updated_at":"2025-12-13T03:42:27Z","pushed_at":"2025-12-12T22:27:04Z","git_url":"git://github.com/quarkusio/quarkus.git","ssh_url":"git@github.com:quarkusio/quarkus.git","clone_url":"https://github.com/quarkusio/quarkus.git","svn_url":"https://github.com/quarkusio/quarkus","homepage":"https://quarkus.io","size":451357,"stargazers_count":15335,"watchers_count":15335,"language":"Java","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":3033,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":2724,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","hacktoberfest","java","kubernetes","reactive"],"visibility":"public","forks":3033,"open_issues":2724,"watchers":15335,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/quarkusio/quarkus/pulls/3521","html_url":"https://github.com/quarkusio/quarkus/pull/3521","diff_url":"https://github.com/quarkusio/quarkus/pull/3521.diff","patch_url":"https://github.com/quarkusio/quarkus/pull/3521.patch","merged_at":"2019-12-09T22:41:54Z"},"body":"Pull/Merge Request for Flyway Multi DataSource Support\r\nhttps://github.com/quarkusio/quarkus/issues/3449\r\n\r\nIt wasn't that as easy as i thought at first. I needed to make some choices. Of course, these are open for discussion:\r\n\r\n1.) Since Flyway makes only sense with a DataSource, i took the already existing DataSourceInitializedBuildItem from agroal and used it to get the detected datasource names as reference for the generated Flyway producer methods.\r\nThis enables Flyway for every datasource even without any flyway-specific configuration.\r\n\r\n2.) Like Agroal, i also introduced the qualifier annotation \"FlywayDataSource\" and the possibility\r\nto inject Flyway by name (datasource name + \"_flyway\").\r\n\r\n3.) As it is right now, injecting Flyway without configured DataSource leads to an\r\nUnsatisfiedResolutionException. This also applies to missing named DataSources.\r\n\r\nI will also provide a PR for the documentation when this PR is discussed and ready to merge.","reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/3521/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/quarkusio/quarkus/issues/3521/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":2799801101,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDI3OTk4MDExMDE=","url":"https://api.github.com/repos/quarkusio/quarkus/issues/events/2799801101","actor":{"login":"gsmet","id":1279749,"node_id":"MDQ6VXNlcjEyNzk3NDk=","avatar_url":"https://avatars.githubusercontent.com/u/1279749?v=4","gravatar_id":"","url":"https://api.github.com/users/gsmet","html_url":"https://github.com/gsmet","followers_url":"https://api.github.com/users/gsmet/followers","following_url":"https://api.github.com/users/gsmet/following{/other_user}","gists_url":"https://api.github.com/users/gsmet/gists{/gist_id}","starred_url":"https://api.github.com/users/gsmet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gsmet/subscriptions","organizations_url":"https://api.github.com/users/gsmet/orgs","repos_url":"https://api.github.com/users/gsmet/repos","events_url":"https://api.github.com/users/gsmet/events{/privacy}","received_events_url":"https://api.github.com/users/gsmet/received_events","type":"User",