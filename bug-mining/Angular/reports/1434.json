chitect         0.8.9\r\n@angular-devkit/build-angular     0.8.9\r\n@angular-devkit/build-optimizer   0.8.9\r\n@angular-devkit/build-webpack     0.8.9\r\n@angular-devkit/core              0.8.9\r\n@angular-devkit/schematics        0.8.9\r\n@angular/cdk                      6.4.7\r\n@angular/cli                      6.2.9\r\n@angular/language-service         7.2.15\r\n@ngtools/webpack                  6.2.9\r\n@schematics/angular               0.8.9\r\n@schematics/update                0.8.9\r\nrxjs                              6.2.2\r\ntypescript                        2.9.2\r\nwebpack                           4.16.4\r\n</code></pre>\r\n\r\n**Anything else relevant?**\r\nNo","closed_by":{"login":"jessicajaniuk","id":72768744,"node_id":"MDQ6VXNlcjcyNzY4NzQ0","avatar_url":"https://avatars.githubusercontent.com/u/72768744?v=4","gravatar_id":"","url":"https://api.github.com/users/jessicajaniuk","html_url":"https://github.com/jessicajaniuk","followers_url":"https://api.github.com/users/jessicajaniuk/followers","following_url":"https://api.github.com/users/jessicajaniuk/following{/other_user}","gists_url":"https://api.github.com/users/jessicajaniuk/gists{/gist_id}","starred_url":"https://api.github.com/users/jessicajaniuk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jessicajaniuk/subscriptions","organizations_url":"https://api.github.com/users/jessicajaniuk/orgs","repos_url":"https://api.github.com/users/jessicajaniuk/repos","events_url":"https://api.github.com/users/jessicajaniuk/events{/privacy}","received_events_url":"https://api.github.com/users/jessicajaniuk/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/34818/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/angular/angular/issues/34818/timeline","performed_via_github_app":null,"state_re