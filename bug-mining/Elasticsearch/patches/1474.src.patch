+            @Override
+            public void onResponse(Void v) {
+                listener.onResponse(new ChangePasswordResponse());
+            }
+
+            @Override
+            public void onFailure(Throwable e) {
+                listener.onFailure(e);
+            }
+        });
+    }
+}
