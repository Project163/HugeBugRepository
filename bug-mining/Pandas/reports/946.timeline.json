_s, s1])\r\nprint('Using empty series')\r\nprint(s2)\r\n\r\n#Create a empty Series with name and index\r\nempty_s = pd.Series(name='beta', index=pd.Index([], name='alpha'))\r\ns1 = pd.Series(['a', 'b'], name='beta', index=pd.Index(['X', 'Y'], name='alpha'))\r\ns2 = pd.concat([empty_s, s1])\r\nprint('Using empty series with index and name defined')\r\nprint(s2)\r\n\r\npd.show_versions()\r\n\r\n\r\n```\r\n#### Problem description\r\nThe code pasted intend to probe the what if an empty series is concated with a series fully defined\r\nTo get the expected result:\r\nSame series with name expected name and index.\r\n![image](https://user-images.githubusercontent.com/20059518/50913462-08afc700-13fa-11e9-8f99-8e22019ef149.png)\r\n\r\nat pandas 0.17 it works as expected but when it ran at pandas 0.18 and so on it drops expected name and index.\r\n\r\nit only works that empty series with forced name and index as the following snapshot shows.\r\n\r\n![image](https://user-images.githubusercontent.com/20059518/50913357-d2724780-13f9-11e9-8ad4-7057c0ef5781.png)\r\n\r\n\r\nSame result with pandas 0.23.4\r\n![image](https://user-images.githubusercontent.com/20059518/50917569-744a6200-1403-11e9-9e83-6a3d09fc2f8a.png)\r\n","reactions":{"url":"https://api.github.com/repos/pandas-dev/pandas/issues/24685/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/pandas-dev/pandas/issues/24685/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]