+            ? extends QueryTestValue>> evts) {
+            for (CacheEntryEvent<? extends QueryTestKey, ? extends QueryTestValue> e : evts) {
+                queue.add((CacheEntryEvent<QueryTestKey, QueryTestValue>)e);
