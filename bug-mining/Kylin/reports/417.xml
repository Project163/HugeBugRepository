<item>
            <title>[KYLIN-6029] The password reset tool does not work in Kylin5</title>
                <link>https://issues.apache.org/jira/browse/KYLIN-6029</link>
                <project id="12316121" key="KYLIN">Kylin</project>
                    <description>&lt;p&gt;Executing `$KYLIN_HOME/bin/admin-tool.sh admin-password-reset` shows a success message, but the password is not actually reset.&lt;/p&gt;</description>
                <environment></environment>
