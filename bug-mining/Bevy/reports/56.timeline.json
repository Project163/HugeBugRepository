thub.com/users/BorisBoutillier/following{/other_user}","gists_url":"https://api.github.com/users/BorisBoutillier/gists{/gist_id}","starred_url":"https://api.github.com/users/BorisBoutillier/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BorisBoutillier/subscriptions","organizations_url":"https://api.github.com/users/BorisBoutillier/orgs","repos_url":"https://api.github.com/users/BorisBoutillier/repos","events_url":"https://api.github.com/users/BorisBoutillier/events{/privacy}","received_events_url":"https://api.github.com/users/BorisBoutillier/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-11-09T17:20:43Z","updated_at":"2020-11-09T17:20:43Z","body":"No sure how to fix that.\r\n\r\nIn the asset_server, I don't think we can have access to the Events<Assets<T>> to check for already planed for removal assets and trigger a 'force'.\r\nIn the Assets<T> , when handling the Removed event, we don't have access to the ref_counts to double check the Handle is still ref_count 0.\r\n\r\nIf somebody can give me the appropriate direction to handle this issue, I am eager to try to  implement it.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/724154568/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"BorisBoutillier","id":18518188,"node_id":"MDQ6VXNlcjE4NTE4MTg4","avatar_url":"https://avatars.githubusercontent.com/u/18518188?v=4","gravatar_id":"","url":"https://api.github.com/users/BorisBoutillier","html_url":"https://github.com/BorisBoutillier","followers_url":"https://api.github.com/users/BorisBoutillier/followers","following_url":"https://api.github.com/users/BorisBoutillier/following{/other_user}","gists_url":"https://api.github.com/users/BorisBoutillier/gists{/gist_id}","starred_url":"https://api.github.com/users/BorisBoutillier/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BorisBoutillier/subscriptions","organizations_url":"https://api.github.com/users/BorisBoutillier/orgs","repos_url":"https://api.github.com/users/BorisBoutillier/repos","events_url":"https://api.github.com/users/BorisBoutillier/events{/privacy}","received_events_url":"https://api.github.com/users/BorisBoutillier/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":3975444145,"node_id":"MDEyOkxhYmVsZWRFdmVudDM5NzU0NDQxNDU=","url":"https://api.github.com/repos/bevyengine/bevy/issues/events/3975444145","actor":{"login":"Moxinilian","id":30992420,"node_id":"MDQ6VXNlcjMwOTkyNDIw","avatar_url":"https://avatars.githubusercontent.com/u/30992420?v=4","gravatar_id":"","url":"https://api.github.com/users/Moxinilian","html_url":"https://github.com/Moxinilian","followers_url":"https://api.github.com/users/Moxinilian/followers","following_url":"https://api.github.com/users/Moxinilian/following{/other_user}","gists_url":"https://api.github.com/users/Moxinilian/gists{/gist_id}","starred_url":"https://api.github.com/users/Moxinilian/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Moxinilian/subscriptions","organizations_url":"https://api.github.com/users/Moxinilian/orgs","repos_url":"https://api.github.com/users/Moxinilian/repos","events_url":"https://api.github.com/users/Moxinilian/events{/privacy}","received_events_url":"https://api.github.com/users/Moxinilian/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2020-11-09T19:30:16Z","label":{"name":"assets","color":"f9ccff"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/726374852","html_url":"https://github.com/bevyengine/bevy/issues/824#issuecomment-726374852","issue_url":"https://api.github.com/repos/bevyengine/bevy/issues/824","id":726374852,"node_id":"MDEyOklzc3VlQ29tbWVudDcyNjM3NDg1Mg==","user":{"login":"memoryruins","id":6868531,"node_id":"MDQ6VXNlcjY4Njg1MzE=","avatar_url":"https://avatars.githubusercontent.com/u/6868531?v=4","gravatar_id":"","url":"https://api.github.com/users/memoryruins","html_url":"https://github.com/memoryruins","followers_url":"https://api.github.com/users/memoryruins/followers","following_url":"https://api.github.com/users/memoryruins/following{/other_user}","gists_url":"https://api.github.com/users/memoryruins/gists{/gist_id}","starred_url":"https://api.github.com/users/memoryruins/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/memoryruins/subscriptions","organizations_url":"https://api.github.com/users/memoryruins/orgs","repos_url":"https://api.github.com/users/memoryruins/repos","events_url":"https://api.github.com/users/memoryruins/events{/privacy}","received_events_url":"https://api.github.com/users/memoryruins/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-11-12T22:20:55Z","updated_at":"2020-11-12T22:29:51Z","body":"Thanks for reporting! Perhaps its worth making a branch on Kataster specific to this issue so that it preserves the behavior you ran into. I'll mention the most recent commit for posterity: https://github.com/Bobox214/Kataster/commit/98bafc306848c13cce592970439501afc4ad4013\r\n\r\n---\r\n\r\nSomething that could avoid this behavior in Kataster today is storing a strong handle to the font in a longer living resource. Since the UI is always using the same font, the resource can be re-used in all the systems that need it. This would avoid loading the asset more than once, and would allow weak handles to be used by all UI elements if it's never removed.\r\n\r\n<details>\r\n\r\n<summary>example</summary>\r\n\r\n\r\n```rust\r\n\r\nfn main() {\r\n    App::build()\r\n        .add_plugins(DefaultPlugins)\r\n        .init_resource::<GameFonts>()\r\n        .add_system(system.system())\r\n        .run()\r\n}\r\n\r\nstruct GameFonts {\r\n    primary: Handle<Font>,\r\n}\r\n\r\nimpl FromResources for GameFonts {\r\n    fn from_resources(resources: &Resources) -> Self {\r\n        let assets = resources.get::<AssetServer>().unwrap();\r\n        GameFonts { primary: assets.load(\"kenvector_future.ttf\") }\r\n    }\r\n}\r\n\r\nfn system(game_fonts: Res<GameFonts>) {\r\n    // ... game_fonts.primary.clone() ...\r\n    // ... game_fonts.primary.clone_weak() ...\r\n}\r\n```\r\n\r\n</details>","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/726374852/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"memoryruins","id":6868531,"node_id":"MDQ6VXNlcjY4Njg1MzE=","avatar_url":"https://avatars.githubusercontent.com/u/6868531?v=4","gravatar_id":"","url":"https://api.github.com/users/memoryruins","html_url":"https://github.com/memoryruins","followers_url":"https://api.github.com/users/memoryruins/followers","following_url":"https://api.github.com/users/memoryruins/following{/other_user}","gists_url":"https://api.github.com/users/memoryruins/gists{/gist_id}","starred_url":"https://api.github.com/users/memoryruins/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/memoryruins/subscriptions","organizations_url":"https://api.github.com/users/memoryruins/orgs","repos_url":"https://api.github.com/users/memoryruins/repos","events_url":"https://api.github.com/users/memoryruins/events{/privacy}","received_events_url":"https://api.github.com/users/memoryruins/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/727181115","html_url":"https://github.com/bevyengine/bevy/issues/824#issuecomment-727181115","issue_url":"https://api.github.com/repos/bevyengine/bevy/issues/824","id":727181115,"node_id":"MDEyOklzc3VlQ29tbWVudDcyNzE4MTExNQ==","user":{"login":"BorisBoutillier","id":18518188,"node_id":"MDQ6VXNlcjE4NTE4MTg4","avatar_url":"https://avatars.githubusercontent.com/u/18518188?v=4","gravatar_id":"","url":"https://api.github.com/users/BorisBoutillier","html_url":"https://github.com/BorisBoutillier","followers_url":"https://api.github.com/users/BorisBoutillier/followers","following_url":"https://api.github.com/users/BorisBoutillier/following{/other_user}","gists_url":"https://api.github.com/users/BorisBoutillier/gists{/gist_id}","starred_url":"https://api.github.com/users/BorisBoutillier/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BorisBoutillier/subscriptions","organizations_url":"https://api.github.com/users/BorisBoutillier/orgs","repos_url":"https://api.github.com/users/BorisBoutillier/repos","events_url":"https://api.github.com/users/BorisBoutillier/events{/privacy}","received_events_url":"https://api.github.com/users/BorisBoutillier/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-11-14T10:13:23Z","updated_at":"2020-11-14T10:13:23Z","body":"Good idea effectively, I have created the following branch that allow to reproduce the described issue :\r\nhttps://github.com/Bobox214/Kataster/tree/bevy_issue_824\r\n\r\nEffectively, Kataster does not try to optimize assets handles, like for the laser sprite I re-get the handle from the path each new entity creation ....\r\nI probably should do it as multiple people are taking this project as a starting point, so better provide a good one :)\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/727181115/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"BorisBoutillier","id":18518188,"node_id":"MDQ6VXNlcjE4NTE4MTg4","avatar_url"