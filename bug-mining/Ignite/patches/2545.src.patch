+
+        /** {@inheritDoc} */
+        @Override public void registerCache(String cacheName, String schemaName,
+            GridCacheContext<?, ?> cctx) throws IgniteCheckedException {
+            if (FAILED_CACHES.contains(cctx.name()) && cctx.kernalContext().clientNode())
