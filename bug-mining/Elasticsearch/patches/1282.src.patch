+                "  cluster: all\n" +
+                "  indices:\n" +
+                "    test:\n" +
+                "      privileges: ALL\n" +
+                "      fields:\n" +
+                "        - field1\n" +
+                "role3:\n" +
+                "  cluster: all\n" +
+                "  indices:\n" +
+                "    test:\n" +
+                "      privileges: ALL\n" +
+                "      fields:\n" +
