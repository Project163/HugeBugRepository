s/curl/curl/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/curl/curl/downloads","issues_url":"https://api.github.com/repos/curl/curl/issues{/number}","pulls_url":"https://api.github.com/repos/curl/curl/pulls{/number}","milestones_url":"https://api.github.com/repos/curl/curl/milestones{/number}","notifications_url":"https://api.github.com/repos/curl/curl/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/curl/curl/labels{/name}","releases_url":"https://api.github.com/repos/curl/curl/releases{/id}","deployments_url":"https://api.github.com/repos/curl/curl/deployments","created_at":"2010-03-18T22:32:22Z","updated_at":"2025-12-12T23:57:49Z","pushed_at":"2025-12-12T23:57:45Z","git_url":"git://github.com/curl/curl.git","ssh_url":"git@github.com:curl/curl.git","clone_url":"https://github.com/curl/curl.git","svn_url":"https://github.com/curl/curl","homepage":"https://curl.se/","size":124054,"stargazers_count":40144,"watchers_count":40144,"language":"C","has_issues":true,"has_projects":false,"has_downloads":false,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":6982,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":25,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["c","client","curl","ftp","gopher","hacktoberfest","http","https","imaps","ldap","libcurl","library","mqtt","pop3","scp","sftp","transfer-data","transferring-data","user-agent","websocket"],"visibility":"public","forks":6982,"open_issues":25,"watchers":40144,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"### I did this\r\n\r\nTest case 2043:\r\n`curl --ssl-no-revoke https://revoked.grc.com/`\r\nresults in a read access violation with the following call stack because `conn->data` is null:\r\n```\r\nCurl_ssl_sessionid_lock(connectdata * conn=[nonnull])\r\nCurl_schannel_shutdown(connectdata * conn=[nonnull], int sockindex=0)\r\nCurl_ssl_shutdown(connectdata * conn=[nonnull], int sockindex=0)\r\nCurl_schannel_close(connectdata * conn=[nonnull], int sockindex=0)\r\nCurl_ssl_close(connectdata * conn=[nonnull], int sockindex=0)\r\nCurl_disconnect(Curl_easy * data=[nonnull], connectdata * conn=[nonnull], bool dead_connection=false)\r\nCurl_conncache_close_all_connections(conncache * connc=[nonnull])\r\ncurl_multi_cleanup(Curl_multi * multi=[nonnull])\r\nCurl_close(Curl_easy * data=[nonnull])\r\ncurl_easy_cleanup(Curl_easy * data=[nonnull])\r\nmain_free(GlobalConfig * config=[nonnull])\r\nmain(int argc=[...], char * * argv=[nonnull])\r\n```\r\n\r\nIt's set to `NULL` when `Curl_disconnect` calls `Curl_conncache_remove_conn` as `conn->bundle` is nonnull.\r\n\r\n### I expected the following\r\n\r\nNo crash.\r\n\r\n### curl/libcurl version\r\n\r\nhttps://github.com/curl/curl/commit/6d13432bfa1097da7efb4a5fffac27a22af2002c\r\n```\r\ncurl 7.61.1-DEV (Windows) libcurl/7.61.1-DEV WinSSL\r\nRelease-Date: [unreleased]\r\nProtocols: http https\r\nFeatures: AsynchDNS IPv6 Largefile SSPI Kerberos SPNEGO NTLM SSL\r\n```\r\n\r\n### operating system\r\n\r\nWindows 10","reactions":{"url":"https://api.github.com/repos/curl/curl/issues/2777/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/curl/curl/issues/2777/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":1746540005,"node_id":"MDExOkNsb3NlZEV2ZW50MTc0NjU0MDAwNQ==","url":"https://api.github.com/repos/curl/curl/issues/events/1746540005","actor":{"login":"bagder","id":177011,"node_id":"MDQ6VXNlcjE3NzAxMQ==","avatar_url":"https://avatars.githubusercontent.com/u/177011?v=4","gravatar_id":"","url":"https://api.github.com/users/bagder","html_url":"https://github.com/bagder","followers_url