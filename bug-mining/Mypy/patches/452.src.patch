+static void CPy_CatchError(PyObject **p_type, PyObject **p_value, PyObject **p_traceback) {
+    PyErr_Fetch(p_type, p_value, p_traceback);
+    // SetExcInfo steals references, so incref them
+    Py_XINCREF(*p_type);
+    Py_XINCREF(*p_value);
+    Py_XINCREF(*p_traceback);
