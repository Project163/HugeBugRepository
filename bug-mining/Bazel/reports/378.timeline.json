:"https://api.github.com/users/damienmg/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2017-05-08T12:34:54Z","label":{"name":"P1","color":"d93f0b"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/300107099","html_url":"https://github.com/bazelbuild/bazel/issues/2969#issuecomment-300107099","issue_url":"https://api.github.com/repos/bazelbuild/bazel/issues/2969","id":300107099,"node_id":"MDEyOklzc3VlQ29tbWVudDMwMDEwNzA5OQ==","user":{"login":"damienmg","id":3721087,"node_id":"MDQ6VXNlcjM3MjEwODc=","avatar_url":"https://avatars.githubusercontent.com/u/3721087?v=4","gravatar_id":"","url":"https://api.github.com/users/damienmg","html_url":"https://github.com/damienmg","followers_url":"https://api.github.com/users/damienmg/followers","following_url":"https://api.github.com/users/damienmg/following{/other_user}","gists_url":"https://api.github.com/users/damienmg/gists{/gist_id}","starred_url":"https://api.github.com/users/damienmg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/damienmg/subscriptions","organizations_url":"https://api.github.com/users/damienmg/orgs","repos_url":"https://api.github.com/users/damienmg/repos","events_url":"https://api.github.com/users/damienmg/events{/privacy}","received_events_url":"https://api.github.com/users/damienmg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-05-09T09:13:04Z","updated_at":"2017-05-09T09:13:16Z","body":"Discussion with @philwo about what to do (TL;DR: we are going to name it -jdk7 and if we are not happy modify the naming scheme further):\r\n\r\n@philwo \r\nI don't care much, I guess we could see it as there being three variants \"with-jdk\", \"without-jdk\" and \"jdk7\"?\r\nBut at first I thought it was confusing, because if it's not called \"without-jdk\", then it might look like we're bundling a jdk7?\r\n\r\n@damienmg\r\nYes the current list is weird\r\n\r\n@philwo \r\nI'll just LGTM the CL and we can look at the generated files for the next RC and see if they're fine\r\n\r\n@damienmg\r\nhttps://releases.bazel.build/0.5/rc3/index.html --> bazel-0.5rc3-jdk7-without-jdk-installer-darwin-x86_64.sh\r\nThat's the only one\r\nsince we are going to maintain that code for just one release I believe we should just keep the same name for the JDK7 variant that we were using\r\n\r\n@philwo\r\nAh, yes. Good point.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/300107099/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"damienmg","id":3721087,"node_id":"MDQ6VXNlcjM3MjEwODc=","avatar_url":"https://avatars.githubusercontent.com/u/3721087?v=4","gravatar_id":"","url":"https://api.github.com/users/damienmg","html_url":"https://github.com/damienmg","followers_url":"https://api.github.com/users/damienmg/followers","following_url":"https://api.github.com/users/damienmg/following{/other_user}","gists_url":"https://api.github.com/users/damienmg/gists{/gist_id}","starred_url":"https://api.github.com/users/damienmg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/damienmg/subscriptions","organizations_url":"https://api.github.com/users/damienmg/orgs","repos_url":"https://api.github.com/users/damienmg/repos","events_url":"https://api.github.com/users/damienmg/events{/privacy}","received_events_url":"https://api.github.com/users/damienmg/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1074216701,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50MTA3NDIxNjcwMQ==","url":"https://api.github.com/repos/bazelbuild/bazel/issues/events/1074216701","actor":{"login":"philwo","id":504652,"node_id":"MDQ6VXNlcjUwNDY1Mg==","avatar_url":"https://avatars.github