es"}],"state":"closed","locked":false,"assignee":{"login":"ttyusupov","id":903044,"node_id":"MDQ6VXNlcjkwMzA0NA==","avatar_url":"https://avatars.githubusercontent.com/u/903044?v=4","gravatar_id":"","url":"https://api.github.com/users/ttyusupov","html_url":"https://github.com/ttyusupov","followers_url":"https://api.github.com/users/ttyusupov/followers","following_url":"https://api.github.com/users/ttyusupov/following{/other_user}","gists_url":"https://api.github.com/users/ttyusupov/gists{/gist_id}","starred_url":"https://api.github.com/users/ttyusupov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ttyusupov/subscriptions","organizations_url":"https://api.github.com/users/ttyusupov/orgs","repos_url":"https://api.github.com/users/ttyusupov/repos","events_url":"https://api.github.com/users/ttyusupov/events{/privacy}","received_events_url":"https://api.github.com/users/ttyusupov/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"ttyusupov","id":903044,"node_id":"MDQ6VXNlcjkwMzA0NA==","avatar_url":"https://avatars.githubusercontent.com/u/903044?v=4","gravatar_id":"","url":"https://api.github.com/users/ttyusupov","html_url":"https://github.com/ttyusupov","followers_url":"https://api.github.com/users/ttyusupov/followers","following_url":"https://api.github.com/users/ttyusupov/following{/other_user}","gists_url":"https://api.github.com/users/ttyusupov/gists{/gist_id}","starred_url":"https://api.github.com/users/ttyusupov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ttyusupov/subscriptions","organizations_url":"https://api.github.com/users/ttyusupov/orgs","repos_url":"https://api.github.com/users/ttyusupov/repos","events_url":"https://api.github.com/users/ttyusupov/events{/privacy}","received_events_url":"https://api.github.com/users/ttyusupov/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":1,"created_at":"2019-10-10T13:12:42Z","updated_at":"2019-12-19T23:31:42Z","closed_at":"2019-12-19T23:31:42Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"It can happen that inbound RPC request is not fitting application-level RPC read buffer and BinaryCallParser is unable to increase read buffer because of mem tracker memory limits.\r\n```\r\nW0918 16:47:11.144232 23664 binary_call_parser.cc:72] Unable to allocate read buffer because of limit, required: 25101547, blocked by: 0x0000000002162010 -> root, consumption: 6658375803 of 665843118.\r\n```\r\nSince application-level read buffer is full `TcpStream::Receive` is not able to proceed with reading data from TCP level RECV queue, so RECV queue becomes full and sending from the client is also blocked.\r\n","closed_by":{"login":"ttyusupov","id":903044,"node_id":"MDQ6VXNlcjkwMzA0NA==","avatar_url":"https://avatars.githubusercontent.com/u/903044?v=4","gravatar_id":"","url":"https://api.github.com/users/ttyusupov","html_url":"https://github.com/ttyusupov","followers_url":"https://api.github.com/users/ttyusupov/followers","following_url":"https://api.github.com/users/ttyusupov/following{/other_user}","gists_url":"https://api.github.com/users/ttyusupov/gists{/gist_id}","starred_url":"https://api.github.com/users/ttyusupov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ttyusupov/subscriptions","organizations_url":"https://api.github.com/users/ttyusupov/orgs","repos_url":"https://api.github.com/users/ttyusupov/repos","events_url":"https://api.github.com/users/ttyusupov/events{/privacy}","received_events_url":"https://api.github.com/users/ttyusupov/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/2562/reactions","total_c