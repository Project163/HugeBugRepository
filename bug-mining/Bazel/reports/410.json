":"https://api.github.com/repos/bazelbuild/bazel/labels/P3","name":"P3","color":"fbca04","default":false,"description":"We're not considering working on this, but happy to review a PR. (No assignee)"}],"state":"closed","locked":false,"assignee":{"login":"katre","id":326527,"node_id":"MDQ6VXNlcjMyNjUyNw==","avatar_url":"https://avatars.githubusercontent.com/u/326527?v=4","gravatar_id":"","url":"https://api.github.com/users/katre","html_url":"https://github.com/katre","followers_url":"https://api.github.com/users/katre/followers","following_url":"https://api.github.com/users/katre/following{/other_user}","gists_url":"https://api.github.com/users/katre/gists{/gist_id}","starred_url":"https://api.github.com/users/katre/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/katre/subscriptions","organizations_url":"https://api.github.com/users/katre/orgs","repos_url":"https://api.github.com/users/katre/repos","events_url":"https://api.github.com/users/katre/events{/privacy}","received_events_url":"https://api.github.com/users/katre/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"katre","id":326527,"node_id":"MDQ6VXNlcjMyNjUyNw==","avatar_url":"https://avatars.githubusercontent.com/u/326527?v=4","gravatar_id":"","url":"https://api.github.com/users/katre","html_url":"https://github.com/katre","followers_url":"https://api.github.com/users/katre/followers","following_url":"https://api.github.com/users/katre/following{/other_user}","gists_url":"https://api.github.com/users/katre/gists{/gist_id}","starred_url":"https://api.github.com/users/katre/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/katre/subscriptions","organizations_url":"https://api.github.com/users/katre/orgs","repos_url":"https://api.github.com/users/katre/repos","events_url":"https://api.github.com/users/katre/events{/privacy}","received_events_url":"https://api.github.com/users/katre/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":5,"created_at":"2017-04-12T12:23:29Z","updated_at":"2018-01-24T09:23:59Z","closed_at":"2018-01-24T09:23:59Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"While investigating removing protobuf weirdness, @buchgr fall under a very strange situation.\r\n\r\nAccording to a change by @katre, any local_repository defined under the workspace should not be seen as a package in the main repository. So `bazel query //third_party/protobuf/...` should not see anything under 3.0.0: https://github.com/bazelbuild/bazel/blob/master/WORKSPACE#L53 (we actually change this line with a local_repository to test):\r\n\r\n```\r\n[dmarting@trantor git bazel (master)] $ bazel query third_party/protobuf/...\r\n...................\r\n//third_party/protobuf/3.0.0:protobuf_python_genproto\r\n//third_party/protobuf:srcs\r\n//third_party/protobuf/3.0.0:srcs\r\n//third_party/protobuf:protoc_lib\r\n//third_party/protobuf:protoc\r\n//third_party/protobuf/3.0.0:protoc\r\n//third_party/protobuf/3.0.0:protoc_lib\r\n//third_party/protobuf:protobuf_python\r\n//third_party/protobuf/3.0.0:protobuf_python\r\n//third_party/protobuf/3.0.0:protobuf_python_srcs\r\n//third_party/protobuf:protobuf_java_util\r\n//third_party/protobuf/3.0.0:protobuf_java_util\r\n//third_party/protobuf:protobuf_java\r\n//third_party/protobuf/3.0.0:protobuf_java\r\n//third_party/protobuf:protobuf-jars\r\n//third_party/protobuf/3.0.0:protobuf-jars\r\n//third_party/protobuf:protobuf\r\n//third_party/protobuf:java_toolchain\r\n//third_party/protobuf/3.0.0:java_toolchain\r\n//third_party/protobuf/3.0.0:protobuf\r\n//third_party/protobuf/3.0.0:protobuf_lite\r\n//third_party/protobuf/3.0.0:freebsd\r\n[dmarting@trantor git bazel (master)] $ git diff\r\ndiff --git a/WORKSPACE b/WORKSPACE\r\nindex 0f215c8a3..49c164ae6 100644\r\n--- a/WORKSPACE\r\n+++ b/WORKSPACE\r\n@@ -50,10 +50,9 @@ docker_repository()\r\n # This allows rules written in skylark to locate apple build tools.\r\n bind(name = \"xcrunwrapper\", actual = \"@bazel_tools//tools/objc:xcrunwrapper\")\r\n \r\n-new_local_repository(\r\n+local_repository(\r\n     name = \"com_google_protobuf\",\r\n     path = \"./third_party/protobuf/3.0.0/\",\r\n-    build_file = \"./third_party/protobuf/3.0.0/BUILD\",\r\n )\r\n \r\n new_local_repository(\r\n```\r\n\r\n@katre: any idea why we see those in query?","closed_by":{"login":"katre","id":326527,"node_id":"MDQ6VXNlcjMyNjUyNw==","avatar_url":"https://avatars.githubusercontent.com/u/326527?v=4","gravatar_id":"","url":"https://api.github.com/users/katre","html_url":"https://github.com/katre","followers_url":"https://api.github.com/users/katre/followers","following_url":"https://api.github.com/users/katre/following{/other_user}","gists_url":"https://api.github.com/users/katre/gists{/gist_id}","starred_url":"https://api.github.com/users/katre/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/katre/subscriptions","organizations_url":"https://api.github.com/users/katre/orgs","repos_url":"https://api.github.com/users/katre/repos","events_url":"https://api.github.com/users/katre/events{/privacy}","received_events_url":"https://api.github.com/users/katre/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/2811/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bazelbuild/bazel/issues/2811/timeline","performed_via_github_app":null,"state_reason":"completed"}