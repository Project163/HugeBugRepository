thub.com/users/dereuromark/subscriptions","organizations_url":"https://api.github.com/users/dereuromark/orgs","repos_url":"https://api.github.com/users/dereuromark/repos","events_url":"https://api.github.com/users/dereuromark/events{/privacy}","received_events_url":"https://api.github.com/users/dereuromark/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"milestoned","commit_id":null,"commit_url":null,"created_at":"2025-04-03T15:21:12Z","milestone":{"title":"5.2.1"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/2777241991","html_url":"https://github.com/cakephp/cakephp/issues/18274#issuecomment-2777241991","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/18274","id":2777241991,"node_id":"IC_kwDOAAoEbs6liVmH","user":{"login":"dereuromark","id":39854,"node_id":"MDQ6VXNlcjM5ODU0","avatar_url":"https://avatars.githubusercontent.com/u/39854?v=4","gravatar_id":"","url":"https://api.github.com/users/dereuromark","html_url":"https://github.com/dereuromark","followers_url":"https://api.github.com/users/dereuromark/followers","following_url":"https://api.github.com/users/dereuromark/following{/other_user}","gists_url":"https://api.github.com/users/dereuromark/gists{/gist_id}","starred_url":"https://api.github.com/users/dereuromark/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dereuromark/subscriptions","organizations_url":"https://api.github.com/users/dereuromark/orgs","repos_url":"https://api.github.com/users/dereuromark/repos","events_url":"https://api.github.com/users/dereuromark/events{/privacy}","received_events_url":"https://api.github.com/users/dereuromark/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-04T00:03:10Z","updated_at":"2025-04-04T01:06:21Z","body":"Actually, using the documented approach\n```php\n$countExpression = new QueryExpression('count = count + ' . $count);\n$this->updateAll([$countExpression], ['id' => $id]);\n```\ndoes not help eiter, as the key here is not assoc but numerically indexed, so it would break either way with the new changes.\n\nI tracked it down to\nhttps://github.com/cakephp/cakephp/pull/18218\npossibly being partially responsible for the regression here.\n\n[\n  (int) 0 => object(Cake\\Database\\Expression\\QueryExpression)\n]\n\nis whats going in, but even if you add\n\n    && !isset($key[0])\n\nit would later fail for the array part in general.\n\nIt seems to be fixable with\n\n    $this->updateAll(['count' => $countExpression], ['id' => $id]);\n\nbut thats also not how it is documented in the cookbook:\nhttps://book.cakephp.org/5/en/orm/saving-data.html#bulk-updates\nand how it so far worked.\n\nAnd using assoc here seems also not really valid in all DBs: https://github.com/dereuromark/CakePHP-DatabaseLog/actions/runs/14255369773/job/39956999767","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/2777241991/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"dereuromark","id":39854,"node_id":"MDQ6VXNlcjM5ODU0","avatar_url":"https://avatars.githubusercontent.com/u/39854?v=4","gravatar_id":"","url":"https://api.github.com/users/dereuromark","html_url":"https://github.com/dereuromark","followers_url":"https://api.github.com/users/dereuromark/followers","following_url":"https://api.github.com/users/dereuromark/following{/other_user}","gists_url":"https://api.github.com/users/dereuromark/gists{/gist_id}","starred_url":"https://api.github.com/users/dereuromark/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dereuromark/subscriptions","organizations_url":"https://api.github.com/users/dereuromark/orgs","repos_url":"https://api.github.com/users/dereuromark/repos","events_url":"https://api.github.com/users/dereuromark/events{/privacy}","received_events_url":"https://api.github.com/users/dereuromark/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/2777272111","html_url":"https://github.com/cakephp/cakephp/issues/18274#issuecomment-2777272111","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/18274","id":2777272111,"node_id":"IC_kwDOAAoEbs6lic8v","user":{"login":"dereuromark","id":39854,"node_id":"MDQ6VXNlcjM5ODU0","avatar_url":"https://avatars.githubusercontent.com/u/39854?v=4","gravatar_id":"","url":"https://api.github.com/users/dereuromark","html_url":"https://github.com/dereuromark","followers_url":"https://api.github.com/users/dereuromark/followers","following_url":"https://api.github.com/users/dereuromark/following{/other_user}","gists_url":"https://api.github.com/users/dereuromark/gists{/gist_id}","starred_url":"https://api.github.com/users/dereuromark/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dereuromark/subscriptions","organizations_url":"https://api.github.com/users/dereuromark/orgs","repos_url":"https://api.github.com/users/dereuromark/repos","events_url":"https://api.github.com/users/dereuromark/events{/privacy}","received_events_url":"https://api.github.com/users/dereuromark/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-04T00:29:56Z","updated_at":"2025-04-04T01:05:56Z","body":"OK, so this seems to resolve the regression added in the linked PR\n\n```php\n        if (is_array($key) && !isset($key[0])) { // Here we need to make sure we ignore the non-assoc arrays\n            $typeMap = $this->getTypeMap()->setTypes($value ?? []);\n            /** @var \\Cake\\Database\\Expression\\QueryExpression $setExpr */\n            $setExpr = $this->_parts['set'];\n            foreach ($key as $k => $v) {\n                $setExpr->add(new ComparisonExpression($k, $v, $typeMap->type($k)));\n            }\n\n            return $this;\n        }\n\n        if (is_array($key) || $key instanceof ExpressionInterface) { // Here we need to still account for non-assoc arrays\n            $types = (array)$value;\n            /** @var \\Cake\\Database\\Expression\\QueryExpression $setExpr */\n            $setExpr = $this->_parts['set'];\n            $setExpr->add($key, $types);\n\n            return $this;\n        }\n```\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/2777272111/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"dereuromark","id":39854,"node_id":"MDQ6VXNlcjM5ODU0","avatar_url":"https://avatars.githubusercontent.com/u/39854?v=4","gravatar_id":"","url":"https://api.github.com/users/dereuromark","html_url":"https://github.com/dereuromark","followers_url":"https://api.github.com/users/dereuromark/followers","following_url":"https://api.github.com/users/dereuromark/following{/other_user}","gists_url":"https://api.github.com/users/dereuromark/gists{/gist_id}","starred_url":"https://api.github.com/users/dereuromark/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dereuromark/subscriptions","organizations_url":"https://api.github.com/users/dereuromark/orgs","repos_url":"https://api.github.com/users/dereuromark/repos","events_url":"https://api.github.com/users/dereuromark/events{/privacy}","received_events_url":"https://api.github.com/users/dereuromark/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":17123409580,"node_id":"AE_lADOAAoEbs6xBhTuzwAAAAP8on6s","url":"https://api.github.com/repos/cakephp/cakephp/issues/events/17123409580","actor":{"login":"markstory","id":24086,"node_id":"MDQ6VXNlcjI0MDg2","avatar_url":"https://avatars.githubusercontent.com/u/24086?v=4","gravatar_id":"","url":"https://