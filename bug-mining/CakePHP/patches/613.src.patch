diff --git a/tests/TestCase/ORM/QueryRegressionTest.php b/tests/TestCase/ORM/QueryRegressionTest.php
index 4a44b2943d..b66fda0ddb 100644
--- a/tests/TestCase/ORM/QueryRegressionTest.php
