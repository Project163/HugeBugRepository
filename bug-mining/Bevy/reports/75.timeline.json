000000100000016, id=Id<wgpu_core::resource::TextureView<wgpu_hal::empty::Api>> @ x1) at storage.rs:105:45 [opt]\r\n   102 \t    /// Panics if there is an epoch mismatch, or the entry is empty.\r\n   103 \t    pub(crate) fn get(&self, id: I) -> Result<&T, InvalidId> {\r\n   104 \t        let (index, epoch, _) = id.unzip();\r\n-> 105 \t        let (result, storage_epoch) = match self.map.get(index as usize) {\r\n   106 \t            Some(&Element::Occupied(ref v, epoch)) => (Ok(v), epoch),\r\n   107 \t            Some(&Element::Vacant) => panic!(\"{}[{}] does not exist\", self.kind, index),\r\n   108 \t            Some(&Element::Error(epoch, ..)) => (Err(InvalidId), epoch),\r\n```","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/10524/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bevyengine/bevy/issues/10524/timeline","performed_via_github_app":null,"state_reason":"not_planned"}},"event":"cross-referenced"},{"id":13255436013,"node_id":"REFE_lADODf6-U84llizCzwAAAAMWFebt","url":"https://api.github.com/repos/bevyengine/bevy/issues/events/13255436013","actor":{"login":"tigregalis","id":38416468,"node_id":"MDQ6VXNlcjM4NDE2NDY4","avatar_url":"https://avatars.githubusercontent.com/u/38416468?v=4","gravatar_id":"","url":"https://api.github.com/users/tigregalis","html_url":"https://github.com/tigregalis","followers_url":"https://api.github.com/users/tigregalis/followers","following_url":"https://api.github.com/users/tigregalis/following{/other_user}","gists_url":"https://api.github.com/users/tigregalis/gists{/gist_id}","starred_url":"https://api.github.com/users/tigregalis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tigregalis/subscriptions","organizations_url":"https://api.github.com/users/tigregalis/orgs","repos_url":"https://api.github.com/users/tigregalis/repos","events_url":"https://api.github.com/users/tigregalis/e