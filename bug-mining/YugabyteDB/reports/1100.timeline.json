yugabyte/yugabyte-db/compare/{base}...{head}","merges_url":"https://api.github.com/repos/yugabyte/yugabyte-db/merges","archive_url":"https://api.github.com/repos/yugabyte/yugabyte-db/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/yugabyte/yugabyte-db/downloads","issues_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues{/number}","pulls_url":"https://api.github.com/repos/yugabyte/yugabyte-db/pulls{/number}","milestones_url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones{/number}","notifications_url":"https://api.github.com/repos/yugabyte/yugabyte-db/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels{/name}","releases_url":"https://api.github.com/repos/yugabyte/yugabyte-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Jira Link: [DB-7808](https://yugabyte.atlassian.net/browse/DB-7808)\r\n### Description\r\n\r\nConsider the following test case in `pg_tablet_split-test.cc`:\r\n```\r\nTEST_F(PgTabletSplitTest, TabletSyncFlush) {\r\n  ANNOTATE_UNPROTECTED_WRITE(FLAGS_db_block_size_bytes) = 256;\r\n  ANNOTATE_UNPROTECTED_WRITE(FLAGS_ysql_enable_packed_row) = true;\r\n  ANNOTATE_UNPROTECTED_WRITE(FLAGS_rocksdb_level0_file_num_compaction_trigger) =\r\n      std::numeric_limits<int32>::max();\r\n\r\n  // Create a table and make a series of write followed by flushed to have several files.\r\n  auto conn = ASSERT_RESULT(Connect());\r\n  ASSERT_OK(conn.Execute(\"CREATE TABLE t(k INT PRIMARY KEY, v INT) SPLIT INTO 1 TABLETS\"));\r\n  const auto table_id = ASSERT_RESULT(GetTableIDFromTableName(\"t\"));\r\n  auto peers = ListTableActiveTabletPeers(cluster_.get(), table_id);\r\n  ASSERT_EQ(1, peers.size());\r\n\r\n  // The first and second files contain only new rows.\r\n  ASSERT_OK(conn.ExecuteFormat(\"INSERT INTO t SELECT i, i FROM generate_series(1, 100) AS i\"));\r\n  ASSERT_OK(peers.front()->shared_tablet()->Flush(tablet::FlushMode::kSync));\r\n  ASSERT_OK(conn.ExecuteFormat(\"INSERT INTO t SELECT i, i FROM generate_series(4051, 5000) AS i\"));\r\n  ASSERT_OK(peers.front()->shared_tablet()->Flush(tablet::FlushMode::kSync));\r\n\r\n  // The third file contains several new rows and some of existing rows deleted.\r\n  ASSERT_OK(conn.ExecuteFormat(\"INSERT INTO t SELECT i, i FROM generate_series(101, 150) AS i\"));\r\n  ASSERT_OK(conn.ExecuteFormat(\"DELETE FROM t WHERE v < 51\"));\r\n  ASSERT_OK(conn.ExecuteFormat(\"INSERT INTO t SELECT i, i FROM generate_series(151, 2000) AS i\"));\r\n  ASSERT_OK(peers.front()->shared_tablet()->Flush(tablet::FlushMode::kSync));\r\n\r\n  // The forth file contains several new rows and updates.\r\n  ASSERT_OK(conn.ExecuteFormat(\"INSERT INTO t SELECT i, i FROM generate_series(2001, 4000) AS i\"));\r\n  ASSERT_OK(conn.ExecuteFormat(\"UPDATE t SET v = -1 * k WHERE k < 101\"));\r\n  ASSERT_OK(peers.front()->shared_tablet()->Flush(tablet::FlushMode::kSync));\r\n\r\n  // The fifth and sixth files contain several new rows.\r\n  ASSERT_OK(conn.ExecuteFormat(\"INSERT INTO t SELECT i, i FROM generate_series(5001, 5100) AS i\"));\r\n  ASSERT_OK(peers.front()->shared_tablet()->Flush(tablet::FlushMode::kSync));\r\n  ASSERT_OK(conn.ExecuteFormat(\"INSERT INTO t SELECT i, i FROM generate_series(4001, 4050) AS i\"));\r\n  ASSERT_OK(peers.front()->shared_tablet()->Flush(tablet::FlushMode::kSync)); // Last flush\r\n\r\n  const auto parent_files = peers.front()->shared_tablet()->regular_db()->GetLiveFilesMetaData();\r\n  const auto input_limit  = ASSERT_RESULT([&parent_files]() -> Result<uint64_t> {\r\n    SCHECK_EQ(6, parent_files.size(), IllegalState, \"\");\r\n    const uint64_t max_size = parent_files[2].total_size + parent_files[3].total_size;\r\n    const uint64_t min_size = std::max(parent_files[0].total_size + parent_files[1].total_size,\r\n                                       parent_files[4].total_size + parent_files[5].total_size);\r\n    return min_size + 1;\r\n  }());\r\n  LOG(INFO) << \"Selecting input size limit to \" << input_limit\r\n            << \" should allow to post split into 4 files.\";\r\n}\r\n```\r\nThe test intermittently fails in release mode on the line `SCHECK_EQ(6, parent_files.size(), IllegalState, \"\");`.\r\n\r\nIn accordance with logs (the full log is in Jira), this is happening because the last sync `Flush()` had returned before the RegularDB actually started flushing and that's why version storage was not able to see the new file:\r\n```\r\n[ts-1] I0901 13:57:30.843521 238129152 tablet.cc:986] T {t_tablet_id1} P {ts1_peer_id}: DoCleanupIntentFiles: Intents SST file will be deleted: { total_size: 74720 base_size: 67046 uncompressed_size: 80526 name_id: 16 db_path: /private${TEST_TMPDIR}/pg_tablet_split-test.PgTabletSplitTest.PostSplitCompactionWithLimitedSize.1693576641632442-33040/minicluster-data/ts-1-root/yb-data/tserver/data/rocksdb/table-000033f5000030008000000000004000/tablet-{t_tablet_id1}.intents imported: 0 being_compacted: 0 column_family_name: default level: 0 smallest: { seqno: 1125899906858858 user_frontier: 0x000000011defe000 -> Global filter: <invalid>, Cotables filter: []{ op_id: 1.17 hybrid_time: { days: 19601 time: 13:57:30.820696 } history_cutoff: { cotables cutoff: <invalid>, primary cutoff: <invalid> } max_value_level_ttl_expiration_time: <invalid> primary_schema_version: 0x000000011defe038 -> 0 cotable_schema_versions: [] } } largest: { seqno: 1125899906859163 user_frontier: 0x000000011defe0c0 -> Global filter: <invalid>, Cotables filter: []{ op_id: 1.18 hybrid_time: { days: 19601 time: 13:57:30.833337 } history_cutoff: { cotables cutoff: <invalid>, primary cutoff: <invalid> } max_value_level_ttl_expiration_time: <initial> primary_schema_version: 0x000000011defe0f8 -> 0 cotable_schema_versions: [] } } }, max ht: { days: 19601 time: 13:57:30.833337 }, min running transaction start ht: <max>\r\n[ts-1] I0901 13:57:30.843618 238129152 db_impl.cc:5492] T {t_tablet_id1} P {ts1_peer_id} [R]: [default] New memtable created with log file: #3\r\n../../src/yb/yql/pgwrapper/pg_tablet_split-test.cc:498: Failure\r\nFailed\r\nBad status: Illegal state (yb/yql/pgwrapper/pg_tablet_split-test.cc:492): : 6 vs 5\r\nI0901 13:57:30.843683 246714368 flush_job.cc:251] T {t_tablet_id1} P {ts1_peer_id} [R]: [default] [JOB 7] Flushing memtable with next log file: 3\r\nI0901 13:57:30.843735 246714368 event_logger.cc:66] T {t_tablet_id1} P {ts1_peer_id} [R]: EVENT_LOG_v1 {\"time_micros\": 1693576650843724, \"job\": 7, \"event\": \"flush_started\", \"num_memtables\": 1, \"num_entries\": 50, \"num_deletes\": 0, \"memory_usage\": 3536}\r\nI0901 13:57:30.843760 246714368 flush_job.cc:279] T {t_tablet_id1} P {ts1_peer_id} [R]: [default] [JOB 7] Level-0 flush table #16: started\r\nTest failure stack trace:\r\n    @        0x1050fcd3d  testing::internal::TestEventRepeater::OnTestPartResult()\r\n    ...\r\n    @        0x10452f0ef  main\r\n2023-09-01 13:57:30.844 GMT [33439] LOG:  received fast shutdown request\r\n2023-09-01 13:57:30.845 GMT [33439] LOG:  aborting any active transactions\r\n2023-09-01 13:57:30.845 GMT [33448] FATAL:  terminating background worker \"YSQL webserver\" due to administrator command\r\nI0901 13:57:30.847540 246714368 flush_job.cc:311] T {t_tablet_id1} P {ts1_peer_id} [R]: [default] [JOB 7] Level-0 flush table #16: 68164 bytes OK frontiers: { smallest: Global filter: <invalid>, Cotables filter: []{ op_id: 1.19 hybrid_time: { days: 19601 time: 13:57:30.834816 } history_cutoff: { cotables cutoff: <invalid>, primary cutoff: <invalid> } max_value_level_ttl_expiration_time: <invalid> primary_schema_version: 0x0000000115649178 -> 0 cotable_schema_versions: [] } largest: Global filter: <invalid>, Cotables filter: []{ op_id: 1.19 hybrid_time: { days: 19601 time: 13:57:30.835254 } history_cutoff: { cotables cutoff: <invalid>, primary cutoff: <invalid> } max_value_level_ttl_expiration_time: <invalid> primary_schema_version: 0x0000000114c5a878 -> 0 cotable_schema_versions: [] } }\r\nI0901 13:57:30.847609 246714368 event_logger.cc:66] T {t_tablet_id1} P {ts1_peer_id} [R]: EVENT_LOG_v1 {\"time_micros\": 1693576650847587, \"cf_name\": \"default\", \"job\": 7, \"event\": \"table_file_creation\", \"file_number\": 16, \"file_size\": 68164, \"table_properties\": {\"data_size\": 1645, \"data_index_size\": 219, \"filter_size\": 65482, \"filter_index_size\": 22, \"raw_key_size\": 1499, \"raw_average_key_size\": 29, \"raw_value_size\": 1149, \"raw_average_value_size\": 22, \"num_data_blocks\": 10, \"num_entries\": 50, \"num_filter_blocks\": 1, \"num_data_index_blocks\": 1, \"filter_policy_name\": \"DocKeyV3Filter\", \"kDeletedKeys\": \"0\"}}\r\n*** Aborted at 1693576650 (unix time) try \"date -d @1693576650\" if you are using GNU date ***\r\nPC: @                0x0 (unknown)\r\n*** SIGSEGV (@0x0) received by PID 33040 (TID 0x70000eb49000) stack trace: ***\r\n    @     0x7fff20819d7d _sigtramp\r\n    @        0x10959ac0e rocksdb::EventHelpers::LogAndNotifyTableFileCreation()\r\n    @        0x1095ab197 rocksdb::FlushJob::WriteLevel0Table()\r\n```\r\nDepending on what is happening after the flush we may get an undefined behaviour or even a crash (in case of the unit test it is a crash somewhere in FlushJob as the tests stoped and the resources were freed while the job was still on the fly).\r\nSynced flush is used at least by tablet bootstrap, tablet split and `InitialSysCatalogSnapshotWriter::WriteSnapshot()`, and they can be potentially impacted (first impression is that these methods are not impacted by such behaviour, but additional investigation is required). Most likely only a number of unit tests are impacted.\r\n\r\n### Warning: Please confirm that this issue does not contain any sensitive information\r\n\r\n- [X] I confirm this issue does not contain any sensitive information.\r\n\r\n[DB-7808]: https://yugabyte.atlassian.net/browse/DB-7808?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/18965/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/18965/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"}]