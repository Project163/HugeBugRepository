1588","html_url":"https://github.com/bazelbuild/bazel/issues/739#issuecomment-191491588","issue_url":"https://api.github.com/repos/bazelbuild/bazel/issues/739","id":191491588,"node_id":"MDEyOklzc3VlQ29tbWVudDE5MTQ5MTU4OA==","user":{"login":"nkurz","id":122253,"node_id":"MDQ6VXNlcjEyMjI1Mw==","avatar_url":"https://avatars.githubusercontent.com/u/122253?v=4","gravatar_id":"","url":"https://api.github.com/users/nkurz","html_url":"https://github.com/nkurz","followers_url":"https://api.github.com/users/nkurz/followers","following_url":"https://api.github.com/users/nkurz/following{/other_user}","gists_url":"https://api.github.com/users/nkurz/gists{/gist_id}","starred_url":"https://api.github.com/users/nkurz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nkurz/subscriptions","organizations_url":"https://api.github.com/users/nkurz/orgs","repos_url":"https://api.github.com/users/nkurz/repos","events_url":"https://api.github.com/users/nkurz/events{/privacy}","received_events_url":"https://api.github.com/users/nkurz/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-03-02T23:28:33Z","updated_at":"2016-03-02T23:28:33Z","body":"Came to report the same problem.   I was trying to install Bazel to compile https://github.com/google/highwayhash.\n\n$ wget https://github.com/bazelbuild/bazel/releases/download/0.2.0/bazel-0.2.0-installer-linux-x86_64.sh\n$ sudo bash bazel-0.2.0-installer-linux-x86_64.sh\n$ bazel build :all -c opt --copt=-mavx2\nError: mkdir('/home/nate/.cache/bazel/_bazel_nate'): Permission denied\n$ ls -ald ~/.cache/bazel/\ndrwxr-xr-x 3 root root 4096 Mar  2 18:02 /home/nate/.cache/bazel/\n\nSolved with \"sudo chown -R $USER:$USER ~/.cache/bazel/\".\n\nI don't understand Bazel, but I don't think the problem is just the permissions.   I'd think the cache directory should be per user, rather than being a single directory which all users share.  How are the permissions going to work when a third-party user on the system tries to use Bazel?    Will it try to create a subdirectory within my home directory? \n\n$ ls -al ~/.cache/bazel/\ntotal 16\ndrwxr-xr-x 4 nate nate 4096 Mar  2 18:15 .\ndrwx------ 5 nate nate 4096 Mar  2 18:02 ..\ndrwxr-xr-x 4 nate nate 4096 Mar  2 18:15 _bazel_nate\ndrwxr-xr-x 4 nate nate 4096 Mar  2 18:02 _bazel_root\n\nAt the least, this seems odd.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/191491588/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"nkurz","id":122253,"node_id":"MDQ6VXNlcjEyMjI1Mw==","avatar_url":"https://avatars.githubusercontent.com/u/122253?v=4","gravatar_id":"","url":"https://api.github.com/users/nkurz","html_url":"https://github.com/nkurz","followers_url":"https://api.github.com/users/nkurz/followers","following_url":"https://api.github.com/users/nkurz/following{/other_user}","gists_url":"https://api.github.com/users/nkurz/gists{/gist_id}","starred_url":"https://api.github.com/users/nkurz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nkurz/subscriptions","organizations_url":"https://api.github.com/users/nkurz/orgs","repos_url":"https://api.github.com/users/nkurz/repos","events_url":"https://api.github.com/users/nkurz/events{/privacy}","received_events_url":"https://api.github.com/users/nkurz/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/191494336","html_url":"https://github.com/bazelbuild/bazel/issues/739#issuecomment-191494336","issue_url":"https://api.github.com/repos/bazelbuild/bazel/issues/739","id":191494336,"node_id":"MDEyOklzc3VlQ29tbWVudDE5MTQ5NDMzNg==","user":{"login":"damienmg","id":3721087,"node_id":"MDQ6VXNlcjM3MjEwODc=","avatar_url":"https://avatars.githubusercontent.com/u/3721087?v=4","gravatar_id":"","url":"https://api.github.com/users/damienmg","html_url":"https://github.com/damienmg","followers_url":"https://api.github.com/users/damienmg/followers","following_url":"https://api.github.com/users/damienmg/following{/other_user}","gists_url":"https://api.github.com/users/damienmg/gists{/gist_id}","starred_url":"https://api.github.com/users/damienmg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/damienmg/subscriptions","organizations_url":"https://api.github.com/users/damienmg/orgs","repos_url":"https://api.github.com/users/damienmg/repos","events_url":"https://api.github.com/users/damienmg/events{/privacy}","received_events_url":"https://api.github.com/users/damienmg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-03-02T23:37:52Z","updated_at":"2016-03-02T23:37:52Z","body":"The isssue is that the install from the installer see the user home as the\nhost home (not root).  We should probably just not run bazel if the\ninstaller is run as root.\n\nOn Wed, Mar 2, 2016 at 3:28 PM nkurz notifications@github.com wrote:\n\n> Came to report the same problem. I was trying to install Bazel to compile\n> https://github.com/google/highwayhash.\n> \n> $ wget\n> https://github.com/bazelbuild/bazel/releases/download/0.2.0/bazel-0.2.0-installer-linux-x86_64.sh\n> $ sudo bash bazel-0.2.0-installer-linux-x86_64.sh\n> $ bazel build :all -c opt --copt=-mavx2\n> Error: mkdir('/home/nate/.cache/bazel/_bazel_nate'): Permission denied\n> $ ls -ald ~/.cache/bazel/\n> drwxr-xr-x 3 root root 4096 Mar 2 18:02 /home/nate/.cache/bazel/\n> \n> Solved with \"sudo chown -R $USER:$USER ~/.cache/bazel/\".\n> \n> I don't understand Bazel, but I don't think the problem is just the\n> permissions. I'd think the cache directory should be per user, rather than\n> being a single directory which all users share. How are the permissions\n> going to work when a third-party user on the system tries to use Bazel?\n> Will it try to create a subdirectory within my home directory?\n> \n> $ ls -al ~/.cache/bazel/\n> total 16\n> drwxr-xr-x 4 nate nate 4096 Mar 2 18:15 .\n> drwx------ 5 nate nate 4096 Mar 2 18:02 ..\n> drwxr-xr-x 4 nate nate 4096 Mar 2 18:15 _bazel_nate\n> drwxr-xr-x 4 nate nate 4096 Mar 2 18:02 _bazel_root\n> \n> At the least, this seems odd.\n> \n> —\n> Reply to this email directly or view it on GitHub\n> https://github.com/bazelbuild/bazel/issues/739#issuecomment-191491588.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/191494336/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"damienmg","id":3721087,"node_id":"MDQ6VXNlcjM3MjEwODc=","avatar_url":"https://avatars.githubusercontent.com/u/3721087?v=4","gravatar_id":"","url":"https://api.github.com/users/damienmg","html_url":"https://github.com/damienmg","followers_url":"https://api.github.com/users/damienmg/followers","following_url":"https://api.github.com/users/damienmg/following{/other_user}","gists_url":"https://api.github.com/users/damienmg/gists{/gist_id}","starred_url":"https://api.github.com/users/damienmg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/damienmg/subscriptions","organizations_url":"https://api.github.com/users/damienmg/orgs","repos_url":"https://api.github.com/users/damienmg/repos","events_url":"https://api.github.com/users/damienmg/events{/privacy}","received_events_url":"https://api.github.com/users/damienmg/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":577711807,"node_id":"MDExOkNsb3NlZEV2ZW50NTc3NzExODA3","url":"https://api.github.com/repos/bazelbuild/bazel/issues/events/577711807","actor":{"login":"bazel-io","id":15028808,"node_id":"MDQ6VXNlcjE1MDI4ODA4","avatar_url":"https://avatars.githubusercontent.com/u/15028808?v=4","gravatar_id