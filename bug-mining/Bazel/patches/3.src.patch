+source $(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-setup.sh \
+  || { echo "test-setup.sh not found!" >&2; exit 1; }
+
+function test_path_with_spaces() {
+  ws="a b"
+  mkdir "$ws"
+  cd "$ws"
+  touch WORKSPACE
+
+  bazel info &> $TEST_log && fail "Info succeeeded"
+  bazel help &> $TEST_log || fail "Help failed"
+}
