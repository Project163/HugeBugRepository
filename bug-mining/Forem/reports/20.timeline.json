i.github.com/repos/forem/forem/issues/comments/440189235/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Link2Twenty","id":3534427,"node_id":"MDQ6VXNlcjM1MzQ0Mjc=","avatar_url":"https://avatars.githubusercontent.com/u/3534427?v=4","gravatar_id":"","url":"https://api.github.com/users/Link2Twenty","html_url":"https://github.com/Link2Twenty","followers_url":"https://api.github.com/users/Link2Twenty/followers","following_url":"https://api.github.com/users/Link2Twenty/following{/other_user}","gists_url":"https://api.github.com/users/Link2Twenty/gists{/gist_id}","starred_url":"https://api.github.com/users/Link2Twenty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Link2Twenty/subscriptions","organizations_url":"https://api.github.com/users/Link2Twenty/orgs","repos_url":"https://api.github.com/users/Link2Twenty/repos","events_url":"https://api.github.com/users/Link2Twenty/events{/privacy}","received_events_url":"https://api.github.com/users/Link2Twenty/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/forem/forem/issues/comments/440228341","html_url":"https://github.com/forem/forem/issues/1160#issuecomment-440228341","issue_url":"https://api.github.com/repos/forem/forem/issues/1160","id":440228341,"node_id":"MDEyOklzc3VlQ29tbWVudDQ0MDIyODM0MQ==","user":{"login":"Link2Twenty","id":3534427,"node_id":"MDQ6VXNlcjM1MzQ0Mjc=","avatar_url":"https://avatars.githubusercontent.com/u/3534427?v=4","gravatar_id":"","url":"https://api.github.com/users/Link2Twenty","html_url":"https://github.com/Link2Twenty","followers_url":"https://api.github.com/users/Link2Twenty/followers","following_url":"https://api.github.com/users/Link2Twenty/following{/other_user}","gists_url":"https://api.github.com/users/Link2Twenty/gists{/gist_id}","starred_url":"https://api.github.com/users/Link2Twenty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Link2Twenty/subscriptions","organizations_url":"https://api.github.com/users/Link2Twenty/orgs","repos_url":"https://api.github.com/users/Link2Twenty/repos","events_url":"https://api.github.com/users/Link2Twenty/events{/privacy}","received_events_url":"https://api.github.com/users/Link2Twenty/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-11-20T10:45:46Z","updated_at":"2018-11-20T10:53:42Z","body":"Though personally, rather than having to worry about sizes I would put the model effect over the `page-content`\r\n\r\nperhaps something like this\r\n\r\n```CSS\r\ndiv#page-content::after {\r\n  content: \"\";\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  height: 100vh;\r\n  width: 100vw;\r\n  background: rgba(17, 17, 17, 0.88);\r\n  z-index: 999;\r\n  opacity: 0;\r\n  pointer-events: none;\r\n}\r\n\r\ndiv#page-content.active-modal::after {\r\n  opacity: 1;\r\n  pointer-events: auto;\r\n}\r\n```\r\nThis would mean the whole of `.top-bar` is above the modal backdrop, also anything could use that modal style in the future.\r\n\r\n**Side note:** \r\nI'm using `opacity` and `pointer-events` rather than `display:none` to avoid a repaint.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/forem/forem/issues/comments/440228341/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Link2Twenty","id":3534427,"node_id":"MDQ6VXNlcjM1MzQ0Mjc=","avatar_url":"https://avatars.githubusercontent.com/u/3534427?v=4","gravatar_id":"","url":"https://api.github.com/users/Link2Twenty","html_url":"https://github.com/Link2Twenty","followers_url":"https://api.github.com/users/Link2Twenty/followers","following_url":"https://api.github.com/users/Link2Twenty/following{/other_user}","gists_url":"https://api.githu