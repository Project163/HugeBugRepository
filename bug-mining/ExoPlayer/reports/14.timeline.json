.com/users/jeoliva/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jeoliva/subscriptions","organizations_url":"https://api.github.com/users/jeoliva/orgs","repos_url":"https://api.github.com/users/jeoliva/repos","events_url":"https://api.github.com/users/jeoliva/events{/privacy}","received_events_url":"https://api.github.com/users/jeoliva/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-02-27T14:22:26Z","updated_at":"2015-02-27T14:22:26Z","body":"Agree with ojw28. In fact, adding query string parameters of the base url will cause issues when working with some CDN's, that offer some security mechanisms that are based on a query string parameter that must be included just in the master request.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/76401295/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"jeoliva","id":7904247,"node_id":"MDQ6VXNlcjc5MDQyNDc=","avatar_url":"https://avatars.githubusercontent.com/u/7904247?v=4","gravatar_id":"","url":"https://api.github.com/users/jeoliva","html_url":"https://github.com/jeoliva","followers_url":"https://api.github.com/users/jeoliva/followers","following_url":"https://api.github.com/users/jeoliva/following{/other_user}","gists_url":"https://api.github.com/users/jeoliva/gists{/gist_id}","starred_url":"https://api.github.com/users/jeoliva/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jeoliva/subscriptions","organizations_url":"https://api.github.com/users/jeoliva/orgs","repos_url":"https://api.github.com/users/jeoliva/repos","events_url":"https://api.github.com/users/jeoliva/events{/privacy}","received_events_url":"https://api.github.com/users/jeoliva/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"ht