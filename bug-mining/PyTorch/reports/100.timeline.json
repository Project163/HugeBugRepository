hub.com/users/CaoE/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CaoE/subscriptions","organizations_url":"https://api.github.com/users/CaoE/orgs","repos_url":"https://api.github.com/users/CaoE/repos","events_url":"https://api.github.com/users/CaoE/events{/privacy}","received_events_url":"https://api.github.com/users/CaoE/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/pytorch/pytorch/issues/comments/1492886317","html_url":"https://github.com/pytorch/pytorch/issues/94128#issuecomment-1492886317","issue_url":"https://api.github.com/repos/pytorch/pytorch/issues/94128","id":1492886317,"node_id":"IC_kwDOA-j9z85Y-6Mt","user":{"login":"shijy16","id":31403391,"node_id":"MDQ6VXNlcjMxNDAzMzkx","avatar_url":"https://avatars.githubusercontent.com/u/31403391?v=4","gravatar_id":"","url":"https://api.github.com/users/shijy16","html_url":"https://github.com/shijy16","followers_url":"https://api.github.com/users/shijy16/followers","following_url":"https://api.github.com/users/shijy16/following{/other_user}","gists_url":"https://api.github.com/users/shijy16/gists{/gist_id}","starred_url":"https://api.github.com/users/shijy16/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shijy16/subscriptions","organizations_url":"https://api.github.com/users/shijy16/orgs","repos_url":"https://api.github.com/users/shijy16/repos","events_url":"https://api.github.com/users/shijy16/events{/privacy}","received_events_url":"https://api.github.com/users/shijy16/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-04-01T09:06:34Z","updated_at":"2023-04-01T09:06:34Z","body":"@CaoE The similar bug exists in `torch._C._nn.multilabel_margin_loss`, `torch._C._linalg.linalg_pinv` and `torch._C._linalg.linalg_matmul`.  An 0 and a big value in the input result in a segment fault.\r\nThese are the buggy code of them:\r\n````python\r\n# multilabel_margin_loss\r\nimport torch\r\ninput = torch.rand([3, 2], dtype=torch.float32)\r\ntarget = torch.rand([9, 9, 2, 15, 0, 904932433365235466], dtype=torch.float32)\r\nreduction = 53\r\nres = torch._C._nn.multilabel_margin_loss(\r\n    input=input,\r\n    target=target,\r\n    reduction=reduction,\r\n)\r\n````\r\n````python\r\n# linalg_pinv\r\nimport torch\r\ninput = torch.rand([0, 2786357852644344240, 11, 15, 10, 16], dtype=torch.float32)\r\nres = torch._C._linalg.linalg_pinv(\r\n    input=input,\r\n)\r\n````\r\n\r\n````python\r\n# linalg_matmul\r\nimport torch\r\ninput = torch.rand([2, 10], dtype=torch.float32)\r\nother = torch.rand([8, 0, 9, 13, 1356914755596406577], dtype=torch.float32)\r\nres = torch._C._linalg.linalg_matmul(\r\n    input=input,\r\n    other=other,\r\n)\r\n````","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/pytorch/pytorch/issues/comments/1492886317/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"shijy16","id":31403391,"node_id":"MDQ6VXNlcjMxNDAzMzkx","avatar_url":"https://avatars.githubusercontent.com/u/31403391?v=4","gravatar_id":"","url":"https://api.github.com/users/shijy16","html_url":"https://github.com/shijy16","followers_url":"https://api.github.com/users/shijy16/followers","following_url":"https://api.github.com/users/shijy16/following{/other_user}","gists_url":"https://api.github.com/users/shijy16/gists{/gist_id}","starred_url":"https://api.github.com/users/shijy16/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shijy16/subscriptions","organizations_url":"https://api.github.com/users/shijy16/orgs","repos_url":"https://api.github.com/users/shijy16/repos","events_url":"https://api.github.com/users/shijy16/events{/privacy}","received_events_url":"https://api.github.com/users/shijy16/received_events","type":"User","user_view_type":"public","site_admin":fals