/bazelbuild/bazel/git/commits{/sha}","comments_url":"https://api.github.com/repos/bazelbuild/bazel/comments{/number}","issue_comment_url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments{/number}","contents_url":"https://api.github.com/repos/bazelbuild/bazel/contents/{+path}","compare_url":"https://api.github.com/repos/bazelbuild/bazel/compare/{base}...{head}","merges_url":"https://api.github.com/repos/bazelbuild/bazel/merges","archive_url":"https://api.github.com/repos/bazelbuild/bazel/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/bazelbuild/bazel/downloads","issues_url":"https://api.github.com/repos/bazelbuild/bazel/issues{/number}","pulls_url":"https://api.github.com/repos/bazelbuild/bazel/pulls{/number}","milestones_url":"https://api.github.com/repos/bazelbuild/bazel/milestones{/number}","notifications_url":"https://api.github.com/repos/bazelbuild/bazel/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/bazelbuild/bazel/labels{/name}","releases_url":"https://api.github.com/repos/bazelbuild/bazel/releases{/id}","deployments_url":"https://api.github.com/repos/bazelbuild/bazel/deployments","created_at":"2014-06-12T16:00:38Z","updated_at":"2025-12-12T22:36:14Z","pushed_at":"2025-12-12T23:00:16Z","git_url":"git://github.com/bazelbuild/bazel.git","ssh_url":"git@github.com:bazelbuild/bazel.git","clone_url":"https://github.com/bazelbuild/bazel.git","svn_url":"https://github.com/bazelbuild/bazel","homepage":"https://bazel.build","size":992874,"stargazers_count":24886,"watchers_count":24886,"language":"Java","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":4359,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1818,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["bazel","build","build-system","correct","fast","multi-language","scalable","test"],"visibility":"public","forks":4359,"open_issues":1818,"watchers":24886,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/bazelbuild/bazel/pulls/9111","html_url":"https://github.com/bazelbuild/bazel/pull/9111","diff_url":"https://github.com/bazelbuild/bazel/pull/9111.diff","patch_url":"https://github.com/bazelbuild/bazel/pull/9111.patch","merged_at":null},"body":"Checks COMPREPLY after filling it to reset it to () if it only contains a null entry, allowing fall-through to other completions configured through bash.\r\n\r\nPer the [bash manual][1], after a bash completion function runs, \"possible completions are retrieved from the value of the COMPREPLY array variable.\" However, the bazel completion function includes a null first element in COMPREPLY if no completions are found. This prevents it from falling through and allowing other default behaviors - it does not play nice in the shell. This is done in _bazel__to_compreply().\r\n\r\nFor example:\r\n\r\n    complete -o nospace -o default -F _bazel__complete\r\n\r\nThis command should allow any command to use bazel completions (if available), and then fall-through to default completions. Typing `vim l<TAB>` should give me completions of files beginning with l (assuming no bazel completions begin that way). In its current state, by including a null entry in COMPREPLY, the fallthrough enabled by '-o default' is currently prevented.\r\n\r\nFixes #9112\r\n\r\n[1]: https://www.gnu.org/software/bash/manual/html_node/Programmable-Completion-Builtins.html","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/9111/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bazelbuild/bazel/issues/9111/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":2549285253,"node_id":"MDEyOkxhYmVsZWRFdmVudDI1NDkyODUyNTM=","url":"https://api.github.com/repos/bazelbuild/bazel/issues/events/2549285253","actor":{"login":"ishikhman","id":11422276,"node_id":"MDQ6VXNlcjExNDIyMjc2","avatar_url":"https://avatars.githubusercontent.com/u/11422276?v=4","gravatar_id":"","url":"https://api.github.com/users/ishikhman","html_url":"https://github.com/ishikhman","followers_url":"https://api.github.com/users/ishikhman/followers","following_url":"https://api.github.com/users/ishikhman/following{/other_user}","gists_url":"https://api.github.com/users/ishikhman/gists{/gist_id}","starred_url":"https://api.github.com/users/ishikhman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ishikhman/subscriptions","organizations_url":"https://api.github.com/users/ishikhman/orgs","repos_url":"https://api.github.com/users/ishikhman/repos","events_url":"https://api.github.com/users/ishikhman/events{/privacy}","received_events_url":"https://api.github.com/users/ishikhman/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2019-08-12T07:16:28Z","label":{"name":"team-XProduct","color":"f1f442"},"performed_via_github_app":null},{"id":2549285256,"node_id":"MDEyOkxhYmVsZWRFdmVudDI1NDkyODUyNTY=","url":"https://api.github.com/repos/bazelbuild/bazel/issues/events/2549285256","actor":{"login":"ishikhman","id":11422276,"node_id":"MDQ6VXNlcjExNDIyMjc2","avatar_url":"https://avatars.githubusercontent.com/u/11422276?v=4","gravatar_id":"","url":"https://api.github.com/users/ishikhman","html_url":"https://github.com/ishikhman","followers_url":"https://api.github.com/users/ishikhman/followers","following_url":"https://api.github.com/users/ishikhman/following{/other_user}","gists_url":"https://api.github.com/users/ishikhman/g