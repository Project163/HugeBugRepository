.github.com/users/fabianskii/subscriptions","organizations_url":"https://api.github.com/users/fabianskii/orgs","repos_url":"https://api.github.com/users/fabianskii/repos","events_url":"https://api.github.com/users/fabianskii/events{/privacy}","received_events_url":"https://api.github.com/users/fabianskii/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2020-11-26T10:08:27Z","label":{"name":"requires triage","color":"f9aeb0"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/typeorm/typeorm/issues/comments/847792346","html_url":"https://github.com/typeorm/typeorm/issues/7110#issuecomment-847792346","issue_url":"https://api.github.com/repos/typeorm/typeorm/issues/7110","id":847792346,"node_id":"MDEyOklzc3VlQ29tbWVudDg0Nzc5MjM0Ng==","user":{"login":"kauz","id":28005569,"node_id":"MDQ6VXNlcjI4MDA1NTY5","avatar_url":"https://avatars.githubusercontent.com/u/28005569?v=4","gravatar_id":"","url":"https://api.github.com/users/kauz","html_url":"https://github.com/kauz","followers_url":"https://api.github.com/users/kauz/followers","following_url":"https://api.github.com/users/kauz/following{/other_user}","gists_url":"https://api.github.com/users/kauz/gists{/gist_id}","starred_url":"https://api.github.com/users/kauz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kauz/subscriptions","organizations_url":"https://api.github.com/users/kauz/orgs","repos_url":"https://api.github.com/users/kauz/repos","events_url":"https://api.github.com/users/kauz/events{/privacy}","received_events_url":"https://api.github.com/users/kauz/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-05-25T11:33:05Z","updated_at":"2021-05-25T11:33:05Z","body":"This is likely to be a posgtgres-specific issue. Explicit type conversions are stripped when loading schema from database, but in some cases this is done inaccurately, which causes this schema change to appear in all further generated migrations. In my case value \r\n`to_char(nextval('orders_display_id_seq'::regclass), 'FMU999'::text)` was stripped to just `to_char(nextval('orders_display_id_seq'`.\r\n\r\nWith the next schema it causes this change to appear again and again in every migration, that I generate:\r\n```\r\nexport class Order  {\r\n\r\n    @PrimaryGeneratedColumn('uuid')\r\n    id: string;\r\n\r\n    @Column({\r\n      nullable: false,\r\n      type: 'varchar',\r\n      default: () => \"TO_CHAR(NEXTVAL('orders_display_id_seq'), 'FMU999')\",\r\n    })\r\n    @Index({ unique: true })\r\n    displayId: string;\r\n}\r\n```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/typeorm/typeorm/issues/comments/847792346/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"kauz","id":28005569,"node_id":"MDQ6VXNlcjI4MDA1NTY5","avatar_url":"https://avatars.githubusercontent.com/u/28005569?v=4","gravatar_id":"","url":"https://api.github.com/users/kauz","html_url":"https://github.com/kauz","followers_url":"https://api.github.com/users/kauz/followers","following_url":"https://api.github.com/users/kauz/following{/other_user}","gists_url":"https://api.github.com/users/kauz/gists{/gist_id}","starred_url":"https://api.github.com/users/kauz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kauz/subscriptions","organizations_url":"https://api.github.com/users/kauz/orgs","repos_url":"https://api.github.com/users/kauz/repos","events_url":"https://api.github.com/users/kauz/events{/privacy}","received_events_url":"https://api.github.com/users/kauz/received_events","type":"User","user_view_type":"public","site_admin":false}},{"actor":{"login":"kauz","id":28005569,"node_id":"MDQ6VXNlcjI4MDA1NTY5","avatar_url":"https://avatars.githubusercontent.com/u/28005569?v=4","gravatar