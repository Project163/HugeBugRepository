my/sqlalchemy.git","svn_url":"https://github.com/sqlalchemy/sqlalchemy","homepage":"https://www.sqlalchemy.org","size":99269,"stargazers_count":11252,"watchers_count":11252,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":1606,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":205,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["python","sql","sqlalchemy"],"visibility":"public","forks":1606,"open_issues":205,"watchers":11252,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"### Describe the bug\r\n\r\nI have a query that returned a different result between v1.4 & 2.0 (see code snippet later).\r\nSomehow the brackets suddenly disappeared (on 2.0 -- but not all)...\r\nI don't know why they are gone as they shouldn't have.\r\n\r\nIf you need more information, please ask!\r\n\r\n### Optional link from https://docs.sqlalchemy.org which documents the behavior that is expected\r\n\r\n_No response_\r\n\r\n### SQLAlchemy Version in Use\r\n\r\n1.4 & 2.0\r\n\r\n### DBAPI (i.e. the database driver)\r\n\r\nsqlite\r\n\r\n### Database Vendor and Major Version\r\n\r\nSQLite 3.38.5\r\n\r\n### Python Version\r\n\r\n3.9.13\r\n\r\n### Operating system\r\n\r\nWindows\r\n\r\n### To Reproduce\r\n\r\n```python\r\nimport os\r\nfrom pathlib import Path\r\n\r\nfrom sqlalchemy import create_engine, Column, Integer, Float, String\r\nfrom sqlalchemy.orm import sessionmaker\r\nfrom sqlalchemy.ext.declarative import declarative_base\r\n\r\nBase = declarative_base()\r\n\r\nPath(\"cities.db\").unlink(missing_ok=True)\r\nengine = create_engine(\"sqlite:///cities.db\")\r\n\r\n\r\nclass Location(Base):\r\n    __tablename__ = \"cities\"\r\n    id = Column(Integer, primary_key=True)\r\n    lat = Column(Float)\r\n    lng = Column(Float)\r\n    city_name = Column(String)\r\n\r\n    def __repr__(self):\r\n        return f\"Location({self.lat}, {self.lng} > {self.city_name})\"\r\n\r\n\r\nBase.metadata.create_all(engine)\r\n\r\nSession = sessionmaker(bind=engine)\r\nsession = Session()\r\n\r\nsession.add_all(\r\n    [\r\n        Location(lat=37.7749, lng=-122.4194, city_name=\"San Francisco\"),\r\n        Location(lat=40.7128, lng=-74.0060, city_name=\"New York\"),\r\n        Location(lat=41.8781, lng=-87.6298, city_name=\"Chicago\"),\r\n        Location(lat=29.7604, lng=-95.3698, city_name=\"Houston\"),\r\n        Location(lat=34.0522, lng=-118.2437, city_name=\"Los Angeles\"),\r\n    ]\r\n)\r\n\r\nsession.commit()\r\n\r\nfudge = 1.2345678\r\nlat = 40\r\nlng = -74\r\n\r\nquery = session.query(\r\n    Location,\r\n    (lat - Location.lat) * (lat - Location.lat)\r\n    + fudge * (lng - Location.lng) * (lng - Location.lng),\r\n)\r\n\r\nprint(query)\r\n\r\nfor row in query.all():\r\n    print(row)\r\n\r\nsession.close()\r\n```\r\n\r\n\r\n### Error\r\n\r\n```text\r\nSELECT cities.id AS cities_id, cities.lat AS cities_lat, cities.lng AS cities_lng, cities.city_name AS cities_city_name, (? - cities.lat) * (? - cities.lat) + ? * (? - cities.lng) * ? - cities.lng AS anon_1 \r\nFROM cities\r\n(Location(37.7749, -122.4194 > San Francisco), -4296.12990800368)\r\n(Location(40.7128, -74.006 > New York), 73.96593573679998)\r\n(Location(41.8781, -87.6298 > Chicago), -1154.0344432225602)\r\n(Location(29.7604, -95.3698 > Houston), -1752.0833478005597)\r\n(Location(34.0522, -118.2437 > Los Angeles), -3888.3966807516404)\r\n```\r\n\r\nExpected:\r\n```text\r\nSELECT cities.id AS cities_id, cities.lat AS cities_lat, cities.lng AS cities_lng, cities.city_name AS cities_city_name, (? - cities.lat) * (? - cities.lat) + ? * (? - cities.lng) * (? - cities.lng) AS anon_1 \r\nFROM cities\r\n(Location(37.7749, -122.4194 > San Francisco), 2899.3190997829124)\r\n(Location(40.7128, -74.006 > New York), 0.508128284440802)\r\n(Location(41.8781, -87.6298 > Chicago), 232.8747075195572)\r\n(Location(29.7604, -95.3698 > Houston), 668.6374508676481)\r\n(Location(34.0522, -118.2437 > Los Angeles), 2452.0489534506064)\r\n```\r\n\r\n### Additional context\r\n\r\n_No response_","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/9271/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/9271/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":10671032367,"node_id":"REFE_lADOCX5JB85EQtH-zwAAAAJ8Cwgv","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/10671032367","actor":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"c1017bc800509870f8594de6bf384a86ed2a3f9a","commit_url":"https://api.github.com/repos/sqlalchemy/sqlalchem