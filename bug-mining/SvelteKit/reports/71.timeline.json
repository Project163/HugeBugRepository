rs/accuser/orgs","repos_url":"https://api.github.com/users/accuser/repos","events_url":"https://api.github.com/users/accuser/events{/privacy}","received_events_url":"https://api.github.com/users/accuser/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-01-29T17:02:48Z","updated_at":"2022-01-29T17:02:48Z","body":"I'm automatically rotating keys in a JWKS served from `.well-known/jwks.json`, and so dynamically generating the content. I could change this to serve the key set from `static`, but would need to re-build/re-deploy each time I rotated the keys. Being able to 'map' the path in `svelte.config.js` would be useful if the use of dot prefixed files should be avoided. ","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sveltejs/kit/issues/comments/1024948089/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"accuser","id":85733,"node_id":"MDQ6VXNlcjg1NzMz","avatar_url":"https://avatars.githubusercontent.com/u/85733?v=4","gravatar_id":"","url":"https://api.github.com/users/accuser","html_url":"https://github.com/accuser","followers_url":"https://api.github.com/users/accuser/followers","following_url":"https://api.github.com/users/accuser/following{/other_user}","gists_url":"https://api.github.com/users/accuser/gists{/gist_id}","starred_url":"https://api.github.com/users/accuser/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/accuser/subscriptions","organizations_url":"https://api.github.com/users/accuser/orgs","repos_url":"https://api.github.com/users/accuser/repos","events_url":"https://api.github.com/users/accuser/events{/privacy}","received_events_url":"https://api.github.com/users/accuser/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sveltejs/kit/issues/comments/1024949172","html_url":"https://github.com/sveltejs/kit/issues/3340#issuecomment-1024949172","issue_url":"https://api.github.com/repos/sveltejs/kit/issues/3340","id":1024949172,"node_id":"IC_kwDOEiPr8c49F3u0","user":{"login":"accuser","id":85733,"node_id":"MDQ6VXNlcjg1NzMz","avatar_url":"https://avatars.githubusercontent.com/u/85733?v=4","gravatar_id":"","url":"https://api.github.com/users/accuser","html_url":"https://github.com/accuser","followers_url":"https://api.github.com/users/accuser/followers","following_url":"https://api.github.com/users/accuser/following{/other_user}","gists_url":"https://api.github.com/users/accuser/gists{/gist_id}","starred_url":"https://api.github.com/users/accuser/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/accuser/subscriptions","organizations_url":"https://api.github.com/users/accuser/orgs","repos_url":"https://api.github.com/users/accuser/repos","events_url":"https://api.github.com/users/accuser/events{/privacy}","received_events_url":"https://api.github.com/users/accuser/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-01-29T17:08:06Z","updated_at":"2022-01-29T17:08:06Z","body":"https://www.rfc-editor.org/rfc/rfc8615 defines the use of well-known URIs. I wonder if adding  `__well-known` as a root route could be a place-holder for the `.well-known` path, be mapped automatically by SvelteKit?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sveltejs/kit/issues/comments/1024949172/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"accuser","id":85733,"node_id":"MDQ6VXNlcjg1NzMz","avatar_url":"https://avatars.githubusercontent.com/u/85733?v=4","gravatar_id":"","url":"https://api.github.com/users/accuser","html_url":"https://github.com/accuser","followers_url":"https://api.github.com/users/accuser/followers","following_url":"https://api.github.com/users/accuser/following{/other_user}","gists_url":"https://api.github.com/users/accuser/gists{/gist_id}","starred_url":"https://api.github.com/users/accuser/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/accuser/subscriptions","organizations_url":"https://api.github.com/users/accuser/orgs","repos_url":"https://api.github.com/users/accuser/repos","events_url":"https://api.github.com/users/accuser/events{/privacy}","received_events_url":"https://api.github.com/users/accuser/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sveltejs/kit/issues/comments/1057070301","html_url":"https://github.com/sveltejs/kit/issues/3340#issuecomment-1057070301","issue_url":"https://api.github.com/repos/sveltejs/kit/issues/3340","id":1057070301,"node_id":"IC_kwDOEiPr8c4_AZzd","user":{"login":"accuser","id":85733,"node_id":"MDQ6VXNlcjg1NzMz","avatar_url":"https://avatars.githubusercontent.com/u/85733?v=4","gravatar_id":"","url":"https://api.github.com/users/accuser","html_url":"https://github.com/accuser","followers_url":"https://api.github.com/users/accuser/followers","following_url":"https://api.github.com/users/accuser/following{/other_user}","gists_url":"https://api.github.com/users/accuser/gists{/gist_id}","starred_url":"https://api.github.com/users/accuser/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/accuser/subscriptions","organizations_url":"https://api.github.com/users/accuser/orgs","repos_url":"https://api.github.com/users/accuser/repos","events_url":"https://api.github.com/users/accuser/events{/privacy}","received_events_url":"https://api.github.com/users/accuser/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-03-02T15:39:35Z","updated_at":"2022-03-02T15:39:35Z","body":"Just adding to this in case anyone else come searching: my specific issue is with deploying on Netlify. There is a suggested workaround, but I haven't managed to get it to work correctly: renamed the `.well-known` folder/endpoint to `well-known` and add a `_redirects` file in the root of the project with the following rule: `/.well-known/* /well-known/:splat 200`. ","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sveltejs/kit/issues/comments/1057070301/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"accuser","id":85733,"node_id":"MDQ6VXNlcjg1NzMz","avatar_url":"https://avatars.githubusercontent.com/u/85733?v=4","gravatar_id":"","url":"https://api.github.com/users/accuser","html_url":"https://github.com/accuser","followers_url":"https://api.github.com/users/accuser/followers","following_url":"https://api.github.com/users/accuser/following{/other_user}","gists_url":"https://api.github.com/users/accuser/gists{/gist_id}","starred_url":"https://api.github.com/users/accuser/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/accuser/subscriptions","organizations_url":"https://api.github.com/users/accuser/orgs","repos_url":"https://api.github.com/users/accuser/repos","events_url":"https://api.github.com/users/accuser/events{/privacy}","received_events_url":"https://api.github.com/users/accuser/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sveltejs/kit/issues/comments/1102544218","html_url":"https://github.com/sveltejs/kit/issues/3340#issuecomment-1102544218","issue_url":"https://api.github.com/repos/sveltejs/kit/issues/3340","id":1102544218,"node_id":"IC_kwDOEiPr8c5Bt31a","user":{"login":"sidvishnoi","id":8426945,"node_id":"MDQ6VXNlcjg0MjY5NDU=","avatar_url":"https://avatars.githubusercontent.com/u/8426945?v=4","gravatar_id":"","url":"https://api.github.com/users/sidvishnoi","html_url":"https://github.com/sidvishnoi","followers_url":"https://api.github.com/users/sidvishnoi/followers","following_url":"https://api.github.com/users/sidvishnoi/following{/other_user}","gists_url":"https://api.github.com/users/sidvishnoi/gists{/gist_id}","starred_url":"https://api.github.com/users/sidvishnoi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sidvishnoi/subscriptions","organizations_url":"https://api.github.com/users/sidvishnoi/orgs","repos_url":"https://api.github.com/users/sidvishnoi/repos","events_url":"https://api.github.com/users/sidvishnoi/events{/privacy}","received_events_url":"https://api.github.com/users/sidvishnoi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-04-19T11:48:14Z","updated_at":"2022-04-19T11:48:31Z","body":"Figured out a workaround: rename `.well-known` directory to `well-known` and rewrite request via hooks. Tested with adapter-node. \r\nI had some problems with content-encoding though, so I manually cleared some headers.\r\n\r\n```js\r\n// src/hooks.js\r\nexport const handle = ({ event, resolve }) => {\r\n  if (event.url.pathname.startsWith('/.well-known')) {\r\n    const url = new URL(event.url);\r\n    url.pathname = url.pathname.replace('/.well-known', '/well-known');\r\n    const res = await fetch(url.href, {\r\n      method: event.request.method,\r\n      headers: event.request.headers,\r\n    });\r\n    // Some content-encoding related headers cause invalid response. So, we pick\r\n    // the desired ones. There might be a better way to do this.\r\n    const headers = new Headers();\r\n    headers.set('content-type', res.headers.get('content-type'));\r\n    headers.set('cache-control', res.headers.get('cache-control'));\r\n    return new Response(res.body, { headers });\r\n  }\r\n\r\n  return resolve(event);\r\n};\r\n```\r\n\r\nI think adapters should respect `config.kit.routes` and/or include `.well-known` as an exception.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sveltejs/kit/issues/comments/1102544218/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"sidvishnoi","id":8426945,"node_id":"MDQ6VXNlcjg0MjY5NDU=","avatar_url":"https://avatars.githubusercontent.com/u/8426945?v=4","gravatar_id":"","url":"https://api.github.com/users/sidvishnoi","html_url":"https://github.com/sidvishnoi","followers_url":"https://api.github.com/users/sidvishnoi/followers","following_url":"https://api.github.com/users/sidvishnoi/following{/other_user}","gists_url":"https://api.github.com/users/sidvishnoi/gists{/gist_id}","starred_url":"https://api.github.com/users/sidvishnoi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sidvishnoi/subscriptions","organizations_url":"https://api.github.com/users/sidvishnoi/orgs","repos_url":"https://api.github.com/users/sidvishnoi/repos","events_url":"https://api.github.com/users/sidvishnoi/events{/privacy}","received_events_url":"https://api.github.com/users/sidvishnoi/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sveltejs/kit/issues/comments/1102581099","html_url":"https://github.com/sveltejs/kit/issues/3340#issuecomment-1102581099","issue_url":"https://api.github.com/repos/sveltejs/kit/issues/3340","id":1102581099,"node_id":"IC_kwDOEiPr8c5BuA1r","user":{"login":"mankins","id":170588,"node_id":"MDQ6VXNlcjE3MDU4OA==","avatar_url":"https://avatars.githubusercontent.com/u/170588?v=4","gravatar_id":"","url":"https://api.github.com/users/mankins","html_url":"https://github.com/mankins","followers_url":"https://api.github.com/users/mankins/followers","following_url":"https://api.github.com/users/mankins/following{/other_user}","gists_url":"https://api.github.com/users/mankins/gists{/gist_id}","starred_url":"https://api.github.com/users/mankins/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mankins/subscriptions","organizations_url":"https://api.github.com/users/mankins/orgs","repos_url":"https://api.github.com/users/mankins/repos","events_url":"https://api.github.com/users/mankins/events{/privacy}","received_events_url":"https://api.github.com/users/mankins/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-04-19T12:25:14Z","updated_at":"2022-04-19T12:39:47Z","body":"> I think adapters should respect config.kit.routes and/or include .well-known as an exception.\r\n\r\nI agree. I think the blanket filter is a bug, but besides @sidvishnoi 's workaround you can work around it this way as well:\r\n\r\nRename `.well-known` to `[...wellKnown=wellKnown]`\r\n\r\n```\r\nsrc/routes/.well-known => src/routes/[...wellKnown=wellKnown]/\r\n```\r\n\r\nand then: `src/params/wellKnown.ts` is\r\n\r\n```js\r\nimport type { ParamMatcher } from '@sveltejs/kit';\r\n\r\nexport const match: ParamMatcher = (param) => {\r\n  const isWellKnownPath = /^\\.well-known$/i.test(param);\r\n  return isWellKnownPath;\r\n};\r\n```\r\n\r\nThat way the file doesn't start with a `.` and isn't filtered by the adapter.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sveltejs/kit/issues/comments/1102581099/reactions","total_count":2,"+1":0,"-1":0,"laugh":1,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"mankins","id":170588,"node_id":"MDQ6VXNlcjE3MDU4OA==","avatar_url":"https://avatars.githubusercontent.com/u/170588?v=4","gravatar_id":"","url":"https://api.github.com/users/mankins","html_url":"https://github.com/mankins","followers_url":"https://api.github.com/users/mankins/followers","following_url":"https://api.github.com/users/mankins/following{/other_user}","gists_url":"https://api.github.com/users/mankins/gists{/gist_id}","starred_url":"https://api.github.com/users/mankins/starred{/owner}{/repo}","subscriptions_url":"https://api.githu