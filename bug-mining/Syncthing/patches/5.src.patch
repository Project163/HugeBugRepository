+func (fakeResolver) WhoHas(n string) []string {
+	if strings.HasPrefix(n, "a-") {
+		return []string{"a", "nodeID"}
+	} else if strings.HasPrefix(n, "b-") {
+		return []string{"b", "nodeID"}
+	}
+	return []string{"a", "b", "nodeID"}
