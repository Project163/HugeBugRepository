ly does something else.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/helm/helm/issues/comments/582944160/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"KlavsKlavsen","id":2737885,"node_id":"MDQ6VXNlcjI3Mzc4ODU=","avatar_url":"https://avatars.githubusercontent.com/u/2737885?v=4","gravatar_id":"","url":"https://api.github.com/users/KlavsKlavsen","html_url":"https://github.com/KlavsKlavsen","followers_url":"https://api.github.com/users/KlavsKlavsen/followers","following_url":"https://api.github.com/users/KlavsKlavsen/following{/other_user}","gists_url":"https://api.github.com/users/KlavsKlavsen/gists{/gist_id}","starred_url":"https://api.github.com/users/KlavsKlavsen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KlavsKlavsen/subscriptions","organizations_url":"https://api.github.com/users/KlavsKlavsen/orgs","repos_url":"https://api.github.com/users/KlavsKlavsen/repos","events_url":"https://api.github.com/users/KlavsKlavsen/events{/privacy}","received_events_url":"https://api.github.com/users/KlavsKlavsen/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/helm/helm/issues/comments/582946226","html_url":"https://github.com/helm/helm/issues/7539#issuecomment-582946226","issue_url":"https://api.github.com/repos/helm/helm/issues/7539","id":582946226,"node_id":"MDEyOklzc3VlQ29tbWVudDU4Mjk0NjIyNg==","user":{"login":"KlavsKlavsen","id":2737885,"node_id":"MDQ6VXNlcjI3Mzc4ODU=","avatar_url":"https://avatars.githubusercontent.com/u/2737885?v=4","gravatar_id":"","url":"https://api.github.com/users/KlavsKlavsen","html_url":"https://github.com/KlavsKlavsen","followers_url":"https://api.github.com/users/KlavsKlavsen/followers","following_url":"https://api.github.com/users/KlavsKlavsen/following{/other_user}","gists_url":"https://api.g