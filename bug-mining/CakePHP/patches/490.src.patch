+	public function testUrlGenerationPrefixedPlugin() {
+		Router::prefix('admin', function($routes) {
+			$routes->plugin('MyPlugin', function($routes) {
+				$routes->fallbacks();
+			});
+		});
+		$result = Router::url(['prefix' => 'admin', 'plugin' => 'MyPlugin', 'controller' => 'Forms', 'action' => 'edit', 2]);
