+      value: any, currencyCode: string = 'USD', symbolDisplay: boolean = false,
+      digits?: string): string|null {
+    return formatNumber(
+        DeprecatedCurrencyPipe, this._locale, value, NumberFormatStyle.Currency, digits,
+        currencyCode, symbolDisplay);
+  }
+}
