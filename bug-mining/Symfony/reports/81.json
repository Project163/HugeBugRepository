{"url":"https://api.github.com/repos/symfony/symfony/issues/8111","repository_url":"https://api.github.com/repos/symfony/symfony","labels_url":"https://api.github.com/repos/symfony/symfony/issues/8111/labels{/name}","comments_url":"https://api.github.com/repos/symfony/symfony/issues/8111/comments","events_url":"https://api.github.com/repos/symfony/symfony/issues/8111/events","html_url":"https://github.com/symfony/symfony/issues/8111","id":14565084,"node_id":"MDU6SXNzdWUxNDU2NTA4NA==","number":8111,"title":"[Form] PATCH'ed forms are never valid","user":{"login":"Burgov","id":417674,"node_id":"MDQ6VXNlcjQxNzY3NA==","avatar_url":"https://avatars.githubusercontent.com/u/417674?v=4","gravatar_id":"","url":"https://api.github.com/users/Burgov","html_url":"https://github.com/Burgov","followers_url":"https://api.github.com/users/Burgov/followers","following_url":"https://api.github.com/users/Burgov/following{/other_user}","gists_url":"https://api.github.com/users/Burgov/gists{/gist_id}","starred_url":"https://api.github.com/users/Burgov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Burgov/subscriptions","organizations_url":"https://api.github.com/users/Burgov/orgs","repos_url":"https://api.github.com/users/Burgov/repos","events_url":"https://api.github.com/users/Burgov/events{/privacy}","received_events_url":"https://api.github.com/users/Burgov/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":99594,"node_id":"MDU6TGFiZWw5OTU5NA==","url":"https://api.github.com/repos/symfony/symfony/labels/Form","name":"Form","color":"DDDDDD","default":false,"description":null},{"id":100079,"node_id":"MDU6TGFiZWwxMDAwNzk=","url":"https://api.github.com/repos/symfony/symfony/labels/Bug","name":"Bug","color":"e10c02","default":false,"description":null}],"state":"closed","locked":false,"assignee":null,"assignees":[],"milestone":null,"comments":15,"created_at":"2013-05-21T12:36:23Z","updated_at":"2013-08-01T16:13:10Z","closed_at":"2013-07-21T19:55:26Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"While trying out the new form PATCH feature, I ran into a bug:\n\nSay for instance you have a form with two children: firstName, lastName,\n\nand you PATCH with this data: `array('firstName' => 'Hank')`\n\nnow the \"submit\" method is never called on the child \"lastName\". Now there's a problem, because Form::isValid() only returns `true` if `$this->submitted` is `true`. However, this is `false` for the \"lastName\" child. A form with children, in turn, will only return `true`, if all of it's children are `true`, which, now, is not the case.\n","closed_by":{"login":"fabpot","id":47313,"node_id":"MDQ6VXNlcjQ3MzEz","avatar_url":"https://avatars.githubusercontent.com/u/47313?v=4","gravatar_id":"","url":"https://api.github.com/users/fabpot","html_url":"https://github.com/fabpot","followers_url":"https://api.github.com/users/fabpot/followers","following_url":"https://api.github.com/users/fabpot/following{/other_user}","gists_url":"https://api.github.com/users/fabpot/gists{/gist_id}","starred_url":"https://api.github.com/users/fabpot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fabpot/subscriptions","organizations_url":"https://api.github.com/users/fabpot/orgs","repos_url":"https://api.github.com/users/fabpot/repos","events_url":"https://api.github.com/users/fabpot/events{/privacy}","received_events_url":"https://api.github.com/users/fabpot/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/symfony/symfony/issues/8111/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/symfony/symfony/issues/8111/ti