+			{`(?<=^)#[^\n]*(\n|\Z)`, Comment, nil},
+			{`(?<=^)(%)([^\n]*)(\n|\Z)`, ByGroups(NameTag, Using(Python), Other), nil},
+			{`(?sx)
+                 (.+?)               # anything, followed by:
