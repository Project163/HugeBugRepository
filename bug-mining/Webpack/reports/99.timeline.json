b.com/users/sokra/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"0636e7cf79178fc36a144591e901e1baafec06c2","commit_url":"https://api.github.com/repos/webpack/webpack/commits/0636e7cf79178fc36a144591e901e1baafec06c2","created_at":"2016-12-28T07:37:27Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/webpack/webpack/issues/comments/269480889","html_url":"https://github.com/webpack/webpack/issues/3591#issuecomment-269480889","issue_url":"https://api.github.com/repos/webpack/webpack/issues/3591","id":269480889,"node_id":"MDEyOklzc3VlQ29tbWVudDI2OTQ4MDg4OQ==","user":{"login":"d-ph","id":4347095,"node_id":"MDQ6VXNlcjQzNDcwOTU=","avatar_url":"https://avatars.githubusercontent.com/u/4347095?v=4","gravatar_id":"","url":"https://api.github.com/users/d-ph","html_url":"https://github.com/d-ph","followers_url":"https://api.github.com/users/d-ph/followers","following_url":"https://api.github.com/users/d-ph/following{/other_user}","gists_url":"https://api.github.com/users/d-ph/gists{/gist_id}","starred_url":"https://api.github.com/users/d-ph/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/d-ph/subscriptions","organizations_url":"https://api.github.com/users/d-ph/orgs","repos_url":"https://api.github.com/users/d-ph/repos","events_url":"https://api.github.com/users/d-ph/events{/privacy}","received_events_url":"https://api.github.com/users/d-ph/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-12-28T14:01:51Z","updated_at":"2016-12-28T14:01:51Z","body":"As I mentioned in the PR, the problem isn't solved entirely by that PR. Now the progress indicator stays in one place, but still isn't right:\r\n![bugreport-after-gif](https://cloud.githubusercontent.com/assets/4347095/21523346/4c33e332-cd05-11e6-938f-0a49ba3a904e.gif)\r\n\r\nI found, that the problem lies in the fact, that virtually anything can `console.log()` during the progress output, which breaks Windows' terminal. Long story short: This is something nothing can be done about.\r\n\r\nBut there is a workaround: don't use prescripts in npm. I.e. instead of this:\r\n```json\r\n\"scripts\": {\r\n    \"clean\": \"rimraf dist\",\r\n    \"prebuild\": \"npm run clean\",\r\n    \"build\": \"webpack --progress --hide-modules\"\r\n  },\r\n```\r\nuse this:\r\n```json\r\n\"scripts\": {\r\n    \"clean\": \"rimraf dist\",\r\n    \"build\": \"npm run clean && webpack --progress --hide-modules\"\r\n  },\r\n```\r\nwhich will work in any terminal, any OS. Seems like this is npm's problem and not webpack's.\r\n\r\nBottom line: it's a `Won't Fix`","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/webpack/webpack/issues/comments/269480889/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"d-ph","id":4347095,"node_id":"MDQ6VXNlcjQzNDcwOTU=","avatar_url":"https://avatars.githubusercontent.com/u/4347095?v=4","gravatar_id":"","url":"https://api.github.com/users/d-ph","html_url":"https://github.com/d-ph","followers_url":"https://api.github.com/users/d-ph/followers","following_url":"https://api.github.com/users/d-ph/following{/other_user}","gists_url":"https://api.github.com/users/d-ph/gists{/gist_id}","starred_url":"https://api.github.com/users/d-ph/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/d-ph/subscriptions","organizations_url":"https://api.github.com/users/d-ph/orgs","repos_url":"https://api.github.com/users/d-ph/repos","events_url":"https://api.github.com/users/d-ph/events{/privacy}","received_events_url":"https://api.github.com/users/d-ph/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":907166286,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDkwNzE2NjI4Ng==","url":"https://api.github.com/repos/webpack/webpack/issues/events/907166286","actor":{"