\")\n\t\t.withExposedPorts(8123, 9000);\n\n\t@DynamicPropertySource\n\tstatic void properties(DynamicPropertyRegistry registry) {\n\t\tregistry.add(\"spring.datasource.url\", () -> \"jdbc:clickhouse://\" + clickhouse.getHost() + \":\"\n\t\t\t\t+ clickhouse.getFirstMappedPort() + \"/\" + clickhouse.getDatabaseName());\n\t\tregistry.add(\"spring.datasource.username\", clickhouse::getUsername);\n\t\tregistry.add(\"spring.datasource.password\", clickhouse::getPassword);\n\t}\n```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/testcontainers/testcontainers-java/issues/comments/2638691971/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"livk-cloud","id":50291874,"node_id":"MDQ6VXNlcjUwMjkxODc0","avatar_url":"https://avatars.githubusercontent.com/u/50291874?v=4","gravatar_id":"","url":"https://api.github.com/users/livk-cloud","html_url":"https://github.com/livk-cloud","followers_url":"https://api.github.com/users/livk-cloud/followers","following_url":"https://api.github.com/users/livk-cloud/following{/other_user}","gists_url":"https://api.github.com/users/livk-cloud/gists{/gist_id}","starred_url":"https://api.github.com/users/livk-cloud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/livk-cloud/subscriptions","organizations_url":"https://api.github.com/users/livk-cloud/orgs","repos_url":"https://api.github.com/users/livk-cloud/repos","events_url":"https://api.github.com/users/livk-cloud/events{/privacy}","received_events_url":"https://api.github.com/users/livk-cloud/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":16203443470,"node_id":"LE_lADOAgP_mc6o1fI1zwAAAAPFzO0O","url":"https://api.github.com/repos/testcontainers/testcontainers-java/issues/events/16203443470","actor":{"login":"eddumelendez","id":1810547,"node_id":"MDQ6VXNlcjE4MTA1NDc=","avatar_u