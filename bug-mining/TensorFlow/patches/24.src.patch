+      rpcmethod_ListDevices_(grpcMasterService_method_names[4],
+                             ::grpc::RpcMethod::NORMAL_RPC, channel),
+      rpcmethod_Reset_(grpcMasterService_method_names[5],
+                       ::grpc::RpcMethod::NORMAL_RPC, channel) {}
