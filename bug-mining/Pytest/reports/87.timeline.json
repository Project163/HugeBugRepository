","python","science"],"visibility":"public","forks":1984,"open_issues":1435,"watchers":4970,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"I've tried using the `--pastebin='failed'` functionality running tests in astroquery, and I get the following traceback/dump:\n\n```\n======================================================================================== Sending information to Paste Service ========================================================================================\nTraceback (most recent call last):\n  File \"<string>\", line 1, in <module>\n  File \"/private/var/folders/_r/c4nkvmpn4vx6qc91qygz8h740000gr/T/astroquery-test-g65uipac/lib.macosx-10.5-x86_64-3.5/astroquery/_astropy_init.py\", line 114, in test\n    coverage=coverage, open_files=open_files, **kwargs)\n  File \"/Users/adam/anaconda/envs/astropy35/lib/python3.5/site-packages/astropy-1.1.1-py3.5-macosx-10.5-x86_64.egg/astropy/tests/runner.py\", line 253, in run_tests\n    return pytest.main(args=all_args, plugins=plugins)\n  File \"_pytest.config\", line 41, in main\n  File \"_pytest.core\", line 521, in __call__\n  File \"_pytest.core\", line 528, in _docall\n  File \"_pytest.core\", line 394, in execute\n  File \"_pytest.main\", line 116, in pytest_cmdline_main\n  File \"_pytest.main\", line 109, in wrap_session\n  File \"_pytest.core\", line 521, in __call__\n  File \"_pytest.core\", line 528, in _docall\n  File \"_pytest.core\", line 393, in execute\n  File \"_pytest.core\", line 109, in wrapped_call\n  File \"_pytest.terminal\", line 360, in pytest_sessionfinish\n  File \"_pytest.core\", line 521, in __call__\n  File \"_pytest.core\", line 528, in _docall\n  File \"_pytest.core\", line 394, in execute\n  File \"_pytest.pastebin\", line 87, in pytest_terminal_summary\n  File \"_pytest.pastebin\", line 64, in create_new_paste\n  File \"/Users/adam/anaconda/envs/astropy35/lib/python3.5/urllib/request.py\", line 162,