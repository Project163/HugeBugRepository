ull,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Psalm gives many undefined errors for this example, but nothing is undefined, since include.php includes everything. Surprisingly, the example is minimal.\r\n\r\nProbably related to https://github.com/vimeo/psalm/issues/1338.\r\n\r\nExample:\r\n\r\n**include.php**\r\n```php\r\n<?php\r\ninclude 'func.php';\r\ninclude 'Base.php';\r\ninclude 'Child.php';\r\n```\r\n\r\n**func.php**\r\n```php\r\n<?php\r\nnamespace ns;\r\n\r\nfunction func(): void {}\r\n\r\ndefine('ns\\\\cons', 0);\r\n\r\ncons;\r\n```\r\n\r\n**Base.php**\r\n```php\r\n<?php\r\nnamespace ns;\r\n\r\nfunc();\r\n\r\ncons;\r\n\r\nclass Base {\r\n    public function __construct() {}\r\n}\r\n```\r\n\r\n**Child.php**\r\n```php\r\n<?php\r\nnamespace ns;\r\n\r\nfunc();\r\n\r\ncons;\r\n\r\nclass Child extends Base {\r\n    /**\r\n     * @var int\r\n     */\r\n    public $x;\r\n\r\n    public function __construct() {\r\n        parent::__construct();\r\n    }\r\n}\r\n```\r\n\r\nExample output (using commit 8ec188a):\r\n```\r\n$ psalm include.php\r\nERROR: UndefinedFunction - Base.php:4:1 - Function ns\\func does not exist\r\n\r\nERROR: UndefinedConstant - Base.php:6:1 - Const cons is not defined\r\n\r\nERROR: UndefinedConstant - Child.php:6:1 - Const cons is not defined\r\n\r\nINFO: PropertyNotSetInConstructor - Child.php:12:12 - Property ns\\Child::$x is not defined in constructor of ns\\Child or in any methods called in the constructor\r\n\r\nERROR: UndefinedConstant - func.php:8:1 - Const cons is not defined\r\n```","closed_by":{"login":"muglug","id":2292638,"node_id":"MDQ6VXNlcjIyOTI2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/2292638?v=4","gravatar_id":"","url":"https://api.github.com/users/muglug","html_url":"https://github.com/muglug","followers_url":"https://api.github.com/users/muglug/followers","following_url":"https://api.github.com/users/muglug/following{/other_user}","gists_url":"https://api.github.com/users/muglug/gists{/gist_id}","starred_url":"https://api.github.com/users/muglug/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/muglug/subscriptions","organizations_url":"https://api.github.com/users/muglug/orgs","repos_url":"https://api.github.com/users/muglug/repos","events_url":"https://api.github.com/users/muglug/events{/privacy}","received_events_url":"https://api.github.com/users/muglug/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/1417/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vimeo/psalm/issues/1417/timeline","performed_via_github_app":null,"state_reason":"completed"}