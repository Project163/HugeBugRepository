ithub.com/repos/eslint/eslint/labels/accepted","name":"accepted","color":"0052cc","default":false,"description":"There is consensus among the team that this change meets the criteria for inclusion"},{"id":154929020,"node_id":"MDU6TGFiZWwxNTQ5MjkwMjA=","url":"https://api.github.com/repos/eslint/eslint/labels/blocked","name":"blocked","color":"e11d21","default":false,"description":"This change can't be completed until another issue is resolved"},{"id":829215248,"node_id":"MDU6TGFiZWw4MjkyMTUyNDg=","url":"https://api.github.com/repos/eslint/eslint/labels/archived%20due%20to%20age","name":"archived due to age","color":"eeeeee","default":false,"description":"This issue has been archived; please open a new issue for any further discussion"}],"state":"closed","locked":true,"assignee":null,"assignees":[],"milestone":null,"comments":3,"created_at":"2015-03-31T17:48:37Z","updated_at":"2018-02-07T01:23:19Z","closed_at":"2015-04-11T00:39:44Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"This may be related to the eslint-babel parser. Given [this code](http://babeljs.io/repl/#?experimental=true&playground=true&evaluate=true&loose=true&spec=false&code=const%20foo%20%3D%20'hello!'%3B%0A%0Afunction%20bar%28foobar%20%3D%20foo%29%20%7B%0A%20%20console.log%28foobar%29%3B%0A%7D)\n\n``` javascript\n// example.js\nconst foo = \"hello!\";\n\nfunction bar(foobar = foo) {\n  foobar.replace(/!$/, \" world!\");\n}\n\nbar();\n```\n\nand this .eslintrc\n\n``` json\n{\n  \"parser\": \"babel-eslint\",\n  \"rules\": {\n    \"strict\": 0\n  }\n}\n```\n\nI get this error:\n\n```\n~/Desktop\n⛄  $ eslint example.js \n\nexample.js\n  1:6  error  foo is defined but never used  no-unused-vars\n\n✖ 1 problem (1 error, 0 warnings)\n```\n\nHowever, `foo` is being used as the default parameter.\n","closed_by":{"log