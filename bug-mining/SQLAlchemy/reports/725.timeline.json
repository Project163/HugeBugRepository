sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2017-12-14T21:29:09Z","state_reason":null,"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/441939813","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/4147#issuecomment-441939813","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/4147","id":441939813,"node_id":"MDEyOklzc3VlQ29tbWVudDQ0MTkzOTgxMw==","user":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-06-14T14:15:29Z","updated_at":"2018-11-27T06:16:00Z","body":"**colladoman wrote:**\n\nI'm having lots of problems when I try to use \"tometadata\" in tables from Oracle that contain indexes. I've been using this to sync data from one database to other, but since sqlalchemy 1.2.0 i'm having this problem:\n\n```\nTraceback (most recent call last):\n  File \"test.py\", line 186, in <module>\n    sources[source]=DBAccess.cSource(DBConfig.SOURCES[source], source_connections)\n  File \"/home/pyweb/projects/DBCacheSQLite/DBAccess.py\", line 111, in __init__\n    self.cache_metadata,\n  File \"/home/pyweb/projects/DBCacheSQLite/lib/python3.4/site-packages/sqlalchemy/sql/schema.py\", line 911, in tometadata\n    **index.kwargs)\n  File \"/home/pyweb/projects/DBCacheSQLite/lib/python3.4/site-packages/sqlalchemy/sql/schema.py\", line 3447, in __init__\n    self._set_parent(table)\n  File \"/home/pyweb/projects/DBCacheSQLite/lib/python3.4/site-packages/sqlalchemy/sql/schema.py\", line 3458, in _set_parent\n    table.description\nsqlalchemy.exc.ArgumentError: Index 'ix_bag_last' is against table 'bbags', and cannot be associated with table 'bbags'.\n\n```\n\nI've tested that reverting the last part of tometadata method changes everything runs fine again (file sqlalchemy/sql/schema.py):\nFrom (1.2.0+)\n \n```\n            Index(index.name,\n                  unique=index.unique,\n                  *[_copy_expression(expr, self, table)\n                    for expr in index.expressions],\n                  _table=table,\n                  **index.kwargs)\n```\n\n\nto (1.1.8)\n\n\n```\n            Index(index.name,\n                  unique=index.unique,\n                  *[table.c[col] for col in index.columns.keys()],\n                  **index.kwargs)\n```\n\n\nActually, I don't need indexes to be copied, but I would like to know if there's something I can do to get tables copied from one database to another like I used to\n","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/441939813/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_gith