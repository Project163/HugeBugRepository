{"id":1353907004,"node_id":"MDU6TGFiZWwxMzUzOTA3MDA0","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/priority/high","name":"priority/high","color":"ffdc5e","default":false,"description":"High Priority"}],"state":"closed","locked":false,"assignee":{"login":"frozenspider","id":2077017,"node_id":"MDQ6VXNlcjIwNzcwMTc=","avatar_url":"https://avatars.githubusercontent.com/u/2077017?v=4","gravatar_id":"","url":"https://api.github.com/users/frozenspider","html_url":"https://github.com/frozenspider","followers_url":"https://api.github.com/users/frozenspider/followers","following_url":"https://api.github.com/users/frozenspider/following{/other_user}","gists_url":"https://api.github.com/users/frozenspider/gists{/gist_id}","starred_url":"https://api.github.com/users/frozenspider/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/frozenspider/subscriptions","organizations_url":"https://api.github.com/users/frozenspider/orgs","repos_url":"https://api.github.com/users/frozenspider/repos","events_url":"https://api.github.com/users/frozenspider/events{/privacy}","received_events_url":"https://api.github.com/users/frozenspider/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"frozenspider","id":2077017,"node_id":"MDQ6VXNlcjIwNzcwMTc=","avatar_url":"https://avatars.githubusercontent.com/u/2077017?v=4","gravatar_id":"","url":"https://api.github.com/users/frozenspider","html_url":"https://github.com/frozenspider","followers_url":"https://api.github.com/users/frozenspider/followers","following_url":"https://api.github.com/users/frozenspider/following{/other_user}","gists_url":"https://api.github.com/users/frozenspider/gists{/gist_id}","starred_url":"https://api.github.com/users/frozenspider/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/frozenspider/subscriptions","organizations_url":"https://api.github.com/users/frozenspider/orgs","repos_url":"https://api.github.com/users/frozenspider/repos","events_url":"https://api.github.com/users/frozenspider/events{/privacy}","received_events_url":"https://api.github.com/users/frozenspider/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":1,"created_at":"2020-01-28T17:35:28Z","updated_at":"2020-01-31T11:16:22Z","closed_at":"2020-01-31T11:16:22Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"While creating unique index on existing data, if unique constraint fails for one/more of the rows, the index still gets created with incorrect data.\r\nSee this example:\r\n```\r\nyugabyte=# create table foo(a int primary key, b int);\r\nCREATE TABLE\r\nyugabyte=# insert into foo(a) select generate_series(1,1000);\r\nINSERT 0 1000\r\nyugabyte=# \\timing on\r\nTiming is on.\r\nyugabyte=# select count(1) from foo;\r\n count \r\n-------\r\n  1000\r\n(1 row)\r\n\r\nTime: 36.992 ms\r\nyugabyte=# update foo set b=10;\r\nUPDATE 1000\r\nTime: 698.933 ms\r\nyugabyte=# create unique index on foo(b);\r\nERROR:  duplicate key value violates unique constraint \"foo_b_idx\"\r\nTime: 605.651 ms\r\nyugabyte=# \\d foo\r\n                Table \"public.foo\"\r\n Column |  Type   | Collation | Nullable | Default \r\n--------+---------+-----------+----------+---------\r\n a      | integer |           | not null | \r\n b      | integer |           |          | \r\nIndexes:\r\n    \"foo_pkey\" PRIMARY KEY, lsm (a HASH)\r\n    \"foo_b_idx\" UNIQUE, lsm (b HASH)\r\n\r\nyugabyte=# select * from foo where b=10;\r\n a | b \r\n---+---\r\n(0 rows)\r\n\r\nTime: 9.469 ms\r\n```","closed_by":{"login":"frozenspider","id":2077017,"node_id":"MDQ6VXNlcjIwNzcwMTc=","avatar_url":"https://avatars.githubusercontent.com/u/2077017?v=4","gravatar_id":"","url":"https://api.github.com/users/frozenspider","html_url":"https://github.com/frozenspider","followers_url":"https://api.github.com/users/frozenspider/followers","following_url":"https://api.github.com/users/frozenspider/following{/other_user}","gists_url":"https://api.github.com/users/frozenspider/gists{/gist_id}","starred_url":"https://api.github.com/users/frozenspider/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/frozenspider/subscriptions","organizations_url":"https://api.github.com/users/frozenspider/orgs","repos_url":"https://api.github.com/users/frozenspider/repos","events_url":"https://api.github.com/users/frozenspider/events{/privacy}","received_events_url":"https://api.github.com/users/frozenspider/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/3462/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/3462/timeline","performed_via_github_app":null,"state_reason":"completed"}