+          package:android
+          package:com.android.contacts
+          package:com.google.android.webview
+
+        ADB_OUTPUT
+
+        mock_adb_response_for_command(adb_list_packages_command, adb_response)
+      end
+
+      it 'skips uninstall of app' do
