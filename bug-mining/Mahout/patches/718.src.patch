-  private static boolean isSymmetric(Matrix a) {
-    /*
-    Symmetry flag.
-    */
-    int n = a.columnSize();
-
-    boolean isSymmetric = true;
-    for (int j = 0; (j < n) && isSymmetric; j++) {
-      for (int i = 0; (i < n) && isSymmetric; i++) {
-        isSymmetric = a.getQuick(i, j) == a.getQuick(j, i);
-      }
