ity/high","color":"ffdc5e","default":false,"description":"High Priority"},{"id":2156857038,"node_id":"MDU6TGFiZWwyMTU2ODU3MDM4","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/area/ycql","name":"area/ycql","color":"0c4fcc","default":false,"description":"Yugabyte CQL (YCQL)"}],"state":"closed","locked":false,"assignee":{"login":"nocaway","id":31016169,"node_id":"MDQ6VXNlcjMxMDE2MTY5","avatar_url":"https://avatars.githubusercontent.com/u/31016169?v=4","gravatar_id":"","url":"https://api.github.com/users/nocaway","html_url":"https://github.com/nocaway","followers_url":"https://api.github.com/users/nocaway/followers","following_url":"https://api.github.com/users/nocaway/following{/other_user}","gists_url":"https://api.github.com/users/nocaway/gists{/gist_id}","starred_url":"https://api.github.com/users/nocaway/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nocaway/subscriptions","organizations_url":"https://api.github.com/users/nocaway/orgs","repos_url":"https://api.github.com/users/nocaway/repos","events_url":"https://api.github.com/users/nocaway/events{/privacy}","received_events_url":"https://api.github.com/users/nocaway/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"nocaway","id":31016169,"node_id":"MDQ6VXNlcjMxMDE2MTY5","avatar_url":"https://avatars.githubusercontent.com/u/31016169?v=4","gravatar_id":"","url":"https://api.github.com/users/nocaway","html_url":"https://github.com/nocaway","followers_url":"https://api.github.com/users/nocaway/followers","following_url":"https://api.github.com/users/nocaway/following{/other_user}","gists_url":"https://api.github.com/users/nocaway/gists{/gist_id}","starred_url":"https://api.github.com/users/nocaway/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nocaway/subscriptions","organizations_url":"https://api.github.com/users/nocaway/orgs","repos_url":"https://api.github.com/users/nocaway/repos","events_url":"https://api.github.com/users/nocaway/events{/privacy}","received_events_url":"https://api.github.com/users/nocaway/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":4,"created_at":"2020-06-25T18:36:56Z","updated_at":"2020-07-06T16:06:17Z","closed_at":"2020-07-06T16:03:42Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"When we create table with indexes where one column is a prefix of the other column, the select queries that use both the column fail with \"Column doesn't exist\" error.\r\n\r\nSteps to reproduce:\r\n```\r\nycqlsh:ybdemo_keyspace> create table benchmark_table_0405 (k text, v text, v1 text, primary key(k)) WITH transactions = { 'enabled' : true };\r\nycqlsh:ybdemo_keyspace> create index idx on benchmark_table_0405 (v);\r\nycqlsh:ybdemo_keyspace>  create index idx1 on benchmark_table_0405 (v1);\r\nycqlsh:ybdemo_keyspace>\r\nycqlsh:ybdemo_keyspace> select * from benchmark_table_0405 where v = 'def' and v1 = 'efg';\r\nInvalidRequest: Error from server: code=2200 [Invalid query] message=\"Undefined Column. Column doesn't exist\r\nselect * from benchmark_table_0405 where v = 'def' and v1 = 'efg';\r\n                                                       ^^\r\n (ql error -203)\"\r\n```\r\n\r\nNote that without indexes the problem doesn't exist.\r\n```\r\nycqlsh:ybdemo_keyspace> create table benchmark_table_0405 (k text, v text, v1 text, primary key(k)) WITH transactions = { 'enabled' : true };\r\nycqlsh:ybdemo_keyspace> insert into benchmark_table_0405 (k,v,v1) values ('abc', 'def', 'efg');\r\nycqlsh:ybdemo_keyspace> select * from benchmark_table_0405 where v = 'def' and v1 = 'efg';\r\n k   | v   | v1\r\n-----+-----+-----\r\n abc | def | efg\r\n\r\n```\r\n\r\nAlso this is a problem only when one column is a prefix of the other:\r\n```\r\nycqlsh:ybdemo_keyspace> create table benchmark_table_0405 (k text, v2 text, v1 text, primary key(k)) WITH transactions = { 'enabled' : true };\r\nycqlsh:ybdemo_keyspace> create index idx1 on benchmark_table_0405 (v1);\r\nycqlsh:ybdemo_keyspace> create index idx2 on benchmark_table_0405 (v2);\r\nycqlsh:ybdemo_keyspace>  insert into benchmark_table_0405 (k,v1,v2) values ('abc', 'def', 'efg');\r\nycqlsh:ybdemo_keyspace> select * from benchmark_table_0405 where v1 = 'def' and v2 = 'efg';\r\n k   | v2  | v1\r\n-----+-----+-----\r\n abc | efg | def\r\n```","closed_by":{"login":"nocaway","id":31016169,"node_id":"MDQ6VXNlcjMxMDE2MTY5","avatar_url":"https://avatars.githubusercontent.com/u/31016169?v=4","gravatar_id":"","url":"https://api.github.com/users/nocaway","html_url":"https://github.com/nocaway","followers_url":"https://api.github.com/users/nocaway/followers","following_url":"https://api.github.com/users/nocaway/following{/other_user}","gists_url":"https://api.github.com/users/nocaway/gists{/gist_id}","starred_url":"https://api.github.com/users/nocaway/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nocaway/subscriptions","organizations_url":"https://api.github.com/users/nocaway/orgs","repos_url":"https://api.github.com/users/nocaway/repos","events_url":"https://api.github.com/users/nocaway/events{/privacy}","received_events_url":"https://api.github.com/users/nocaway/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/4881/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/4881/timeline","performed_via_github_app":null,"state_reason":"completed"}