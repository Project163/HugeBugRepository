":26171110,"node_id":"MDEyOklzc3VlQ29tbWVudDI2MTcxMTEw","user":{"login":"ghost","id":10137,"node_id":"MDQ6VXNlcjEwMTM3","avatar_url":"https://avatars.githubusercontent.com/u/10137?v=4","gravatar_id":"","url":"https://api.github.com/users/ghost","html_url":"https://github.com/ghost","followers_url":"https://api.github.com/users/ghost/followers","following_url":"https://api.github.com/users/ghost/following{/other_user}","gists_url":"https://api.github.com/users/ghost/gists{/gist_id}","starred_url":"https://api.github.com/users/ghost/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ghost/subscriptions","organizations_url":"https://api.github.com/users/ghost/orgs","repos_url":"https://api.github.com/users/ghost/repos","events_url":"https://api.github.com/users/ghost/events{/privacy}","received_events_url":"https://api.github.com/users/ghost/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2013-10-11T20:41:06Z","updated_at":"2013-10-11T20:41:06Z","body":"3rd Apr 2010, **[Kim Biesbjerg](https://github.com/biesbjerg)** said:\n\n---\n\nJust discovered that the patch isn't complete.\n\nEven though the test pass, it's still not 100% correct. Right now the table has to exists in database A, even though the datasource is database B.\n\nI'm thinking we need to prefix `table`.`field` with the database name?\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/26171110/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ghost","id":10137,"node_id":"MDQ6VXNlcjEwMTM3","avatar_url":"https://avatars.githubusercontent.com/u/10137?v=4","gravatar_id":"","url":"https://api.github.com/users/ghost","html_url":"https://github.com/ghost","followers_url":"https://api.github.com/users/ghost/followers","following_url":"https://api.github.com/users/ghost/following{/other_user}","gists_url":"https://api.github.com/users/ghost/gists{/gist_id}","starred_url":"https://api.github.com/users/ghost/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ghost/subscriptions","organizations_url":"https://api.github.com/users/ghost/orgs","repos_url":"https://api.github.com/users/ghost/repos","events_url":"https://api.github.com/users/ghost/events{/privacy}","received_events_url":"https://api.github.com/users/ghost/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/26171114","html_url":"https://github.com/cakephp/cakephp/issues/1749#issuecomment-26171114","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/1749","id":26171114,"node_id":"MDEyOklzc3VlQ29tbWVudDI2MTcxMTE0","user":{"login":"ghost","id":10137,"node_id":"MDQ6VXNlcjEwMTM3","avatar_url":"https://avatars.githubusercontent.com/u/10137?v=4","gravatar_id":"","url":"https://api.github.com/users/ghost","html_url":"https://github.com/ghost","followers_url":"https://api.github.com/users/ghost/followers","following_url":"https://api.github.com/users/ghost/following{/other_user}","gists_url":"https://api.github.com/users/ghost/gists{/gist_id}","starred_url":"https://api.github.com/users/ghost/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ghost/subscriptions","organizations_url":"https://api.github.com/users/ghost/orgs","repos_url":"https://api.github.com/users/ghost/repos","events_url":"https://api.github.com/users/ghost/events{/privacy}","received_events_url":"https://api.github.com/users/ghost/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2013-10-11T20:41:08Z","updated_at":"2013-10-11T20:41:08Z","body":"3rd Apr 2010, **[Kim Biesbjerg](https://github.com/biesbjerg)** said:\n\n---\n\nThe fix in the dbo_source + this custom mysql dbo does it for me :\n\n```\n<?php\nApp::import('DataSource', 'dbo_mysql'); \nclass DboMysqlCustom extends DboMysql {\n/**\n * Gets full table name including prefix and database name\n *\n * `@param` mixed $model Either a Model object or a string table name.\n * `@param` boolean $quote Whether you want the table name quoted.\n * `@return` string Full quoted table name\n * `@access` public\n */\n    function fullTableName($model, $quote = true) {\n        $table = parent::fullTableName($model, $quote);\n        $database = $this->databaseName($model, $quote);\n        if ($database) {\n            return $database . '.' . $table;\n        }\n        return $table;\n    }\n\n\n/**\n * Gets database name for model\n */ \n    function databaseName($model, $quote = true) {\n        if (is_object($model)) {\n            $db =& ConnectionManager::getDataSource($model->useDbConfig);\n            if (!isset($db->config['database'])) {\n                return false;\n            }\n            $database = $db->config['database'];\n        } elseif (isset($model->config['database'])) {\n            $database = $model->config['database'];     \n        }   \n        if ($quote) {\n            $database = $this->name($database);\n        }\n        return $database;\n    }\n}\n?>\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/26171114/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ghost","id":10137,"node_id":"MDQ6VXNlcjEwMTM3","avatar_url":"https://avatars.githubusercontent.com/u/10137?v=4","gravatar_id":"","url":"https://api.github.com/users/ghost","html_url":"https://github.com/ghost","followers_url":"https://api.github.com/users/ghost/followers","following_url":"https://api.github.com/users/ghost/following{/other_user}","gists_url":"https://api.github.com/users/ghost/gists{/gist_id}","starred_url":"https://api.github.com/users/gh