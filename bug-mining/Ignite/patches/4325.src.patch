+
+        for (Ignite ignite : G.allGrids()) {
+            PartitionUpdateCounter c = counter(PARTITION_ID, cacheName, ignite.name());
+
+            if (c0 == null)
+                c0 = c;
+            else {
+                assertEquals(ignite.name(), c0, c);
+
+                c0 = c;
+            }
+        }
+    }
+}
