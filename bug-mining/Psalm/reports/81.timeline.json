muglug/repos","events_url":"https://api.github.com/users/muglug/events{/privacy}","received_events_url":"https://api.github.com/users/muglug/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2017-10-22T15:35:21Z","label":{"name":"wontfix","color":"ffffff"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/vimeo/psalm/issues/comments/338487016","html_url":"https://github.com/vimeo/psalm/issues/250#issuecomment-338487016","issue_url":"https://api.github.com/repos/vimeo/psalm/issues/250","id":338487016,"node_id":"MDEyOklzc3VlQ29tbWVudDMzODQ4NzAxNg==","user":{"login":"muglug","id":2292638,"node_id":"MDQ6VXNlcjIyOTI2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/2292638?v=4","gravatar_id":"","url":"https://api.github.com/users/muglug","html_url":"https://github.com/muglug","followers_url":"https://api.github.com/users/muglug/followers","following_url":"https://api.github.com/users/muglug/following{/other_user}","gists_url":"https://api.github.com/users/muglug/gists{/gist_id}","starred_url":"https://api.github.com/users/muglug/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/muglug/subscriptions","organizations_url":"https://api.github.com/users/muglug/orgs","repos_url":"https://api.github.com/users/muglug/repos","events_url":"https://api.github.com/users/muglug/events{/privacy}","received_events_url":"https://api.github.com/users/muglug/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-10-22T15:42:50Z","updated_at":"2017-10-22T23:58:00Z","body":"The equivalent function in if-statement form also fails in Psalm:\r\n\r\n```php\r\nfunction f(A $obj): string {\r\n  if (($obj->a !== null) == true) {\r\n    return $obj->a; // definitely not null\r\n  } elseif (!is_null($obj->b) == true) {\r\n    return $obj->b;\r\n  } else {\r\n    throw new \\InvalidArgumentException('$obj->a or $obj->b must be set');\r\n  }\r\n}\r\n```\r\n\r\nBut it works when simplified:\r\n\r\n```php\r\nfunction f(A $obj): string {\r\n  if ($obj->a !== null) {\r\n    return $obj->a; // definitely not null\r\n  } elseif (!is_null($obj->b)) {\r\n    return $obj->b;\r\n  } else {\r\n    throw new \\InvalidArgumentException('$obj->a or $obj->b must be set');\r\n  }\r\n}\r\n```\r\n\r\nand in the spirit of not forcing Psalm to ~understand arbitrarily convoluted algebra~*, I'm going to close this, while opening one to address more basic switch statement logic.\r\n\r\n**EDIT** *Psalm now understands all of the above","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/comments/338487016/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"muglug","id":2292638,"node_id":"MDQ6VXNlcjIyOTI2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/2292638?v=4","gravatar_id":"","url":"https://api.github.com/users/muglug","html_url":"https://github.com/muglug","followers_url":"https://api.github.com/users/muglug/followers","following_url":"https://api.github.com/users/muglug/following{/other_user}","gists_url":"https://api.github.com/users/muglug/gists{/gist_id}","starred_url":"https://api.github.com/users/muglug/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/muglug/subscriptions","organizations_url":"https://api.github.com/users/muglug/orgs","repos_url":"https://api.github.com/users/muglug/repos","events_url":"https://api.github.com/users/muglug/events{/privacy}","received_events_url":"https://api.github.com/users/muglug/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1304569630,"node_id":"MDExOkNsb3NlZEV2ZW50MTMwNDU2OTYzMA==","url":"https://api.github.com/repos/vimeo/psalm/issues/events/1304569630","actor":{"login":"muglug","id":2292638,"node_id":"MDQ