                            <comment id="17032460" author="ivan.glukos" created="Fri, 7 Feb 2020 15:35:12 +0000"  >&lt;p&gt;&lt;a href=&quot;https://issues.apache.org/jira/secure/ViewProfile.jspa?name=vmalinovskiy&quot; class=&quot;user-hover&quot; rel=&quot;vmalinovskiy&quot;&gt;vmalinovskiy&lt;/a&gt; Hello!&lt;br/&gt;
Please pay attention to the Ignite code style.&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
        Set&amp;lt;&lt;span class=&quot;code-object&quot;&gt;String&lt;/span&gt;&amp;gt; beancClsNames = srv.queryMBeans(&lt;span class=&quot;code-keyword&quot;&gt;null&lt;/span&gt;, &lt;span class=&quot;code-keyword&quot;&gt;null&lt;/span&gt;).stream()
            .map(ObjectInstance::getClassName)
            .collect(toSet());
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;p&gt;Ident for next lines in a long expression is 4 bytes.&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
        &lt;span class=&quot;code-keyword&quot;&gt;try&lt;/span&gt; {
            Ignite ignite = startGrid();

            validateMbeans(ignite, &lt;span class=&quot;code-quote&quot;&gt;&quot;org.apache.ignite.spi.discovery.zk.ZookeeperDiscoverySpi$ZookeeperDiscoverySpiMBeanImpl&quot;&lt;/span&gt;);
        }
        &lt;span class=&quot;code-keyword&quot;&gt;finally&lt;/span&gt; {
            stopAllGrids();
        }
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;p&gt;finally and catch clauses should be on a separate line.&lt;/p&gt;</comment>
                            <comment id="17036179" author="ignitetcbot" created="Thu, 13 Feb 2020 12:30:26 +0000"  >&lt;div class=&quot;panel&quot; style=&quot;border-color: #ccc;border-style: dashed;border-width: 1px;&quot;&gt;&lt;div class=&quot;panelHeader&quot; style=&quot;border-bottom-width: 1px;border-bottom-style: dashed;border-bottom-color: #ccc;background-color: #D6F7C1;&quot;&gt;&lt;b&gt;Branch: &lt;span class=&quot;error&quot;&gt;&amp;#91;pull/7369/head&amp;#93;&lt;/span&gt; Base: &lt;span class=&quot;error&quot;&gt;&amp;#91;master&amp;#93;&lt;/span&gt; : No blockers found!&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;
