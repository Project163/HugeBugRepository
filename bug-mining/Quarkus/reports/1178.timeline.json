eoand/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-07-06T08:14:40Z","updated_at":"2021-07-06T08:14:40Z","body":"Yes, it is required for remote-dev","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/874557282/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"geoand","id":4374975,"node_id":"MDQ6VXNlcjQzNzQ5NzU=","avatar_url":"https://avatars.githubusercontent.com/u/4374975?v=4","gravatar_id":"","url":"https://api.github.com/users/geoand","html_url":"https://github.com/geoand","followers_url":"https://api.github.com/users/geoand/followers","following_url":"https://api.github.com/users/geoand/following{/other_user}","gists_url":"https://api.github.com/users/geoand/gists{/gist_id}","starred_url":"https://api.github.com/users/geoand/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/geoand/subscriptions","organizations_url":"https://api.github.com/users/geoand/orgs","repos_url":"https://api.github.com/users/geoand/repos","events_url":"https://api.github.com/users/geoand/events{/privacy}","received_events_url":"https://api.github.com/users/geoand/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/874824995","html_url":"https://github.com/quarkusio/quarkus/issues/18439#issuecomment-874824995","issue_url":"https://api.github.com/repos/quarkusio/quarkus/issues/18439","id":874824995,"node_id":"MDEyOklzc3VlQ29tbWVudDg3NDgyNDk5NQ==","user":{"login":"cherrydev","id":1072616,"node_id":"MDQ6VXNlcjEwNzI2MTY=","avatar_url":"https://avatars.githubusercontent.com/u/1072616?v=4","gravatar_id":"","url":"https://api.github.com/users/cherrydev","html_url":"https://github.com/cherrydev","followers_url":"https://api.github.com/users/cherrydev/followers","following_url":"https://api.github.com/users/cherrydev/following{/other_user}","gists_url":"https://api.github.com/users/cherrydev/gists{/gist_id}","starred_url":"https://api.github.com/users/cherrydev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cherrydev/subscriptions","organizations_url":"https://api.github.com/users/cherrydev/orgs","repos_url":"https://api.github.com/users/cherrydev/repos","events_url":"https://api.github.com/users/cherrydev/events{/privacy}","received_events_url":"https://api.github.com/users/cherrydev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-07-06T14:45:43Z","updated_at":"2021-07-06T14:45:43Z","body":"Here's an implementation of a utility function that will fix this:\r\n``` java\r\n    private static void storePropertiesWithoutTimestamp(Properties props, OutputStream out, String comment) throws IOException {\r\n        Writer originalOut = new StringWriter();\r\n        props.store(originalOut, comment);\r\n        String originalOutString = originalOut.toString();\r\n        String sep = System.lineSeparator();\r\n        String[] lines = originalOutString.split(sep);\r\n        for (int lineNum = 0; lineNum < lines.length; lineNum++) {\r\n            if (lineNum == 1) continue;\r\n            String nextLine = (lineNum == lines.length - 1) ? lines[lineNum] : lines[lineNum] + sep;\r\n            out.write(nextLine.getBytes(StandardCharsets.ISO_8859_1));\r\n        }\r\n    }\r\n```\r\n8859-1 is the character set used in the Java 1.5-v9 implementation of `Properties#store()` and is also compatible with >v9 versions of `#load()`","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/874824995/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"cherrydev","id":1072616,"node_id":"MDQ6VXNlcjEwNzI2MTY=","avatar_url":"https://avatars.githubusercontent.com/u/1072616?v=4","gravatar_id":"","url":"https://api.github.com/users/cherrydev","html_url":"https://github.com/cherrydev","followers_url":"https://api.github.com/users/cherrydev/followers","following_url":"https://api.github.com/users/cherrydev/following{/other_user}","gists_url":"https://api.github.com/users/cherrydev/gists{/gist_id}","starred_url":"https://api.github.com/users/cherrydev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cherrydev/subscriptions","organizations_url":"https://api.github.com/users/cherrydev/orgs","repos_url":"https://api.github.com/users/cherrydev/repos","events_url":"https://api.github.com/users/cherrydev/events{/privacy}","received_events_url":"https://api.github.com/users/cherrydev/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/874878302","html_url":"https://github.com/quarkusio/quarkus/issues/18439#issuecomment-874878302","issue_url":"https://api.github.com/repos/quarkusio/quarkus/issues/18439","id":874878302,"node_id":"MDEyOklzc3VlQ29tbWVudDg3NDg3ODMwMg==","user":{"login":"cescoffier","id":402301,"node_id":"MDQ6VXNlcjQwMjMwMQ==","avatar_url":"https://avatars.githubusercontent.com/u/402301?v=4","gravatar_id":"","url":"https://api.github.com/users/cescoffier","html_url":"https://github.com/cescoffier","followers_url":"https://api.github.com/users/cescoffier/followers","following_url":"https://api.github.com/users/cescoffier/following{/other_user}","gists_url":"https://api.github.com/users/cescoffier/gists{/gist_id}","starred_url":"https://api.github.com/users/cescoffier/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cescoffier/subscriptions","organizations_url":"https://api.github.com/users/cescoffier/orgs","repos_url":"https://api.github.com/users/cescoffier/repos","events_url":"https://api.github.com/users/cescoffier/events{/privacy}","received_events_url":"https://api.github.com/users/cescoffier/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-07-06T15:51:33Z","updated_at":"2021-07-06T15:51:33Z","body":"Yes, the issue is that the properties file is updated with a timestamp and so requires rebuilding that layer and all the layers above. The proposed solution would work. Too bad that we can't disable that comment in https://docs.oracle.com/javase/10/docs/api/java/util/Properties.html#store(java.io.Writer,java.lang.String). ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/874878302/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"cescoffier","id":402301,"node_id":"MDQ6VXNlcjQwMjMwMQ==","avatar_url":"https://avatars.githubusercontent.com/u/402301?v=4","gravatar_id":"","url":"https://api.github.com/users/cescoffier","html_url":"https://github.com/cescoffier","followers_url":"https://api.github.com/users/cescoffier/followers","following_url":"https://api.github.com/users/cescoffier/following{/other_user}","gists_url":"https://api.github.com/users/cescoffier/gists{/gist_id}","starred_url":"https://api.github.com/users/cescoffier/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cescoffier/subscriptions","organizations_url":"https://api.github.com/users/cescoffier/orgs","repos_url":"https://api.github.com/users/cescoffier/repos","events_url":"https://api.github.com/users/cescoffier/events{/privacy}","received_events_url":"https://api.github.com/users/cescoffier/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":4986147042,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDQ5ODYxNDcwNDI=","url":"https://api.github.com/repos/quarkusio/quarkus/issues/events/4986147042","actor":{"login"