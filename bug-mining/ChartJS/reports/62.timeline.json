thub.com:chartjs/Chart.js.git","clone_url":"https://github.com/chartjs/Chart.js.git","svn_url":"https://github.com/chartjs/Chart.js","homepage":"https://www.chartjs.org/","size":43713,"stargazers_count":66876,"watchers_count":66876,"language":"JavaScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":11988,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":505,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["canvas","chart","graph","html5","html5-charts","javascript"],"visibility":"public","forks":11988,"open_issues":505,"watchers":66876,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/chartjs/Chart.js/pulls/6884","html_url":"https://github.com/chartjs/Chart.js/pull/6884","diff_url":"https://github.com/chartjs/Chart.js/pull/6884.diff","patch_url":"https://github.com/chartjs/Chart.js/pull/6884.patch","merged_at":"2020-01-15T22:13:36Z"},"body":"This is a proposed fix for https://github.com/chartjs/Chart.js/issues/6830\r\nPart of the problem described in the bug is due to the implementation using canvas - the canvas rendering context does not support a borderwidth of 0 [1]:\r\n\r\n> Zero, negative, Infinity, and NaN values are ignored. This value is 1.0 by default\r\n\r\nso setting the boderwidth to 0 does nothing. I'm not sure if that is really a bug. There are some unit tests that seem to assume that setting a boderwidth to zero will actually draw a border of 1 (the tests have been updated as part of this pull request) - but if the maintainers believe it is, I have proposed this potential fix.\r\n\r\nThis proposal also fixes the second problem in the issue, which is that points that aren't hovered over are acting as they are. This seems like it is definitely a bug. \r\n\r\nNote that similar issues may happen with borders set to zero for non-point elements. This fix is only for the point borderwidth problem originally described in the issue.\r\n\r\nBelow is a JSBIN demonstrating the original problem. [2]\r\n\r\nThe bottom row points should have no border. When hovering over a point, only those points should be animated, but all points to the right get highlighted instead.\r\n\r\n[1] https://developer.mozilla.org/en-US/docs/Web/API/CanvasRenderingContext2D/lineWidth\r\n[2] https://jsbin.com/yanorafobo/edit?html,output\r\n\r\n\r\n","reactions":{"url":"https://api.github.com/repos/chartjs/Chart.js/issues/6884/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/chartjs/Chart.js/issues/6884/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/chartjs/Chart.js/issues/comments/570039364","html_url":"https://github.com/chartjs/Chart.js/issues/6830#issuecomment-570039364","issue_url":"https://api.github.com/repos/chartjs/Chart.js/issues/6830","id":570039364,"node_id":"MDEyOklzc3VlQ29tbWVudDU3MDAzOTM2NA==","user":{"login":"silverma","id":1373279,"node_id":"MDQ6VXNlcjEzNzMyNzk=","avatar_url":"https://avatars.githubusercontent.com/u/1373279?v=4","gravatar_id":"","url":"https://api.github.com/users/silverma","html_url":"https://github.com/silverma","followers_url":"https://api.github.com/users/silverma/followers","following_url":"https://api.github.com/users/silverma/following{/other_user}","gists_url":"https://api.github.com/users/silverma/gists{/gist_id}","starred_url":"https://api.github.com/users/silverma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/silverma/subscriptions","organizations_url":"https://api.github.com/users/silverma/orgs","repos_url":