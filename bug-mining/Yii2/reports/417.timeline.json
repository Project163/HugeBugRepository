users/samdark/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/samdark/subscriptions","organizations_url":"https://api.github.com/users/samdark/orgs","repos_url":"https://api.github.com/users/samdark/repos","events_url":"https://api.github.com/users/samdark/events{/privacy}","received_events_url":"https://api.github.com/users/samdark/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"milestoned","commit_id":null,"commit_url":null,"created_at":"2015-08-13T07:56:26Z","milestone":{"title":"2.0.x"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/yiisoft/yii2/issues/comments/132097206","html_url":"https://github.com/yiisoft/yii2/issues/9314#issuecomment-132097206","issue_url":"https://api.github.com/repos/yiisoft/yii2/issues/9314","id":132097206,"node_id":"MDEyOklzc3VlQ29tbWVudDEzMjA5NzIwNg==","user":{"login":"hesna","id":2319368,"node_id":"MDQ6VXNlcjIzMTkzNjg=","avatar_url":"https://avatars.githubusercontent.com/u/2319368?v=4","gravatar_id":"","url":"https://api.github.com/users/hesna","html_url":"https://github.com/hesna","followers_url":"https://api.github.com/users/hesna/followers","following_url":"https://api.github.com/users/hesna/following{/other_user}","gists_url":"https://api.github.com/users/hesna/gists{/gist_id}","starred_url":"https://api.github.com/users/hesna/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hesna/subscriptions","organizations_url":"https://api.github.com/users/hesna/orgs","repos_url":"https://api.github.com/users/hesna/repos","events_url":"https://api.github.com/users/hesna/events{/privacy}","received_events_url":"https://api.github.com/users/hesna/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-08-18T07:09:13Z","updated_at":"2015-08-18T07:09:13Z","body":"I have the same problem. my case is much simpler though. I have a user and it has just one permission.\nthe permission is assigned to user directly, there are no roles involved:\n\n``` php\nYii::$app->authManager->assign($permision, $userId);\n```\n\n`getPermissionsByUser()` method returns an empty array. looking at its code, it seems that it does not look for directly assigned permissions to a user. it just tries to return permissions that are inherited from an assigned role:\n\n``` php\n        $query = (new Query)->select('item_name')\n            ->from($this->assignmentTable)\n            ->where(['user_id' => (string) $userId]);\n\n        $childrenList = $this->getChildrenList();\n        $result = [];\n        foreach ($query->column($this->db) as $roleName) {\n            // $result is empty because there are no roles assigned to this user.\n            $this->getChildrenRecursive($roleName, $childrenList, $result);\n        }\n\n        if (empty($result)) {\n            // but this user has a direct permission, we should check for that before returning empty!\n            return [];\n        }\n```\n\nAlso in the case @yrssoft described system is returning inherited permissions, but not directly assigned permission (permission1 and permission2).\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yiisoft/yii2/issues/comments/132097206/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"hesna","id":2319368,"node_id":"MDQ6VXNlcjIzMTkzNjg=","avatar_url":"https://avatars.githubusercontent.com/u/2319368?v=4","gravatar_id":"","url":"https://api.github.com/users/hesna","html_url":"https://github.com/hesna","followers_url":"https://api.github.com/users/hesna/followers","following_url":"https://api.github.com/users/hesna/following{/other_user}","gists_url":"https://api.github.com/users/hesna/gists{/gist_id}","starred_url":"https://api.github.com/users/hesna/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hesna/subs