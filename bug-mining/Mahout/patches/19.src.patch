+		<module name="TodoComment">
+			<property name="format" value="WARNING" />
+		</module>
+
+		<module name="UpperEll" />
+
+		<!--Assert statement may have side effects:-->
+		<module name="DescendantToken">
+			<property name="tokens" value="LITERAL_ASSERT" />
