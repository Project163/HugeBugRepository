idc/repos","events_url":"https://api.github.com/users/ruidc/events{/privacy}","received_events_url":"https://api.github.com/users/ruidc/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2012-08-22T12:11:18Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/pandas-dev/pandas/issues/comments/8310140","html_url":"https://github.com/pandas-dev/pandas/issues/1799#issuecomment-8310140","issue_url":"https://api.github.com/repos/pandas-dev/pandas/issues/1799","id":8310140,"node_id":"MDEyOklzc3VlQ29tbWVudDgzMTAxNDA=","user":{"login":"lodagro","id":1094464,"node_id":"MDQ6VXNlcjEwOTQ0NjQ=","avatar_url":"https://avatars.githubusercontent.com/u/1094464?v=4","gravatar_id":"","url":"https://api.github.com/users/lodagro","html_url":"https://github.com/lodagro","followers_url":"https://api.github.com/users/lodagro/followers","following_url":"https://api.github.com/users/lodagro/following{/other_user}","gists_url":"https://api.github.com/users/lodagro/gists{/gist_id}","starred_url":"https://api.github.com/users/lodagro/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lodagro/subscriptions","organizations_url":"https://api.github.com/users/lodagro/orgs","repos_url":"https://api.github.com/users/lodagro/repos","events_url":"https://api.github.com/users/lodagro/events{/privacy}","received_events_url":"https://api.github.com/users/lodagro/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2012-09-05T19:04:17Z","updated_at":"2012-09-05T19:04:17Z","body":"Just spend a bit of time on fixing this.\n\n``` python\nIn [9]: df\nOut[9]: \n           1         2         3\n1   0.476835 -0.541463  0.142869\n10  2.027024  0.434206 -1.092403\nC   1.108003  1.692173 -1.413435\nE   0.688612 -1.082818  1.289867\n\nIn [10]: df.ix[10]\nOut[10]: \n1    2.027024\n2    0.434206\n3   -1.092403\nName: 10\n\nIn [11]: df.ix[[1, 10]]\nOut[11]: \n           1         2         3\n1   0.476835 -0.541463  0.142869\n10  2.027024  0.434206 -1.092403\n```\n\nWhen starting to fix the slices and df.ix[list], i noticed that slicing from label to position (or reversed) and selecting a range with both labels and positions on 0.8.1 has (at least for me) unexpected behavior (even for indexes without integers). So what can we expect from pandas to behave in these situations?\n\n``` python\nIn [24]: df\nOut[24]: \n          A         B         C         D         E\na  0.613189  0.689797 -0.234561  2.147688 -2.809169\nb  0.203202  0.025470  0.862836  1.250575  1.166273\nc  0.002628  0.413194 -1.367218  1.112502  0.059427\nd -2.734778 -1.671669  0.029811 -1.469516 -0.043275\ne  1.560336  0.845640  1.517610 -0.861052 -0.206302\n\nIn [25]: df.ix[[2, 'e']]\nOut[25]: \n          A        B        C         D         E\n2       NaN      NaN      NaN       NaN       NaN\ne  1.560336  0.84564  1.51761 -0.861052 -0.206302\n\nIn [26]: df.ix[2:'e']\nOut[26]: \n          A         B         C         D         E\na  0.613189  0.689797 -0.234561  2.147688 -2.809169\nb  0.203202  0.025470  0.862836  1.250575  1.166273\nc  0.002628  0.413194 -1.367218  1.112502  0.059427\nd -2.734778 -1.671669  0.029811 -1.469516 -0.043275\ne  1.560336  0.845640  1.517610 -0.861052 -0.206302\n\nIn [27]: df.ix[['b', 4]]\nOut[27]: \n          A        B         C         D         E\nb  0.203202  0.02547  0.862836  1.250575  1.166273\n4       NaN      NaN       NaN       NaN       NaN\n\nIn [28]: df.ix['b':4]\nOut[28]: \nEmpty DataFrame\nColumns: array([A, B, C, D, E], dtype=object)\nIndex: array([], dtype=object)\n```\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/pandas-dev/pandas/issues/comments/8310140/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"lodagro","id":1094464,"n