omments":1,"created_at":"2019-04-11T17:03:19Z","updated_at":"2019-04-12T19:27:16Z","closed_at":"2019-04-12T19:27:16Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"When a row is deleted from a table with index, the index entry is not deleted. This can cause a subsequent insert to fail when the index is unique. For example,\r\n\r\n```\r\npostgres=# create table t (k int primary key, v int); \r\nCREATE TABLE\r\npostgres=# create unique index on t (v);\r\nCREATE INDEX\r\npostgres=# insert into t values (1, 1);\r\nINSERT 0 1\r\npostgres=# delete from t where k = 1;\r\nDELETE 1\r\npostgres=# insert into t values (1, 1);\r\nERROR:  Query error: Duplicate key found in primary key or unique index\r\n```","closed_by":{"login":"robertpang","id":30942926,"node_id":"MDQ6VXNlcjMwOTQyOTI2","avatar_url":"https://avatars.githubusercontent.com/u/30942926?v=4","gravatar_id":"","url":"https://api.github.com/users/robertpang","html_url":"https://github.com/robertpang","followers_url":"https://api.github.com/users/robertpang/followers","following_url":"https://api.github.com/users/robertpang/following{/other_user}","gists_url":"https://api.github.com/users/robertpang/gists{/gist_id}","starred_url":"https://api.github.com/users/robertpang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/robertpang/subscriptions","organizations_url":"https://api.github.com/users/robertpang/orgs","repos_url":"https://api.github.com/users/robertpang/repos","events_url":"https://api.github.com/users/robertpang/events{/privacy}","received_events_url":"https://api.github.com/users/robertpang/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/1193/reactions","total_count":0,"+1":0,"-1":