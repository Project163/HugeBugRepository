-07T13:30:23Z","updated_at":"2025-12-12T11:48:01Z","pushed_at":"2025-12-11T20:11:30Z","git_url":"git://github.com/python/mypy.git","ssh_url":"git@github.com:python/mypy.git","clone_url":"https://github.com/python/mypy.git","svn_url":"https://github.com/python/mypy","homepage":"https://www.mypy-lang.org/","size":77161,"stargazers_count":20064,"watchers_count":20064,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":3065,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":3124,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["linter","python","typechecker","types","typing"],"visibility":"public","forks":3065,"open_issues":3124,"watchers":20064,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"`test_mypy.py`:\r\n\r\n```python\r\nimport pymongo # this can be any third-party module without stubs\r\n\r\nCollection = pymongo.collection.Collection\r\n\r\ndef func(a: Collection) -> bool:\r\n   return True\r\n```\r\n\r\nHere's the output of `mypy test_mypy.py` :\r\n\r\n```\r\ntest_mypy.py:1: error: No library stub file for module 'pymongo'\r\ntest_mypy.py:1: note: (Stub files are from https://github.com/python/typeshed)\r\ntest_mypy.py: note: In function \"func\":\r\ntest_mypy.py:5: error: Invalid type \"test_mypy.Collection\"\r\n```\r\n\r\nHowever, if I change `test_mypy.py` to this:\r\n\r\n```python\r\nimport pymongo\r\n\r\ndef func(a: pymongo.collection.Collection) -> bool:\r\n  return True\r\n```\r\nthen `mypy` does not complain about `pymongo.collection.Collection` being an invalid type. This seems inconsistent/wrong, `Collection` is not an invalid type, it's just an alias for a type without a stub.","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/2801/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/mypy/issues/2801/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":962914375,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDk2MjkxNDM3NQ==","url":"https://api.github.com/repos/python/mypy/issues/events/962914375","actor":{"login":"elazarg","id":5108069,"node_id":"MDQ6VXNlcjUxMDgwNjk=","avatar_url":"https://avatars.githubusercontent.com/u/5108069?v=4","gravatar_id":"","url":"https://api.github.com/users/elazarg","html_url":"https://github.com/elazarg","followers_url":"https://api.github.com/users/elazarg/followers","following_url":"https://api.github.com/users/elazarg/following{/other_user}","gists_url":"https://api.github.com/users/elazarg/gists{/gist_id}","starred_url":"https://api.github.com/users/elazarg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elazarg/subscriptions","organizations_url":"https://api.github.com/users/elazarg/orgs","repos_url":"https://api.github.com/users/elazarg/repos","events_url":"https://api.github.com/users/elazarg/events{/privacy}","received_events_url":"https://api.github.com/users/elazarg/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"c5142a137b8f0af3508a1d6509ba9e9fc1db43b1","commit_url":"https://api.github.com/repos/elazarg/mypy/commits/c5142a137b8f0af3508a1d6509ba9e9fc1db43b1","created_at":"2017-02-15T11:21:52Z","performed_via_github_app":null},{"actor":{"login":"elazarg","id":5108069,"node_id":"MDQ6VXNlcjUxMDgwNjk=","avatar_url":"https://avatars.githubusercontent.com/u/5108069?v=4","gravatar_id":"","url":"https://api.github.com/users/elazarg","html_url":"https://github.com/elazarg","followers_url":"https://api.github.com/users/elazarg/followers","following_url":"https://api.github.com/users/elazarg/following{/other_us