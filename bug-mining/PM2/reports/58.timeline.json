/cfi2017/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2018-08-28T14:06:45Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/Unitech/pm2/issues/comments/416642405","html_url":"https://github.com/Unitech/pm2/issues/3883#issuecomment-416642405","issue_url":"https://api.github.com/repos/Unitech/pm2/issues/3883","id":416642405,"node_id":"MDEyOklzc3VlQ29tbWVudDQxNjY0MjQwNQ==","user":{"login":"cfi2017","id":20141618,"node_id":"MDQ6VXNlcjIwMTQxNjE4","avatar_url":"https://avatars.githubusercontent.com/u/20141618?v=4","gravatar_id":"","url":"https://api.github.com/users/cfi2017","html_url":"https://github.com/cfi2017","followers_url":"https://api.github.com/users/cfi2017/followers","following_url":"https://api.github.com/users/cfi2017/following{/other_user}","gists_url":"https://api.github.com/users/cfi2017/gists{/gist_id}","starred_url":"https://api.github.com/users/cfi2017/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cfi2017/subscriptions","organizations_url":"https://api.github.com/users/cfi2017/orgs","repos_url":"https://api.github.com/users/cfi2017/repos","events_url":"https://api.github.com/users/cfi2017/events{/privacy}","received_events_url":"https://api.github.com/users/cfi2017/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-08-28T15:59:30Z","updated_at":"2018-08-28T15:59:30Z","body":"It doesn't look like it's defined as a type. It seems to work if I create a startOptions object like this:\r\n```typescript\r\nconst startOptions: StartOptions = {} as StartOptions;\r\n```\r\nand then add `wait_ready` like this:\r\n```typescript\r\nstartOptions['wait_ready'] = true;\r\n```\r\n\r\nAdditionally, it seems I can add `max_memory_restart` as a number (`4294967296`), but it doesn't seem to affect the actual configuration.\r\n\r\nMy full configuration and launching script is as follows: (In this example, max_memory_restart has no effect.)\r\n\r\n```typescript\r\nconst startOptions: StartOptions = {\r\n  script: 'target/index.js',\r\n  name: 'Worker#' + workerNumber,\r\n  kill_timeout: 30000,\r\n  watch: true,\r\n  max_memory_restart: 4294967296,\r\n  autorestart: false,\r\n  env: {\r\n    NODE_ENV: 'development'\r\n  },\r\n  args: [output, '--deleteOutput=' + options.deleteOutput, '--selfLaunched']\r\n} as StartOptions;\r\n\r\nstartOptions['wait_ready'] = true;\r\n\r\npm2.start(startOptions, (err2, apps) => {\r\n  // Post-initialization code\r\n});\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/Unitech/pm2/issues/comments/416642405/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"cfi2017","id":20141618,"node_id":"MDQ6VXNlcjIwMTQxNjE4","avatar_url":"https://avatars.githubusercontent.com/u/20141618?v=4","gravatar_id":"","url":"https://api.github.com/users/cfi2017","html_url":"https://github.com/cfi2017","followers_url":"https://api.github.com/users/cfi2017/followers","following_url":"https://api.github.com/users/cfi2017/following{/other_user}","gists_url":"https://api.github.com/users/cfi2017/gists{/gist_id}","starred_url":"https://api.github.com/users/cfi2017/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cfi2017/subscriptions","organizations_url":"https://api.github.com/users/cfi2017/orgs","repos_url":"https://api.github.com/users/cfi2017/repos","events_url":"https://api.github.com/users/cfi2017/events{/privacy}","received_events_url":"https://api.github.com/users/cfi2017/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1816059819,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDE4MTYwNTk4MTk=","url":"https://api.github.com/repos/Unitech/pm2/issues/events/1816059819","actor":{"login":"wallet77","id":5022887,"node_id":"MDQ6VXNlcjUw