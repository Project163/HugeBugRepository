-              Iterables.addAll(theWords, onSpace.split(line));
-              return true;
-            }
-
-            @Override
-            public List<String> getResult() {
-              return theWords;
-            }
-          });
-      } catch (IOException e) {
-        throw new ImpossibleException(e);
-      }
-    }
-
-    @Override
-    public String convert(int i) {
-      if (i < words.size()) {
