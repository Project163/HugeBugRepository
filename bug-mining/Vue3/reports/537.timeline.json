mkit/formkit/milestones{/number}","notifications_url":"https://api.github.com/repos/formkit/formkit/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/formkit/formkit/labels{/name}","releases_url":"https://api.github.com/repos/formkit/formkit/releases{/id}","deployments_url":"https://api.github.com/repos/formkit/formkit/deployments","created_at":"2021-06-02T21:35:19Z","updated_at":"2026-03-08T16:38:24Z","pushed_at":"2025-12-22T21:42:50Z","git_url":"git://github.com/formkit/formkit.git","ssh_url":"git@github.com:formkit/formkit.git","clone_url":"https://github.com/formkit/formkit.git","svn_url":"https://github.com/formkit/formkit","homepage":"https://formkit.com","size":8463,"stargazers_count":4649,"watchers_count":4649,"language":"TypeScript","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":200,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":152,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["form-generation","forms","validation","vue"],"visibility":"public","forks":200,"open_issues":152,"watchers":4649,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"### Reproduction\n\nhttps://github.com/formkit/formkit/blob/6b4542a3e013bfff810e126eb20eb2fbce6f25af/packages/vue/src/FormKitSchema.ts\n\n### Describe the bug\n\nHi,\r\n\r\nsorry for passing only the link to the code where the exception is thrown, but you need some more complex application where you toggle between multiple components that includes a FormkitSchema component.\r\n\r\nAfter switching to Vue 3.5 it seems that data on cleanup can be null.\r\n\r\n```\r\n    /**\r\n     * Perform cleanup operations when the component is unmounted. This should\r\n     * remove any memory allocations that were made during the render process.\r\n     */\r\n    function cleanUp() {\r\n      // Perform cleanup operations\r\n      clean(props.schema, props.memoKey, instanceKey)\r\n      /* eslint-disable @typescript-eslint/no-non-null-assertion */\r\n      if (data.node) data.node.destroy()\r\n      data.slots = null!\r\n      data = null!\r\n      render = null!\r\n      /* eslint-enable @typescript-eslint/no-non-null-assertion */\r\n    }```\r\n\r\nAccess data.node throws part throws exception:\r\n\r\n```\r\nUncaught (in promise) TypeError: Cannot read properties of null (reading 'node')\r\n    at cleanUp (@formkit_vue.js?v=c3cff561:1581:16)\r\n    at chunk-CXSE3S54.js?v=c3cff561:4847:40\r\n    at callWithErrorHandling (chunk-CXSE3S54.js?v=c3cff561:2288:19)\r\n    at callWithAsyncErrorHandling (chunk-CXSE3S54.js?v=c3cff561:2295:17)\r\n    at hook.__weh.hook.__weh (chunk-CXSE3S54.js?v=c3cff561:4827:19)\r\n    at flushPostFlushCbs (chunk-CXSE3S54.js?v=c3cff561:2474:28)\r\n    at flushJobs (chunk-CXSE3S54.js?v=c3cff561:2516:5)\r\n```\r\n\r\nChanging back to Vue 3.4 fix the issue.\r\n\r\nGreetings,\r\n\r\nTom\r\n \n\n### Environment\n\n• OS: MacOS 14.6.1\r\n• Browser Chrome\r\n• Version 128.0.6613.120 (Offizieller Build) (arm64)\r\n\r\n","reactions":{"url":"https://api.github.com/repos/formkit/formkit/issues/1496/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/formkit/formkit/issues/1496/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}},"event":"cross-referenced"},{"id":14464221893,"node_id":"LOE_lADOCCum186WnH7rzwAAAANeIoLF","url":"https://api.github.com/repos/vuejs/core/issues/events/14464221893","actor":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars