-    const Status s = STATUS(InvalidArgument, "Could not find snapshot", req->snapshot_id());
-    return SetupError(resp->mutable_error(), MasterErrorPB::SNAPSHOT_NOT_FOUND, s);
-  }
-
-  auto snapshot_lock = snapshot->LockForWrite();
