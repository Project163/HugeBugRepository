&lt;p&gt;    &lt;a href=&quot;https://github.com/apache/ignite/pull/2335&quot; class=&quot;external-link&quot; target=&quot;_blank&quot; rel=&quot;nofollow noopener&quot;&gt;https://github.com/apache/ignite/pull/2335&lt;/a&gt;&lt;/p&gt;

&lt;p&gt;    &lt;a href=&quot;https://issues.apache.org/jira/browse/IGNITE-5806&quot; title=&quot;IgniteCache5 suite timed out, assertions in sessions close logic&quot; class=&quot;issue-link&quot; data-issue-key=&quot;IGNITE-5806&quot;&gt;&lt;del&gt;IGNITE-5806&lt;/del&gt;&lt;/a&gt;: removed assertion failing Ignite Cache 5 suite&lt;/p&gt;



