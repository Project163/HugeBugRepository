.com/users/climba03003","html_url":"https://github.com/climba03003","followers_url":"https://api.github.com/users/climba03003/followers","following_url":"https://api.github.com/users/climba03003/following{/other_user}","gists_url":"https://api.github.com/users/climba03003/gists{/gist_id}","starred_url":"https://api.github.com/users/climba03003/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/climba03003/subscriptions","organizations_url":"https://api.github.com/users/climba03003/orgs","repos_url":"https://api.github.com/users/climba03003/repos","events_url":"https://api.github.com/users/climba03003/events{/privacy}","received_events_url":"https://api.github.com/users/climba03003/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/fastify/fastify/issues/comments/907563340","html_url":"https://github.com/fastify/fastify/issues/3283#issuecomment-907563340","issue_url":"https://api.github.com/repos/fastify/fastify/issues/3283","id":907563340,"node_id":"IC_kwDOBCRpgs42GFFM","user":{"login":"climba03003","id":23028015,"node_id":"MDQ6VXNlcjIzMDI4MDE1","avatar_url":"https://avatars.githubusercontent.com/u/23028015?v=4","gravatar_id":"","url":"https://api.github.com/users/climba03003","html_url":"https://github.com/climba03003","followers_url":"https://api.github.com/users/climba03003/followers","following_url":"https://api.github.com/users/climba03003/following{/other_user}","gists_url":"https://api.github.com/users/climba03003/gists{/gist_id}","starred_url":"https://api.github.com/users/climba03003/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/climba03003/subscriptions","organizations_url":"https://api.github.com/users/climba03003/orgs","repos_url":"https://api.github.com/users/climba03003/repos","events_url":"https://api.github.com/users/climba03003/events{/privacy}","received_events_url":"https://api.github.com/users/climba03003/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-08-28T04:03:19Z","updated_at":"2021-08-28T04:05:48Z","body":"Example 1:\r\nIt is correct behavior.\r\n\r\nExample 2:\r\nYou need to ensure the `payload` is one of the following type which stated in the document clearly.\r\nhttps://github.com/fastify/fastify/blob/main/docs/Reply.md#type-of-the-final-payload\r\n\r\nWhen using a custom `content-type` it skip all the serializing code\r\nhttps://github.com/fastify/fastify/blob/a04f4c952731c57e79c6ca3794a62959a43731ed/lib/reply.js#L139-L191\r\n\r\nSo, it directly pass `object` to the `res.end` and it throw an error.\r\nI can confirm it is a bug due to `onSendHook` set `kReplySent` to `true`.\r\nhttps://github.com/fastify/fastify/blob/a04f4c952731c57e79c6ca3794a62959a43731ed/lib/reply.js#L380\r\nThen `onSendEnd` cannot properly throw and send the error message.\r\nhttps://github.com/fastify/fastify/blob/a04f4c952731c57e79c6ca3794a62959a43731ed/lib/reply.js#L429-L431\r\n\r\nExample 3:\r\nIt is intended behavior to always set `charset` when we see `application/json` only `content-type`.\r\nhttps://github.com/fastify/fastify/blob/a04f4c952731c57e79c6ca3794a62959a43731ed/lib/reply.js#L170-L173","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/fastify/fastify/issues/comments/907563340/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"climba03003","id":23028015,"node_id":"MDQ6VXNlcjIzMDI4MDE1","avatar_url":"https://avatars.githubusercontent.com/u/23028015?v=4","gravatar_id":"","url":"https://api.github.com/users/climba03003","html_url":"https://github.com/climba03003","followers_url":"https://api.github.com/users/climba03003/followers","following_url":"https://api.github.com/users/climba03003/following{/other_user}","gists_url":"https://api.github.com/users/climba03003/gists{/gist_id}","starred_url":"https://