/prokher","followers_url":"https://api.github.com/users/prokher/followers","following_url":"https://api.github.com/users/prokher/following{/other_user}","gists_url":"https://api.github.com/users/prokher/gists{/gist_id}","starred_url":"https://api.github.com/users/prokher/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/prokher/subscriptions","organizations_url":"https://api.github.com/users/prokher/orgs","repos_url":"https://api.github.com/users/prokher/repos","events_url":"https://api.github.com/users/prokher/events{/privacy}","received_events_url":"https://api.github.com/users/prokher/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1778550026,"node_id":"MDEyOkxhYmVsZWRFdmVudDE3Nzg1NTAwMjY=","url":"https://api.github.com/repos/pylint-dev/pylint/issues/events/1778550026","actor":{"login":"PCManticore","id":448166,"node_id":"MDQ6VXNlcjQ0ODE2Ng==","avatar_url":"https://avatars.githubusercontent.com/u/448166?v=4","gravatar_id":"","url":"https://api.github.com/users/PCManticore","html_url":"https://github.com/PCManticore","followers_url":"https://api.github.com/users/PCManticore/followers","following_url":"https://api.github.com/users/PCManticore/following{/other_user}","gists_url":"https://api.github.com/users/PCManticore/gists{/gist_id}","starred_url":"https://api.github.com/users/PCManticore/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PCManticore/subscriptions","organizations_url":"https://api.github.com/users/PCManticore/orgs","repos_url":"https://api.github.com/users/PCManticore/repos","events_url":"https://api.github.com/users/PCManticore/events{/privacy}","received_events_url":"https://api.github.com/users/PCManticore/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2018-08-08T19:05:57Z","label":{"name":"bug","color":"ea9896"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/pylint-dev/pylint/issues/comments/411518711","html_url":"https://github.com/pylint-dev/pylint/issues/2379#issuecomment-411518711","issue_url":"https://api.github.com/repos/pylint-dev/pylint/issues/2379","id":411518711,"node_id":"MDEyOklzc3VlQ29tbWVudDQxMTUxODcxMQ==","user":{"login":"PCManticore","id":448166,"node_id":"MDQ6VXNlcjQ0ODE2Ng==","avatar_url":"https://avatars.githubusercontent.com/u/448166?v=4","gravatar_id":"","url":"https://api.github.com/users/PCManticore","html_url":"https://github.com/PCManticore","followers_url":"https://api.github.com/users/PCManticore/followers","following_url":"https://api.github.com/users/PCManticore/following{/other_user}","gists_url":"https://api.github.com/users/PCManticore/gists{/gist_id}","starred_url":"https://api.github.com/users/PCManticore/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PCManticore/subscriptions","organizations_url":"https://api.github.com/users/PCManticore/orgs","repos_url":"https://api.github.com/users/PCManticore/repos","events_url":"https://api.github.com/users/PCManticore/events{/privacy}","received_events_url":"https://api.github.com/users/PCManticore/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-08-08T19:09:33Z","updated_at":"2018-08-08T19:09:33Z","body":"Hey folks, I can also reproduce this bug. \r\n\r\nThe problem is that in 2.1 `pylint` got a bit smarter with respect to `not-an-iterable`, since it can understand when a `for` loop doesn't work with an async iterator and vice versa. But at the same time, it's not yet aware of the fact that `a_iter` is not a normal generator, but rather an async version of it. You can test this problem with the following snippet:\r\n\r\n ```\r\nfrom astroid import extract_node\r\nn = extract_node('''\r\nasync def a_iter(n):\r\n    \"\"\" emits 1 number per second  \"\"\"\r\n    for i in range(1, n+1):\r\n        yield i\r\n        await asyncio.sleep(1)\r\n\r\na_iter(n)\r\n''')\r\ni = next(n.infer())\r\nprint(i) # Prints that it's an generator, not an AsyncGenerator\r\n```\r\nIn this case, it should infer that the output of `a_iter` is going to be an AsyncGenerator and thus `async for` is perfectly fine for it, but it doesn't do that right now.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/pylint-dev/pylint/issues/comments/411518711/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"PCManticore","id":448166,"node_id":"MDQ6VXNlcjQ0ODE2Ng==","avatar_url":"https://avatars.githubusercontent.com/u/448166?v=4","gravatar_id":"","url":"https://api.github.com/users/PCManticore","html_url":"https://github.com/PCManticore","followers_url":"https://api.github.com/users/PCManticore/followers","following_url":"https://api.github.com/users/PCManticore/following{/other_user}","gists_url":"https://api.github.com/users/PCManticore/gists{/gist_id}","starred_url":"https://api.github.com/users/PCManticore/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PCManticore/subscriptions","organizations_url":"https://api.github.com/users/PCManticore/orgs","repos_url":"https://api.github.com/users/PCManticore/repos","events_url":"https://api.github.com/users/PCManticore/events{/privacy}","received_events_url":"https://api.github.com/users/PCManticore/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1778558262,"node_id":"MDEyOkxhYmVsZWRFdmVudDE3Nzg1NTgyNjI=","url":"https://api.github.com/repos/pylint-dev/pylint/issues/events/1778558262","actor":{"login":"PCManticore","id":448166,"node_id":"MDQ6VXNlcjQ0ODE2Ng==","avatar_url":"https://avatars.githubusercontent.com/u/448166?v=4","gravatar_id":"","url":"https://api.github.com/users/PCManticore","html_url":"https://github.com/PCManticore","followers_url":"https://api.github.com/users/PCManticore/follo