+bool TSManager::IsTsBlacklisted(const TSDescSharedPtr& ts,
+    const BlacklistSet blacklist) {
+  if (blacklist.empty()) {
+    return false;
+  }
+  for (const auto tserver : blacklist) {
+    HostPortPB hp;
+    HostPortToPB(tserver, &hp);
+    if (ts->IsRunningOn(hp)) {
+      return true;
+    }
+  }
+  return false;
 }
 
