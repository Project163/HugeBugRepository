se},"event":"milestoned","commit_id":null,"commit_url":null,"created_at":"2020-04-23T13:58:55Z","milestone":{"title":"1.3.x"},"performed_via_github_app":null},{"id":3265125202,"node_id":"MDE3OlJlbmFtZWRUaXRsZUV2ZW50MzI2NTEyNTIwMg==","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/3265125202","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2020-04-23T14:01:26Z","rename":{"from":"Column.copy() doesn't copy dialect_options such as encoding etc. into the new object","to":"Column.copy() doesn't copy dialect_options such as encoding etc. into the new object (all schema items, Table, etc same issue)"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/618418459","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/5276#issuecomment-618418459","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5276","id":618418459,"node_id":"MDEyOklzc3VlQ29tbWVudDYxODQxODQ1OQ==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-04-23T14:13:21Z","updated_at":"2020-04-23T14:13:21Z","body":"as the poster was not able to provide an MCVE, I will provide one here, which includes all the major objects for which this functionality should be both completed as well as tested, within test/sql/test_metadata.py\r\n\r\n```\r\nfrom sqlalchemy import Column\r\nfrom sqlalchemy import Integer\r\nfrom sqlalchemy import MetaData\r\nfrom sqlalchemy import Table\r\nfrom sqlalchemy.dialects import registry\r\nfrom sqlalchemy.engine import default\r\nfrom sqlalchemy.schema import Index\r\nfrom sqlalchemy.schema import PrimaryKeyConstraint, UniqueConstraint\r\n\r\n\r\nclass MyDialect(default.DefaultDialect):\r\n    construct_arguments = [\r\n        (Table, {\"some_table_arg\": None}),\r\n        (Column, {\"some_column_arg\": None}),\r\n        (Index, {\"some_index_arg\": None}),\r\n        (PrimaryKeyConstraint, {\"some_pk_arg\": None}),\r\n        (UniqueConstraint, {\"some_uq_arg\": None}),\r\n    ]\r\n\r\n\r\nregistry.register(\"mydialect\", \"__main__\", \"MyDialect\")\r\n\r\n\r\nt = Table(\r\n    \"t\",\r\n    MetaData(),\r\n    Column(\"foo\", Integer, mydialect_some_column_arg=\"a2\"),\r\n    Column(\"bar\", Integer),\r\n    PrimaryKeyConstraint(\"foo\", mydialect_some_pk_arg=\"a3\"),\r\n    UniqueConstraint(\"bar\", mydialect_some_uq_arg=\"a5\"),\r\n    mydialect_some_table_arg=\"a1\",\r\n)\r\n\r\nIndex(\"idx\", t.c.foo, mydialect_some_index_arg=\"a4\")\r\n\r\n\r\ndef assert_seems_to_work_(t):\r\n    assert t.dialect_kwargs[\"mydialect_some_table_arg\"] == \"a1\"\r\n    assert (\r\n        list(t.indexes)[0].dialect_kwargs[\"mydialect_some_index_arg\"] == \"a4\"\r\n    )\r\n\r\n\r\ndef assert_seems_broken_(t):\r\n    assert (\r\n        list(c for c in t.constraints if isinstance(c, UniqueConstraint))[\r\n            0\r\n        ].dialect_kwargs[\"mydialect_some_uq_arg\"]\r\n        == \"a5\"\r\n    )\r\n    assert t.c.foo.dialect_kwargs[\"mydialect_some_column_arg\"] == \"a2\"\r\n    assert t.primary_key.dialect_kwargs[\"mydialect_some_pk_arg\"] == \"a3\"\r\n\r\n\r\nassert_seems_to_work_(t)\r\nassert_seems_broken_(t)\r\n\r\n\r\nm2 = MetaData()\r\nt2 = t.tometadata(m2)\r\n\r\nassert_seems_to_work_(t2)\r\n\r\n# failures begin here\r\nassert_seems_broken_(t2)\r\n\r\n```\r\n\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/618418459/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","or