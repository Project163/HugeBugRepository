thub.com/users/christosts/following{/other_user}","gists_url":"https://api.github.com/users/christosts/gists{/gist_id}","starred_url":"https://api.github.com/users/christosts/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/christosts/subscriptions","organizations_url":"https://api.github.com/users/christosts/orgs","repos_url":"https://api.github.com/users/christosts/repos","events_url":"https://api.github.com/users/christosts/events{/privacy}","received_events_url":"https://api.github.com/users/christosts/received_events","type":"User","user_view_type":"public","site_admin":false},"performed_via_github_app":null},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/745448315","html_url":"https://github.com/google/ExoPlayer/issues/8323#issuecomment-745448315","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/8323","id":745448315,"node_id":"MDEyOklzc3VlQ29tbWVudDc0NTQ0ODMxNQ==","user":{"login":"christosts","id":54315740,"node_id":"MDQ6VXNlcjU0MzE1NzQw","avatar_url":"https://avatars.githubusercontent.com/u/54315740?v=4","gravatar_id":"","url":"https://api.github.com/users/christosts","html_url":"https://github.com/christosts","followers_url":"https://api.github.com/users/christosts/followers","following_url":"https://api.github.com/users/christosts/following{/other_user}","gists_url":"https://api.github.com/users/christosts/gists{/gist_id}","starred_url":"https://api.github.com/users/christosts/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/christosts/subscriptions","organizations_url":"https://api.github.com/users/christosts/orgs","repos_url":"https://api.github.com/users/christosts/repos","events_url":"https://api.github.com/users/christosts/events{/privacy}","received_events_url":"https://api.github.com/users/christosts/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-12-15T17:36:05Z","updated_at":"2020-12-15T17:37:00Z","body":"We inspected the code and saw there is a case where this may happen: if the playlist has a subtitles track but it does not include a URI for the subtitles. This would be in violation of the HLS spec, but the player at the moment does not raise an exception immediately. As a result, a null value may be inserted in the `playlistUrls`  array. We are going to fix this and it will be available to the dev-v2 branch in the coming days. The fix would make the player fail fast and make this error more obvious. \r\n\r\nOur hypothesis of what is probably happening: the playlist does not have a URI for subtitles but the player does not raise a parse exception, therefore it contains the null element in the array. This is not causing an error immediately because subtitles are not displayed, then later a possibly unrelated error triggers the onLoadError() event (HTTP 404 maybe?) which eventually raises the NPE.\r\n\r\nWe should try to verify this is indeed the case causing the error at hand. @stari4ek is it possible provide any playlist samples that have caused this? You did mention that it's not possible, but I'm asking in case something has changed since the issue was filed. Or, in case you have found reproduction steps in your app, will you be able to test locally on your app after we commit the fix?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/745448315/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"christosts","id":54315740,"node_id":"MDQ6VXNlcjU0MzE1NzQw","avatar_url":"https://avatars.githubusercontent.com/u/54315740?v=4","gravatar_id":"","url":"https://api.github.com/users/christosts","html_url":"https://github.com/christosts","followers_url":"https://api.github.com/users/christosts/followers","following_url":"https://api.github.com/users/christosts/following{/other_user}","gists_ur