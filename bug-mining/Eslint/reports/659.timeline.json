acy}","received_events_url":"https://api.github.com/users/jbe456/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-10-29T18:15:33Z","updated_at":"2015-10-29T18:15:33Z","body":"I agree it's not common and I currently disable the rule just for this line.\n\nHere is the use case: we have several functions which in some conditions return `undefined`. And we want to factorize that value, which happens to be `undefined` today but could be changed to `null` or an error code tomorrow.\n\n```\nconst NO_RESULT = undefined;\n\nfunction f1(){\n   if(...) {\n      ...\n      return NO_RESULT;\n   }\n   ...\n}\n\nfunction f2(){\n   if(...) {\n      ...\n      return NO_RESULT;\n   }\n   ...\n}\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/eslint/eslint/issues/comments/152271375/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"jbe456","id":4415696,"node_id":"MDQ6VXNlcjQ0MTU2OTY=","avatar_url":"https://avatars.githubusercontent.com/u/4415696?v=4","gravatar_id":"","url":"https://api.github.com/users/jbe456","html_url":"https://github.com/jbe456","followers_url":"https://api.github.com/users/jbe456/followers","following_url":"https://api.github.com/users/jbe456/following{/other_user}","gists_url":"https://api.github.com/users/jbe456/gists{/gist_id}","starred_url":"https://api.github.com/users/jbe456/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jbe456/subscriptions","organizations_url":"https://api.github.com/users/jbe456/orgs","repos_url":"https://api.github.com/users/jbe456/repos","events_url":"https://api.github.com/users/jbe456/events{/privacy}","received_events_url":"https://api.github.com/users/jbe456/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/eslint/eslint/issues/comment