ubusercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":82,"state":"open","created_at":"2012-09-12T10:39:07Z","updated_at":"2018-07-29T21:40:26Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2014-01-21T19:06:07Z","updated_at":"2014-02-08T11:47:12Z","closed_at":"2014-02-08T11:47:12Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"The explicit support for std::initializer_list is not really needed and creates some problems that can cause bugs.\n\nThe compiler try's to match the best matching constructor and the std::initializer_list one will grab all uniform initialization variants with any length and the compiler is no longer able to select the expected constructor.\nThis causes a list of problems and bugs:\n- any list that has not N elements (for vecN): undefined behavior ( if the list is shorter than N ) or assert fail.\n- copy/cast: the assignment at the constructor will fail because of type mismatch for each member.\n\nYou only need a std::initializer_list constructors for containers if your data type supports a construction of a list of variable number of elements, like std::vector, for data types with fixed length you gain nothing because the compiler already try's to match the other constructors to that list.\n\nI tested this problematic behavior on ms vc++ 2013 ( and nov ctp ).\n","closed_by":{"login":"Groovounet","id":367227,"node_id":"MDQ6VXNlcjM2NzIyNw==","avatar_url":"https://avatars.githubusercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/g-truc/glm/issues/160/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/g-truc/glm/issues/160/timeline","performed_via_github_app":null,"state_reason":"completed"}