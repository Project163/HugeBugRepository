@@ -172,6 +172,16 @@ public DecimalConverter(String name, int scale) {&lt;br/&gt;
     public void addBinary(Binary value) &lt;/p&gt;
{
       record.add(name, new BigDecimal(new BigInteger(value.getBytes()), scale));
     }
&lt;p&gt;+&lt;br/&gt;
+    @Override&lt;br/&gt;
+    public void addInt(int value) &lt;/p&gt;
{
