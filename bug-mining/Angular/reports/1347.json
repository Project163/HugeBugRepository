ar/compiler-cli/src/ngtsc/file_system/src/helpers.js:29:19)\r\n</code></pre>\r\n\r\n\r\n## 🌍  Your Environment\r\n\r\n**Angular Version:**\r\n<pre><code>@angular/compiler-cli@9.0.0</code></pre>\r\n","closed_by":{"login":"zarend","id":7720245,"node_id":"MDQ6VXNlcjc3MjAyNDU=","avatar_url":"https://avatars.githubusercontent.com/u/7720245?v=4","gravatar_id":"","url":"https://api.github.com/users/zarend","html_url":"https://github.com/zarend","followers_url":"https://api.github.com/users/zarend/followers","following_url":"https://api.github.com/users/zarend/following{/other_user}","gists_url":"https://api.github.com/users/zarend/gists{/gist_id}","starred_url":"https://api.github.com/users/zarend/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zarend/subscriptions","organizations_url":"https://api.github.com/users/zarend/orgs","repos_url":"https://api.github.com/users/zarend/repos","events_url":"https://api.github.com/users/zarend/events{/privacy}","received_events_url":"https://api.github.com/users/zarend/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/36290/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/angular/angular/issues/36290/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}