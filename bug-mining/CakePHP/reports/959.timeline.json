stry::getTableLocator()->get('Accounting.TdbHours');\r\n        $hours = $tdbHours->find()->select([\r\n            'amount' => $tdbHours->find()->func()->sum('centiemes_h/100')\r\n        ])->where(function (QueryExpression $q) use ($tasks) {\r\n            return $q->or_([\r\n                'affaire IN' => $tasks,\r\n                'compte_ana IN' => $tasks\r\n            ]);\r\n        })\r\n            ->orderAsc('rob_annee')\r\n            ->toArray(); // Avoid Notice and allows data in JsonView\r\n\r\n        $this->set(compact('hours'));\r\n        $this->set('_serialize', ['hours']);\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/504056805/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"it-mob","id":22001292,"node_id":"MDQ6VXNlcjIyMDAxMjky","avatar_url":"https://avatars.githubusercontent.com/u/22001292?v=4","gravatar_id":"","url":"https://api.github.com/users/it-mob","html_url":"https://github.com/it-mob","followers_url":"https://api.github.com/users/it-mob/followers","following_url":"https://api.github.com/users/it-mob/following{/other_user}","gists_url":"https://api.github.com/users/it-mob/gists{/gist_id}","starred_url":"https://api.github.com/users/it-mob/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/it-mob/subscriptions","organizations_url":"https://api.github.com/users/it-mob/orgs","repos_url":"https://api.github.com/users/it-mob/repos","events_url":"https://api.github.com/users/it-mob/events{/privacy}","received_events_url":"https://api.github.com/users/it-mob/received_events","type":"User","user_view_type":"public","site_admin":false}}]