-    values.increment(index, increment);
-  }
-
-  @Override
-  public SequentialAccessSparseVector like() {
-    return new SequentialAccessSparseVector(size(), values.getNumMappings());
-  }
-
-  @Override
-  public Vector like(int cardinality) {
