                            <comment id="17113346" author="ignitetcbot" created="Thu, 21 May 2020 16:34:59 +0000"  >&lt;div class=&quot;panel&quot; style=&quot;border-color: #ccc;border-style: dashed;border-width: 1px;&quot;&gt;&lt;div class=&quot;panelHeader&quot; style=&quot;border-bottom-width: 1px;border-bottom-style: dashed;border-bottom-color: #ccc;background-color: #D6F7C1;&quot;&gt;&lt;b&gt;Branch: &lt;span class=&quot;error&quot;&gt;&amp;#91;pull/7788/head&amp;#93;&lt;/span&gt; Base: &lt;span class=&quot;error&quot;&gt;&amp;#91;master&amp;#93;&lt;/span&gt; : No blockers found!&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;
