...{head}","merges_url":"https://api.github.com/repos/yugabyte/yugabyte-db/merges","archive_url":"https://api.github.com/repos/yugabyte/yugabyte-db/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/yugabyte/yugabyte-db/downloads","issues_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues{/number}","pulls_url":"https://api.github.com/repos/yugabyte/yugabyte-db/pulls{/number}","milestones_url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones{/number}","notifications_url":"https://api.github.com/repos/yugabyte/yugabyte-db/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels{/name}","releases_url":"https://api.github.com/repos/yugabyte/yugabyte-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Jira Link: [DB-10372](https://yugabyte.atlassian.net/browse/DB-10372)\r\n### Description\n\nProblem\r\n---\r\n* Reproducible on a recent master (305dbefe92).\r\n* No error when bitmap scan is disabled.\r\n\r\n```\r\nYB test# SELECT * FROM CC  AS table1  JOIN C  AS table2  ON ( table2 .col_int_key  = table1 .col_int_nokey  )  WHERE table2 .col_varchar_key  <=  SOME (  SELECT col_varchar_nokey  FROM C  )  AND table1 .col_varchar_key  = table2 .col_varchar_key  OR ( table1 .col_int_nokey  >= table2 .pk  AND table1 .col_varchar_key  IS  NULL  )   ;\r\nERROR:  floating-point exception\r\nDETAIL:  An invalid floating-point operation was signaled. This probably means an out-of-range result or an invalid operation, such as division by zero.\r\nYB test# EXPLAIN (COSTS OFF) SELECT * FROM CC  AS table1  JOIN C  AS table2  ON ( table2 .col_int_key  = table1 .col_int_nokey  )  WHERE table2 .col_varchar_key  <=  SOME (  SELECT col_varchar_nokey  FROM C  )  AND table1 .col_varchar_key  = table2 .col_varchar_key  OR ( table1 .col_int_nokey  >= table2 .pk  AND table1 .col_varchar_key  IS  NULL  )   ;\r\n                                                                              QUERY PLAN\r\n-----------------------------------------------------------------------------------------------------------------------------------------------------------------------\r\n Nested Loop\r\n   ->  Seq Scan on cc table1\r\n   ->  YB Bitmap Table Scan on c table2\r\n         Filter: (((SubPlan 1) AND ((table1.col_varchar_key)::text = (col_varchar_key)::text)) OR ((table1.col_int_nokey >= pk) AND (table1.col_varchar_key IS NULL)))\r\n         ->  BitmapAnd\r\n               ->  Bitmap Index Scan on c_int_key\r\n                     Index Cond: (col_int_key = table1.col_int_nokey)\r\n               ->  BitmapOr\r\n                     ->  Bitmap Index Scan on c_varchar_key\r\n                           Index Cond: ((table1.col_varchar_key)::text = (col_varchar_key)::text)\r\n                     ->  Bitmap Index Scan on c_pkey\r\n                           Index Cond: (table1.col_int_nokey >= pk)\r\n         SubPlan 1\r\n           ->  Materialize\r\n                 ->  Seq Scan on c\r\n(15 rows)\r\n```\r\n\r\n**Bitmap scan disabled**:\r\n```\r\nYB test# /*+ Set(enable_bitmapscan OFF) */SELECT * FROM CC  AS table1  JOIN C  AS table2  ON ( table2 .col_int_key  = table1 .col_int_nokey  )  WHERE table2 .col_varchar_key  <=  SOME (  SELECT col_varchar_nokey  FROM C  )  AND table1 .col_varchar_key  = table2 .col_varchar_key  OR ( table1 .col_int_nokey  >= table2 .pk  AND table1 .col_varchar_key  IS  NULL  )   ;\r\n pk | col_int_nokey | col_varchar_key | pk | col_int_key | col_varchar_key | col_varchar_nokey\r\n----+---------------+-----------------+----+-------------+-----------------+-------------------\r\n 12 |             1 | r               | 17 |           1 | r               | r\r\n(1 row)\r\n\r\nYB test# EXPLAIN (COSTS OFF)/*+ Set(enable_bitmapscan OFF) */SELECT * FROM CC  AS table1  JOIN C  AS table2  ON ( table2 .col_int_key  = table1 .col_int_nokey  )  WHERE table2 .col_varchar_key  <=  SOME (  SELECT col_varchar_nokey  FROM C  )  AND table1 .col_varchar_key  = table2 .col_varchar_key  OR ( table1 .col_int_nokey  >= table2 .pk  AND table1 .col_varchar_key  IS  NULL  )   ;\r\n                                                                                     QUERY PLAN\r\n------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------\r\n Hash Join\r\n   Hash Cond: (table1.col_int_nokey = table2.col_int_key)\r\n   Join Filter: (((SubPlan 1) AND ((table1.col_varchar_key)::text = (table2.col_varchar_key)::text)) OR ((table1.col_int_nokey >= table2.pk) AND (table1.col_varchar_key IS NULL)))\r\n   ->  Seq Scan on cc table1\r\n   ->  Hash\r\n         ->  Seq Scan on c table2\r\n   SubPlan 1\r\n     ->  Materialize\r\n           ->  Seq Scan on c\r\n(9 rows)\r\n\r\nYB test#\r\n```\r\n\r\nTest Case\r\n---\r\n```\r\nCREATE TABLE c (\r\n    pk integer NOT NULL,\r\n    col_int_key integer,\r\n    col_varchar_key character varying(1),\r\n    col_varchar_nokey character varying(1),\r\n    CONSTRAINT c_pkey PRIMARY KEY(pk ASC)\r\n);\r\n\r\nCREATE TABLE cc (\r\n    pk integer NOT NULL,\r\n    col_int_nokey integer,\r\n    col_varchar_key character varying(1),\r\n    CONSTRAINT cc_pkey PRIMARY KEY(pk ASC)\r\n);\r\n\r\n\r\nCOPY c (pk, col_int_key, col_varchar_key, col_varchar_nokey) FROM stdin;\r\n1\t4\tv\tv\r\n2\t62\tv\tv\r\n3\t7\tc\tc\r\n4\t1\t\\N\t\\N\r\n5\t0\tx\tx\r\n6\t7\ti\ti\r\n7\t7\te\te\r\n8\t1\tp\tp\r\n9\t7\ts\ts\r\n10\t1\tj\tj\r\n11\t5\tz\tz\r\n12\t2\tc\tc\r\n13\t0\ta\ta\r\n14\t1\tq\tq\r\n15\t8\ty\ty\r\n16\t1\t\\N\t\\N\r\n17\t1\tr\tr\r\n18\t9\tv\tv\r\n19\t1\t\\N\t\\N\r\n20\t5\tr\tr\r\n\\.\r\n\r\nCOPY cc (pk, col_int_nokey, col_varchar_key) FROM stdin;\r\n10\t\\N\tx\r\n11\t8\td\r\n12\t1\tr\r\n13\t9\tf\r\n14\t4\ty\r\n15\t3\tu\r\n16\t2\tm\r\n17\t\\N\t\\N\r\n18\t2\to\r\n19\t\\N\tw\r\n20\t6\tm\r\n21\t7\tq\r\n22\t2\t\\N\r\n23\t5\td\r\n24\t7\tg\r\n25\t6\tx\r\n26\t6\tf\r\n27\t2\tp\r\n28\t9\tj\r\n29\t6\tc\r\n\\.\r\n\r\nCREATE INDEX c_int_key ON c USING lsm (col_int_key ASC);\r\nCREATE INDEX c_varchar_key ON c USING lsm (col_varchar_key ASC, col_int_key ASC);\r\n\r\n\r\nSELECT\r\n    *\r\nFROM\r\n    CC AS table1\r\n    JOIN C AS table2 ON (\r\n        table2.col_int_key = table1.col_int_nokey\r\n    )\r\nWHERE\r\n    table2.col_varchar_key <= SOME (\r\n        SELECT\r\n            col_varchar_nokey\r\n        FROM\r\n            C\r\n    )\r\n    AND\r\n    table1.col_varchar_key = table2.col_varchar_key\r\n    OR\r\n    (\r\n        table1.col_int_nokey >= table2.pk\r\n        AND\r\n        table1.col_varchar_key IS NULL\r\n    )\r\n;\r\n```\n\n### Issue Type\n\nkind/bug\n\n### Warning: Please confirm that this issue does not contain any sensitive