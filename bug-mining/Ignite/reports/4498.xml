<item>
            <title>[IGNITE-12481] .NET: NuGet verification script does not handle multi-digit version parts</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-12481</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;The following regex in verify-nuget.ps1 does not support multi-digit versions like 8.7.99&lt;/p&gt;

&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
$packageId = $_.Name -replace &lt;span class=&quot;code-quote&quot;&gt;&apos;(.*?)\.\d\.\d\.\d\.nupkg&apos;&lt;/span&gt;, &lt;span class=&quot;code-quote&quot;&gt;&apos;$1&apos;&lt;/span&gt;
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</description>
