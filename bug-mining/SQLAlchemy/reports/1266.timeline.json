 x2 = Column(Integer)\r\n    y2 = Column(Integer)\r\n\r\n    vertex = composite(Vertex._generate, x1, y1, x2, y2)\r\n\r\n\r\nwith Session(engine) as s:\r\n    hv = HasVertex(vertex=Vertex(Point(1, 2), Point(3, 4)))\n```\n\n\n### Error\n\n```\r\nTraceback (most recent call last):\r\n  File \"/home/gord/git/sqla-gerrit/gord_test/has_vertex.py\", line 68, in <module>\r\n    hv = HasVertex(vertex=Vertex(Point(1, 2), Point(3, 4)))\r\n  File \"<string>\", line 4, in __init__\r\n  File \"/home/gord/git/sqla-gerrit/lib/sqlalchemy/orm/state.py\", line 482, in _initialize_instance\r\n    manager.dispatch.init_failure(self, args, kwargs)\r\n  File \"/home/gord/git/sqla-gerrit/lib/sqlalchemy/util/langhelpers.py\", line 141, in __exit__\r\n    raise exc_value.with_traceback(exc_tb)\r\n  File \"/home/gord/git/sqla-gerrit/lib/sqlalchemy/orm/state.py\", line 479, in _initialize_instance\r\n    return manager.original_init(*mixed[1:], **kwargs)\r\n  File \"/home/gord/git/sqla-gerrit/lib/sqlalchemy/orm/decl_base.py\", line 1279, in _declarative_constructor\r\n    setattr(self, k, kwargs[k])\r\n  File \"<string>\", line 1, in __set__\r\n  File \"/home/gord/git/sqla-gerrit/lib/sqlalchemy/orm/descriptor_props.py\", line 235, in fset\r\n    self._composite_values_from_instance(value),\r\n  File \"/home/gord/git/sqla-gerrit/lib/sqlalchemy/orm/descriptor_props.py\", line 166, in _composite_values_from_instance\r\n    return self._generated_composite_accessor(value)\r\nAttributeError: 'Vertex' object has no attribute 'x1'\r\n``` \n\n### Versions\n\n- OS: Xubuntu 20.04\r\n- Python: 3.8\r\n- SQLAlchemy: current main branch\r\n- Database: sqlite\r\n- DBAPI (eg: psycopg, cx_oracle, mysqlclient):\r\n\n\n### Additional context\n\n_No response_","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/7753/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/