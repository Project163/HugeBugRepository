+    public static byte[] readByteArray(ByteBuffer... bufs) {
+        assert !F.isEmpty(bufs);
+
+        int size = 0;
+
+        for (ByteBuffer buf : bufs)
+            size += buf.remaining();
+
+        byte[] res = new byte[size];
+
+        int off = 0;
+
+        for (ByteBuffer buf : bufs) {
+            int len = buf.remaining();
+
+            if (len != 0) {
+                buf.get(res, off, len);
+
+                off += len;
+            }
+        }
+
+        assert off == res.length;
+
+        return res;
+    }
