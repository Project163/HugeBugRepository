+            try (Network network = Network.newNetwork()) {
+                String firstId = network.getId();
+                assertNotNull(
+                        "Network exists",
+                        DockerClientFactory.instance().client().inspectNetworkCmd().withNetworkId(firstId).exec()
+                );
+
+                network.close();
+
+                assertNotEquals(
+                        "New network created",
+                        firstId,
