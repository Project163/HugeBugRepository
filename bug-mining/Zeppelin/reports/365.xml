            <title>[ZEPPELIN-1260] R interpreter doesn&apos;t work with Spark 2.0</title>
                <link>https://issues.apache.org/jira/browse/ZEPPELIN-1260</link>
                <project id="12316221" key="ZEPPELIN">Zeppelin</project>
                    <description>&lt;p&gt;Build with&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;./dev/change_scala_version.sh 2.11
mvn clean &lt;span class=&quot;code-keyword&quot;&gt;package&lt;/span&gt; -pl &lt;span class=&quot;code-quote&quot;&gt;&apos;zeppelin-web,zeppelin-interpreter,zeppelin-zengine,zeppelin-server,spark,spark-dependencies&apos;&lt;/span&gt; -Pspark-2.0 -Phadoop-2.6 -Ppyspark -Psparkr -Dscala-2.11 -DskipTests
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;Run&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;%r 
localDF &amp;lt;- data.frame(name=c(&lt;span class=&quot;code-quote&quot;&gt;&quot;a&quot;&lt;/span&gt;, &lt;span class=&quot;code-quote&quot;&gt;&quot;b&quot;&lt;/span&gt;, &lt;span class=&quot;code-quote&quot;&gt;&quot;c&quot;&lt;/span&gt;), age=c(19, 23, 18))
df &amp;lt;- createDataFrame(localDF)
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;Result:&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;Error in getSparkSession(): SparkSession not initialized
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</description>
