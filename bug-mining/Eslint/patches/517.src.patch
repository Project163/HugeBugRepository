+    function getFirstNodeBeforeColon(node) {
+        var prevNode;
+
+        while (node.type !== "Punctuator" || node.value !== ":") {
+            prevNode = node;
+            node = context.getTokenAfter(node);
+        }
+
+        return prevNode;
+    }
