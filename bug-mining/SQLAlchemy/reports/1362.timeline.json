27T03:35:03Z","updated_at":"2025-12-12T09:08:20Z","pushed_at":"2025-12-10T20:45:00Z","git_url":"git://github.com/sqlalchemy/sqlalchemy.git","ssh_url":"git@github.com:sqlalchemy/sqlalchemy.git","clone_url":"https://github.com/sqlalchemy/sqlalchemy.git","svn_url":"https://github.com/sqlalchemy/sqlalchemy","homepage":"https://www.sqlalchemy.org","size":99269,"stargazers_count":11252,"watchers_count":11252,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":1606,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":205,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["python","sql","sqlalchemy"],"visibility":"public","forks":1606,"open_issues":205,"watchers":11252,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"### Describe the bug\r\n\r\nAnnotating an attribute as optional with `Mapped[str | None]` with `from __future__ import annotations` in Python < 3.10 raises `sqlalchemy.exc.ArgumentError`.\r\n\r\nThe same exception occurs with other types, e.g., `Mapped[bool | None]`, `Mapped[int | None]`.\r\n\r\n### To Reproduce\r\n\r\n```python\r\nfrom __future__ import annotations\r\n\r\nfrom sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column\r\n\r\nclass Base(DeclarativeBase):\r\n    pass\r\n\r\nclass Foo(Base):\r\n    __tablename__ = \"foo\"\r\n\r\n    id: Mapped[int] = mapped_column(primary_key=True)\r\n    foo:  Mapped[str | None]\r\n```\r\n\r\n\r\n### Error\r\n\r\n```\r\nTraceback (most recent call last):\r\n  File \"/tmp/sqlalchemy/venv/lib/python3.9/site-packages/sqlalchemy/util/typing.py\", line 174, in eval_expression\r\n    annotation = eval(expression, base_globals, None)\r\n  File \"<string>\", line 1, in <module>\r\nTypeError: unsupported operand type(s) for |: 'type' and 'NoneType'\r\n\r\nThe above exception was the direct cause of the following exception:\r\n\r\nTraceback (most recent call last):\r\n  File \"/tmp/sqlalchemy/venv/lib/python3.9/site-packages/sqlalchemy/orm/decl_base.py\", line 1376, in _extract_mappable_attributes\r\n    value.declarative_scan(\r\n  File \"/tmp/sqlalchemy/venv/lib/python3.9/site-packages/sqlalchemy/orm/properties.py\", line 681, in declarative_scan\r\n    self._init_column_for_annotation(\r\n  File \"/tmp/sqlalchemy/venv/lib/python3.9/site-packages/sqlalchemy/orm/properties.py\", line 717, in _init_column_for_annotation\r\n    argument = de_stringify_annotation(\r\n  File \"/tmp/sqlalchemy/venv/lib/python3.9/site-packages/sqlalchemy/util/typing.py\", line 147, in de_stringify_annotation\r\n    annotation = eval_expression(annotation, originating_module)\r\n  File \"/tmp/sqlalchemy/venv/lib/python3.9/site-packages/sqlalchemy/util/typing.py\", line 176, in eval_expression\r\n    raise NameError(\r\nNameError: Could not de-stringify annotation 'str | None'\r\n\r\nThe above exception was the direct cause of the following exception:\r\n\r\nTraceback (most recent call last):\r\n  File \"/tmp/sqlalchemy/t.py\", line 8, in <module>\r\n    class Foo(Base):\r\n  File \"/tmp/sqlalchemy/venv/lib/python3.9/site-packages/sqlalchemy/orm/decl_api.py\", line 706, in __init_subclass__\r\n    _as_declarative(cls._sa_registry, cls, cls.__dict__)\r\n  File \"/tmp/sqlalchemy/venv/lib/python3.9/site-packages/sqlalchemy/orm/decl_base.py\", line 234, in _as_declarative\r\n    return _MapperConfig.setup_mapping(registry, cls, dict_, None, {})\r\n  File \"/tmp/sqlalchemy/venv/lib/python3.9/site-packages/sqlalchemy/orm/decl_base.py\", line 315, in setup_mapping\r\n    return _ClassScanMapperConfig(\r\n  File \"/tmp/sqlalchemy/venv/lib/python3.9/site-packages/sqlalchemy/orm/decl_base.py\", line 557, in __init__\r\n    self._extract_mappable_attributes()\r\n  File \"/tmp/sqlalchemy/venv/lib/python3.9/site-packages/sqlalchemy/orm/decl_base.py\", line 1388, in _extract_mappable_attributes\r\n    raise exc.ArgumentError(\r\nsqlalchemy.exc.ArgumentError: Could not resolve all types within mapped annotation: \"Mapped[str | None]\".  Ensure all types are written correctly and are imported within the module in use.\r\n``` \r\n\r\n### Versions\r\n\r\n- OS: Ubuntu 22.04\r\n- Python: 3.9.16\r\n- SQLAlchemy: 2.0.0rc2\r\n- Database: n/a\r\n- DBAPI (eg: psycopg, cx_oracle, mysqlclient): n/a\r\n\r\n\r\n### Additional context\r\n\r\nAnnotating with `Mapped[Optional[str]]` will work as expected.","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/9110/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/9110/timeline","performed_via_github_app":null,"state_reason":"not_planned"}},"event":"cross-referenced"},{"id":18054538813,"node_id":"REFE_lADOCX5JB85V4D9rzwAAAAQ0ImY9","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/18054538813","actor":{"login":"jiajunsu","id":16359131,"node_id":"MDQ6VXNlcjE2MzU5MTMx","avatar_url":"https://avatars.githubusercontent.com/u/16359131?v=4","gravatar_id":"","url":"https://api.github.com/users/jiajunsu","html_url":"https://github.com/jiajunsu","followers_url":"https://api.github.com/users/jiajunsu/followers","following_url":"https://api.github.com/users/jiajunsu/following{/other_user}","gists_url":"https://api.github.com/users/jiajunsu/gists{/gist_id}","starred_url":"https://api.github.com/users/jiajunsu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jiajunsu/subscriptions","organizations_url":"https://api.github.com/users/jiajunsu/orgs","repos_url":"https://api.github.com/users/jiajunsu/repos","events_url":"https://api.github.com/users/jiajunsu/events{/privacy}","received_events_url":"https://api.github.c