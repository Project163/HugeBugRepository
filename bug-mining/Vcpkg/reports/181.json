sercontent.com/u/47264268?v=4","gravatar_id":"","url":"https://api.github.com/users/JackBoosY","html_url":"https://github.com/JackBoosY","followers_url":"https://api.github.com/users/JackBoosY/followers","following_url":"https://api.github.com/users/JackBoosY/following{/other_user}","gists_url":"https://api.github.com/users/JackBoosY/gists{/gist_id}","starred_url":"https://api.github.com/users/JackBoosY/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JackBoosY/subscriptions","organizations_url":"https://api.github.com/users/JackBoosY/orgs","repos_url":"https://api.github.com/users/JackBoosY/repos","events_url":"https://api.github.com/users/JackBoosY/events{/privacy}","received_events_url":"https://api.github.com/users/JackBoosY/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"JackBoosY","id":47264268,"node_id":"MDQ6VXNlcjQ3MjY0MjY4","avatar_url":"https://avatars.githubusercontent.com/u/47264268?v=4","gravatar_id":"","url":"https://api.github.com/users/JackBoosY","html_url":"https://github.com/JackBoosY","followers_url":"https://api.github.com/users/JackBoosY/followers","following_url":"https://api.github.com/users/JackBoosY/following{/other_user}","gists_url":"https://api.github.com/users/JackBoosY/gists{/gist_id}","starred_url":"https://api.github.com/users/JackBoosY/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JackBoosY/subscriptions","organizations_url":"https://api.github.com/users/JackBoosY/orgs","repos_url":"https://api.github.com/users/JackBoosY/repos","events_url":"https://api.github.com/users/JackBoosY/events{/privacy}","received_events_url":"https://api.github.com/users/JackBoosY/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":1,"created_at":"2022-03-23T19:53:49Z","updated_at":"2022-03-24T21:03:32Z","closed_at":"2022-03-24T21:03:32Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**Avoid installing Symlinks**\r\n\r\n**Is your feature request related to a problem? Please describe.**\r\nThe fontconfig port installs a number of symlinks into `etc/fonts/` below the installation prefix. These files are, at least on linux, always processed, even if the configuration is overloaded by defining a custom configuration with the `FONTCONFIG_FILE` and/or `FONTCONFIG_PATH` variables.\r\n\r\nDepending on security policies, windows based systems can disallow symlinks.\r\n* Assuming the windows system can generate symlinks, using `vcpkg export --zip`  will create corrupted zip files, as the zip format cannot handle symlinks.\r\n* Assuming the windows system cannot generate symlinks, an installation will be created that lacks  most content of the `etc` subpath. However, this installation, exports, and binarysource, cannot be distinguished by metadata from an installation/export/binarysource that does contain files in `etc`.\r\n\r\n**Proposed solution**\r\nPatch the port to Install regular files instead of symlinks. On linux and unix, where symlinks can be considered to be supported in any sane setup, avoiding the installation of symlinks fixes the zip-file export, while on windows the package becomes independend of symlink enabling/restricting security policies on top of getting the zip export fixed.\r\n\r\n**Describe alternatives you've considered**\r\nNot using caches/exports avoids the issue, but different security configurations still result in different installations, which is counter-intuitive\r\n\r\n**Additional context**\r\n","closed_by":{"login":"dan-shaw","id":51385773,"node_id":"MDQ6VXNlcjUxMzg1Nzcz","avatar_url":"https://avatars.githubusercontent.com/u/51385773?v=4","gravatar_id":"","url":"https://api.github.com/users/dan-shaw","html_url":"https://github.com/dan-shaw","followers_url":"https://api.github.com/users/dan-shaw/followers","following_url":"https://api.github.com/users/dan-shaw/following{/other_user}","gists_url":"https://api.github.com/users/dan-shaw/gists{/gist_id}","starred_url":"https://api.github.com/users/dan-shaw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dan-shaw/subscriptions","organizations_url":"https://api.github.com/users/dan-shaw/orgs","repos_url":"https://api.github.com/users/dan-shaw/repos","events_url":"https://api.github.com/users/dan-shaw/events{/privacy}","received_events_url":"https://api.github.com/users/dan-shaw/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/microsoft/vcpkg/issues/23735/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/microsoft/vcpkg/issues/23735/timeline","performed_via_github_app":null,"state_reason":"completed"}