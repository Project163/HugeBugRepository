diff --git a/alembic/util/sqla_compat.py b/alembic/util/sqla_compat.py
index 2d56d3ea..28a6548c 100644
--- a/alembic/util/sqla_compat.py
+++ b/alembic/util/sqla_compat.py
@@ -171,3 +171,10 @@ def _get_index_expressions(idx):
 
