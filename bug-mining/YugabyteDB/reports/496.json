desirazu/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2021-01-29T23:03:18Z","updated_at":"2021-02-08T18:40:30Z","closed_at":"2021-02-08T18:40:30Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"When we limit the size of batch size of `cdc_max_apply_batch_num_records`, we can end up in a race condition where we end up applying transactions before all the intents have been replicated. This happens due to the asynchronous nature of tablet lookup, so we may trigger a lookup on an intent before its apply, but execute the callbacks in reverse order. Smaller batch sizes means we send multiple write requests per poll to a given tablet, so request 1 may contain a commit, while request 2 may contain an apply for the transaction we committed.","closed_by":{"login":"rahuldesirazu","id":7719567,"node_id":"MDQ6VXNlcjc3MTk1Njc=","avatar_url":"https://avatars.githubusercontent.com/u/7719567?v=4","gravatar_id":"","url":"https://api.github.com/users/rahuldesirazu","html_url":"https://github.com/rahuldesirazu","followers_url":"https://api.github.com/users/rahuldesirazu/followers","following_url":"https://api.github.com/users/rahuldesirazu/following{/other_user}","gists_url":"https://api.github.com/users/rahuldesirazu/gists{/gist_id}","starred_url":"https://api.github.com/users/rahuldesirazu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rahuldesirazu/subscriptions","organizations_url":"https://api.github.com/users/rahuldesirazu/orgs","repos_url":"https://api.github.com/users/rahuldesirazu/repos","events_url":"https://api.github.com/users/rahuldesirazu/events{/privacy}","received_events_url":"https://api.github.com/users/rahuldesirazu/received_events","type":"User","user_view_type":"pu