-	logger.mu.Lock()
-	defer logger.mu.Unlock()
-	if logger.out != nil {
-		logger.out.Close()
-	}
-}
-
-// GetName returns empty for these provider loggers
-func (logger *WriterLogger) GetName() string {
-	return ""
-}
