+        useCustomLdr = false;
+
+        IgniteEx ignite0 = startGrid(0);
+
+        IgniteEx client = startClientGrid(1);
+
+        IgniteCache<Integer, Integer> cache = client.getOrCreateCache(generateCacheConfiguration(
