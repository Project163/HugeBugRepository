diff --git a/src/Datasource/EntityTrait.php b/src/Datasource/EntityTrait.php
index 19cc2b2899..484b7b427c 100644
--- a/src/Datasource/EntityTrait.php
+++ b/src/Datasource/EntityTrait.php
@@ -606,7 +606,16 @@ trait EntityTrait
         if ($new === null) {
             return $this->_new;
         }
-        return $this->_new = (bool)$new;
+
+        $new = (bool)$new;
+
+        if ($new) {
+            foreach ($this->_properties as $k => $p) {
+                $this->_dirty[$k] = true;
+            }
+        }
+
+        return $this->_new = $new;
     }
 
