tArray([1.0, 2.0, 3.0])\r\n        vec2 = ImplicitArray([1.0, 2.0, 4.0])\r\n        assert vec1 == approx(vec2)\r\n```\r\n\r\nBut for both cases, they are passing when I know it shouldn't, and I haven't made any edits to ApproxNumpy yet.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/pytest-dev/pytest/issues/comments/2067532787/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"poulami-sau","id":109125687,"node_id":"U_kgDOBoEgNw","avatar_url":"https://avatars.githubusercontent.com/u/109125687?v=4","gravatar_id":"","url":"https://api.github.com/users/poulami-sau","html_url":"https://github.com/poulami-sau","followers_url":"https://api.github.com/users/poulami-sau/followers","following_url":"https://api.github.com/users/poulami-sau/following{/other_user}","gists_url":"https://api.github.com/users/poulami-sau/gists{/gist_id}","starred_url":"https://api.github.com/users/poulami-sau/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/poulami-sau/subscriptions","organizations_url":"https://api.github.com/users/poulami-sau/orgs","repos_url":"https://api.github.com/users/poulami-sau/repos","events_url":"https://api.github.com/users/poulami-sau/events{/privacy}","received_events_url":"https://api.github.com/users/poulami-sau/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/pytest-dev/pytest/issues/comments/2068270378","html_url":"https://github.com/pytest-dev/pytest/issues/12114#issuecomment-2068270378","issue_url":"https://api.github.com/repos/pytest-dev/pytest/issues/12114","id":2068270378,"node_id":"IC_kwDOAjwLdc57R00q","user":{"login":"poulami-sau","id":109125687,"node_id":"U_kgDOBoEgNw","avatar_url":"https://avatars.githubusercontent.com/u/109125687?v=4","gravatar_id":"","url":"https://api.github.com/users/poulami-sau","htm