ues_url":"https://api.github.com/repos/typeorm/typeorm/issues{/number}","pulls_url":"https://api.github.com/repos/typeorm/typeorm/pulls{/number}","milestones_url":"https://api.github.com/repos/typeorm/typeorm/milestones{/number}","notifications_url":"https://api.github.com/repos/typeorm/typeorm/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/typeorm/typeorm/labels{/name}","releases_url":"https://api.github.com/repos/typeorm/typeorm/releases{/id}","deployments_url":"https://api.github.com/repos/typeorm/typeorm/deployments","created_at":"2016-02-29T07:41:14Z","updated_at":"2025-12-12T16:46:06Z","pushed_at":"2025-12-12T10:50:18Z","git_url":"git://github.com/typeorm/typeorm.git","ssh_url":"git@github.com:typeorm/typeorm.git","clone_url":"https://github.com/typeorm/typeorm.git","svn_url":"https://github.com/typeorm/typeorm","homepage":"http://typeorm.io","size":33014,"stargazers_count":36125,"watchers_count":36125,"language":"TypeScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":6469,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":540,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["active-record","cockroachdb","data-mapper","database","electron","hacktoberfest","javascript","mariadb","mysql","oracle","orm","postgresql","react-native","sap","sap-hana","sqlite","sqlserver","typeorm","typescript","websql"],"visibility":"public","forks":6469,"open_issues":540,"watchers":36125,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/typeorm/typeorm/pulls/11441","html_url":"https://github.com/typeorm/typeorm/pull/11441","diff_url":"https://github.com/typeorm/typeorm/pull/11441.diff","patch_url":"https://github.com/typeorm/typeorm/pull/11441.patch","merged_at":"2025-06-05T13:25:43Z"},"body":"### Description of change\r\nissue - #8647\r\nThis changes enhance the Postgresdriver’s schema synchronization logic to detect when a column’s `collation` property has been modified and include the appropriate `ALTER … COLLATE` statement in both `up` and `down` migration SQL.\r\n\r\nSo, I made a few changes in `PostgresDriver.ts` and `PostgresQueryRunner.ts`\r\n\r\n> **It seems that the same issue is observed not only in `PostgreSQL` but also in several other RDBMS drivers that allow Collation to be configured** _(`SQL Server`, `MySQL`, `Oracle`, etc... as far as I know...)_ \r\n>\r\n> Please let me know if you'd like this to be applied uniformly across those other DBMS as well. 😄 \r\n\r\n### Pull-Request Checklist\r\n- [x] Code is up-to-date with the `master` branch\r\n- [x] `npm run format` to apply prettier formatting\r\n- [x] `npm run test` passes with this change\r\n- [x] This pull request links relevant issues as `Fixes #8647`\r\n- [x] There are new or updated unit tests validating the change\r\n- [ ] Documentation has been updated to reflect this change (N/A)\r\n- [x] The new commits follow conventions explained in [CONTRIBUTING.md](https://github.com/typeorm/typeorm/blob/master/CONTRIBUTING.md)\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n- **New Features**\n  - Added support for detecting and synchronizing collation changes on PostgreSQL columns during schema updates.\n\n- **Tests**\n  - Introduced tests to verify that collation changes are correctly detected, generate the appropriate migration SQL, and are applied to the database schema.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->","reactions":{"url":"https://api.github.com/repos/typeorm/typeorm/issues/11441/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/typeorm/typeorm/issues/11441/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":18001162780,"node_id":"CE_lADOAyVBJc5D45TLzwAAAAQw8_Ic","url":"https://api.github.com/repos/typeorm/typeorm/issues/events/18001162780","actor":{"login":"alumni","id":611745,"node_id":"MDQ6VXNlcjYxMTc0NQ==","avatar_url":"https://avatars.githubusercontent.com/u/611745?v=4","gravatar_id":"","url":"https://api.github.com/users/alumni","html_url":"https://github.com/alumni","followers_url":"https://api.github.com/users/alumni/followers","following_url":"https://api.github.com/users/alumni/following{/other_user}","gists_url":"https://api.github.com/users/alumni/gists{/gist_id}","starred_url":"https://api.github.com/users/alumni/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alumni/subscriptions","organizations_url":"https://api.github.com/users/alumni/orgs","repos_url":"https://api.github.com/users/alumni/repos","events_url":"https://api.github.com/users/alumni/events{/privacy}","received_events_url":"https://api.github.com/users/alumni/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":"24c3e38c517bf67366704822668b3e618fa56430","commit_url":"https://api.github.com/repos/typeorm/typeorm/commits/24c3e38c517bf67366704822668b3e618fa56430","created_at":"2025-06-05T13:25:44Z","state_reason":null,"performed_via_github_app":null},{"id":18003597513,"node_id":"REFE_lADOAyVBJc5D45TLzwAAAAQxGRjJ","url":"https://api.github.com/repos/typeorm/typeorm/issues/events/18003597513","actor":{"login":"yevhen-komarov","id":28161270,"node_id":"MDQ6VXNlcjI4MTYxMjcw","avatar_url":"https://avatars.githubusercontent.com/u/28161270?v=4","gravatar_id":"","url":"https://api.github.com/users/yevhen-komarov","html_url":"https://github.com/yevhen-komarov","followers_url":"https://api.github.com/users/yevhen-komarov/followe