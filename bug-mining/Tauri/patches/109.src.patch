diff --git a/.changes/fix-webview-resize-on-move.md b/.changes/fix-webview-resize-on-move.md
new file mode 100644
index 000000000..d318741dd
--- /dev/null
+++ b/.changes/fix-webview-resize-on-move.md
@@ -0,0 +1,5 @@
+---
+"tauri-runtime-wry": patch
+---
+
+Applies a workaround to a Windows webview2 positioning issue after a window move event.
diff --git a/core/tauri-runtime-wry/src/lib.rs b/core/tauri-runtime-wry/src/lib.rs
index a09d88c48..35ad40680 100644
--- a/core/tauri-runtime-wry/src/lib.rs
+++ b/core/tauri-runtime-wry/src/lib.rs
@@ -1539,7 +1539,8 @@ fn handle_event_loop(
             menu_event_listeners.clone(),
           );
         }
-        WryWindowEvent::Resized(_) => {
+        // we also resize the webview on `Moved` to fix https://github.com/tauri-apps/tauri/issues/1911
+        WryWindowEvent::Resized(_) | WryWindowEvent::Moved(_) => {
           if let Err(e) = webviews[&window_id].inner.resize() {
             eprintln!("{}", e);
           }
