+        AllocationService strategy = createAllocationService(Settings.EMPTY, new ClusterInfoService() {
+            @Override
+            public ClusterInfo getClusterInfo() {
+                return new ClusterInfo(Collections.EMPTY_MAP, Collections.EMPTY_MAP) {
+                    @Override
