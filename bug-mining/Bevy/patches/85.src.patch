+fn apply_import(
+    import_handles: &HashMap<ShaderImport, Handle<Shader>>,
+    shaders: &HashMap<Handle<Shader>, Shader>,
+    import: &ShaderImport,
+    shader: &Shader,
+    final_string: &mut String,
