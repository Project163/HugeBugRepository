pi.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-03-02T07:10:31Z","updated_at":"2024-03-02T07:10:31Z","body":"i think it might help if we had cloned_traverse() etc. in cython maybe","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1974582830/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1974824111","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/11085#issuecomment-1974824111","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/11085","id":1974824111,"node_id":"IC_kwDOCX5JB851tWyv","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-03-02T15:04:59Z","updated_at":"2024-03-02T15:05:23Z","body":"just some thinking, which seemed like a good idea 20 seconds ago but now im not sure\r\n\r\nthey put a SQL expression in a loader option.   then that loader option is part of what's cached.  later, they run a new query, with a new loader option, and the query / opts are identical to what we have, except for parameter values.   \r\n\r\nso right now we are taking the cached option, cloning it, and rewriting the SQL expression to have the bound values of the uncached one.  the rewriting is the problem.\r\n\r\nthe totally other way to do this, is to use the **uncached** option, use the SQL expressions that are inside there.  for the tests that were added in #10570 we can literally just do this:\r\n\r\n```\r\n    def _adapt_cached_option_to_uncached_option(\r\n        self, context: QueryContext, uncached_opt: ORMOption\r\n    ) -> ORMOption:\r\n        return uncached_opt\r\n\r\n```\r\n\r\nand those tests pass.   so what is the problem?  it's when the loader options point to aliased() constructs and such that are part of the \"path\", those constructs dont match where they need to from the cached version of the option.    But maybe I can get the matching to work in that direction, meaning we adapt the uncached option to work, rather than adapting the cached option to work.\r\n\r\nAlthough that really can't work because if the uncached option has extra_criteria that references the original query, we have to rewrite the expression anyway.       might be a non-starter and im doing the same thinking I already did here.\r\n\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1974824111/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":11987596931,"node_id":"LE_lADOCX5JB86BBPpUzwAAAALKhDaD","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/11987596931","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"ht