TO test (\"ab(cd)ef\") VALUES (%(ab(cd)ef)s)\r\n2021-02-14 00:20:38,437 INFO sqlalchemy.engine.base.Engine {'ab(cd)ef': 123}\r\n2021-02-14 00:20:38,437 INFO sqlalchemy.engine.base.Engine ROLLBACK\r\nTraceback (most recent call last):\r\n  File \"<stdin>\", line 1, in <module>\r\n  File \"/usr/local/Caskroom/miniconda/base/envs/mas/lib/python3.8/site-packages/sqlalchemy/engine/base.py\", line 2235, in execute\r\n    return connection.execute(statement, *multiparams, **params)\r\n  File \"/usr/local/Caskroom/miniconda/base/envs/mas/lib/python3.8/site-packages/sqlalchemy/engine/base.py\", line 1011, in execute\r\n    return meth(self, multiparams, params)\r\n  File \"/usr/local/Caskroom/miniconda/base/envs/mas/lib/python3.8/site-packages/sqlalchemy/sql/elements.py\", line 298, in _execute_on_connection\r\n    return connection._execute_clauseelement(self, multiparams, params)\r\n  File \"/usr/local/Caskroom/miniconda/base/envs/mas/lib/python3.8/site-packages/sqlalchemy/engine/base.py\", line 1124, in _execute_clauseelement\r\n    ret = self._execute_context(\r\n  File \"/usr/local/Caskroom/miniconda/base/envs/mas/lib/python3.8/site-packages/sqlalchemy/engine/base.py\", line 1316, in _execute_context\r\n    self._handle_dbapi_exception(\r\n  File \"/usr/local/Caskroom/miniconda/base/envs/mas/lib/python3.8/site-packages/sqlalchemy/engine/base.py\", line 1514, in _handle_dbapi_exception\r\n    util.raise_(exc_info[1], with_traceback=exc_info[2])\r\n  File \"/usr/local/Caskroom/miniconda/base/envs/mas/lib/python3.8/site-packages/sqlalchemy/util/compat.py\", line 182, in raise_\r\n    raise exception\r\n  File \"/usr/local/Caskroom/miniconda/base/envs/mas/lib/python3.8/site-packages/sqlalchemy/engine/base.py\", line 1276, in _execute_context\r\n    self.dialect.do_execute(\r\n  File \"/usr/local/Caskroom/miniconda/base/envs/mas/lib/python3.8/site-packages/sqlalchemy/engine/default.py\", line 608, in do_execute\r\n    cursor.execute(statement, parameters)\r\nKeyError: 'ab(cd'\r\n\r\n```\r\n\r\n**Versions.**\r\n - OS: macos\r\n - Python: 3.8\r\n - SQLAlchemy: 1.3.23\r\n - Database: postgresql 13.2\r\n - DBAPI: psycopg2\r\n\r\n**Additional context**\r\ncolumn named with parenthese  is valid, at least in postgresql to my knowledge.\r\n\r\n**Have a nice day!**\r\n","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5941/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5941/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":6698785772,"node_id":"REFE_lADOCX5JB84rJAGHzwAAAAGPR1vs","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/6698785772","actor":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"cac8de9ab2d5fe04954947d96b78ee34522f3a2a","commit_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/commits/cac8de9ab2d5fe04954947d96b78ee