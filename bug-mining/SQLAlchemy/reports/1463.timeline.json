\n### To Reproduce\n\n```python\nfrom __future__ import annotations\r\n\r\nimport enum\r\n\r\nimport sqlalchemy\r\nfrom sqlalchemy import create_engine\r\nfrom sqlalchemy.orm import DeclarativeBase\r\nfrom sqlalchemy.orm import Mapped\r\nfrom sqlalchemy.orm import mapped_column\r\n\r\nDSN = \"postgresql://test:test@localhost/test\"\r\n\r\n\r\nclass Transform(enum.Enum):\r\n    upper = str.upper\r\n    lower = str.lower\r\n    title = str.title\r\n\r\n    def __call__(self, text: str) -> str:\r\n        return self.value(text)\r\n\r\n\r\nclass Base(DeclarativeBase):\r\n    pass\r\n\r\n\r\nclass SomeClass(Base):\r\n    __tablename__ = \"some_table\"\r\n\r\n    id: Mapped[int] = mapped_column(primary_key=True)\r\n    transform: Mapped[Transform]\r\n\r\n\r\ne = create_engine(DSN, echo=True)\r\nBase.metadata.drop_all(e)\r\nBase.metadata.create_all(e)\n```\n\n\n### Error\n\n```\r\nTraceback (most recent call last):\r\n  File \"<stdin>\", line 1, in <module>\r\n  File \"/home/david/git/certificateclaim/env/lib64/python3.10/site-packages/sqlalchemy/sql/schema.py\", line 5792, in create_all\r\n    bind._run_ddl_visitor(\r\n  File \"/home/david/git/certificateclaim/env/lib64/python3.10/site-packages/sqlalchemy/engine/base.py\", line 3239, in _run_ddl_visitor\r\n    conn._run_ddl_visitor(visitorcallable, element, **kwargs)\r\n  File \"/home/david/git/certificateclaim/env/lib64/python3.10/site-packages/sqlalchemy/engine/base.py\", line 2443, in _run_ddl_visitor\r\n    visitorcallable(self.dialect, self, **kwargs).traverse_single(element)\r\n  File \"/home/david/git/certificateclaim/env/lib64/python3.10/site-packages/sqlalchemy/sql/visitors.py\", line 670, in traverse_single\r\n    return meth(obj, **kw)\r\n  File \"/home/david/git/certificateclaim/env/lib64/python3.10/site-packages/sqlalchemy/sql/ddl.py\", line 912, in visit_metadata\r\n    with self.with_ddl_events(\r\n  File \"/usr/lib64/python3.10/contextlib.py\", line 135, in __enter__\r\n    return next(self.gen)\r\n  File