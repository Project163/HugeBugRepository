ocked_by":0,"blocking":0,"total_blocking":0},"body":"from #8108\r\n\r\n```py\r\nimport pickle\r\n\r\nimport sqlalchemy\r\nfrom sqlalchemy import Column, Integer, Boolean\r\nfrom sqlalchemy import create_engine\r\nfrom sqlalchemy.ext.declarative import declarative_base\r\nfrom sqlalchemy.orm import scoped_session, sessionmaker, with_loader_criteria\r\n\r\nengine = create_engine(\"sqlite:///:memory:\")\r\n\r\nDeclarativeBase = declarative_base()\r\nmaker = sessionmaker(autoflush=True, autocommit=False)\r\nDBSession = scoped_session(maker)\r\nDBSession.configure(bind=engine)\r\n\r\n\r\nclass SoftDeleteMixin:\r\n    deleted = Column(Boolean, default=False, nullable=False)\r\n\r\n\r\nclass SoftDeletableObject(DeclarativeBase, SoftDeleteMixin):\r\n    __tablename__ = \"foo\"\r\n    id = Column(Integer, primary_key=True)\r\n\r\n\r\nclass RegularObject(DeclarativeBase):\r\n    __tablename__ = \"bar\"\r\n    id = Column(Integer, primary_key=True)\r\n\r\n\r\nDeclarativeBase.metadata.create_all(engine)\r\n\r\nDBSession.add(SoftDeletableObject(id=1))\r\nDBSession.add(RegularObject(id=1))\r\nDBSession.flush()\r\n\r\n\r\ndef _is_deleted(cls):\r\n    return cls.deleted == False\r\n\r\n@sqlalchemy.event.listens_for(DBSession, \"do_orm_execute\")\r\ndef _do_orm_execute(orm_execute_state):\r\n    if (\r\n        orm_execute_state.is_select\r\n        and not orm_execute_state.is_column_load\r\n        and not orm_execute_state.is_relationship_load\r\n    ):\r\n        orm_execute_state.statement = orm_execute_state.statement.options(\r\n            with_loader_criteria(\r\n                SoftDeleteMixin,\r\n                _is_deleted,\r\n                include_aliases=True,\r\n            )\r\n        )\r\n\r\n\r\nfoo = DBSession.query(SoftDeletableObject).first()\r\nresult = pickle.dumps(foo, pickle.HIGHEST_PROTOCOL) \r\n```","closed_by":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gr