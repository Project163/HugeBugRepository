ase/Schema/CachedCollection.php(62): Cake\\Database\\Schema\\Collection->describe('parent_games', Array)\n#2 PATH/vendor/cakephp/cakephp/src/ORM/Table.php(339): Cake\\Database\\Schema\\CachedCollection->describe('parent_games')\n#3 PATH/vendor/cakephp/cakephp/src/ORM/Table.php(412): Cake\\ORM\\Table->schema()\n#4 PATH/vendor/cakephp/cakephp/src/Shell/Task/ViewTask.php(455): Cake\\ORM\\Table->primaryKey()\n#5 PATH/vendor/cakephp/cakephp/src/Shell/Task/ViewTask.php(264): Cake\\Shell\\Task\\ViewTask->_associations(Object(Cake\\ORM\\Table))\n#6 PATH/vendor/cakephp/cakephp/src/Shell/Task/ViewTask.php(134): Cake\\Shell\\Task\\ViewTask->_loadController()\n#7 PATH/vendor/cakephp/cakephp/src/Shell/bakeShell.php(220): Cake\\Shell\\Task\\ViewTask->main('Games')\n#8 [internal function]: Cake\\Shell\\BakeShell->all('games')\n#9 PATH/vendor/cakephp/cakephp/src/Console/Shell.php(365): call_user_func_array(Array, Array)\n#10 PATH/vendor/cakephp/cakephp/src/Console/ShellDispatcher.php(184): Cake\\Console\\Shell->runCommand(Array, true)\n#11 PATH/vendor/cakephp/cakephp/src/Console/ShellDispatcher.php(160): Cake\\Console\\ShellDispatcher->_dispatch()\n#12 PATH/vendor/cakephp/cakephp/src/Console/ShellDispatcher.php(117): Cake\\Console\\ShellDispatcher->dispatch()\n#13 PATH/bin/cake.php(20): Cake\\Console\\ShellDispatcher::run(Array)\n#14 {main}\n```\n\nLooks like it's the `bake view` step, but `bin/cake bake view Games` works without problems.\n","closed_by":{"login":"markstory","id":24086,"node_id":"MDQ6VXNlcjI0MDg2","avatar_url":"https://avatars.githubusercontent.com/u/24086?v=4","gravatar_id":"","url":"https://api.github.com/users/markstory","html_url":"https://github.com/markstory","followers_url":"https://api.github.com/users/markstory/followers","following_url":"https://api.github.com/users/markstory/following{/other_user}","gists_url":"https://api.github.com/users/markstory/gists{/gist_id}","starred_url":"https://api.github.com/users/markstory/starred{/owner}{/repo}","subscripti