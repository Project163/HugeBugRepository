dn't be the right call for it. I think the `parent_update_system` should instead run at the end of each stage just like the command buffer;","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/731653623/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"lassade","id":9643105,"node_id":"MDQ6VXNlcjk2NDMxMDU=","avatar_url":"https://avatars.githubusercontent.com/u/9643105?v=4","gravatar_id":"","url":"https://api.github.com/users/lassade","html_url":"https://github.com/lassade","followers_url":"https://api.github.com/users/lassade/followers","following_url":"https://api.github.com/users/lassade/following{/other_user}","gists_url":"https://api.github.com/users/lassade/gists{/gist_id}","starred_url":"https://api.github.com/users/lassade/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lassade/subscriptions","organizations_url":"https://api.github.com/users/lassade/orgs","repos_url":"https://api.github.com/users/lassade/repos","events_url":"https://api.github.com/users/lassade/events{/privacy}","received_events_url":"https://api.github.com/users/lassade/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/731681683","html_url":"https://github.com/bevyengine/bevy/issues/891#issuecomment-731681683","issue_url":"https://api.github.com/repos/bevyengine/bevy/issues/891","id":731681683,"node_id":"MDEyOklzc3VlQ29tbWVudDczMTY4MTY4Mw==","user":{"login":"cart","id":2694663,"node_id":"MDQ6VXNlcjI2OTQ2NjM=","avatar_url":"https://avatars.githubusercontent.com/u/2694663?v=4","gravatar_id":"","url":"https://api.github.com/users/cart","html_url":"https://github.com/cart","followers_url":"https://api.github.com/users/cart/followers","following_url":"https://api.github.com/users/cart/follo