<item>
            <title>[IGNITE-5203] JDBC driver should support BLOB fields</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-5203</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;JDBD driver doesn&apos;t support BLOB fields. Need to implement BLOBs, at least simple byte array based implementation.&lt;/p&gt;
</description>
                <environment></environment>
        <key id="13071130">IGNITE-5203</key>
            <summary>JDBC driver should support BLOB fields</summary>
                <type id="1" iconUrl="https://issues.apache.org/jira/secure/viewavatar?size=xsmall&amp;avatarId=21133&amp;avatarType=issuetype">Bug</type>
