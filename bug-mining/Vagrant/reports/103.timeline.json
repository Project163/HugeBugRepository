ant","virtualization"],"visibility":"public","forks":4446,"open_issues":734,"watchers":27145,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/hashicorp/vagrant/pulls/8653","html_url":"https://github.com/hashicorp/vagrant/pull/8653","diff_url":"https://github.com/hashicorp/vagrant/pull/8653.diff","patch_url":"https://github.com/hashicorp/vagrant/pull/8653.patch","merged_at":"2017-06-07T18:47:38Z"},"body":"This commit adds some better handling around the snapshot restore\r\ncommand for the virtualbox provider. If a user attempts to restore from\r\na vm that does not exist, instead of exiting 0 it will raise an\r\nexception saying the virtual machine has not been created yet.\r\nAddtionally, if a user attempts to restore from a snapshot id that does\r\nnot exist, instead of printing a complicated exception from the\r\nvirtualbox cli tool, it prints a more useful error message telling the\r\nuser that the snapshot does not exist.\r\n\r\nFixes #7188","reactions":{"url":"https://api.github.com/repos/hashicorp/vagrant/issues/8653/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/hashicorp/vagrant/issues/8653/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":1112746170,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDExMTI3NDYxNzA=","url":"https://api.github.com/repos/hashicorp/vagrant/issues/events/1112746170","actor":{"login":"briancain","id":810277,"node_id":"MDQ6VXNlcjgxMDI3Nw==","avatar_url":"https://avatars.githubusercontent.com/u/810277?v=4","gravatar_id":"","url":"https://api.github.com/users/briancain","html_url":"https://github.com/briancain","followers_url":"https://api.github.com/users/briancain/followers","following_url":"https://api.github.com/users/briancain/following{/other_user}","gists_url":"https://api.githu