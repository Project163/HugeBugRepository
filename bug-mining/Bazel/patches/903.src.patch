index 0000000000..40dd5204d2
--- /dev/null
+++ b/src/main/java/com/google/devtools/build/lib/analysis/config/ConfigConditions.java
@@ -0,0 +1,81 @@
+// Copyright 2021 The Bazel Authors. All rights reserved.
