url":"https://api.github.com/repos/yiisoft/yii2/releases{/id}","deployments_url":"https://api.github.com/repos/yiisoft/yii2/deployments","created_at":"2012-02-13T15:32:36Z","updated_at":"2025-12-13T02:47:07Z","pushed_at":"2025-12-09T16:34:01Z","git_url":"git://github.com/yiisoft/yii2.git","ssh_url":"git@github.com:yiisoft/yii2.git","clone_url":"https://github.com/yiisoft/yii2.git","svn_url":"https://github.com/yiisoft/yii2","homepage":"http://www.yiiframework.com","size":87780,"stargazers_count":14308,"watchers_count":14308,"language":"PHP","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":6857,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":521,"license":{"key":"bsd-3-clause","name":"BSD 3-Clause \"New\" or \"Revised\" License","spdx_id":"BSD-3-Clause","url":"https://api.github.com/licenses/bsd-3-clause","node_id":"MDc6TGljZW5zZTU="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["framework","hacktoberfest","php","php-framework","yii","yii2"],"visibility":"public","forks":6857,"open_issues":521,"watchers":14308,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Not sure this issue is valid. But I got this problem and would like to share this info.\n\nyii\\filters\\HttpCache works with HTTP_IF_MODIFIED_SINCE header. In order to get it from the browser you have to add to your first response Last-Modified header. \n\nThe problem is that default http://www.php.net/manual/en/session.configuration.php#ini.session.cache-limiter\nset to nocache. This means that you'll automatically get such headers after session started\n\nExpires: Thu, 19 Nov 1981 08:52:00 GMT\nCache-Control: no-store, no-cache, must-revalidate, post-check=0, pre-check=0\nPragma: no-cache\n\nbrowser consider this as you don't have cache. If you try to override this headers They will be just duplicated like \nExpires: Thu, 19 Nov 1981 08:52:00 GMT, [VALID DATE]\n\nYes yii allow to set HttpCache::sessionCacheLimiter. But the real problem is that you can't control if session has been already started. In my opinion it's very likely that you'll start session before Controller's filter. In most cases you have to authorize user using session.\n\nSo in order to make it work I had to delete such headers and \n\n``` php\n        foreach (headers_list() as $header) {\n            $header = explode(':', $header)[0];\n            header_remove($header);\n        }\n\n        $response = Yii::$app->getResponse();\n        $headers = $response->getHeaders();\n        $headers->set('Pragma');\n        $headers->set('Cache-Control', 'public, max-age=10800');\n```\n","reactions":{"url":"https://api.github.com/repos/yiisoft/yii2/issues/3638/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yiisoft/yii2/issues/3638/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":145278390,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDE0NTI3ODM5MA==","url":"https://api.github.com/repos/yiisoft/yii2/issues/events/145278390","actor":{"login":"tvdavid","id":8103082,"node_id":"MDQ6VXNlcjgxMDMwODI=","avatar_url":"https://avatars.githubusercontent.com/u/8103082?v=4","gravatar_id":"","url":"https://api.github.com/users/tvdavid","html_url":"https://github.com/tvdavid","followers_url":"https://api.github.com/users/tvdavid/followers","following_url":"https://api.github.com/users/tvdavid/following{/other_user}","gists_url":"https://api.github.com/users/tvdavid/gists{/gist_id}","starred_url":"https://api.github.com/users/tvdavid/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tvdavid/subscriptions","organizations_url":"https://api.github.com/users/tvdavid/orgs","repos_url":"https://api.github.com/users/tvdavid/repos","events_url":"