      ->all();\n    }\n```\n\n**_With the id set:**_\n\n```\n(int) 0 => object(App\\Model\\Entity\\BuildingTypesProject) {\n\n        'id' => (int) 5497,\n        'project' => object(App\\Model\\Entity\\Project) {\n\n            'country_id' => (int) 8,\n            '[new]' => false,\n            '[accessible]' => [\n                '*' => true\n            ],\n            '[dirty]' => [],\n            '[original]' => [],\n            '[virtual]' => [],\n            '[errors]' => [],\n            '[repository]' => 'Projects'\n\n        },\n        '[new]' => false,\n        '[accessible]' => [\n            '*' => true\n        ],\n        '[dirty]' => [],\n        '[original]' => [],\n        '[virtual]' => [],\n        '[errors]' => [],\n        '[repository]' => 'BuildingTypesProjects'\n\n    },\n```\n\n**_Without the id set:**_\n\n```\n(int) 0 => object(App\\Model\\Entity\\BuildingTypesProject) {\n\n        'Projects' => object(App\\Model\\Entity\\Project) {\n\n            'country_id' => (int) 8,\n            '[new]' => false,\n            '[accessible]' => [\n                '*' => true\n            ],\n            '[dirty]' => [],\n            '[original]' => [],\n            '[virtual]' => [],\n            '[errors]' => [],\n            '[repository]' => 'Projects'\n\n        },\n        '[new]' => false,\n        '[accessible]' => [\n            '*' => true\n        ],\n        '[dirty]' => [],\n        '[original]' => [],\n        '[virtual]' => [],\n        '[errors]' => [],\n        '[repository]' => 'BuildingTypesProjects'\n\n    },\n```\n","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/8112/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/cakephp/cakephp/issues/8112/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":578999622,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDU3ODk5OTYyMg=