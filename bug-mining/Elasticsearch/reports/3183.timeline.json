ntent.com/u/19536095?v=4","gravatar_id":"","url":"https://api.github.com/users/rseldner","html_url":"https://github.com/rseldner","followers_url":"https://api.github.com/users/rseldner/followers","following_url":"https://api.github.com/users/rseldner/following{/other_user}","gists_url":"https://api.github.com/users/rseldner/gists{/gist_id}","starred_url":"https://api.github.com/users/rseldner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rseldner/subscriptions","organizations_url":"https://api.github.com/users/rseldner/orgs","repos_url":"https://api.github.com/users/rseldner/repos","events_url":"https://api.github.com/users/rseldner/events{/privacy}","received_events_url":"https://api.github.com/users/rseldner/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-27T16:34:43Z","updated_at":"2024-11-27T17:07:12Z","body":"Observed this on `8.15.2` in Elastic Cloud.  The current master was reporting the following `INFO` level message hours after multiple nodes had left the cluster (disk quotas exceeded) (logger: `org.elasticsearch.cluster.InternalClusterInfoService`):\n```\nfailed to notify [org.elasticsearch.node.NodeConstruction$$Lambda/0x00007f551bded5f0@1baabe21] of new cluster info\njava.lang.NullPointerException: Cannot invoke \"org.elasticsearch.cluster.routing.RoutingNode.iterator()\" because the return value of \"org.elasticsearch.cluster.routing.RoutingNodes.node(String)\" is null\n\tat org.elasticsearch.cluster.routing.allocation.DiskThresholdMonitor.onNewInfo(DiskThresholdMonitor.java:388) ~[elasticsearch-8.15.2.jar:?]\n\tat org.elasticsearch.cluster.InternalClusterInfoService$AsyncRefresh.callListeners(InternalClusterInfoService.java:330) ~[elasticsearch-8.15.2.jar:?]\n\tat org.elasticsearch.core.AbstractRefCounted$1.closeInternal(AbstractRefCounted.java:118) ~[elasticsearch-core-8.15.2.jar:?]\n\tat org.elasticsearch.core.AbstractRefCounted.decRef(AbstractRefCounted.java:70) ~[elasticsearch-core-8.15.2.jar:?]\n\tat org.elasticsearch.action.support.RefCountingRunnable.close(RefCountingRunnable.java:112) ~[elasticsearch-8.15.2.jar:?]\n\tat org.elasticsearch.core.Releasables.close(Releasables.java:34) ~[elasticsearch-core-8.15.2.jar:?]\n\tat org.elasticsearch.core.Releasables.closeExpectNoException(Releasables.java:56) ~[elasticsearch-core-8.15.2.jar:?]\n\tat org.elasticsearch.action.ActionListenerImplementations$2.run(ActionListenerImplementations.java:49) ~[elasticsearch-8.15.2.jar:?]\n\tat org.elasticsearch.action.ActionListenerImplementations$RunAfterActionListener.onResponse(ActionListenerImplementations.java:271) ~[elasticsearch-8.15.2.jar:?]\n\tat org.elasticsearch.action.support.ThreadedActionListener$1.doRun(ThreadedActionListener.java:39) ~[elasticsearch-8.15.2.jar:?]\n\tat org.elasticsearch.common.util.concurrent.ThreadContext$ContextPreservingAbstractRunnable.doRun(ThreadContext.java:984) ~[elasticsearch-8.15.2.jar:?]\n\tat org.elasticsearch.common.util.concurrent.AbstractRunnable.run(AbstractRunnable.java:26) ~[elasticsearch-8.15.2.jar:?]\n\tat java.util.concurrent.ThreadPoolExecutor.runWorker(ThreadPoolExecutor.java:1144) ~[?:?]\n\tat java.util.concurrent.ThreadPoolExecutor$Worker.run(ThreadPoolExecutor.java:642) ~[?:?]\n\tat java.lang.Thread.run(Thread.java:1570) ~[?:?]\n```\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/comments/2504317911/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"rseldner","id":19536095,"node_id":"MDQ6VXNlcjE5NTM2MDk1","avatar_url":"https://avatars.githubusercontent.com/u/19536095?v=4","gravatar_id":"","url":"https://api.github.com/users/rseldner","html_url":"https://github.com/rseldner","followers_url":"https://api.github.com/users/rseldner/followers","following_url":"https://api.github.com/users/rseldner/following{/other_user}","gists_url":"https://api.github.com/users/rseldner/gists{/gist_id}","starred_url":"https://api.github.com/users/rseldner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rseldner/subscriptions","organizations_url":"https://api.github.com/users/rseldner/orgs","repos_url":"https://api.github.com/users/rseldner/repos","events_url":"https://api.github.com/users/rseldner/events{/privacy}","received_events_url":"https://api.github.com/users/rseldner/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/comments/2505297078","html_url":"https://github.com/elastic/elasticsearch/issues/100201#issuecomment-2505297078","issue_url":"https://api.github.com/repos/elastic/elasticsearch/issues/100201","id":2505297078,"node_id":"IC_kwDOAAe_f86VU8y2","user":{"login":"ywangd","id":2344308,"node_id":"MDQ6VXNlcjIzNDQzMDg=","avatar_url":"https://avatars.githubusercontent.com/u/2344308?v=4","gravatar_id":"","url":"https://api.github.com/users/ywangd","html_url":"https://github.com/ywangd","followers_url":"https://api.github.com/users/ywangd/followers","following_url":"https://api.github.com/users/ywangd/following{/other_user}","gists_url":"https://api.github.com/users/ywangd/gists{/gist_id}","starred_url":"https://api.github.com/users/ywangd/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ywangd/subscriptions","organizations_url":"https://api.github.com/users/ywangd/orgs","repos_url":"https://api.github.com/users/ywangd/repos","events_url":"https://api.github.com/users/ywangd/events{/privacy}","received_events_url":"https://api.github.com/users/ywangd/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-28T05:35:30Z","updated_at":"2024-11-28T05:35:30Z","body":"I think this can happen when the node-to-be-replaced (source) leaves the cluster before the corresponding shutdown metadat