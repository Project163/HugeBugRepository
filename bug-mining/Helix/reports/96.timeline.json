or/helix/issues{/number}","pulls_url":"https://api.github.com/repos/helix-editor/helix/pulls{/number}","milestones_url":"https://api.github.com/repos/helix-editor/helix/milestones{/number}","notifications_url":"https://api.github.com/repos/helix-editor/helix/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/helix-editor/helix/labels{/name}","releases_url":"https://api.github.com/repos/helix-editor/helix/releases{/id}","deployments_url":"https://api.github.com/repos/helix-editor/helix/deployments","created_at":"2020-06-01T04:26:56Z","updated_at":"2025-12-13T06:25:54Z","pushed_at":"2025-12-12T21:34:59Z","git_url":"git://github.com/helix-editor/helix.git","ssh_url":"git@github.com:helix-editor/helix.git","clone_url":"https://github.com/helix-editor/helix.git","svn_url":"https://github.com/helix-editor/helix","homepage":"https://helix-editor.com","size":74505,"stargazers_count":41809,"watchers_count":41809,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":true,"has_discussions":true,"forks_count":3200,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1362,"license":{"key":"mpl-2.0","name":"Mozilla Public License 2.0","spdx_id":"MPL-2.0","url":"https://api.github.com/licenses/mpl-2.0","node_id":"MDc6TGljZW5zZTE0"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["kakoune","rust","text-editor","vim"],"visibility":"public","forks":3200,"open_issues":1362,"watchers":41809,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/helix-editor/helix/pulls/5426","html_url":"https://github.com/helix-editor/helix/pull/5426","diff_url":"https://github.com/helix-editor/helix/pull/5426.diff","patch_url":"https://github.com/helix-editor/helix/pull/5426.patch","merged_at":"2023-01-16T07:13:48Z"},"body":"Fixes the issue described in #5424 \r\n\r\nThe code has been changed so that for unix type platforms a call is made to `libc::setsid` using the unix specific CommandExt [pre_exec](https://doc.rust-lang.org/std/os/unix/process/trait.CommandExt.html#tymethod.pre_exec).\r\n\r\nThe `setsid` call happens just after `fork` has been called and before `execve` is called. This means it runs in the context of the child process.\r\n\r\nThe call is necessary to ensure that spawned child processes related to the clipboard (e.g. `xclip`) have a distinct process session ID and process group ID.\r\n\r\nWithout this change when the parent process exits, the child (i.e. `xclip`), can be erroneously killed leading to copy/paste breaking in some specific circumstances such as those detailed in #5424 ","reactions":{"url":"https://api.github.com/repos/helix-editor/helix/issues/5426/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/helix-editor/helix/issues/5426/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/helix-editor/helix/issues/comments/1373264306","html_url":"https://github.com/helix-editor/helix/issues/5424#issuecomment-1373264306","issue_url":"https://api.github.com/repos/helix-editor/helix/issues/5424","id":1373264306,"node_id":"IC_kwDOD__WI85R2lmy","user":{"login":"gavynriebau","id":11895736,"node_id":"MDQ6VXNlcjExODk1NzM2","avatar_url":"https://avatars.githubusercontent.com/u/11895736?v=4","gravatar_id":"","url":"https://api.github.com/users/gavynriebau","html_url":"https://github.com/gavynriebau","followers_url":"https://api.github.com/users/gavynriebau/followers","following_url":"https://api.github.com/users/gavynriebau/following{/other_user}","gists_url":"https://api.github.com/users/gavynriebau/gists{/gist_id}","starred_url":"https://api.github.com/users/gavynriebau/starred{/owner}{/repo}","subscriptions_url":"https://ap