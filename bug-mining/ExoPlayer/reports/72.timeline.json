jw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"unlabeled","commit_id":null,"commit_url":null,"created_at":"2015-11-15T22:56:59Z","label":{"name":"question","color":"cc317c"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/156868288","html_url":"https://github.com/google/ExoPlayer/issues/958#issuecomment-156868288","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/958","id":156868288,"node_id":"MDEyOklzc3VlQ29tbWVudDE1Njg2ODI4OA==","user":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-11-15T23:16:49Z","updated_at":"2015-11-15T23:16:49Z","body":"This happens because ExoPlayer's Mp4Extractor claims compatibility with QuickTime files, but does not parse QuickTime `SoundDescription` entries correctly. Useful links:\n\nhttp://lists.apple.com/archives/QuickTime-API/2007/Oct/msg00061.html\nhttps://developer.apple.com/library/mac/documentation/QuickTime/QTFF/QTFFChap3/qtff3.html\nhttps://searchcode.com/codesearch/view/70087452/#l-69\n\nI think we need to:\n- Have Mp4Extractor read the brand out of the ftyp atom, to determine whether the file is QT rather than MP4.\n- Have AtomParsers parse `SoundDescription` entries rather than `AudioSample` entries if so (nb - the two are very similar, although structurally slightly different).\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/156868288/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/157007319","html_url":"https://github.com/google/ExoPlayer/issues/958#issuecomment-157007319","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/958","id":157007319,"node_id":"MDEyOklzc3VlQ29tbWVudDE1NzAwNzMxOQ==","user":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars