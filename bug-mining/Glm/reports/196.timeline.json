or order.\nAccording to that, not only shearZ3D, but all the shear functions are wrong.\n\nreferences\nhttp://www.cs.colorado.edu/~mcbryan/5229.03/mail/55.htm http://www.cs.colorado.edu/%7Emcbryan/5229.03/mail/55.htm \nhttp://run.usc.edu/cs480-s13/lec05-viewing/05-viewing-6up.pdf\n\n—\nReply to this email directly or view it on GitHub https://github.com/g-truc/glm/issues/403#issuecomment-148994811 .  https://github.com/notifications/beacon/ANlv6KyzJR1kZjD0bVSgYx2SB01yMlvNks5o81zkgaJpZM4F8RN5.gif \n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/g-truc/glm/issues/comments/149047147/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"TBurnettIII","id":14249960,"node_id":"MDQ6VXNlcjE0MjQ5OTYw","avatar_url":"https://avatars.githubusercontent.com/u/14249960?v=4","gravatar_id":"","url":"https://api.github.com/users/TBurnettIII","html_url":"https://github.com/TBurnettIII","followers_url":"https://api.github.com/users/TBurnettIII/followers","following_url":"https://api.github.com/users/TBurnettIII/following{/other_user}","gists_url":"https://api.github.com/users/TBurnettIII/gists{/gist_id}","starred_url":"https://api.github.com/users/TBurnettIII/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TBurnettIII/subscriptions","organizations_url":"https://api.github.com/users/TBurnettIII/orgs","repos_url":"https://api.github.com/users/TBurnettIII/repos","events_url":"https://api.github.com/users/TBurnettIII/events{/privacy}","received_events_url":"https://api.github.com/users/TBurnettIII/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":844142102,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDg0NDE0MjEwMg==","url":"https://api.github.com/repos/g-truc/glm/issues/events/844142102","actor":{"login":"Groovounet","id":367227,"node_id":"MDQ6VXNlcjM2NzIyNw==","avatar_url":"https://avatar