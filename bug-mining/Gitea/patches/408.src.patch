+			{`((?:[a-z][\w-]*)?\:)([a-z][\w-]*)`, ByGroups(NameNamespace, NameTag), nil},
+			{`#[^\n]+`, Comment, nil},
+			{`\b(true|false)\b`, Literal, nil},
+			{`[+\-]?\d*\.\d+`, LiteralNumberFloat, nil},
+			{`[+\-]?\d*(:?\.\d+)?E[+\-]?\d+`, LiteralNumberFloat, nil},
