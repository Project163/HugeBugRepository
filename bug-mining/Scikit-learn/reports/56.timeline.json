ython2.7/dist-packages/PIL/PpmImagePlugin.py\nm PIL.TiffImagePlugin       /usr/lib/python2.7/dist-packages/PIL/TiffImagePlugin.py\nm PIL.TiffTags              /usr/lib/python2.7/dist-packages/PIL/TiffTags.py\nm PIL._binary               /usr/lib/python2.7/dist-packages/PIL/_binary.py\n? ICCProfile imported from PIL.PngImagePlugin\n? _imaging_gif imported from PIL.GifImagePlugin\n? builtins imported from PIL.Image, matplotlib.pyparsing_py3, scipy.lib.six, sklearn.externals.joblib.my_exceptions, sklearn.externals.six\n```\n\nStrangely, `datasets` is not listed by the modulefinder.\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/scikit-learn/scikit-learn/issues/comments/37742624/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"larsmans","id":335383,"node_id":"MDQ6VXNlcjMzNTM4Mw==","avatar_url":"https://avatars.githubusercontent.com/u/335383?v=4","gravatar_id":"","url":"https://api.github.com/users/larsmans","html_url":"https://github.com/larsmans","followers_url":"https://api.github.com/users/larsmans/followers","following_url":"https://api.github.com/users/larsmans/following{/other_user}","gists_url":"https://api.github.com/users/larsmans/gists{/gist_id}","starred_url":"https://api.github.com/users/larsmans/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/larsmans/subscriptions","organizations_url":"https://api.github.com/users/larsmans/orgs","repos_url":"https://api.github.com/users/larsmans/repos","events_url":"https://api.github.com/users/larsmans/events{/privacy}","received_events_url":"https://api.github.com/users/larsmans/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/scikit-learn/scikit-learn/issues/comments/37742952","html_url":"https://github.com/scikit-learn/scikit-learn/issues/2961#issuecomment-37