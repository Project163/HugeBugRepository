+        ).build();
+        IllegalArgumentException iae = expectThrows(IllegalArgumentException.class, () -> RestActions.urlParamsToQueryBuilder(request));
+        assertEquals(
+            "request [/] contains parameters [df, analyzer, analyze_wildcard, lenient, default_operator] "
