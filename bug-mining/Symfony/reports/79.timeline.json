ns.\n- Query builder (if there will be more bulk insert queries like `INSERT INTO ... SELECT ...`)?\n\nOpen for discussion. Ideas welcome!\n","reactions":{"url":"https://api.github.com/repos/doctrine/dbal/issues/682/reactions","total_count":23,"+1":18,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":5,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/doctrine/dbal/issues/682/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":1539597339,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDE1Mzk1OTczMzk=","url":"https://api.github.com/repos/symfony/symfony/issues/events/1539597339","actor":{"login":"ostrolucky","id":496233,"node_id":"MDQ6VXNlcjQ5NjIzMw==","avatar_url":"https://avatars.githubusercontent.com/u/496233?v=4","gravatar_id":"","url":"https://api.github.com/users/ostrolucky","html_url":"https://github.com/ostrolucky","followers_url":"https://api.github.com/users/ostrolucky/followers","following_url":"https://api.github.com/users/ostrolucky/following{/other_user}","gists_url":"https://api.github.com/users/ostrolucky/gists{/gist_id}","starred_url":"https://api.github.com/users/ostrolucky/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ostrolucky/subscriptions","organizations_url":"https://api.github.com/users/ostrolucky/orgs","repos_url":"https://api.github.com/users/ostrolucky/repos","events_url":"https://api.github.com/users/ostrolucky/events{/privacy}","received_events_url":"https://api.github.com/users/ostrolucky/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"b644a2cd816e2cbf6d291332d9dfd92d93dd5aea","commit_url":"https://api.github.com/repos/ostrolucky/symfony/commits/b644a2cd816e2cbf6d291332d9dfd92d93dd5aea","created_at":"2018-03-25T13:21:12Z","performed_via_github_app":null},{"id":1539597343,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDE1Mzk1OTczNDM=","url":"https://api.github.com/repos/symfony/symfony/issues/events/1539597343"