asday/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":{"url":"https://api.github.com/repos/storybookjs/storybook/milestones/56","html_url":"https://github.com/storybookjs/storybook/milestone/56","labels_url":"https://api.github.com/repos/storybookjs/storybook/milestones/56/labels","id":6497182,"node_id":"MDk6TWlsZXN0b25lNjQ5NzE4Mg==","number":56,"title":"6.2 blocking","description":"","creator":{"login":"shilman","id":488689,"node_id":"MDQ6VXNlcjQ4ODY4OQ==","avatar_url":"https://avatars.githubusercontent.com/u/488689?v=4","gravatar_id":"","url":"https://api.github.com/users/shilman","html_url":"https://github.com/shilman","followers_url":"https://api.github.com/users/shilman/followers","following_url":"https://api.github.com/users/shilman/following{/other_user}","gists_url":"https://api.github.com/users/shilman/gists{/gist_id}","starred_url":"https://api.github.com/users/shilman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shilman/subscriptions","organizations_url":"https://api.github.com/users/shilman/orgs","repos_url":"https://api.github.com/users/shilman/repos","events_url":"https://api.github.com/users/shilman/events{/privacy}","received_events_url":"https://api.github.com/users/shilman/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":22,"state":"closed","created_at":"2021-03-02T12:59:51Z","updated_at":"2021-04-01T00:06:13Z","due_on":null,"closed_at":"2021-04-01T00:06:13Z"},"comments":8,"created_at":"2021-03-29T14:22:03Z","updated_at":"2021-04-02T10:12:04Z","closed_at":"2021-03-30T03:01:15Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**Describe the bug**\nAfter upgrade from v6.2.0-rc.10 to v6.2.0-rc.11 I got the following error in preview (displayed in UI):\n\n\n```\nCannot read property 'name' of undefined\nTypeError: Cannot read property 'name' of undefined\n    at createDefaultValue (http://localhost:6007/vendors~main.iframe.bundle.js:16438:33)\n    at createBasicPropDef (http://localhost:6007/vendors~main.iframe.bundle.js:16464:19)\n    at javaScriptFactory (http://localhost:6007/vendors~main.iframe.bundle.js:16501:17)\n    at extractProp (http://localhost:6007/vendors~main.iframe.bundle.js:16642:19)\n    at http://localhost:6007/vendors~main.iframe.bundle.js:16623:33\n    at Array.map (<anonymous>)\n    at extractComponentSectionObject (http://localhost:6007/vendors~main.iframe.bundle.js:16621:26)\n    at extractComponentProps (http://localhost:6007/vendors~main.iframe.bundle.js:16634:87)\n    at getPropDefs (http://localhost:6007/vendors~main.iframe.bundle.js:13848:106)\n    at extractProps (http://localhost:6007/vendors~main.iframe.bundle.js:13870:11)\n```\n\nFirst of all - **this error is useless. It doesn't point to any place where this occurs.** I spend a lot of time trying to find a place where it happened (we have ~30 components)...\n\n**To Reproduce**\n\nI found it is because of this weird combination of propTypes and defaultProps - happens if default prop is defined but propType is missing\n\nComponent: \n\n\n```tsx\nimport React from 'react';\nimport PropTypes from 'prop-types';\n\nexport const DATA_TYPE_STRING = 'string';\n\n// eslint-disable-next-line react/prefer-stateless-function\nexport class TestComponent extends React.Component {\n    static propTypes = {\n        // whatever here actually\n        test: PropTypes.number,\n        // dataType: PropTypes.string,\n    };\n\n    static defaultProps = {\n        test: [],\n        dataType: DATA_TYPE_STRING,\n    };\n\n    render() {\n        return <div>test</div>;\n    }\n}\n```\n\nStory:\n\n\n```tsx\nimport React from 'react';\nimport PropTypes from 'prop-types';\nimport { Story, Meta } from '@storybook/react';\n\nimport { TestComponent } from './TestComponent';\n\ntype TestComponentProps = PropTypes.InferProps<typeof TestComponent.propTypes>;\n\ntype TestComponentStory = Story<TestComponentProps>;\n\nexport default {\n    component: TestComponent,\n    title: 'Components/TestComponent',\n} as Meta<TestComponentProps>;\n\nconst Template: TestComponentStory = args => <TestComponent {...args} />;\n\nexport const Basic: TestComponentStory = Template.bind({});\n```\n\nIn our original component we have:\n\n```tsx\n        /**\n         * The format of the value\n         */\n        dataType: dataTypeShape,\n```\n\nand the `dataTypeShape` is defined outside so this may be the issue too.\n\n\n\n┆Issue is synchronized with this [Asana task](https://app.asana.com/0/1199622255231368/1200128122964622) by [Unito](https://www.unito.io/learn-more)\n","closed_by":{"login":"shilman","id":488689,"node_id":"MDQ6VXNlcjQ4ODY4OQ==","avatar_url":"https://avatars.githubusercontent.com/u/488689?v=4","gravatar_id":"","url":"https://api.github.com/users/shilman","html_url":"https://github.com/shilman","followers_url":"https://api.github.com/users/shilman/followers","following_url":"https://api.github.com/users/shilman/following{/other_user}","gists_url":"https://api.github.com/users/shilman/gists{/gist_id}","starred_url":"https://api.github.com/users/shilman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shilman/subscriptions","organizations_url":"https://api.github.com/users/shilman/orgs","repos_url":"https://api.github.com/users/shilman/repos","events_url":"https://api.github.com/users/shilman/events{/privacy}","received_events_url":"https://api.github.com/users/shilman/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/storybookjs/storybook/issues/14377/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/storyboo