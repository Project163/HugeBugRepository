zzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/632192949","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/5340#issuecomment-632192949","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5340","id":632192949,"node_id":"MDEyOklzc3VlQ29tbWVudDYzMjE5Mjk0OQ==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-05-21T16:30:32Z","updated_at":"2020-05-21T16:30:32Z","body":"OK lots of fixes, however there is a fundamental, very slight slowdown in the mechanics of Row, which bisect shows is directly due to cc718cccc where we reorganized row.  the previous approach of proxying to the original row simply has a little less overhead than our current approach of copying into a tuple, however what seems odd is that the profiling seems to claim it occurs at the tuple-access point, not at the row creation point.   not sure if this is an artifact of the profiling, or perhaps it has to do with Python allocating more memory to make a copy of the tuple.   We can look into maintaining some \"proxy to tuple\" beahvior in resultproxy.c, particularly if we don't have any processors which is going to be much more often the case, however trying to do this quickly was running into problems.    the current symptom is consuming 50000 rows and producing ORM objects from them is taking .75 seconds rather than about .65, so a tenth of a second per 50K rows in a heavy ORM context.   the simplicity of Row now is still likely worth it and we should just look into refining it to not copy the tuple if it doesn't need to, but this is not urgent.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/632192949/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/