+
+    // Step 3: Normalize by 1/2^n
+    double norm_factor = 1.0 / (double)state_len;
+    normalize_batch_kernel<<<gridSize, blockSize, 0, stream>>>(
+        state_complex_d,
+        total_elements,
+        norm_factor
+    );
+
     return (int)cudaGetLastError();
 }
 
