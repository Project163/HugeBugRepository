[{"id":6083167908,"node_id":"LE_lADOBC3Cis5D9FFuzwAAAAFqlcak","url":"https://api.github.com/repos/vercel/next.js/issues/events/6083167908","actor":{"login":"zzzorgo","id":17454987,"node_id":"MDQ6VXNlcjE3NDU0OTg3","avatar_url":"https://avatars.githubusercontent.com/u/17454987?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzorgo","html_url":"https://github.com/zzzorgo","followers_url":"https://api.github.com/users/zzzorgo/followers","following_url":"https://api.github.com/users/zzzorgo/following{/other_user}","gists_url":"https://api.github.com/users/zzzorgo/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzorgo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzorgo/subscriptions","organizations_url":"https://api.github.com/users/zzzorgo/orgs","repos_url":"https://api.github.com/users/zzzorgo/repos","events_url":"https://api.github.com/users/zzzorgo/events{/privacy}","received_events_url":"https://api.github.com/users/zzzorgo/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2022-02-16T14:21:17Z","label":{"name":"template: bug","color":"fddf99"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1042651524","html_url":"https://github.com/vercel/next.js/issues/34425#issuecomment-1042651524","issue_url":"https://api.github.com/repos/vercel/next.js/issues/34425","id":1042651524,"node_id":"IC_kwDOBC3Cis4-JZmE","user":{"login":"zzzorgo","id":17454987,"node_id":"MDQ6VXNlcjE3NDU0OTg3","avatar_url":"https://avatars.githubusercontent.com/u/17454987?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzorgo","html_url":"https://github.com/zzzorgo","followers_url":"https://api.github.com/users/zzzorgo/followers","following_url":"https://api.github.com/users/zzzorgo/following{/other_user}","gists_url":"https://api.github.com/users/zzzorgo/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzorgo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzorgo/subscriptions","organizations_url":"https://api.github.com/users/zzzorgo/orgs","repos_url":"https://api.github.com/users/zzzorgo/repos","events_url":"https://api.github.com/users/zzzorgo/events{/privacy}","received_events_url":"https://api.github.com/users/zzzorgo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-02-17T07:31:18Z","updated_at":"2022-02-17T07:31:18Z","body":"I have found temporary workaround for this issue. Since `react` is not actually needed for middleware to operate I am adding react-mock to final `_middleware` asset with custom webpack plugin.\r\n```js\r\n// customWebpackPlugin.js\r\nconst fs = require('fs');\r\n\r\nclass TextAdditionToFinalAsset {\r\n    constructor(textContent, filePathRegExp) {\r\n        this.textContent = textContent;\r\n        this.filePathRegExp = filePathRegExp;\r\n    }\r\n\r\n    apply(compiler) {\r\n        compiler.hooks.assetEmitted.tap('TextAdditionToFinalAsset', (_, { content, targetPath }) => {\r\n            if (targetPath.match(this.filePathRegExp)) {\r\n                const newContent = `${this.textContent}\\n${content.toString()}`;\r\n                fs.writeFileSync(targetPath, newContent);\r\n            }\r\n        });\r\n    }\r\n}\r\n\r\nmodule.exports = TextAdditionToFinalAsset;\r\n```\r\n\r\n```js\r\n// next.config.js\r\n/** @type {import('next').NextConfig} */\r\n\r\nconst TextAdditionToFinalAsset = require('./customWebpackPlugin');\r\n\r\nconst nextConfig = {\r\n  reactStrictMode: true,\r\n\r\n  webpack(config, { isServer }) {\r\n    if (!isServer) {\r\n      config.externals = {\r\n          ...(config.externals || {}),\r\n          react: 'React',\r\n          'react-dom': 'ReactDOM',\r\n      };\r\n\r\n      config.plugins.push(\r\n            new TextAdditionToFinalAsset(\r\n                  'var React = { createContext() {}};',\r\n                  /\\.next\\/server\\/pages\\/_middleware\\.js/,\r\n            ),\r\n      );\r\n    }\r\n\r\n    return config;\r\n  }\r\n}\r\n\r\nmodule.exports = nextConfig\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1042651524/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzorgo","id":17454987,"node_id":"MDQ6VXNlcjE3NDU0OTg3","avatar_url":"https://avatars.githubusercontent.com/u/17454987?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzorgo","html_url":"https://github.com/zzzorgo","followers_url":"https://api.github.com/users/zzzorgo/followers","following_url":"https://api.github.com/users/zzzorgo/following{/other_user}","gists_url":"https://api.github.com/users/zzzorgo/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzorgo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzorgo/subscriptions","organizations_url":"https://api.github.com/users/zzzorgo/orgs","repos_url":"https://api.github.com/users/zzzorgo/repos","events_url":"https://api.github.com/users/zzzorgo/events{/privacy}","received_events_url":"https://api.github.com/users/zzzorgo/received_events","type":"User","user_view_type":"public","site_admin":false}},{"actor":{"login":"balazsorban44","id":18369201,"node_id":"MDQ6VXNlcjE4MzY5MjAx","avatar_url":"https://avatars.githubusercontent.com/u/18369201?v=4","gravatar_id":"","url":"https://api.github.com/users/balazsorban44","html_url":"https://github.com/balazsorban44","followers_url":"https://api.github.com/users/balazsorban44/followers","following_url":"https://api.github.com/users/balazsorban44/following{/other_user}","gists_url":"https://api.github.com/users/balazsorban44/gists{/gist_id}","starred_url":"https://api.github.com/users/balazsorban44/starred{/owner}{/repo}","subscriptions_url":"https://api.github.co