glm::to_string(m) << endl;\n    cout << \"i: \" << glm::to_string(i) << endl;\n    cout << \"1: \" << glm::to_string(m * i) << endl;\n}\n```\n\nOutput:\n\n```\nm: mat4x4((2.000000, 0.000000, 0.000000, 0.000000), (0.000000, 2.000000, 0.000000, 0.000000), (0.000000, 0.000000, 2.000000, 0.000000), (0.000000, 0.000000, 0.000000, 1.000000))\ni: mat4x4((2.000000, 0.000000, 0.000000, 0.000000), (0.000000, 2.000000, 0.000000, 0.000000), (0.000000, 0.000000, 2.000000, 0.000000), (0.000000, 0.000000, 0.000000, 1.000000))\n1: mat4x4((4.000000, 0.000000, 0.000000, 0.000000), (0.000000, 4.000000, 0.000000, 0.000000), (0.000000, 0.000000, 4.000000, 0.000000), (0.000000, 0.000000, 0.000000, 1.000000))\n```\n","closed_by":{"login":"Groovounet","id":367227,"node_id":"MDQ6VXNlcjM2NzIyNw==","avatar_url":"https://avatars.githubusercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/g-truc/glm/issues/192/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/g-truc/glm/issues/192/timeline","performed_via_github_app":null,"state_reason":"completed"}