ng\r\nfrom sqlalchemy.ext.declarative import declarative_base\r\nfrom sqlalchemy.orm import declarative_base\r\nBase = declarative_base()\r\n\r\n\r\nclass A(Base):\r\n    __tablename__ = 'a'\r\n\r\n    id = Column(Integer, primary_key=True)\r\n    data = Column(String)\r\n\r\n\r\na1 = select(A.__table__).subquery(\"a1\")\r\na2 = select(A.__table__).subquery(\"a2\")\r\n\r\nstmt = select(a1, a2).select_from(a1.join(a2, a1.c.id == a2.c.id))\r\n\r\ne = create_engine(\"postgresql://scott:tiger@localhost/test\", echo='debug')\r\n\r\nwith e.connect() as conn:\r\n    conn.begin()\r\n    Base.metadata.create_all(conn)\r\n\r\n    conn.execute(\r\n        A.__table__.insert(),\r\n        {\"id\": 1, \"data\": \"some data\"}\r\n    )\r\n    result = conn.execute(\r\n        stmt.set_label_style(LABEL_STYLE_TABLENAME_PLUS_COL)\r\n    )\r\n    row = result.fetchone()\r\n    print(row.keys())\r\n\r\n```\r\n\r\n\r\noutput:\r\n\r\n```sql\r\nSELECT a1.id AS a1_id, a1.data AS a1_data, a2.id AS a2_id, a2.data AS a2_data \r\nFROM (SELECT a.id AS id, a.data AS data \r\nFROM a) AS a1 JOIN (SELECT a.id AS id, a.data AS data \r\nFROM a) AS a2 ON a1.id = a2.id\r\n2021-02-11 11:55:15,741 INFO sqlalchemy.engine.Engine [generated in 0.00021s] {}\r\n2021-02-11 11:55:15,742 DEBUG sqlalchemy.engine.Engine Col ('a1_id', 'a1_data', 'a2_id', 'a2_data')\r\n2021-02-11 11:55:15,742 DEBUG sqlalchemy.engine.Engine Row (1, 'some data', 1, 'some data')\r\nRMKeyView(['a1_id', 'a1_data', 'a2_id', 'a2_data'])\r\n\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/777639142/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/777643517","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/5933#issuecomment-777643517","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5933","id":777643517,"node_id":"MDEyOklzc3VlQ29tbWVudDc3NzY0MzUxNw==","user":{"login":"bencf","id":2965904,"node_id":"MDQ6VXNlcjI5NjU5MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/2965904?v=4","gravatar_id":"","url":"https://api.github.com/users/bencf","html_url":"https://github.com/bencf","followers_url":"https://api.github.com/users/bencf/followers","following_url":"https://api.github.com/users/bencf/following{/other_user}","gists_url":"https://api.github.com/users/bencf/gists{/gist_id}","starred_url":"https://api.github.com/users/bencf/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bencf/subscriptions","organizations_url":"https://api.github.com/users/bencf/orgs","repos_url":"https://api.github.com/users/bencf/repos","events_url":"https://api.github.com/users/bencf/events{/privacy}","received_events_url":"https://api.github.com/users/bencf/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-02-11T17:02:09Z","updated_at":"2021-02-11T17:02:09Z","body":"Thanks, Mike, this is very helpful. Let me try to match your test with my code and see if I can identify the key differences and if I can get it to reproduce.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/777643517/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"bencf","id":2965904,"node_id":"MDQ6VXNlcjI5NjU5MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/2965904?v=4","gravatar_id":"","url":"https://api.github.com/users/bencf","html_url":"https://github.com/bencf","followers_url":"https://api.github.com/users/bencf/followers","following_url":"https://api.github.com/users/bencf/following{/other_user}","gists_url":"https://api.github.com/users/bencf/gists{/gist_id}","starred_url":"https://api.github.com/users/bencf/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bencf/subscriptions","organizations_url":"https://api.github.com/users/bencf/orgs","repos_url":"https://api.github.com/users/bencf/repos","events_url":"https://api.github.com/users/bencf/events{/privacy}","received_events_url":"https://api.github.com/users/bencf/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/777672343","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/5933#issuecomment-777672343","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5933","id":777672343,"node_id":"MDEyOklzc3VlQ29tbWVudDc3NzY3MjM0Mw==","user":{"login":"bencf","id":2965904,"node_id":"MDQ6VXNlcjI5NjU5MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/2965904?v=4","gravatar_id":"","url":"https://api.github.com/users/bencf","html_url":"https://github.com/bencf","followers_url":"https://api.github.com/users/bencf/followers","following_url":"https://api.github.com/users/bencf/following{/other_user}","gists_url":"https://api.github.com/users/bencf/gists{/gist_id}","starred_url":"https://api.github.com/users/bencf/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bencf/subscriptions","organizations_url":"https://api.github.com/users/bencf/orgs","repos_url":"https://api.github.com/users/bencf/repos","events_url":"https://api.github.com/users/bencf/events{/privacy}","received_events_url":"https://api.github.com/users/bencf/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-02-11T17:46:52Z","updated_at":"2021-02-11T17:46:52Z","body":"OK, I figured out how to reproduce it.\r\n\r\nThe differences with your test are:\r\n(1) Using `Session`\r\n(2) Specifying the fields in the select\r\n\r\nEither change by itself doesn't reproduce the problem, only the combination of them.\r\n\r\nIn your code, replace:\r\n```py\r\na1 = select(A.__table__).subquery(\"a1\")\r\na2 = select(A.__table__).subquery(\"a2\")\r\n```\r\nwith\r\n```py\r\na1 = select(A.id, A.data).subquery(\"a1\")\r\na2 = select(A.id, A.data).subquery(\"a2\")\r\n```\r\n\r\nAnd replace this:\r\n```py\r\nwith e.connect() as conn:\r\n    conn.begin()\r\n    Base.metadata.create_all(conn)\r\n\r\n    conn.execute(\r\n        A.__table__.insert(),\r\n        {\"id\": 1, \"data\": \"some data\"}\r\n    )\r\n    result = conn.execute(\r\n        stmt.set_label_style(LABEL_STYLE_TABLENAME_PLUS_COL)\r\n    )\r\n    row = result.fetchone()\r\n    print(row.keys())\r\n```\r\nwith\r\n```py\r\nwith Session(e) as session:\r\n    Base.metadata.create_all(e)\r\n\r\n    session.execute(\r\n        A.__table__.insert(),\r\n        {\"id\": 1, \"data\": \"some data\"}\r\n    )\r\n    result = session.execute(\r\n        stmt.set_label_style(LABEL_STYLE_TABLENAME_PLUS_COL)\r\n    )\r\n    row = result.fetchone()\r\n    print(row.keys())\r\n```\r\n(As well as importing `Session`.)\r\n\r\nThat gives me this output:\r\n```sql\r\nSELECT a1.id AS a1_id, a1.data AS a1_data, a2.id AS a2_id, a2.data AS a2_data\r\nFROM (SELECT a.id AS id, a.data AS data\r\nFROM a) AS a1 JOIN (SELECT a.id AS id, a.data AS data\r\nFROM a) AS a2 ON a1.id = a2.id\r\n2021-02-11 12:35:30,427 INFO sqlalchemy.engine.Engine [generated in 0.00026s] {}\r\nRMKeyView(['id', 'data', 'id', 'data'])\r\n```\r\n\r\nAs I said, I am very new to SQLAlchemy so it's possible I'm misunderstanding why these changes *should* produce this behavior, but given that the SQL query is labeled properly, it's not clear to me why these changes should change anything about the output to the result.\r\n\r\nThanks again for the help (and for the quick response)!","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/777672343/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"bencf","id":2965904,"node_id":"MDQ6VXNlcjI5NjU5MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/2965904?v=4","gravatar_id":"","url":"https://api.github.com/users/bencf","html_url":"https://github.com/bencf","followers_url":"https://api.github.com/users/bencf/followers","following_url":"https://api.github.com/users/bencf/following{/other_user}","gists_url":"https://api.github.com/users/bencf/gists{/gist_id}","starred_url":"https://api.github.com/users/bencf/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bencf/subscriptions","organizations_url":"https://api.github.com/users/bencf/orgs","repos_url":"https://api.github.com/users/bencf/repos","events_url":"https://api.github.com/users/bencf/events{/privacy}","received_events_url":"https://api.github.com/users/bencf/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/777676029","html_url":"https://github.com/sqlalchemy/