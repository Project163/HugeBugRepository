-        List<Edge> edgesToNode = joinsGraph.edgesToNode.get(tableRef);
-
-        if (edgesFromNode == null) {
-            return false;
-        }
-
-        if (edgesToNode == null) {
-            return false;
-        }
-
-        if (edgesToNode.size() != edgesFromNode.size()) {
-            return false;
-        }
-
-        for (Edge edge : edgesFromNode) {
-            if (edge.join.isLeftJoin()) {
-                return false;
-            }
-        }
-
-        return true;
-    }
