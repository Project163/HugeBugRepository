/wardbell/followers","following_url":"https://api.github.com/users/wardbell/following{/other_user}","gists_url":"https://api.github.com/users/wardbell/gists{/gist_id}","starred_url":"https://api.github.com/users/wardbell/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wardbell/subscriptions","organizations_url":"https://api.github.com/users/wardbell/orgs","repos_url":"https://api.github.com/users/wardbell/repos","events_url":"https://api.github.com/users/wardbell/events{/privacy}","received_events_url":"https://api.github.com/users/wardbell/received_events","type":"User","user_view_type":"public","site_admin":false},"performed_via_github_app":null},{"url":"https://api.github.com/repos/angular/angular/issues/comments/295030461","html_url":"https://github.com/angular/angular/issues/16100#issuecomment-295030461","issue_url":"https://api.github.com/repos/angular/angular/issues/16100","id":295030461,"node_id":"MDEyOklzc3VlQ29tbWVudDI5NTAzMDQ2MQ==","user":{"login":"wardbell","id":129061,"node_id":"MDQ6VXNlcjEyOTA2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/129061?v=4","gravatar_id":"","url":"https://api.github.com/users/wardbell","html_url":"https://github.com/wardbell","followers_url":"https://api.github.com/users/wardbell/followers","following_url":"https://api.github.com/users/wardbell/following{/other_user}","gists_url":"https://api.github.com/users/wardbell/gists{/gist_id}","starred_url":"https://api.github.com/users/wardbell/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wardbell/subscriptions","organizations_url":"https://api.github.com/users/wardbell/orgs","repos_url":"https://api.github.com/users/wardbell/repos","events_url":"https://api.github.com/users/wardbell/events{/privacy}","received_events_url":"https://api.github.com/users/wardbell/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-04-19T00:59:02Z","updated_at":"2017-04-19T01:00:10Z","body":"I don’t know how to cure the artifacts described by @igorminar in issue 16100. Presumably they occur on slow network/slow device.\r\n\r\nThe word \"key\" is likely the consequence of delayed processing of the `<md-icon>`. Here's the source:\r\n```\r\n<md-icon class=\"rotating-icon\">keyboard_arrow_right</md-icon>\r\n```\r\nIs there a way to know when the `<md-icon>` has done its job? Or when Angular had done its job? I suppose we could hide the nav items until `afterViewInit` + a tick. If we start going down that road, I fear the wheels just come off of Angular altogether. \r\n\r\nI don't know what the blue line is about but I've seen stuff like that and I believe it is a Material Design style that doesn't go away immediately.\r\n\r\nTo whom should we turn? Jeremy?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/comments/295030461/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"wardbell","id":129061,"node_id":"MDQ6VXNlcjEyOTA2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/129061?v=4","gravatar_id":"","url":"https://api.github.com/users/wardbell","html_url":"https://github.com/wardbell","followers_url":"https://api.github.com/users/wardbell/followers","following_url":"https://api.github.com/users/wardbell/following{/other_user}","gists_url":"https://api.github.com/users/wardbell/gists{/gist_id}","starred_url":"https://api.github.com/users/wardbell/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wardbell/subscriptions","organizations_url":"https://api.github.com/users/wardbell/orgs","repos_url":"https://api.github.com/users/wardbell/repos","events_url":"https://api.github.com/users/wardbell/events{/privacy}","received_events_url":"https://api.github.com/users/wardbell/received_events","type":"User","user_view_type":"public","site_admi