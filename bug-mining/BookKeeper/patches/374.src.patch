-    doStartDelivery(origHandler, origFilter);
-    // STARTING_DELIVERY => STARTED_DELIVERY
-    setDeliveryState(STARTED_DELIVERY);
-  } catch (const std::exception& e) {
-    // STARTING_DELIVERY => STOPPED_DELIVERY
