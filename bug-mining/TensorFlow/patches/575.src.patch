+      {0x1.EFFFFEp7, 0x1.Ep7},  // Largest number that doesn't overflow
+      {0x1.Fp7, nan},           // Smallest number that overflows
+      {0x1p8, nan},             // Overflow
+      {0x1p-7, 0x1p-7},         // Smallest F8 normal
