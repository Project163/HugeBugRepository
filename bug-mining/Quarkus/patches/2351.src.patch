diff --git a/integration-tests/test-extension/extension/deployment/src/test/java/io/quarkus/config/ByteArrayConverterTest.java b/integration-tests/test-extension/extension/deployment/src/test/java/io/quarkus/config/ByteArrayConverterTest.java
