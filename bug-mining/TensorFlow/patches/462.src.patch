+        DOWNLOAD_RESULT := $(shell $(MAKEFILE_DIR)/ext_libs/cmsis_download.sh ${MAKEFILE_DIR}/downloads)
+        ifneq ($(DOWNLOAD_RESULT), SUCCESS)
+          $(error Something went wrong with the CMSIS download: $(DOWNLOAD_RESULT))
+        endif
       endif
     endif
 
