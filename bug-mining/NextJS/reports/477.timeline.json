z"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["blog","browser","compiler","components","hybrid","nextjs","node","react","server-rendering","ssg","static","static-site-generator","universal","vercel"],"visibility":"public","forks":30029,"open_issues":3156,"watchers":136480,"default_branch":"canary","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/vercel/next.js/pulls/53687","html_url":"https://github.com/vercel/next.js/pull/53687","diff_url":"https://github.com/vercel/next.js/pull/53687.diff","patch_url":"https://github.com/vercel/next.js/pull/53687.patch","merged_at":"2023-08-07T20:05:22Z"},"body":"Edge runtime doesn't have `/404` entry points as not-found, if server hits 404 it's hitting `/_not-found` entry point of edge bundles unlike nodejs server rendering.\r\n\r\nIn app-render it needs the information that when `pathname` (or can call `pagePath`) is `/404` it can render the `not-found.js` components properly\r\n\r\nSeparate the not-found test suite into 2 parts, a basic case testing all urls with `not-found.js` boundary, and another conflict route case with `not-found.js` with `not-found/` route at the same time\r\n\r\nFixes #53652\r\n","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/53687/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vercel/next.js/issues/53687/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":10028282068,"node_id":"CE_lADOBC3Cis5tlyv-zwAAAAJVu3DU","url":"https://api.github.com/repos/vercel/next.js/issues/events/10028282068","actor":{"login":"kodiakhq[bot]","id":49736102,"node_id":"MDM6Qm90NDk3MzYxMDI=","avatar_url":"https://avatars.githubusercontent.com/in/29196?v=4","gravatar_id":"","url":"https://api.github.com/users/kodiakhq%5Bbot%5D