-  IsCreateTableDoneRequestPB wait_req;
-  IsCreateTableDoneResponsePB wait_resp;
-  CreateSnapshotRequestPB snapshot_req;
-  CreateSnapshotResponsePB snapshot_resp;
-
-  for (int i = 0; i < tables_meta.size(); ++i) {
