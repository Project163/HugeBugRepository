duced further:\n\n``` python\nfrom typing import Function, typevar\n\nA = typevar('A')\n\ndef voidify(n: int) -> None:\n    pass\n\ndef identity(f: Function[[A], None]) -> Function[[A], None]:\n    return f\n\nidentity(voidify)(3)\n```\n\nThe return type doesn't matter, can be a `typevar` or a builtin type or `None`.  What specifically matters is that an argument be a `typevar`.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/49091761/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"jswalden","id":4139753,"node_id":"MDQ6VXNlcjQxMzk3NTM=","avatar_url":"https://avatars.githubusercontent.com/u/4139753?v=4","gravatar_id":"","url":"https://api.github.com/users/jswalden","html_url":"https://github.com/jswalden","followers_url":"https://api.github.com/users/jswalden/followers","following_url":"https://api.github.com/users/jswalden/following{/other_user}","gists_url":"https://api.github.com/users/jswalden/gists{/gist_id}","starred_url":"https://api.github.com/users/jswalden/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jswalden/subscriptions","organizations_url":"https://api.github.com/users/jswalden/orgs","repos_url":"https://api.github.com/users/jswalden/repos","events_url":"https://api.github.com/users/jswalden/events{/privacy}","received_events_url":"https://api.github.com/users/jswalden/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":145440376,"node_id":"MDE0OlVubGFiZWxlZEV2ZW50MTQ1NDQwMzc2","url":"https://api.github.com/repos/python/mypy/issues/events/145440376","actor":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"h