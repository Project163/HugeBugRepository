+
+    // -------------------------------------------------------------------------
+    // Public Implemented Properties
+    // -------------------------------------------------------------------------
+
+    /**
+     * Connection options.
+     */
+    options: AuroraMysqlConnectionOptions
+
+    /**
+     * Database name used to perform all write queries.
+     */
+    database?: string
+
+    /**
+     * Schema name used to performn all write queries.
+     */
+    schema?: string
+
+    /**
