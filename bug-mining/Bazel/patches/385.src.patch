 cd "$TEST_SRCDIR"
 "$@"
 TEST_STATUS=$?
 
-# If LCOV_MERGER is not set, coverage is not supported.
-if [[ -z "$LCOV_MERGER" ]]; then
-  exit $TEST_STATUS
-fi
