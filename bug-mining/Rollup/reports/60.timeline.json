lic","forks":1656,"open_issues":611,"watchers":26142,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"As best I can tell, `export default` should export a binding, but in the following case, it does not:\n\n``` js\n// value.js\nlet value = 4;\nexport function set(_value) {value = _value;}\nexport default value;\n\n// main.js\nimport value, {set} from './value.js';\nconsole.log(value);\nset(2);\nconsole.log(value);\n```\n\nAs it produces\n\n``` js\n'use strict';\n\nlet value = 4;\nfunction set(_value) {value = _value;}\nvar value$1 = value;\n\nconsole.log(value$1);\nset(2);\nconsole.log(value$1);\n```\n\nWhich prints\n\n```\n4\n4\n```\n\ninstead of \n\n```\n4\n2\n```\n\nHowever, if I instead write `export {value as default};`, it functions as expected.\n","reactions":{"url":"https://api.github.com/repos/rollup/rollup/issues/807/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/rollup/rollup/issues/807/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":793438994,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDc5MzQzODk5NA==","url":"https://api.github.com/repos/rollup/rollup/issues/events/793438994","actor":{"login":"Rich-Harris","id":1162160,"node_id":"MDQ6VXNlcjExNjIxNjA=","avatar_url":"https://avatars.githubusercontent.com/u/1162160?v=4","gravatar_id":"","url":"https://api.github.com/users/Rich-Harris","html_url":"https://github.com/Rich-Harris","followers_url":"https://api.github.com/users/Rich-Harris/followers","following_url":"https://api.github.com/users/Rich-Harris/following{/other_user}","gists_url":"https://api.github.com/users/Rich-Harris/gists{/gist_id}","starred_url":"https://api.github.com/users/Rich-Harris/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rich-Harris/subscriptions","organizations_url":"https://api.git