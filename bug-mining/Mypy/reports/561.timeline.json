y":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/python/mypy/issues/comments/58827615","html_url":"https://github.com/python/mypy/issues/474#issuecomment-58827615","issue_url":"https://api.github.com/repos/python/mypy/issues/474","id":58827615,"node_id":"MDEyOklzc3VlQ29tbWVudDU4ODI3NjE1","user":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-10-12T23:39:48Z","updated_at":"2014-10-12T23:39:48Z","body":"Actually, this is a different issue from #307. Referring to `B` within a method body is normally not possible without using `self.X` or `A.B`, and thus disallowing it in type annotations is consistent. For example, this would fail:\n\n``` python\nfrom typing import *\n\nclass A:\n    class B:\n        pass\n\n    def f() -> None:\n        x = List[B]()   # B not bound in this scope\n```\n\n`A.B` is currently supported by mypy, but `self.B` is not recognized as a valid type. Maybe `self.B` should be a valid type in the above example? However, `self.B` is a different type from `A.B`, since a subclass of `A` could override `B`, but the type system can't represent this distinction. Oh well.\n","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/58827615/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":177445628,"node_id":"MDE0OlVubGFiZWxlZEV2ZW50MTc3NDQ1NjI4","url":"https://api.github.com/repos/python/mypy/issues/events/177445628","actor":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"unlabeled","commit_id":null,"commit_url":null,"created_at":"2014-10-13T00:21:47Z","label":{"name":"priority","color":"f7c6c7"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/python/mypy/issues/comments/58830015","html_url":"https://github.com/python/mypy/issues/474#issuecomment-58830015","issue_url":"https://api.github.com/repos/python/mypy/issues/474","id":58830015,"node_id":"MDEyOklzc3VlQ29tbWVudDU4ODMwMDE1","user":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-10-13T00:22:06Z","updated_at":"2014-10-13T00:22:06Z","body":"Removed priority tag since this needs more thought.\n","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/58830015/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/python/mypy/issues/comments/58848036","html_url":"https://github.com/python/mypy/issues/474#issuecomment-58848036","issue_url":"https://api.github.com/repos/python/mypy/issues/474","id":58848036,"node_id":"MDEyOklzc3VlQ29tbWVudDU4ODQ4MDM2","user":{"login":"spkersten","id":4456832,"node_id":"MDQ6VXNlcjQ0NTY4MzI=","avatar_url":"https://avatars.githubusercontent.com/u/4456832?v=4","gravatar_id":"","url":"https://api.github.com/users/spkersten","html_url":"https://github.com/spkersten","followers_url":"https://api.github.com/users/spkersten/followers","following_url":"https://api.github.com/users/spkersten/following{/other_user}","gists_url":"https://api.github.com/users/spkersten/gists{/gist_id}","starred_url":"https://api.github.com/users/spkersten/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/spkersten/subscriptions","organizations_url":"https://api.github.com/users/spkersten/orgs","repos_url":"https://api.github.com/users/spkersten/repos","events_url":"https://api.github.com/users/spkersten/events{/privacy}","received_events_url":"https://api.github.com/users/spkersten/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-10-13T05:46:09Z","updated_at":"2014-10-13T05:46:09Z","body":"Is a subclass of `A` allowed to override `B` though? The baseclass might be using `self.B` in both covariant and contravariant ways. Overriding `B` might therefore break the subtype relation between `A` and the subclass. Mypy could try to determine whether `self.B` is used only either covariantly or contravariantly and treat `self.B` as a sub or super type, respectively, of `A.B`. (And restrict in which direction the type may change when `A` is subtyped.)\n\nOr alternatively, maybe referring to types in `self` should not be allowed (requiring always `A.B`). \n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/58848036/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"spkersten","id":4456832,"node_id":"MDQ6VXNlcjQ0NTY4MzI=","avatar_url":"https://avatars.githubusercontent.com/u/4456832?v=4","gravatar_id":"","url":"https://api.github.com/users/spkersten","html_url":"https://github.com/spkersten","followers_url":"https://api.github.com/users/spkersten/followers","following_url":"https://api.github.com/users/spkersten/following{/other_user}","gists_url":"https://api.github.com/users/spkersten/gists{/gist_id}","starred_url":"https://api.github.com/users/spkersten/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/spkersten/subscriptions","organizations_url":"https://api.github.com/users/spkersten/orgs","repos_url":"https://api.github.com/users/spkersten/repos","events_url":"https://api.github.com/users/spkersten/events{/privacy}","received_events_url":"https://api.github.com/users/spkersten/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/python/mypy/issues/comments/291255573","html_url":"https://github.com/python/mypy/issues/474#issuecomment-291255573","issue_url":"https://api.github.com/repos/python/mypy/issues/474","id":291255573,"node_id":"MDEyOklzc3VlQ29tbWVudDI5MTI1NTU3Mw==","user":{"login":"elazarg","id":5108069,"node_id":"MDQ6VXNlcjUxMDgwNjk=","avatar_url":"https://avatars.githubusercontent.com/u/5108069?v=4","gravatar_id":"","url":"https://api.github.com/users/elazarg","html_url":"https://github.com/elazarg","followers_url":"https://api.github.com/users/elazarg/followers","following_url":"https://api.github.com/users/elazarg/following{/other_user}","gists_url":"https://api.github.com/users/elazarg/gists{/gist_id}","starred_url":"https://api.github.com/users/elazarg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elazarg/subscriptions","organizations_url":"https://api.github.com/users/elazarg/orgs","repos_url":"https://api.github.com/users/elazarg/repos","events_url":"https://api.github.com/users/elazarg/events{/privacy}","received_events_url":"https://api.github.com/users/elazarg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-04-03T19:57:20Z","updated_at":"2017-04-03T19:57:20Z","body":"I don't understand this issue, The inner class is recognized when accessed using `A.B` as it should be. If the discussion is about `self.B` (which to me sounds like requiring Scala-style path-dependent type system) then the title of the issue and the example are unrelated.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/291255573/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"elazarg","id":5108069,"node_id":"MDQ6VXNlcjUxMDgwNjk=","avatar_url":"https://avatars.githubusercontent.com/u/5108069?v=4","gravatar_id":"","url":"https://api.github.com/users/elazarg","html_url":"https://github.com/elazarg","followers_url":"https://api.github.com/users/elazarg/followers","following_url":"https://api.github.com/users/elazarg/following{/other_user}","gists_url":"https://api.github.com/users/elazarg/gists{/gist_id}","starred_url":"https://api.github.com/users/elazarg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elazarg/subscriptions","organizations_url":"https://api.github.com/users/elazarg/orgs","repos_url":"https://api.github.com/users/elazarg/repos","events_url":"https://api.github.com/users/elazarg/events{/privacy}","received_events_url":"https://api.github.com/users/elazarg/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/python/mypy/issues/comments/291259603","html_url":"https://github.com/python/mypy/issues/474#issuecomment-291259603","issue_url":"https://api.github.com/repos/python/mypy/issues/474","id":291259603,"node_id":"MDEyOklzc3VlQ29tbWVudDI5MTI1OTYwMw==","user":{"login":"gvanrossum","id":2894642,"node_id":"MDQ6VXNlcjI4OTQ2NDI=","avatar_url":"https://avatars.githubusercontent.com/u/2894642?v=4","gravatar_id":"","url":"https://api.github.com/users/gvanrossum","html_url":"https://github.com/gvanrossum","followers_url":"https://api.github.com/users/gvanrossum/followers","following_url":"https://api.github.com/users/gvanrossum/following{/other_user}","gists_url":"https://api.github.com/users/gvanrossum/gists{/gist_id}","starred_url":"https://api.github.com/users/gvanrossum/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gvanrossum/subscriptions","organizations_url":"https://api.github.com/users/gvanrossum/orgs","repos_url":"https://api.github.com/users/gvanrossum/repos","events_url":"https://api.github.com/users/gvanrossum/events{/privacy}","received_events_url":"https://api.github.com/users/gvanrossum/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-04-03T20:12:13Z","updated_at":"2017-04-03T20:12:13Z","body":"Looking at the original example, I think PEP 484 is not completely clear about the scope in which type comments like `# type: List[B]` are looked up; for type annotations in argument declarations the scope might be different than for variable declarations in the body.\r\n\r\nHowever PEP 526 provides an alternate syntax that requires the type to be evaluatable:\r\n```python\r\nclass A:\r\n    class B:\r\n        pass\r\n\r\n    def f() -> None:\r\n        x: List[B] = []\r\n```\r\nHere B is clearly inaccessible (because of Python's inscrutable scope rules for method bodies, which intentionally skip the containing class's scope) so I think we should use the same rule for type comments.\r\n\r\nClosing; agreed that the discussion about subclasses of A overriding B belongs somewhere else.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/291259603/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"gvanrossum","id":2894642,"node_id":"MDQ6VXNlcjI4OTQ2NDI=","avatar_url":"https://avatars.githubusercontent.com/u/2894642?v=4","gravatar_id":"","url":"https://api.github.com/users/gvanrossum","html_url":"https://github.com/gvanrossum","followers_url":"https://api.github.com/users/gvanrossum/followers","following_url":"https://api.github.com/users/gvanrossum/following{/other_user}","gists_url":"https://api.github.com/users/gvanrossum/gists{/gist_id}","starred_url":"https://api.github.com/users/gvanrossum/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gvanrossum/subscriptions","organizations_url":"https://api.github.com/users/gvanrossum/orgs","repos_url":"https://api.github.com/users/gvanrossum/repos","events_url":"https://api.github.com/users/gvanrossum/events{/privacy}","received_events_url":"https://api.github.com/users/gvanrossum/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1027185028,"node_id":"MDExOkNsb3NlZEV2ZW50MTAyNzE4NTAyOA==","url":"https://api.github.com/repos/python/mypy/issues/events/1027185028","actor":{"login":"gvanrossum","id":2894642,"node_id":"MDQ6VXNlcjI4OTQ2NDI=","avatar_url":"https://avatars.githubusercontent.com/u/2894642?v=4","gravatar_id":"","url":"https://api.github.com/users/gvanrossum","html_url":"https://github.com/gvanrossum","followers_url":"https://api.github.com/users/gvanrossum/followers","following_url":"https://api.github.com/users/gvanrossum/following{/other_user}","gists_url":"https://api.github.com/users/gvanrossum/gists{/gist_id}","starred_url":"https://api.github.com/users/gvanrossum/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gvanrossum/subscriptions","organizations_url":"https://api.github.com/users/gvanrossum/orgs","repos_url":"https://api.github.com/users/gvanrossum/repos","events_url":"https://api.github.com/users/gvanrossum/events{/privacy}","received_events_url":"https://api.github.com/users/gvanrossum/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2017-04-03T20:12:13Z","state_reason":null,"performed_via_github_app":null}]