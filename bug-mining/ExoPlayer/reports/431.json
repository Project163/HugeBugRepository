ub.com/users/erdemguven","html_url":"https://github.com/erdemguven","followers_url":"https://api.github.com/users/erdemguven/followers","following_url":"https://api.github.com/users/erdemguven/following{/other_user}","gists_url":"https://api.github.com/users/erdemguven/gists{/gist_id}","starred_url":"https://api.github.com/users/erdemguven/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/erdemguven/subscriptions","organizations_url":"https://api.github.com/users/erdemguven/orgs","repos_url":"https://api.github.com/users/erdemguven/repos","events_url":"https://api.github.com/users/erdemguven/events{/privacy}","received_events_url":"https://api.github.com/users/erdemguven/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"erdemguven","id":16116340,"node_id":"MDQ6VXNlcjE2MTE2MzQw","avatar_url":"https://avatars.githubusercontent.com/u/16116340?v=4","gravatar_id":"","url":"https://api.github.com/users/erdemguven","html_url":"https://github.com/erdemguven","followers_url":"https://api.github.com/users/erdemguven/followers","following_url":"https://api.github.com/users/erdemguven/following{/other_user}","gists_url":"https://api.github.com/users/erdemguven/gists{/gist_id}","starred_url":"https://api.github.com/users/erdemguven/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/erdemguven/subscriptions","organizations_url":"https://api.github.com/users/erdemguven/orgs","repos_url":"https://api.github.com/users/erdemguven/repos","events_url":"https://api.github.com/users/erdemguven/events{/privacy}","received_events_url":"https://api.github.com/users/erdemguven/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2018-12-05T22:15:45Z","updated_at":"2019-05-16T13:03:33Z","closed_at":"2018-12-14T15:48:06Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"\r\n### Issue description\r\nThe exact same thing as here https://github.com/google/ExoPlayer/issues/2120 happens on another device.\r\n\r\n### Reproduction steps\r\n1. Start MP4 playback with repeating enabled.\r\n2. Turn off repeating.\r\n3. Wait for video to finish.\r\n4. Turn on repeating. \r\n\r\nVideo should start playing automatically from the beginning. Instead the output is stuck on last frame.\r\n\r\n### Link to test content\r\nThe device is this one https://www.framexx.com/framexx-sign/\r\n\r\n### Version of ExoPlayer being used\r\n2.9.2\r\n\r\n### Device(s) and version(s) of Android being used\r\n\"MBX Quad-Core Enjoy TV Box\" running Android 4.4.2\r\n\r\n### A full bug report captured from the device\r\n[stvm8-bugreport.txt](https://github.com/google/ExoPlayer/files/2650804/stvm8-bugreport.txt)\r\n\r\n### The solution\r\n\r\nUpdate `MediaCodecRenderer.codecNeedsEosFlushWorkaround` as so:\r\n\r\n    private static boolean codecNeedsEosFlushWorkaround(String name) {\r\n        return (Util.SDK_INT <= 23 && \"OMX.google.vorbis.decoder\".equals(name))\r\n                || (Util.SDK_INT <= 19\r\n                && (\"hb2000\".equals(Util.DEVICE)\r\n                || \"stvm8\".equals(Util.DEVICE))\r\n                && (\"OMX.amlogic.avc.decoder.awesome\".equals(name)\r\n                || \"OMX.amlogic.avc.decoder.awesome.secure\".equals(name)));\r\n    }\r\n\r\nwhere `\"stvm8\"` is the device in question.\r\n\r\nThis has been tested (with the non-secure variant) and it solved the described issue.","closed_by":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/5203/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/google/ExoPlayer/issues/5203/timeline","performed_via_github_app":null,"state_reason":"completed"}