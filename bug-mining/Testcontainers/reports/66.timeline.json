[{"url":"https://api.github.com/repos/testcontainers/testcontainers-java/issues/comments/1213086494","html_url":"https://github.com/testcontainers/testcontainers-java/issues/4275#issuecomment-1213086494","issue_url":"https://api.github.com/repos/testcontainers/testcontainers-java/issues/4275","id":1213086494,"node_id":"IC_kwDOAgP_mc5ITjse","user":{"login":"jjvrensburg","id":65496381,"node_id":"MDQ6VXNlcjY1NDk2Mzgx","avatar_url":"https://avatars.githubusercontent.com/u/65496381?v=4","gravatar_id":"","url":"https://api.github.com/users/jjvrensburg","html_url":"https://github.com/jjvrensburg","followers_url":"https://api.github.com/users/jjvrensburg/followers","following_url":"https://api.github.com/users/jjvrensburg/following{/other_user}","gists_url":"https://api.github.com/users/jjvrensburg/gists{/gist_id}","starred_url":"https://api.github.com/users/jjvrensburg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jjvrensburg/subscriptions","organizations_url":"https://api.github.com/users/jjvrensburg/orgs","repos_url":"https://api.github.com/users/jjvrensburg/repos","events_url":"https://api.github.com/users/jjvrensburg/events{/privacy}","received_events_url":"https://api.github.com/users/jjvrensburg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-08-12T13:01:04Z","updated_at":"2022-08-12T13:01:04Z","body":"This is still an issue in testcontainers 1.17.3.\r\nI created the following class as a workaround:\r\n```java\r\npublic class CustomAgeBasedPullPolicy extends AbstractImagePullPolicy {\r\n    Duration maxAge;\r\n\r\n    public CustomAgeBasedPullPolicy(Duration maxAge) {\r\n        this.maxAge = maxAge;\r\n    }\r\n\r\n    protected boolean shouldPullCached(DockerImageName imageName, ImageData localImageData) {\r\n        Instant now = Instant.now();\r\n        // Instant from image created time which is actually seconds\r\n        Instant createdAt = Instant.ofEpochSecond(localImageData.getCreatedAt().toEpochMilli());\r\n        Duration imageAge = Duration.between(createdAt, now);\r\n        boolean result = imageAge.compareTo(this.maxAge) > 0;\r\n        return result;\r\n    }\r\n}\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/testcontainers/testcontainers-java/issues/comments/1213086494/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"jjvrensburg","id":65496381,"node_id":"MDQ6VXNlcjY1NDk2Mzgx","avatar_url":"https://avatars.githubusercontent.com/u/65496381?v=4","gravatar_id":"","url":"https://api.github.com/users/jjvrensburg","html_url":"https://github.com/jjvrensburg","followers_url":"https://api.github.com/users/jjvrensburg/followers","following_url":"https://api.github.com/users/jjvrensburg/following{/other_user}","gists_url":"https://api.github.com/users/jjvrensburg/gists{/gist_id}","starred_url":"https://api.github.com/users/jjvrensburg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jjvrensburg/subscriptions","organizations_url":"https://api.github.com/users/jjvrensburg/orgs","repos_url":"https://api.github.com/users/jjvrensburg/repos","events_url":"https://api.github.com/users/jjvrensburg/events{/privacy}","received_events_url":"https://api.github.com/users/jjvrensburg/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/testcontainers/testcontainers-java/issues/comments/1213115119","html_url":"https://github.com/testcontainers/testcontainers-java/issues/4275#issuecomment-1213115119","issue_url":"https://api.github.com/repos/testcontainers/testcontainers-java/issues/4275","id":1213115119,"node_id":"IC_kwDOAgP_mc5ITqrv","user":{"login":"kiview","id":5088104,"node_id":"MDQ6VXNlcjUwODgxMDQ=","avatar_url":"https://avatars.githubusercontent.com/u/5088104?v=4","gravatar_id":"","url":"https://api.github