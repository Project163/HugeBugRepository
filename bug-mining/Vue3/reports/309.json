ly happening?\r\ntext `show-it` sometimes will not shown\r\n\r\n---\r\nhttps://codesandbox.io/s/eager-paper-prv33s\r\nhttps://stackblitz.com/edit/vue3-v-html-render-error\r\n\r\n<!-- generated by vue-issues. DO NOT REMOVE -->","closed_by":{"login":"a272121742","id":1763446,"node_id":"MDQ6VXNlcjE3NjM0NDY=","avatar_url":"https://avatars.githubusercontent.com/u/1763446?v=4","gravatar_id":"","url":"https://api.github.com/users/a272121742","html_url":"https://github.com/a272121742","followers_url":"https://api.github.com/users/a272121742/followers","following_url":"https://api.github.com/users/a272121742/following{/other_user}","gists_url":"https://api.github.com/users/a272121742/gists{/gist_id}","starred_url":"https://api.github.com/users/a272121742/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/a272121742/subscriptions","organizations_url":"https://api.github.com/users/a272121742/orgs","repos_url":"https://api.github.com/users/a272121742/repos","events_url":"https://api.github.com/users/a272121742/events{/privacy}","received_events_url":"https://api.github.com/users/a272121742/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/vuejs/core/issues/5439/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vuejs/core/issues/5439/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}