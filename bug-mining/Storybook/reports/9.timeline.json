.com/storybooks/storybook-addon-knobs/issues/53\r\nbut it looks like the `storybooks/storybook-addon-knobs` repository is now deprecated.\r\n\r\nI saw this related issue on this repository:\r\n\r\n\"Remove UPPERCASE text-transform from labels #793\"\r\nhttps://github.com/storybooks/storybook/issues/793\r\n\r\nwith a comment saying:\r\n\r\n> A PR fixing this was merged couple days ago.\r\n\r\nbut I still see `text-transform: 'uppercase'` on master:\r\nhttps://github.com/storybooks/storybook/blob/master/packages/addon-knobs/src/components/PropField.js#L22\r\n\r\nSorry if this is a duplicate of something else I didn't find.","reactions":{"url":"https://api.github.com/repos/storybookjs/storybook/issues/991/reactions","total_count":4,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/storybookjs/storybook/issues/991/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"actor":{"login":"shilman","id":488689,"node_id":"MDQ6VXNlcjQ4ODY4OQ==","avatar_url":"https://avatars.githubusercontent.com/u/488689?v=4","gravatar_id":"","url":"https://api.github.com/users/shilman","html_url":"https://github.com/shilman","followers_url":"https://api.github.com/users/shilman/followers","following_url":"https://api.github.com/users/shilman/following{/other_user}","gists_url":"https://api.github.com/users/shilman/gists{/gist_id}","starred_url":"https://api.github.com/users/shilman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shilman/subscriptions","organizations_url":"https://api.github.com/users/shilman/orgs","repos_url":"https://api.github.com/users/shilman/repos","events_url":"https://api.github.com/users/shilman/events{/privacy}","received_events_url":"https://api.github.com/users/shilman/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-05-20T08:31:13Z","updated_at":"2017-05-20T08:31:13Z","source":{"ty