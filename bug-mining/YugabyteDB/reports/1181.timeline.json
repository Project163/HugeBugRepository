te/yugabyte-db/contents/{+path}","compare_url":"https://api.github.com/repos/yugabyte/yugabyte-db/compare/{base}...{head}","merges_url":"https://api.github.com/repos/yugabyte/yugabyte-db/merges","archive_url":"https://api.github.com/repos/yugabyte/yugabyte-db/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/yugabyte/yugabyte-db/downloads","issues_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues{/number}","pulls_url":"https://api.github.com/repos/yugabyte/yugabyte-db/pulls{/number}","milestones_url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones{/number}","notifications_url":"https://api.github.com/repos/yugabyte/yugabyte-db/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels{/name}","releases_url":"https://api.github.com/repos/yugabyte/yugabyte-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Jira Link: [DB-1751](https://yugabyte.atlassian.net/browse/DB-1751)\r\nWhile enabling Postgres regression tests for with clause, the following test fails.\r\n\r\nPre-test\r\n```\r\nCREATE TABLE withz AS SELECT i AS k, (i || ' v')::text v FROM generate_series(1, 16, 3) i;\r\nALTER TABLE withz ADD UNIQUE (k);\r\n\r\nWITH t AS (\r\n    INSERT INTO withz SELECT i, 'insert'\r\n    FROM generate_series(0, 16) i\r\n    ON CONFLICT (k) DO UPDATE SET v = withz.v || ', now update'\r\n    RETURNING *\r\n)\r\nSELECT * FROM t;\r\n\r\n-- Test EXCLUDED.* reference within CTE\r\nWITH aa AS (\r\n    INSERT INTO withz VALUES(1, 5) ON CONFLICT (k) DO UPDATE SET v = EXCLUDED.v\r\n    WHERE withz.k != EXCLUDED.k\r\n    RETURNING *\r\n)\r\nSELECT * FROM aa;\r\n```\r\n\r\nFailing test:\r\n```\r\n-- Update a row more than once, in different parts of a wCTE. That is\r\n-- an allowed, presumably very rare, edge case, but since it was\r\n-- broken in the past, having a test seems worthwhile.\r\nWITH simpletup AS (\r\n  SELECT 2 k, 'Green' v),\r\nupsert_cte AS (\r\n  INSERT INTO withz VALUES(2, 'Blue') ON CONFLICT (k) DO\r\n    UPDATE SET (k, v) = (SELECT k, v FROM simpletup WHERE simpletup.k = withz.k)\r\n    RETURNING k, v)\r\nINSERT INTO withz VALUES(2, 'Red') ON CONFLICT (k) DO\r\nUPDATE SET (k, v) = (SELECT k, v FROM upsert_cte WHERE upsert_cte.k = withz.k)\r\nRETURNING k, v;\r\n```\r\n\r\nThe above should return 0 rows, but in YDB cluster, see the following output:\r\n```\r\nWARNING:  TupleDesc reference leak: TupleDesc 0x123ce9eb8 (16541,-1) still referenced\r\n k |   v\r\n---+-------\r\n 2 | Green\r\n(1 row)\r\n```\r\n\r\n","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/6782/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"t