subscriptions","organizations_url":"https://api.github.com/users/LinusBorg/orgs","repos_url":"https://api.github.com/users/LinusBorg/repos","events_url":"https://api.github.com/users/LinusBorg/events{/privacy}","received_events_url":"https://api.github.com/users/LinusBorg/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2023-06-05T08:23:03Z","label":{"name":"feat: reactivity","color":"c9c2fc"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/vuejs/core/issues/comments/1576513623","html_url":"https://github.com/vuejs/core/issues/8501#issuecomment-1576513623","issue_url":"https://api.github.com/repos/vuejs/core/issues/8501","id":1576513623,"node_id":"IC_kwDOCCum185d97BX","user":{"login":"shaileshnighojkar","id":99124848,"node_id":"U_kgDOBeiGcA","avatar_url":"https://avatars.githubusercontent.com/u/99124848?v=4","gravatar_id":"","url":"https://api.github.com/users/shaileshnighojkar","html_url":"https://github.com/shaileshnighojkar","followers_url":"https://api.github.com/users/shaileshnighojkar/followers","following_url":"https://api.github.com/users/shaileshnighojkar/following{/other_user}","gists_url":"https://api.github.com/users/shaileshnighojkar/gists{/gist_id}","starred_url":"https://api.github.com/users/shaileshnighojkar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shaileshnighojkar/subscriptions","organizations_url":"https://api.github.com/users/shaileshnighojkar/orgs","repos_url":"https://api.github.com/users/shaileshnighojkar/repos","events_url":"https://api.github.com/users/shaileshnighojkar/events{/privacy}","received_events_url":"https://api.github.com/users/shaileshnighojkar/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-05T10:11:28Z","updated_at":"2023-06-05T10:11:28Z","body":"@Fuzzyma @LinusBorg \r\n\r\nAs per documentation - https://vuejs.org/api/reactivity-advanced.html#shallowreactive\r\n\r\n<img width=\"744\" alt=\"Screenshot\" src=\"https://github.com/vuejs/core/assets/99124848/abeaca77-1e6f-4e7f-8dd1-8b45e15ea964\">\r\n\r\n\r\n<br /><br />\r\nSince they stored are as-is, I tried to log the Map which is passed to shallowReactive as well. The returned values are same ie, as-is (not unwrapped)\r\n\r\n```js\r\nconst msg = ref('ads')\r\nconst myReactive = reactive({msg})\r\nconst myMap = new Map([['foo1', myReactive]])\r\nconst myReactiveMap = shallowReactive(myMap)\r\nconst log = key => console.log(key, myMap.get(key).msg, myReactiveMap.get(key).msg)\r\n\r\nlog('foo1') // foo1 ads ads\r\n\r\nmyReactiveMap.set('foo2', myReactive)\r\nlog('foo2') // foo2 RefImpl RefImpl\r\n  \r\nmyMap.set('foo3', myReactive)\r\nlog('foo3') // foo3 ads ads\r\n```\r\n\r\nLink: https://play.vuejs.org/#\r\n\r\nIt looks like shallowReactive is working as per the documentation.\r\n\r\nAlso, when I change shallowReactive to reactive, I am getting consistent 'ads' console log for `myReactiveMap.get(key).msg`.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/vuejs/core/issues/comments/1576513623/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"shaileshnighojkar","id":99124848,"node_id":"U_kgDOBeiGcA","avatar_url":"https://avatars.githubusercontent.com/u/99124848?v=4","gravatar_id":"","url":"https://api.github.com/users/shaileshnighojkar","html_url":"https://github.com/shaileshnighojkar","followers_url":"https://api.github.com/users/shaileshnighojkar/followers","following_url":"https://api.github.com/users/shaileshnighojkar/following{/other_user}","gists_url":"https://api.github.com/users/shaileshnighojkar/gists{/gist_id}","starred_url":"https://api.github.com/users/shaileshnighojkar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shaileshnighojkar/subscripti