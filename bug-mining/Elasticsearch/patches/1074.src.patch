+    public String getPath() {
+        return path;
+    }
+
+    public ObjectMapper getNestedObjectMapper() {
+        return nestedObjectMapper;
+    }
+
+    public boolean queryFound() {
+        return queryFound;
+    }
+
+    public boolean filterFound() {
+        return filterFound;
+    }
