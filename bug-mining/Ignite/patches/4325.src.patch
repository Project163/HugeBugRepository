+
+    /** {@inheritDoc} */
+    @Override public long next() {
+        SB sb = new SB();
+
+        sb.a("[op=next" +
+            ", grpId=" + grp.groupId() +
+            ", partId=" + partId +
+            ", before=" + toString());
