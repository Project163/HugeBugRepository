pi.github.com/users/citizen428/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2022-02-07T07:11:27Z","label":{"name":"bug","color":"E99695"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/forem/forem/issues/comments/1031876484","html_url":"https://github.com/forem/forem/issues/16418#issuecomment-1031876484","issue_url":"https://api.github.com/repos/forem/forem/issues/16418","id":1031876484,"node_id":"IC_kwDOBGPKJs49gS-E","user":{"login":"rpalo","id":14909201,"node_id":"MDQ6VXNlcjE0OTA5MjAx","avatar_url":"https://avatars.githubusercontent.com/u/14909201?v=4","gravatar_id":"","url":"https://api.github.com/users/rpalo","html_url":"https://github.com/rpalo","followers_url":"https://api.github.com/users/rpalo/followers","following_url":"https://api.github.com/users/rpalo/following{/other_user}","gists_url":"https://api.github.com/users/rpalo/gists{/gist_id}","starred_url":"https://api.github.com/users/rpalo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rpalo/subscriptions","organizations_url":"https://api.github.com/users/rpalo/orgs","repos_url":"https://api.github.com/users/rpalo/repos","events_url":"https://api.github.com/users/rpalo/events{/privacy}","received_events_url":"https://api.github.com/users/rpalo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-02-07T20:13:15Z","updated_at":"2022-02-07T20:13:15Z","body":"I'd like to suggest some fixes to address the errors the feed validator raised.  I checked an author feed, but I could go through all the feed types just to make sure I don't miss anything.  For example here are the issues raised by the author feed:\r\n\r\n1. `<channel>` tag doesn't have an `<author>` child in the spec.\r\n2. `<author>` tags should be an email address and name combo in an [approved format](https://validator.w3.org/feed/docs/error/InvalidContact.html)\r\n3. The feed `<image>` subitem `<title>` is recommended to have the same text as the channel's `<title>` element\r\n4. Article descriptions shouldn't contain relative links, and the headers usually have relative anchor links attached to them.\r\n5. The feed needs an `<atom:link rel=\"self\">` tag ([more info](https://validator.w3.org/feed/docs/warning/MissingAtomSelfLink.html)\r\n\r\nAdditionally, looks like there are a few other schema links, etc. that would make it perform a little bit better in the browser and in readers ([RSS Best Practice Recommendations](https://www.rssboard.org/rss-profile#recommendations)).\r\n\r\nLet me know if this seems like an OK pull request to open!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/forem/forem/issues/comments/1031876484/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"rpalo","id":14909201,"node_id":"MDQ6VXNlcjE0OTA5MjAx","avatar_url":"https://avatars.githubusercontent.com/u/14909201?v=4","gravatar_id":"","url":"https://api.github.com/users/rpalo","html_url":"https://github.com/rpalo","followers_url":"https://api.github.com/users/rpalo/followers","following_url":"https://api.github.com/users/rpalo/following{/other_user}","gists_url":"https://api.github.com/users/rpalo/gists{/gist_id}","starred_url":"https://api.github.com/users/rpalo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rpalo/subscriptions","organizations_url":"https://api.github.com/users/rpalo/orgs","repos_url":"https://api.github.com/users/rpalo/repos","events_url":"https://api.github.com/users/rpalo/events{/privacy}","received_events_url":"https://api.github.com/users/rpalo/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/forem/forem/issues/comments/1032270763","html_url":"https://github.com/forem/forem