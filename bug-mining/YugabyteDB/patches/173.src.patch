+    width: 140px;
+    padding: 5px 10px;
+    color: white;
+    border-radius: 4px 4px 0 0;
+    font-size: 11px;
+    background-color: #f75821;
+    cursor: pointer;
+    z-index: 9999;
+
+    -moz-transition: bottom 300ms ease;
