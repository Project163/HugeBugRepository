-        System.out.println("Finished unacked pubs: tput = " + BenchmarkUtils.calcTp(myPublishLimit, startTime)
-                           + " ops/s");
-        // Wait till the benchmark test has completed
-        agg.tpAgg.queue.take();
-        System.out.println(agg.summarize(startTime));
-        return null;
-    }
-
-}
