rl":"https://api.github.com/repos/eslint/eslint/releases{/id}","deployments_url":"https://api.github.com/repos/eslint/eslint/deployments","created_at":"2013-06-29T23:59:48Z","updated_at":"2025-12-12T07:58:06Z","pushed_at":"2025-12-11T20:07:33Z","git_url":"git://github.com/eslint/eslint.git","ssh_url":"git@github.com:eslint/eslint.git","clone_url":"https://github.com/eslint/eslint.git","svn_url":"https://github.com/eslint/eslint","homepage":"https://eslint.org","size":51012,"stargazers_count":26698,"watchers_count":26698,"language":"JavaScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":4866,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":103,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["ecmascript","eslint","javascript","linter","static-code-analysis"],"visibility":"public","forks":4866,"open_issues":103,"watchers":26698,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"After many requests and some soul-searching, I've come around to believing that ESLint should optionally support JSX. My rationale is based on:\n1. The growing popularity of React/JSX\n2. The existence of Esprima-FB and estraverse-FB\n\nThere is still the issue of escope not supporting es6 scoping rules and relying on estraverse directly, but that may be solvable. \n\nThe way I'm envisioning this working is by allowing you to specify one of four JavaScript modes:\n1. ECMAScript 3\n2. ECMAScript 5\n3. ECMAScript 6\n4. JSX\n\nThat means ECMAScript 6 support is separate from JSX support. You opt-in to JSX, you get whatever is in Esprima-FB vs. opting in to ES6, which should not support JSX syntax. \n\nThis issue is to gather investigation data to determine how this can be achieved and what blockers might exist. \n","reactions":{"url":"https://api.github.com/repos/eslint/eslint/issues/1291/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/eslint/eslint/issues/1291/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":198183092,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDE5ODE4MzA5Mg==","url":"https://api.github.com/repos/eslint/eslint/issues/events/198183092","actor":{"login":"lo1tuma","id":169170,"node_id":"MDQ6VXNlcjE2OTE3MA==","avatar_url":"https://avatars.githubusercontent.com/u/169170?v=4","gravatar_id":"","url":"https://api.github.com/users/lo1tuma","html_url":"https://github.com/lo1tuma","followers_url":"https://api.github.com/users/lo1tuma/followers","following_url":"https://api.github.com/users/lo1tuma/following{/other_user}","gists_url":"https://api.github.com/users/lo1tuma/gists{/gist_id}","starred_url":"https://api.github.com/users/lo1tuma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lo1tuma/subscriptions","organizations_url":"https://api.github.com/users/lo1tuma/orgs","repos_url":"https://api.github.com/users/lo1tuma/repos","events_url":"https://api.github.com/users/lo1tuma/events{/privacy}","received_events_url":"https://api.github.com/users/lo1tuma/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"28c3fde5119d4c8d91f33b87db8e672445af90fc","commit_url":"https://api.github.com/repos/eslint/eslint/commits/28c3fde5119d4c8d91f33b87db8e672445af90fc","created_at":"2014-11-25T10:25:40Z","performed_via_github_app":null},{"id":198183890,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDE5ODE4Mzg5MA==","url":"https://api.github.com/repos/eslint/eslint/issues/events/198183890","actor":{"login":"lo1tuma","id":169170,"node_id":"MDQ6VXNlcjE2OTE3MA==","avatar_url":"https://avatars.githubuserconten