t/streamlit/downloads","issues_url":"https://api.github.com/repos/streamlit/streamlit/issues{/number}","pulls_url":"https://api.github.com/repos/streamlit/streamlit/pulls{/number}","milestones_url":"https://api.github.com/repos/streamlit/streamlit/milestones{/number}","notifications_url":"https://api.github.com/repos/streamlit/streamlit/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/streamlit/streamlit/labels{/name}","releases_url":"https://api.github.com/repos/streamlit/streamlit/releases{/id}","deployments_url":"https://api.github.com/repos/streamlit/streamlit/deployments","created_at":"2019-08-24T00:14:52Z","updated_at":"2025-12-13T03:51:18Z","pushed_at":"2025-12-13T01:35:43Z","git_url":"git://github.com/streamlit/streamlit.git","ssh_url":"git@github.com:streamlit/streamlit.git","clone_url":"https://github.com/streamlit/streamlit.git","svn_url":"https://github.com/streamlit/streamlit","homepage":"https://streamlit.io","size":797696,"stargazers_count":42660,"watchers_count":42660,"language":"Python","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":3962,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1304,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["data-analysis","data-science","data-visualization","deep-learning","developer-tools","machine-learning","python","streamlit"],"visibility":"public","forks":3962,"open_issues":1304,"watchers":42660,"default_branch":"develop","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/streamlit/streamlit/pulls/2658","html_url":"https://github.com/streamlit/streamlit/pull/2658","diff_url":"https://github.com/streamlit/streamlit/pull/2658.diff","patch_url":"https://github.com/streamlit/streamlit/pull/2658.patch","merged_at":"2021-01-27T19:33:52Z"},"body":"Tests for the \"C\" and \"R\" App hotkeys. These tests use Cypress because I just could not get an Enzyme test to work.\r\n\r\nThere are 5 tests:\r\n1. When you press 'c', the Clear Cache dialog should appear\r\n2. Unless you have focused text-input, in which case the 'c' should be typed into the input\r\n3. Ctrl-C/Cmd-C should not invoke Clear Cache\r\n4. When you press 'r', the app should rerun\r\n5. Unless you have a focused text-input\r\n\r\nI added `data-testid` attributes to a couple components so that Cypress can fish them out of the DOM more easily.\r\n\r\nFixes #2566\r\n\r\nFor memorialization purposes, here's a failed attempt at getting a \"C\" hotkey test to work with Enzyme in various ways:\r\n\r\n```typescript\r\n  it(\"shows ClearCache dialog when 'C' is pressed\", () => {\r\n    const props = getProps()\r\n    const wrapper = mount(<App {...props} />)\r\n\r\n    // Spy on `App.openClearCacheDialog`. We want to make sure it gets called.\r\n    // @ts-ignore\r\n    const spy = jest.spyOn(wrapper.instance(), \"openClearCacheDialog\")\r\n\r\n    // @ts-ignore\r\n    const keydown = new KeyboardEvent(\"keydown\", { key: \"c\", code: \"KeyC\" })\r\n\r\n    // Dispatch an event on HotKeys' DOM element:\r\n    // @ts-ignore\r\n    wrapper\r\n      .find(HotKeys)\r\n      .getDOMNode()\r\n      .dispatchEvent(keydown)\r\n\r\n    wrapper\r\n      .find(ReportView)\r\n      .getDOMNode()\r\n      .dispatchEvent(keydown)\r\n\r\n    // Dispatch an event on <App>'s DOM element:\r\n    wrapper.getDOMNode().dispatchEvent(keydown)\r\n\r\n    // Dispatch an event globally in two different ways:\r\n    global.document.dispatchEvent(keydown)\r\n    global.window.dispatchEvent(keydown)\r\n\r\n    // Use Jest.simulate to simulate a keydown on App:\r\n    wrapper.simulate(\"keydown\", { key: \"c\" })\r\n\r\n    // Simulate a keydown on HotKeys:\r\n    wrapper.find(HotKeys).simulate(\"keydown\", { key: \"c\" })\r\n\r\n    expect(spy).toHaveBeenCalled()\r\n  })\r\n```","reactions":{"url":"https://api.github.com/repos/streamlit/streamlit/issues/2658/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/streamlit/streamlit/issues/2658/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":4257609701,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDQyNTc2MDk3MDE=","url":"https://api.github.com/repos/streamlit/streamlit/issues/events/4257609701","actor":{"login":"tconkling","id":709022,"node_id":"MDQ6VXNlcjcwOTAyMg==","avatar_url":"https://avatars.githubusercontent.com/u/709022?v=4","gravatar_id":"","url":"https://api.github.com/users/tconkling","html_url":"https://github.com/tconkling","followers_url":"https://api.github.com/users/tconkling/followers","following_url":"https://api.github.com/users/tconkling/following{/other_user}","gists_url":"https://api.github.com/users/tconkling/gists{/gist_id}","starred_url":"https://api.github.com/users/tconkling/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tconkling/subscriptions","organizations_url":"https://api.github.com/users/tconkling/orgs","repos_url":"https://api.github.com/users/tconkling/repos","events_url":"https://api.github.com/users/tconkling/events{/privacy}","received_events_url":"https://api.github.com/users/tconkling/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"968e7f5f720080c22e76912aff0861cf917bfeb4","commit_url":"https://api.github.com/repos/streamlit/streamlit/commits/968e7f5f720080c22e76912aff0861cf917bfeb4","created_at":"2021-01-27T19:33:54Z","performed_via_github_app":null},{"id":4783691217,"node_id":"MDE0OlVubGFiZWxlZEV2ZW50NDc4MzY5MTIxNw==","url":"https://api.github.com/repos/streamlit/streamlit/issues/e