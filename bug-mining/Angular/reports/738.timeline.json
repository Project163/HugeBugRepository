e has less code impact and better tree-shakability. Of course we can iterate on the proposal.\r\n\r\nThis PR changes runtime only. compiler change will follow as soon as runtime is sorted out.","reactions":{"url":"https://api.github.com/repos/angular/angular/issues/25482/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/angular/angular/issues/25482/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":1797521968,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDE3OTc1MjE5Njg=","url":"https://api.github.com/repos/angular/angular/issues/events/1797521968","actor":{"login":"pkozlowski-opensource","id":973550,"node_id":"MDQ6VXNlcjk3MzU1MA==","avatar_url":"https://avatars.githubusercontent.com/u/973550?v=4","gravatar_id":"","url":"https://api.github.com/users/pkozlowski-opensource","html_url":"https://github.com/pkozlowski-opensource","followers_url":"https://api.github.com/users/pkozlowski-opensource/followers","following_url":"https://api.github.com/users/pkozlowski-opensource/following{/other_user}","gists_url":"https://api.github.com/users/pkozlowski-opensource/gists{/gist_id}","starred_url":"https://api.github.com/users/pkozlowski-opensource/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pkozlowski-opensource/subscriptions","organizations_url":"https://api.github.com/users/pkozlowski-opensource/orgs","repos_url":"https://api.github.com/users/pkozlowski-opensource/repos","events_url":"https://api.github.com/users/pkozlowski-opensource/events{/privacy}","received_events_url":"https://api.github.com/users/pkozlowski-opensource/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"24b5142e3b136097d94a7b4a73a541b02bca9733","commit_url":"https://api.github.com/repos/pkozlowski-opensource/angular/commits/24b5142e3b136097d94a7b4a73a541b02bca9733","created_at":"2