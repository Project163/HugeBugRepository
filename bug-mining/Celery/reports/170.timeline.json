elery/git/commits{/sha}","comments_url":"https://api.github.com/repos/celery/celery/comments{/number}","issue_comment_url":"https://api.github.com/repos/celery/celery/issues/comments{/number}","contents_url":"https://api.github.com/repos/celery/celery/contents/{+path}","compare_url":"https://api.github.com/repos/celery/celery/compare/{base}...{head}","merges_url":"https://api.github.com/repos/celery/celery/merges","archive_url":"https://api.github.com/repos/celery/celery/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/celery/celery/downloads","issues_url":"https://api.github.com/repos/celery/celery/issues{/number}","pulls_url":"https://api.github.com/repos/celery/celery/pulls{/number}","milestones_url":"https://api.github.com/repos/celery/celery/milestones{/number}","notifications_url":"https://api.github.com/repos/celery/celery/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/celery/celery/labels{/name}","releases_url":"https://api.github.com/repos/celery/celery/releases{/id}","deployments_url":"https://api.github.com/repos/celery/celery/deployments","created_at":"2009-04-24T11:31:24Z","updated_at":"2026-03-11T11:08:53Z","pushed_at":"2026-03-10T15:04:28Z","git_url":"git://github.com/celery/celery.git","ssh_url":"git@github.com:celery/celery.git","clone_url":"https://github.com/celery/celery.git","svn_url":"https://github.com/celery/celery","homepage":"https://docs.celeryq.dev","size":36397,"stargazers_count":28268,"watchers_count":28268,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":4989,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":773,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["amqp","python","python-library","python3","queue-tasks","queue-workers","queued-jobs","redis","redis-queue","sqs","sqs-queue","task-manager","task-runner","task-scheduler"],"visibility":"public","forks":4989,"open_issues":773,"watchers":28268,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/celery/celery/pulls/10134","html_url":"https://github.com/celery/celery/pull/10134","diff_url":"https://github.com/celery/celery/pull/10134.diff","patch_url":"https://github.com/celery/celery/pull/10134.patch","merged_at":"2026-02-21T09:01:43Z"},"body":"## Description\r\nFixes #7355\r\n\r\n### Background\r\nWhen a Celery worker uses a database result backend and processes a task that doesn't require a new subprocess fork (e.g., discarding an expired task inline), it avoids creating a full connection pool by falling back to SQLAlchemy's `NullPool`. \r\n\r\nPreviously, `get_engine` attempted to strip out `QueuePool`-specific arguments from `database_engine_options` by only filtering keys that started with `\"pool\"`. However, arguments like `max_overflow` (and `echo_pool`) bypass this filter. Passing these arguments to `NullPool` causes `create_engine` to raise a `TypeError`, leading to a worker crash mid-execution.\r\n\r\n### Changes Made\r\n* Updated the fallback logic in `celery.backends.database.session.SessionManager.get_engine`.\r\n* Introduced an explicit exclusion set (`unsupported_nullpool_kwargs`) containing `'max_overflow'` and `'echo_pool'`.\r\n* The dictionary comprehension now safely filters out both `pool*` prefixed arguments and the explicitly defined unsupported kwargs before initializing `NullPool`.\r\n","reactions":{"url":"https://api.github.com/repos/celery/celery/issues/10134/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/celery/celery/issues/10134/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/celery/celery/issues/comments/3924572050","html_url":"https://github.com/celery/celery/issues/7355#issuecomment-3924572050","issue_url":"https://api.github.com/repos/celery/celery/issues/7355","id":3924572050,"node_id":"IC_kwDOAALQjM7p7DeS","user":{"login":"ChickenBenny","id":96862600,"node_id":"U_kgDOBcYBiA","avatar_url":"https://avatars.githubusercontent.com/u/96862600?v=4","gravatar_id":"","url":"https://api.github.com/users/ChickenBenny","html_url":"https://github.com/ChickenBenny","followers_url":"https://api.github.com/users/ChickenBenny/followers","following_url":"https://api.github.com/users/ChickenBenny/following{/other_user}","gists_url":"https://api.github.com/users/ChickenBenny/gists{/gist_id}","starred_url":"https://api.github.com/users/ChickenBenny/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ChickenBenny/subscriptions","organizations_url":"https://api.github.com/users/ChickenBenny/orgs","repos_url":"https://api.github.com/users/ChickenBenny/repos","events_url":"https://api.github.com/users/ChickenBenny/events{/privacy}","received_events_url":"https://api.github.com/users/ChickenBenny/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-19T04:05:13Z","updated_at":"2026-02-19T04:05:13Z","body":"Hey @auvipy @danihodovic, I've put together a PR #10130 to fix this issue.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/celery/celery/issues/comments/3924572050/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ChickenBenny","id":96862600,"node_id":"U_kgDOBcYBiA","avatar_url":"https://avatars.githubusercontent.com/u/96862600?v=4","gravatar_id":"","url":"https://api.github.com/users