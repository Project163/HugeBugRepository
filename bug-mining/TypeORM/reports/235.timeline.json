b/506133e2179529bf3add2b0b982613835d321af6/src/find-options/FindOptionsWhere.ts#L14\r\n\r\nOf course that's just a partial solution, merely a hint in the right direction. Because with the evaluation missing one could pass in methods as keys for the `findBy` methods. ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/typeorm/typeorm/issues/comments/1152380054/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Agreon","id":4455258,"node_id":"MDQ6VXNlcjQ0NTUyNTg=","avatar_url":"https://avatars.githubusercontent.com/u/4455258?v=4","gravatar_id":"","url":"https://api.github.com/users/Agreon","html_url":"https://github.com/Agreon","followers_url":"https://api.github.com/users/Agreon/followers","following_url":"https://api.github.com/users/Agreon/following{/other_user}","gists_url":"https://api.github.com/users/Agreon/gists{/gist_id}","starred_url":"https://api.github.com/users/Agreon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Agreon/subscriptions","organizations_url":"https://api.github.com/users/Agreon/orgs","repos_url":"https://api.github.com/users/Agreon/repos","events_url":"https://api.github.com/users/Agreon/events{/privacy}","received_events_url":"https://api.github.com/users/Agreon/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/typeorm/typeorm/issues/comments/1161501180","html_url":"https://github.com/typeorm/typeorm/issues/9061#issuecomment-1161501180","issue_url":"https://api.github.com/repos/typeorm/typeorm/issues/9061","id":1161501180,"node_id":"IC_kwDOAyVBJc5FOxn8","user":{"login":"sdlyy","id":67391475,"node_id":"MDQ6VXNlcjY3MzkxNDc1","avatar_url":"https://avatars.githubusercontent.com/u/67391475?v=4","gravatar_id":"","url":"https://api.github.com/users/sdlyy","html_url":"https://github.com/sdlyy","followe