octrine/dbal/issues/6189/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/doctrine/dbal/issues/comments/1762201437","html_url":"https://github.com/doctrine/dbal/issues/6185#issuecomment-1762201437","issue_url":"https://api.github.com/repos/doctrine/dbal/issues/6185","id":1762201437,"node_id":"IC_kwDOAApWWM5pCQ9d","user":{"login":"cgknx","id":124388865,"node_id":"U_kgDOB2oGAQ","avatar_url":"https://avatars.githubusercontent.com/u/124388865?v=4","gravatar_id":"","url":"https://api.github.com/users/cgknx","html_url":"https://github.com/cgknx","followers_url":"https://api.github.com/users/cgknx/followers","following_url":"https://api.github.com/users/cgknx/following{/other_user}","gists_url":"https://api.github.com/users/cgknx/gists{/gist_id}","starred_url":"https://api.github.com/users/cgknx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cgknx/subscriptions","organizations_url":"https://api.github.com/users/cgknx/orgs","repos_url":"https://api.github.com/users/cgknx/repos","events_url":"https://api.github.com/users/cgknx/events{/privacy}","received_events_url":"https://api.github.com/users/cgknx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-10-13T20:48:34Z","updated_at":"2023-10-13T20:48:34Z","body":"The issue is caused when checking commented column types where the column declaration used is a synonym of the MySQL/MariaDb internal column type names. The simplest approach to fixing this is to restrict the type checking of commented columns to json only which is the only case this test should be necessary.\r\n\r\nChanging the column declaration to the internal type as per your patch also works but there is nothing to stop a custom type hard wiring NUMERIC into the type declaration and triggering the issue. \r\n\r\nsee PR #6189 ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/doctrine/dbal/issues/comments/1762201437/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"cgknx","id":124388865,"node_id":"U_kgDOB2oGAQ","avatar_url":"https://avatars.githubusercontent.com/u/124388865?v=4","gravatar_id":"","url":"https://api.github.com/users/cgknx","html_url":"https://github.com/cgknx","followers_url":"https://api.github.com/users/cgknx/followers","following_url":"https://api.github.com/users/cgknx/following{/other_user}","gists_url":"https://api.github.com/users/cgknx/gists{/gist_id}","starred_url":"https://api.github.com/users/cgknx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cgknx/subscriptions","organizations_url":"https://api.github.com/users/cgknx/orgs","repos_url":"https://api.github.com/users/cgknx/repos","events_url":"https://api.github.com/users/cgknx/events{/privacy}","received_events_url":"https://api.github.com/users/cgknx/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":10848639883,"node_id":"REFE_lADOAApWWM5zp7kVzwAAAAKGoRuL","url":"https://api.github.com/repos/doctrine/dbal/issues/events/10848639883","actor":{"login":"derrabus","id":1506493,"node_id":"MDQ6VXNlcjE1MDY0OTM=","avatar_url":"https://avatars.githubusercontent.com/u/1506493?v=4","gravatar_id":"","url":"https://api.github.com/users/derrabus","html_url":"https://github.com/derrabus","followers_url":"https://api.github.com/users/derrabus/followers","following_url":"https://api.github.com/users/derrabus/following{/other_user}","gists_url":"https://api.github.com/users/derrabus/gists{/gist_id}","starred_url":"https://api.github.com/users/derrabus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/derrabus/subscriptions","organizations_url":"https://api.github.com/users/derrabus/orgs","repos_url":"https://api.github.com/users/derrabus/repos","events_url":"https://api.githu