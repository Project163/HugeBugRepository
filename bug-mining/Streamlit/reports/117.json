01Z","closed_at":"2020-08-27T22:39:01Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"# Summary\r\nOn update refresh of a st.plotly_chart, the legend title is not refreshed and keeps the existing value.\r\n\r\n# Steps to reproduce\r\n\r\nHere is an example of how to reproduce the bug\r\n\r\n```python\r\nimport streamlit as st\r\nimport plotly.graph_objects as go\r\n\r\ndef title():\r\n    fig = go.Figure()\r\n    fig.add_trace(go.Bar(y=[10,10,10], x=[\"a\",\"b\",\"c\"], name=\"a\"))\r\n    fig.add_trace(go.Bar(y=[100,100,100], x=[\"a\",\"b\",\"c\"], name=\"b\"))\r\n    fig.update_layout(legend_title_text='I have a title')\r\n\r\n    st.plotly_chart(fig, key=\"graph2\")\r\n\t    \r\ndef noTitle():\r\n    fig = go.Figure()\r\n    fig.add_trace(go.Bar(y=[10,10,10],x=[\"1\",\"2\",\"3\"],name=\"rolfla\"))\r\n    fig.add_trace(go.Bar(y=[100,100,100], x=[\"a\",\"b\",\"c\"], name=\"coulos\"))\r\n    ## fig.update_layout(legend_title_text='I have a title')  # Removing the title\r\n\r\n    st.plotly_chart(fig)\r\n\t    \r\nplot = st.sidebar.radio(\"plots\",('title', 'noTitle'))\r\nfuncts = {'title':title,'noTitle':noTitle}\r\nfuncts[plot]()\r\n```\r\n\r\n## Expected behavior:\r\nOne graph (`title()`) should have a legend title, the other one should not have a legend title (`noTitle()`)\r\n\r\n## Actual behavior:\r\nWhen switching between `title()` and `noTitle()`, the legend title is not refreshed.\r\n\r\n## Is this a regression?\r\n\r\n No\r\n\r\n# Debug info\r\n\r\n- Streamlit version: 0.61.0\r\n- Python version: 3.7.4\r\n\r\n","closed_by":{"login":"kantuni","id":6151409,"node_id":"MDQ6VXNlcjYxNTE0MDk=","avatar_url":"https://avatars.githubusercontent.com/u/6151409?v=4","gravatar_id":"","url":"https://api.github.com/users/kantuni","html_url":"https://github.com/kantuni","followers_u