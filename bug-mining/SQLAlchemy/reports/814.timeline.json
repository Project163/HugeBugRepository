29:50Z","milestone":{"title":"1.2.x"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/442332353","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/4377#issuecomment-442332353","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/4377","id":442332353,"node_id":"MDEyOklzc3VlQ29tbWVudDQ0MjMzMjM1Mw==","user":{"login":"jsynowiec","id":1029142,"node_id":"MDQ6VXNlcjEwMjkxNDI=","avatar_url":"https://avatars.githubusercontent.com/u/1029142?v=4","gravatar_id":"","url":"https://api.github.com/users/jsynowiec","html_url":"https://github.com/jsynowiec","followers_url":"https://api.github.com/users/jsynowiec/followers","following_url":"https://api.github.com/users/jsynowiec/following{/other_user}","gists_url":"https://api.github.com/users/jsynowiec/gists{/gist_id}","starred_url":"https://api.github.com/users/jsynowiec/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jsynowiec/subscriptions","organizations_url":"https://api.github.com/users/jsynowiec/orgs","repos_url":"https://api.github.com/users/jsynowiec/repos","events_url":"https://api.github.com/users/jsynowiec/events{/privacy}","received_events_url":"https://api.github.com/users/jsynowiec/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-11-28T06:13:44Z","updated_at":"2018-11-28T16:32:19Z","body":"Thanks! I was already exploring this yesterday. As I've mentioned in the https://github.com/sqlalchemy/sqlalchemy/pull/4380#issuecomment-442331469, after adding my types to the `ischema_names` it now seems to work. At least there are no warnings and Alembic is not generating wrong migrations.\r\n\r\nSo the solution is to _register_ custom user defined types with the [`ischema_names`](https://github.com/sqlalchemy/sqlalchemy/blob/master/lib/sqlalchemy/dialects/postgresql/base.py#L1379) dict exported by base module of PostgreSQL dialect. This seems to be only available for PostgreSQL and is undocumented API.\r\n\r\nManaging domains is another topic. One have to write the SQL manually and execute it against the database. I've started experimenting with `_CreateDropBase`, `compiles` decorator and visitors but I'm just exploring some ideas. @zzzeek can you give me some pointers where to look? I would eventually like to have Alembic generating migrations for PSQL domains.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/442332353/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"jsynowiec","id":1029142,"node_id":"MDQ6VXNlcjEwMjkxNDI=","avatar_url":"https://avatars.githubusercontent.com/u/1029142?v=4","gravatar_id":"","url":"https://api.github.com/users/jsynowiec","html_url":"https://github.com/jsynowiec","followers_url":"https://api.github.com/users/jsynowiec/followers","following_url":"https://api.github.com/users/jsynowiec/following{/other_user}","gists_url":"https://api.github.com/users/jsynowiec/gists{/gist_id}","starred_url":"https://api.github.com/users/jsynowiec/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jsynowiec/subscriptions","organizations_url":"https://api.github.com/users/jsynowiec/orgs","repos_url":"https://api.github.com/users/jsynowiec/repos","events_url":"https://api.github.com/users/jsynowiec/events{/privacy}","received_events_url":"https://api.github.com/users/jsynowiec/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1992945966,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50MTk5Mjk0NTk2Ng==","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/1992945966","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"