 isinstance logic makes mypy skip\ntypechecking of dead code.  This change makes this more consistent,\ncausing the following to not be an error:\n\ndef foo() -> int:\n    return foo()\n    return 'a'\n\nI changed the test to avoid this case.  We should probably decide what\nwe actually want to do about dead code and make appropriate tests.\n","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/957/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/mypy/issues/957/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":441121847,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDQ0MTEyMTg0Nw==","url":"https://api.github.com/repos/python/mypy/issues/events/441121847","actor":{"login":"ecprice","id":140334,"node_id":"MDQ6VXNlcjE0MDMzNA==","avatar_url":"https://avatars.githubusercontent.com/u/140334?v=4","gravatar_id":"","url":"https://api.github.com/users/ecprice","html_url":"https://github.com/ecprice","followers_url":"https://api.github.com/users/ecprice/followers","following_url":"https://api.github.com/users/ecprice/following{/other_user}","gists_url":"https://api.github.com/users/ecprice/gists{/gist_id}","starred_url":"https://api.github.com/users/ecprice/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ecprice/subscriptions","organizations_url":"https://api.github.com/users/ecprice/orgs","repos_url":"https://api.github.com/users/ecprice/repos","events_url":"https://api.github.com/users/ecprice/events{/privacy}","received_events_url":"https://api.github.com/users/ecprice/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"c489c4d2dd7b54c2e1a094b53b5096bf336320c8","commit_url":"https://api.github.com/repos/python/mypy/commits/c489c4d2dd7b54c2e1a094b53b5096bf336320c8","created_at":"2015-10-21T05:26:56Z","performed_via_github_app":null