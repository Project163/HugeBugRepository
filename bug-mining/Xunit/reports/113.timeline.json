An item with the same key has already been added. Key: ID\n\nThis appears to go wrong in AssertHelper.cs here:\n\n![Image](https://github.com/user-attachments/assets/5da3c998-fb8c-4592-a8ad-4e070855088b)\n\nThe following example shows the issue:\n\n```C#\n[Fact]\npublic void TestMyClass()\n{\n    MyClass c1 = new MyClass(\"123\");\n    MyClass c2 = new MyClass(\"123\");\n\n    Assert.Equivalent(c1, c2);\n}\n\npublic abstract class MyDomainBase<T>\n    where T : MyDomainBase<T>\n{\n    protected MyDomainBase(object id)\n    {\n        ID = id;\n    }\n\n    public object ID { get; }\n}\n\npublic abstract class MyDomainBase<T, TIdentifier> : MyDomainBase<T>\n    where T : MyDomainBase<T, TIdentifier>\n{\n    protected MyDomainBase(TIdentifier id) : base(id)\n    {\n        ID = id;\n    }\n\n    public new TIdentifier ID { get; }\n}\n\npublic class MyClass : MyDomainBase<MyClass, string>\n{\n    public MyClass(string id) : base(id)\n    {\n    }\n}\n```\n\nEdit; styling and formatting.","reactions":{"url":"https://api.github.com/repos/xunit/visualstudio.xunit/issues/441/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/xunit/visualstudio.xunit/issues/441/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"actor":{"login":"Joost-Jens-Luminis","id":116875956,"node_id":"U_kgDOBvditA","avatar_url":"https://avatars.githubusercontent.com/u/116875956?v=4","gravatar_id":"","url":"https://api.github.com/users/Joost-Jens-Luminis","html_url":"https://github.com/Joost-Jens-Luminis","followers_url":"https://api.github.com/users/Joost-Jens-Luminis/followers","following_url":"https://api.github.com/users/Joost-Jens-Luminis/following{/other_user}","gists_url":"https://api.github.com/users/Joost-Jens-Luminis/gists{/gist_id}","starred_url":"https://api.github.com/users/Joost-Jens-Luminis/starred{/owner}{/repo}","subscriptions_url":"https: