el/framework/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/laravel/framework/downloads","issues_url":"https://api.github.com/repos/laravel/framework/issues{/number}","pulls_url":"https://api.github.com/repos/laravel/framework/pulls{/number}","milestones_url":"https://api.github.com/repos/laravel/framework/milestones{/number}","notifications_url":"https://api.github.com/repos/laravel/framework/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/laravel/framework/labels{/name}","releases_url":"https://api.github.com/repos/laravel/framework/releases{/id}","deployments_url":"https://api.github.com/repos/laravel/framework/deployments","created_at":"2013-01-10T21:27:28Z","updated_at":"2025-12-12T11:43:01Z","pushed_at":"2025-12-12T03:08:29Z","git_url":"git://github.com/laravel/framework.git","ssh_url":"git@github.com:laravel/framework.git","clone_url":"https://github.com/laravel/framework.git","svn_url":"https://github.com/laravel/framework","homepage":"https://laravel.com","size":94640,"stargazers_count":34350,"watchers_count":34350,"language":"PHP","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":11731,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":118,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["framework","laravel","php"],"visibility":"public","forks":11731,"open_issues":118,"watchers":34350,"default_branch":"12.x","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/laravel/framework/pulls/56677","html_url":"https://github.com/laravel/framework/pull/56677","diff_url":"https://github.com/laravel/framework/pull/56677.diff","patch_url":"https://github.com/laravel/framework/pull/56677.patch","merged_at":"2025-08-17T19:50:17Z"},"body":"<!--\r\nPlease only send a pull request to branches that are currently supported: https://laravel.com/docs/releases#support-policy \r\n\r\nIf you are unsure which branch your pull request should be sent to, please read: https://laravel.com/docs/contributions#which-branch\r\n\r\nPull requests without a descriptive title, thorough description, or tests will be closed.\r\n\r\nIn addition, please describe the benefit to end users; the reasons it does not break any existing features; how it makes building web applications easier, etc.\r\n-->\r\n\r\nFixed: #56497 \r\n\r\n# scheduling logic\r\n``` php\r\nCarbon::setTestNow(Carbon::create(2024, 1, 1, 8, 05, 0));\r\ndump('Current time: '.Carbon::now()->toDateTimeString());\r\nSchedule::days([1, 2, 3, 4, 5, 6])->group(function () {\r\n    Schedule::between('07:00', '08:00')->group(function () {\r\n        Schedule::call(Task1::class)->everyMinute();\r\n        Schedule::call(Task2::class)->everyFiveMinutes();\r\n    });\r\n\r\n    Schedule::call(Task3::class)->at('08:05');\r\n});\r\n```\r\n\r\n# before\r\n``` bash\r\nroot@PeopleSea-PC:/laravel-bug-report# php artisan schedule:run\r\n\"Current time: 2024-01-01 08:05:00\" // routes/console.php:12\r\n\r\n   INFO  No scheduled commands are ready to run.  \r\n```\r\n\r\n# after\r\n``` bash\r\nroot@PeopleSea-PC:/laravel-bug-report# php artisan schedule:run\r\n\"Current time: 2024-01-01 08:05:00\" // routes/console.php:12\r\n\r\n  2024-01-01 08:05:00 Running [App\\Jobs\\Task3] .......................................32.63ms DONE\r\n```\r\n\r\n\r\n# Solution approach:\r\n It is correct that attributes are inherited when group is nestedly called.  However, if filters are declared in the child group, it will directly change the top-level group.  Therefore, clone should be used to prevent filters from causing contamination.","reactions":{"url":"https://api.github.com/repos/laravel/framework/issues/56677/