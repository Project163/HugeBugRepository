,"has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Currently, we verify the client (cql/ql layer's) schema against the tserver's schema when the request is received by the Tserver.\r\n\r\nHowever if a ChangeMetadataOperation is under replication, then the schema when the write request is applied may be different from the schema that it was checked against (when received).\r\n\r\nWe should either make sure to not allow new writes while a schema change is replicating, or make sure that we check it against the new schema as well.\r\n\r\nCauses #3977","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/4039/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/4039/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":3236386991,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDMyMzYzODY5OTE=","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/3236386991","actor":{"login":"amitanandaiyer","id":32495790,"node_id":"MDQ6VXNlcjMyNDk1Nzkw","avatar_url":"https://avatars.githubusercontent.com/u/32495790?v=4","gravatar_id":"","url":"https://api.github.com/users