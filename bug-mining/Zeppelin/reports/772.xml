    ldapRealm = org.apache.zeppelin.realm.LdapRealm&lt;br/&gt;
    ldapRealm.contextFactory.url = ldap://ldap.foo&lt;br/&gt;
    ldapRealm.contextFactory.authenticationMechanism = simple&lt;br/&gt;
    ldapRealm.userDnTemplate = uid=&lt;/p&gt;
{0},cn=users,dc=ods,dc=foo&lt;br/&gt;
    ldapRealm.searchBase = dc=ods,dc=foo,dc=corp&lt;br/&gt;
    ldapRealm.userSearchBase = cn=users,dc=ods,dc=foo&lt;br/&gt;
    ldapRealm.groupSearchBase = cn=groups,dc=ods,dc=foo&lt;br/&gt;
    ldapRealm.authorizationEnabled = true&lt;br/&gt;
    ldapRealm.groupObjectClass = posixGroup&lt;br/&gt;
    ldapRealm.memberAttribute = memberUid&lt;br/&gt;
    ldapRealm.userObjectClass = posixAccount&lt;br/&gt;
    ldapRealm.memberOfAttribute = memberOf&lt;br/&gt;
    ldapReal.groupSearchFilter = &apos;(memberUid={0}
&lt;p&gt;)&apos;&lt;br/&gt;
    securityManager.realms = $ldapRealm&lt;br/&gt;
    sessionManager = org.apache.shiro.web.session.mgt.DefaultWebSessionManager&lt;br/&gt;
    securityManager.sessionManager = $sessionManager&lt;br/&gt;
    securityManager.sessionManager.globalSessionTimeout = 86400000&lt;br/&gt;
