<item>
            <title>[ZEPPELIN-926] Getting &apos;File name too long&apos; error when running scala code in Zeppelin</title>
                <link>https://issues.apache.org/jira/browse/ZEPPELIN-926</link>
                <project id="12316221" key="ZEPPELIN">Zeppelin</project>
                    <description>&lt;p&gt;1. Create %spark paragraph&lt;br/&gt;
2. Run this code several times in a row (usually 10~15 is enough)&lt;/p&gt;

&lt;p&gt;import org.apache.spark.sql.expressions.Window._&lt;br/&gt;
import org.apache.spark.sql.DataFrame&lt;br/&gt;
import org.apache.spark.sql.functions._&lt;/p&gt;

&lt;p&gt;def normaliseDate(table: DataFrame, col: String) = from_unixtime(table(col)/1000, &quot;yyyy-MM-dd&quot;) as col&lt;br/&gt;
def normaliseTime(table: DataFrame, col: String) = from_unixtime(table(col)/1000, &quot;HH:mm:ss&quot;) as col&lt;/p&gt;

&lt;p&gt;val df = sqlContext.sql(&quot;select * from parquet.`big_parquet_file`&quot;)&lt;/p&gt;

&lt;p&gt;val result = df.withColumn(&quot;start_date&quot;,from_unixtime((df(&quot;start_date&quot;)/1000),&quot;yyyy-MM-dd&quot;))&lt;/p&gt;

&lt;p&gt;Result: Getting &apos;File name too long&apos;&lt;/p&gt;</description>
