{"url":"https://api.github.com/repos/symfony/symfony/issues/2577","repository_url":"https://api.github.com/repos/symfony/symfony","labels_url":"https://api.github.com/repos/symfony/symfony/issues/2577/labels{/name}","comments_url":"https://api.github.com/repos/symfony/symfony/issues/2577/comments","events_url":"https://api.github.com/repos/symfony/symfony/issues/2577/events","html_url":"https://github.com/symfony/symfony/issues/2577","id":2170024,"node_id":"MDU6SXNzdWUyMTcwMDI0","number":2577,"title":"[HttpFoundation] UploadedFile needs Locale parameter to pass","user":{"login":"helios-ag","id":334907,"node_id":"MDQ6VXNlcjMzNDkwNw==","avatar_url":"https://avatars.githubusercontent.com/u/334907?v=4","gravatar_id":"","url":"https://api.github.com/users/helios-ag","html_url":"https://github.com/helios-ag","followers_url":"https://api.github.com/users/helios-ag/followers","following_url":"https://api.github.com/users/helios-ag/following{/other_user}","gists_url":"https://api.github.com/users/helios-ag/gists{/gist_id}","starred_url":"https://api.github.com/users/helios-ag/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/helios-ag/subscriptions","organizations_url":"https://api.github.com/users/helios-ag/orgs","repos_url":"https://api.github.com/users/helios-ag/repos","events_url":"https://api.github.com/users/helios-ag/events{/privacy}","received_events_url":"https://api.github.com/users/helios-ag/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":100079,"node_id":"MDU6TGFiZWwxMDAwNzk=","url":"https://api.github.com/repos/symfony/symfony/labels/Bug","name":"Bug","color":"e10c02","default":false,"description":null},{"id":125366,"node_id":"MDU6TGFiZWwxMjUzNjY=","url":"https://api.github.com/repos/symfony/symfony/labels/HttpFoundation","name":"HttpFoundation","color":"DDDDDD","default":false,"description":null},{"id":3113949,"node_id":"MDU6TGFiZWwzMTEzOTQ5","url":"https://api.github.com/repos/symfony/symfony/labels/Good%20first%20issue","name":"Good first issue","color":"7057ff","default":false,"description":"Ideal for your first contribution! (some Symfony experience may be required)"}],"state":"closed","locked":false,"assignee":null,"assignees":[],"milestone":null,"comments":15,"created_at":"2011-11-08T01:25:25Z","updated_at":"2012-05-21T14:09:09Z","closed_at":"2012-05-21T14:09:08Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Because function basename() is locale aware, the constructor need to pass a locale parameter and set it in constructor. Without setting a locale non-latin first characters cut off from beginning until a latin letter or a non-letter character found in the name.\n\nfrom HttpFoundation\\File\\UploadedFile.php\n\n```\n    $this->originalName = basename($originalName);\n    $this->mimeType = $mimeType ?: 'application/octet-stream';\n    $this->size = $size;\n    $this->error = $error ?: UPLOAD_ERR_OK;\n    $this->test = (Boolean) $test;\n\n    parent::__construct($path, UPLOAD_ERR_OK === $this->error);\n}\n```\n\nShould be like this (an example):\n        setlocale(LC_ALL, 'ru_RU.UTF8');\n        $this->originalName = basename($originalName);\n        $this->mimeType = $mimeType ?: 'application/octet-stream';\n        $this->size = $size;\n        $this->error = $error ?: UPLOAD_ERR_OK;\n        $this->test = (Boolean) $test;\n\n```\n    parent::__construct($path, UPLOAD_ERR_OK === $this->error);\n}\n```\n","closed_by":{"login":"vicb","id":248818,"node_id":"MDQ6VXNlcjI0ODgxOA==","avatar_url":"https://avatars.githubusercontent.com/u/248818?v=4","gravatar_id":"","url":"https://api.github.com/users/vicb","html_url":"https://github.com/vicb","followers_url":"https://api.github.com/users/vicb/followers","following_url":"https://api.github.com/users/vicb/following{/other_user}","gists_url":"https://api.github.com/users/vicb/gists{/gist_id}","starred_url":"https://api.github.com/users/vicb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vicb/subscriptions","organizations_url":"https://api.github.com/users/vicb/orgs","repos_url":"https://api.github.com/users/vicb/repos","events_url":"https://api.github.com/users/vicb/events{/privacy}","received_events_url":"https://api.github.com/users/vicb/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/symfony/symfony/issues/2577/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/symfony/symfony/issues/2577/timeline","performed_via_github_app":null,"state_reason":"completed"}