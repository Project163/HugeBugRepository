lcjQ1Njg0MjA=","avatar_url":"https://avatars.githubusercontent.com/u/4568420?v=4","gravatar_id":"","url":"https://api.github.com/users/albertzaharovits","html_url":"https://github.com/albertzaharovits","followers_url":"https://api.github.com/users/albertzaharovits/followers","following_url":"https://api.github.com/users/albertzaharovits/following{/other_user}","gists_url":"https://api.github.com/users/albertzaharovits/gists{/gist_id}","starred_url":"https://api.github.com/users/albertzaharovits/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/albertzaharovits/subscriptions","organizations_url":"https://api.github.com/users/albertzaharovits/orgs","repos_url":"https://api.github.com/users/albertzaharovits/repos","events_url":"https://api.github.com/users/albertzaharovits/events{/privacy}","received_events_url":"https://api.github.com/users/albertzaharovits/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Elasticsearch Version\r\n\r\n8.9 and up\r\n\r\n### Installed Plugins\r\n\r\n_No response_\r\n\r\n### Java Version\r\n\r\n_bundled_\r\n\r\n### OS Version\r\n\r\nany\r\n\r\n### Problem Description\r\n\r\nResponse headers such as `Warning: 299 Elasticsearch-8.* \"Your license will expire in [6] days. Contact your administrator or update your license for continued use of features\"` continue to be returned even though the license has been successfully [updated](https://www.elastic.co/guide/en/elasticsearch/reference/current/update-license.html).\r\nMoreover, multiple such warnings might be returned for different countdowns.\r\n\r\nIn case, following a license update, no **new** warnings are returned (but the existing ones continue to show up), licensed functionality should not be impacted come the deadline.\r\n\r\n### Steps to Reproduce\r\n\r\nAuthentication **and** auditing need to be enabled.\r\nThe license needs to expire 7 days from the current time.\r\nUploading a new license doesn't make the existing response warnings go away.","closed_by":{"login":"slobodanadamovic","id":4357326,"node_id":"MDQ6VXNlcjQzNTczMjY=","avatar_url":"https://avatars.githubusercontent.com/u/4357326?v=4","gravatar_id":"","url":"https://api.github.com/users/slobodanadamovic","html_url":"https://github.com/slobodanadamovic","followers_url":"https://api.github.com/users/slobodanadamovic/followers","following_url":"https://api.github.com/users/slobodanadamovic/following{/other_user}","gists_url":"https://api.github.com/users/slobodanadamovic/gists{/gist_id}","starred_url":"https://api.github.com/users/slobodanadamovic/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/slobodanadamovic/subscriptions","organizations_url":"https://api.github.com/users/slobodanadamovic/orgs","repos_url":"https://api.github.com/users/slobodanadamovic/repos","events_url":"https://api.github.com/users/slobodanadamovic/events{/privacy}","received_events_url":"https://api.github.com/users/slobodanadamovic/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/107573/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/elastic/elasticsearch/issues/107573/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}