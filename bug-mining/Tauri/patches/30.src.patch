+/// Displays a message dialog.
+pub fn message(message: impl AsRef<str>, title: impl AsRef<str>) {
+  DialogBuilder::new()
+    .message(message.as_ref())
+    .title(title.as_ref())
+    .style(DialogStyle::Info)
+    .build()
+    .show();
+}
