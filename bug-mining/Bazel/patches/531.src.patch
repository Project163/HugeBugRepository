+def Which(program):
+
+  def IsExe(fpath):
+    return os.path.isfile(fpath) and os.access(fpath, os.X_OK)
+
+  for path in os.environ['PATH'].split(os.pathsep):
+    filename = os.path.join(path, program)
+    if IsExe(filename):
+      return filename
+
+  return None
+
+
+class NoRpmbuildFound(Exception):
+  pass
+
+
+def FindRpmbuild():
+  path = Which('rpmbuild')
+  if path:
+    return path
+  else:
+    raise NoRpmbuildFound()
+
+
