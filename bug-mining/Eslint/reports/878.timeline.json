ub.com/users/npm/received_events","type":"Organization","user_view_type":"public","site_admin":false},"html_url":"https://github.com/npm/npm","description":"This repository is moving to: https://github.com/npm/cli","fork":false,"url":"https://api.github.com/repos/npm/npm","forks_url":"https://api.github.com/repos/npm/npm/forks","keys_url":"https://api.github.com/repos/npm/npm/keys{/key_id}","collaborators_url":"https://api.github.com/repos/npm/npm/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/npm/npm/teams","hooks_url":"https://api.github.com/repos/npm/npm/hooks","issue_events_url":"https://api.github.com/repos/npm/npm/issues/events{/number}","events_url":"https://api.github.com/repos/npm/npm/events","assignees_url":"https://api.github.com/repos/npm/npm/assignees{/user}","branches_url":"https://api.github.com/repos/npm/npm/branches{/branch}","tags_url":"https://api.github.com/repos/npm/npm/tags","blobs_url":"https://api.github.com/repos/npm/npm/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/npm/npm/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/npm/npm/git/refs{/sha}","trees_url":"https://api.github.com/repos/npm/npm/git/trees{/sha}","statuses_url":"https://api.github.com/repos/npm/npm/statuses/{sha}","languages_url":"https://api.github.com/repos/npm/npm/languages","stargazers_url":"https://api.github.com/repos/npm/npm/stargazers","contributors_url":"https://api.github.com/repos/npm/npm/contributors","subscribers_url":"https://api.github.com/repos/npm/npm/subscribers","subscription_url":"https://api.github.com/repos/npm/npm/subscription","commits_url":"https://api.github.com/repos/npm/npm/commits{/sha}","git_commits_url":"https://api.github.com/repos/npm/npm/git/commits{/sha}","comments_url":"https://api.github.com/repos/npm/npm/comments{/number}","issue_comment_url":"https://api.github.com/repos/npm/npm/issues/comments{/number}","contents_url":"https://api.github.com/repos/npm/npm/contents/{+path}","compare_url":"https://api.github.com/repos/npm/npm/compare/{base}...{head}","merges_url":"https://api.github.com/repos/npm/npm/merges","archive_url":"https://api.github.com/repos/npm/npm/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/npm/npm/downloads","issues_url":"https://api.github.com/repos/npm/npm/issues{/number}","pulls_url":"https://api.github.com/repos/npm/npm/pulls{/number}","milestones_url":"https://api.github.com/repos/npm/npm/milestones{/number}","notifications_url":"https://api.github.com/repos/npm/npm/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/npm/npm/labels{/name}","releases_url":"https://api.github.com/repos/npm/npm/releases{/id}","deployments_url":"https://api.github.com/repos/npm/npm/deployments","created_at":"2009-09-29T17:21:24Z","updated_at":"2025-12-12T05:40:09Z","pushed_at":"2020-08-07T14:31:21Z","git_url":"git://github.com/npm/npm.git","ssh_url":"git@github.com:npm/npm.git","clone_url":"https://github.com/npm/npm.git","svn_url":"https://github.com/npm/npm","homepage":"http://npm.community","size":47314,"stargazers_count":17598,"watchers_count":17598,"language":null,"has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":3006,"mirror_url":null,"archived":true,"disabled":false,"open_issues_count":2164,"license":null,"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":[],"visibility":"public","forks":3006,"open_issues":2164,"watchers":17598,"default_branch":"latest","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"I have a hard to debug deduplication error (I assume), which is reproducible, but hard to cage in for me.\n\nIt happens in the project [assetgraph/assetgraph](https://github.com/assetgraph/assetgraph/) and is happening consistently [on CI](https://travis-ci.org/assetgraph/assetgraph/builds/122372717) since we upgraded chalk from 1.1.2 to 1.1.3.\n\nAll the build errors manifest the same way - by eslint not being able to find a module called 'has-ansi' required by 'chalk' in one of it's repoters. Because of [a bug in eslint](https://github.com/eslint/eslint/issues/5977), it shows as if the loader couldn't be loaded though:\n\n```\n> assetgraph@2.3.0 lint /home/travis/build/assetgraph/assetgraph\n> eslint .\nCould not find formatter 'stylish'.\n```\n\nIt fails on node 5 and 6, but not on 0.10, 0.12, or 4. Which lead me to think that it was related to npm version 3. I have been able to confirm that by running the following commands from a clean checkout of [current HEAD](https://github.com/assetgraph/assetgraph/tree/9c483ef273d4d64027ad47f9e7f056b78a67bd14) of AssetGraph.\n\n```\n$ npm install && echo \"node: `node -v`\" && echo \"npm: `npm -v`\" && npm run lint\n```\n\nThat yields the following outputs, with different configurations:\n\n```\n$ npm install && echo \"node: `node -v`\" && echo \"npm: `npm -v`\" && npm run lint\n... truncated npm install output ...\nnode: v0.10.42\nnpm: 2.15.2\n\n> assetgraph@2.3.0 lint /home/gno/Scratch/reproDedupError\n> eslint .\n\n```\n\n```\n$ npm install && echo \"node: `node -v`\" && echo \"npm: `npm -v`\" && npm run lint\nnode: v5.11.0\nnpm: 2.15.4\n\n> assetgraph@2.3.0 lint /home/gno/Scratch/assetgraph-test/assetgraph\n> eslint .\n\n```\n\n```\n$ npm install && echo \"node: `node -v`\" && echo \"npm: `npm -v`\" && npm run lint\n... truncated npm install output ...\nnode: v5.10.1\nnpm: 3.8.3\n\n> assetgraph@2.3.0 lint /home/gno/Projects/assetgraph\n> eslint .\n\nCould not find formatter 'stylish'.\n\nnpm ERR! Linux 4.2.0-35-generic\n... truncated error output ...\n```\n\n```\n$ npm install && echo \"node: `node -v`\" && echo \"npm: `npm -v`\" && npm run lint\n... truncated npm install output ...\nnode: v5.11.0\nnpm: 3.8.7\n\n> assetgraph@2.3.0 lint /home/gno/Scratch/assetgraph-test/assetgraph\n> eslint .\n\nCould not find formatter 'stylish'.\n\nnpm ERR! Linux 4.2.0-35-generic\n... truncated error output ...\n```\n\nIt fails consistently with npm@3, and it works with npm@2. Running npm install again, after having triggered the error with npm@3, will actually install the missing package, and fix the problem.\n\nThat makes me really certain that this problem is related to npm and npm 3 in particular.\n\nI have spent a long time trying to reproduce this with a smaller set of packages, but I haven't been able to. I hope that I provided enough information that you will be able to pick it up.\n\nLet me know if there's any details missing.\n","reactions":{"url":"https://api.github.com/repos/npm/npm/issues/12503/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/npm/npm/issues/12503/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":643704154,"node_id":"MDEyOkxhYmVsZWRFdmVudDY0MzcwNDE1NA==","url":"https://api.github.com/repos/eslint/eslint/issues/events/643704154","actor":{"login":"nzakas","id":38546,"node_id":"MDQ6VXNlcjM4NTQ2","avatar_url":"https://avatars.githubusercontent.com/u/38546?v=4","gravatar_id":"","url":"https://api.github.com/users/nzakas","html_url":"https://github.com/nzakas","followers_url":"https://api.github.com/users/nzakas/followers","following_url":"https://api.github.com/users/nzakas/following{/other_user}","gists_url":"https://api.github.com/users/nzakas/gists{/gist_id}","starred_url":"https://api.github.com/users/nzakas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nzakas/subscriptions","organizations_url":"https://api.github.com/users/nzakas/orgs","repos_url":"https://api.github.com/users/nzakas/repos","events_url":"https://api.github.com/users/nzakas/events{/privacy}","received_events_url":"https://api.github.com/users/nzakas/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled",