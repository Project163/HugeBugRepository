.github.com/repos/sveltejs/kit/subscribers","subscription_url":"https://api.github.com/repos/sveltejs/kit/subscription","commits_url":"https://api.github.com/repos/sveltejs/kit/commits{/sha}","git_commits_url":"https://api.github.com/repos/sveltejs/kit/git/commits{/sha}","comments_url":"https://api.github.com/repos/sveltejs/kit/comments{/number}","issue_comment_url":"https://api.github.com/repos/sveltejs/kit/issues/comments{/number}","contents_url":"https://api.github.com/repos/sveltejs/kit/contents/{+path}","compare_url":"https://api.github.com/repos/sveltejs/kit/compare/{base}...{head}","merges_url":"https://api.github.com/repos/sveltejs/kit/merges","archive_url":"https://api.github.com/repos/sveltejs/kit/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/sveltejs/kit/downloads","issues_url":"https://api.github.com/repos/sveltejs/kit/issues{/number}","pulls_url":"https://api.github.com/repos/sveltejs/kit/pulls{/number}","milestones_url":"https://api.github.com/repos/sveltejs/kit/milestones{/number}","notifications_url":"https://api.github.com/repos/sveltejs/kit/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/sveltejs/kit/labels{/name}","releases_url":"https://api.github.com/repos/sveltejs/kit/releases{/id}","deployments_url":"https://api.github.com/repos/sveltejs/kit/deployments","created_at":"2020-10-15T14:00:23Z","updated_at":"2025-12-12T17:54:14Z","pushed_at":"2025-12-12T19:49:47Z","git_url":"git://github.com/sveltejs/kit.git","ssh_url":"git@github.com:sveltejs/kit.git","clone_url":"https://github.com/sveltejs/kit.git","svn_url":"https://github.com/sveltejs/kit","homepage":"https://svelte.dev/docs/kit","size":32161,"stargazers_count":20055,"watchers_count":20055,"language":"JavaScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":2168,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1040,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["hacktoberfest","svelte"],"visibility":"public","forks":2168,"open_issues":1040,"watchers":20055,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"**Describe the bug**\r\nWhen the `$error.svelte` route is rendered, links on the page change the URL but the page is not updated.\r\n\r\n**Logs**\r\n<details>\r\n<summary>console.log</summary>\r\n\r\n```\r\n\r\nGET http://localhost:3000/not-here\r\n[HTTP/1.1 404 Not Found 399ms]\r\n\r\n[vite] connecting... client:180:9\r\n[vite] connected. client:202:21\r\nUncaught (in promise) TypeError: this.current.page is null\r\n    notify http://localhost:3000/.svelte/dev/runtime/internal/start.js:423\r\n    _navigate http://localhost:3000/.svelte/dev/runtime/internal/start.js:185\r\n    init http://localhost:3000/.svelte/dev/runtime/internal/start.js:112\r\n    init http://localhost:3000/.svelte/dev/runtime/internal/start.js:73\r\n    start http://localhost:3000/.svelte/dev/runtime/internal/start.js:812\r\n    <anonymous> http://localhost:3000/not-here:16\r\nstart.js:423:5\r\n    _navigate http://localhost:3000/.svelte/dev/runtime/internal/start.js:206\r\n    init http://localhost:3000/.svelte/dev/runtime/internal/start.js:112\r\n    (Async: EventListener.handleEvent)\r\n    init http://localhost:3000/.svelte/dev/runtime/internal/start.js:73\r\n    start http://localhost:3000/.svelte/dev/runtime/internal/start.js:812\r\n    <anonymous> http://localhost:3000/not-here:16\r\n    InnerModuleEvaluation self-hosted:2382\r\n    evaluation self-hosted:2333\r\n```\r\n</details>\r\n\r\n**To Reproduce**\r\n1. Setup with `npm init svelte@next`\r\n2. Create an `$error.svelte` route with a link to, say, \"/\"\r\n3. Run the dev server (or build and start)\r\n4. Hit a 404 say /not-here\r\n5. Click the link and observe that the URL changes, but the page does not\r\n\r\nClone https://github.com/drzax/svelte-kit-app for a quick reproduction.\r\nDeployed here: https://svelte-kit-app.netlify.app/not-there\r\n\r\n**Expected behavior**\r\nClicking the link should display the home page. \r\n\r\n**Information about your SvelteKit Installation:**\r\n```\r\n System:\r\n    OS: macOS 10.15.7\r\n    CPU: (16) x64 Intel(R) Core(TM) i9-9880H CPU @ 2.30GHz\r\n    Memory: 154.45 MB / 32.00 GB\r\n    Shell: 5.0.11 - /usr/local/bin/bash\r\n  Binaries:\r\n    Node: 14.15.1 - ~/.nave/installed/default/bin/node\r\n    Yarn: 1.22.10 - ~/.nave/installed/default/bin/yarn\r\n    npm: 7.6.3 - ~/.nave/installed/default/bin/npm\r\n  Browsers:\r\n    Chrome: 91.0.4455.2\r\n    Edge: 89.0.774.57\r\n    Firefox: 86.0.1\r\n    Firefox Developer Edition: 79.0\r\n    Safari: 14.0.3\r\n  npmPackages:\r\n    @sveltejs/kit: next => 1.0.0-next.59\r\n    svelte: ^3.29.0 => 3.35.0\r\n```\r\nSeen in Firefox 86.0.1  on macOS\r\n\r\nSeen on both adapter-node and adapter-netlify\r\n\r\n**Severity**\r\nA bit annoying. Links direct on the page can use `target=\"_self\"` to avoid the router but links in modules used on the error page are more difficult to modify.\r\n\r\n**Additional context**\r\nSeems possibly related to https://github.com/sveltejs/kit/issues/643","reactions":{"url":"https://api.github.com/repos/sveltejs/kit/issues/663/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sveltejs/kit/issues/663/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":4547103273,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDQ1NDcxMDMyNzM=","url":"https://api.github.com/repos/sveltejs/kit/issues/events/4547103273","actor":{"login":"Rich-Harris","id":1162160,"node_id":"MDQ6VXNlcjExNjIxNjA=","avatar_url":"https://avatars.githubusercontent.com/u/116216