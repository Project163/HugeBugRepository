+                    statRepo.saveObsolescenceInfo(ctx.configuration().key());
+
+                if (ctx.table() == null || ctx.configuration() == null || ctx.configuration().columns().isEmpty()) {
+                    statRepo.clearLocalPartitionsStatistics(ctx.configuration().key(), null);
