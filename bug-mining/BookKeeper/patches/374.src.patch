-PubSubDataPtr AbstractDuplexChannel::retrieveTransaction(long txnid) {
-  boost::lock_guard<boost::mutex> lock(txnid2data_lock);
-
-  PubSubDataPtr data = txnid2data[txnid];
-  txnid2data.erase(txnid);
