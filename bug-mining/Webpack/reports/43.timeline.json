em);\n      }, this);\n    }\n    if(module.contextDependencies) {\n      module.contextDependencies.forEach(function(item) {\n        this.contextDependencies.push(item);\n      }, this);\n    }\n  }, this);\n  this.errors.forEach(function(error) {\n    // todo: fix me!!!\n    // when error happen we want to watch this file also\n    // this is wrong in 100% :D \n    if (error.module) {\n      this.fileDependencies.push(error.module.resource);\n    }\n    if(Array.isArray(error.missing)) {\n      error.missing.forEach(function(item) {\n        this.missingDependencies.push(item);\n      }, this);\n    }\n  }, this);\n  this.fileDependencies.sort();\n  this.fileDependencies = filterDups(this.fileDependencies);\n  this.contextDependencies.sort();\n  this.contextDependencies = filterDups(this.contextDependencies);\n  this.missingDependencies.sort();\n  this.missingDependencies = filterDups(this.missingDependencies);\n};\n```\n\nping @sokra if you can comment ( what is best approach to fix it ) i will make small PR!\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/webpack/webpack/issues/comments/178584980/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"piecyk","id":82964,"node_id":"MDQ6VXNlcjgyOTY0","avatar_url":"https://avatars.githubusercontent.com/u/82964?v=4","gravatar_id":"","url":"https://api.github.com/users/piecyk","html_url":"https://github.com/piecyk","followers_url":"https://api.github.com/users/piecyk/followers","following_url":"https://api.github.com/users/piecyk/following{/other_user}","gists_url":"https://api.github.com/users/piecyk/gists{/gist_id}","starred_url":"https://api.github.com/users/piecyk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/piecyk/subscriptions","organizations_url":"https://api.github.com/users/piecyk/orgs","repos_url":"https://api.github.com/users/p