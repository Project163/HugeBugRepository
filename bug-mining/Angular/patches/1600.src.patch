 export function unwrapSignal(s: any): any {
-  return isSignal(s) ? s() : s;
+  if (!isSignal(s)) {
+    return s;
+  }
+
+  const {error, value} = safelyReadSignalValue(s);
+  if (error) {
+    return;
+  }
+  return value;
 }
