com/repos/bazelbuild/bazel/labels/category:%20misc%20%3E%20misc","name":"category: misc > misc","color":"d4c5f9","default":false,"description":null}],"state":"closed","locked":false,"assignee":{"login":"philwo","id":504652,"node_id":"MDQ6VXNlcjUwNDY1Mg==","avatar_url":"https://avatars.githubusercontent.com/u/504652?v=4","gravatar_id":"","url":"https://api.github.com/users/philwo","html_url":"https://github.com/philwo","followers_url":"https://api.github.com/users/philwo/followers","following_url":"https://api.github.com/users/philwo/following{/other_user}","gists_url":"https://api.github.com/users/philwo/gists{/gist_id}","starred_url":"https://api.github.com/users/philwo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/philwo/subscriptions","organizations_url":"https://api.github.com/users/philwo/orgs","repos_url":"https://api.github.com/users/philwo/repos","events_url":"https://api.github.com/users/philwo/events{/privacy}","received_events_url":"https://api.github.com/users/philwo/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"philwo","id":504652,"node_id":"MDQ6VXNlcjUwNDY1Mg==","avatar_url":"https://avatars.githubusercontent.com/u/504652?v=4","gravatar_id":"","url":"https://api.github.com/users/philwo","html_url":"https://github.com/philwo","followers_url":"https://api.github.com/users/philwo/followers","following_url":"https://api.github.com/users/philwo/following{/other_user}","gists_url":"https://api.github.com/users/philwo/gists{/gist_id}","starred_url":"https://api.github.com/users/philwo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/philwo/subscriptions","organizations_url":"https://api.github.com/users/philwo/orgs","repos_url":"https://api.github.com/users/philwo/repos","events_url":"https://api.github.com/users/philwo/events{/privacy}","received_events_url":"https://api.github.com/users/philwo/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":3,"created_at":"2017-04-20T15:14:27Z","updated_at":"2022-10-26T08:01:11Z","closed_at":"2018-07-19T12:42:45Z","author_association":"MEMBER","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"I was just trying to test some of my changes via \"bazel test\", when Bazel stopped working and suddenly couldn't build anything at all. I know the bug is probably in my new code, but the uselessness of error messages makes it nearly impossible to debug this:\r\n\r\n```\r\nphilwo-macbookpro:bazel-test philwo$ bazel build -s --verbose_failures //src:bazel\r\nINFO: Reading 'startup' options from /Users/philwo/.bazelrc: --watchfs\r\nINFO: Analysed target //src:bazel (0 packages loaded).\r\nINFO: Found 1 target...\r\nERROR: Process exited with status 127\r\nTarget //src:bazel failed to build\r\nINFO: Elapsed time: 0.252s, Critical Path: 0.01s\r\nFAILED: Build did NOT complete successfully\r\n```\r\n\r\nIt prints 7 lines, none of which are remotely helpful here.\r\n\r\nSome open questions:\r\n- Which \"process\" that supposedly exited with status 127 is Bazel referring to here?\r\n- If Bazel tried to launch a process, why isn't it printing any command-line even though I use \"-s\"?\r\n\r\nI understand that we don't want to annoy users with stack traces when the build failed due to a syntax error in their own code. But after another hour of debugging Bazel failing with \"Failure due to failure in a failing component that is totally not Bazel, haha, oh wait, I have another hint for you: Somewhere some code threw an IOException! But I won't print any more info, because stack traces are ugly and UX!\" I'm slightly annoyed.\r\n\r\nAs a Bazel developer, this terseness of error messages has killed my productivity often enough that I'll try to improve this now...\r\n\r\n![trace_all_the_stacks](https://cloud.githubusercontent.com/assets/504652/25238072/a7df7f12-25ec-11e7-8a77-52c87a61c330.png)","closed_by":{"login":"philwo","id":504652,"node_id":"MDQ6VXNlcjUwNDY1Mg==","avatar_url":"https://avatars.githubusercontent.com/u/504652?v=4","gravatar_id":"","url":"https://api.github.com/users/philwo","html_url":"https://github.com/philwo","followers_url":"https://api.github.com/users/philwo/followers","following_url":"https://api.github.com/users/philwo/following{/other_user}","gists_url":"https://api.github.com/users/philwo/gists{/gist_id}","starred_url":"https://api.github.com/users/philwo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/philwo/subscriptions","organizations_url":"https://api.github.com/users/philwo/orgs","repos_url":"https://api.github.com/users/philwo/repos","events_url":"https://api.github.com/users/philwo/events{/privacy}","received_events_url":"https://api.github.com/users/philwo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/2855/reactions","total_count":8,"+1":8,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bazelbuild/bazel/issues/2855/timeline","performed_via_github_app":null,"state_reason":"completed"}