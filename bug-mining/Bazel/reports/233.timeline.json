r}","gists_url":"https://api.github.com/users/bazel-io/gists{/gist_id}","starred_url":"https://api.github.com/users/bazel-io/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bazel-io/subscriptions","organizations_url":"https://api.github.com/users/bazel-io/orgs","repos_url":"https://api.github.com/users/bazel-io/repos","events_url":"https://api.github.com/users/bazel-io/events{/privacy}","received_events_url":"https://api.github.com/users/bazel-io/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":"c5545fd0896f3c602a9be0986debed6f0c9c662d","commit_url":"https://api.github.com/repos/bazelbuild/bazel/commits/c5545fd0896f3c602a9be0986debed6f0c9c662d","created_at":"2016-09-28T08:30:54Z","state_reason":null,"performed_via_github_app":null},{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/250139686","html_url":"https://github.com/bazelbuild/bazel/issues/1846#issuecomment-250139686","issue_url":"https://api.github.com/repos/bazelbuild/bazel/issues/1846","id":250139686,"node_id":"MDEyOklzc3VlQ29tbWVudDI1MDEzOTY4Ng==","user":{"login":"aehlig","id":9567293,"node_id":"MDQ6VXNlcjk1NjcyOTM=","avatar_url":"https://avatars.githubusercontent.com/u/9567293?v=4","gravatar_id":"","url":"https://api.github.com/users/aehlig","html_url":"https://github.com/aehlig","followers_url":"https://api.github.com/users/aehlig/followers","following_url":"https://api.github.com/users/aehlig/following{/other_user}","gists_url":"https://api.github.com/users/aehlig/gists{/gist_id}","starred_url":"https://api.github.com/users/aehlig/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aehlig/subscriptions","organizations_url":"https://api.github.com/users/aehlig/orgs","repos_url":"https://api.github.com/users/aehlig/repos","events_url":"https://api.github.com/users/aehlig/events{/privacy}","received_events_url":"https://api.github.com/users/aehlig/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-09-28T11:20:08Z","updated_at":"2016-09-28T11:20:08Z","body":"On Tue, Sep 27, 2016 at 11:45:25AM -0700, Yun Peng wrote:\n\n> ```\n> root@62f6b1c16dcb:/# bazel version\n> INFO: Options provided by the client:\n>   Inherited 'common' options: --isatty=1 --terminal_columns=230\n> INFO: Reading options for 'version' from /etc/bazel.bazelrc:\n>   Inherited 'common' options: --action_env=PATH --action_env=LD_LIBRARY_PATH --action_env=TMPDIR\n> Unrecognized option: --action_env=PATH\n> root@62f6b1c16dcb:/# bazel info\n> The 'info' command is only supported from within a workspace.\n> root@62f6b1c16dcb:/# vim /etc/bazel.bazelrc \n> root@62f6b1c16dcb:/# rm /etc/bazel.bazelrc\n> root@62f6b1c16dcb:/# bazel version\n> Build label: 0.3.2rc2\n> Build target: bazel-out/local-fastbuild/bin/src/main/java/com/google/devtools/build/lib/bazel/BazelServer_deploy.jar\n> Build time: Tue Sep 27 17:58:19 2016 (1474999099)\n> Build timestamp: 1474999099\n> Build timestamp as int: 1474999099\n> root@62f6b1c16dcb:/# \n> ```\n> \n> I used a docker to test installing the latest bazel candidate and found this error.\n> After deleting `/etc/bazel.bazelrc`, the output is expected.\n\nWhich commit does the label 0.3.2rc2 refer to? The error seems to indicate that your\ndebian package is combining the latest additional files (bazel.bazelrc) with a binary\nbased on an old source version (that does not yet know the --action_env option).\n\nNote that not keeping packaging and sources in sync is usually a bad idea; so the\nrollback only treats the symptoms and not the underlying cause that files intended\nto be packaged with only a newer source version get packaged with an older source\nversion. Should we reopen this bug to address the actual issue that when packaging\nan old version we don't use the packaging script from that source version (and\nroll forward the rolled back commit)?\n\n## \n\nKlaus Aehlig\nGoogle Germany GmbH, Erika-Mann-Str. 33, 80636 Muenchen\nRegistergericht und -nummer: Hamburg, HRB 86891\nSitz der Gesellschaft: Hamburg\nGeschaeftsfuehrer: Matthew Scott Sucherman, Paul Terence Manicle\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/250139686/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"aehlig","id":9567293,"node_id":"MDQ6VXNlcjk1NjcyOTM=","avatar_url":"https://avatars.githubusercontent.com/u/9567293?v=4","gravatar_id":"","url":"https://api.github.com/users/aehlig","html_url":"https://github.com/aehlig","followers_url":"https://api.github.com/users/aehlig/followers","following_url":"https://api.github.com/users/aehlig/following{/other_user}","gists_url":"https://api.github.com/users/aehlig/gists{/gist_id}","starred_url":"https://api.github.com/users/aehlig/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aehlig/subscriptions","organizations_url":"https://api.github.com/users/aehlig/orgs","repos_url":"https://api.github.com/users/aehlig/repos","events_url":"https://api.github.com/users/aehlig/events{/privacy}","received_events_url":"https://api.github.com/users/aehlig/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/250410474","html_url":"https://github.com/bazelbuild/bazel/issues/1846#issuecomment-250410474","issue_url":"https://api.github.com/repos/bazelbuild/bazel/issues/1846","id":250410474,"node_id":"MDEyOklzc3VlQ29tbWVudDI1MDQxMDQ3NA==","user":{"login":"aehlig","id":9567293,"node_id":"MDQ6VXNlcjk1NjcyOTM=","avatar_url":"https://avatars.githubusercontent.com/u/9567293?v=4","gravatar_id":"","url":"https://api.github.com/users/aehlig","html_url":"https://github.com/aehlig","followers_url":"https://api.github.com/users/aehlig/followers","following_url":"https://ap