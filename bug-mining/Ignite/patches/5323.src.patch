+        G.allGrids().forEach(i -> failCompressionProcessor(i));
+
+        Collection<String> groupsWithoutCompression = CACHES.entrySet().stream()
+            .filter(e -> !COMPRESSED_CACHES.contains(e.getKey()))
+            .map(e -> e.getValue() != null ? e.getValue() : e.getKey())
