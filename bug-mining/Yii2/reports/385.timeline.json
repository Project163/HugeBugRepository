users/wichura/gists{/gist_id}","starred_url":"https://api.github.com/users/wichura/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wichura/subscriptions","organizations_url":"https://api.github.com/users/wichura/orgs","repos_url":"https://api.github.com/users/wichura/repos","events_url":"https://api.github.com/users/wichura/events{/privacy}","received_events_url":"https://api.github.com/users/wichura/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2015-03-20T13:12:55Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/yiisoft/yii2/issues/comments/84017541","html_url":"https://github.com/yiisoft/yii2/issues/7735#issuecomment-84017541","issue_url":"https://api.github.com/repos/yiisoft/yii2/issues/7735","id":84017541,"node_id":"MDEyOklzc3VlQ29tbWVudDg0MDE3NTQx","user":{"login":"wichura","id":878562,"node_id":"MDQ6VXNlcjg3ODU2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/878562?v=4","gravatar_id":"","url":"https://api.github.com/users/wichura","html_url":"https://github.com/wichura","followers_url":"https://api.github.com/users/wichura/followers","following_url":"https://api.github.com/users/wichura/following{/other_user}","gists_url":"https://api.github.com/users/wichura/gists{/gist_id}","starred_url":"https://api.github.com/users/wichura/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wichura/subscriptions","organizations_url":"https://api.github.com/users/wichura/orgs","repos_url":"https://api.github.com/users/wichura/repos","events_url":"https://api.github.com/users/wichura/events{/privacy}","received_events_url":"https://api.github.com/users/wichura/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-03-20T13:28:52Z","updated_at":"2015-03-20T13:51:00Z","body":"Hi @cebe,\n\nThanks for the prompt fix, and sorry for the radio silence in the past days - I was away from my computer. \n\nI've seen fecdf1a5f77155a9aa4290c01a358053a545b9d6 and it seems that you simply ignore multiple search paths, which does not work for our particular application. \n\nI made some headway with refactoring yii\\composer\\Installer and yii\\base\\Application to work with arrays, albeit I can see it is a limitation of Yii::setAlias() when it comes to setting the same key. One might argue though that setting one alias (be it the first or the last one) is better than ignoring them altogether? \n\nThanks again for troubleshooting this for us, much appreciated\nMarcin\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/yiisoft/yii2/issues/comments/84017541/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"wichura","id":878562,"node_id":"MDQ6VXNlcjg3ODU2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/878562?v=4","gravatar_id":"","url":"https://api.github.com/users/wichura","html_url":"https://github.com/wichura","followers_url":"https://api.github.com/users/wichura/followers","following_url":"https://api.github.com/users/wichura/following{/other_user}","gists_url":"https://api.github.com/users/wichura/gists{/gist_id}","starred_url":"https://api.github.com/users/wichura/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wichura/subscriptions","organizations_url":"https://api.github.com/users/wichura/orgs","repos_url":"https://api.github.com/users/wichura/repos","events_url":"https://api.github.com/users/wichura/events{/privacy}","received_events_url":"https://api.github.com/users/wichura/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":260429465,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50MjYwNDI5NDY1","url":"https://api.github.com/repos/yiisoft/yii2/issues/events/260429465","actor":{"login":"cebe","id":189796,"node_id":"MD