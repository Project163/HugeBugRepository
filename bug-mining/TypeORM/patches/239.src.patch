+            "post",
+            new TableColumn({
+                name: "authorId",
+                type: "integer",
+            }),
+        )
+        await queryRunner.createForeignKey(
+            "post",
+            new TableForeignKey({
+                columnNames: ["authorId"],
+                referencedTableName: "author",
+                referencedColumnNames: ["id"],
+            }),
+        )
+    }
