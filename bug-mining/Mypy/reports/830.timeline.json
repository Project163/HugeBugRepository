nt, str]:\r\n    pass\r\n```\r\n\r\nRunning with `mypy run.py --show-traceback` (with or without incremental mode):\r\n```\r\nrun.py:3: error: String argument 1 \"_fn\" to TypeVar(...) does not match variable name \"_Fn\"\r\nrun.py:3: error: Argument \"bound\" to \"TypeVar\" has incompatible type \"object\"; expected \"Union[None, Type[Any], str]\"\r\nrun.py:6: error: Variable \"run._Fn\" is not valid as a type\r\nrun.py:6: note: See https://mypy.readthedocs.io/en/stable/common_issues.html#variables-vs-type-aliases\r\nrun.py:10: error: INTERNAL ERROR -- Please try using mypy master on Github:\r\nhttps://mypy.readthedocs.io/en/stable/common_issues.html#using-a-development-mypy-build\r\nPlease report a bug at https://github.com/python/mypy/issues\r\nversion: 0.920+dev.9cbd2103abbc2afb518bbfe727b7c3e7bcd55f3a\r\nTraceback (most recent call last):\r\n  File \"/home/pranav/.local/bin/mypy\", line 8, in <module>\r\n    sys.exit(console_entry())\r\n  File \"/home/pranav/.local/lib/python3.8/site-packages/mypy/__main__.py\", line 11, in console_entry\r\n    main(None, sys.stdout, sys.stderr)\r\n  File \"/home/pranav/.local/lib/python3.8/site-packages/mypy/main.py\", line 87, in main\r\n    res, messages, blockers = run_build(sources, options, fscache, t0, stdout, stderr)\r\n  File \"/home/pranav/.local/lib/python3.8/site-packages/mypy/main.py\", line 165, in run_build\r\n    res = build.build(sources, options, None, flush_errors, fscache, stdout, stderr)\r\n  File \"/home/pranav/.local/lib/python3.8/site-packages/mypy/build.py\", line 180, in build\r\n    result = _build(\r\n  File \"/home/pranav/.local/lib/python3.8/site-packages/mypy/build.py\", line 256, in _build\r\n    graph = dispatch(sources, manager, stdout)\r\n  File \"/home/pranav/.local/lib/python3.8/site-packages/mypy/build.py\", line 2712, in dispatch\r\n    process_graph(graph, manager)\r\n  File \"/home/pranav/.local/lib/python3.8/site-packages/mypy/build.py\", line 3043, in process_graph\r\n    process_stale_scc(graph, scc, manager)\r\n  File \"/home/pranav/.local/lib/python3.8/site-packages/mypy/build.py\", line 3141, in process_stale_scc\r\n    graph[id].type_check_first_pass()\r\n  File \"/home/pranav/.local/lib/python3.8/site-packages/mypy/build.py\", line 2177, in type_check_first_pass\r\n    self.type_checker().check_first_pass()\r\n  File \"/home/pranav/.local/lib/python3.8/site-packages/mypy/checker.py\", line 315, in check_first_pass\r\n    self.accept(d)\r\n  File \"/home/pranav/.local/lib/python3.8/site-packages/mypy/checker.py\", line 421, in accept\r\n    stmt.accept(self)\r\n  File \"/home/pranav/.local/lib/python3.8/site-packages/mypy/nodes.py\", line 555, in accept\r\n    return visitor.visit_overloaded_func_def(self)\r\n  File \"/home/pranav/.local/lib/python3.8/site-packages/mypy/checker.py\", line 454, in visit_overloaded_func_def\r\n    self._visit_overloaded_func_def(defn)\r\n  File \"/home/pranav/.local/lib/python3.8/site-packages/mypy/checker.py\", line 481, in _visit_overloaded_func_def\r\n    self.check_overlapping_overloads(defn)\r\n  File \"/home/pranav/.local/lib/python3.8/site-packages/mypy/checker.py\", line 509, in check_overlapping_overloads\r\n    assert isinstance(inner_type, CallableType)\r\nAssertionError: \r\nrun.py:10: : note: use --pdb to drop into pdb\r\n```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/980784582/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"pranavrajpal","id":78008260,"node_id":"MDQ6VXNlcjc4MDA4MjYw","avatar_url":"https://avatars.githubusercontent.com/u/78008260?v=4","gravatar_id":"","url":"https://api.github.com/users/pranavrajpal","html_url":"https://github.com/pranavrajpal","followers_url":"https://api.github.com/users/pranavrajpal/followers","following_url":"https://api.github.com/users/pranavrajpal/following{/othe