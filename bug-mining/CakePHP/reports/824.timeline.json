wing{/other_user}","gists_url":"https://api.github.com/users/markstory/gists{/gist_id}","starred_url":"https://api.github.com/users/markstory/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/markstory/subscriptions","organizations_url":"https://api.github.com/users/markstory/orgs","repos_url":"https://api.github.com/users/markstory/repos","events_url":"https://api.github.com/users/markstory/events{/privacy}","received_events_url":"https://api.github.com/users/markstory/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/248933791","html_url":"https://github.com/cakephp/cakephp/issues/9496#issuecomment-248933791","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/9496","id":248933791,"node_id":"MDEyOklzc3VlQ29tbWVudDI0ODkzMzc5MQ==","user":{"login":"ndm2","id":5031606,"node_id":"MDQ6VXNlcjUwMzE2MDY=","avatar_url":"https://avatars.githubusercontent.com/u/5031606?v=4","gravatar_id":"","url":"https://api.github.com/users/ndm2","html_url":"https://github.com/ndm2","followers_url":"https://api.github.com/users/ndm2/followers","following_url":"https://api.github.com/users/ndm2/following{/other_user}","gists_url":"https://api.github.com/users/ndm2/gists{/gist_id}","starred_url":"https://api.github.com/users/ndm2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ndm2/subscriptions","organizations_url":"https://api.github.com/users/ndm2/orgs","repos_url":"https://api.github.com/users/ndm2/repos","events_url":"https://api.github.com/users/ndm2/events{/privacy}","received_events_url":"https://api.github.com/users/ndm2/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-09-22T15:15:01Z","updated_at":"2016-09-22T15:15:01Z","body":"For applications that are using the new middleware stack that would probably be a good place.\n\nBut as long as the stack isn't mandatory and dispatcher filters are only deprecated, backwards compatibility would be nice to have, ie the exception renderer will probably have to be kept involved in one way or another for the time being.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/248933791/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ndm2","id":5031606,"node_id":"MDQ6VXNlcjUwMzE2MDY=","avatar_url":"https://avatars.githubusercontent.com/u/5031606?v=4","gravatar_id":"","url":"https://api.github.com/users/ndm2","html_url":"https://github.com/ndm2","followers_url":"https://api.github.com/users/ndm2/followers","following_url":"https://api.github.com/users/ndm2/following{/other_user}","gists_url":"https://api.github.com/users/ndm2/gists{/gist_id}","starred_url":"https://api.github.com/users/ndm2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ndm2/subscriptions","organizations_url":"https://api.github.com/users/ndm2/orgs","repos_url":"https://api.github.com/users/ndm2/repos","events_url":"https://api.github.com/users/ndm2/events{/privacy}","received_events_url":"https://api.github.com/users/ndm2/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/249081506","html_url":"https://github.com/cakephp/cakephp/issues/9496#issuecomment-249081506","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/9496","id":249081506,"node_id":"MDEyOklzc3VlQ29tbWVudDI0OTA4MTUwNg==","user":{"login":"markstory","id":24086,"node_id":"MDQ6VXNlcjI0MDg2","avatar_url":"https://avatars.githubusercontent.com/u/24086?v=4","gravatar_id":"","url":"https://api.github.com/users/markstory","html_url":"https://github.com/markstory","followers_url":"https://api.github.com/users/markstory/followers","following_url":"https://api.github.com/users/markstory/following{/other_user}","gists_url":"https://api.github.com/users/markstory/gists{/gist_id}","starred_url":"https://api.github.com/users/markstory/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/markstory/subscriptions","organizations_url":"https://api.github.com/users/markstory/orgs","repos_url":"https://api.github.com/users/markstory/repos","events_url":"https://api.github.com/users/markstory/events{/privacy}","received_events_url":"https://api.github.com/users/markstory/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-09-23T01:56:49Z","updated_at":"2016-09-23T01:56:49Z","body":"The Middleware stack is optional. Looking at ExceptionRenderer::_shutdown() the event dispatch is still present and in use. So I'm a bit confused as to how the event is not working anymore.\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/249081506/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"markstory","id":24086,"node_id":"MDQ6VXNlcjI0MDg2","avatar_url":"https://avatars.githubusercontent.com/u/24086?v=4","gravatar_id":"","url":"https://api.github.com/users/markstory","html_url":"https://github.com/markstory","followers_url":"https://api.github.com/users/markstory/followers","following_url":"https://api.github.com/users/markstory/following{/other_user}","gists_url":"https://api.github.com/users/markstory/gists{/gist_id}","starred_url":"https://api.github.com/users/markstory/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/markstory/subscriptions","organizations_url":"https://api.github.com/users/markstory/orgs","repos_url":"https://api.github.com/users/markstory/repos","events_url":"https://api.github.com/users/markstory/events{/privacy}","received_events_url":"https://api.github.com/users/markstory/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/249084474","html_url":"https://github.com/cakephp/cakephp/issues/9496#issuecomment-249084474","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/9496","id":249084474,"node_id":"MDEyOklzc3VlQ29tbWVudDI0OTA4NDQ3NA==","user":{"login":"ndm2","id":5031606,"node_id":"MDQ6VXNlcjUwMzE2MDY=","avatar_url":"https://avatars.githubusercontent.com/u/5031606?v=4","gravatar_id":"","url":"https://api.github.com/users/ndm2","html_url":"https://github.com/ndm2","followers_url":"https://api.github.com/users/ndm2/followers","following_url":"https://api.github.com/users/ndm2/following{/other_user}","gists_url":"https://api.github.com/users/ndm2/gists{/gist_id}","starred_url":"https://api.github.com/users/ndm2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ndm2/subscriptions","organizations_url":"https://api.github.com/users/ndm2/orgs","repos_url":"https://api.github.com/users/ndm2/repos","events_url":"https://api.github.com/users/ndm2/events{/privacy}","received_events_url":"https://api.github.com/users/ndm2/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-09-23T02:14:04Z","updated_at":"2016-09-23T02:17:42Z","body":"Correct, the problem isn't that the exception renderer wouldn't  dispatch the event anymore, it still is doing that, the problem is that the filters/listeners do not get subscribed until `Dispatcher::dispatch()` is being invoked, which the exception render will of course not do.\n\nPreviously the filters/listeners have been registered in `Dispatcher::addFilter()`, so whenever an instance of `Dispatcher` has been created via `DispatcherFactory::create()`, the filters where subscribed as listeners, since the factory adds all the statically registered filters:\n- https://github.com/cakephp/cakephp/blob/3.2.14/src/Routing/DispatcherFactory.php#L85\n- https://github.com/cakephp/cakephp/blob/3.2.14/src/Routing/Dispatcher.php#L146\n\nSo dispatching the event on `$dispatcher` in the exception renderer invoked the filters/listeners properly.\n\nWith the action dispatcher introduced, `Dispatcher::addFilter()` does not subscribe the filters/listeners anymore, instead they are being subscribed in `ActionDispatcher::addFilter()`, and while the `ActionDispatcher` instance used by the `Dispatcher` class gets the `Dispatcher` instances event manager passed to it to subscribe the filters on, all this only happens when `Dispatcher::dispatch()` is being invoked.\n- https://github.com/cakephp/cakephp/blob/3.3.3/src/Routing/Dispatcher.php#L78\n- https://github.com/cakephp/cakephp/blob/3.3.3/src/Http/ActionDispatcher.php#L64\n- https://github.com/cakephp/cakephp/blob/3.3.3/src/Http/ActionDispatcher.php#L155\n- https://github.com/cakephp/cakephp/blob/3.3.3/src/Routing/Dispatcher.php#L59\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/249084474/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ndm2","id":5031606,"node_id":"MDQ6VXNlcjUwMzE2MDY=","avatar_url":"https://avatars.githubusercontent.com/u/5031606?v=4","gravatar_id":"","url":"https://api.github.com/users/ndm2","html_url":"https://github.com/ndm2","followers_url":"https://api.github.com/users/ndm2/followers","following_url":"https://api.github.com/users/ndm2/following{/other_user}","gists_url":"https://api.github.com/users/ndm2/gists{/gist_id}","starred_url":"https://api.github.com/users/ndm2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ndm2/subscriptions","organizations_url":"https://api.github.com/users/ndm2/orgs","repos_url":"https://api.github.com/users/ndm2/repos","events_url":"https://api.github.com/users/ndm2/events{/priva