":["cakephp","form-builder","hacktoberfest","mvc","mvc-framework","orm","php","psr-7","rapid-development","rest-api","validation","web","web-framework"],"visibility":"public","forks":3388,"open_issues":18,"watchers":8780,"default_branch":"5.x","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"This is a:\r\n\r\n* [x] bug\r\n* [ ] enhancement\r\n* [ ] feature-discussion (RFC)\r\n\r\n* CakePHP Version: 3.7.2.\r\n\r\n### What I did\r\n\r\n    echo $this->Form->create(null, array(\r\n        'type' => 'POST',\r\n        'url' => '/my/url',\r\n    )).PHP_EOL;\r\n    foreach (range(0, 9) as $i) :\r\n        echo $this->Form->input('gid.', [\r\n            'name' => 'gid[]',\r\n            'type' => 'hidden',\r\n            'value' => $i,\r\n        ]);\r\n    endforeach;\r\n    echo $this->Form->end();\r\n\r\n### What happened\r\n\r\n    <form method=\"post\" accept-charset=\"utf-8\" role=\"form\" action=\"/my/url\">\r\n        <div style=\"display:none;\">\r\n            <input type=\"hidden\" name=\"_method\" value=\"POST\"/>\r\n            <input type=\"hidden\" name=\"_csrfToken\" autocomplete=\"off\" value=\"6748..90c6\"/>\r\n        </div>\r\n        <input type=\"hidden\" name=\"gid[]\" id=\"gid\" value=\"0\"/>\r\n        <input type=\"hidden\" name=\"gid[]\" id=\"gid\" value=\"1\"/>\r\n        <input type=\"hidden\" name=\"gid[]\" id=\"gid\" value=\"2\"/>\r\n        <input type=\"hidden\" name=\"gid[]\" id=\"gid\" value=\"3\"/>\r\n        <input type=\"hidden\" name=\"gid[]\" id=\"gid\" value=\"4\"/>\r\n        <input type=\"hidden\" name=\"gid[]\" id=\"gid\" value=\"5\"/>\r\n        <input type=\"hidden\" name=\"gid[]\" id=\"gid\" value=\"6\"/>\r\n        <input type=\"hidden\" name=\"gid[]\" id=\"gid\" value=\"7\"/>\r\n        <input type=\"hidden\" name=\"gid[]\" id=\"gid\" value=\"8\"/>\r\n        <input type=\"hidden\" name=\"gid[]\" id=\"gid\" value=\"9\"/>\r\n        <div style=\"display:none;\">\r\n            <input type=\"hidden\" name=\"_Token[fields]\" autocomplete=\"off\" value=\"e7ecb..4c6e%3Agid\"/>\r\n            <input type=\"hidden\" name=\"_Token[unlocked]\" autocomplete=\"off\" value=\"\"/>\r\n            <input type=\"hidden\" name=\"_Token[debug]\" autocomplete=\"off\" value=\"%5B%22%5C%2Fmy%5C%2Furl%22%2C%7B%22gid%22%3A%229%22%7D%2C%5B%5D%5D\"/>\r\n        </div>\r\n    </form>\r\n\r\nAfter submitting:\r\n\r\n> Notice (8): Undefined index: gid [CORE/src/Controller/Component/SecurityComponent.php, line 458]\r\n> Tampered field 'gid' in POST data (expected value '9' but found '')\r\n\r\nNote how `_Token[debug]` is set to `[\"\\/my\\/url\",{\"gid\":\"9\"},[]]`.\r\n\r\n### What else I tried\r\n\r\n    // …\r\n    echo $this->Form->input('gid.', [\r\n        'name' => 'gid[]',\r\n        'type' => 'text', // ← changed from 'hidden' to 'text'\r\n        'value' => $i,\r\n    ]);\r\n    // …\r\n\r\n### What I expected to happen\r\nExpected `debug($this->request->getData())` to output below for hidden inputs as well. Currently it works with text inputs only.\r\n\r\n    [\r\n    \t'gid' => [\r\n    \t\t(int) 0 => '0',\r\n    \t\t(int) 1 => '1',\r\n    \t\t(int) 2 => '2',\r\n    \t\t(int) 3 => '3',\r\n    \t\t(int) 4 => '4',\r\n    \t\t(int) 5 => '5',\r\n    \t\t(int) 6 => '6',\r\n    \t\t(int) 7 => '7',\r\n    \t\t(int) 8 => '8',\r\n    \t\t(int) 9 => '9'\r\n    \t]\r\n    ]\r\n\r\nMay be related: #8170","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/12912/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/cakephp/cakephp/issues/12912/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]