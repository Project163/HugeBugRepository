ub.com/users/aplr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aplr/subscriptions","organizations_url":"https://api.github.com/users/aplr/orgs","repos_url":"https://api.github.com/users/aplr/repos","events_url":"https://api.github.com/users/aplr/events{/privacy}","received_events_url":"https://api.github.com/users/aplr/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-03-16T14:48:32Z","updated_at":"2023-03-16T15:39:13Z","body":"I'm also experiencing this, not only for graphql requests but for dynamic `fetch` in general. That's even happening for `POST` requests, which should not be cached at all according to the docs. Using `const dynamic = \"force-dynamic\"` in all of the segments.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1472124890/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"event":"commented","actor":{"login":"aplr","id":1051396,"node_id":"MDQ6VXNlcjEwNTEzOTY=","avatar_url":"https://avatars.githubusercontent.com/u/1051396?v=4","gravatar_id":"","url":"https://api.github.com/users/aplr","html_url":"https://github.com/aplr","followers_url":"https://api.github.com/users/aplr/followers","following_url":"https://api.github.com/users/aplr/following{/other_user}","gists_url":"https://api.github.com/users/aplr/gists{/gist_id}","starred_url":"https://api.github.com/users/aplr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aplr/subscriptions","organizations_url":"https://api.github.com/users/aplr/orgs","repos_url":"https://api.github.com/users/aplr/repos","events_url":"https://api.github.com/users/aplr/events{/privacy}","received_events_url":"https://api.github.com/users/aplr/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1472132805","html_url":"https://github.com/vercel/next.js/issues/47033#issuecomment-1472132805","issue_url":"https://api.github.com/repos/vercel/next.js/issues/47033","id":1472132805,"node_id":"IC_kwDOBC3Cis5XvvbF","user":{"login":"codinsonn","id":5967956,"node_id":"MDQ6VXNlcjU5Njc5NTY=","avatar_url":"https://avatars.githubusercontent.com/u/5967956?v=4","gravatar_id":"","url":"https://api.github.com/users/codinsonn","html_url":"https://github.com/codinsonn","followers_url":"https://api.github.com/users/codinsonn/followers","following_url":"https://api.github.com/users/codinsonn/following{/other_user}","gists_url":"https://api.github.com/users/codinsonn/gists{/gist_id}","starred_url":"https://api.github.com/users/codinsonn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/codinsonn/subscriptions","organizations_url":"https://api.github.com/users/codinsonn/orgs","repos_url":"https://api.github.com/users/codinsonn/repos","events_url":"https://api.github.com/users/codinsonn/events{/privacy}","received_events_url":"https://api.github.com/users/codinsonn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-03-16T14:53:16Z","updated_at":"2023-03-16T18:57:52Z","body":"Likely experiencing a similar issue. Any `dynamic: 'force-static' | 'force-dynamic'` settings seem to be completely ignored, and during builds (which do \"succeed\") it always defaults back to static rendering of an empty page with a \"next__error\" class on the body.\r\n\r\nYet no build errors are spotted.\r\nEven adding an Error Boundary did not reveal anything new, which is strange. Then where does the error occur?\r\n\r\nRunning things locally in dev mode, it all still works and the page SSRs like it's supposed to.\r\n\r\nI'll see if I can create an issue for it on my own repo that I can link here for more info ⏳ ","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1472132805/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"codinsonn","id":5967956,"node_id":"MDQ6VXNlcjU5Njc5NTY=","avatar_url":"https://avatars.githubusercontent.com/u/5967956?v=4","gravatar_id":"","url":"https://api.github.com/users/codinsonn","html_url":"https://github.com/codinsonn","followers_url":"https://api.github.com/users/codinsonn/followers","following_url":"https://api.github.com/users/codinsonn/following{/other_user}","gists_url":"https://api.github.com/users/codinsonn/gists{/gist_id}","starred_url":"https://api.github.com/users/codinsonn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/codinsonn/subscriptions","organizations_url":"https://api.github.com/users/codinsonn/orgs","repos_url":"https://api.github.com/users/codinsonn/repos","events_url":"https://api.github.com/users/codinsonn/events{/privacy}","received_events_url":"https://api.github.com/users/codinsonn/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1472163500","html_url":"https://github.com/vercel/next.js/issues/47033#issuecomment-1472163500","issue_url":"https://api.github.com/repos/vercel/next.js/issues/47033","id":1472163500,"node_id":"IC_kwDOBC3Cis5Xv26s","user":{"login":"aplr","id":1051396,"node_id":"MDQ6VXNlcjEwNTEzOTY=","avatar_url":"https://avatars.githubusercontent.com/u/1051396?v=4","gravatar_id":"","url":"https://api.github.com/users/aplr","html_url":"https://github.com/aplr","followers_url":"https://api.github.com/users/aplr/followers","following_url":"https://api.github.com/users/aplr/following{/other_user}","gists_url":"https://api.github.com/users/aplr/gists{/gist_id}","starred_url":"https://api.github.com/users/aplr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aplr/subscriptions","organizations_url":"https://api.github.com/users/aplr/orgs","repos_url":"https://api.github.com/users/aplr/repos","events_url":"https://api.github.com/users/aplr/events{/privacy}","received_events_url":"https://api.github.com/users/aplr/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-03-16T15:08:01Z","updated_at":"2023-03-16T17:28:01Z","body":"It's happening since 13.2.4 for me. I reverted back to 13.2.3 for now, everything started working again.\r\n\r\nFor me, it cached requests for days, even across redeploys. That's bad in particular for requests which contain errors (as graphql returns `200`s even if there are errors). And it seems it considers all requests on a segment as static. And when all of them are considered static, the whole page is, which caused dynamic pages not updating for days.\r\n\r\n### Edit 1\r\n\r\nI've been able to narrow down the version the issue was introduced to `13.2.4-canary.5`. When looking at [the diff](https://github.com/vercel/next.js/compare/v13.2.4-canary.4...v13.2.4-canary.5), the handling of the `revalidation` setting on segment level was changed, as well as the [`fetch` patch](https://github.com/vercel/next.js/compare/v13.2.4-canary.4...v13.2.4-canary.5#diff-4c54e369ddb9a2db1eed95fe1d678f94c8e82c540204475d42c78e49bf4f223a). Probably it has sth to do with that.\r\n\r\nFrom what I've experienced, I saw my `POST` request's responses cached in the `.next/cache/fetch-cache` folder, with a `revalidate` value of `31536000` (1 year). The fetch-cache entries are generated on build-time.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1472163500/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"aplr","id":1051396,"node_id":"MDQ6VXNlcjEwNTEzOTY=","avatar_url":"https://avatars.githubusercontent.com/u/1051396?v=4","gravatar_id":"","url":"htt