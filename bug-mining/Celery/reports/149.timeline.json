hive_format}{/ref}","downloads_url":"https://api.github.com/repos/celery/celery/downloads","issues_url":"https://api.github.com/repos/celery/celery/issues{/number}","pulls_url":"https://api.github.com/repos/celery/celery/pulls{/number}","milestones_url":"https://api.github.com/repos/celery/celery/milestones{/number}","notifications_url":"https://api.github.com/repos/celery/celery/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/celery/celery/labels{/name}","releases_url":"https://api.github.com/repos/celery/celery/releases{/id}","deployments_url":"https://api.github.com/repos/celery/celery/deployments","created_at":"2009-04-24T11:31:24Z","updated_at":"2026-03-11T11:08:53Z","pushed_at":"2026-03-10T15:04:28Z","git_url":"git://github.com/celery/celery.git","ssh_url":"git@github.com:celery/celery.git","clone_url":"https://github.com/celery/celery.git","svn_url":"https://github.com/celery/celery","homepage":"https://docs.celeryq.dev","size":36397,"stargazers_count":28268,"watchers_count":28268,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":4989,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":773,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["amqp","python","python-library","python3","queue-tasks","queue-workers","queued-jobs","redis","redis-queue","sqs","sqs-queue","task-manager","task-runner","task-scheduler"],"visibility":"public","forks":4989,"open_issues":773,"watchers":28268,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/celery/celery/pulls/8351","html_url":"https://github.com/celery/celery/pull/8351","diff_url":"https://github.com/celery/celery/pull/8351.diff","patch_url":"https://github.com/celery/celery/pull/8351.patch","merged_at":"2023-07-29T04:11:10Z"},"body":"The AQL queries used in the ArangoDbBackend's implementation are potentially\r\nvulnerable to injections because no sanity checks are performed on the\r\narguments used to build the query strings.\r\n\r\nThis is particularly evident when using a database collection with a dash in\r\nits name, e.g. \"celery-task-results\". The query string generated by the set\r\nmethod is 'INSERT {task: v}, _key: \"k\"} INTO celery-task-results' instead of\r\n'INSERT {task: v}, _key: \"k\"} INTO `celery-task-results`' (backticks\r\nsurrounding collection name). The former is evaluated as a substraction\r\n(celery - task - results) and is therefore an illegal collection name,\r\nwhile the latter is evaluated as a string.\r\n\r\nThis commit re-implements the setter and getters using bind parameters,\r\nwhich performs the necessary safety checks. Furthermore, the new query used\r\nin the set method accounts for updates to existing keys, resolving https://github.com/celery/celery/issues/7039.\r\n","reactions":{"url":"https://api.github.com/repos/celery/celery/issues/8351/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/celery/celery/issues/8351/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":9906021480,"node_id":"REFE_lADOAALQjM4-LlSLzwAAAAJOceRo","url":"https://api.github.com/repos/celery/celery/issues/events/9906021480","actor":{"login":"othieno","id":1661621,"node_id":"MDQ6VXNlcjE2NjE2MjE=","avatar_url":"https://avatars.githubusercontent.com/u/1661621?v=4","gravatar_id":"","url":"https://api.github.com/users/othieno","html_url":"https://github.com/othieno","followers_url":"https://api.github.com/users/othieno/followers","following_url":"https://api.github.