i.github.com/users/joseph-gio/following{/other_user}","gists_url":"https://api.github.com/users/joseph-gio/gists{/gist_id}","starred_url":"https://api.github.com/users/joseph-gio/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joseph-gio/subscriptions","organizations_url":"https://api.github.com/users/joseph-gio/orgs","repos_url":"https://api.github.com/users/joseph-gio/repos","events_url":"https://api.github.com/users/joseph-gio/events{/privacy}","received_events_url":"https://api.github.com/users/joseph-gio/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1067196899","html_url":"https://github.com/bevyengine/bevy/issues/4200#issuecomment-1067196899","issue_url":"https://api.github.com/repos/bevyengine/bevy/issues/4200","id":1067196899,"node_id":"IC_kwDODf6-U84_nCHj","user":{"login":"kirusfg","id":32136879,"node_id":"MDQ6VXNlcjMyMTM2ODc5","avatar_url":"https://avatars.githubusercontent.com/u/32136879?v=4","gravatar_id":"","url":"https://api.github.com/users/kirusfg","html_url":"https://github.com/kirusfg","followers_url":"https://api.github.com/users/kirusfg/followers","following_url":"https://api.github.com/users/kirusfg/following{/other_user}","gists_url":"https://api.github.com/users/kirusfg/gists{/gist_id}","starred_url":"https://api.github.com/users/kirusfg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kirusfg/subscriptions","organizations_url":"https://api.github.com/users/kirusfg/orgs","repos_url":"https://api.github.com/users/kirusfg/repos","events_url":"https://api.github.com/users/kirusfg/events{/privacy}","received_events_url":"https://api.github.com/users/kirusfg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-03-14T19:19:53Z","updated_at":"2022-03-14T19:19:53Z","body":"> minimal example to reproduce\r\n\r\nYesterday I came up with one and was hoping to solve the issue with some slight change to the `SystemParam` derive macro, but apparently I did not quite get what your desired outcome is (it was late into the night, forgive me). \r\n\r\nAfter looking at your example today, now I understand it and think of it as a legitimate feature to request.\r\n\r\nI believe this can be achieved by introducing, say, a new `Private` filter for `Query` (akin to `With`, `Or`, and the likes); I am not well-experienced with Bevy's ECS though...\r\n\r\nThis only means that implementing this will take a while, if someone else does not do it before me :)","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1067196899/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"kirusfg","id":32136879,"node_id":"MDQ6VXNlcjMyMTM2ODc5","avatar_url":"https://avatars.githubusercontent.com/u/32136879?v=4","gravatar_id":"","url":"https://api.github.com/users/kirusfg","html_url":"https://github.com/kirusfg","followers_url":"https://api.github.com/users/kirusfg/followers","following_url":"https://api.github.com/users/kirusfg/following{/other_user}","gists_url":"https://api.github.com/users/kirusfg/gists{/gist_id}","starred_url":"https://api.github.com/users/kirusfg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kirusfg/subscriptions","organizations_url":"https://api.github.com/users/kirusfg/orgs","repos_url":"https://api.github.com/users/kirusfg/repos","events_url":"https://api.github.com/users/kirusfg/events{/privacy}","received_events_url":"https://api.github.com/users/kirusfg/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1067200019","html_url":"https://github.com/bevyengine/bevy/issues/4200#issuecomment-1067200019","issue_url":"https://api.github.com/repos/bevyengine/bevy/issues/4200","id":1067200019,"node_id":"IC_kwDODf6-U84_nC4T","user":{"login":"kirusfg","id":32136879,"node_id":"MDQ6VXNlcjMyMTM2ODc5","avatar_url":"https://avatars.githubusercontent.com/u/32136879?v=4","gravatar_id":"","url":"https://api.github.com/users/kirusfg","html_url":"https://github.com/kirusfg","followers_url":"https://api.github.com/users/kirusfg/followers","following_url":"https://api.github.com/users/kirusfg/following{/other_user}","gists_url":"https://api.github.com/users/kirusfg/gists{/gist_id}","starred_url":"https://api.github.com/users/kirusfg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kirusfg/subscriptions","organizations_url":"https://api.github.com/users/kirusfg/orgs","repos_url":"https://api.github.com/users/kirusfg/repos","events_url":"https://api.github.com/users/kirusfg/events{/privacy}","received_events_url":"https://api.github.com/users/kirusfg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-03-14T19:23:27Z","updated_at":"2022-03-14T19:23:27Z","body":"Yet again, I am not even sure that such a filter is feasible.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1067200019/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"kirusfg","id":32136879,"node_id":"MDQ6VXNlcjMyMTM2ODc5","avatar_url":"https://avatars.githubusercontent.com/u/32136879?v=4","gravatar_id":"","url":"https://api.github.com/users/kirusfg","html_url":"https://github.com/kirusfg","followers_url":"https://api.github.com/users/kirusfg/followers","following_url":"https://api.github.com/users/kirusfg/following{/other_user}","gists_url":"https://api.github.com/users/kirusfg/gists{/gist_id}","starred_url":"https://api.github.com/users/kirusfg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kirusfg/subscriptions","organizations_url":"https://api.github.com/users/kirusfg/orgs","repos_url":"https://api.github.com/users/kirusfg/repos","events_url":"https://api.github.com/users/kirusfg/events{/privacy}","received_events_url":"https://api.github.com/users/kirusfg/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1067420171","html_url":"https://github.com/bevyengine/bevy/issues/4200#issuecomment-1067420171","issue_url":"https://api.github.com/repos/bevyengine/bevy/issues/4200","id":1067420171,"node_id":"IC_kwDODf6-U84_n4oL","user":{"login":"joseph-gio","id":21144246,"node_id":"MDQ6VXNlcjIxMTQ0MjQ2","avatar_url":"https://avatars.githubusercontent.com/u/21144246?v=4","gravatar_id":"","url":"https://api.github.com/users/joseph-gio","html_url":"https://github.com/joseph-gio","followers_url":"https://api.github.com/users/joseph-gio/followers","following_url":"https://api.github.com/users/joseph-gio/following{/other_user}","gists_url":"https://api.github.com/users/joseph-gio/gists{/gist_id}","starred_url":"https://api.github.com/users/joseph-gio/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joseph-gio/subscriptions","organizations_url":"https://api.github.com/users/joseph-gio/orgs","repos_url":"https://api.github.com/users/joseph-gio/repos","events_url":"https://api.github.com/users/joseph-gio/events{/privacy}","received_events_url":"https://api.github.com/users/joseph-gio/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-03-14T23:51:50Z","updated_at":"2022-03-14T23:51:50Z","body":"So I've tried looking at the generated code using `cargo-expand`, and it appears my original theory was incorrect. The culprit is this impl, which exposes the private fields via an associated type:\r\n\r\n```rust\r\nimpl<'w, 's> bevy::ecs::system::SystemParam for OpaqueParams<'w, 's> {\r\n    type Fetch = OpaqueParamsState<(\r\n        <Query<'w, 's, Read<Private>> as bevy::ecs::system::SystemParam>::Fetch,\r\n    )>;\r\n}\r\n```\r\n\r\nI think a fairly easy fix would be to just use an opaque type for `SystemParam::Fetch`. I wrote up an example here:\r\n\r\n```rust\r\n#[doc(hidden)]\r\npub type OpaqueFetch = impl for<'w, 's> SystemParamFetch<'w, 's>;\r\n// the purpose of this entire module is just to fulfill the \"defining scope\"\r\n// for the above opaque type.\r\n// We simply define a function that never gets called in order to clue the compiler\r\n// in on what the concrete type of `OpaqueFetch` is.\r\nmod define {\r\n    use super::*;\r\n    #[allow(unreachable_code)]\r\n    #[allow(unused)]\r\n    fn dummy<'w, 's>() -> OpaqueFetch {\r\n        use bevy::ecs::system::SystemParamState as _;\r\n        <OpaqueParamsState<\r\n            (<Query<'w, 's, Read<Private>> as bevy::ecs::system::SystemParam>::Fetch,),\r\n        >>::init(unreachable!(), unreachable!(), unreachable!())\r\n    }\r\n}\r\nimpl<'w, 's> bevy::ecs::system::SystemParam for OpaqueParams<'w, 's> {\r\n    type Fetch = OpaqueFetch;\r\n}\r\n```\r\n\r\nThis *almost* works, but fails when I try to actually use it as a SystemParam due to some inscrutable type errors involving `IntoSystem`\r\n\r\n```\r\nerror[E0277]: the trait bound `for<'r, 's> fn(OpaqueParams<'r, 's>) {print_stuff}: IntoSystem<(), (), _>` is not satisfied\r\n   --> src\\main.rs:10:21\r\n    |\r\n10  |         .add_system(print_stuff)\r\n    |          ---------- ^^^^^^^^^^^ the trait `IntoSystem<(), (), _>` is not implemented for `for<'r, 's> fn(OpaqueParams<'r, 's>) {print_stuff}`\r\n    |          |\r\n    |          required by a bound introduced by this call\r\n    |\r\n    = note: required because of the requirements on the impl of `IntoSystemDescriptor<_>` for `for<'r, 's> fn(OpaqueParams<'r, 's>) {print_stuff}`\r\nnote: required by a bound in `bevy::prelude::App::add_system`\r\n   --> C:\\Users\\joe10\\.cargo\\registry\\src\\github.com-1ecc6299db9ec823\\bevy_app-0.6.0\\src\\app.rs:325:55\r\n    |\r\n325 |     pub fn add_system<Params>(&mut self, system: impl IntoSystemDescriptor<Params>) -> &mut Self {\r\n    |                                                       ^^^^^^^^^^^^^^^^^^^^^^^^^^^^ required by this bound in `bevy::prelude::App::add_system`\r\n\r\nFor more information about this error, try `rustc --explain E0277`.\r\n```\r\n\r\nHopefully that should be fixable by someone who knows more about the inner-workings of bevy. Otherwise, it works perfectly, satisfying type inference without leaking private fields.  \r\nIf anyone wants to play around with it, my fix is on [this branch](https://github.com/JoJoJet/bevy_param_example/tree/impl-trait-fix).\r\n\r\nOf course, none of this is possible yet since `type_alias_impl_trait` is not stable :(","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1067420171/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"joseph-gio","id":21144246,"node_id":"MDQ6VXNlcjIxMTQ0MjQ2","avatar_url":"https://avatars.githubusercontent.com/u/21144246?v=4","gravatar_id":"","url":"https://api.github.com/users/joseph-gio","html_url":"https://github.com/joseph-gio","followers_url":"https://api.github.com/users/joseph-gio/followers","following_url":"https://api.github.com/users/joseph-gio/following{/other_user}","gists_url":"https://api.github.com/users/joseph-gio/gists{/gist_id}","starred_url":"https://api.github.com/users/joseph-gio/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joseph-gio/subscriptions","organizations_url":"https://api.github.com/users/joseph-gio/orgs","repos_url":"https://api.github.com/users/joseph-gio/repos","events_url":"https://api.github.com/users/joseph-gio/events{/privacy}","received_events_url":"https://api.github.com/users/joseph-gio/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1073517720","html_url":"https://github.com/bevyengine/bevy/issues/4200#issuecomment-1073517720","issue_url":"https://api.github.com/repos/bevyengine/bevy/issues/4200","id":1073517720,"node_id":"IC_kwDODf6-U84__JSY","user":{"login":"arialpew","id":15246558,"node_id":"MDQ6VXNlcjE1MjQ2NTU4","avatar_url":"https://avatars.githubusercontent.com/u/15246558?v=4","gravatar_id":"","url":"https://api.github.com/users/arialpew","html_url":"https://github.com/arialpew","followers_url":"https://api.github.com/users/arialpew/followers","following_url":"https://api.github.com/users/arialpew/following{/other_user}","gists_url":"https://api.github.com/users/arialpew/gists{/gist_id}","starred_url":"https://api.github.com/users/arialpew/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arialpew/subscriptions","organizations_url":"https://api.github.com/users/arialpew/orgs","repos_url":"https://api.github.com/users/arialpew/repos","events_url":"https://api.github.com/users/arialpew/events{/privacy}","received_events_url":"https://api.github.com/users/arialpew/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-03-21T06:16:55Z","updated_at":"2022-03-21T06:28:18Z","body":"If you have params, say for a `Local<ShowPopup>`, you expect to have a `ShowPopup` at the end, because `Local<T>`, `Res<T>`, `ResMut<T>`, and so on, are just smart pointer over their T. In your system when you access field on your SystemParam, even if there's many indirection, the end result is a T.\r\n\r\nSo does it make sense to have T private ? If you make T public, that does not mean T fields are public. You can hide all your fields and consumer can only use public method that encapsulate all your logic that you want to expose.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1073517720/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"arialpew","id":15246558,"node_id":"MDQ6VXNlcjE1MjQ2NTU4","avatar_url":"https://avatars.githubusercontent.com/u/15246558?v=4","gravatar_id":"","url":"https://api.github.com/users/arialpew","html_url":"https://github.com/arialpew","followers_url":"https://api.github.com/users/arialpew/followers","following_url":"https://api.github.com/users/arialpew/following{/other_user}","gists_url":"https://api.github.com/users/arialpew/gists{/gist_id}","starred_url":"https://api.github.com/users/arialpew/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arialpew/subscriptions","organizations_url":"https://api.github.com/users/arialpew/orgs","repos_url":"https://api.github.com/users/arialpew/repos","events_url":"https://api.github.com/users/arialpew/events{/privacy}","received_events_url":"https://api.github.com/users/arialpew/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1074014122","html_url":"https://github.com/bevyengine/bevy/issues/4200#issuecomment-1074014122","issue_url":"https://api.github.com/repos/bevyengine/bevy/issues/4200","id":1074014122,"node_id":"IC_kwDODf6-U85ABCeq","user":{"login":"Guvante","id":7098608,"node_id":"MDQ6VXNlcjcwOTg2MDg=","avatar_url":"https://avatars.githubusercontent.com/u/7098608?v=4","gravatar_id":"","url":"https://api.github.com/users/Guvante","html_url":"https://github.com/Guvante","followers_url":"https://api.github.com/users/Guvante/followers","following_url":"https://api.github.com/users/Guvante/following{/other_user}","gists_url":"https://api.github.com/users/Guvante/gists{/gist_id}","starred_url":"https://api.github.com/users/Guvante/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Guvante/subscriptions","organizations_url":"https://api.github.com/users/Guvante/orgs","repos_url":"https://api.github.com/users/Guvante/repos","events_url":"https://api.github.com/users/Guvante/events{/privacy}","received_events_url":"https://api.github.com/users/Guvante/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-03-21T15:06:15Z","updated_at":"2022-03-21T15:06:15Z","body":"`IntoSystem` requires that the `Param` is `'static` which `pub type OpaqueFetch = impl for<'w, 's> SystemParamFetch<'w, 's>;` doesn't specify. I haven't played around with `type_alias_impl_trait` so don't know if this is a fixable problem (I assume it would be).\r\n\r\nUnfortunately though I don't know if this would be enough to solve your problem as `<<OpaqueParams as SystemParam>::Fetch as SystemParamFetch<'_, '_>>::Item == Private` and that means anyone who has `OpaqueParams` can name `Private` now.\r\n\r\nWhether this is a problem depends on exactly the intent of the privacy system.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1074014122/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Guvante","id":7098608,"node_id":"MDQ6VXNlcjcwOTg2MDg=","avatar_url":"https://avatars.githubusercontent.com/u/7098608?v=4","gravatar_id":"","url":"https://api.github.com/users/Guvante","html_url":"https://github.com/Guvante","followers_url":"https://api.github.com/users/Guvante/followers","following_url":"https://api.github.com/users/Guvante/following{/other_user}","gists_url":"https://api.github.com/users/Guvante/gists{/gist_id}","starred_url":"https://api.github.com/users/Guvante/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Guvante/subscriptions","organizations_url":"https://api.github.com/users/Guvante/orgs","re