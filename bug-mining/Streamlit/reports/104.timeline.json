":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":3962,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1304,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["data-analysis","data-science","data-visualization","deep-learning","developer-tools","machine-learning","python","streamlit"],"visibility":"public","forks":3962,"open_issues":1304,"watchers":42660,"default_branch":"develop","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/streamlit/streamlit/pulls/828","html_url":"https://github.com/streamlit/streamlit/pull/828","diff_url":"https://github.com/streamlit/streamlit/pull/828.diff","patch_url":"https://github.com/streamlit/streamlit/pull/828.patch","merged_at":"2019-12-11T17:00:49Z"},"body":"If `s3.url` is set in the user's config, ensure that it's an absolute URL.\r\n\r\nAn absolute URL starts with either `scheme://` or `//` -- if the configured URL does not start with either prefix, prepend it with `//` to make it absolute. (If we don't do this, and the user enters something like `url=myhost.com/reports`, the browser will assume this is a relative URL, and will prepend the hostname of the Streamlit instance to the configured URL.)\r\n\r\nFixes #802","reactions":{"url":"https://api.github.com/repos/streamlit/streamlit/issues/828/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/streamlit/streamlit/issues/828/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":2875063752,"node_id":"MDExOkNsb3NlZEV2ZW50Mjg3NTA2Mzc1Mg==","url":"https://api.github.com/repos/streamlit/streamlit/issues/eve