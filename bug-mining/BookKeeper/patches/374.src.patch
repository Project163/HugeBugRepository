-            // async dispatch ...
-            if (null != sessionMessageListener) {
-                synchronized (SessionImpl.this.lockObject){
-                    rolledbackMessageList.add(this);
-                    SessionImpl.this.lockObject.notifyAll();
-                }
-            }
