         }
+
+        protected final void clearEpollIn0() {
+            if ((flags & readFlag) != 0) {
+                flags &= ~readFlag;
+                ((EpollEventLoop) eventLoop()).modify(AbstractEpollChannel.this);
+            }
+        }
     }
 }
