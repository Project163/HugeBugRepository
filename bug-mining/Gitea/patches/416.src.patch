-      colomnIndex = 0;
-
-      // a little inline analysis and draw process
-      while (colomnIndex < currentRow.length) {
-        colomn = currentRow[colomnIndex];
-        prevColomn = currentRow[colomnIndex - 1];
-
-        if (currentRow[colomnIndex] === ' ') {
