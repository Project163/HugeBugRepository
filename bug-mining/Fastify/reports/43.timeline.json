e('fastify')({\r\n  logger: true\r\n});\r\n\r\nconst puppeteer = require('puppeteer');\r\n\r\nfastify.get('/', async (request, reply) => {\r\n  reply.type('application/json').code(200)\r\n  \r\n  const browser =   await puppeteer.launch({\r\n    headless: false\r\n  });\r\n\r\n  return { hello: 'world' }\r\n})\r\n\r\nfastify.addHook('onClose', function(instance, done) {\r\n  console.log('server closing....');\r\n});\r\n\r\nprocess.on('SIGINT', () => {\r\n  fastify.close(() => {\r\n     process.exit(0);\r\n  });\r\n});\r\n\r\nfastify.listen({ port: 3000 }, (err, address) => {\r\n  if (err) throw err\r\n  // Server is now listening on ${address}\r\n})\r\n\r\n```\r\n\r\n\r\npm2 start app.js \n\n### Expected Behavior\n\n_No response_","reactions":{"url":"https://api.github.com/repos/fastify/fastify/issues/4772/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/fastify/fastify/issues/4772/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/fastify/fastify/issues/comments/1574746977","html_url":"https://github.com/fastify/fastify/issues/4774#issuecomment-1574746977","issue_url":"https://api.github.com/repos/fastify/fastify/issues/4774","id":1574746977,"node_id":"IC_kwDOBCRpgs5d3Lth","user":{"login":"izedgo","id":1213666,"node_id":"MDQ6VXNlcjEyMTM2NjY=","avatar_url":"https://avatars.githubusercontent.com/u/1213666?v=4","gravatar_id":"","url":"https://api.github.com/users/izedgo","html_url":"https://github.com/izedgo","followers_url":"https://api.github.com/users/izedgo/followers","following_url":"https://api.github.com/users/izedgo/following{/other_user}","gists_url":"https://api.github.com/users/izedgo/gists{/gist_id}","starred_url":"https://api.github.com/users/izedgo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/izedgo/subscriptions","organizations_url":"https:/