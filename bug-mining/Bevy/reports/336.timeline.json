ub.com/users/MrGVSV/subscriptions","organizations_url":"https://api.github.com/users/MrGVSV/orgs","repos_url":"https://api.github.com/users/MrGVSV/repos","events_url":"https://api.github.com/users/MrGVSV/events{/privacy}","received_events_url":"https://api.github.com/users/MrGVSV/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2023-04-17T15:53:07Z","label":{"name":"D-Good-First-Issue","color":"008672"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1511759965","html_url":"https://github.com/bevyengine/bevy/issues/8415#issuecomment-1511759965","issue_url":"https://api.github.com/repos/bevyengine/bevy/issues/8415","id":1511759965,"node_id":"IC_kwDODf6-U85aG6Bd","user":{"login":"InnocentusLime","id":17496400,"node_id":"MDQ6VXNlcjE3NDk2NDAw","avatar_url":"https://avatars.githubusercontent.com/u/17496400?v=4","gravatar_id":"","url":"https://api.github.com/users/InnocentusLime","html_url":"https://github.com/InnocentusLime","followers_url":"https://api.github.com/users/InnocentusLime/followers","following_url":"https://api.github.com/users/InnocentusLime/following{/other_user}","gists_url":"https://api.github.com/users/InnocentusLime/gists{/gist_id}","starred_url":"https://api.github.com/users/InnocentusLime/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/InnocentusLime/subscriptions","organizations_url":"https://api.github.com/users/InnocentusLime/orgs","repos_url":"https://api.github.com/users/InnocentusLime/repos","events_url":"https://api.github.com/users/InnocentusLime/events{/privacy}","received_events_url":"https://api.github.com/users/InnocentusLime/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-04-17T17:07:35Z","updated_at":"2023-04-17T17:08:53Z","body":"> Original message\r\n> \r\n> **Edit:** Seems I'm wrong here. I mistakenly thought `BreakLineOn` was a `Component` (and also forgot how reflection's (de)serialization works for a moment haha).\r\n> \r\n> Still, the solution here is to just register the type in `bevy_text`.\r\n\r\nSo it is expected from the user to register **all** the types their crate uses including the \"nested\" types? I am not an experienced library designer and I don't know the reasoning behind this decision, but tracking down if all types are registered can get difficult quick ☹️ \r\n\r\nI would like to do the fix-PR if that's ok and will check if any other type in `bevy_text` has not been registered.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1511759965/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"InnocentusLime","id":17496400,"node_id":"MDQ6VXNlcjE3NDk2NDAw","avatar_url":"https://avatars.githubusercontent.com/u/17496400?v=4","gravatar_id":"","url":"https://api.github.com/users/InnocentusLime","html_url":"https://github.com/InnocentusLime","followers_url":"https://api.github.com/users/InnocentusLime/followers","following_url":"https://api.github.com/users/InnocentusLime/following{/other_user}","gists_url":"https://api.github.com/users/InnocentusLime/gists{/gist_id}","starred_url":"https://api.github.com/users/InnocentusLime/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/InnocentusLime/subscriptions","organizations_url":"https://api.github.com/users/InnocentusLime/orgs","repos_url":"https://api.github.com/users/InnocentusLime/repos","events_url":"https://api.github.com/users/InnocentusLime/events{/privacy}","received_events_url":"https://api.github.com/users/InnocentusLime/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1511825363","html_url":"https://github.com/bevyengine/bevy/issues/8415#issuecomment-1511825363","issue_url":"https://api.github.com/repos/bevyengine/bevy/issues/8415","id":1511825363,"node_id":"IC_kwDODf6-U85aHJ_T","user":{"login":"MrGVSV","id":49806985,"node_id":"MDQ6VXNlcjQ5ODA2OTg1","avatar_url":"https://avatars.githubusercontent.com/u/49806985?v=4","gravatar_id":"","url":"https://api.github.com/users/MrGVSV","html_url":"https://github.com/MrGVSV","followers_url":"https://api.github.com/users/MrGVSV/followers","following_url":"https://api.github.com/users/MrGVSV/following{/other_user}","gists_url":"https://api.github.com/users/MrGVSV/gists{/gist_id}","starred_url":"https://api.github.com/users/MrGVSV/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MrGVSV/subscriptions","organizations_url":"https://api.github.com/users/MrGVSV/orgs","repos_url":"https://api.github.com/users/MrGVSV/repos","events_url":"https://api.github.com/users/MrGVSV/events{/privacy}","received_events_url":"https://api.github.com/users/MrGVSV/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-04-17T17:50:38Z","updated_at":"2023-04-17T17:50:38Z","body":"> So it is expected from the user to register **all** the types their crate uses including the \"nested\" types? I am not an experienced library designer and I don't know the reasoning behind this decision, but tracking down if all types are registered can get difficult quick ☹️\r\n\r\nYeah that's currently the requirement, and is likely to stay that way until a better solution is found. The main issue is that other crates that \"solve\" this use life-before-main and linker shenanigans to get it to work, which is not something we want to support right now. Mainly due to the fact that we don't build our reflection logic on top of a \"hack\" and we want the engine to be cross-platform (these other solutions break on platforms like WASM).\r\n\r\nAs far as nested types go, there is #5781 which adds the ability to recursively register a type's fields (review very welcome on that PR btw 😉).\r\n\r\n> I would like to do the fix-PR if that's ok and will check if any other type in `bevy_text` has not been registered.\r\n\r\nSounds great, thank you!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1511825363/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"MrGVSV","id":49806985,"node_id":"MDQ6VXNlcjQ5ODA2OTg1","avatar_url":"https://avatars.githubusercontent.com/u/49806985?v=4","gravatar_id":"","url":"https://api.github.com/users/MrGVSV","html_url":"https://github.com/MrGVSV","followers_url":"https://api.github.com/users/MrGVSV/followers","following_url":"https://api.github.com/users/MrGVSV/following{/other_user}","gists_url":"https://api.github.com/users/MrGVSV/gists{/gist_id}","starred_url":"https://api.github.com/users/MrGVSV/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MrGVSV/subscriptions","organizations_url":"https://api.github.com/users/MrGVSV/orgs","repos_url":"https://api.github.com/users/MrGVSV/repos","events_url":"https://api.github.com/users/MrGVSV/events{/privacy}","received_events_url":"https://api.github.com/users/MrGVSV/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1511944913","html_url":"https://github.com/bevyengine/bevy/issues/8415#issuecomment-1511944913","issue_url":"https://api.github.com/repos/bevyengine/bevy/issues/8415","id":1511944913,"node_id":"IC_kwDODf6-U85aHnLR","user":{"login":"InnocentusLime","id":17496400,"node_id":"MDQ6VXNlcjE3NDk2NDAw","avatar_url":"https://avatars.githubusercontent.com/u/17496400?v=4","gravatar_id":"","url":"https://api.github.com/users/InnocentusLime","html_url":"https://github.com/InnocentusLime","followers_url":"htt