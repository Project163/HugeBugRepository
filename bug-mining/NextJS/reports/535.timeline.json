ercontent.com/u/101155892?v=4","gravatar_id":"","url":"https://api.github.com/users/blauakqa","html_url":"https://github.com/blauakqa","followers_url":"https://api.github.com/users/blauakqa/followers","following_url":"https://api.github.com/users/blauakqa/following{/other_user}","gists_url":"https://api.github.com/users/blauakqa/gists{/gist_id}","starred_url":"https://api.github.com/users/blauakqa/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blauakqa/subscriptions","organizations_url":"https://api.github.com/users/blauakqa/orgs","repos_url":"https://api.github.com/users/blauakqa/repos","events_url":"https://api.github.com/users/blauakqa/events{/privacy}","received_events_url":"https://api.github.com/users/blauakqa/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-09-06T08:07:23Z","updated_at":"2023-09-06T08:33:34Z","body":"Thanks William,\r\n \r\nTo clarify are you implying that skipTrailingSlashRedirect property is only for after the user clicks the link?\r\nOriginally thought that but after checking NextJS code we thought it would also preserve the URL as supplied before the users clicks the link. Seeing the behaviour we're seeing the former makes sense\r\n\r\nIf you go to the homepage from the repo, we wish to preserve the URL as is:\r\n- Links that have a trailing slash (link-wish-slash) to render with the trailing slash\r\n- In this case it’s removed (see yellow boxes from the image) but we require it to preserve the original URL\r\nCan also view the homepage for the URL you supplied - https://154699-nextjs-trailing-slash-issue-git-13-4-9.preview.vercel-support.app/\r\n\r\n![image](https://github.com/vercel/next.js/assets/101155892/74ff1b11-8c8e-4b76-92c4-15dc6889b2e9)\r\n\r\nIf that’s not the case, apart from patching the code is there a way to achieve this desired behaviour of preserving the URL?\r\n\r\nCheers,\r\nBen","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1707869028/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"blauakqa","id":101155892,"node_id":"U_kgDOBgeENA","avatar_url":"https://avatars.githubusercontent.com/u/101155892?v=4","gravatar_id":"","url":"https://api.github.com/users/blauakqa","html_url":"https://github.com/blauakqa","followers_url":"https://api.github.com/users/blauakqa/followers","following_url":"https://api.github.com/users/blauakqa/following{/other_user}","gists_url":"https://api.github.com/users/blauakqa/gists{/gist_id}","starred_url":"https://api.github.com/users/blauakqa/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blauakqa/subscriptions","organizations_url":"https://api.github.com/users/blauakqa/orgs","repos_url":"https://api.github.com/users/blauakqa/repos","events_url":"https://api.github.com/users/blauakqa/events{/privacy}","received_events_url":"https://api.github.com/users/blauakqa/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1708154464","html_url":"https://github.com/vercel/next.js/issues/54984#issuecomment-1708154464","issue_url":"https://api.github.com/repos/vercel/next.js/issues/54984","id":1708154464,"node_id":"IC_kwDOBC3Cis5l0F5g","user":{"login":"wiiiimm","id":179761,"node_id":"MDQ6VXNlcjE3OTc2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/179761?v=4","gravatar_id":"","url":"https://api.github.com/users/wiiiimm","html_url":"https://github.com/wiiiimm","followers_url":"https://api.github.com/users/wiiiimm/followers","following_url":"https://api.github.com/users/wiiiimm/following{/other_user}","gists_url":"https://api.github.com/users/wiiiimm/gists{/gist_id}","starred_url":"https://api.github.com/users/wiiiimm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wiiiimm/subscriptions","organizations_url":"https://api.github.com/users/wiiiimm/orgs","repos_url":"https://api.github.com/users/wiiiimm/repos","events_url":"https://api.github.com/users/wiiiimm/events{/privacy}","received_events_url":"https://api.github.com/users/wiiiimm/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-09-06T11:22:08Z","updated_at":"2023-09-06T11:24:04Z","body":"To summarise:\r\n\r\n1. After click on link behaviour is correct\r\n2. Direct URL access behaviour is correct (when an external link ask for `/something` and `/something-else/` with `skipTrailingSlashRedirect` set to true, take visitor to `/something` and `/something-else/` respectively, without redirect)\r\n3. The javascript renderings of links are correct\r\n4. The raw HTML output of links are not correct (ie, if you access the raw HTML using `curl https://154699-nextjs-trailing-slash-issue-git-13-4-9.preview.vercel-support.app/`, the slashes are removed).\r\n\r\n`skipTrailingSlashRedirect` , as its name suggests, only affects the slash-redirecting behaviour of Next.js, so what you are after is either a bug or a feature request of behaviour that should not be controlled by the `skipTrailingSlashRedirect` settings. I will notify the Next.js team and see what can be done.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1708154464/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"wiiiimm","id":179761,"node_id":"MDQ6VXNlcjE3OTc2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/179761?v=4","gravatar_id":"","url":"https://api.github.com/users/wiiiimm","html_url":"https://github.com/wiiiimm","followers_url":"https://api.github.com/users/wiiiimm/followers","following_url":"https://api.github.com/users/wiiiimm/following{/other_user}","gists_url":