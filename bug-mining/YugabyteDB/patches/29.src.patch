+      assert(masters.split(",").length == 4);
+    }
+
+    // Wait for some ops and verify no failures in load tester.
+    loadTesterRunnable.waitNumOpsIncrement(NUM_OPS_INCREMENT);
+    loadTesterRunnable.verifyNumExceptions();
+
+    verifyClusterHealth();
+  }
