s_url":"https://api.github.com/repos/open-telemetry/opentelemetry-demo/releases{/id}","deployments_url":"https://api.github.com/repos/open-telemetry/opentelemetry-demo/deployments","created_at":"2022-04-26T19:47:29Z","updated_at":"2025-12-12T18:24:10Z","pushed_at":"2025-12-12T15:32:59Z","git_url":"git://github.com/open-telemetry/opentelemetry-demo.git","ssh_url":"git@github.com:open-telemetry/opentelemetry-demo.git","clone_url":"https://github.com/open-telemetry/opentelemetry-demo.git","svn_url":"https://github.com/open-telemetry/opentelemetry-demo","homepage":"https://opentelemetry.io/docs/demo/","size":50674,"stargazers_count":2780,"watchers_count":2780,"language":"TypeScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":5330,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":68,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["demo","jaeger","opentelemetry","opentelemetry-collector","opentelemetry-dotnet","opentelemetry-erlang","opentelemetry-go","opentelemetry-java-agent","opentelemetry-javascript","opentelemetry-python","opentelemetry-rust","prometheus"],"visibility":"public","forks":5330,"open_issues":68,"watchers":2780,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/open-telemetry/opentelemetry-demo/pulls/109","html_url":"https://github.com/open-telemetry/opentelemetry-demo/pull/109","diff_url":"https://github.com/open-telemetry/opentelemetry-demo/pull/109.diff","patch_url":"https://github.com/open-telemetry/opentelemetry-demo/pull/109.patch","merged_at":"2022-06-06T18:13:36Z"},"body":"## Changes\n\nThis PR rewrites the `emailservice` in Ruby. We make the following notable changes:\n- This is an **http** service, since Ruby and GRPC are not the best of friends. We modify the calling `checkoutservice` accordingly.\n- I pinned us to otelcol 0.52.0 - whatever version I had locally on my M1 Mac was segfaulting, and pulling the latest version fixed it. This necessitated a small change to the config, since some keys shuffled around in the `jaeger` exporter section.\n- I changed some of the relevant environmental variables to reflect the HTTP nature of this service, and to properly configure Ruby's OTLP/HTTP exporter; but I tried to change those in a non-invasive way for any other service.\n\nWe were able to do this pretty easily, especially since the GRPC request proto for emailservice was very simple and readily serialized to JSON.\n\nThere are two potential things wrong with it:\n- I'm pretty sure that the formatting of the email message looks slightly different then the original python version intended ... but honestly I don't think anyone ever looked at it before. :shrug:\n- We render the email body into the log, which is a tad bit noisy. On the other hand, the logs are very noisy as-is.\n\nFixes #37\n","reactions":{"url":"https://api.github.com/repos/open-telemetry/opentelemetry-demo/issues/109/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/open-telemetry/opentelemetry-demo/issues/109/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/grpc/grpc/issues/comments/1585823422","html_url":"https://github.com/grpc/grpc/issues/25373#issuecomment-1585823422","issue_url":"https://api.github.com/repos/grpc/grpc/issues/25373","id":1585823422,"node_id":"IC_kwDOAacf2M5ehb6-","user":{"login":"alto-ruby","id":122473768,"node_id":"U_kgDOB0zNKA","avatar_url":"https://avatars.githubusercontent.com/u/122473768?v=4","gravatar_id":"","url":"https://api.github.com/users/alto-ruby","html_url":"https://github.com/alto-ruby","followers_url":"https://api.github.com/users/alto-ruby/followers","following_url":"https://api.github.com/users/alto-ruby/following{/other_user}","gists_url":"https://api.github.com/users/alto-ruby/gists{/gist_id}","starred_url":"https://api.github.com/users/alto-ruby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alto-ruby/subscriptions","organizations_url":"https://api.github.com/users/alto-ruby/orgs","repos_url":"https://api.github.com/users/alto-ruby/repos","events_url":"https://api.github.com/users/alto-ruby/events{/privacy}","received_events_url":"https://api.github.com/users/alto-ruby/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-10T21:42:09Z","updated_at":"2023-06-10T21:42:09Z","body":"Yes, this is caused by line 231: `@metadata_sent = true`, yet the constructed ops were dropped due to the exception; when exception was handled, [send_status](https://github.com/grpc/grpc/blob/90f13f08f06993768b58cb3431d83ab2f5f5f5cc/src%2Fruby%2Flib%2Fgrpc%2Fgeneric%2Factive_call.rb#L207) was called but mistakenly determined that the initial metadata was already sent and caused c-core stuck there.\r\n\r\nYour proposal would be the correct fix, and is also what's being done [at the client side](https://github.com/grpc/grpc/blob/90f13f08f06993768b58cb3431d83ab2f5f5f5cc/src%2Fruby%2Flib%2Fgrpc%2Fgeneric%2Factive_call.rb#L351-L364).\r\n\r\nThanks for raising this and the detailed analysis, welcome to create a PR to address this. @jakubednarek ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/grpc/grpc/issues/comments/1585823422/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"alto-ruby","id":122473768,"node_id":"U_kgDOB0zNKA","avatar_url":"https://avatars.githubuserco