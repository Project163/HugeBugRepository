pi.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2021-04-14T15:37:40Z","label":{"name":"question","color":"d876e3"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/819620633","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/6260#issuecomment-819620633","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/6260","id":819620633,"node_id":"MDEyOklzc3VlQ29tbWVudDgxOTYyMDYzMw==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-04-14T15:45:14Z","updated_at":"2021-04-14T15:45:14Z","body":"hi there -\r\n\r\nThis is essentially an effect of the same issue reported in #5780, #6062, which is that this is a semi-private API that does not accept an Engine as its argument; it takes a Connection object.\r\n\r\nIn this case, the Engine is non-initialized when first called so the value of \"default_schema_name\" has not been initialized.\r\n\r\nOther than the lack of an assertion here, which I will probably push up since for some reason this issue keeps coming up, you should not pass an Engine object to dialect.has_table(), and this method is not appropriate for public API use in any case.   The correct legacy API is [engine.has_table()](https://docs.sqlalchemy.org/en/14/core/connections.html?highlight=engine%20has_table#sqlalchemy.engine.Engine.has_table) and the newer API is [Inspector.has_table](https://docs.sqlalchemy.org/en/14/core/reflection.html#sqlalchemy.engine.reflection.Inspector.has_table) .\r\n\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/819620633/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/819641486","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/6260#issuecomment-819641486","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/6260","id":819641486,"node_id":"MDEyOklzc3