],"visibility":"public","forks":3065,"open_issues":3124,"watchers":20064,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/python/mypy/pulls/1535","html_url":"https://github.com/python/mypy/pull/1535","diff_url":"https://github.com/python/mypy/pull/1535.diff","patch_url":"https://github.com/python/mypy/pull/1535.patch","merged_at":"2016-05-17T17:23:27Z"},"body":" #1172 says IntEnum members are treated as ints. This diff treats SomeIntEnum.x as both an instance of SomeIntEnum and int.\n\nIt'd be great to not have to do this hardcoded list of Enum-like classes, but seeing as that's how Enum is already done, I just decided to jack into it.\n\nOnly concern: this iteration over a list of size 2 is going to happen for _every instance_, it might be worth worrying about optimizing the branch prediction on it. (9/10 times, instances aren't going to be Enum.)\n","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/1535/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/mypy/issues/1535/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":663116460,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDY2MzExNjQ2MA==","url":"https://api.github.com/repos/python/mypy/issues/events/663116460","actor":{"login":"wittekm","id":578530,"node_id":"MDQ6VXNlcjU3ODUzMA==","avatar_url":"https://avatars.githubusercontent.com/u/578530?v=4","gravatar_id":"","url":"https://api.github.com/users/wittekm","html_url":"https://github.com/wittekm","followers_url":"https://api.github.com/users/wittekm/followers","following_url":"https://api.github.com/users/wittekm/following{/other_user}","gists_url":"https://api.github.com/users/wittekm/gists{/gist_id}","starred_url":"https://api.github.com/users/wittekm/starred{/owner}{/repo}","subscripti