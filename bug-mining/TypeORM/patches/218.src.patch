-            let { database, tableName: name } = this.driver.parseTableName(tableName)
-
-            if (!database) {
-                database = currentDatabase;
-            }
-
-            return `(\`t\`.\`schema\` = '${database}' AND \`t\`.\`name\` = '${name}')`;
-        }).join(" OR ");
