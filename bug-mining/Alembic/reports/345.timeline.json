ioni/gists{/gist_id}","starred_url":"https://api.github.com/users/fbuccioni/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fbuccioni/subscriptions","organizations_url":"https://api.github.com/users/fbuccioni/orgs","repos_url":"https://api.github.com/users/fbuccioni/repos","events_url":"https://api.github.com/users/fbuccioni/events{/privacy}","received_events_url":"https://api.github.com/users/fbuccioni/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2025-11-05T14:03:23Z","rename":{"from":"Problem in MSSQL altering column / Ability to apply `mssql_drop_*` to `alter_column` also","to":"Problem in MSSQL altering column when change type and server_default in one statement"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/alembic/issues/comments/3491492645","html_url":"https://github.com/sqlalchemy/alembic/issues/1744#issuecomment-3491492645","issue_url":"https://api.github.com/repos/sqlalchemy/alembic/issues/1744","id":3491492645,"node_id":"IC_kwDOCX47u87QG_Ml","user":{"login":"sqla-tester","id":8250554,"node_id":"MDQ6VXNlcjgyNTA1NTQ=","avatar_url":"https://avatars.githubusercontent.com/u/8250554?v=4","gravatar_id":"","url":"https://api.github.com/users/sqla-tester","html_url":"https://github.com/sqla-tester","followers_url":"https://api.github.com/users/sqla-tester/followers","following_url":"https://api.github.com/users/sqla-tester/following{/other_user}","gists_url":"https://api.github.com/users/sqla-tester/gists{/gist_id}","starred_url":"https://api.github.com/users/sqla-tester/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqla-tester/subscriptions","organizations_url":"https://api.github.com/users/sqla-tester/orgs","repos_url":"https://api.github.com/users/sqla-tester/repos","events_url":"https://api.github.com/users/sqla-tester/events{/privacy}","received_events_url":"https://api.github.com/users/sqla-tester/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-05T14:22:29Z","updated_at":"2025-11-05T14:22:29Z","body":"**Mike Bayer** has proposed a fix for this issue in the **main** branch:\n\n**run drop default constraint ahead of type** https://gerrit.sqlalchemy.org/c/sqlalchemy/alembic/+/6402","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/sqlalchemy/alembic/issues/comments/3491492645/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"sqla-tester","id":8250554,"node_id":"MDQ6VXNlcjgyNTA1NTQ=","avatar_url":"https://avatars.githubusercontent.com/u/8250554?v=4","gravatar_id":"","url":"https://api.github.com/users/sqla-tester","html_url":"https://github.com/sqla-tester","followers_url":"https://api.github.com/users/sqla-tester/followers","following_url":"https://api.github.com/users/sqla-tester/following{/other_user}","gists_url":"https://api.github.com/users/sqla-tester/gists{/gist_id}","starred_url":"https://api.github.com/users/sqla-tester/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqla-tester/subscriptions","organizations_url":"https://api.github.com/users/sqla-tester/orgs","repos_url":"https://api.github.com/users/sqla-tester/repos","events_url":"https://api.github.com/users/sqla-tester/events{/privacy}","received_events_url":"https://api.github.com/users/sqla-tester/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/alembic/issues/comments/3491745825","html_url":"https://github.com/sqlalchemy/alembic/issues/1744#issuecomment-3491745825","issue_url":"https://api.github.com/repos/sqlalchemy/alembic/issues/1744","id":3491745825,"node_id":"IC_kwDOCX47u87QH9Ah","user":{"login":"fbuccioni","id":1074427,"node_id":"MDQ6VXNlcjEwNzQ0Mjc=","avatar_url":"https://avatars.githubusercontent.com/u/1074427?v=4","gravatar_id":"","url":"https://api.github.com/users/fbuccioni","html_url":"https://github.com/fbuccioni","followers_url":"https://api.github.com/users/fbuccioni/followers","following_url":"https://api.github.com/users/fbuccioni/following{/other_user}","gists_url":"https://api.github.com/users/fbuccioni/gists{/gist_id}","starred_url":"https://api.github.com/users/fbuccioni/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fbuccioni/subscriptions","organizations_url":"https://api.github.com/users/fbuccioni/orgs","repos_url":"https://api.github.com/users/fbuccioni/repos","events_url":"https://api.github.com/users/fbuccioni/events{/privacy}","received_events_url":"https://api.github.com/users/fbuccioni/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-05T15:05:15Z","updated_at":"2025-11-05T15:10:16Z","body":"I had modified to continue my work with the following code, I look before the `super.alter_column()` if there is a `existing_server_default` or applies the yet used condition and leave the server default after condition untouched\n\n\n```patch\n--- mssql-original.py   2025-11-05 11:23:35.477078311 -0300\n+++ mssql-patched.py    2025-11-05 11:22:15.407828065 -0300\n@@ -137,40 +137,54 @@\n             server_default, existing_server_default\n         ):\n             used_default = True\n             kw[\"server_default\"] = server_default\n             kw[\"existing_server_default\"] = existing_server_default\n\n+        server_default_changed = server_default is not False and used_default is False\n+\n+        if (\n+            ( # When has an existing default and type is changed\n+                existing_type is not None\n+                and existing_server_default not in (False, None)\n+                and type_ != existing_type\n+            ) or ( # When server default is changed\n+                server_default_changed\n+                and (\n+                    existing_server_default is not False\n+                    or server_default is None\n+                )\n+            )\n+        ):\n+            self._exec(\n+                _ExecDropConstraint(\n+                    table_name,\n+                    column_name,\n+                    \"sys.default_constraints\",\n+                    schema,\n+                )\n+            )\n+\n         super().alter_column(\n             table_name,\n             column_name,\n             nullable=nullable,\n             type_=type_,\n             schema=schema,\n             existing_type=existing_type,\n             existing_nullable=existing_nullable,\n             **kw,\n         )\n\n-        if server_default is not False and used_default is False:\n-            if existing_server_default is not False or server_default is None:\n-                self._exec(\n-                    _ExecDropConstraint(\n-                        table_name,\n-                        column_name,\n-                        \"sys.default_constraints\",\n-                        schema,\n-                    )\n-                )\n-            if server_default is not None:\n-                super().alter_column(\n-                    table_name,\n-                    column_name,\n-                    schema=schema,\n-                    server_default=server_default,\n-                )\n+        if server_default_changed and server_default is not None:\n+            super().alter_column(\n+                table_name,\n+                column_name,\n+                schema=schema,\n+                server_default=server_default,\n+            )\n\n         if name is not None:\n             super().alter_column(\n                 table_name, column_name, schema=schema, name=name\n             )\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sqlalchemy/alembic/issues/comments/3491745825/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"fbuccioni","id":1074427,"node_id":"MDQ6VXNlcjEwNzQ0Mjc=","avatar_url":"https://avatars.githubusercontent.com/u/1074427?v=4","gravatar_id":"","url":"https://api.github.com/users/fbuccioni","html_url":"https://github.com/fbuccioni","followers_url":"https://api.github.com/users/fbuccioni/followers","following_url":"https://api.github.com/users/fbuccioni/following{/other_user}","gists_url":"https://api.github.com/users/fbuccioni/gists{/gist_id}","starred_url":"https://api.github.com/users/fbuccioni/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fbuccioni/subscriptions","organizations_url":"https://api.github.com/users/fbuccioni/orgs","repos_url":"https://api.github.com/users/fbuccioni/repos","events_url":"https://api.github.com/users/fbuccioni/events{/privacy}","received_events_url":"https://api.github.com/users/fbuccioni/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":20734157661,"node_id":"CE_lADOCX47u87V45EpzwAAAATT2iNd","url":"https://api.github.com/repos/sqlalchemy/alembic/issues/events/20734157661","actor":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users