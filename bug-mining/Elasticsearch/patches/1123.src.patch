index 00000000000..24d2dcdc08f
--- /dev/null
+++ b/rest-api-spec/test/indices.exists/20_read_only_index.yaml
@@ -0,0 +1,30 @@
+---
+"Test indices.exists on a read only index":
+
+  - do:
+      indices.create:
+        index: test_index_ro
+
+  - do:
+      indices.put_settings:
+        index: test_index_ro
+        body:
+          index.blocks.read_only: true
+
+  - do:
+      indices.exists:
+        index: test_index_ro
+
+  - is_true: ''
+
+  - do:
+      indices.put_settings:
+        index: test_index_ro
+        body:
+          index.blocks.read_only: false
+
+  - do:
+      indices.exists:
+        index: test_index_ro
+
+  - is_true: ''
