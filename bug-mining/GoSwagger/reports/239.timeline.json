d assertions on logs which may fail during parallel testing\r\n\r\nSigned-off-by: Frederic BIDON <fredbi@yahoo.com>","reactions":{"url":"https://api.github.com/repos/go-swagger/go-swagger/issues/2513/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/go-swagger/go-swagger/issues/2513/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":4301886674,"node_id":"MDExOkNsb3NlZEV2ZW50NDMwMTg4NjY3NA==","url":"https://api.github.com/repos/go-swagger/go-swagger/issues/events/4301886674","actor":{"login":"fredbi","id":14262513,"node_id":"MDQ6VXNlcjE0MjYyNTEz","avatar_url":"https://avatars.githubusercontent.com/u/14262513?v=4","gravatar_id":"","url":"https://api.github.com/users/fredbi","html_url":"https://github.com/fredbi","followers_url":"https://api.github.com/users/fredbi/followers","following_url":"https://api.github.com/users/fredbi/following{/other_user}","gists_url":"https://api.github.com/users/fredbi/gists{/gist_id}","starred_url":"https://api.github.com/users/fredbi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fredbi/subscriptions","organizations_url":"https://api.github.com/users/fredbi/orgs","repos_url":"https://api.github.com/users/fredbi/repos","events_url":"https://api.github.com/users/fredbi/events{/privacy}","received_events_url":"https://api.github.com/users/fredbi/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2021-02-08T08:00:11Z","state_reason":null,"performed_via_github_app":null},{"id":4301886823,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDQzMDE4ODY4MjM=","url":"https://api.github.com/repos/go-swagger/go-swagger/issues/events/4301886823","actor":{"login":"fredbi","id":14262513,"node_id":"MDQ6VXNlcjE0MjYyNTEz","avatar_url":"https://avatars.githubusercontent.com/u/14262513?v=4","gravatar_id":"","u