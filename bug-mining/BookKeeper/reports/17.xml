<item>
            <title>[BOOKKEEPER-57] NullPointException at bookie.zk@EntryLogger</title>
                <link>https://issues.apache.org/jira/browse/BOOKKEEPER-57</link>
                <project id="12311293" key="BOOKKEEPER">Bookkeeper</project>
                    <description>&lt;p&gt;In Bookie.java, if the recovery time is longer than gcWaitTime, bookie.zk is null and gc thread will exit&lt;/p&gt;</description>
                <environment></environment>
        <key id="12520538">BOOKKEEPER-57</key>
            <summary>NullPointException at bookie.zk@EntryLogger</summary>
                <type id="1" iconUrl="https://issues.apache.org/jira/secure/viewavatar?size=xsmall&amp;avatarId=21133&amp;avatarType=issuetype">Bug</type>
