<item>
            <title>[IGNITE-13142] SQL constraint not null added on key prevents correct inserts</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-13142</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;It is possible to configure &lt;tt&gt;QueryEntity&lt;/tt&gt; so that subsequent inserts would fail.&lt;/p&gt;
&lt;ul class=&quot;alternate&quot; type=&quot;square&quot;&gt;
	&lt;li&gt;lowercase &lt;tt&gt;keyFieldName&lt;/tt&gt;&lt;/li&gt;
	&lt;li&gt;not null constraint on &lt;tt&gt;keyFieldName&lt;/tt&gt;&lt;/li&gt;
&lt;/ul&gt;



&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
&lt;span class=&quot;code-keyword&quot;&gt;new&lt;/span&gt; QueryEntity()
    .setTableName(&lt;span class=&quot;code-quote&quot;&gt;&quot;Person&quot;&lt;/span&gt;)
    .setKeyFieldName(&lt;span class=&quot;code-quote&quot;&gt;&quot;id&quot;&lt;/span&gt;)
    .setKeyType(&lt;span class=&quot;code-quote&quot;&gt;&quot;java.lang.&lt;span class=&quot;code-object&quot;&gt;Integer&lt;/span&gt;&quot;&lt;/span&gt;)
    .setValueType(&lt;span class=&quot;code-quote&quot;&gt;&quot;Person&quot;&lt;/span&gt;)
    .setFields(&lt;span class=&quot;code-keyword&quot;&gt;new&lt;/span&gt; LinkedHashMap&amp;lt;&amp;gt;(
            F.asMap(&lt;span class=&quot;code-quote&quot;&gt;&quot;id&quot;&lt;/span&gt;, &lt;span class=&quot;code-quote&quot;&gt;&quot;java.lang.&lt;span class=&quot;code-object&quot;&gt;Integer&lt;/span&gt;&quot;&lt;/span&gt;,
                    &lt;span class=&quot;code-quote&quot;&gt;&quot;name&quot;&lt;/span&gt;, &lt;span class=&quot;code-quote&quot;&gt;&quot;java.lang.&lt;span class=&quot;code-object&quot;&gt;String&lt;/span&gt;&quot;&lt;/span&gt;,
                    &lt;span class=&quot;code-quote&quot;&gt;&quot;age&quot;&lt;/span&gt;, &lt;span class=&quot;code-quote&quot;&gt;&quot;java.lang.&lt;span class=&quot;code-object&quot;&gt;Integer&lt;/span&gt;&quot;&lt;/span&gt;)))
    .setNotNullFields(F.asSet(&lt;span class=&quot;code-quote&quot;&gt;&quot;id&quot;&lt;/span&gt;, &lt;span class=&quot;code-quote&quot;&gt;&quot;name&quot;&lt;/span&gt;, &lt;span class=&quot;code-quote&quot;&gt;&quot;age&quot;&lt;/span&gt;))))
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;The following SQL produces error: Null value is not allowed for column &apos;ID&apos;&lt;/p&gt;

&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
insert into Person (id, name, age) values (1, &lt;span class=&quot;code-quote&quot;&gt;&apos;John Doe&apos;&lt;/span&gt;, 30)
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</description>
