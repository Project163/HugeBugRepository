/celery/celery.git","svn_url":"https://github.com/celery/celery","homepage":"https://docs.celeryq.dev","size":36397,"stargazers_count":28268,"watchers_count":28268,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":4989,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":773,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["amqp","python","python-library","python3","queue-tasks","queue-workers","queued-jobs","redis","redis-queue","sqs","sqs-queue","task-manager","task-runner","task-scheduler"],"visibility":"public","forks":4989,"open_issues":773,"watchers":28268,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/celery/celery/pulls/9392","html_url":"https://github.com/celery/celery/pull/9392","diff_url":"https://github.com/celery/celery/pull/9392.diff","patch_url":"https://github.com/celery/celery/pull/9392.patch","merged_at":"2024-12-25T18:09:05Z"},"body":"## Description\r\n\r\n<!-- Please describe your pull request.\r\n\r\nNOTE: All patches should be made against main, not a maintenance branch like\r\n3.1, 2.5, etc.  That is unless the bug is already fixed in main, but not in\r\nthat version series.\r\n\r\nIf it fixes a bug or resolves a feature request,\r\nbe sure to link to that issue via (Fixes #4412) for example.\r\n-->\r\nFixes #9310 \r\nAs explained in the issue, `_maybe_close_db_fd` tries to catch django's db-agnostic errors (such as `django.db.InterfaceError`), but `_maybe_close_fd` raises a db-specific error (eg. `pyscog2.InterfaceError`). \r\n\r\nTo fix that, we wrap the call to `_maybe_close_fd` with the `c.wrap_database_errors` context manager (cf [here](https://github.com/django/django/blob/main/django/db/backends/base/base.py#L663)), made for this exact purpose. It prevents the worker to keep raising errors when initializing a process\r\n\r\nThis can easily be reproduced:\r\n```\r\nfrom django.db import connections\r\nfrom celery import Celery\r\napp = Celery(\"proj\", broker=\"redis://localhost\")\r\nworker = app.Worker()\r\n\r\nconnection = connections.all()[0]\r\nconnection.connect()\r\nconnection.connection.close()  # for any reason, connection is closed\r\n\r\nworker.start()\r\n\r\n```\r\n","reactions":{"url":"https://api.github.com/repos/celery/celery/issues/9392/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/celery/celery/issues/9392/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":15036687665,"node_id":"REFE_lADOAALQjM6XjgzYzwAAAAOAQaUx","url":"https://api.github.com/repos/celery/celery/issues/events/15036687665","actor":{"login":"Lotram","id":7586076,"node_id":"MDQ6VXNlcjc1ODYwNzY=","avatar_url":"https://avatars.githubusercontent.com/u/7586076?v=4","gravatar_id":"","url":"https://api.github.com/users/Lotram","html_url":"https://github.com/Lotram","followers_url":"https://api.github.com/users/Lotram/followers","following_url":"https://api.github.com/users/Lotram/following{/other_user}","gists_url":"https://api.github.com/users/Lotram/gists{/gist_id}","starred_url":"https://api.github.com/users/Lotram/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lotram/subscriptions","organizations_url":"https://api.github.com/users/Lotram/orgs","repos_url":"https://api.github.com/users/Lotram/repos","events_url":"https://api.github.com/users/Lotram/events{/privacy}","received_events_url":"https://api.github.com/users/Lotram/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"refe