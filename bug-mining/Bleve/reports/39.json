_id":"MDQ6VXNlcjI5ODE0Mw==","avatar_url":"https://avatars.githubusercontent.com/u/298143?v=4","gravatar_id":"","url":"https://api.github.com/users/mschoch","html_url":"https://github.com/mschoch","followers_url":"https://api.github.com/users/mschoch/followers","following_url":"https://api.github.com/users/mschoch/following{/other_user}","gists_url":"https://api.github.com/users/mschoch/gists{/gist_id}","starred_url":"https://api.github.com/users/mschoch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mschoch/subscriptions","organizations_url":"https://api.github.com/users/mschoch/orgs","repos_url":"https://api.github.com/users/mschoch/repos","events_url":"https://api.github.com/users/mschoch/events{/privacy}","received_events_url":"https://api.github.com/users/mschoch/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"mschoch","id":298143,"node_id":"MDQ6VXNlcjI5ODE0Mw==","avatar_url":"https://avatars.githubusercontent.com/u/298143?v=4","gravatar_id":"","url":"https://api.github.com/users/mschoch","html_url":"https://github.com/mschoch","followers_url":"https://api.github.com/users/mschoch/followers","following_url":"https://api.github.com/users/mschoch/following{/other_user}","gists_url":"https://api.github.com/users/mschoch/gists{/gist_id}","starred_url":"https://api.github.com/users/mschoch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mschoch/subscriptions","organizations_url":"https://api.github.com/users/mschoch/orgs","repos_url":"https://api.github.com/users/mschoch/repos","events_url":"https://api.github.com/users/mschoch/events{/privacy}","received_events_url":"https://api.github.com/users/mschoch/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":5,"created_at":"2019-03-12T03:14:30Z","updated_at":"2019-03-14T02:48:21Z","closed_at":"2019-03-14T02:48:21Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"A panic will be occurred cause `index out of range` when doing range query with unlimited upper by using **scorch**.\r\n\r\nThere are some logic issue in `RangeIterator` method of `index/scorch/segment/zap/Dictionary` struct.  \r\n\r\nhttps://github.com/blevesearch/bleve/blob/4b5cfbc8d5656cf05bf74d1ae270d2ca505560fc/index/scorch/segment/zap/dict.go#L140-L163\r\n\r\nWhen a range query with unlimited upper invoked, the `end` parameter of this method will be an  empty string. Then the `endBytes` variable will becomes a byte slice without any element. \r\n\r\n```go\r\n\t// need to increment the end position to be inclusive\r\n\tendBytes := []byte(end)\r\n\tif endBytes[len(endBytes)-1] < 0xff {\r\n\t\tendBytes[len(endBytes)-1]++\r\n\t} else {\r\n\t\tendBytes = append(endBytes, 0xff)\r\n\t}\r\n```\r\n\r\nThe above code will trying to **access element from empty slice**, so that an `index out of range` panic will be occurred.\r\n\r\nThis issue found by my colleague @heidawei .\r\nWe will submit a merge request soon to fix this problem.","closed_by":{"login":"mervinkid","id":5708406,"node_id":"MDQ6VXNlcjU3MDg0MDY=","avatar_url":"https://avatars.githubusercontent.com/u/5708406?v=4","gravatar_id":"","url":"https://api.github.com/users/mervinkid","html_url":"https://github.com/mervinkid","followers_url":"https://api.github.com/users/mervinkid/followers","following_url":"https://api.github.com/users/mervinkid/following{/other_user}","gists_url":"https://api.github.com/users/mervinkid/gists{/gist_id}","starred_url":"https://api.github.com/users/mervinkid/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mervinkid/subscriptions","organizations_url":"https://api.github.com/users/mervinkid/orgs","repos_url":"https://api.github.com/users/mervinkid/repos","events_url":"https://api.github.com/users/mervinkid/events{/privacy}","received_events_url":"https://api.github.com/users/mervinkid/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/blevesearch/bleve/issues/1156/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/blevesearch/bleve/issues/1156/timeline","performed_via_github_app":null,"state_reason":"completed"}