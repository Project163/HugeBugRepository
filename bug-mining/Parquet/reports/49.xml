<item>
            <title>[PARQUET-24] Enforce PARQUET jira prefix for PR names in merge script</title>
                <link>https://issues.apache.org/jira/browse/PARQUET-24</link>
                <project id="12315521" key="PARQUET">Parquet</project>
                    <description>&lt;p&gt;merge_parquet_pr.py should:&lt;/p&gt;
&lt;ul class=&quot;alternate&quot; type=&quot;square&quot;&gt;
	&lt;li&gt;enforce that the pull request description starts with &quot;Parquet-X: &quot;&lt;/li&gt;
	&lt;li&gt;automatically close the corresponding JIRA (right now it does except it ask for the JIRA ID)&lt;/li&gt;
	&lt;li&gt;ask for JIRA creds (right now they have to be in env)&lt;/li&gt;
&lt;/ul&gt;


&lt;p&gt;&lt;a href=&quot;https://github.com/apache/incubator-parquet-mr/blob/master/dev/merge_parquet_pr.py&quot; class=&quot;external-link&quot; target=&quot;_blank&quot; rel=&quot;nofollow noopener&quot;&gt;https://github.com/apache/incubator-parquet-mr/blob/master/dev/merge_parquet_pr.py&lt;/a&gt;&lt;/p&gt;</description>
                <environment></environment>
        <key id="12728731">PARQUET-24</key>
            <summary>Enforce PARQUET jira prefix for PR names in merge script</summary>
                <type id="1" iconUrl="https://issues.apache.org/jira/secure/viewavatar?size=xsmall&amp;avatarId=21133&amp;avatarType=issuetype">Bug</type>
