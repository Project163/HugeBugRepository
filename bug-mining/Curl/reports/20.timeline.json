_input_negotiate(struct connectdata *conn, bool proxy,\n   }\n\n   /* Initilise the security context and decode our challenge */\n-  return Curl_auth_decode_spnego_message(data, userp, passwdp, service, host,\n-                                         header, neg_ctx);\n+  result = Curl_auth_decode_spnego_message(data, userp, passwdp, service,\n+                                           host, header, neg_ctx);\n+\n+  if(result)\n+    Curl_auth_spnego_cleanup(neg_ctx);\n+\n+  return result;\n }\n\n CURLcode Curl_output_negotiate(struct connectdata *conn, bool proxy)\n```\n\nAlternatively, we can simply do the same cleanup in spnego_sspi.c file as well.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/curl/curl/issues/comments/259257373/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"iboukris","id":7945916,"node_id":"MDQ6VXNlcjc5NDU5MTY=","avatar_url":"https://avatars.githubusercontent.com/u/7945916?v=4","gravatar_id":"","url":"https://api.github.com/users/iboukris","html_url":"https://github.com/iboukris","followers_url":"https://api.github.com/users/iboukris/followers","following_url":"https://api.github.com/users/iboukris/following{/other_user}","gists_url":"https://api.github.com/users/iboukris/gists{/gist_id}","starred_url":"https://api.github.com/users/iboukris/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iboukris/subscriptions","organizations_url":"https://api.github.com/users/iboukris/orgs","repos_url":"https://api.github.com/users/iboukris/repos","events_url":"https://api.github.com/users/iboukris/events{/privacy}","received_events_url":"https://api.github.com/users/iboukris/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":852339831,"node_id":"MDEyOkxhYmVsZWRFdmVudDg1MjMzOTgzMQ==","url":"https://api.github.com/repos/curl/curl/issues