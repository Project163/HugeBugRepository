jin/following{/other_user}","gists_url":"https://api.github.com/users/jin/gists{/gist_id}","starred_url":"https://api.github.com/users/jin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jin/subscriptions","organizations_url":"https://api.github.com/users/jin/orgs","repos_url":"https://api.github.com/users/jin/repos","events_url":"https://api.github.com/users/jin/events{/privacy}","received_events_url":"https://api.github.com/users/jin/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-03-21T11:29:25Z","updated_at":"2018-03-21T11:29:25Z","body":"As long as the sources are declared as inputs to your test, Bazel will make them available at test runtime. \r\n\r\nDo you have a use case where this is not sufficient?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/374906872/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"jin","id":347918,"node_id":"MDQ6VXNlcjM0NzkxOA==","avatar_url":"https://avatars.githubusercontent.com/u/347918?v=4","gravatar_id":"","url":"https://api.github.com/users/jin","html_url":"https://github.com/jin","followers_url":"https://api.github.com/users/jin/followers","following_url":"https://api.github.com/users/jin/following{/other_user}","gists_url":"https://api.github.com/users/jin/gists{/gist_id}","starred_url":"https://api.github.com/users/jin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jin/subscriptions","organizations_url":"https://api.github.com/users/jin/orgs","repos_url":"https://api.github.com/users/jin/repos","events_url":"https://api.github.com/users/jin/events{/privacy}","received_events_url":"https://api.github.com/users/jin/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/374912195","html_url":"https://github.com/bazelbuild/bazel/issues/1052#issuecomment-374912195","issue_url":"https://api.github.com/repos/bazelbuild/bazel/issues/1052","id":374912195,"node_id":"MDEyOklzc3VlQ29tbWVudDM3NDkxMjE5NQ==","user":{"login":"edwardmjm","id":3351545,"node_id":"MDQ6VXNlcjMzNTE1NDU=","avatar_url":"https://avatars.githubusercontent.com/u/3351545?v=4","gravatar_id":"","url":"https://api.github.com/users/edwardmjm","html_url":"https://github.com/edwardmjm","followers_url":"https://api.github.com/users/edwardmjm/followers","following_url":"https://api.github.com/users/edwardmjm/following{/other_user}","gists_url":"https://api.github.com/users/edwardmjm/gists{/gist_id}","starred_url":"https://api.github.com/users/edwardmjm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/edwardmjm/subscriptions","organizations_url":"https://api.github.com/users/edwardmjm/orgs","repos_url":"https://api.github.com/users/edwardmjm/repos","events_url":"https://api.github.com/users/edwardmjm/events{/privacy}","received_events_url":"https://api.github.com/users/edwardmjm/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-03-21T11:53:15Z","updated_at":"2018-03-21T11:53:15Z","body":"It is sufficient, but it needs huge amount of unnecessary work.\r\nI am migrating from cmake to bazel. In a folder, basically it is some python and some genrules.\r\nWe had a test script run all the python tests in this folder recursively.\r\nSo basically I need all py files under this folder as `data` for the test script.\r\nBut given there are some `genrule` I need to run, there are some BUILD files, so that glob([\"**/*.py\"]) can't get through.\r\n\r\nFor example, we have a folder `python` contains following files.\r\n`python/BUILD`\r\n`python/test_a.py`\r\n`python/folder_a/BUILD` this one has genrule in it.\r\n`python/folder_a/folder_b/BUILD` this one has genrule as well.\r\n`python/folder_a/folder_b/folder_c/test_b.py`\r\n\r\nWe run the test script under `python`, it will run all the test_*.py recursively. Now we want to wrap it as a `sh_test` in bazel. So we need to specify all the `test_*.py` in the `data` field. But there is no easy way to do that since `glob()` can't get through `python/folder_a/BUILD` and `python/folder_a/folder_b/BUILD`\r\n\r\nI know it is a good way to use bazel, but it is too much work for migrating everything at the same time.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/374912195/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"edwardmjm","id":3351545,"node_id":"MDQ6VXNlcjMzNTE1NDU=","avatar_url":"https://avatars.githubusercontent.com/u/3351545?v=4","gravatar_id":"","url":"https://api.github.com/users/edwardmjm","html_url":"https://github.com/edwardmjm","followers_url":"https://api.github.com/users/edwardmjm/followers","following_url":"https://api.github.com/users/edwardmjm/following{/other_user}","gists_url":"https://api.github.com/users/edwardmjm/gists{/gist_id}","starred_url":"https://api.github.com/users/edwardmjm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/edwardmjm/subscriptions","organizations_url":"https://api.github.com/users/edwardmjm/orgs","repos_url":"https://api.github.com/users/edwardmjm/repos","events_url":"https://api.github.com/users/edwardmjm/events{/privacy}","received_events_url":"https://api.github.com/users/edwardmjm/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/374967545","html_url":"https://github.com/bazelbuild/bazel/issues/1052#issuecomment-374967545","issue_url":"https://api.github.com/repos/bazelbuild/bazel/issues/1052","id":374967545,"node_id":"MDEyOklzc3VlQ29tbWVudDM3NDk2NzU0NQ==","user"