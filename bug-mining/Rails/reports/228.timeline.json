for each table : charset: \"utf8mb4\", collation: \"utf8mb4_unicode_ci\"\r\n\r\nIn the mysql adaptater of activerecord @config[:encoding]  is not in use at all anymore (in rails 6.1.2)\r\nIt's still not clear for me how this information is passed to mysql2 gem.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/rails/rails/issues/comments/777823386/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"thomasdarde","id":812048,"node_id":"MDQ6VXNlcjgxMjA0OA==","avatar_url":"https://avatars.githubusercontent.com/u/812048?v=4","gravatar_id":"","url":"https://api.github.com/users/thomasdarde","html_url":"https://github.com/thomasdarde","followers_url":"https://api.github.com/users/thomasdarde/followers","following_url":"https://api.github.com/users/thomasdarde/following{/other_user}","gists_url":"https://api.github.com/users/thomasdarde/gists{/gist_id}","starred_url":"https://api.github.com/users/thomasdarde/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thomasdarde/subscriptions","organizations_url":"https://api.github.com/users/thomasdarde/orgs","repos_url":"https://api.github.com/users/thomasdarde/repos","events_url":"https://api.github.com/users/thomasdarde/events{/privacy}","received_events_url":"https://api.github.com/users/thomasdarde/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":4322198057,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50NDMyMjE5ODA1Nw==","url":"https://api.github.com/repos/rails/rails/issues/events/4322198057","actor":{"login":"config","id":50385744,"node_id":"MDEyOk9yZ2FuaXphdGlvbjUwMzg1NzQ0","avatar_url":"https://avatars.githubusercontent.com/u/50385744?v=4","gravatar_id":"","url":"https://api.github.com/users/config","html_url":"https://github.com/config","followers_url":"https://api.github.com/users/config/followers","following_url":"