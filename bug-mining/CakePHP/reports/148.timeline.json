ub.com/users/SplicePHP/events{/privacy}","received_events_url":"https://api.github.com/users/SplicePHP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-08-12T06:02:59Z","updated_at":"2014-08-12T06:02:59Z","body":"Hi, I fixed the marshaller and submitted a pull request.\nExisting ids are now detected and loaded instead of new ones being created.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/51876665/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"SplicePHP","id":4450898,"node_id":"MDQ6VXNlcjQ0NTA4OTg=","avatar_url":"https://avatars.githubusercontent.com/u/4450898?v=4","gravatar_id":"","url":"https://api.github.com/users/SplicePHP","html_url":"https://github.com/SplicePHP","followers_url":"https://api.github.com/users/SplicePHP/followers","following_url":"https://api.github.com/users/SplicePHP/following{/other_user}","gists_url":"https://api.github.com/users/SplicePHP/gists{/gist_id}","starred_url":"https://api.github.com/users/SplicePHP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SplicePHP/subscriptions","organizations_url":"https://api.github.com/users/SplicePHP/orgs","repos_url":"https://api.github.com/users/SplicePHP/repos","events_url":"https://api.github.com/users/SplicePHP/events{/privacy}","received_events_url":"https://api.github.com/users/SplicePHP/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/51878333","html_url":"https://github.com/cakephp/cakephp/issues/4228#issuecomment-51878333","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/4228","id":51878333,"node_id":"MDEyOklzc3VlQ29tbWVudDUxODc4MzMz","user":{"login":"SplicePHP","id":4450898,"node_id":"MDQ6VXNlcjQ0NTA4OTg=","avatar_url":"https://avatars.githubusercontent.com/u/4450898?v=4","gravatar_id":"","url":"https://api.github.com/users/SplicePHP","html_url":"https://github.com/SplicePHP","followers_url":"https://api.github.com/users/SplicePHP/followers","following_url":"https://api.github.com/users/SplicePHP/following{/other_user}","gists_url":"https://api.github.com/users/SplicePHP/gists{/gist_id}","starred_url":"https://api.github.com/users/SplicePHP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SplicePHP/subscriptions","organizations_url":"https://api.github.com/users/SplicePHP/orgs","repos_url":"https://api.github.com/users/SplicePHP/repos","events_url":"https://api.github.com/users/SplicePHP/events{/privacy}","received_events_url":"https://api.github.com/users/SplicePHP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-08-12T06:31:43Z","updated_at":"2014-08-12T06:31:43Z","body":"Not sure why but it does not seem like my pull request went through.\nIf you don't see it here is the code to fix it:\n( only modified the last foreach loop but pasted the entire function for context )\nin ORM/Marshaller.php at line 343\n\n```\n    public function mergeMany($entities, array $data, array $options = [])\n    {\n        $primary = (array)$this->_table->primaryKey();\n        $indexed = (new Collection($data))->groupBy($primary[0])->toArray();\n        $new = isset($indexed[null])?[$indexed[null]]:[];\n        unset($indexed[null]);\n        $output = [];\n        foreach($entities as $entity) {\n            if (!($entity instanceof EntityInterface)) {\n                continue;\n            }\n\n            $key = $entity->get($primary[0]);\n\n            if ($key === null || !isset($indexed[$key])) {\n                continue;\n            }\n\n            $output[] = $this->merge($entity, $indexed[$key][0], $options);\n            unset($indexed[$key]);\n        }\n\n        foreach(array_merge($indexed, $new) as $record) {\n            foreach($record as $value) {\n                if (isset($value[$primary[0]]) && $this->_table->exists([$primary[0] => $value[$primary[0]]])) {\n                    if ($entity = $this->_table->get($value[$primary[0]])) {\n                        $output[] = $this->merge($entity, $value, $options);\n                    }\n                } else {\n                    $output[] = $this->one($value, $options);\n                }\n            }\n        }\n        return $output;\n    }\n```\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/51878333/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"SplicePHP","id":4450898,"node_id":"MDQ6VXNlcjQ0NTA4OTg=","avatar_url":"https://avatars.githubusercontent.com/u/4450898?v=4","gravatar_id":"","url":"https://api.github.com/users/SplicePHP","html_url":"https://github.com/SplicePHP","followers_url":"https://api.github.com/users/SplicePHP/followers","following_url":"https://api.github.com/users/SplicePHP/following{/other_user}","gists_url":"https://api.github.com/users/SplicePHP/gists{/gist_id}","starred_url":"https://api.github.com/users/SplicePHP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SplicePHP/subscriptions","organizations_url":"https://api.github.com/users/SplicePHP/orgs","repos_url":"https://api.github.com/users/SplicePHP/repos","events_url":"https://api.github.com/users/SplicePHP/events{/privacy}","received_events_url":"https://api.github.com/users/SplicePHP/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/51879249","html_url":"https://github.com/cakephp/cakephp/issues/4228#issuecomment-51879249","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/4228","id":5187924