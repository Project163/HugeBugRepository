rl":"git@github.com:python/typeshed.git","clone_url":"https://github.com/python/typeshed.git","svn_url":"https://github.com/python/typeshed","homepage":"","size":29930,"stargazers_count":4954,"watchers_count":4954,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":1938,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":335,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["python","stub","types","typing"],"visibility":"public","forks":1938,"open_issues":335,"watchers":4954,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/python/typeshed/pulls/1986","html_url":"https://github.com/python/typeshed/pull/1986","diff_url":"https://github.com/python/typeshed/pull/1986.diff","patch_url":"https://github.com/python/typeshed/pull/1986.patch","merged_at":"2018-03-29T19:41:43Z"},"body":"This fixes the following issues, most of which were reported in #1983:\r\n\r\n* [x] Windows-related\r\n  * [x] `wintypes` is missing\r\n  * [x] `ctypes.HRESULT`'s value type should be `int` instead of `Any`\r\n  * [x] multiple assignment of types in `wintypes.pyi` is not understood by mypy (may be intentional: python/mypy#4794) (workaround: replaced multiple assignments with single assignments)\r\n* [x] `_cparam` should be called `_CArgObject` to match the type's real name\r\n* [x] `memmove` and friends don't accept all valid types in their pointer arguments (e. g. `_CArgObject` and `bytes`)\r\n* [x] `Array` issues\r\n  * [x] `_CDataMeta.__[r]mul__` return type contains unbound type variables\r\n  * [x] mypy complains when trying to create arrays of pointers or arrays (mypy bug, not something that needs to be changed in : python/mypy#4789)\r\n  * [x] mypy has problems with `Array.__init__`'s `*args` type annotation (not an issue at the moment, see below)\r\n  * [x] `Array`s of simple types are not handled correctly (this is very complicated to fix, if it is possible at all - changed some types in `Array`'s methods to `Any` as a workaround for now)","reactions":{"url":"https://api.github.com/repos/python/typeshed/issues/1986/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/typeshed/issues/1986/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"actor":{"login":"ilevkivskyi","id":12005495,"node_id":"MDQ6VXNlcjEyMDA1NDk1","avatar_url":"https://avatars.githubusercontent.com/u/12005495?v=4","gravatar_id":"","url":"https://api.github.com/users/ilevkivskyi","html_url":"https://github.com/ilevkivskyi","followers_url":"https://api.github.com/users/ilevkivskyi/followers","following_url":"https://api.github.com/users/ilevkivskyi/following{/other_user}","gists_url":"https://api.github.com/users/ilevkivskyi/gists{/gist_id}","starred_url":"https://api.github.com/users/ilevkivskyi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ilevkivskyi/subscriptions","organizations_url":"https://api.github.com/users/ilevkivskyi/orgs","repos_url":"https://api.github.com/users/ilevkivskyi/repos","events_url":"https://api.github.com/users/ilevkivskyi/events{/privacy}","received_events_url":"https://api.github.com/users/ilevkivskyi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-03-29T10:27:03Z","updated_at":"2018-03-29T10:27:03Z","source":{"type":"issue","issue":{"url":"https://api.github.com/repos/python/mypy/issues/4823","repository_url":"https://api.github.com/repos/python/mypy","labels_url":"https://api.github.com/repos/python/mypy/issues/4823/labels{/name}","comments_url":"https://api.githu