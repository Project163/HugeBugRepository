            <title>[IGNITE-5442] .NET: LINQ Conditional statement will fail for some types</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-5442</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;Next code will fail:&lt;/p&gt;

&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;&lt;span class=&quot;code-keyword&quot;&gt;var&lt;/span&gt; res = persons.Select(x =&amp;gt; &lt;span class=&quot;code-keyword&quot;&gt;new&lt;/span&gt; {Foo = x.Key%2 == 0 ? 1 : (&lt;span class=&quot;code-object&quot;&gt;int&lt;/span&gt;?)&lt;span class=&quot;code-keyword&quot;&gt;null&lt;/span&gt;, x.Value}).ToArray();
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;Fix: strip nullable type in &lt;tt&gt;SqlTypes&lt;/tt&gt;&lt;/p&gt;</description>
