t_creation_policy":"all","topics":["elasticsearch","java","search-engine"],"visibility":"public","forks":25807,"open_issues":5586,"watchers":76300,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/elastic/elasticsearch/pulls/62649","html_url":"https://github.com/elastic/elasticsearch/pull/62649","diff_url":"https://github.com/elastic/elasticsearch/pull/62649.diff","patch_url":"https://github.com/elastic/elasticsearch/pull/62649.patch","merged_at":"2020-09-21T09:07:11Z"},"body":"The `standard` tokenfilter was removed by #33310, and should have been \r\nunuseable in any indexes created since 7.0.  However, a cacheing bug fixed \r\nby #51092 meant that it was still possible in certain circumstances to create\r\nindexes referencing the `standard` filter in versions up to 7.5.2.  Our checks\r\nin `AnalysisModule` still refer to 7.0.0, however, meaning that a cluster that\r\ncontains one of these rogue indexes cannot be upgraded.\r\n\r\nThis commit adjusts the AnalysisModule checks so that we only refuse to\r\nbuild a mapping referring to `standard` filter if the index created version is\r\n7.6 or later.\r\n\r\nFixes #62644 ","reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/62649/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/elastic/elasticsearch/issues/62649/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":3787646140,"node_id":"MDExOkNsb3NlZEV2ZW50Mzc4NzY0NjE0MA==","url":"https://api.github.com/repos/elastic/elasticsearch/issues/events/3787646140","actor":{"login":"romseygeek","id":1347065,"node_id":"MDQ6VXNlcjEzNDcwNjU=","avatar_url":"https://avatars.githubusercontent.com/u/1347065?v=4","gravatar_id":"","url":"https://api.github.com/users/romseygeek","html_url":"https://github.c