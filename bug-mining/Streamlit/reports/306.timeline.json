rsion: 3.7.1\r\nUsing Conda? PipEnv? PyEnv? Pex? pip on WinPython\r\nOS version: Windows 10 version 1903\r\nBrowser version: Firefox 69.0\r\n\r\n# Additional information\r\nTried changing the port, enabling debugging, killing the console and restarting. Not running jupyter-lab. Removing the multiselect code. Tried using `http://localhost:8501/?a=1`. Tried `http://192.168.1.34:8501`. Seems to be caching and always just returning the 404.\r\n","reactions":{"url":"https://api.github.com/repos/streamlit/streamlit/issues/244/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/streamlit/streamlit/issues/244/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":2683126268,"node_id":"MDE3OlJlbmFtZWRUaXRsZUV2ZW50MjY4MzEyNjI2OA==","url":"https://api.github.com/repos/streamlit/streamlit/issues/events/2683126268","actor":{"login":"bluesheeptoken","id":17785017,"node_id":"MDQ6VXNlcjE3Nzg1MDE3","avatar_url":"https://avatars.githubusercontent.com/u/17785017?v=4","gravatar_id":"","url":"https://api.github.com/users/bluesheeptoken","html_url":"https://github.com/bluesheeptoken","followers_url":"https://api.github.com/users/bluesheeptoken/followers","following_url":"https://api.github.com/users/bluesheeptoken/following{/other_user}","gists_url":"https://api.github.com/users/bluesheeptoken/gists{/gist_id}","starred_url":"https://api.github.com/users/bluesheeptoken/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bluesheeptoken/subscriptions","organizations_url":"https://api.github.com/users/bluesheeptoken/orgs","repos_url":"https://api.github.com/users/bluesheeptoken/repos","events_url":"https://api.github.com/users/bluesheeptoken/events{/privacy}","received_events_url":"https://api.github.com/users/bluesheeptoken/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","comm