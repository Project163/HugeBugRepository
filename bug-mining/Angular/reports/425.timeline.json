:true,"has_projects":false,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":122,"mirror_url":null,"archived":true,"disabled":false,"open_issues_count":2,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":122,"open_issues":2,"watchers":797,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"When i have this type on my component:\r\n\r\n```\r\n    test: {a: number, b: number} | null = {\r\n        a: 1,\r\n        b: 2\r\n    }\r\n```\r\n\r\nand this in the template:\r\n```\r\n{{test?.a}}\r\n```\r\n\r\nthe plugin complains and tells me:\r\n```\r\n'Identifier 'a' is not defined. '<anonymous>' does not contain such a member'\r\n```\r\n\r\nI use the `?.` accessor method all the time (of course one could do `*ngIf=\"test\"` on the outer element but it turns out this does not solve the problem. `test` is still treated as `<anonymous>` in that case (along with the error message), meaning that the the `?.` operator is not the problem here). Seemingly the plugin can't handle access to members of objects that are possibly `null`. If i remove `null` from the type definition everything works smoothly (except the rest of code breaking ;-).","reactions":{"url":"https://api.github.com/repos/angular/vscode-ng-language-service/issues/71/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/angular/vscode-ng-language-service/issues/71/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}},"event":"cross-referenced"},{"id":1037320182,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDEwMzczMjAxODI=