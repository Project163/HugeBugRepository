sue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Regression due to https://github.com/vimeo/psalm/pull/191\r\n\r\nGiven three files `A.php`, `B.php`, and `C.php` each defining respective classes:\r\n\r\n```php\r\nclass A {\r\n  public function foo() {}\r\n}\r\n\r\nclass B {\r\n  public static function makeA() {\r\n    return new A;\r\n  }\r\n}\r\n\r\nclass C {\r\n  public function useA() {\r\n    B::makeA()->foo();\r\n  }\r\n}\r\n```\r\n\r\nIf you run in `--diff` mode, removing the method `foo` from `A` won’t cause an error to be thrown.","closed_by":{"login":"muglug","id":2292638,"node_id":"MDQ6VXNlcjIyOTI2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/2292638?v=4","gravatar_id":"","url":"https://api.github.com/users/muglug","html_url":"https://github.com/muglug","followers_url":"https://api.github.com/users/muglug/followers","following_url":"https://api.github.com/users/muglug/following{/other_user}","gists_url":"https://api.github.com/users/muglug/gists{/gist_id}","starred_url":"https://api.github.com/users/muglug/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/muglug/subscriptions","organizations_url":"https://api.github.com/users/muglug/orgs","repos_url":"https://api.github.com/users/muglug/repos","events_url":"https://api.github.com/users/muglug/events{/privacy}","received_events_url":"https://api.github.com/users/muglug/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/205/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vimeo/psalm/issues/205/timeline","performed_via_github_app":null,"state_reason":"completed"}