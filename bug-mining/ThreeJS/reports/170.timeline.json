/three.js/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/mrdoob/three.js/downloads","issues_url":"https://api.github.com/repos/mrdoob/three.js/issues{/number}","pulls_url":"https://api.github.com/repos/mrdoob/three.js/pulls{/number}","milestones_url":"https://api.github.com/repos/mrdoob/three.js/milestones{/number}","notifications_url":"https://api.github.com/repos/mrdoob/three.js/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/mrdoob/three.js/labels{/name}","releases_url":"https://api.github.com/repos/mrdoob/three.js/releases{/id}","deployments_url":"https://api.github.com/repos/mrdoob/three.js/deployments","created_at":"2010-03-23T18:58:01Z","updated_at":"2025-12-12T21:37:33Z","pushed_at":"2025-12-12T15:03:31Z","git_url":"git://github.com/mrdoob/three.js.git","ssh_url":"git@github.com:mrdoob/three.js.git","clone_url":"https://github.com/mrdoob/three.js.git","svn_url":"https://github.com/mrdoob/three.js","homepage":"https://threejs.org/","size":1541931,"stargazers_count":109825,"watchers_count":109825,"language":"JavaScript","has_issues":true,"has_projects":false,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":false,"forks_count":36156,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":609,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["3d","augmented-reality","canvas","html5","javascript","svg","virtual-reality","webaudio","webgl","webgl2","webgpu","webxr"],"visibility":"public","forks":36156,"open_issues":609,"watchers":109825,"default_branch":"dev","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/mrdoob/three.js/pulls/14170","html_url":"https://github.com/mrdoob/three.js/pull/14170","diff_url":"https://github.com/mrdoob/three.js/pull/14170.diff","patch_url":"https://github.com/mrdoob/three.js/pull/14170.patch","merged_at":"2018-07-31T05:00:49Z"},"body":"Here is a long awaited and relatively big update to TransformControls!\r\n\r\nThis PR fixes issues reported in #13806 #5489 #5379 #10916 #9312 #7947\r\n\r\nThis is pretty much a full rewrite on top of the original API. It includes a bunch of small improvements, simplifications and a few new features.\r\n\r\nSome of the updates are:\r\n\r\n- There is no need to use setter functions since changing relevant properties will automatically triger change event. For example. `control.setMode('scale')` should now be `control.mode = 'scale'`. Moreover, calling `control.update()` is no longer needed since updates are done automatically with `updateMatrixWorld`.\r\n\r\n- Transform gizmo now includes \"helpers\" that can serve as visual aid showing current transformation axis for example.\r\n\r\n- Handling of axis orientation is much improved. Axes pointing towards camera will automatically be hidden while axes occluded by other axes will flip to front side of the gizmo.\r\n\r\n![transform-axis-hide](https://user-images.githubusercontent.com/708984/40682290-a9b01396-638b-11e8-9a12-358c7d5ebea6.gif)\r\n\r\n- Rotation at grazing angles is now possible. Also, dragging the object center (between axes) will rotate the object around arbitrary axis perpendicular to drag direction.\r\n\r\n![transform-rotate](https://user-images.githubusercontent.com/708984/40682317-b85dbe52-638b-11e8-9a5a-fb7acb1f456b.gif)\r\n\r\n- Scale mode now correctly scales the object at rate relative to drag gesture in the viewport. Also, additional handles for XY, YZ and XZ scale are added.\r\n\r\n![transform-scale](https://user-images.githubusercontent.com/708984/40682460-16f2bb0c-638c-11e8-8521-1012d289423f.gif)\r\n\r\n- Transform gizmo looks slightly better and flips/hides axes depending on angle.\r\n\r\n![transform-translate](https://user-images.githubusercontent.com/708984/40682752-e408c820-638c-11e8-961c-acea599ae9b5.gif)\r\n","reactions":{"url":"https://api.github.com/repos/mrdoob/three.js/issues/14170/reactions","total_count":12,"+1":12,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/mrdoob/three.js/issues/14170/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":1655776576,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDE2NTU3NzY1NzY=","url":"https://api.github.com/repos/mrdoob/three.js/issues/events/1655776576","actor":{"login":"arodic","id":708984,"node_id":"MDQ6VXNlcjcwODk4NA==","avatar_url":"https://avatars.githubusercontent.com/u/708984?v=4","gravatar_id":"","url":"https://api.github.com/users/arodic","html_url":"https://github.com/arodic","followers_url":"https://api.github.com/users/arodic/followers","following_url":"https://api.github.com/users/arodic/following{/other_user}","gists_url":"https://api.github.com/users/arodic/gists{/gist_id}","starred_url":"https://api.github.com/users/arodic/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arodic/subscriptions","organizations_url":"https://api.github.com/users/arodic/orgs","repos_url":"https://api.github.com/users/arodic/repos","events_url":"https://api.github.com/users/arodic/events{/privacy}","received_events_url":"https://api.github.com/users/arodic/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"db4356d8df2ec08ed3e8f2e16e940db865f96c31","commit_url":"https://api.github.com/repos/arodic/three.js/commits/db4356d8df2ec08ed3e8f2e16e940db865f96c31","created_at":"2018-05-31T11:35:44Z","performed_via_github_app":null},{"id":1727315815,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDE3MjczMTU4MTU=","url":"https://api.github.com/repos/mrdoob/three.js/issues/events/1727315815","actor":{"login":"arodic","id":708984,"node_id":"MDQ6VXNlcjcwODk4NA==","avatar_url":"https://avatars.githu