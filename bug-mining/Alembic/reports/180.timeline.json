ithub.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-08-01T02:20:15Z","updated_at":"2018-11-27T03:25:22Z","body":"**Michael Bayer ([@zzzeek](https://github.com/zzzeek)) wrote:**\n\ncan you provide more specifics as to what you are seeing?   the source code uses \"True\" to mean changed:\n\n```\n    isdiff = autogen_context.migration_context._compare_type(\n        conn_col, metadata_col)\n\n    if isdiff:\n        alter_column_op.modify_type = metadata_type\n        log.info(\"Detected type change from %r to %r on '%s.%s'\",\n                 conn_type, metadata_type, tname, cname\n                 )\n\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sqlalchemy/alembic/issues/comments/441887879/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/alembic/issues/comments/441887880","html_url":"https://github.com/sqlalchemy/alembic/issues/501#issuecomment-441887880","issue_url":"https://api.github.com/repos/sqlalchemy/alembic/issues/501","id":441887880,"node_id":"MDEyOklzc3VlQ29tbWVudDQ0MTg4Nzg4MA==","user":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-08-01T15:24:23Z","updated_at":"2018-11-27T03:25:22Z","body":"**Mauricio Farías ([@negas](https://github.com/negas)) wrote:**\n\nI've done this [pull request](https://bitbucket.org/zzzeek/alembic/pull-requests/82/fix-comments-in-compare_against_backend).\nThe comments are confusing because are in opposition to code. It's in the [compare_against_backend method](https://bitbucket.org/zzzeek/alembic/src/master/docs/build/autogenerate.rst#docs/build/autogenerate.rst-441):\n\n```\ndef compare_against_backend(self, dialect, conn_type):\n            # return True if the types are different,\n            # False if not, or None to allow the default implementation\n            # to compare these types\n            if dialect.name == 'postgresql':\n                return isinstance(conn_type, postgresql.UUID)\n            else:\n                return isinstance(conn_type, String)\n```\nThen you use it here: [impl.py](https://bitbucket.org/zzzeek/alembic/src/master/alembic/ddl/impl.py#alembic/ddl/impl.py-250)\n\n```\ndef compare_type(self, inspector_column, metadata_column):\n\n        conn_type = inspector_column.type\n        metadata_type = metadata_column.type\n\n        metadata_impl = metadata_type.dialect_impl(self.dialect)\n        if isinstance(metadata_impl, sqltypes.Variant):\n            metadata_impl = metadata_impl.impl.dialect_impl(self.dialect)\n\n        # work around SQLAlchemy bug \"stale value for type affinity\"\n        # fixed in 0.7.4\n        metadata_impl.__dict__.pop('_type_affinity', None)\n\n        if hasattr(metadata_impl, \"compare_against_backend\"):\n            comparison = metadata_impl.compare_against_backend(\n                self.dialect, conn_type)\n            if comparison is not None:\n                return not comparison\n```\nFor example, I coded a custom type as:\n\n```\ndef compare_against_backend(self, dialect, conn_type):\n        # return True if the types are different,\n        # False if not, or None to allow the default implementation\n        # to compare these types\n\n        return isinstance(conn_type, types.BigInteger)\n```\nIf the function returns True then the types are the same so the comment should be:\n\"return False if the types are different.\"\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sqlalchemy/alembic/issues/comments/441887880/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gra