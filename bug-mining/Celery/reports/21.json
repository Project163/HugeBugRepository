:7,"created_at":"2014-08-19T11:21:41Z","updated_at":"2017-09-29T09:02:39Z","closed_at":"2016-06-23T23:48:27Z","assignee":null,"author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"When attempting to restore a group that was empty, we get an `AsyncResult` instead of a `GroupResult`:\n\n```\nfrom celery import group\nfrom celery.result = GroupResult\n\n# This is actually a simplification: the list comprehension used here\n# may evaluate to empty.\njob = group([])\nresult = job.apply_async()\n\nGroupResult.save(result)\n```\n\nThen, in another thread, possibly:\n\n```\ntask = GroupResult.restore(result.id)\n```\n\nIMHO: this should be a `GroupResult` with an empty list for `.results`, but it's coming back as an `AsyncResult`.\n","closed_by":{"login":"ask","id":1558,"node_id":"MDQ6VXNlcjE1NTg=","avatar_url":"https://avatars.githubusercontent.com/u/1558?v=4","gravatar_id":"","url":"https://api.github.com/users/ask","html_url":"https://github.com/ask","followers_url":"https://api.github.com/users/ask/followers","following_url":"https://api.github.com/users/ask/following{/other_user}","gists_url":"https://api.github.com/users/ask/gists{/gist_id}","starred_url":"https://api.github.com/users/ask/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ask/subscriptions","organizations_url":"https://api.github.com/users/ask/orgs","repos_url":"https://api.github.com/users/ask/repos","events_url":"https://api.github.com/users/ask/events{/privacy}","received_events_url":"https://api.github.com/users/ask/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/celery/celery/issues/2202/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url"