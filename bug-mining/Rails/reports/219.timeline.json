//api.github.com/users/kamipo/subscriptions","organizations_url":"https://api.github.com/users/kamipo/orgs","repos_url":"https://api.github.com/users/kamipo/repos","events_url":"https://api.github.com/users/kamipo/events{/privacy}","received_events_url":"https://api.github.com/users/kamipo/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2020-12-12T00:03:55Z","label":{"name":"regression","color":"e10c02"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/rails/rails/issues/comments/751440989","html_url":"https://github.com/rails/rails/issues/40804#issuecomment-751440989","issue_url":"https://api.github.com/repos/rails/rails/issues/40804","id":751440989,"node_id":"MDEyOklzc3VlQ29tbWVudDc1MTQ0MDk4OQ==","user":{"login":"8398a7","id":8043276,"node_id":"MDQ6VXNlcjgwNDMyNzY=","avatar_url":"https://avatars.githubusercontent.com/u/8043276?v=4","gravatar_id":"","url":"https://api.github.com/users/8398a7","html_url":"https://github.com/8398a7","followers_url":"https://api.github.com/users/8398a7/followers","following_url":"https://api.github.com/users/8398a7/following{/other_user}","gists_url":"https://api.github.com/users/8398a7/gists{/gist_id}","starred_url":"https://api.github.com/users/8398a7/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/8398a7/subscriptions","organizations_url":"https://api.github.com/users/8398a7/orgs","repos_url":"https://api.github.com/users/8398a7/repos","events_url":"https://api.github.com/users/8398a7/events{/privacy}","received_events_url":"https://api.github.com/users/8398a7/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-12-27T08:41:22Z","updated_at":"2020-12-27T08:41:22Z","body":"There is a similar problem when the value contains Japanese characters.\r\nI would like to consider using only alphanumeric characters, but if you can fix it, I would be happy.\r\n\r\nIt seems to be an effect of this line.\r\nhttps://github.com/rails/rails/blob/v6.1.0/activerecord/lib/active_record/enum.rb#L205\r\n\r\n```ruby\r\n# frozen_string_literal: true\r\n\r\nrequire \"bundler/inline\"\r\n\r\ngemfile(true) do\r\n  source \"https://rubygems.org\"\r\n\r\n  git_source(:github) { |repo| \"https://github.com/#{repo}.git\" }\r\n\r\n  # Activate the gem you are reporting the issue against.\r\n  gem \"activerecord\", \"6.1.0\"\r\n  gem \"sqlite3\"\r\nend\r\n\r\nrequire \"active_record\"\r\nrequire \"minitest/autorun\"\r\nrequire \"logger\"\r\n\r\n# This connection will do for database-independent bug reports.\r\nActiveRecord::Base.establish_connection(adapter: \"sqlite3\", database: \":memory:\")\r\nActiveRecord::Base.logger = Logger.new(STDOUT)\r\n\r\nActiveRecord::Schema.define do\r\n  create_table :posts, force: true do |t|\r\n    t.integer :status\r\n  end\r\nend\r\n\r\nclass Post < ActiveRecord::Base\r\n  enum status: %i[成功 失敗]\r\nend\r\n\r\nclass BugTest < Minitest::Test\r\n  def test_association_stuff\r\n    post = Post.create!(status: 1)\r\n    puts post.status\r\n  end\r\nend\r\n```\r\n\r\n```\r\nTraceback (most recent call last):\r\n        12: from active_record_gem.rb:29:in `<main>'\r\n        11: from active_record_gem.rb:30:in `<class:Post>'\r\n        10: from /.../ruby/2.7.2/lib/ruby/gems/2.7.0/gems/activerecord-6.1.0/lib/active_record/enum.rb:170:in `enum'\r\n         9: from /.../ruby/2.7.2/lib/ruby/gems/2.7.0/gems/activerecord-6.1.0/lib/active_record/enum.rb:170:in `each'\r\n         8: from /.../ruby/2.7.2/lib/ruby/gems/2.7.0/gems/activerecord-6.1.0/lib/active_record/enum.rb:190:in `block in enum'\r\n         7: from /.../ruby/2.7.2/lib/ruby/gems/2.7.0/gems/activerecord-6.1.0/lib/active_record/enum.rb:190:in `module_eval'\r\n         6: from /.../ruby/2.7.2/lib/ruby/gems/2.7.0/gems/activerecord-6.1.0/lib/active_record/enum.rb:193:in `block (2 levels) in enum'\r\n         5: from /.../ruby/2.7.2/lib/ruby/gems/2.7.0/gems/activerecord-6.1.0/lib/active_record/enum.rb:193:in `each'\r\n         4: from /.../ruby/2.7.2/lib/ruby/gems/2.7.0/gems/activerecord-6.1.0/lib/active_record/enum.rb:193:in `each_with_index'\r\n         3: from /.../ruby/2.7.2/lib/ruby/gems/2.7.0/gems/activerecord-6.1.0/lib/active_record/enum.rb:193:in `each'\r\n         2: from /.../ruby/2.7.2/lib/ruby/gems/2.7.0/gems/activerecord-6.1.0/lib/active_record/enum.rb:212:in `block (3 levels) in enum'\r\n         1: from /.../ruby/2.7.2/lib/ruby/gems/2.7.0/gems/activerecord-6.1.0/lib/active_record/enum.rb:271:in `detect_enum_conflict!'\r\n/.../ruby/2.7.2/lib/ruby/gems/2.7.0/gems/activerecord-6.1.0/lib/active_record/enum.rb:276:in `raise_conflict_error': You tried to define an enum named \"status\" on the model \"Post\", but this will generate a instance method \"_?\", which is already defined by another enum. (ArgumentError)\r\n```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/rails/rails/issues/comments/751440989/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"8398a7","id":8043276,"node_id":"MDQ6VXNlcjgwNDMyNzY=","avatar_url":"https://avatars.githubusercontent.com/u/8043276?v=4","gravatar_id":"","url":"https://api.github.com/users/8398a7","html_url":"https://github.com/8398a7","followers_url":"https://api.github.com/users/8398a7/followers","following_url":"https://api.github.com/users/8398a7/following{/other_user}","gists_url":"https://api.github.com/users/8398a7/gists{/gist_id}","starred_url":"https://api.github.com/users/8398a7/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/8398a7/subscriptions","organizations_url":"https://api.github.com/users/8398a7/orgs","repos_url":"https://api.github.com/users/8398a7/repos","events_url":"https://api.github.com/users/8398a7/events{/privacy}","received_events_url":"https://api.github.com/users/839