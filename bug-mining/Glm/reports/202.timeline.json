/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2016-11-01T22:54:00Z","label":{"name":"extension","color":"d4c5f9"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/g-truc/glm/issues/comments/259076048","html_url":"https://github.com/g-truc/glm/issues/448#issuecomment-259076048","issue_url":"https://api.github.com/repos/g-truc/glm/issues/448","id":259076048,"node_id":"MDEyOklzc3VlQ29tbWVudDI1OTA3NjA0OA==","user":{"login":"unravel-dev","id":1499411,"node_id":"MDQ6VXNlcjE0OTk0MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1499411?v=4","gravatar_id":"","url":"https://api.github.com/users/unravel-dev","html_url":"https://github.com/unravel-dev","followers_url":"https://api.github.com/users/unravel-dev/followers","following_url":"https://api.github.com/users/unravel-dev/following{/other_user}","gists_url":"https://api.github.com/users/unravel-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/unravel-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/unravel-dev/subscriptions","organizations_url":"https://api.github.com/users/unravel-dev/orgs","repos_url":"https://api.github.com/users/unravel-dev/repos","events_url":"https://api.github.com/users/unravel-dev/events{/privacy}","received_events_url":"https://api.github.com/users/unravel-dev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-11-08T08:33:15Z","updated_at":"2016-11-08T08:33:15Z","body":"i believe the last part in the function that gets the quaternion is kinda wrong\nthis version works way bettter with consistent results. I suggnest to replace it with this\n\n```\nint i, j, k = 0;\nfloat root, trace = Row[0].x + Row[1].y + Row[2].z;\nif (trace > static_cast<T>(0))\n{\n    root = sqrt(trace + static_cast<T>(1.0));\n    Orientation.w = static_cast<T>(0.5) * root;\n    root = static_cast<T>(0.5) / root;\n    Orientation.x = root * (Row[1].z - Row[2].y);\n    Orientation.y = root * (Row[2].x - Row[0].z);\n    Orientation.z = root * (Row[0].y - Row[1].x);\n} // End if > 0\nelse\n{\n    static int Next[3] = { 1, 2, 0 };\n    i = 0;\n    if (Row[1].y > Row[0].x) i = 1;\n    if (Row[2].z > Row[i][i]) i = 2;\n    j = Next[i];\n    k = Next[j];\n\n    root = sqrt(Row[i][i] - Row[j][j] - Row[k][k] + static_cast<T>(1.0));\n\n    Orientation[i] = static_cast<T>(0.5) * root;\n    root = static_cast<T>(0.5) / root;\n    Orientation[j] = root * (Row[i][j] + Row[j][i]);\n    Orientation[k] = root * (Row[i][k] + Row[k][i]);\n    Orientation.w = root * (Row[j][k] - Row[k][j]);\n} // End if <= 0\n`\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/g-truc/glm/issues/comments/259076048/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"unravel-dev","id":1499411,"node_id":"MDQ6VXNlcjE0OTk0MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1499411?v=4","gravatar_id":"","url":"https://api.github.com/users/unravel-dev","html_url":"https://github.com/unravel-dev","followers_url":"https://api.github.com/users/unravel-dev/followers","following_url":"https://api.github.com/users/unravel-dev/following{/other_user}","gists_url":"https://api.github.com/users/unravel-dev/gists{/gist_id}","starred_url":"https://api.github.com/users/unravel-dev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/unravel-dev/subscriptions","organizations_url":"https://api.github.com/users/unravel-dev/orgs","repos_url":"https://api.github.com/