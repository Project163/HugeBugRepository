+
+                    return msg0.exchangeId() == null && msg0.partitions().get(CU.cacheId(DEFAULT_CACHE_NAME)).
+                        topologyVersion().equals(new AffinityTopologyVersion(4, 0));
+                }
+
+                return false;
+            }
+        });
