t.com/u/35890159?v=4","gravatar_id":"","url":"https://api.github.com/users/AlexanderFarkas","html_url":"https://github.com/AlexanderFarkas","followers_url":"https://api.github.com/users/AlexanderFarkas/followers","following_url":"https://api.github.com/users/AlexanderFarkas/following{/other_user}","gists_url":"https://api.github.com/users/AlexanderFarkas/gists{/gist_id}","starred_url":"https://api.github.com/users/AlexanderFarkas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AlexanderFarkas/subscriptions","organizations_url":"https://api.github.com/users/AlexanderFarkas/orgs","repos_url":"https://api.github.com/users/AlexanderFarkas/repos","events_url":"https://api.github.com/users/AlexanderFarkas/events{/privacy}","received_events_url":"https://api.github.com/users/AlexanderFarkas/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1516377088","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/9676#issuecomment-1516377088","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/9676","id":1516377088,"node_id":"IC_kwDOCX5JB85aYhQA","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-04-20T13:55:51Z","updated_at":"2023-04-20T13:55:51Z","body":"the propagate is needed in at least some cases as removing all propagates causes tests to fail.\r\n\r\nthe double propagate for set can be disabled via:\r\n\r\n```diff\r\ndiff --git a/lib/sqlalchemy/ext/mutable.py b/lib/sqlalchemy/ext/mutable.py\r\nindex 7d23f9fda7..22f1745323 100644\r\n--- a/lib/sqlalchemy/ext/mutable.py\r\n+++ b/lib/sqlalchemy/ext/mutable.py\r\n@@ -528,6 +528,7 @@ class MutableBase:\r\n             outgoing.\r\n \r\n             \"\"\"\r\n+            print(f\"set event! {oldvalue} {value}\")\r\n             if value is oldvalue:\r\n                 return value\r\n \r\n@@ -577,7 +578,7 @@ class MutableBase:\r\n             parent_cls, \"refresh_flush\", load_attrs, raw=True, propagate=True\r\n         )\r\n         event.listen(\r\n-            attribute, \"set\", set_, raw=True, retval=True, propagate=True\r\n+            attribute, \"set\", set_, raw=True, retval=True, propagate=False\r\n         )\r\n         event.listen(parent_cls, \"pickle\", pickle, raw=True, propagate=True)\r\n         event.listen(\r\n\r\n``` \r\n\r\nhowever it's not clear why we have test cases which rely upon propagate being present","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1516377088/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1516386371","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/9676#issuecomment-1516386371","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/9676","id":1516386371,"node_id":"IC_kwDOCX5JB85aYjhD","user":{"login":"AlexanderFarkas","id":35890159,"node_id":"MDQ6VXNlcjM1ODkwMTU5","avatar_url":"https://avatars.githubusercontent.com/u/35890159?v=4","gravatar_id":"","url":"https://api.github.com/users/AlexanderFarkas","html_url":"https://github.com/AlexanderFarkas","followers_url":"https://api.github.com/users/AlexanderFarkas/followers","following_url":"https://api.github.com/users/AlexanderFarkas/following{/other_user}","gists_url":"https://api.github.com/users/AlexanderFarkas/gists{/gist_id}","starred_url":"https://api.github.com/users/AlexanderFarkas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AlexanderFarkas/subscriptions","organizations_url":"https://api.github.com/users/AlexanderFarkas/orgs","repos_url":"https://api.github.com/users/AlexanderFarkas/repos","events_url":"https://api.github.com/users/AlexanderFarkas/events{/privacy}","received_events_url":"https://api.github.com/users/AlexanderFarkas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-04-20T14:01:15Z","updated_at":"2023-04-20T14:06:24Z","body":"```python\r\nimport dataclasses\r\nimport json\r\n\r\nfrom sqlalchemy import create_engine, Table, JSON, Column, String, Integer\r\nfrom sqlalchemy.ext.mutable import Mutable\r\nfrom sqlalchemy.orm import registry\r\nfrom sqlalchemy.types import TypeDecorator, VARCHAR\r\n\r\nengine = create_engine(\"sqlite://\", echo=True, future=True)\r\nmapper_registry = registry()\r\n\r\n\r\nclass JSONEncodedDict(TypeDecorator):\r\n    \"Represents an immutable structure as a json-encoded string.\"\r\n\r\n    impl = VARCHAR\r\n\r\n    def process_bind_param(self, value, dialect):\r\n        if value is not None:\r\n            value = json.dumps(value)\r\n        return value\r\n\r\n    def process_result_value(self, value, dialect):\r\n        if value is not None:\r\n            value = json.loads(value)\r\n        return value\r\n\r\n\r\nclass MutableDict(Mutable, dict):\r\n    @classmethod\r\n    def coerce(cls, key, value):\r\n        \"Convert plain dictionaries to MutableDict.\"\r\n\r\n        if not isinstance(value, MutableDict):\r\n            if isinstance(value, dict):\r\n                return MutableDict(value)\r\n\r\n            # this call will raise ValueError\r\n            return Mutable.coerce(key, value)\r\n        else:\r\n            return value\r\n\r\n    def __setitem__(self, key, value):\r\n        \"Detect dictionary set events and emit change events.\"\r\n\r\n        dict.__setitem__(self, key, value)\r\n        self.changed()\r\n\r\n    def __delitem__(self, key):\r\n        \"Detect dictionary del events and emit change events.\"\r\n\r\n        dict.__delitem__(self, key)\r\n        self.changed()\r\n\r\n\r\ntable = Table(\r\n    \"person\",\r\n    mapper_registry.metadata,\r\n    Column(\"id\", Integer, autoincrement=True, primary_key=True),\r\n    Column(\"metadata\", MutableDict.as_mutable(JSONEncodedDict)),\r\n    Column(\"job_title\", String, nullable=True),\r\n)\r\n\r\n\r\n@dataclasses.dataclass\r\nclass Person:\r\n    metadata: dict\r\n\r\n\r\n@dataclasses.dataclass\r\nclass Employee(Person):\r\n    job_title: str\r\n\r\n\r\nmapper_registry.map_imperatively(\r\n    Person,\r\n    table\r\n)\r\n\r\nmapper_registry.map_imperatively(\r\n    Employee,\r\n    inherits=Person,\r\n)\r\n\r\nemployee = Employee(metadata={}, job_title=\"Programmer\")\r\nprint(len(employee._sa_class_manager.local_attrs[\"metadata\"].dispatch.set)) # 2, should be 1\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1516386371/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"AlexanderFarkas","id":35890159,"node_id":"MDQ6VXNlcjM1ODkwMTU5","avatar_url":"https://avatars.githubusercontent.com/u/35890159?v=4","gravatar_id":"","url":"https://api.github.com/users/AlexanderFarkas","html_url":"https://github.com/AlexanderFarkas","followers_url":"https://api.github.com/users/AlexanderFarkas/followers","following_url":"https://api.github.com/users/AlexanderFarkas/following{/other_user}","gists_url":"https://api.github.com/users/AlexanderFarkas/gists{/gist_id}","starred_url":"https://api.github.com/users/AlexanderFarkas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AlexanderFarkas/subscriptions","organizations_url":"https://api.github.com/users/AlexanderFarkas/orgs","repos_url":"https://api.github.com/users/AlexanderFarkas/repos","events_url":"https://api.github.com/users/AlexanderFarkas/events{/privacy}","received_events_url":"https://api.github.com/users/AlexanderFarkas/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1516404688","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/9676#issuecomment-1516404688","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/9676","id":1516404688,"node_id":"IC_kwDOCX5JB85aYn_Q","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-04-20T14:12:28Z","updated_at":"2023-04-20T14:12:28Z","body":"here's a more comprehensive patch that qualifies the propagate call.    it might be better to keep using \"propagate\" though and use a flag instead\r\n\r\n```diff\r\ndiff --git a/lib/sqlalchemy/ext/mutable.py b/lib/sqlalchemy/ext/mutable.py\r\nindex 7d23f9fda7..12bb8dcec0 100644\r\n--- a/lib/sqlalchemy/ext/mutable.py\r\n+++ b/lib/sqlalchemy/ext/mutable.py\r\n@@ -478,6 +478,7 @@ class MutableBase:\r\n         attribute: QueryableAttribute[Any],\r\n         coerce: bool,\r\n         parent_cls: _ExternalEntityType[Any],\r\n+        propagate: bool = False,\r\n     ) -> None:\r\n         \"\"\"Establish this type as a mutation listener for the given\r\n         mapped descriptor.\r\n@@ -566,22 +567,28 @@ class MutableBase:\r\n             \"_sa_event_merge_wo_load\",\r\n             load,\r\n             raw=True,\r\n-            propagate=True,\r\n+            propagate=propagate,\r\n         )\r\n \r\n-        event.listen(parent_cls, \"load\", load, raw=True, propagate=True)\r\n+        event.listen(parent_cls, \"load\", load, raw=True, propagate=propagate)\r\n         event.listen(\r\n-            parent_cls, \"refresh\", load_attrs, raw=True, propagate=True\r\n+            parent_cls, \"refresh\", load_attrs, raw=True, propagate=propagate\r\n         )\r\n         event.listen(\r\n-            parent_cls, \"refresh_flush\", load_attrs, raw=True, propagate=True\r\n+            parent_cls,\r\n+            \"refresh_flush\",\r\n+            load_attrs,\r\n+            raw=True,\r\n+            propagate=propagate,\r\n+        )\r\n+        event.listen(\r\n+            attribute, \"set\", set_, raw=True, retval=True, propagate=propagate\r\n         )\r\n         event.listen(\r\n-            attribute, \"set\", set_, raw=True, retval=True, propagate=True\r\n+            parent_cls, \"pickle\", pickle, raw=True, propagate=propagate\r\n         )\r\n-        event.listen(parent_cls, \"pickle\", pickle, raw=True, propagate=True)\r\n         event.listen(\r\n-            parent_cls, \"unpickle\", unpickle, raw=True, propagate=True\r\n+            parent_cls, \"unpickle\", unpickle, raw=True, propagate=propagate\r\n         )\r\n \r\n \r\n@@ -601,13 +608,15 @@ class Mutable(MutableBase):\r\n \r\n     @classmethod\r\n     def associate_with_attribute(\r\n-        cls, attribute: InstrumentedAttribute[_O]\r\n+        cls, attribute: InstrumentedAttribute[_O], *, propagate: bool = True\r\n     ) -> None:\r\n         \"\"\"Establish this type as a mutation listener for the given\r\n         mapped descriptor.\r\n \r\n         \"\"\"\r\n-        cls._listen_on_attribute(attribute, True, attribute.class_)\r\n+        cls._listen_on_attribute(\r\n+            attribute, True, attribute.class_, propagate=propagate\r\n+        )\r\n \r\n     @classmethod\r\n     def associate_with(cls, sqltype: type) -> None:\r\n@@ -700,7 +709,9 @@ class Mutable(MutableBase):\r\n                     and prop.expression.info.get(\"_ext_mutable_orig_type\")  # type: ignore # noqa: E501 # TODO: https://github.com/python/mypy/issues/1424#issuecomment-1272354487\r\n                     is sqltype\r\n                 ) or (prop.columns[0].type is sqltype):\r\n-                    cls.associate_with_attribute(getattr(class_, prop.key))\r\n+                    cls.associate_with_attribute(\r\n+                        getattr(class_, prop.key), propagate=False\r\n+                    )\r\n \r\n         event.listen(Mapper, \"mapper_configured\", listen_for_type)\r\n \r\n@@ -742,7 +753,7 @@ def _setup_composite_listener() -> None:\r\n                 and issubclass(prop.composite_class, MutableComposite)\r\n             ):\r\n                 prop.composite_class._listen_on_attribute(\r\n-                    getattr(class_, prop.key), False, class_\r\n+                    getattr(class_, prop.key), False, class_, propagate=True\r\n                 )\r\n \r\n     if not event.contains(Mapper, \"mapper_configured\", _listen_for_type):\r\n\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1516404688/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/