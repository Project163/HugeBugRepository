+   * Since webworkers aren't widely used, we will lift it once RouterScroller is
+   * battle-tested.
+   */
+  private supportScrollRestoration(): boolean {
+    try {
+      return !!this.window && !!this.window.scrollTo;
+    } catch (e) {
+      return false;
+    }
+  }
+}
