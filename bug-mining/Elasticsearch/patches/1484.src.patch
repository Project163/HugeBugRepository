+        } else if (includeDefaults) {
+            if (fieldType().dateTimeFormatter().locale() == null) {
+                builder.field("locale", Locale.ROOT);
+            } else {
+                builder.field("locale", fieldType().dateTimeFormatter().locale());
+            }
+        }
