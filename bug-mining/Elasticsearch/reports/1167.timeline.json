s":["elasticsearch","java","search-engine"],"visibility":"public","forks":25807,"open_issues":5588,"watchers":76300,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/elastic/elasticsearch/pulls/11434","html_url":"https://github.com/elastic/elasticsearch/pull/11434","diff_url":"https://github.com/elastic/elasticsearch/pull/11434.diff","patch_url":"https://github.com/elastic/elasticsearch/pull/11434.patch","merged_at":"2015-06-01T11:15:51Z"},"body":"When the dfs phase runs a SearchContext is created on each node that has a shard\nfor this query. When the query phase (or query and fetch phase) failed that SearchContext\nwas released only if the query was actually executed on the node. If for example\nthe query was rejected because the thread pool queue was full then the search context\nwas not released.\nThis commit adds a dedicated call for releasing the SearchContext in this case.\n\nIn addition, set the docIdsToLoad to null in case the fetch phase failed, otherwise\nsearch contexts might not be released in releaseIrrelevantSearchContexts.\n\ncloses #11400\n","reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/11434/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/elastic/elasticsearch/issues/11434/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/comments/107056752","html_url":"https://github.com/elastic/elasticsearch/issues/11400#issuecomment-107056752","issue_url":"https://api.github.com/repos/elastic/elasticsearch/issues/11400","id":107056752,"node_id":"MDEyOklzc3VlQ29tbWVudDEwNzA1Njc1Mg==","user":{"login":"brwe","id":4320215,"node_id":"MDQ6VXNlcjQzMjAyMTU=","avatar_url":"https://avatars.githubusercontent.com/u/4320215?