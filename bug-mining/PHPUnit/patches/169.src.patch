diff --git a/src/TextUI/Command.php b/src/TextUI/Command.php
index 4ba761cec..e5dd7a01d 100644
--- a/src/TextUI/Command.php
+++ b/src/TextUI/Command.php
@@ -20,6 +20,7 @@
 use function fgets;
 use function file_get_contents;
 use function file_put_contents;
+use function get_class;
 use function getcwd;
 use function ini_get;
 use function ini_set;
@@ -560,7 +561,18 @@ protected function handleBootstrap(string $filename): void
         try {
             FileLoader::checkAndLoad($filename);
         } catch (Throwable $t) {
-            $this->exitWithErrorMessage($t->getMessage());
+            if ($t instanceof \PHPUnit\Exception) {
+                $this->exitWithErrorMessage($t->getMessage());
+            }
+
+            $this->exitWithErrorMessage(
+                sprintf(
+                    'Error in bootstrap script: %s:%s%s',
+                    get_class($t),
+                    PHP_EOL,
+                    $t->getMessage()
+                )
+            );
         }
     }
 
