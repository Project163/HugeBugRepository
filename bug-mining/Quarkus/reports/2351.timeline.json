gsmet/repos","events_url":"https://api.github.com/users/gsmet/events{/privacy}","received_events_url":"https://api.github.com/users/gsmet/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"083a45af6873d80ec4401e5b63d067579c143916","commit_url":"https://api.github.com/repos/gsmet/quarkus/commits/083a45af6873d80ec4401e5b63d067579c143916","created_at":"2025-02-11T18:17:43Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/2678498290","html_url":"https://github.com/quarkusio/quarkus/issues/46170#issuecomment-2678498290","issue_url":"https://api.github.com/repos/quarkusio/quarkus/issues/46170","id":2678498290,"node_id":"IC_kwDOCFbutM6fpqPy","user":{"login":"heywobu","id":32598726,"node_id":"MDQ6VXNlcjMyNTk4NzI2","avatar_url":"https://avatars.githubusercontent.com/u/32598726?v=4","gravatar_id":"","url":"https://api.github.com/users/heywobu","html_url":"https://github.com/heywobu","followers_url":"https://api.github.com/users/heywobu/followers","following_url":"https://api.github.com/users/heywobu/following{/other_user}","gists_url":"https://api.github.com/users/heywobu/gists{/gist_id}","starred_url":"https://api.github.com/users/heywobu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/heywobu/subscriptions","organizations_url":"https://api.github.com/users/heywobu/orgs","repos_url":"https://api.github.com/users/heywobu/repos","events_url":"https://api.github.com/users/heywobu/events{/privacy}","received_events_url":"https://api.github.com/users/heywobu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-24T14:00:00Z","updated_at":"2025-02-24T14:34:52Z","body":"I still have the same issue on a Map<String, String>\nThe goal is to go from a string property to a Map<String, String>, (because the default Map converter requires a different formatting: `key1=value1;key2=value2`\n\n`string-mapping=[key1:value1,key2:value2]`\n\n```java\n    @WithConverter(CustomConverter.class)\n    @ConfigProperty(name = \"string-mapping\")\n    Map<String, String> mapMapping;\n```\n\n```java\npublic class CustomConverter implements Converter<Map<String, String>> {\n@Override\n    public Map<String, String> convert(String text) {\n        return Arrays.stream(text.split(\",\"))\n                .map(entry -> entry.split(\":\"))\n                .collect(Collectors.toMap(entry -> entry[0].trim(), entry -> entry[1].trim()));\n    }\n}\n```\n\nquarkusPlatformVersion=3.18.4\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/2678498290/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"heywobu","id":32598726,"node_id":"MDQ6VXNlcjMyNTk4NzI2","avatar_url":"https://avatars.githubusercontent.com/u/32598726?v=4","gravatar_id":"","url":"https://api.github.com/users/heywobu","html_url":"https://github.com/heywobu","followers_url":"https://api.github.com/users/heywobu/followers","following_url":"https://api.github.com/users/heywobu/following{/other_user}","gists_url":"https://api.github.com/users/heywobu/gists{/gist_id}","starred_url":"https://api.github.com/users/heywobu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/heywobu/subscriptions","organizations_url":"https://api.github.com/users/heywobu/orgs","repos_url":"https://api.github.com/users/heywobu/repos","events_url":"https://api.github.com/users/heywobu/events{/privacy}","received_events_url":"https://api.github.com/users/heywobu/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/2681822639","html_url":"https://github.com/quarkusio/quarkus/issues/46170#issuecomment-2681822639","issue_url":"https://api.github.com/repos/quark