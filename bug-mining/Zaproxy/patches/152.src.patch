+			@Override
+			public void actionPerformed(java.awt.event.ActionEvent evt) {
+				Control.getSingleton().setMode(modeType);
+				View.getSingleton().getMainFrame().getMainToolbarPanel().setMode(modeType);
+			}
+		});
+		return modeItem;
+	}
+
+	public void setMode (final Mode mode) {
