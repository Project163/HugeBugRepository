er_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":522,"state":"open","created_at":"2019-06-11T16:37:26Z","updated_at":"2025-06-19T15:15:28Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2021-04-16T21:23:20Z","updated_at":"2021-04-29T21:28:39Z","closed_at":"2021-04-29T21:28:38Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"In sqlalchemy `1.4`, if a custom declarative base class defines an `__iter__` method, then it cannot be used in `select(SomeModel)` unless it's wrapped with a `list`. Otherwise, an exception is raised (see example and traceback below).\r\n\r\nIs this the intended behavior?\r\n\r\n**Example**\r\n\r\n```python\r\nfrom sqlalchemy import create_engine, select\r\nfrom sqlalchemy.orm import declarative_base\r\n\r\nclass Base:\r\n    def __iter__(self):\r\n        # some method to yield key/value tuples for dict(instance) conversion\r\n        data = {k: v for k, v in self.__dict__.items() if not k.startswith(\"_sa_\")}\r\n        yield from data.items()\r\n\r\nBase = declarative_base(cls=Base)\r\n\r\nclass User(Base):\r\n    __tablename__ = \"users\"\r\n    id = sa.Column(sa.Integer(), primary_key=True)\r\n    name = sa.Column(sa.Text())\r\n\r\nengine = create_engine(\"sqlite://\")\r\nBase.metadata.create_all(engine)\r\n\r\nstmt = select([User])  # <-- no error when wrapped with list\r\nstmt = select(User)    # <-- throws error below\r\n```\r\n\r\n**Complete stack trace**\r\n```\r\nTraceback (most recent call last):\r\n  File \"<stdin>\", line 3, in <module>\r\n  File \"<string>\", line 2, in select\r\n  File \"<snip>/lib/python3.9/site-packages/sqlalchemy/sql/selectable.py\", line 4893, in _create\r\n    return cls.create_legacy_select(*args, **kw)\r\n  File \"<string>\", line 2, in create_legacy_select\r\n  File \"<snip>/lib/python3.9/site-packages/sqlalchemy/util/deprecations.py\", line 390, in warned\r\n    return fn(*args, **kwargs)\r\n  File \"<snip>/lib/python3.9/site-packages/sqlalchemy/sql/selectable.py\", line 4771, in create_legacy_select\r\n    self._raw_columns = [\r\nTypeError: 'DeclarativeMeta' object is not iterable\r\n```\r\n\r\n**Versions**\r\n - OS: MacOS 11.2.3\r\n - Python: 3.9.4\r\n - SQLAlchemy: 1.4.8\r\n - Database: sqlite3\r\n - DBAPI: sqlite3\r\n","closed_by":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/6300/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/6300/timeline","performed_via_github_app":null,"state_reason":"completed"}