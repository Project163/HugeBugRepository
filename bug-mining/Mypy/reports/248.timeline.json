web_commit_signoff_required":false,"topics":["linter","python","typechecker","types","typing"],"visibility":"public","forks":3065,"open_issues":3124,"watchers":20064,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"I'm a relatively new user to mypy, and I have a quick bit of feedback / suggestion:\r\n\r\n(Tangentially related to #2783 and/or #2782)\r\n\r\nI see this error message:\r\n\r\n```\r\nerror: Return type of \"__iter__\" incompatible with supertype \"Iterable\"\r\n```\r\n\r\nIt would be really helpful if the message specified what the return type is, and more helpfully, what mypy thinks it should be.\r\n\r\nThis is particularly helpful in the context of generic/templated types like `Iterable`, where reading the definition of the type doesn't immediately give you the answer.  In other words: \"Oh no!  I have to think!\" 😃 ","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/2797/reactions","total_count":6,"+1":6,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/mypy/issues/2797/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":967783601,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDk2Nzc4MzYwMQ==","url":"https://api.github.com/repos/python/mypy/issues/events/967783601","actor":{"login":"sixolet","id":1633505,"node_id":"MDQ6VXNlcjE2MzM1MDU=","avatar_url":"https://avatars.githubusercontent.com/u/1633505?v=4","gravatar_id":"","url":"https://api.github.com/users/sixolet","html_url":"https://github.com/sixolet","followers_url":"https://api.github.com/users/sixolet/followers","following_url":"https://api.github.com/users/sixolet/following{/other_user}","gists_url":"https://api.github.com/users/sixolet/gists{/gist_id}","starred_url":"https://api.github.com/users/sixolet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sixolet/subscript