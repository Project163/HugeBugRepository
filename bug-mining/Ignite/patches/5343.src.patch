+            A.notNull(job, "job");
+            A.ensure(!cacheNames.isEmpty(), "cachesNames mustn't be empty");
+            CU.validateCacheNames(cacheNames);
+
+            return ctx.closure().affinityRun(cacheNames, affKey, job, opts.get());
+        }
+        catch (IgniteCheckedException e) {
