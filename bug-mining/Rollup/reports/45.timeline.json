_url":"https://api.github.com/repos/rollup/rollup/deployments","created_at":"2015-05-14T22:26:28Z","updated_at":"2025-12-12T17:56:35Z","pushed_at":"2025-12-12T22:55:35Z","git_url":"git://github.com/rollup/rollup.git","ssh_url":"git@github.com:rollup/rollup.git","clone_url":"https://github.com/rollup/rollup.git","svn_url":"https://github.com/rollup/rollup","homepage":"https://rollupjs.org","size":33211,"stargazers_count":26142,"watchers_count":26142,"language":"JavaScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":1656,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":611,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":[],"visibility":"public","forks":1656,"open_issues":611,"watchers":26142,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Examine the following case:\n\n```\n// main.js\nimport { func } from './func.js';\n\n// func.js\nexport function func ( ) {\n}\n\nexport var func;\n```\n\nThe compiled output is:\n\n```\n'use strict';\n\nvar func;\n\nfunc();\n```\n\nHowever, this is incorrect because a `var` statement without an assignment, defining a pre-existing identifier is essentially a no-op. The correct behavior should shake the successive null var statements, but leave in the function definition.\n\nThis is concrete problem because when using TypeScript's module merging feature (i.e. merging a function with a module), a `var` statement is emitted before the module which causes the preceding function to be shaken off.\n","reactions":{"url":"https://api.github.com/repos/rollup/rollup/issues/820/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/rollup/rollup/issues/820/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]