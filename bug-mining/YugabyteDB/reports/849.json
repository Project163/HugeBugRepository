s/area/docdb","name":"area/docdb","color":"0c4fcc","default":false,"description":"YugabyteDB core features"},{"id":1353907004,"node_id":"MDU6TGFiZWwxMzUzOTA3MDA0","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/priority/high","name":"priority/high","color":"ffdc5e","default":false,"description":"High Priority"},{"id":4199362411,"node_id":"LA_kwDOBlCVUc76TS9r","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/2.14%20Backport%20Required","name":"2.14 Backport Required","color":"bfdadc","default":false,"description":""},{"id":4721920290,"node_id":"LA_kwDOBlCVUc8AAAABGXLJIg","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/2.16%20Backport%20Required","name":"2.16 Backport Required","color":"24F4C7","default":false,"description":""}],"state":"closed","locked":false,"assignee":{"login":"mbautin","id":552936,"node_id":"MDQ6VXNlcjU1MjkzNg==","avatar_url":"https://avatars.githubusercontent.com/u/552936?v=4","gravatar_id":"","url":"https://api.github.com/users/mbautin","html_url":"https://github.com/mbautin","followers_url":"https://api.github.com/users/mbautin/followers","following_url":"https://api.github.com/users/mbautin/following{/other_user}","gists_url":"https://api.github.com/users/mbautin/gists{/gist_id}","starred_url":"https://api.github.com/users/mbautin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mbautin/subscriptions","organizations_url":"https://api.github.com/users/mbautin/orgs","repos_url":"https://api.github.com/users/mbautin/repos","events_url":"https://api.github.com/users/mbautin/events{/privacy}","received_events_url":"https://api.github.com/users/mbautin/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"mbautin","id":552936,"node_id":"MDQ6VXNlcjU1MjkzNg==","avatar_url":"https://avatars.githubusercontent.com/u/552936?v=4","gravatar_id":"","url":"https://api.github.com/users/mbautin","html_url":"https://github.com/mbautin","followers_url":"https://api.github.com/users/mbautin/followers","following_url":"https://api.github.com/users/mbautin/following{/other_user}","gists_url":"https://api.github.com/users/mbautin/gists{/gist_id}","starred_url":"https://api.github.com/users/mbautin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mbautin/subscriptions","organizations_url":"https://api.github.com/users/mbautin/orgs","repos_url":"https://api.github.com/users/mbautin/repos","events_url":"https://api.github.com/users/mbautin/events{/privacy}","received_events_url":"https://api.github.com/users/mbautin/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":5,"created_at":"2022-12-16T21:53:34Z","updated_at":"2023-09-28T20:15:21Z","closed_at":"2023-09-28T20:15:21Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Jira Link: [DB-4496](https://yugabyte.atlassian.net/browse/DB-4496)\r\n### Description\r\n\r\nCopying to colocated table (without packed rows enabled) is very slow on a large rows_per_transaction. Specifically, when large rows per transaction is used by copy command, the average write latency increases substantially.\r\nThe increasing write latencies at the tablet server indicate that the latency is coming from docdb. See image below. \r\n\r\n\r\n<img width=\"570\" alt=\"Screenshot 2022-12-16 at 1 23 55 PM\" src=\"https://user-images.githubusercontent.com/96742848/208192600-9fcc1667-f156-4af4-8e91-261a9a1c0bf8.png\">\r\n\r\n**To reproduce the issue**\r\n\r\n```\r\nCREATE TABLE cast_info (\r\n    id integer NOT NULL PRIMARY KEY,\r\n     person_id integer NOT NULL,\r\n     movie_id integer NOT NULL,\r\n     person_role_id integer,\r\n     note text,\r\n     nr_order integer,\r\n     role_id integer NOT NULL\r\n) WITH (colocated = true);\r\n```\r\n\r\nCopy the data:\r\n`copy cast_info from '/home/yugabyte/imdb/cast_info.csv' with (format csv, rows_per_transaction 20000);`\r\n\r\nAttached file:\r\nhttps://drive.google.com/file/d/1S6dBhVBKyGOAhCRDaNz3TOKM7GZvBscK/view?usp=share_link\r\n\r\n The hypothesis is, that on a colocated table, all write batches go to 1 tablet, For a batch size of 20,000 and 5 column table, 100k (20k * 5) key values are inserted in 1 batch to doc db, where as in the non-colocated case, the 100k key values are inserted to 8 tablets in parallel (for Linh’s RF-1 experiment). For all the KVs, the intent checks and various other checks needs to be made, which increase the latency. With packed row, the size of the batch was getting reduced from 100K to 20K, and thus packed_row helped reduce the latency. While we continue to look at the cause of latency - potentially the intent aware iterator.\r\n\r\nThe hypothesis is, on a colocated table, all write batches go to the same tablet, and performing intent checker on the same tablet gets increasingly slower as the batch size increases.\r\n\r\nThe short term solution is to reduce the batch size to a reasonable value until this issue is fixed.\r\n\r\n[DB-4496]: https://yugabyte.atlassian.net/browse/DB-4496?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","closed_by":{"login":"rthallamko3","id":17170123,"node_id":"MDQ6VXNlcjE3MTcwMTIz","avatar_url":"https://avatars.githubusercontent.com/u/17170123?v=4","gravatar_id":"","url":"https://api.github.com/users/rthallamko3","html_url":"https://github.com/rthallamko3","followers_url":"https://api.github.com/users/rthallamko3/followers","following_url":"https://api.github.com/users/rthallamko3/following{/other_user}","gists_url":"https://api.github.com/users/rthallamko3/gists{/gist_id}","starred_url":"https://api.github.com/users/rthallamko3/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rthallamko3/subscriptions","organizations_url":"https://api.github.com/users/rthallamko3/orgs","repos_url":"https://api.github.com/users/rthallamko3/repos","events_url":"https://api.github.com/users/rthallamko3/events{/privacy}","received_events_url":"https://api.github.com/users/rthallamko3/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/15362/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/15362/timeline","performed_via_github_app":null,"state_reason":"completed"}