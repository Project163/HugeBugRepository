ython3.13/site-packages/pandas/core/algorithms.py\", line 595, in factorize_array\n    uniques, codes = table.factorize(\n                     ~~~~~~~~~~~~~~~^\n        values,\n        ^^^^^^^\n    ...<3 lines>...\n        ignore_na=use_na_sentinel,\n        ^^^^^^^^^^^^^^^^^^^^^^^^^^\n    )\n    ^\n  File \"pandas/_libs/hashtable_class_helper.pxi\", line 7281, in pandas._libs.hashtable.PyObjectHashTable.factorize\n  File \"pandas/_libs/hashtable_class_helper.pxi\", line 7195, in pandas._libs.hashtable.PyObjectHashTable._unique\nTypeError: unhashable type: 'list'\n```\n\n### Is this a regression?\n\n- [x] Yes, this used to work in a previous version.\n\n### Debug info\n\n- Streamlit version: 1.44.0\n- Python version: 3.13\n- Operating System: Fedora 41\n- Browser: Firefox 136.0.3\n\n\n### Additional Information\n\n_No response_","reactions":{"url":"https://api.github.com/repos/streamlit/streamlit/issues/10957/reactions","total_count":12,"+1":12,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/streamlit/streamlit/issues/10957/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"}]