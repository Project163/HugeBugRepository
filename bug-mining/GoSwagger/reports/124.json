pe":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2017-10-04T13:03:53Z","updated_at":"2018-03-06T16:32:46Z","closed_at":"2018-03-06T16:32:46Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Problem statement\r\n\r\nAdding length to a string with `uri` format will result unworkable generated code\r\n\r\n## Swagger specification\r\n\r\n```\r\nswagger: '2.0'\r\ninfo:\r\n  version: '2.0.0'\r\n  title: Thing API\r\n  description: Some description\r\nbasePath: /thing-api\r\nconsumes:\r\n  - application/json\r\nproduces:\r\n  - application/json\r\npaths:\r\n  '/things':\r\n    get:\r\n      operationId: POST_things\r\n      summary: Get a Thing\r\n      description: Create a new thing\r\n      responses:\r\n        '200':\r\n          description: Its all ok\r\n          schema:\r\n            type: object\r\n            properties:\r\n              notification_url:\r\n                $ref: '#/definitions/notification-url'\r\ndefinitions:\r\n  notification-url:\r\n    description: A URL to be notified about the Thing\r\n    type: string\r\n    maxLength: 1000\r\n    format: uri\r\n```\r\n\r\n## Steps to reproduce\r\n\r\n```\r\nswagger generate client --target=src\r\n```\r\n\r\n## Symptom\r\n\r\nThe generated file `src/models/notification_url.go` will contain the following code (in which `m.String()` won't compile because `strfmt.URI` is string):\r\n\r\n```\r\ntype NotificationURL strfmt.URI\r\n\r\n// Validate validates this notification url\r\nfunc (m NotificationURL) Validate(formats strfmt.Registry) error {\r\n\tvar res []error\r\n\r\n\tif err := validate.MaxLength(\"\", \"body\", string(m), 1000); err != nil {\r\n\t\treturn err\r\n\t}\r\n\r\n\tif err := validate.FormatOf(\"\", \"body\", \"uri\", m.String(), formats); err != nil {\r\n\t\treturn err\r\n\t}\r\n```\r\n\r\n## Environment\r\nswagger version:\r\nversion: 0.12.0\r\ncommit: 8135eb6728e43b73489e80f94426e6d387809502\r\n\r\ngo version:\r\ngo version go1.9 darwin/amd64\r\n","closed_by":{"login":"casualjim","id":456109,"node_id":"MDQ6VXNlcjQ1NjEwOQ==","avatar_url":"https://avatars.githubusercontent.com/u/456109?v=4","gravatar_id":"","url":"https://api.github.com/users/casualjim","html_url":"https://github.com/casualjim","followers_url":"https://api.github.com/users/casualjim/followers","following_url":"https://api.github.com/users/casualjim/following{/other_user}","gists_url":"https://api.github.com/users/casualjim/gists{/gist_id}","starred_url":"https://api.github.com/users/casualjim/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/casualjim/subscriptions","organizations_url":"https://api.github.com/users/casualjim/orgs","repos_url":"https://api.github.com/users/casualjim/repos","events_url":"https://api.github.com/users/casualjim/events{/privacy}","received_events_url":"https://api.github.com/users/casualjim/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/go-swagger/go-swagger/issues/1191/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/go-swagger/go-swagger/issues/1191/timeline","performed_via_github_app":null,"state_reason":"completed"}