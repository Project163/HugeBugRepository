[{"id":20715035038,"node_id":"LE_lADOCX47u87V45EpzwAAAATStlme","url":"https://api.github.com/repos/sqlalchemy/alembic/issues/events/20715035038","actor":{"login":"fbuccioni","id":1074427,"node_id":"MDQ6VXNlcjEwNzQ0Mjc=","avatar_url":"https://avatars.githubusercontent.com/u/1074427?v=4","gravatar_id":"","url":"https://api.github.com/users/fbuccioni","html_url":"https://github.com/fbuccioni","followers_url":"https://api.github.com/users/fbuccioni/followers","following_url":"https://api.github.com/users/fbuccioni/following{/other_user}","gists_url":"https://api.github.com/users/fbuccioni/gists{/gist_id}","starred_url":"https://api.github.com/users/fbuccioni/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fbuccioni/subscriptions","organizations_url":"https://api.github.com/users/fbuccioni/orgs","repos_url":"https://api.github.com/users/fbuccioni/repos","events_url":"https://api.github.com/users/fbuccioni/events{/privacy}","received_events_url":"https://api.github.com/users/fbuccioni/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2025-11-04T23:39:32Z","label":{"name":"requires triage","color":"ffff00"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/alembic/issues/comments/3491339131","html_url":"https://github.com/sqlalchemy/alembic/issues/1744#issuecomment-3491339131","issue_url":"https://api.github.com/repos/sqlalchemy/alembic/issues/1744","id":3491339131,"node_id":"IC_kwDOCX47u87QGZt7","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-05T13:52:36Z","updated_at":"2025-11-05T13:52:36Z","body":"hi -\n\nthe DROP for default constraints is automatic with alter_column() and SQL Server , because you pass in the existing_default so we know there's a default that has to be dropped.  so there's no boolean, it runs that drop default query automatically.\n\nalso, the mssql_drop_default is a boolean that runs basically the same query that alter_column() does automatically.    so it's just the one query.\n\nIt looks like the issue is if you are changing the type and the default at the same time, the existing defaults need to be dropped before we touch either of those (and in any case there's nothing wrong with dropping the default earlier in the process).\n\ni was able to create a reproducer that can fix this, stay tuned\n\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/alembic/issues/comments/3491339131/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzee