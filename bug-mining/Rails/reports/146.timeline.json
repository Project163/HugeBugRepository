codes/repos","events_url":"https://api.github.com/users/eileencodes/events{/privacy}","received_events_url":"https://api.github.com/users/eileencodes/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/rails/rails/issues/comments/183779325","html_url":"https://github.com/rails/rails/issues/23645#issuecomment-183779325","issue_url":"https://api.github.com/repos/rails/rails/issues/23645","id":183779325,"node_id":"MDEyOklzc3VlQ29tbWVudDE4Mzc3OTMyNQ==","user":{"login":"eileencodes","id":1080678,"node_id":"MDQ6VXNlcjEwODA2Nzg=","avatar_url":"https://avatars.githubusercontent.com/u/1080678?v=4","gravatar_id":"","url":"https://api.github.com/users/eileencodes","html_url":"https://github.com/eileencodes","followers_url":"https://api.github.com/users/eileencodes/followers","following_url":"https://api.github.com/users/eileencodes/following{/other_user}","gists_url":"https://api.github.com/users/eileencodes/gists{/gist_id}","starred_url":"https://api.github.com/users/eileencodes/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eileencodes/subscriptions","organizations_url":"https://api.github.com/users/eileencodes/orgs","repos_url":"https://api.github.com/users/eileencodes/repos","events_url":"https://api.github.com/users/eileencodes/events{/privacy}","received_events_url":"https://api.github.com/users/eileencodes/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-02-14T00:18:36Z","updated_at":"2016-02-14T00:18:36Z","body":"I've investigated a bit and understand why this is happening but not sure yet how to fix it. The problem is with any non-db attribute. So because `password` is an `attr_accessor` and not an attribute of the record `record.changed?` is returning `false`, whereas if it were a db attribute then it would return `true` for `changed?`.\n\nIf the record was considered dirty and the attributes changed this would not have changed behavior. The reason `email_will_change!` works is because it's marking the record as `changed?`. \n\nI'm not sure the best way to fix this yet.\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/rails/rails/issues/comments/183779325/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"eileencodes","id":1080678,"node_id":"MDQ6VXNlcjEwODA2Nzg=","avatar_url":"https://avatars.githubusercontent.com/u/1080678?v=4","gravatar_id":"","url":"https://api.github.com/users/eileencodes","html_url":"https://github.com/eileencodes","followers_url":"https://api.github.com/users/eileencodes/followers","following_url":"https://api.github.com/users/eileencodes/following{/other_user}","gists_url":"https://api.github.com/users/eileencodes/gists{/gist_id}","starred_url":"https://api.github.com/users/eileencodes/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eileencodes/subscriptions","organizations_url":"https://api.github.com/users/eileencodes/orgs","repos_url":"https://api.github.com/users/eileencodes/repos","events_url":"https://api.github.com/users/eileencodes/events{/privacy}","received_events_url":"https://api.github.com/users/eileencodes/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":557572383,"node_id":"MDExOkNsb3NlZEV2ZW50NTU3NTcyMzgz","url":"https://api.github.com/repos/rails/rails/issues/events/557572383","actor":{"login":"eileencodes","id":1080678,"node_id":"MDQ6VXNlcjEwODA2Nzg=","avatar_url":"https://avatars.githubusercontent.com/u/1080678?v=4","gravatar_id":"","url":"https://api.github.com/users/eileencodes","html_url":"https://github.com/eileencodes","followers_url":"https://api.github.com/users/eileencodes/followers","following_url":"https://api.github.com/users/eileencodes/following{/other_user}","gists_url":"https://api.github.com/users/eileencodes/gists{/gist_id}","starred_url":"https://api.github.com/users/eileencodes/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eileencodes/subscriptions","organizations_url":"https://api.github.com/users/eileencodes/orgs","repos_url":"https://api.github.com/users/eileencodes/repos","events_url":"https://api.github.com/users/eileencodes/events{/privacy}","received_events_url":"https://api.github.com/users/eileencodes/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":"6f15b276cb69ae1241e5c021fdc8e73fd3fe1197","commit_url":"https://api.github.com/repos/rails/rails/commits/6f15b276cb69ae1241e5c021fdc8e73fd3fe1197","created_at":"2016-02-20T14:19:45Z","state_reason":null,"performed_via_github_app":null},{"url":"https://api.github.com/repos/rails/rails/issues/comments/186615084","html_url":"https://github.com/rails/rails/issues/23645#issuecomment-186615084","issue_url":"https://api.github.com/repos/rails/rails/issues/23645","id":186615084,"node_id":"MDEyOklzc3VlQ29tbWVudDE4NjYxNTA4NA==","user":{"login":"eileencodes","id":1080678,"node_id":"MDQ6VXNlcjEwODA2Nzg=","avatar_url":"https://avatars.githubusercontent.com/u/1080678?v=4","gravatar_id":"","url":"https://api.github.com/users/eileencodes","html_url":"https://github.com/eileencodes","followers_url":"https://api.github.com/users/eileencodes/followers","following_url":"https://api.github.com/users/eileencodes/following{/other_user}","gists_url":"https://api.github.com/users/eileencodes/gists{/gist_id}","starred_url":"https://api.github.com/users/eileencodes/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eileencodes/subscriptions","organizations_url":"https://api.github.com/users/eileencodes/orgs","repos_url":"https://api.github.com/users/eileencodes/repos","events_url":"https://api.github.com/users/eileencodes/events{/privacy}","received_events_url":"https://api.github.com/users/eileencodes/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-02-20T14:27:32Z","updated_at":"2016-02-20T14:27:32Z","body":"Ok this is fixed in master. There is no way for Rails to know that the record was `record.changed?` or dirty when using a virtual attribute like this. I think we should eventually deprecate this behavior but I talked about it with Aaron and it's not super easy to do that.\n\nWhat I did to fix the issue was check if the changed attribute was in the `record.attributes` hash. If it's not then it's a virtual attribute and we can say always check this record if we don't know about the attribute in the database.\n\nIf you do want to mark your record as dirty when setting a virtual attribute you can use the following code:\n\n``` ruby\ndef password=(value)\n  attribute_will_change!(:password)\n  @password = value\nend\n```\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/rails/rails/issues/comments/186615084/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"eileencodes","id":1080678,"node_id":"MDQ6VXNlcjEwODA2Nzg=","avatar_url":"https://avatars.githubusercontent.com/u/1080678?v=4","gravatar_id":"","url":"https://api.github.com/users/eileencodes","html_url":"https://github.com/eileencodes","followers_url":"https://api.github.com/users/eileencodes/followers","following_url":"https://api.github.com/users/eileencodes/following{/other_user}","gists_url":"https://api.github.com/users/eileencodes/gists{/gist_id}","starred_url":"https://api.github.com/users/eileencodes/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eileencodes/subscriptions","organizations_url":"https://api.github.com/users/eileencodes/orgs","repos_url":"https://api.github.com/users/eileencodes/repos","events_url":"https://api.github.com/users/eileencodes/events{/privacy}","received_events_url":"https://api.github.com/