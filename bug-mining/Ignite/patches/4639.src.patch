-        this.compareStringsOptimized = CompareMode.OFF.equals(compareMode.getName());
-
-        switch (type) {
-            case Value.BOOLEAN:
-            case Value.BYTE:
-                this.size = 1;
-                break;
-
-            case Value.SHORT:
-                this.size = 2;
-                break;
-
-            case Value.INT:
-                this.size = 4;
-                break;
-
-            case Value.LONG:
-                this.size = 8;
-                break;
-
-            case Value.FLOAT:
-                this.size = 4;
-                break;
-
-            case Value.DOUBLE:
-                this.size = 8;
-                break;
-
-            case Value.DATE:
-                this.size = 8;
-                break;
-
-            case Value.TIME:
-                this.size = 8;
-                break;
-
-            case Value.TIMESTAMP:
-                this.size = 16;
-                break;
-
-            case Value.UUID:
