``\r\n\r\n```sh\r\nbin/yb-ctl restart\r\n```\r\n\r\n```sql\r\nSELECT * FROM t; -- returns 3 rows\r\n```\r\n\r\n```sh\r\n/path/to/bin/yb-admin flush_table ysql.yugabyte t\r\n/path/to/bin/sst_dump --output_format=decoded_regulardb --command=scan --file=$(ls -d /path/to/yugabyte-data/node-1/disk-1/yb-data/tserver/data/rocksdb/table-????????????????????????????????.tablegroup.parent.uuid/tablet-????????????????????????????????) # returns several records\r\n/path/to/bin/yb-admin compact_table ysql.yugabyte t\r\n/path/to/bin/sst_dump --output_format=decoded_regulardb --command=scan --file=$(ls -d /path/to/yugabyte-data/node-1/disk-1/yb-data/tserver/data/rocksdb/table-????????????????????????????????.tablegroup.parent.uuid/tablet-????????????????????????????????) # returns no records\r\n```\r\n\r\n```sql\r\nSELECT * FROM t; -- returns 0 rows\r\n```","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/12898/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/12898/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":7378628641,"node_id":"CE_lADOBlCVUc5N1cnDzwAAAAG3zPAh","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/7378628641","actor":{"login":"frozenspider","id":2077017,"node_id":"MDQ6VXNlcjIwNzcwMTc=","avatar_url":"https://avatars.githubusercontent.com/u/2077017?v=4","gravatar_id":"","url":"https://api.github.com/users/frozenspider","html_url":"https://github.com/frozenspider","followers_url":"https://api.github.com/users/frozenspider/followers","following_url":"https://api.github.com/users/frozenspider/following{/other_user}","gists_url":"https://api.github.com/users/frozenspider/gists{/gist_id}","starred_url":"https://api.github.com/users/frozenspider/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/frozenspider/subscrip