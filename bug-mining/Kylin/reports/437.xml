<item>
            <title>[KYLIN-6057] Incorrect Data in Global Dictionary Construction</title>
                <link>https://issues.apache.org/jira/browse/KYLIN-6057</link>
                <project id="12316121" key="KYLIN">Kylin</project>
                    <description>&lt;p&gt;Kylin Query Count Distinct Results Incorrect &#160;&lt;/p&gt;
&lt;h3&gt;&lt;a name=&quot;RootCause&quot;&gt;&lt;/a&gt;Root Cause&lt;/h3&gt;

&lt;p&gt;During high-concurrency builds, slight differences in machine clocks may cause different build tasks to use the same old version of a field for construction, leading to overlapping values in the global dictionary.&lt;/p&gt;</description>
                <environment></environment>
        <key id="13609668">KYLIN-6057</key>
            <summary>Incorrect Data in Global Dictionary Construction</summary>
                <type id="1" iconUrl="https://issues.apache.org/jira/secure/viewavatar?size=xsmall&amp;avatarId=21133&amp;avatarType=issuetype">Bug</type>
