-     */
-    public void setVal(Object obj) {
-        this.val = obj;
-    }
-
-    /**
-     * @return Primary key for Gene
-     */
-    public Long id() {
-        return id;
-    }
-
-    /** {@inheritDoc} */
-    @Override public String toString() {
-        return "Gene [id=" + id + ", value=" + val + "]";
-    }
-
-}
