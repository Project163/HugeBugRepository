+                    downQueries.push(
+                        new Query(
+                            `ALTER TABLE ${this.escapePath(table)} CHANGE \`${
+                                generatedColumn.name
+                            }\` ${this.buildCreateColumnSql(
+                                nonGeneratedColumn,
+                                true,
+                            )}`,
+                        ),
+                    )
