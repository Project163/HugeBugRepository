diff --git a/pylint/test/functional/assignment_from_no_return.py b/pylint/test/functional/assignment_from_no_return.py
new file mode 100644
index 000000000..0ee880f26
--- /dev/null
+++ b/pylint/test/functional/assignment_from_no_return.py
@@ -0,0 +1,18 @@
+# pylint: disable=missing-docstring
+
+
+def some_func():
+    pass
+
+
+class Class:
+
+    def some_method(self):
+        pass
+
+    def some_other_method(self):
+        value = self.some_method()  # [assignment-from-no-return]
+        return value + 1
+
+
+VALUE = some_func() # [assignment-from-no-return]
