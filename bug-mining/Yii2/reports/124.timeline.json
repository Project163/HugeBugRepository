ribers_url":"https://api.github.com/repos/yiisoft/yii2/subscribers","subscription_url":"https://api.github.com/repos/yiisoft/yii2/subscription","commits_url":"https://api.github.com/repos/yiisoft/yii2/commits{/sha}","git_commits_url":"https://api.github.com/repos/yiisoft/yii2/git/commits{/sha}","comments_url":"https://api.github.com/repos/yiisoft/yii2/comments{/number}","issue_comment_url":"https://api.github.com/repos/yiisoft/yii2/issues/comments{/number}","contents_url":"https://api.github.com/repos/yiisoft/yii2/contents/{+path}","compare_url":"https://api.github.com/repos/yiisoft/yii2/compare/{base}...{head}","merges_url":"https://api.github.com/repos/yiisoft/yii2/merges","archive_url":"https://api.github.com/repos/yiisoft/yii2/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/yiisoft/yii2/downloads","issues_url":"https://api.github.com/repos/yiisoft/yii2/issues{/number}","pulls_url":"https://api.github.com/repos/yiisoft/yii2/pulls{/number}","milestones_url":"https://api.github.com/repos/yiisoft/yii2/milestones{/number}","notifications_url":"https://api.github.com/repos/yiisoft/yii2/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/yiisoft/yii2/labels{/name}","releases_url":"https://api.github.com/repos/yiisoft/yii2/releases{/id}","deployments_url":"https://api.github.com/repos/yiisoft/yii2/deployments","created_at":"2012-02-13T15:32:36Z","updated_at":"2025-12-13T02:47:07Z","pushed_at":"2025-12-09T16:34:01Z","git_url":"git://github.com/yiisoft/yii2.git","ssh_url":"git@github.com:yiisoft/yii2.git","clone_url":"https://github.com/yiisoft/yii2.git","svn_url":"https://github.com/yiisoft/yii2","homepage":"http://www.yiiframework.com","size":87780,"stargazers_count":14308,"watchers_count":14308,"language":"PHP","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":6857,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":521,"license":{"key":"bsd-3-clause","name":"BSD 3-Clause \"New\" or \"Revised\" License","spdx_id":"BSD-3-Clause","url":"https://api.github.com/licenses/bsd-3-clause","node_id":"MDc6TGljZW5zZTU="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["framework","hacktoberfest","php","php-framework","yii","yii2"],"visibility":"public","forks":6857,"open_issues":521,"watchers":14308,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"When using `matchCallback` in ACF, an attempt to read `$action->controller->actionParams` or `Yii::$app->controller->actionParams` fails, because these attributes are empty:\n\n![asgwew4hwsr](https://cloud.githubusercontent.com/assets/2903392/8453003/71fd44d2-1ff0-11e5-8f9d-94ac51681c65.png)\n\nCode to reproduce:\n\n``` php\npublic function behaviors()\n{\n    return [\n        'access' => [\n            'class' => AccessControl::className(),\n            'rules' => [\n                [\n                    'allow' => true,\n                    'roles' => ['@'],\n                    'matchCallback' => function ($rule, $action) {\n                        echo 'Yii::$app->controller->actionParams = '.print_r(Yii::$app->controller->actionParams, TRUE);\n                        echo '$action->controller->actionParams = '.print_r($action->controller->actionParams, TRUE);\n                        echo '$action = '.print_r($action, TRUE);\n                        die();\n                    }\n                ],\n            ],\n        ]\n    ];\n}\n```\n\nIs this a bug or by design (or maybe I made a mistake and this shouldn't happen)?\n\nIf by design, then, please, provide any explanation or reason, for which `actionParams` can't be accessed / are empty inside `matchCallback`?\n\nUsing `$_GET` inside `matchCallback` is possible and is some-kind-of workaround, but I consider this solution as not professional one and would like to know, how can I use `actionParams` inside `matchCallback` in ACF or why can't I use it there?\n\nAdditional reading:\n- [Stack Overflow question](http://stackoverflow.com/q/31158386/1469208),\n- [Yii forum post](http://www.yiiframework.com/forum/index.php/topic/64662-reading-action-params-in-acfs-matchcallback)\n","reactions":{"url":"https://api.github.com/repos/yiisoft/yii2/issues/8964/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yiisoft/yii2/issues/8964/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/yiisoft/yii2/issues/comments/206354383","html_url":"https://github.com/yiisoft/yii2/issues/1796#issuecomment-206354383","issue_url":"https://api.github.com/repos/yiisoft/yii2/issues/1796","id":206354383,"node_id":"MDEyOklzc3VlQ29tbWVudDIwNjM1NDM4Mw==","user":{"login":"lukos","id":581018,"node_id":"MDQ6VXNlcjU4MTAxOA==","avatar_url":"https://avatars.githubusercontent.com/u/581018?v=4","gravatar_id":"","url":"https://api.github.com/users/lukos","html_url":"https://github.com/lukos","followers_url":"https://api.github.com/users/lukos/followers","following_url":"https://api.github.com/users/lukos/following{/other_user}","gists_url":"https://api.github.com/users/lukos/gists{/gist_id}","starred_url":"https://api.github.com/users/lukos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lukos/subscriptions","organizations_url":"https://api.github.com/users/lukos/orgs","repos_url":"https://api.github.com/users/lukos/repos","events_url":"https://api.github.com/users/lukos/events{/privacy}","received_events_url":"https://api.github.com/users/lukos/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-04-06T12:47:56Z","updated_at":"2016-04-06T12:47:56Z","body":"getActionParams was useful in Yii 1.1, I could use it to override where my actions got their params from in a REST API, which allowed explicit actions like `public function actionApiMethod1($param1,$param2,$pram3)`, making it easier to document using phpdoc and it worked simply by returning $_POST in getActionParams in my controller class, I also automatically got HTTP 400 if a parameter was missing.\n\nThis doesn't look possible in yii 2 since bindActionParams only looks in the 'get' parameters for action params.\n\nPerhaps this use was missed when yii 2 was created which is why the function no longer looks useful?\n\nNow I have to remove the parameters from the actions and manually get each one from Yii::$app->request (if doing it properly) or $_POST and then manually return HTTP 400 if one of them is missing. This is much more code.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yiisoft/yii2/issues/comments/206354383/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"lukos","id":581018,"node_id":"MDQ6VXNlcjU4MTAxOA==","avatar_url":"https://avatars.githubusercontent.com/u/581018?v=4","gravatar_id":"","url":"https://api.github.com/users/lukos","html_url":"https://github.com/lukos","followers_url":"https://api.github.com/users/lukos/followers","following_url":"https://api.github.com/users/lukos/following{/other_user}","gists_url":"https://api.github.com/users/lukos/gists{/gist_id}","starred_url":"https://api.github.com/users/lukos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lukos/subscriptions","organizations_url":"https://api.github.com/users/lukos/orgs","repos_url":"https://api.github.com/users/lukos/repos","events_url":"https://api.github.com/users/lukos/events{/privacy}","received_events_url":"https://api.github.com/users/lukos/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/yiis