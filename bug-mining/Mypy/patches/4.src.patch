+[case testInitializeGlobalToNone]
+class A: pass
+if 1 > 2:
+    a = A()
+print(a) # None
+
+[case testInitializeMultipleGlobals]
+class A: pass
+if 1 > 2:
+    a = A()
+    x = 1
