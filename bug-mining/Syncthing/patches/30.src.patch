+
+	m.ReplaceWithDelete(cid.LocalID, local1)
+	c0 := m.Changes(cid.LocalID)
+
+	m.ReplaceWithDelete(cid.LocalID, local2)
+	c1 := m.Changes(cid.LocalID)
+	if !(c1 > c0) {
