ssues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":684,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1949,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["hacktoberfest","php","security-analysis","static-analysis","taint-analysis","type-inference"],"visibility":"public","forks":684,"open_issues":1949,"watchers":5784,"default_branch":"6.x","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"My apologies for posting again, but this report is a bit different, even though it's a followup for the https://github.com/vimeo/psalm/issues/2024 and https://github.com/vimeo/psalm/issues/652\r\n\r\nImagine there is the following code\r\n\r\n```php\r\n<?php\r\n\r\nfunction keys(): array\r\n{\r\n  return ['foo', 'bar'];\r\n}\r\n\r\n// no lines above can be changed\r\n\r\nforeach (keys() as $k) {\r\n  echo gettype($k);\r\n}\r\n```\r\n\r\nhttps://psalm.dev/r/156e52eb66\r\n\r\nAs of now it's impossible to type it to pass linting with `totallyTyped` mode.\r\n\r\nThe only way I found (as answered at https://stackoverflow.com/q/57519071/251311) is to use ugly hacks via `array_keys`.\r\n\r\nI believe it's a frequent enough case to support something like\r\n\r\n```php\r\nforeach (keys() as /** @var mixed $k */ $k) {\r\n  echo gettype($k);\r\n}\r\n```","reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/2025/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vimeo/psalm/issues/2025/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]