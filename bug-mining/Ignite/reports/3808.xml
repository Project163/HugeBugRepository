                            <comment id="16926441" author="ignitetcbot" created="Tue, 10 Sep 2019 08:51:29 +0000"  >&lt;div class=&quot;panel&quot; style=&quot;border-color: #ccc;border-style: dashed;border-width: 1px;&quot;&gt;&lt;div class=&quot;panelHeader&quot; style=&quot;border-bottom-width: 1px;border-bottom-style: dashed;border-bottom-color: #ccc;background-color: #D6F7C1;&quot;&gt;&lt;b&gt;Branch: &lt;span class=&quot;error&quot;&gt;&amp;#91;pull/6854/head&amp;#93;&lt;/span&gt; Base: &lt;span class=&quot;error&quot;&gt;&amp;#91;master&amp;#93;&lt;/span&gt; : No blockers found!&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;
