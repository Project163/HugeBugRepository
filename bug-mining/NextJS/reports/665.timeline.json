_template":false,"web_commit_signoff_required":false,"topics":["blog","browser","compiler","components","hybrid","nextjs","node","react","server-rendering","ssg","static","static-site-generator","universal","vercel"],"visibility":"public","forks":30029,"open_issues":3156,"watchers":136480,"default_branch":"canary","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/vercel/next.js/pulls/64923","html_url":"https://github.com/vercel/next.js/pull/64923","diff_url":"https://github.com/vercel/next.js/pull/64923.diff","patch_url":"https://github.com/vercel/next.js/pull/64923.patch","merged_at":"2024-04-23T19:02:43Z"},"body":"We currently have logic spread in multiple places that normalize `nxtP` parameters into their regular names, ie `nxtPfoo` -> `foo`. However we don't apply this same logic to `nxtI`, which conceptually is another parameter but for route interception. As a result, the interception route would 404 when deployed because it'd be missing the interception parameter.\r\n\r\nThis moves the normalization check into a util and updates the spots I could find where we handle `nxtP` to also handle `nxtI`.\r\n\r\n### Test Plan\r\nAdded a new test, and validated via these deploys:\r\n\r\n**Working**: [Link](https://vtest314-e2e-tests-m889gxi4p-vtest314-ijjk-testing.vercel.app/)\r\n**Non-Working**: [Link](https://vtest314-e2e-tests-8sa5t9uau-vtest314-ijjk-testing.vercel.app/)\r\n\r\nFixes #62207\r\nCloses NEXT-3204","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/64923/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vercel/next.js/issues/64923/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":12580372670,"node_id":"CE_lADOBC3Cis5_mQbWzwAAAALt2UC-","url":"https://api.github.com/repos/vercel/next.js/issues/events/