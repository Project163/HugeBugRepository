thub.com/repos/angular/angular/downloads","issues_url":"https://api.github.com/repos/angular/angular/issues{/number}","pulls_url":"https://api.github.com/repos/angular/angular/pulls{/number}","milestones_url":"https://api.github.com/repos/angular/angular/milestones{/number}","notifications_url":"https://api.github.com/repos/angular/angular/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/angular/angular/labels{/name}","releases_url":"https://api.github.com/repos/angular/angular/releases{/id}","deployments_url":"https://api.github.com/repos/angular/angular/deployments","created_at":"2014-09-18T16:12:01Z","updated_at":"2026-03-11T09:04:53Z","pushed_at":"2026-03-10T23:39:43Z","git_url":"git://github.com/angular/angular.git","ssh_url":"git@github.com:angular/angular.git","clone_url":"https://github.com/angular/angular.git","svn_url":"https://github.com/angular/angular","homepage":"https://angular.dev","size":616697,"stargazers_count":100154,"watchers_count":100154,"language":"TypeScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":27110,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1141,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["angular","javascript","pwa","typescript","web","web-framework","web-performance"],"visibility":"public","forks":27110,"open_issues":1141,"watchers":100154,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"# 🐞 bug report\r\n\r\n### Affected Package\r\nAngular compiler\r\n\r\n### Is this a regression?\r\nDon't know\r\n\r\n### Description\r\nLet's have an angular library containing components and compiled by Ivy (enableIvy: true). Let's assume the library's module imports (in ES6 sense) an invalid module and add it to the module's imports  (this can happen easily either as a typo, or result of 3rd party modules being renamed / deprecated).\r\n\r\nWith the ivy compiler, we get correct report about invalid import, but after that the compiler reports every single custom component, pipeline and attribute used by the library's components. This can be easily thousands of lines.\r\n\r\nWhen ivy is disabled, we get property only the import error. The error message itself is confusing, _\"Unexpected value 'XY in XYZ' imported by the module 'TestlibModule in DIRtestlib.module.ts'. Please add a @NgModule annotation.\"_\r\nbut at least it's not drowned in the rest.\r\n\r\nFrom my tests it seems this is a problem only when compiling libraries, not applications.\r\n\r\n## 🔬 Minimal Reproduction\r\nCreate the default angular library using angular schematics, enable ivy, and modify the library's module to something like: \r\n<pre><code>\r\nimport { NgModule } from '@angular/core';\r\nimport { bla } from \"@angular/common\";\r\nimport { TestlibComponent } from './testlib.component';\r\nimport { CommonModule } from \"@angular/common\";\r\nimport { RouterModule } from \"@angular/router\";\r\nimport { FormsModule, ReactiveFormsModule } from \"@angular/forms\";\r\n\r\n@NgModule({\r\n  imports: [\r\n    bla,\r\n    CommonModule,\r\n    RouterModule,\r\n    FormsModule,\r\n    ReactiveFormsModule,\r\n  ],\r\n  exports: [\r\n    TestlibComponent\r\n  ],\r\n  declarations: [\r\n    TestlibComponent\r\n  ]\r\n})\r\nexport class TestlibModule { }\r\n`\r\n</code></pre>\r\nIn addition, TestComponent should use for example the async pipe, or ngModel\r\n\r\n\r\n## 🌍  Your Environment\r\n\r\n**Angular Version:**\r\n<pre><code>\r\n@angular-devkit/architect          0.900.0-rc.6\r\n@angular-devkit/build-angular      0.900.0-rc.6\r\n@angular-devkit/build-ng-packagr   0.900.0-rc.6\r\n@angular-devkit/build-optimizer    0.900.0-rc.6\r\n@angular-devkit/build-webpack      0.900.0-rc.6\r\n@angular-devkit/core               9.0.0-rc.6\r\n@angular-devkit/schematics         9.0.0-rc.6\r\n@ngtools/webpack                   9.0.0-rc.6\r\n@schematics/angular                9.0.0-rc.6\r\n@schematics/update                 0.900.0-rc.6\r\nng-packagr                         9.0.0-rc.2\r\nrxjs                               6.5.3\r\ntypescript                         3.6.4\r\nwebpack       \r\n<!-- ✍️-->\r\n\r\n</code></pre>\r\n","reactions":{"url":"https://api.github.com/repos/angular/angular/issues/34396/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/angular/angular/issues/34396/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/angular/angular/issues/comments/566213120","html_url":"https://github.com/angular/angular/issues/33849#issuecomment-566213120","issue_url":"https://api.github.com/repos/angular/angular/issues/33849","id":566213120,"node_id":"MDEyOklzc3VlQ29tbWVudDU2NjIxMzEyMA==","user":{"login":"JoostK","id":123679,"node_id":"MDQ6VXNlcjEyMzY3OQ==","avatar_url":"https://avatars.githubusercontent.com/u/123679?v=4","gravatar_id":"","url":"https://api.github.com/users/JoostK","html_url":"https://github.com/JoostK","followers_url":"https://api.github.com/users/JoostK/followers","following_url":"https://api.github.com/users/JoostK/following{/other_user}","gists_url":"https://api.github.com/users/JoostK/gists{/gist_id}","starred_url":"https://api.github.com/users/JoostK/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JoostK/subscriptions","organizations_url":"https://api.github.com/users/JoostK/orgs","repos_url":"https://api.github.com/users/JoostK/repos","events_url":"https://api.github.com/users/JoostK/events{/privacy}","received_eve