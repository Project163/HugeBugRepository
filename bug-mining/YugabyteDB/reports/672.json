ription":"YugabyteDB core features"},{"id":1419821900,"node_id":"MDU6TGFiZWwxNDE5ODIxOTAw","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/priority/medium","name":"priority/medium","color":"ffdc5e","default":false,"description":"Medium priority issue"}],"state":"closed","locked":false,"assignee":{"login":"spolitov","id":891914,"node_id":"MDQ6VXNlcjg5MTkxNA==","avatar_url":"https://avatars.githubusercontent.com/u/891914?v=4","gravatar_id":"","url":"https://api.github.com/users/spolitov","html_url":"https://github.com/spolitov","followers_url":"https://api.github.com/users/spolitov/followers","following_url":"https://api.github.com/users/spolitov/following{/other_user}","gists_url":"https://api.github.com/users/spolitov/gists{/gist_id}","starred_url":"https://api.github.com/users/spolitov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/spolitov/subscriptions","organizations_url":"https://api.github.com/users/spolitov/orgs","repos_url":"https://api.github.com/users/spolitov/repos","events_url":"https://api.github.com/users/spolitov/events{/privacy}","received_events_url":"https://api.github.com/users/spolitov/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"spolitov","id":891914,"node_id":"MDQ6VXNlcjg5MTkxNA==","avatar_url":"https://avatars.githubusercontent.com/u/891914?v=4","gravatar_id":"","url":"https://api.github.com/users/spolitov","html_url":"https://github.com/spolitov","followers_url":"https://api.github.com/users/spolitov/followers","following_url":"https://api.github.com/users/spolitov/following{/other_user}","gists_url":"https://api.github.com/users/spolitov/gists{/gist_id}","starred_url":"https://api.github.com/users/spolitov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/spolitov/subscriptions","organizations_url":"https://api.github.com/users/spolitov/orgs","repos_url":"https://api.github.com/users/spolitov/repos","events_url":"https://api.github.com/users/spolitov/events{/privacy}","received_events_url":"https://api.github.com/users/spolitov/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"rthallamko3","id":17170123,"node_id":"MDQ6VXNlcjE3MTcwMTIz","avatar_url":"https://avatars.githubusercontent.com/u/17170123?v=4","gravatar_id":"","url":"https://api.github.com/users/rthallamko3","html_url":"https://github.com/rthallamko3","followers_url":"https://api.github.com/users/rthallamko3/followers","following_url":"https://api.github.com/users/rthallamko3/following{/other_user}","gists_url":"https://api.github.com/users/rthallamko3/gists{/gist_id}","starred_url":"https://api.github.com/users/rthallamko3/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rthallamko3/subscriptions","organizations_url":"https://api.github.com/users/rthallamko3/orgs","repos_url":"https://api.github.com/users/rthallamko3/repos","events_url":"https://api.github.com/users/rthallamko3/events{/privacy}","received_events_url":"https://api.github.com/users/rthallamko3/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":2,"created_at":"2020-02-01T01:07:14Z","updated_at":"2022-10-24T22:44:50Z","closed_at":"2022-10-24T22:44:50Z","author_association":"COLLABORATOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Jira Link: [DB-2216](https://yugabyte.atlassian.net/browse/DB-2216)\r\nPacking columns into a single RocksDB entry per row instead of one per column (as we do currently) improves YSQL performance. Below is a table of benchmark results using a `JSONB` column as a proxy for a packed representation on disk.\r\n\r\n## Setup\r\nIn this setup, there are two tables A and B (each with 128 columns). For each row in A, there are 4 rows in B. Consider the following two different way of creating A and B:\r\n\r\n1. A1 and B1 both have 128 column each.\r\n2. A2 and B2 have around 15 of the original columns each, and one additional column of type `JSONB` containing the key-value attributes of the remaining columns. This last column can be used to simulate a packed column representation.\r\n\r\n## Inserts\r\nThe following was observed when performing concurrent inserts from multiple clients.\r\n\r\n| Table Name  | Num Indexes | Batch Size| Num Clients | Throughput | \r\n| ------------ | ------------- |----------- | ------------ | ------------ | \r\n| A1                 |  0                    |    0              |   32               |   1.5K           |\r\n| A2                |  0                    |    0              |   32               |   2.8K           |\r\n| A1                 |  2                    |    20            |   8                 |   1.5K           |\r\n| A2                |  2                    |    20             |    8               |  3K               |\r\n\r\n## Queries\r\n\r\n| Table Name  | Operation Type | Num Clients | Throughput | Latency        |\r\n| ------------ | ---------------- |----------- | -------------- | ------------ | \r\n| A1                 | JOIN on A1, B1    |   128           |   4K                 |      32ms         |\r\n| A2                |  JOIN on A2, B2   |   128          |   10K                |      15ms         |\r\n| A1                 |  PK QUERY on A1 |   128         |   14K                |        6ms        |\r\n| A2                |  PK QUERY on A2 |   128         |  28K                 |        4ms       |\n","closed_by":{"login":"rthallamko3","id":17170123,"node_id":"MDQ6VXNlcjE3MTcwMTIz","avatar_url":"https://avatars.githubusercontent.com/u/17170123?v=4","gravatar_id":"","url":"https://api.github.com/users/rthallamko3","html_url":"https://github.com/rthallamko3","followers_url":"https://api.github.com/users/rthallamko3/followers","following_url":"https://api.github.com/users/rthallamko3/following{/other_user}","gists_url":"https://api.github.com/users/rthallamko3/gists{/gist_id}","starred_url":"https://api.github.com/users/rthallamko3/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rthallamko3/subscriptions","organizations_url":"https://api.github.com/users/rthallamko3/orgs","repos_url":"https://api.github.com/users/rthallamko3/repos","events_url":"https://api.github.com/users/rthallamko3/events{/privacy}","received_events_url":"https://api.github.com/users/rthallamko3/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/3520/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/3520/timeline","performed_via_github_app":null,"state_reason":"completed"}