-03-11T08:59:28Z","git_url":"git://github.com/nodejs/node.git","ssh_url":"git@github.com:nodejs/node.git","clone_url":"https://github.com/nodejs/node.git","svn_url":"https://github.com/nodejs/node","homepage":"https://nodejs.org","size":1438369,"stargazers_count":116250,"watchers_count":116250,"language":"JavaScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":34987,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":2514,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["javascript","js","linux","macos","mit","node","nodejs","runtime","windows"],"visibility":"public","forks":34987,"open_issues":2514,"watchers":116250,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/nodejs/node/pulls/55858","html_url":"https://github.com/nodejs/node/pull/55858","diff_url":"https://github.com/nodejs/node/pull/55858.diff","patch_url":"https://github.com/nodejs/node/pull/55858.patch","merged_at":"2024-11-17T10:25:12Z"},"body":"Fixes #55849\r\n\r\nPreviously, the properties from the global `Date`, including the not-writable `isMock` and `[kMock]` values, would be copied if the global `Date` was already mocked. This became an issue because the mock setup would attempt overwrite these properties.\r\n\r\nNow, `ERR_INVALID_STATE` is thrown, as `Date is already being mocked!`.\r\n\r\n## Example\r\n\r\n```js\r\nimport { test } from 'node:test'\r\n\r\ntest((outer) => {\r\n    outer.mock.timers.enable()\r\n    test((inner) => inner.mock.timers.enable())\r\n});\r\n```\r\n\r\n### Before\r\n```\r\n✖ <anonymous> (0.536701ms)\r\n  TypeError: Cannot redefine property: Symbol(MockTimers)\r\n      at defineProperties (<anonymous>)\r\n      at #createDate (node:internal/test_runner/mock/mock_timers:396:5)\r\n      at Object.Date (node:internal/test_runner/mock/mock_timers:635:45)\r\n      at node:internal/test_runner/mock/mock_timers:659:74\r\n      at Array.forEach (<anonymous>)\r\n      at #toggleEnableTimers (node:internal/test_runner/mock/mock_timers:659:5)\r\n      at MockTimers.enable (node:internal/test_runner/mock/mock_timers:740:29)\r\n      at TestContext.<anonymous> (file:///repro.js:5:39)\r\n      at Test.runInAsyncScope (node:async_hooks:211:14)\r\n      at Test.run (node:internal/test_runner/test:934:25)\r\n```\r\n\r\n### After\r\n```\r\n✖ <anonymous> (0.573319ms)\r\n  Error [ERR_INVALID_STATE]: Invalid state: Date is already being mocked!\r\n      at #createDate (node:internal/test_runner/mock/mock_timers:332:13)\r\n      at Object.Date (node:internal/test_runner/mock/mock_timers:638:45)\r\n      at node:internal/test_runner/mock/mock_timers:662:74\r\n      at Array.forEach (<anonymous>)\r\n      at #toggleEnableTimers (node:internal/test_runner/mock/mock_timers:662:5)\r\n      at MockTimers.enable (node:internal/test_runner/mock/mock_timers:743:29)\r\n      at TestContext.<anonymous> (file:///repro.js:5:39)\r\n      at Test.runInAsyncScope (node:async_hooks:211:14)\r\n      at Test.run (node:internal/test_runner/test:934:25)\r\n      at Test.start (node:internal/test_runner/test:833:17) {\r\n    code: 'ERR_INVALID_STATE'\r\n  }\r\n```","reactions":{"url":"https://api.github.com/repos/nodejs/node/issues/55858/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/nodejs/node/issues/55858/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/nodejs/node/issues/comments/2477586025","html_url":"https://github.com/nodejs/node/issues/55849#issuecomment-2477586025","is