+            "post",
+            new TableForeignKey({
+                columnNames: ["authorId"],
+                referencedTableName: "author",
+                referencedColumnNames: ["id"],
+            }),
+        )
+        await queryRunner.dropColumn("post", "authorId")
+    }
+}
