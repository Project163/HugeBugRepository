-
-            List<String> lines = new LinkedList<>();
-
-            String line;
-
-            int i = 0;
-
-            while ((line = reader.readLine()) != null) {
-                i++;
-
-                if (from != -1 && i - 1 < from)
-                    continue;
-
-                if (to != -1 && i - 1 > to)
