t.com/13721712/229354954-6dfc3a13-8d04-44d2-bbe9-8cdd7f5e7c6f.png)\r\n\r\n![image](https://user-images.githubusercontent.com/13721712/229354980-48db3f81-ad34-4d03-a5f7-2dc09b588725.png)\r\n\r\n![image](https://user-images.githubusercontent.com/13721712/229498150-70b8c2f8-f51f-4c7c-a0cc-2decc91af687.png)\r\n\r\n![image](https://user-images.githubusercontent.com/13721712/229498180-2f75cd76-81ce-47aa-80d0-17c38cab789b.png)\r\n\r\n![image](https://user-images.githubusercontent.com/13721712/229498210-a5191947-f816-42f4-a086-201d61f9c8c3.png)\r\n\r\n\r\n### TODO\r\n\r\n* [x] Make sure it is working for both pushes to a new branch on the same repo and on a fork\r\n* [x] Actually show the message on the dashboard\r\n* [x] Hide pushes to the default branch since it does not make sense to create PRs for that _unless_ the push was made to a forked repo\r\n* [x] Include the time when the push happened in the message\r\n* [x] Add a screenshot here\r\n\r\nResolves #311, resolves #13196, resolves #23743","reactions":{"url":"https://api.github.com/repos/go-gitea/gitea/issues/14003/reactions","total_count":13,"+1":8,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":4,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/go-gitea/gitea/issues/14003/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":4125258860,"node_id":"MDE3OkRlbWlsZXN0b25lZEV2ZW50NDEyNTI1ODg2MA==","url":"https://api.github.com/repos/go-gitea/gitea/issues/events/4125258860","actor":{"login":"lunny","id":81045,"node_id":"MDQ6VXNlcjgxMDQ1","avatar_url":"https://avatars.githubusercontent.com/u/81045?v=4","gravatar_id":"","url":"https://api.github.com/users/lunny","html_url":"https://github.com/lunny","followers_url":"https://api.github.com/users/lunny/followers","following_url":"https://api.github.com/users/lunny/following{/other_user}","gists_url":"https://api.github.com/users/lunny/gists{/gist_id}","starred_url":"https://api.github.com/users/lunny/starred{/owne