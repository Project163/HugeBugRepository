<item>
            <title>[KYLIN-6016] Kylin5 occasionally encounters ParquetFileFormat class conflicts during builds</title>
                <link>https://issues.apache.org/jira/browse/KYLIN-6016</link>
                <project id="12316121" key="KYLIN">Kylin</project>
                    <description>&lt;p&gt;&lt;span class=&quot;image-wrap&quot; style=&quot;&quot;&gt;&lt;img src=&quot;https://issues.apache.org/jira/secure/attachment/13074859/13074859_image-2025-02-19-14-42-54-238.png&quot; height=&quot;232&quot; width=&quot;549&quot; style=&quot;border: 0px solid black&quot; /&gt;&lt;/span&gt;&lt;/p&gt;</description>
                <environment></environment>
        <key id="13608988">KYLIN-6016</key>
            <summary>Kylin5 occasionally encounters ParquetFileFormat class conflicts during builds</summary>
