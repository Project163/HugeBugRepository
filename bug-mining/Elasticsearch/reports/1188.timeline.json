ue,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":25807,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":5588,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["elasticsearch","java","search-engine"],"visibility":"public","forks":25807,"open_issues":5588,"watchers":76300,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/elastic/elasticsearch/pulls/11768","html_url":"https://github.com/elastic/elasticsearch/pull/11768","diff_url":"https://github.com/elastic/elasticsearch/pull/11768.diff","patch_url":"https://github.com/elastic/elasticsearch/pull/11768.patch","merged_at":"2015-06-30T07:00:59Z"},"body":"When using compression over the network, you might sometimes see warnings that\nthe stream was not fully read. This is because DeflaterOutputStream adds an\nend-of-stream marker. When deserializing, we need to poll for one byte using\nInputStream.read() to make sure to decode this EOS marker.\n\nFor the record, it does not strike all the time today because we perform\nbuffering when decompressing to avoid performing too many JNI calls, but it\nis easy to make this warning happen all the time by decreasing the size of\nthe buffer we use.\n\nClose #11748\n","reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/11768/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/elastic/elasticsearch/issues/11768/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":343862489,"node_id":"MDExOkNsb3NlZEV2ZW50MzQzODYyNDg5","url":"https://api.