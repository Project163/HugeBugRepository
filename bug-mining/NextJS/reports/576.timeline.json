universal","vercel"],"visibility":"public","forks":30029,"open_issues":3156,"watchers":136480,"default_branch":"canary","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/vercel/next.js/pulls/59273","html_url":"https://github.com/vercel/next.js/pull/59273","diff_url":"https://github.com/vercel/next.js/pull/59273.diff","patch_url":"https://github.com/vercel/next.js/pull/59273.patch","merged_at":"2023-12-05T16:47:40Z"},"body":"### What?\r\nUsing an interception marker next to a dynamic segment does not behave properly when deployed to Vercel\r\n\r\n### Why?\r\nThe named route regex that gets created is not accounting for the interception marker, which is causing the non-intercepted route to match the intercepted serverless function.\r\n\r\n### How?\r\nThis factors in the interception marker when building the named route regex so that the non-intercepted route regex properly matches when loading the non-intercepted page. \r\n\r\nDeployment verified here: https://test-intercept-mu.vercel.app/\r\n\r\nCloses NEXT-1786\r\nFixes #54650\r\n","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/59273/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vercel/next.js/issues/59273/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":11156262272,"node_id":"CE_lADOBC3Cis5vZ5mmzwAAAAKY9w2A","url":"https://api.github.com/repos/vercel/next.js/issues/events/11156262272","actor":{"login":"ztanner","id":1939140,"node_id":"MDQ6VXNlcjE5MzkxNDA=","avatar_url":"https://avatars.githubusercontent.com/u/1939140?v=4","gravatar_id":"","url":"https://api.github.com/users/ztanner","html_url":"https://github.com/ztanner","followers_url":"https://api.github.com/users/ztanner/followers","following_url":"https://api.github.com/users/ztanner/following{/ot