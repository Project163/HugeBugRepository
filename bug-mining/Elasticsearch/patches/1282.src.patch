+                    .setQuery(matchQuery(allowedField, "value"))
+                    .putHeader(BASIC_AUTH_HEADER, basicAuthHeaderValue("user1", USERS_PASSWD))
+                    .get();
+            assertHitCount(response, 1);
+        }
+        for (String disallowedField : disAllowedFields) {
