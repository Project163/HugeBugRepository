+        lt(longColumn("id"), 500L)
+    )));
+    assertEquals(0, countFilteredRecords(path, and(
+        gt(doubleColumn("missing"), 33.33),
+        lt(longColumn("id"), 500L)
+    )));
+    assertEquals(0, countFilteredRecords(path, and(
