  }\n    …\n```\n\nBoth `constructor` and `updateTab` will trigger the message for having a space between the name and the parens even though the above should be the correct format.\n\n---\n\n`.eslintrc` is below:\n\n```\n{\n  \"parser\": \"babel-eslint\",\n  \"env\": {\n    \"browser\": true,\n    \"es6\": true,\n    \"node\": true,\n    \"amd\": true\n  },\n  \"globals\": {\n    \"angular\": false,\n    \"system\": false\n  },\n  \"ecmaFeatures\": {\n    \"modules\": true,\n    \"classes\": true,\n    \"blockBindings\":true\n  },\n  \"rules\": {\n    \"curly\": [2, \"all\"],\n    \"eqeqeq\": [2, \"smart\"],\n    \"no-eval\": 2,\n    \"no-extend-native\": 2,\n    \"no-extra-bind\": 2,\n    \"no-implied-eval\": 2,\n    \"no-iterator\": 2,\n    \"no-multi-spaces\": 2,\n    \"no-multi-str\": 2,\n    \"no-redeclare\": 2,\n    \"no-sequences\": 2,\n    \"no-with\": 2,\n    \"radix\": 2,\n    \"strict\": 0,\n    \"no-delete-var\": 2,\n    \"no-shadow-restricted-names\": 2,\n    \"no-undef\": 0,\n    \"no-unused-vars\": 1,\n    \"no-use-before-define\": [2, \"nofunc\"],\n\n    \"indent\": 4,\n    \"brace-style\": [2, \"1tbs\", { \"allowSingleLine\": true }],\n    \"camelcase\": 2,\n    \"comma-spacing\": [2, { \"before\": false, \"after\": true }],\n    \"consistent-this\": [1, \"vm\"],\n    \"eol-last\": 1,\n    \"func-style\": 0,\n    \"key-spacing\": [2, { \"beforeColon\": false, \"afterColon\": true }],\n    \"new-cap\": [2, { \"newIsCap\": true, \"capIsNew\": false }],\n    \"no-mixed-spaces-and-tabs\": [2, \"smart-tabs\"],\n    \"no-nested-ternary\": 2,\n    \"no-new-object\": 2,\n    \"no-spaced-func\": 1,\n    \"no-underscore-dangle\": 1,\n    \"padded-blocks\": [1, \"always\"],\n    \"quotes\": [1, \"single\", \"avoid-escape\"],\n    \"semi\": [2, \"always\"],\n    \"space-before-function-parentheses\": [1, \"always\"],\n    \"space-after-keywords\": [2, \"always\"],\n    \"space-before-blocks\": [2, \"always\"],\n    \"space-in-parens\": [1, \"never\", { \"exceptions\": [\"{}\", \"[]\", \"()\"] }],\n    \"space-infix-ops\": 2,\n    \"space-return-throw-case\": 2,\n    \"space-unary-ops\": [1, { \"words\": true, \"nonwords\": false }],\n    \"space-in-brackets\": [2, \"never\", {\n        \"singleValue\": false,\n        \"objectsInArrays\": true,\n        \"arraysInArrays\": true,\n        \"arraysInObjects\": true,\n        \"objectsInObjects\": true,\n        \"propertyName\": true\n    }],\n\n    \"no-var\": 1,\n    \"generator-star\": [2, \"start\"]\n  }\n}\n```\n\nAny help or fixes in case it's purely user error would be much appreciated.\n","reactions":{"url":"https://api.github.com/repos/eslint/eslint/issues/2128/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/eslint/eslint/issues/2128/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":1461432298,"node_id":"MDExOkxvY2tlZEV2ZW50MTQ2MTQzMjI5OA==","url":"https://api.github.com/repos/eslint/eslint/issues/events/1461432298","actor":{"login":"eslint-deprecated[bot]","id":29966797,"node_id":"MDM6Qm90Mjk5NjY3OTc=","avatar_url":"https://avatars.githubusercontent.com/in/3565?v=4","gravatar_id":"","url":"https://api.github.com/users/eslint-deprecated%5Bbot%5D","html_url":"https://github.com/apps/eslint-deprecated","followers_url":"https://api.github.com/users/eslint-deprecated%5Bbot%5D/followers","following_url":"https://api.github.com/users/eslint-deprecated%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/eslint-deprecated%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/eslint-deprecated%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eslint-deprecated%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/eslint-deprecated%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/eslint-deprecated%5Bbot%5D/repos","events