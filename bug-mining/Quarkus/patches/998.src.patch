+    }
+
+    public void setBaseVariable(String baseVariable) {
+        this.baseVariable = baseVariable;
+    }
+
+    public T getData() {
+        return this.data;
+    }
+
+    public void setData(T data) {
+        this.data = data;
+    }
+}
