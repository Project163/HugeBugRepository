 following updates were made:\r\n\r\nAdded a new section in the Tauri documentation under <PROJECT ROOT>/src-tauri/capabilities/default.json.\r\nProvided an example JSON structure demonstrating how to configure the permissions array for sidecar functionality.\r\nClarified the use of the shell:allow-execute identifier and how to modify it to shell:allow-spawn for specific use cases.\r\nCloses https://github.com/tauri-apps/tauri/issues/1298#issuecomment-2504261926_","reactions":{"url":"https://api.github.com/repos/tauri-apps/tauri-docs/issues/3103/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/tauri-apps/tauri-docs/issues/3103/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":16966856788,"node_id":"SE_lADOC7lts84wr7ZvzwAAAAPzTbBU","url":"https://api.github.com/repos/tauri-apps/tauri/issues/events/16966856788","actor":{"login":"xmsz-stu","id":139225486,"node_id":"U_kgDOCExpjg","avatar_url":"https://avatars.githubusercontent.com/u/139225486?v=4","gravatar_id":"","url":"https://api.github.com/users/xmsz-stu","html_url":"https://github.com/xmsz-stu","followers_url":"https://api.github.com/users/xmsz-stu/followers","following_url":"https://api.github.com/users/xmsz-stu/following{/other_user}","gists_url":"https://api.github.com/users/xmsz-stu/gists{/gist_id}","starred_url":"https://api.github.com/users/xmsz-stu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xmsz-stu/subscriptions","organizations_url":"https://api.github.com/users/xmsz-stu/orgs","repos_url":"https://api.github.com/users/xmsz-stu/repos","events_url":"https://api.github.com/users/xmsz-stu/events{/privacy}","received_events_url":"https://api.github.com/users/xmsz-stu/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2025-03-25T04:02:20Z","