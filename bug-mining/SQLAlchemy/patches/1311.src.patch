             if "ext.mutable.values" in state_dict:
-                for val in state_dict["ext.mutable.values"][key]:
-                    val._parents[state] = key
+                collection = state_dict["ext.mutable.values"]
+                if isinstance(collection, list):
+                    # legacy format
+                    for val in collection:
