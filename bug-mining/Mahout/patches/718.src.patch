-    int low = 0;
-    int high = n - 1;
-
-    for (int m = low + 1; m <= high - 1; m++) {
-
-      // Scale column.
-
-      Vector hColumn = hessenBerg.viewColumn(m - 1).viewPart(m, high - m + 1);
