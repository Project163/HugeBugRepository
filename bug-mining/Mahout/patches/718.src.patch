-        for (int j = 0; j < n; j++) {
-          a[i][j] = arg.get(j, i);
-        }
-      }
-    } else {
-      m = arg.numRows();
-      n = arg.numCols();
-      a = new double[m][n];
-      for (int i = 0; i < m; i++) {
-        for (int j = 0; j < n; j++) {
-          a[i][j] = arg.get(i, j);
-        }
-      }
-    }
-    
-    
-    int nu = Math.min(m, n);
