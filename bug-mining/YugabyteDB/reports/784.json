sers/Huqicheng/followers","following_url":"https://api.github.com/users/Huqicheng/following{/other_user}","gists_url":"https://api.github.com/users/Huqicheng/gists{/gist_id}","starred_url":"https://api.github.com/users/Huqicheng/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Huqicheng/subscriptions","organizations_url":"https://api.github.com/users/Huqicheng/orgs","repos_url":"https://api.github.com/users/Huqicheng/repos","events_url":"https://api.github.com/users/Huqicheng/events{/privacy}","received_events_url":"https://api.github.com/users/Huqicheng/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":7,"created_at":"2022-09-14T18:02:47Z","updated_at":"2023-01-05T21:26:58Z","closed_at":"2023-01-05T21:26:58Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Jira Link: [DB-3505](https://yugabyte.atlassian.net/browse/DB-3505)\r\n### Description\r\n\r\nScenario for the potential issue:\r\n1. Parent tablet leader received `WriteRpc` 1 and added `WRITE_OP` 1 to the WAL. But `YBClient` didn’t get the response.\r\n2. Parent tablet got `SPLIT_OP` and added it to the WAL.\r\n3. YBClient is retrying `WriteRpc` 1 to the parent tablet leader and getting error that tablet started split (or already split).\r\n4. YBClient is preparing new `WriteRpc` 2 to retry the same YBOperation to the child tablet and sends it to the child tablet.\r\n5. Child tablet leader applies `WRITE_OP` 2 caused by the same user request as `WRITE_OP` 1.\r\n\r\nWe need to implement a unit-test and then fix it. ~~Idea for fix - make tablet leader first checking for duplicate request and only after that for whether it started split. Then at step 3 parent tablet leader will reject `WriteRpc` 1 as a duplicate and `YBClient` will not retry it to the child tablet.~~\r\n\r\nUPDATE: Consider reusing the same request_id for splitting-related retries (we would need to keep filling retryable requests for child tablets).","closed_by":{"login":"rthallamko3","id":17170123,"node_id":"MDQ6VXNlcjE3MTcwMTIz","avatar_url":"https://avatars.githubusercontent.com/u/17170123?v=4","gravatar_id":"","url":"https://api.github.com/users/rthallamko3","html_url":"https://github.com/rthallamko3","followers_url":"https://api.github.com/users/rthallamko3/followers","following_url":"https://api.github.com/users/rthallamko3/following{/other_user}","gists_url":"https://api.github.com/users/rthallamko3/gists{/gist_id}","starred_url":"https://api.github.com/users/rthallamko3/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rthallamko3/subscriptions","organizations_url":"https://api.github.com/users/rthallamko3/orgs","repos_url":"https://api.github.com/users/rthallamko3/repos","events_url":"https://api.github.com/users/rthallamko3/events{/privacy}","received_events_url":"https://api.github.com/users/rthallamko3/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/14005/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/14005/timeline","performed_via_github_app":null,"state_reason":"completed"}