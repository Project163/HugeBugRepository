ry/issues{/number}","pulls_url":"https://api.github.com/repos/celery/celery/pulls{/number}","milestones_url":"https://api.github.com/repos/celery/celery/milestones{/number}","notifications_url":"https://api.github.com/repos/celery/celery/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/celery/celery/labels{/name}","releases_url":"https://api.github.com/repos/celery/celery/releases{/id}","deployments_url":"https://api.github.com/repos/celery/celery/deployments","created_at":"2009-04-24T11:31:24Z","updated_at":"2026-03-11T11:08:53Z","pushed_at":"2026-03-10T15:04:28Z","git_url":"git://github.com/celery/celery.git","ssh_url":"git@github.com:celery/celery.git","clone_url":"https://github.com/celery/celery.git","svn_url":"https://github.com/celery/celery","homepage":"https://docs.celeryq.dev","size":36397,"stargazers_count":28268,"watchers_count":28268,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":4989,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":772,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["amqp","python","python-library","python3","queue-tasks","queue-workers","queued-jobs","redis","redis-queue","sqs","sqs-queue","task-manager","task-runner","task-scheduler"],"visibility":"public","forks":4989,"open_issues":772,"watchers":28268,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/celery/celery/pulls/6020","html_url":"https://github.com/celery/celery/pull/6020","diff_url":"https://github.com/celery/celery/pull/6020.diff","patch_url":"https://github.com/celery/celery/pull/6020.patch","merged_at":"2020-04-02T18:52:49Z"},"body":"*Note*: Before submitting this pull request, please review our [contributing\r\nguidelines](https://docs.celeryproject.org/en/master/contributing.html).\r\n\r\n## Description\r\n(Fixes #6019) \r\n\r\n**kwargs for the mysql creat_engine() function were removed in the case that self.forked is False (https://github.com/celery/celery/commit/94dae1b899aae6ae2ca333773fddbc6dd603213c) due to issue #1903. However, this causes other database engine options to not be used, such as the SSL certs when the `ResultSession` is made. This fix ignores args in the database engine options that start with `pool` while still applying the others. A detailed description of this issue can be found at https://github.com/celery/celery/issues/6019. \r\n\r\nhttps://docs.sqlalchemy.org/en/13/core/engines.html#sqlalchemy.create_engine.params.pool\r\nThe SQLalchemy documentation shows all of the possible engine args. \r\nHere are the ones containing `pool`:\r\npool\r\npoolclass\r\npool_logging_name\r\npool_pre_ping\r\npool_size\r\npool_recycle\r\npool_reset_on_return\r\npool_timeout\r\npool_use_lifo \r\necho_pool\r\n\r\nIn the description of `pool_size` it says: \"to disable pooling, set poolclass to NullPool instead\"\r\nTherefore, none of these `pool` args will be needed since `poolclass` is set to NullPool. ","reactions":{"url":"https://api.github.com/repos/celery/celery/issues/6020/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/celery/celery/issues/6020/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/celery/celery/issues/comments/607530096","html_url":"https://github.com/celery/celery/issues/6019#issuecomment-607530096","issue_url":"https://api.github.com/repos/celery/celery/issues/6019","id":607530096,"node_id":"MDEyOklzc3VlQ29tbWVudDYwNzUzMDA5Ng==","user":{"login":"alexagr