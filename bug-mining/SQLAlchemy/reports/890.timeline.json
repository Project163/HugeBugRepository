boom\r\nAttributeError: 'NoneType' object has no attribute 'tracks'\r\n\r\n```\r\n\r\nbecause there's no data.   ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/538009464/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/538012809","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/4886#issuecomment-538012809","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/4886","id":538012809,"node_id":"MDEyOklzc3VlQ29tbWVudDUzODAxMjgwOQ==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-10-03T16:08:27Z","updated_at":"2019-10-03T16:08:27Z","body":"Here's a script that makes use of both of your functions within a CASE statement, trying to mimic the general form you have above.    As it reproduces no error, have you also ensured you are on the most recent cx_Oracle version?     Newer SQLAlchemy versions require more recent cx_Oracle versions.\r\n\r\n```\r\nimport datetime\r\n\r\nfrom sqlalchemy import case\r\nfrom sqlalchemy import Column\r\nfrom sqlalchemy import create_engine\r\nfrom sqlalchemy import Date\r\nfrom sqlalchemy import DateTime\r\nfrom sqlalchemy import Integer\r\nfrom sqlalchemy.ext.compiler import compiles\r\nfrom sqlalchemy.ext.declarative import declarative_base\r\nfrom sqlalchemy.orm import Session\r\nfrom sqlalchemy.sql import expression\r\n\r\n\r\nclass add_months(expression.FunctionElement):\r\n    \"\"\"function to add `n` months to a date.\r\n\r\n    Implemented for oracle and sqlite.\r\n    \"\"\"\r\n\r\n    type = Date()\r\n    name = \"add_months\"\r\n\r\n\r\n@compiles(add_months)\r\ndef add_months_default(element, compiler, **kw):\r\n    return compiler.visit_function(element)\r\n\r\n\r\n@compiles(add_months, \"oracle\")\r\ndef add_months_oracle(element, compiler, **kw):\r\n    # oracle implementation of \"add_months\"\r\n    (date, number) = list(element.clauses)\r\n    return \"ADD_MONTHS(%s, %s)\" % (\r\n        compiler.process(date),\r\n        compiler.process(number),\r\n    )\r\n\r\n\r\nclass month(expression.FunctionElement):\r\n    \"\"\"function returns first of month of given date.\r\n\r\n    Implemented for oracle and sqlite.\r\n    \"\"\"\r\n\r\n    type = Date()\r\n    name = \"month\"\r\n\r\n\r\n@compiles(month)\r\ndef month_default(element, compiler, **kw):\r\n    return compiler.visit_function(element)\r\n\r\n\r\n@compiles(month, \"oracle\")\r\ndef month_oracle(element, compiler, **kw):\r\n    # oracle implementation of `month`\r\n    (arg,) = list(element.clauses)\r\n    return \"TRUNC(%s, 'MONTH')\" % (compiler.process(arg),)\r\n\r\n\r\nBase = declarative_base()\r\n\r\n\r\nclass A(Base):\r\n    __tablename__ = \"a\"\r\n\r\n    id = Column(Integer, primary_key=True)\r\n    date = Column(DateTime)\r\n\r\n\r\ne = create_engine(\"oracle://scott:tiger@oracle1120\", echo=True)\r\nBase.metadata.drop_all(e)\r\nBase.metadata.create_all(e)\r\n\r\ns = Session(e)\r\n\r\ns.add(A(id=1, date=datetime.datetime(2019, 10, 5, 12, 47, 18)))\r\ns.commit()\r\n\r\nprint(s.query(month(case([(A.id == 1, add_months(A.date, 3))]))).all())\r\n\r\n```\r\n\r\noutput:\r\n\r\n```\r\nBEGIN (implicit)\r\n2019-10-03 12:06:42,198 INFO sqlalchemy.engine.base.Engine INSERT INTO a (id, \"date\") VALUES (:id, :\"date\")\r\n2019-10-03 12:06:42,198 INFO sqlalchemy.engine.base.Engine {'id': 1, '\"date\"': datetime.datetime(2019, 10, 5, 12, 47, 18)}\r\n2019-10-03 12:06:42,209 INFO sqlalchemy.engine.base.Engine COMMIT\r\n2019-10-03 12:06:42,223 INFO sqlalchemy.engine.base.Engine BEGIN (implicit)\r\n2019-10-03 12:06:42,224 INFO sqlalchemy.engine.base.Engine SELECT TRUNC(CASE WHEN (a.id = :id_1) THEN ADD_MONTHS(a.\"date\", :add_months_1) END, 'MONTH') AS month_1 \r\nFROM a\r\n2019-10-03 12:06:42,224 INFO sqlalchemy.engine.base.Engine {'id_1': 1, 'add_months_1': 3}\r\n[(datetime.date(2020, 1, 1),)]\r\n\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/538012809/reactions","total_count"