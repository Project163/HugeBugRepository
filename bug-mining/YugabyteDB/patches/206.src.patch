-  // Update sys-catalog with the updated snapshot state.
-  Status s = sys_catalog_->UpdateItem(snapshot.get(), leader_ready_term_);
-  if (!s.ok()) {
-    // The mutation will be aborted when 'l' exits the scope on early return.
