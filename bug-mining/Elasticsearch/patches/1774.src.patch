+              "cluster": ["all"],
+              "indices": [
+                {
+                  "names": "*",
+                  "privileges": ["read", "read_cross_cluster", "view_index_metadata"]
+                }
+              ]
+            }
+---
+teardown:
+  - do:
+      xpack.security.delete_user:
+        username: "joe"
