es":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"salyh","id":3762447,"node_id":"MDQ6VXNlcjM3NjI0NDc=","avatar_url":"https://avatars.githubusercontent.com/u/3762447?v=4","gravatar_id":"","url":"https://api.github.com/users/salyh","html_url":"https://github.com/salyh","followers_url":"https://api.github.com/users/salyh/followers","following_url":"https://api.github.com/users/salyh/following{/other_user}","gists_url":"https://api.github.com/users/salyh/gists{/gist_id}","starred_url":"https://api.github.com/users/salyh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/salyh/subscriptions","organizations_url":"https://api.github.com/users/salyh/orgs","repos_url":"https://api.github.com/users/salyh/repos","events_url":"https://api.github.com/users/salyh/events{/privacy}","received_events_url":"https://api.github.com/users/salyh/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/comments/27813161","html_url":"https://github.com/elastic/elasticsearch/issues/4100#issuecomment-27813161","issue_url":"https://api.github.com/repos/elastic/elasticsearch/issues/4100","id":27813161,"node_id":"MDEyOklzc3VlQ29tbWVudDI3ODEzMTYx","user":{"login":"seallison","id":5862103,"node_id":"MDQ6VXNlcjU4NjIxMDM=","avatar_url":"https://avatars.githubusercontent.com/u/5862103?v=4","gravatar_id":"","url":"https://api.github.com/users/seallison","html_url":"https://github.com/seallison","followers_url":"https://api.github.com/users/seallison/followers","following_url":"https://api.github.com/users/seallison/following{/other_user}","gists_url":"https://api.github.com/users/seallison/gists{/gist_id}","starred_url":"https://api.github.com/users/seallison/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/seallison/subscriptions","organizations_url":"https://api.github.com/users/seallison/orgs","repos_url":"https://api.github.com/users/seallison/repos","events_url":"https://api.github.com/users/seallison/events{/privacy}","received_events_url":"https://api.github.com/users/seallison/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2013-11-05T21:17:17Z","updated_at":"2013-11-05T21:17:29Z","body":"Yes, not closing the builder solves the problem, as I noted in the comment in my gist.\n\nThe point is the builder isClosed() should be tested before blindly writing to it.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/comments/27813161/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"seallison","id":5862103,"node_id":"MDQ6VXNlcjU4NjIxMDM=","avatar_url":"https://avatars.githubusercontent.com/u/5862103?v=4","gravatar_id":"","url":"https://api.github.com/users/seallison","html_url":"https://github.com/seallison","followers_url":"https://api.github.com/users/seallison/followers","following_url":"https://api.github.com/users/seallison/following{/other_user}","gists_url":"https://api.github.com/users/seallison/gists{/gist_id}","starred_url":"https://api.github.com/users/seallison/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/seallison/subscriptions","organizations_url":"https://api.github.com/users/seallison/orgs","repos_url":"https://api.github.com/users/seallison/repos","events_url":"https://api.github.com/users/seallison/events{/privacy}","received_events_url":"https://api.github.com/users/seallison/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/comments/27813342","html_url":"https://github.com/elastic/elasticsearch/issues/4100#issuecomment-27813342","issue_url":"https://api.github.com/repos/elastic/elasticsearch/issues/4100","id":27813342,"node_id":"MDEyOklzc3VlQ29tbWVudDI3ODEzMzQy","user":{"login":"salyh","id":3762447,"node_id":"MDQ6VXNlcjM3NjI0NDc=","avatar_url":"https://avatars.githubusercontent.com/u/3762447?v=4","gravatar_id":"","url":"https://api.github.com/users/salyh","html_url":"https://github.com/salyh","followers_url":"https://api.github.com/users/salyh/followers","following_url":"https://api.github.com/users/salyh/following{/other_user}","gists_url":"https://api.github.com/users/salyh/gists{/gist_id}","starred_url":"https://api.github.com/users/salyh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/salyh/subscriptions","organizations_url":"https://api.github.com/users/salyh/orgs","repos_url":"https://api.github.com/users/salyh/repos","events_url":"https://api.github.com/users/salyh/events{/privacy}","received_events_url":"https://api.github.com/users/salyh/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2013-11-05T21:19:35Z","updated_at":"2013-11-05T21:23:21Z","body":"If builder is closed explicitly then sendResponse() failed with a NPE on <code>UTF8JsonGenerator._writeBytes(byte[]) line: 1125</code>  because <code>_outputBuffer</code> in  <code>System.arraycopy(bytes, 0, _outputBuffer, _outputTail, len)</code> is null because its already closed. \n\nMaybe a fix could look like this in <code>JsonXContentGenerator</code>\n\n<pre><code>\n @Override\n    public void close() throws IOException {\n        if (writeLineFeedAtEnd && !generator.isClosed()) {\n            flush();\n            generator.writeRaw(LF);\n        }\n        generator.close();\n    }\n</code></pre>\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/comments/27813342/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"salyh","id":3762447,"node_id":"MDQ6VXNlcjM3NjI0NDc=","av