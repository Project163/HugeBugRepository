s/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"As part of #5918, @d-uspenskiy pointed out that there's other pieces of the class which could be prone to various race conditions, which might suggest the class was never though through as being used across threads.\r\n\r\nWe should revisit this, to make sure with the feature on, we don't end up with subtle race conditions.\r\n\r\nExample code snippet, where `batch_id_` might also have issues:\r\n```\r\nStatus AuditLogger::StartBatchRequest(int statements_count) {\r\n  if (!FLAGS_ycql_enable_audit_log) {\r\n    return Status::OK();\r\n  }\r\n\r\n  if (rescheduled_ && !batch_id_.empty()) {\r\n    // Keep an existing batch ID in case of reschedule.\r\n    return Status::OK();\r\n  }\r\n\r\n  // We cannot have sub-batches as only DMLs are allowed within a batch.\r\n  SCHECK(batch_id_.empty(), InternalError, \"Batch request mode is already active!\");\r\n\r\n  batch_id_ = AsString(boost::uuids::random_generator()());\r\n\r\n  auto operation = Format(\"BatchId:[$0] - BATCH of [$1] statements\", batch_id_, statements_count);\r\n\r\n  // Cassandra uses the currently active keyspace here, for whatever reason.\r\n  // We don't as it's cumbersome to track.\r\n  auto entry_result = CreateLogEntry(Type::BATCH,\r\n                                     \"\" /* keyspace */,\r\n                                     \"\" /* scope */,\r\n                                     std::move(operation),\r\n                                     \"\" /* error_message */);\r\n  if (PREDICT_FALSE(!entry_result.ok())) {\r\n    batch_id_ = \"\";\r\n    return entry_result.status();\r\n  }\r\n\r\n  if (!ShouldBeLogged(*entry_result)) {\r\n    return Status::OK();\r\n  }\r\n\r\n  auto s = AddLogEntry(*entry_result);\r\n  if (PREDICT_FALSE(!s.ok())) {\r\n    batch_id_ = \"\";\r\n  }\r\n  return s;\r\n}\r\n```","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/5922/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/5922/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":3835360759,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDM4MzUzNjA3NTk=","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/3835360759","actor":{"login":"bmatican","id":395011,"node_id":"MDQ6VXNlcjM5NTAxMQ==","avatar_url":"https://avatars.githubusercontent.com/u/395011?v=4","gravatar_id":"","url":"https://api.github.com/users/bmatican","html_url":"https://github.com/bmatican","followers_url":"https://api.github.com/users/bmatican/followers","following_url":"https://api.github.com/users/bmatican/following{/other_user}","gists_url":"https://api.github.com/users