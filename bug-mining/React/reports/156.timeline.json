   }, [expire])\n    const onClick = () => {\n        console.log('isExpired', isExpired)\n    }\n    const isExpired = expire === 0\n    return <div onClick={onClick} className=\"text-red-500\">{expire}</div>\n}\n```\nThe onclick function should be able to access the latest value of `isExpired` \n\n### Provide environment information\n\n```bash\nOperating System:\n  Platform: darwin\n  Arch: arm64\n  Version: Darwin Kernel Version 24.6.0: Mon Jul 14 11:30:29 PDT 2025; root:xnu-11417.140.69~1/RELEASE_ARM64_T6000\n  Available memory (MB): 65536\n  Available CPU cores: 10\nBinaries:\n  Node: 22.18.0\n  npm: 10.9.3\n  Yarn: 4.2.2\n  pnpm: 10.15.1\nRelevant Packages:\n  next: 16.0.1 // Latest available version is detected (16.0.1).\n  eslint-config-next: N/A\n  react: 19.2.0\n  react-dom: 19.2.0\n  typescript: 5.9.3\nNext.js Config:\n  output: N/A\n```\n\n### Which area(s) are affected? (Select all that apply)\n\nReact\n\n### Which stage(s) are affected? (Select all that apply)\n\nnext start (local), next build (local)\n\n### Additional context\n\n_No response_","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/86039/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vercel/next.js/issues/86039/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/facebook/react/issues/comments/3608037831","html_url":"https://github.com/facebook/react/issues/35122#issuecomment-3608037831","issue_url":"https://api.github.com/repos/facebook/react/issues/35122","id":3608037831,"node_id":"IC_kwDOAJy2Ks7XDknH","user":{"login":"NavroO","id":42099711,"node_id":"MDQ6VXNlcjQyMDk5NzEx","avatar_url":"https://avatars.githubusercontent.com/u/42099711?v=4","gravatar_id":"","url":"https://api.github.com/users/NavroO","html_url":"https://github.com/NavroO","followers_url":"https://api.github.com/users/NavroO/followers","following_url":"https://api.github.com/users/NavroO/following{/other_user}","gists_url":"https://api.github.com/users/NavroO/gists{/gist_id}","starred_url":"https://api.github.com/users/NavroO/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NavroO/subscriptions","organizations_url":"https://api.github.com/users/NavroO/orgs","repos_url":"https://api.github.com/users/NavroO/repos","events_url":"https://api.github.com/users/NavroO/events{/privacy}","received_events_url":"https://api.github.com/users/NavroO/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-03T17:41:58Z","updated_at":"2025-12-03T17:41:58Z","body":"Hi,\nThis behavior isn’t really a React bug—it’s caused by Strict Mode in React 18 during development. Components are mounted, unmounted, and remounted, which can make timers or state updates behave unexpectedly.\n\nIn production, this usually doesn’t happen. Using functional state updates (setState(prev => …)) makes your timer reliable in both dev and prod.\n\nI’m curious—have you tried this approach, or do you also see isExpired staying false even when using functional updates?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/facebook/react/issues/comments/3608037831/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"NavroO","id":42099711,"node_id":"MDQ6VXNlcjQyMDk5NzEx","avatar_url":"https://avatars.githubusercontent.com/u/42099711?v=4","gravatar_id":"","url":"https://api.github.com/users/NavroO","html_url":"https://github.com/NavroO","followers_url":"https://api.github.com/users/NavroO/followers","following_url":"https://api.github.com/users/NavroO/following{/other_user}","gists_url":"https://api.github.com/users/NavroO/gists{/gist_id}","starred_url":"https://api.github.com/users/Na