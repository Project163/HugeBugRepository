                 return wrapped
 
         if not literal_binds:
@@ -3436,7 +3476,11 @@ class SQLCompiler(Compiled):
         raise NotImplementedError()
 
     def render_literal_bindparam(
-        self, bindparam, render_literal_value=NO_ARG, **kw
+        self,
+        bindparam,
+        render_literal_value=NO_ARG,
