{/other_user}","gists_url":"https://api.github.com/users/lunny/gists{/gist_id}","starred_url":"https://api.github.com/users/lunny/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lunny/subscriptions","organizations_url":"https://api.github.com/users/lunny/orgs","repos_url":"https://api.github.com/users/lunny/repos","events_url":"https://api.github.com/users/lunny/events{/privacy}","received_events_url":"https://api.github.com/users/lunny/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":3661585529,"node_id":"MDEyOkxhYmVsZWRFdmVudDM2NjE1ODU1Mjk=","url":"https://api.github.com/repos/go-gitea/gitea/issues/events/3661585529","actor":{"login":"lunny","id":81045,"node_id":"MDQ6VXNlcjgxMDQ1","avatar_url":"https://avatars.githubusercontent.com/u/81045?v=4","gravatar_id":"","url":"https://api.github.com/users/lunny","html_url":"https://github.com/lunny","followers_url":"https://api.github.com/users/lunny/followers","following_url":"https://api.github.com/users/lunny/following{/other_user}","gists_url":"https://api.github.com/users/lunny/gists{/gist_id}","starred_url":"https://api.github.com/users/lunny/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lunny/subscriptions","organizations_url":"https://api.github.com/users/lunny/orgs","repos_url":"https://api.github.com/users/lunny/repos","events_url":"https://api.github.com/users/lunny/events{/privacy}","received_events_url":"https://api.github.com/users/lunny/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2020-08-17T12:16:16Z","label":{"name":"reviewed/invalid","color":"e6e6e6"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/go-gitea/gitea/issues/comments/674920325","html_url":"https://github.com/go-gitea/gitea/issues/12505#issuecomment-674920325","issue_url":"https://api.github.com/repos/go-gitea/gitea/issues/12505","id":674920325,"node_id":"MDEyOklzc3VlQ29tbWVudDY3NDkyMDMyNQ==","user":{"login":"osbeker","id":6495847,"node_id":"MDQ6VXNlcjY0OTU4NDc=","avatar_url":"https://avatars.githubusercontent.com/u/6495847?v=4","gravatar_id":"","url":"https://api.github.com/users/osbeker","html_url":"https://github.com/osbeker","followers_url":"https://api.github.com/users/osbeker/followers","following_url":"https://api.github.com/users/osbeker/following{/other_user}","gists_url":"https://api.github.com/users/osbeker/gists{/gist_id}","starred_url":"https://api.github.com/users/osbeker/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/osbeker/subscriptions","organizations_url":"https://api.github.com/users/osbeker/orgs","repos_url":"https://api.github.com/users/osbeker/repos","events_url":"https://api.github.com/users/osbeker/events{/privacy}","received_events_url":"https://api.github.com/users/osbeker/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-08-17T14:37:28Z","updated_at":"2020-08-17T15:21:18Z","body":"hi,\r\nthanx for the reply.\r\nI did - my schema is named \"prod\"!\r\n...\r\n[database]\r\nSCHEMA  = prod\r\n...\r\n\r\n...and it created the schema in that schema - the relations are indeed in that schema (your app does the creation).\r\n... but when attempting to do anything in the web-ui, I get a \"500\" page...\r\nLooking at the log I see the generated sql and the what appears the response from the dbms... example for \"notification\" table.\r\nIf you look at the sql and the error message you will see the relation name is not prefixed with the schema qualifier! It will look for it in the \"public\" schema!\r\nBut it is not there, it is in \"prod\", as it should be.\r\n-> Your sql generation is faulty, you need to prefix the relation name with the schema name!\r\nIs: \"select * from notification where ...\"\r\nExpected\" \"select * from prod.notification where ...\"\r\n\r\nI would look into it, but I don't do Go (yet).\r\n\r\nI don't know if you generate it yourself or use a mapping tool.\r\nIf it is a mapping tool, you may have to configure it to include the schema qualifier!\r\nI assume you use a mapping tool and a separate schema-generation (possibly tool)?\r\nThe schema generation seems to check out - there query there after do not... \"notification\" is merely one example, none of the sql in my log are prefixed.\r\nMy guess is if you use a tool, the tool would be smart enough to do that -> you may have forgotten to tell the tool that the schema lives in a schema.\r\n\r\nCheers,\r\n--C.\r\n________________________________\r\nFrom: Lunny Xiao <notifications@github.com>\r\nSent: Monday, August 17, 2020 8:16 AM\r\nTo: go-gitea/gitea <gitea@noreply.github.com>\r\nCc: osbeker <osbeker@hotmail.com>; Author <author@noreply.github.com>\r\nSubject: Re: [go-gitea/gitea] Postgres schema support (#12505)\r\n\r\n\r\nI think we have support schema, you should set it in\r\n\r\n[database]\r\nSCHEMA=\r\n\r\n—\r\nYou are receiving this because you authored the thread.\r\nReply to this email directly, view it on GitHub<https://github.com/go-gitea/gitea/issues/12505#issuecomment-674846556>, or unsubscribe<https://github.com/notifications/unsubscribe-auth/ABRR4Z7W2RSYWPQSGMNQR2LSBENRBANCNFSM4QBQ662Q>.\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/go-gitea/gitea/issues/comments/674920325/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"osbeker","id":6495847,"node_id":"MDQ6VXNlcjY0OTU4NDc=","avatar_url":"https://avatars.githubusercontent.com/u/6495847?v=4","gravatar_id":"","url":"https://api.github.com/users/osbeker","html_url":"https://github.com/osbeker","followers_url":"https://api.github.com/users/osbeker/followers","following_url":"https://api.github.com/users/osbeker/following{/other_user}","gists_url":"https://api.github.com/users/o