/flask-sqlalchemy/labels{/name}","releases_url":"https://api.github.com/repos/pallets-eco/flask-sqlalchemy/releases{/id}","deployments_url":"https://api.github.com/repos/pallets-eco/flask-sqlalchemy/deployments","created_at":"2010-06-01T15:01:50Z","updated_at":"2025-12-07T12:45:58Z","pushed_at":"2025-12-06T02:58:18Z","git_url":"git://github.com/pallets-eco/flask-sqlalchemy.git","ssh_url":"git@github.com:pallets-eco/flask-sqlalchemy.git","clone_url":"https://github.com/pallets-eco/flask-sqlalchemy.git","svn_url":"https://github.com/pallets-eco/flask-sqlalchemy","homepage":"https://flask-sqlalchemy.readthedocs.io","size":1614,"stargazers_count":4311,"watchers_count":4311,"language":"Python","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":898,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":32,"license":{"key":"bsd-3-clause","name":"BSD 3-Clause \"New\" or \"Revised\" License","spdx_id":"BSD-3-Clause","url":"https://api.github.com/licenses/bsd-3-clause","node_id":"MDc6TGljZW5zZTU="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["flask","flask-sqlalchemy","python","sqlalchemy"],"visibility":"public","forks":898,"open_issues":32,"watchers":4311,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/pallets-eco/flask-sqlalchemy/pulls/1215","html_url":"https://github.com/pallets-eco/flask-sqlalchemy/pull/1215","diff_url":"https://github.com/pallets-eco/flask-sqlalchemy/pull/1215.diff","patch_url":"https://github.com/pallets-eco/flask-sqlalchemy/pull/1215.patch","merged_at":"2023-08-31T21:30:31Z"},"body":"Fixes #1140 \r\n\r\nThis PR adds support to Flask-SQLAlchemy for using the new SQLAlchemy 2.0 style of subclassing DeclarativeBase or DeclarativeBaseNoMeta (and optionally MappedAsDataclass). \r\n\r\nHere's a simple usage example:\r\n\r\n```\r\nclass Base(sa.orm.DeclarativeBase):\r\n    pass\r\n\r\ndb = SQLAlchemy(app, model_class=Base)\r\n\r\nclass Quiz(db.Model):\r\n    __bind_key__ = \"other\"\r\n    id_column: Mapped[int] = mapped_column(primary_key=True, autoincrement=True)\r\n    title: Mapped[str] = mapped_column(db.String(255), nullable=False)\r\n```\r\n\r\nThe tests check for many combinations of subclasses of base, see conftest.py for the parameterized fixture.\r\n\r\nThis approach has the advantage of letting developers follow the SQLAlchemy 2.0 docs for defining models while still being able to benefit from the Bind and Name mixin functionality, as well as all the standard functionality offered by Flask-SQLAlchemy.\r\n\r\nThere's one way that this approach is less flexible than the 1.x integration: it isn't possible to opt out of the Bind or Name mixin. Opting out of bind doesn't seem necessary since it doesn't really affect code that doesn't use it. If opting out of name is a big need, then I think the simplest way to support that is to add a disable_autonaming parameter to SQLAlchemy.\r\n\r\nOther potential drawbacks of this PR:\r\n\r\n* The documentation now has some \"forks\" for 1.x vs 2.x SQLAlchemy APIs. I imagine not everyone is ready to move to 2.x API so Flask-SA may want to support both for a while.\r\n* Similarly, there is some code redundancy in model.py, since I copied the mixins to make them into base classes using __init_subclass__ (versus metaclasses). I could probably refactor redundant code into helper functions if you felt it was necessary.\r\n* The typing situation got a bit hairy, since there are so many types of classes accepted for model_class. My approach resulted in adding some ignores but removing some previous ignores, so I think it's net neutral.\r\n\r\nChecklist:\r\n\r\n- [X] Add tests that demonstrate the correct behavior of the change. Tests should fail without the change.\r\n- [X] Add or update relevant docs, in the docs folder and in code.\r\n- [X] Add an entry in `CHANGES.rst` summarizing the change and linking to the issue.\r\n- [X] Add `.. versionchanged::` entries in any relevant code docs.\r\n- [X] Run `pre-commit` hooks and fix any issues.\r\n- [X] Run `pytest` and `tox`, no tests failed.\r\n","reactions":{"url":"https://api.github.com/repos/pallets-eco/flask-sqlalchemy/issues/1215/reactions","total_count":5,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/pallets-eco/flask-sqlalchemy/issues/1215/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":11755478836,"node_id":"REFE_lADOCX5JB85nSDRBzwAAAAK8rl80","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/11755478836","actor":{"login":"lelit","id":412797,"node_id":"MDQ6VXNlcjQxMjc5Nw==","avatar_url":"https://avatars.githubusercontent.com/u/412797?v=4","gravatar_id":"","url":"https://api.github.com/users/lelit","html_url":"https://github.com/lelit","followers_url":"https://api.github.com/users/lelit/followers","following_url":"https://api.github.com/users/lelit/following{/other_user}","gists_url":"https://api.github.com/users/lelit/gists{/gist_id}","starred_url":"https://api.github.com/users/lelit/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lelit/subscriptions","organizations_url":"https://api.github.com/users/lelit/orgs","repos_url":"https://api.github.com/users/lelit/repos","events_url":"https://api.github.com/users/lelit/events{/privacy}","received_events_url":"https://api.github.com/users/lelit/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"8e297afa8ddd66d5d7317a1b965a8919adb8f1aa","commit_url":"https://api.github.com/repos/lelit/sqlalchemy/commits/8e297afa8ddd66d5d7317a1b965a8919adb8f1aa","created_at":"2024-02-09T09:07:41Z","performed_via_github_app":null}]