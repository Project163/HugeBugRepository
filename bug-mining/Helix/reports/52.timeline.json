rl</kbd> + <kbd>m</kbd> is interpreted as `KeyEvent { code: Enter, modifiers: NONE }`, <kbd>Ctrl</kbd> + <kbd>7</kbd> is `KeyEvent { code: Char('_'), modifiers: SHIFT | CONTROL }`, etc.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/helix-editor/helix/issues/comments/1040726272/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"CptPotato","id":3957610,"node_id":"MDQ6VXNlcjM5NTc2MTA=","avatar_url":"https://avatars.githubusercontent.com/u/3957610?v=4","gravatar_id":"","url":"https://api.github.com/users/CptPotato","html_url":"https://github.com/CptPotato","followers_url":"https://api.github.com/users/CptPotato/followers","following_url":"https://api.github.com/users/CptPotato/following{/other_user}","gists_url":"https://api.github.com/users/CptPotato/gists{/gist_id}","starred_url":"https://api.github.com/users/CptPotato/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CptPotato/subscriptions","organizations_url":"https://api.github.com/users/CptPotato/orgs","repos_url":"https://api.github.com/users/CptPotato/repos","events_url":"https://api.github.com/users/CptPotato/events{/privacy}","received_events_url":"https://api.github.com/users/CptPotato/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":6077851558,"node_id":"MEE_lADOD__WI85DhYpOzwAAAAFqRKem","url":"https://api.github.com/repos/helix-editor/helix/issues/events/6077851558","actor":{"login":"CptPotato","id":3957610,"node_id":"MDQ6VXNlcjM5NTc2MTA=","avatar_url":"https://avatars.githubusercontent.com/u/3957610?v=4","gravatar_id":"","url":"https://api.github.com/users/CptPotato","html_url":"https://github.com/CptPotato","followers_url":"https://api.github.com/users/CptPotato/followers","following_url":"https://api.github.com/users/CptPotato/following{/other_user}","gists_url":"https://api.github.co