IT clause in the CREATE statement of colocated tables.\r\nColocated tables put all of their data into a single tablet, called the colocation tablet, and they are not split into multiple tablets. Therefore, the SPLIT clause should not be allowed. It seems we currently ignore the SPLIT part of the CREATE statement for colocated tables.\r\n\r\nSPLIT AT && SPLIT INTO examples:\r\n```\r\nCREATE DATABASE colocation_test colocated = true;\r\n\\c colocation_test\r\n\r\n-- SPLIT AT\r\nCREATE TABLE tbl_colocated_range (\r\n  a INT,\r\n  b TEXT,\r\n  PRIMARY KEY(a ASC, b ASC)\r\n) SPLIT AT VALUES((-100, 'bar'), (250, 'foo'));\r\nDROP TABLE tbl_colocated_range;\r\n\r\n-- SPLIT INTO\r\nCREATE TABLE tbl_colocated_hash (\r\n  a INT PRIMARY KEY,\r\n  b TEXT\r\n) SPLIT INTO 4 TABLETS;\r\nDROP TABLE tbl_colocated_hash;\r\n\r\n\\c yugabyte\r\nDROP DATABASE colocation_test;\r\n```","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/11540/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/11540/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":6465037647,"node_id":"RTE_lADOBlCVUc5HHiSDzwAAAAGBWKVP","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/6465037647","actor":{"login":"frozenspider","id":2077017,"node_id":"MDQ6VXNlcjIwNzcwMTc=","avatar_url":"https://avatars.githubusercontent.com/u/2077017?v=4","gravatar_id":"","url":"https://api.github.com/users/frozenspider","html_url":"https://github.com/frozenspider","followers_url":"https://api.github.com/users/frozenspider/followers","following_url":"https://api.github.com/users/frozenspider/following{/other_user}","gists_url":"https://api.github.com/users/frozenspider/gists{/gist_id}","starred_url":"https://api.github.com/users/frozenspider/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/