&lt;p&gt;    &lt;a href=&quot;https://github.com/apache/ignite/pull/3384&quot; class=&quot;external-link&quot; target=&quot;_blank&quot; rel=&quot;nofollow noopener&quot;&gt;https://github.com/apache/ignite/pull/3384&lt;/a&gt;&lt;/p&gt;

&lt;p&gt;    &lt;a href=&quot;https://issues.apache.org/jira/browse/IGNITE-7248&quot; title=&quot;&amp;quot;Schema not found&amp;quot; error when setting streaming mode for JDBC driver&quot; class=&quot;issue-link&quot; data-issue-key=&quot;IGNITE-7248&quot;&gt;&lt;del&gt;IGNITE-7248&lt;/del&gt;&lt;/a&gt;  &quot;Schema not found&quot; error when setting streaming mode for JDBC driver&lt;/p&gt;



