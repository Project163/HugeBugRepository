diff --git a/tests/utils/test_patterns.py b/tests/utils/test_patterns.py
index 87abb287..f3df7d52 100644
--- a/tests/utils/test_patterns.py
+++ b/tests/utils/test_patterns.py
@@ -40,3 +40,34 @@ def test_wheel_file_re(filename: str, expected: dict[str, str | None]) -> None:
