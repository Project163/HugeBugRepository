ms occur when the python files are specified on the command line, so perhaps they could be discussed in a separate issue.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/pylint-dev/pylint/issues/comments/163177148/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"pylint-bot","id":16198247,"node_id":"MDQ6VXNlcjE2MTk4MjQ3","avatar_url":"https://avatars.githubusercontent.com/u/16198247?v=4","gravatar_id":"","url":"https://api.github.com/users/pylint-bot","html_url":"https://github.com/pylint-bot","followers_url":"https://api.github.com/users/pylint-bot/followers","following_url":"https://api.github.com/users/pylint-bot/following{/other_user}","gists_url":"https://api.github.com/users/pylint-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/pylint-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pylint-bot/subscriptions","organizations_url":"https://api.github.com/users/pylint-bot/orgs","repos_url":"https://api.github.com/users/pylint-bot/repos","events_url":"https://api.github.com/users/pylint-bot/events{/privacy}","received_events_url":"https://api.github.com/users/pylint-bot/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/pylint-dev/pylint/issues/comments/163177149","html_url":"https://github.com/pylint-dev/pylint/issues/479#issuecomment-163177149","issue_url":"https://api.github.com/repos/pylint-dev/pylint/issues/479","id":163177149,"node_id":"MDEyOklzc3VlQ29tbWVudDE2MzE3NzE0OQ==","user":{"login":"pylint-bot","id":16198247,"node_id":"MDQ6VXNlcjE2MTk4MjQ3","avatar_url":"https://avatars.githubusercontent.com/u/16198247?v=4","gravatar_id":"","url":"https://api.github.com/users/pylint-bot","html_url":"https://github.com/pylint-bot","followers_url":"https://api.github.com/users/pylint-bot/followers","follow