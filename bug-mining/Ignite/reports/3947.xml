 IS_GENERATEDCOLUMN NO&lt;/p&gt;

&lt;p&gt;TABLE_CAT&lt;br/&gt;
 TABLE_SCHEM PUBLIC&lt;br/&gt;
 TABLE_NAME A&lt;br/&gt;
 COLUMN_NAME C&lt;br/&gt;
 &lt;font color=&quot;#d04437&quot;&gt;DATA_TYPE 1111&lt;/font&gt;&lt;br/&gt;
 &lt;font color=&quot;#d04437&quot;&gt;TYPE_NAME OTHER&lt;/font&gt;&lt;br/&gt;
 COLUMN_SIZE null&lt;br/&gt;
 BUFFER_LENGTH null&lt;br/&gt;
 DECIMAL_DIGITS null&lt;br/&gt;
 NUM_PREC_RADIX 10&lt;br/&gt;
