-
-    for f in $MAHOUT_HOME/h2o/target/mahout-h2o*.jar; do
-       CLASSPATH=${CLASSPATH}:$f;
-    done
-
-  fi
-
-  # add jars for running from the command line if we requested shell or spark CLI driver
-  if [ "$SPARK" == "1" ]; then
-
-    for f in $MAHOUT_HOME/lib/mahout-hdfs-*.jar ; do
