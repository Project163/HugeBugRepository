dencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"With the recent change to allow a rate limit on remote bootstraps (https://github.com/YugaByte/yugabyte-db/issues/428), seeing this error on remote bootstrap on a cluster with large tablets, and one tablet was stuck in TABLET_DATA_COPYING mode.\r\n\r\n{code}\r\nW0909 06:36:08.415642 105404 tcp_stream.cc:91] { local: 172.151.26.103:36173 remote: 172.151.17.230:9100 }: Shutting down with pending inbound data (size: 267133381, limit: 267386880, status = Invalid argument (yb/rpc/connection.cc:242): Command is greater than read buffer)\r\n{code}\r\n\r\nIncreasing the `--rpc_max_message_size` flag on the TServer receiving the tablet helped as a temporary workaround.\r\n","closed_by":{"login":"spolitov","id":891914,"node_id":"MDQ6VXNlcjg5MTkxNA==","avatar_url":"https://avatars.githubusercontent.com/u/891914?v=4","gravatar_id":"","url":"https://api.github.com/users/spolitov","html_url":"https://github.com/spolitov","followers_url":"https://api.github.com/users/spolitov/followers","following_url":"https://api.github.com/users/spolitov/following{/other_user}","gists_url":"https://api.github.com/users/spolitov/gists{/gist_id}","starred_url":"https://api.github.com/users/spolitov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/spolitov/subscriptions","organizations_url":"https://api.github.com/users/spolitov/orgs","repos_url":"https://api.github.com/users/spolitov/repos","events_url":"https://api.github.com/users/spolitov/events{/privacy}","received_events_url":"https://api.github.com/users/spolitov/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/467/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/467/timeline","performed_via_