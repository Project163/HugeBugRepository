+                    $atomic_type,
+                    new TString(),
+                    false,
+                    true,
+                    $has_scalar_match
+                )
+                && !$has_scalar_match
+            ) {
+                if (IssueBuffer::accepts(
+                    new InvalidCast(
+                        $atomic_type->getId() . ' cannot be cast to string',
+                        new CodeLocation($statements_analyzer->getSource(), $stmt)
+                    ),
+                    $statements_analyzer->getSuppressedIssues()
+                )) {
+                    // fall through
+                }
+            }
+        }
+    }
