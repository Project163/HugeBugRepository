ub.com/repos/sveltejs/kit/issues{/number}","pulls_url":"https://api.github.com/repos/sveltejs/kit/pulls{/number}","milestones_url":"https://api.github.com/repos/sveltejs/kit/milestones{/number}","notifications_url":"https://api.github.com/repos/sveltejs/kit/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/sveltejs/kit/labels{/name}","releases_url":"https://api.github.com/repos/sveltejs/kit/releases{/id}","deployments_url":"https://api.github.com/repos/sveltejs/kit/deployments","created_at":"2020-10-15T14:00:23Z","updated_at":"2025-12-12T17:54:14Z","pushed_at":"2025-12-12T19:49:47Z","git_url":"git://github.com/sveltejs/kit.git","ssh_url":"git@github.com:sveltejs/kit.git","clone_url":"https://github.com/sveltejs/kit.git","svn_url":"https://github.com/sveltejs/kit","homepage":"https://svelte.dev/docs/kit","size":32161,"stargazers_count":20055,"watchers_count":20055,"language":"JavaScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":2168,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1040,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["hacktoberfest","svelte"],"visibility":"public","forks":2168,"open_issues":1040,"watchers":20055,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"**Describe the bug**\r\n\r\nI'm not sure whether this is by design or a bug.\r\n\r\nI have a page that load data in its load function and a link to this page with sveltekit:prefetch. The load function calls some API using fetch. As soon as I hover over the sveltekit:prefetch, the load function of the target page is called, invoking fetch. Then, when I click on the link and the actual navigation takes place, the load function is called again including the fetch calls. \r\n\r\nTo me this seems to defeat the purpose of prefetching in the first place (at least partially - the page script is of course prefetched, which is beneficial for sure).\r\n\r\n**Logs**\r\n![loading-twice](https://user-images.githubusercontent.com/140714/112222040-7d146080-8c28-11eb-9064-4fdd7b8aab07.gif)\r\n\r\n\r\n**To Reproduce**\r\n\r\n- Pull https://github.com/aloker/svelte-kit-issue-duplicate-data-load\r\n- npm install && npm dev\r\n- Open browser and watch the network/console tap\r\n- Hover over \"Sunrise API\" => sunrise page is loaded and load function is called\r\n- Click on \"Sunrise API\" => load function is called again\r\n\r\n\r\n**Expected behavior**\r\nLoad should only be called once.\r\n\r\n**Information about your SvelteKit Installation:**\r\n\r\n```\r\nSystem:\r\n    OS: Linux 5.4 Ubuntu 20.04.2 LTS (Focal Fossa)\r\n    CPU: (16) x64 Intel(R) Core(TM) i9-9880H CPU @ 2.30GHz\r\n    Memory: 22.28 GB / 24.91 GB\r\n    Container: Yes\r\n    Shell: 5.0.17 - /bin/bash\r\n  Binaries:\r\n    Node: 14.16.0 - /usr/bin/node\r\n    Yarn: 1.22.10 - /mnt/c/tools/node/yarn\r\n    npm: 7.7.0 - /usr/bin/npm\r\n  npmPackages:\r\n    @sveltejs/kit: next => 1.0.0-next.55\r\n    svelte: ^3.29.0 => 3.35.0\r\n```\r\nTested in Chrome and Firefox (latest)\r\n\r\n**Severity**\r\nMedium, mostly a performance issue - or by design.\r\n","reactions":{"url":"https://api.github.com/repos/sveltejs/kit/issues/609/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sveltejs/kit/issues/609/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":4499612042,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDQ0OTk2MTIwNDI=","url":"https://api.github.com/repos/sveltejs/kit/issues/events/4499612042","actor":{"login":"Rich-Harris","id":1162160,"node_id":"MDQ6VXNlcjExNjIxNjA=","avatar_url":"https: