+void WriteQuery::SchemaVersionMismatch(int num_mismatches, int batch_size) {
+  LOG_IF(DFATAL, num_mismatches != batch_size)
+      << "Wrong number or mismatches: " << num_mismatches << " vs " << batch_size;
+  auto self = std::move(self_);
+  submit_token_.Reset();
+  Cancel(Status::OK());
+}
