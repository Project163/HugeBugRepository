   return ReconstructPrometheusAttributesUnlocked();
 }
 
+std::string EscapePrometheusLabelValue(const std::string& s) {
+  if (s.find_first_of("\\\"\n") == std::string::npos) {
+    return s;
+  }
+
+  std::string result;
+  result.reserve(s.size() * 2);
+  for (char c : s) {
+    if (c == '\n') {
+      result += "\\n";
+      continue;
+    }
+    if (c == '\\' || c == '"') {
+      result += '\\';
+    }
+    result += c;
+  }
+  return result;
+}
