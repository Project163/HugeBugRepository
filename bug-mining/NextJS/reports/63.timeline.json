3269","issue_url":"https://api.github.com/repos/vercel/next.js/issues/27744","id":893033269,"node_id":"IC_kwDOBC3Cis41Ops1","user":{"login":"smitssjors","id":18398194,"node_id":"MDQ6VXNlcjE4Mzk4MTk0","avatar_url":"https://avatars.githubusercontent.com/u/18398194?v=4","gravatar_id":"","url":"https://api.github.com/users/smitssjors","html_url":"https://github.com/smitssjors","followers_url":"https://api.github.com/users/smitssjors/followers","following_url":"https://api.github.com/users/smitssjors/following{/other_user}","gists_url":"https://api.github.com/users/smitssjors/gists{/gist_id}","starred_url":"https://api.github.com/users/smitssjors/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smitssjors/subscriptions","organizations_url":"https://api.github.com/users/smitssjors/orgs","repos_url":"https://api.github.com/users/smitssjors/repos","events_url":"https://api.github.com/users/smitssjors/events{/privacy}","received_events_url":"https://api.github.com/users/smitssjors/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-08-04T23:10:10Z","updated_at":"2021-08-04T23:10:10Z","body":"Looking further into it, it seems like [this function](https://github.com/vercel/next.js/blob/4ab41efdbfd082497d3f851a138e091ebea5b810/packages/next/shared/lib/router/router.ts#L89) is causing it.\r\n\r\n```ts\r\nexport function getDomainLocale(\r\n  path: string,\r\n  locale?: string | false,\r\n  locales?: string[],\r\n  domainLocales?: DomainLocale[]\r\n) {\r\n  if (process.env.__NEXT_I18N_SUPPORT) {\r\n    locale = locale || normalizeLocalePath(path, locales).detectedLocale\r\n\r\n    const detectedDomain = detectDomainLocale(domainLocales, undefined, locale)\r\n\r\n    if (detectedDomain) {\r\n      return `http${detectedDomain.http ? '' : 's'}://${detectedDomain.domain}${\r\n        basePath || ''\r\n      }${locale === detectedDomain.defaultLocale ? '' : `/${locale}`}${path}`\r\n    }\r\n    return false\r\n  }\r\n\r\n  return false\r\n}\r\n```\r\n\r\nMy guess is that, as `__NEXT_I18N_SUPPORT` is a boolean and is set to `true` when i18n is enabled, webpack optimizes it out but leaves the last return statement.\r\nI don't know the best way to fix it as I am not verry familiar with webpack.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/893033269/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"smitssjors","id":18398194,"node_id":"MDQ6VXNlcjE4Mzk4MTk0","avatar_url":"https://avatars.githubusercontent.com/u/18398194?v=4","gravatar_id":"","url":"https://api.github.com/users/smitssjors","html_url":"https://github.com/smitssjors","followers_url":"https://api.github.com/users/smitssjors/followers","following_url":"https://api.github.com/users/smitssjors/following{/other_user}","gists_url":"https://api.github.com/users/smitssjors/gists{/gist_id}","starred_url":"https://api.github.com/users/smitssjors/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smitssjors/subscriptions","organizations_url":"https://api.github.com/users/smitssjors/orgs","repos_url":"https://api.github.com/users/smitssjors/repos","events_url":"https://api.github.com/users/smitssjors/events{/privacy}","received_events_url":"https://api.github.com/users/smitssjors/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/893282965","html_url":"https://github.com/vercel/next.js/issues/27744#issuecomment-893282965","issue_url":"https://api.github.com/repos/vercel/next.js/issues/27744","id":893282965,"node_id":"IC_kwDOBC3Cis41PmqV","user":{"login":"timneutkens","id":6324199,"node_id":"MDQ6VXNlcjYzMjQxOTk=","avatar_url":"https://avatars.githubusercontent.com/u/6324199?v=4","gravatar_id":"","url":"https://api.github.com/users/timneutkens","html_url":"https://github.com/timneutkens","followers_url":"https://api.github.com/users/timneutkens/followers","following_url":"https://api.github.com/users/timneutkens/following{/other_user}","gists_url":"https://api.github.com/users/timneutkens/gists{/gist_id}","starred_url":"https://api.github.com/users/timneutkens/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timneutkens/subscriptions","organizations_url":"https://api.github.com/users/timneutkens/orgs","repos_url":"https://api.github.com/users/timneutkens/repos","events_url":"https://api.github.com/users/timneutkens/events{/privacy}","received_events_url":"https://api.github.com/users/timneutkens/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-08-05T08:49:04Z","updated_at":"2021-08-05T08:49:04Z","body":"@smitssjors if you move the last `return false` into an `else` it'll be correctly tree shaken 👍 \r\n\r\n\r\nE.g. this:\r\n\r\n```ts\r\nexport function getDomainLocale(\r\n  path: string,\r\n  locale?: string | false,\r\n  locales?: string[],\r\n  domainLocales?: DomainLocale[]\r\n) {\r\n  if (process.env.__NEXT_I18N_SUPPORT) {\r\n    locale = locale || normalizeLocalePath(path, locales).detectedLocale\r\n\r\n    const detectedDomain = detectDomainLocale(domainLocales, undefined, locale)\r\n\r\n    if (detectedDomain) {\r\n      return `http${detectedDomain.http ? '' : 's'}://${detectedDomain.domain}${\r\n        basePath || ''\r\n      }${locale === detectedDomain.defaultLocale ? '' : `/${locale}`}${path}`\r\n    }\r\n    return false\r\n  } else {\r\n  \treturn false\r\n  }\r\n}\r\n```\r\n\r\nFeel free to open a PR changing this. I've already verified this will shake it away on https://try.terser.org/\r\n\r\n<details>\r\n<summary>Reference code that is passed to Terser (sort of, it's not exactly this)</summary>\r\n\r\n```js\r\n// write or paste code here\r\n\r\nexport function getDomainLocale(\r\n  path,\r\n  locale,\r\n  locales,\r\n  domainLocales\r\n) {\r\n  if (true) {\r\n    locale = locale || normalizeLocalePath(path, locales).detectedLocale\r\n\r\n    const detectedDomain = detectDomainLocale(domainLocales, undefined, locale)\r\n\r\n    if (detectedDomain) {\r\n      return `http${detectedDomain.http ? '' : 's'}://${detectedDomain.domain}${\r\n        basePath || ''\r\n      }${locale === detectedDomain.defaultLocale ? '' : `/${locale}`}${path}`\r\n    }\r\n    return false\r\n  } else {\r\n  \treturn false\r\n  }\r\n}\r\n```\r\n\r\n</details>","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/893282965/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"event":"commented","actor":{"login":"timneutkens","id":6324199,"node_id":"MDQ6VXNlcjYzMjQxOTk=","avatar_url":"https://avatars.githubusercontent.com/u/6324199?v=4","gravatar_id":"","url":"https://api.github.com/users/timneutkens","html_url":"https://github.com/timneutkens","followers_url":"https://api.github.com/users/timneutkens/followers","following_url":"https://api.github.com/users/timneutkens/following{/other_user}","gists_url":"https://api.github.com/users/timneutkens/gists{/gist_id}","starred_url":"https://api.github.com/users/timneutkens/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timneutkens/subscriptions","organizations_url":"https://api.github.com/users/timneutkens/orgs","repos_url":"https://api.github.com/users/timneutkens/repos","events_url":"https://api.github.com/users/timneutkens/events{/privacy}","received_events_url":"https://api.github.com/users/timneutkens/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":5116103169,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50NTExNjEwMzE2OQ==","url":"https://api.github.com/repos/vercel/next.js/issues/events/5116103169","actor":{"login":"smitssjors","id":18398194,"node