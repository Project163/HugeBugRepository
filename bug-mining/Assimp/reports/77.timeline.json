assimp/assimp.git","clone_url":"https://github.com/assimp/assimp.git","svn_url":"https://github.com/assimp/assimp","homepage":"https://www.assimp.org","size":273772,"stargazers_count":12532,"watchers_count":12532,"language":"C++","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":3112,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":249,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["3mf","android","asset-pipeline","assets","assimp","c-plus-plus","collada","dae","fbx","fbx-exporter","game-development","gamedev-tool","gamedevelopment","gltf","gltf2","ifc","patreon","python","stl"],"visibility":"public","forks":3112,"open_issues":249,"watchers":12532,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"**Is your feature request related to a problem? Please describe.**\r\nWhile working on a workaround for issue #4286 for Gentoo Linux, I noticed that collada related unit tests start to fail. The workaround just passes `-DASSIMP_BUILD_COLLADA_{EXPORTER,IMPORTER}=OFF` to cmake to disable the collada module for possible security issues until it's fixed. The unit tests which I needed to disable can be seen in my PR for Gentoo[1].\r\nWe currently build assimp with the default settings, but it's possible, that we will provide options for the user to decide which importers / exporters or other modules they want to enable / disable, as far as the build system supports it, so a proper selection of the testing framework would be crucial.\r\n\r\n**Describe the solution you'd like**\r\nThe unit tests should respect the options passed to cmake and build / run only those unit tests which are configured. One way to do this could be to add guards in the test/CMakeLists.txt file for all the available importers / exporters or other configurable modules and add, build and run the respective source files only if these options are set.\r\n\r\n**Describe alternatives you've considered**\r\nFor Gentoo we have the alternative to completely disable testing, which is no usable option.\r\n\r\n**Additional context**\r\n\r\n[1] https://github.com/gentoo/gentoo/pull/29231/files#diff-14134a3deae6a274139822cd4358c9eb7a1675661eb820364baa837df53338ac\r\n","reactions":{"url":"https://api.github.com/repos/assimp/assimp/issues/4902/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/assimp/assimp/issues/4902/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":8439882826,"node_id":"REFE_lADOAAnkjM5A1ehozwAAAAH3DmRK","url":"https://api.github.com/repos/assimp/assimp/issues/events/8439882826","actor":{"login":"gentoo-bot","id":14542386,"node_id":"MDQ6VXNlcjE0NTQyMzg2","avatar_url":"https://avatars.githubusercontent.com/u/14542386?v=4","gravatar_id":"","url":"https://api.github.com/users/gentoo-bot","html_url":"https://github.com/gentoo-bot","followers_url":"https://api.github.com/users/gentoo-bot/followers","following_url":"https://api.github.com/users/gentoo-bot/following{/other_user}","gists_url":"https://api.github.com/users/gentoo-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/gentoo-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gentoo-bot/subscriptions","organizations_url":"https://api.github.com/users/gentoo-bot/orgs","repos_url":"https://api.github.com/users/gentoo-bot/repos","events_url":"https://api.github.com/users/gentoo-bot/events{/privacy}","received_events_url":"https://api.github.com/users/gentoo-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"abea5e37fe1b382f5809945fef52c18306cea