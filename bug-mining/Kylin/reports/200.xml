                            <comment id="17739586" author="JIRAUSER297438" created="Mon, 3 Jul 2023 11:22:47 +0000"  >&lt;h1&gt;&lt;a name=&quot;RootCause&quot;&gt;&lt;/a&gt;Root Cause&lt;/h1&gt;

&lt;p&gt;FI platform known issues, execute &quot;kerberosEnabled=`${KYLIN_HOME}/bin/get-properties.sh kylin.kerberos.enabled`&quot; can not get kerberosEnabled (empty)&lt;/p&gt;

&lt;p&gt;&lt;span class=&quot;image-wrap&quot; style=&quot;&quot;&gt;&lt;img src=&quot;https://issues.apache.org/jira/secure/attachment/13061036/13061036_image-2023-07-03-19-19-11-529.png&quot; style=&quot;border: 0px solid black&quot; /&gt;&lt;/span&gt;&lt;/p&gt;

&lt;p&gt;As a result, the spark jars are not replaced in the future, and kylin cannot be started&lt;/p&gt;

&lt;p&gt;&lt;span class=&quot;image-wrap&quot; style=&quot;&quot;&gt;&lt;img src=&quot;https://issues.apache.org/jira/secure/attachment/13061037/13061037_image-2023-07-03-19-20-11-766.png&quot; style=&quot;border: 0px solid black&quot; /&gt;&lt;/span&gt;&lt;/p&gt;
&lt;h1&gt;&lt;a name=&quot;FixDesign&quot;&gt;&lt;/a&gt;Fix Design&lt;/h1&gt;

&lt;p&gt;The replace-jars-under-spark.sh script makes the following changes&lt;/p&gt;

&lt;p&gt;&lt;span class=&quot;image-wrap&quot; style=&quot;&quot;&gt;&lt;img src=&quot;https://issues.apache.org/jira/secure/attachment/13061038/13061038_image-2023-07-03-19-21-09-252.png&quot; style=&quot;border: 0px solid black&quot; /&gt;&lt;/span&gt;&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
function get_config_from_props_file() {
  configKey=$1
  configValue=
  &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; [ -f ${KYLIN_HOME}/conf/kylin.properties.override ]; then
      configValue=$(grep -Ev &lt;span class=&quot;code-quote&quot;&gt;&apos;^$|^\s*#&apos;&lt;/span&gt; ${KYLIN_HOME}/conf/kylin.properties.override | grep -E &lt;span class=&quot;code-quote&quot;&gt;&apos;&apos;&lt;span class=&quot;code-quote&quot;&gt;&quot;${configKey}&quot;&lt;/span&gt;&apos;&lt;/span&gt;&lt;span class=&quot;code-quote&quot;&gt;&apos; | awk -F= &apos;&lt;/span&gt;/^&lt;span class=&quot;code-quote&quot;&gt;&apos;&lt;span class=&quot;code-quote&quot;&gt;&quot;${configKey}&quot;&lt;/span&gt;&apos;&lt;/span&gt;=/ { val=$2 } END { print val }&apos;)
  fi

  &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; [[ -z &lt;span class=&quot;code-quote&quot;&gt;&quot;${configValue}&quot;&lt;/span&gt; &amp;amp;&amp;amp; -f ${KYLIN_HOME}/conf/kylin.properties ]]; then
      configValue=$(grep -Ev &lt;span class=&quot;code-quote&quot;&gt;&apos;^$|^\s*#&apos;&lt;/span&gt; ${KYLIN_HOME}/conf/kylin.properties | grep -E &lt;span class=&quot;code-quote&quot;&gt;&apos;&apos;&lt;span class=&quot;code-quote&quot;&gt;&quot;${configKey}&quot;&lt;/span&gt;&apos;&lt;/span&gt;&lt;span class=&quot;code-quote&quot;&gt;&apos; | awk -F= &apos;&lt;/span&gt;/^&lt;span class=&quot;code-quote&quot;&gt;&apos;&lt;span class=&quot;code-quote&quot;&gt;&quot;${configKey}&quot;&lt;/span&gt;&apos;&lt;/span&gt;=/ { val=$2 } END { print val }&apos;)
  fi

  echo &lt;span class=&quot;code-quote&quot;&gt;&quot;${configValue}&quot;&lt;/span&gt;
  &lt;span class=&quot;code-keyword&quot;&gt;return&lt;/span&gt; 1
}

&lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; [ -z &lt;span class=&quot;code-quote&quot;&gt;&quot;${kerberosEnabled}&quot;&lt;/span&gt; ]; then
  kerberosEnabled=$(get_config_from_props_file &lt;span class=&quot;code-quote&quot;&gt;&apos;(kylin|kap).kerberos.enabled&apos;&lt;/span&gt;)
fi &lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;p&gt;Determine whether the result of kerberosEnabled=`${KYLIN_HOME}/bin/get-properties.sh kylin.kerberos.enabled` is empty. If it is empty, directly obtain the value of the configuration item in kylin.properties.override/kylin.properties by grep.&lt;/p&gt;</comment>
