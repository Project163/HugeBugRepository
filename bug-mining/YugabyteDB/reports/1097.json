te SQL (YSQL)"},{"id":1353907551,"node_id":"MDU6TGFiZWwxMzUzOTA3NTUx","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/priority/low","name":"priority/low","color":"ffdc5e","default":false,"description":"Low priority"}],"state":"closed","locked":false,"assignee":{"login":"andrei-mart","id":1223507,"node_id":"MDQ6VXNlcjEyMjM1MDc=","avatar_url":"https://avatars.githubusercontent.com/u/1223507?v=4","gravatar_id":"","url":"https://api.github.com/users/andrei-mart","html_url":"https://github.com/andrei-mart","followers_url":"https://api.github.com/users/andrei-mart/followers","following_url":"https://api.github.com/users/andrei-mart/following{/other_user}","gists_url":"https://api.github.com/users/andrei-mart/gists{/gist_id}","starred_url":"https://api.github.com/users/andrei-mart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andrei-mart/subscriptions","organizations_url":"https://api.github.com/users/andrei-mart/orgs","repos_url":"https://api.github.com/users/andrei-mart/repos","events_url":"https://api.github.com/users/andrei-mart/events{/privacy}","received_events_url":"https://api.github.com/users/andrei-mart/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"andrei-mart","id":1223507,"node_id":"MDQ6VXNlcjEyMjM1MDc=","avatar_url":"https://avatars.githubusercontent.com/u/1223507?v=4","gravatar_id":"","url":"https://api.github.com/users/andrei-mart","html_url":"https://github.com/andrei-mart","followers_url":"https://api.github.com/users/andrei-mart/followers","following_url":"https://api.github.com/users/andrei-mart/following{/other_user}","gists_url":"https://api.github.com/users/andrei-mart/gists{/gist_id}","starred_url":"https://api.github.com/users/andrei-mart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andrei-mart/subscriptions","organizations_url":"https://api.github.com/users/andrei-mart/orgs","repos_url":"https://api.github.com/users/andrei-mart/repos","events_url":"https://api.github.com/users/andrei-mart/events{/privacy}","received_events_url":"https://api.github.com/users/andrei-mart/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2024-02-23T20:20:51Z","updated_at":"2024-03-02T08:00:28Z","closed_at":"2024-02-27T17:15:16Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Jira Link: [DB-10115](https://yugabyte.atlassian.net/browse/DB-10115)\r\n### Description\n\n```\r\n#define PG_STATUS_OK() \\\r\n\t\t} \\\r\n\t\telse \\\r\n\t\t{ \\\r\n\t\t\tYbgStatus status = (YbgStatus) YBCPgSetThreadLocalErrStatus(NULL); \\\r\n\t\t\treturn status ? status : YbgStatusErrorReportingError(); \\\r\n\t\t} \\\r\n\t\tYBCPgSetThreadLocalJumpBuffer(NULL); \\\r\n\t\treturn (YbgStatus) YBCPgSetThreadLocalErrStatus(NULL); \\\r\n\t} while(0)\r\n```\r\nThe `else` block (long jump handler) does not reset the jump buffer.\r\nIt shouldn't cause issues if YbGate is coded properly, that is all PG code invocations are surrounded by PG_SETUP_ERROR_REPORTING/PG_STATUS_OK, but if it is not, segmentation fault is possible instead of proper error.\r\nCurrently PG code is invoked without PG_SETUP_ERROR_REPORTING/PG_STATUS_OK only in tests, and tests failures are possible if tests run in certain order.\n\n### Issue Type\n\nkind/bug\n\n### Warning: Please confirm that this issue does not contain any sensitive information\n\n- [X] I confirm this issue does not contain any sensitive information.\n\n[DB-10115]: https://yugabyte.atlassian.net/browse/DB-10115?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","closed_by":{"login":"andrei-mart","id":1223507,"node_id":"MDQ6VXNlcjEyMjM1MDc=","avatar_url":"https://avatars.githubusercontent.