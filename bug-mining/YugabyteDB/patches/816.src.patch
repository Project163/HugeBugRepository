+  if (update.tablets_size() > 0) {
+    cout << indent << indent << "tablets: ";
+    for (int i = 0; i < update.tablets_size(); i++) {
+      cout << update.tablets(i) << " ";
+    }
+    cout << endl;
+  }
+  if (update.tablet_batches_size() > 0) {
+    cout << indent << indent << "tablet_batches: ";
