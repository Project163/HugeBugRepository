 `pick_list` and `tour` examples with this change. Here's a modified `pick_list` to show the new behavior:\r\n\r\n> https://user-images.githubusercontent.com/4934192/201336666-23823cb0-add6-49c7-8eb6-9a682d30e0fb.mp4","reactions":{"url":"https://api.github.com/repos/iced-rs/iced/issues/1528/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/iced-rs/iced/issues/1528/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":7815428579,"node_id":"REFE_lADOC784y85WJicTzwAAAAHR1fnj","url":"https://api.github.com/repos/iced-rs/iced/issues/events/7815428579","actor":{"login":"hecrj","id":518289,"node_id":"MDQ6VXNlcjUxODI4OQ==","avatar_url":"https://avatars.githubusercontent.com/u/518289?v=4","gravatar_id":"","url":"https://api.github.com/users/hecrj","html_url":"https://github.com/hecrj","followers_url":"https://api.github.com/users/hecrj/followers","following_url":"https://api.github.com/users/hecrj/following{/other_user}","gists_url":"https://api.github.com/users/hecrj/gists{/gist_id}","starred_url":"https://api.github.com/users/hecrj/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hecrj/subscriptions","organizations_url":"https://api.github.com/users/hecrj/orgs","repos_url":"https://api.github.com/users/hecrj/repos","events_url":"https://api.github.com/users/hecrj/events{/privacy}","received_events_url":"https://api.github.com/users/hecrj/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"042020b016705748f83e43c2d47917faa29f7236","commit_url":"https://api.github.com/repos/iced-rs/iced/commits/042020b016705748f83e43c2d47917faa29f7236","created_at":"2022-11-15T16:04:41Z","performed_via_github_app":null},{"id":7815568605,"node_id":"CE_lADOC784y85WJicTzwAAAAHR2Bzd","url":"https://api.github.com/repos/iced-rs/iced/issues/events/7815568605","actor":{"log