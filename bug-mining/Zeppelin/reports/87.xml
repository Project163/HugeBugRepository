      File &quot;/Users/moon/Projects/zeppelin/spark-1.4.0-bin-hadoop2.3/python/pyspark/sql/dataframe.py&quot;, line 617, in _jseq&lt;br/&gt;
        return _to_seq(self.sql_ctx._sc, cols, converter)&lt;br/&gt;
      File &quot;/Users/moon/Projects/zeppelin/spark-1.4.0-bin-hadoop2.3/python/pyspark/sql/column.py&quot;, line 60, in _to_seq&lt;br/&gt;
