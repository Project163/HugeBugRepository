 type so long as it is not itself an enum.Enum subclass.\r\n","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/16320/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/mypy/issues/16320/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"}]