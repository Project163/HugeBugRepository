s","type":"User","user_view_type":"public","site_admin":false}],"milestone":{"url":"https://api.github.com/repos/cypress-io/cypress/milestones/22","html_url":"https://github.com/cypress-io/cypress/milestone/22","labels_url":"https://api.github.com/repos/cypress-io/cypress/milestones/22/labels","id":2000264,"node_id":"MDk6TWlsZXN0b25lMjAwMDI2NA==","number":22,"title":"0.17.5","description":null,"creator":{"login":"brian-mann","id":1268976,"node_id":"MDQ6VXNlcjEyNjg5NzY=","avatar_url":"https://avatars.githubusercontent.com/u/1268976?v=4","gravatar_id":"","url":"https://api.github.com/users/brian-mann","html_url":"https://github.com/brian-mann","followers_url":"https://api.github.com/users/brian-mann/followers","following_url":"https://api.github.com/users/brian-mann/following{/other_user}","gists_url":"https://api.github.com/users/brian-mann/gists{/gist_id}","starred_url":"https://api.github.com/users/brian-mann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brian-mann/subscriptions","organizations_url":"https://api.github.com/users/brian-mann/orgs","repos_url":"https://api.github.com/users/brian-mann/repos","events_url":"https://api.github.com/users/brian-mann/events{/privacy}","received_events_url":"https://api.github.com/users/brian-mann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":14,"state":"closed","created_at":"2016-09-13T04:58:51Z","updated_at":"2016-10-03T01:21:06Z","due_on":null,"closed_at":"2016-10-03T01:21:06Z"},"comments":1,"created_at":"2016-09-21T13:36:48Z","updated_at":"2018-12-07T09:55:39Z","closed_at":"2016-10-03T01:18:51Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":"resolved","sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Currently, a snapshot holds a copy of the `body` with any stylesheet `<link>` tags removed (so that no further requests are made when the snapshot is restored). When tests are finished, the iframe points to and contains the contents of the last page visited (**a**). When a snapshot (**b**) is restored (by hovering over a command in the command log), it replaces the body of the iframe with the copied, stylesheet-less body of the snapshot. \n\nThere are a few problems with this:\n- The CSS from the head of **a** is still there, so **b** will end up using those styles\n- **b** is lacking any `<link>`ed styles that were in its `<body>`, so those styles are missing\n- **b** is lacking any classes that were on its `<html>` tag\n\nSolution:\n\nWhen creating a snapshot:\n- Grab any styles from `<link>`s or `<style>` tags, in order, and preserve them\n- Remove all styles (`<link>` or `<style>` tags) from the copied body\n- Grab any classes from the `<html>` tag and preserve them\n\nWhen restoring a snapshot:\n- Remove any styles in the `<head>` of the iframe (and preserve them for reverting), and restore the `<body>` of the snapshot, inserting the preserved styles\n- Replace any classes on the `<html>` tag with those from the snapshot\n\nWhen reverting to the last page visited:\n- Put back any styles preserved from the `<head>` of the last page visited\n- Replace any classes on the `<html>` tag with those from the last page visited\n","closed_by":{"login":"brian-mann","id":1268976,"node_id":"MDQ6VXNlcjEyNjg5NzY=","avatar_url":"https://avatars.githubusercontent.com/u/1268976?v=4","gravatar_id":"","url":"https://api.github.com/users/brian-mann","html_url":"https://github.com/brian-mann","followers_url":"https://api.github.com/users/brian-mann/followers","following_url":"https://api.github.com/users/brian-mann/following{/other_user}","gists_url":"https://api.github.com/users/brian-mann/gists{/gist_id}","starred_url":"https://api.github.com/users/brian-mann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brian-mann/subscriptions","organizations_url":"https://api.github.com/users/brian-mann/orgs","repos_url":"https://api.github.com/users/brian-mann/repos","events_url":"https://api.github.com/users/brian-mann/events{/privacy}","received_events_url":"https://api.github.com/users/brian-mann/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/cypress-io/cypress/issues/233/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/cypress-io/cypress/issues/233/timeline","performed_via_github_app":null,"state_reason":"completed"}