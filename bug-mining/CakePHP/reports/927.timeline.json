php/cakephp/issues/11958#issuecomment-382068310","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/11958","id":382068310,"node_id":"MDEyOklzc3VlQ29tbWVudDM4MjA2ODMxMA==","user":{"login":"ypnos-web","id":15981753,"node_id":"MDQ6VXNlcjE1OTgxNzUz","avatar_url":"https://avatars.githubusercontent.com/u/15981753?v=4","gravatar_id":"","url":"https://api.github.com/users/ypnos-web","html_url":"https://github.com/ypnos-web","followers_url":"https://api.github.com/users/ypnos-web/followers","following_url":"https://api.github.com/users/ypnos-web/following{/other_user}","gists_url":"https://api.github.com/users/ypnos-web/gists{/gist_id}","starred_url":"https://api.github.com/users/ypnos-web/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ypnos-web/subscriptions","organizations_url":"https://api.github.com/users/ypnos-web/orgs","repos_url":"https://api.github.com/users/ypnos-web/repos","events_url":"https://api.github.com/users/ypnos-web/events{/privacy}","received_events_url":"https://api.github.com/users/ypnos-web/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-04-17T17:02:50Z","updated_at":"2018-04-17T17:02:50Z","body":"This patch works for me:\r\n```diff\r\n--- src/Routing/Router.php  2018-04-17 18:53:38.514626771 +0200\r\n+++ patched/Routing/Router.php   2018-04-17 18:58:02.641960414 +0200\r\n@@ -633,7 +633,7 @@\r\n         }\r\n\r\n         if (empty($url)) {\r\n-            $output = isset($here) ? $here : $base . '/';\r\n+            $output = $base . (isset($here) ? $here : '/');\r\n             if ($full) {\r\n                 $output = static::fullBaseUrl() . $output;\r\n             }\r\n```\r\n\r\nHowever I tried to track down why such a change would be needed in the git history of Routing/Router.php and Http/ServerRequest.php and couldn't figure it out.\r\n\r\nThe old `ServerRequest::here()` method would add the base to $here, implying that it is missing in $here. But this method was not used in `Router::url()`. (instead, it seems $here was accessed directly all the time).","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/382068310/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ypnos-web","id":15981753,"node_id":"MDQ6VXNlcjE1OTgxNzUz","avatar_url":"https://avatars.githubusercontent.com/u/15981753?v=4","gravatar_id":"","url":"https://api.github.com/users/ypnos-web","html_url":"https://github.com/ypnos-web","followers_url":"https://api.github.com/users/ypnos-web/followers","following_url":"https://api.github.com/users/ypnos-web/following{/other_user}","gists_url":"https://api.github.com/users/ypnos-web/gists{/gist_id}","starred_url":"https://api.github.com/users/ypnos-web/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ypnos-web/subscriptions","organizations_url":"https://api.github.com/users/ypnos-web/orgs","repos_url":"https://api.github.com/users/ypnos-web/repos","events_url":"https://api.github.com/users/ypnos-web/events{/privacy}","received_events_url":"https://api.github.com/users/ypnos-web/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/382109864","html_url":"https://github.com/cakephp/cakephp/issues/11958#issuecomment-382109864","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/11958","id":382109864,"node_id":"MDEyOklzc3VlQ29tbWVudDM4MjEwOTg2NA==","user":{"login":"markstory","id":24086,"node_id":"MDQ6VXNlcjI0MDg2","avatar_url":"https://avatars.githubusercontent.com/u/24086?v=4","gravatar_id":"","url":"https://api.github.com/users/markstory","html_url":"https://github.com/markstory","followers_url":"https://api.github.com/users/markstory/followers","following_url":"https://api.github.com/users/markstory