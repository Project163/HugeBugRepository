.github.com/users/robertpang/followers","following_url":"https://api.github.com/users/robertpang/following{/other_user}","gists_url":"https://api.github.com/users/robertpang/gists{/gist_id}","starred_url":"https://api.github.com/users/robertpang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/robertpang/subscriptions","organizations_url":"https://api.github.com/users/robertpang/orgs","repos_url":"https://api.github.com/users/robertpang/repos","events_url":"https://api.github.com/users/robertpang/events{/privacy}","received_events_url":"https://api.github.com/users/robertpang/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-03-12T23:18:14Z","updated_at":"2019-03-12T23:18:24Z","body":"This happens because YugaByte indexes piggyback on PostgreSQL's btree index access methods.  PG's btree indexes support full ordering whereas YugaByte indexes doesn't currently support full ordering yet.\r\n\r\nTo fix the ordering issue, we should mark YugaByte indexes' with `amcanorder = false` in the access method declaration until full ordering is supported.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/472217528/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"robertpang","id":30942926,"node_id":"MDQ6VXNlcjMwOTQyOTI2","avatar_url":"https://avatars.githubusercontent.com/u/30942926?v=4","gravatar_id":"","url":"https://api.github.com/users/robertpang","html_url":"https://github.com/robertpang","followers_url":"https://api.github.com/users/robertpang/followers","following_url":"https://api.github.com/users/robertpang/following{/other_user}","gists_url":"https://api.github.com/users/robertpang/gists{/gist_id}","starred_url":"https://api.github.com/users/robertpang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/robertpang/subscriptions","organizations_url":"https://api.github.com/users/robertpang/orgs","repos_url":"https://api.github.com/users/robertpang/repos","events_url":"https://api.github.com/users/robertpang/events{/privacy}","received_events_url":"https://api.github.com/users/robertpang/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/473101011","html_url":"https://github.com/yugabyte/yugabyte-db/issues/979#issuecomment-473101011","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/979","id":473101011,"node_id":"MDEyOklzc3VlQ29tbWVudDQ3MzEwMTAxMQ==","user":{"login":"robertpang","id":30942926,"node_id":"MDQ6VXNlcjMwOTQyOTI2","avatar_url":"https://avatars.githubusercontent.com/u/30942926?v=4","gravatar_id":"","url":"https://api.github.com/users/robertpang","html_url":"https://github.com/robertpang","followers_url":"https://api.github.com/users/robertpang/followers","following_url":"https://api.github.com/users/robertpang/following{/other_user}","gists_url":"https://api.github.com/users/robertpang/gists{/gist_id}","starred_url":"https://api.github.com/users/robertpang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/robertpang/subscriptions","organizations_url":"https://api.github.com/users/robertpang/orgs","repos_url":"https://api.github.com/users/robertpang/repos","events_url":"https://api.github.com/users/robertpang/events{/privacy}","received_events_url":"https://api.github.com/users/robertpang/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-03-14T23:15:37Z","updated_at":"2019-03-14T23:15:37Z","body":"Similarly, YugaByte indexes return empty bitmap scan causing incorrect result:\r\n\r\n```\r\npostgres=# create table test (v1 int, v2 int, v3 int);\r\nCREATE TABLE\r\npostgres=# create index on test (v2, v3);\r\nCREATE INDEX\r\npostgres=# insert into test values (1, 11, 21), (2, 12, 22), (3, 13, 23), (4, 14, 24), (5, 15, 25);\r\nINSERT 0 5\r\npostgres=# delete from test where v2 = 12 or v2 = 13 returning v2;\r\n v2\r\n----\r\n(0 rows)\r\npostgres=# explain delete from test where v2 = 12 or v2 = 13;\r\n                                          QUERY PLAN\r\n-----------------------------------------------------------------------------------------------\r\n Delete on test  (cost=0.50..4.51 rows=1000 width=68)\r\n   ->  Bitmap Heap Scan on test  (cost=0.50..4.51 rows=1000 width=68)\r\n         Recheck Cond: ((v2 = 12) OR (v2 = 13))\r\n         ->  BitmapOr  (cost=0.50..0.50 rows=1 width=0)\r\n               ->  Bitmap Index Scan on test_v2_v3_idx  (cost=0.00..0.00 rows=1 width=0)\r\n                     Index Cond: (v2 = 12)\r\n               ->  Bitmap Index Scan on test_v2_v3_idx  (cost=0.00..0.00 rows=1 width=0)\r\n                     Index Cond: (v2 = 13)\r\n(8 rows)","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/473101011/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"robertpang","id":30942926,"node_id":"MDQ6VXNlcjMwOTQyOTI2","avatar_url":"https://avatars.githubusercontent.com/u/30942926?v=4","gravatar_id":"","url":"https://api.github.com/users/robertpang","html_url":"https://github.com/robertpang","followers_url":"https://api.github.com/users/robertpang/followers","following_url":"https://api.github.com/users/robertpang/following{/other_user}","gists_url":"https://api.github.com/users/robertpang/gists{/gist_id}","starred_url":"https://api.github.com/users/robertpang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/robertpang/subscriptions","organizations_url":"https://api.github.com/users/robertpang/orgs","repos_url":"https://api.github.com/users/robertpang/repos","events_url":"https://api.g