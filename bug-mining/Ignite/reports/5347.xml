<item>
            <title>[IGNITE-18826] Java thin client hangs on close</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-18826</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;There are several places where thin client threads can hang:&lt;/p&gt;

&lt;p&gt;GridNioClientConnectionMultiplexer: SSL enabled + PA enabled&lt;/p&gt;
&lt;div class=&quot;preformatted panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;preformattedContent panelContent&quot;&gt;
&lt;pre&gt;// Can return finished future with error -&amp;gt; sslHandshakeFut will not complete.
GridNioFuture&amp;lt;GridNioSession&amp;gt; sesFut = srv.createSession(ch, meta, false, null);

 if (sslHandshakeFut != null)
      sslHandshakeFut.get();
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;TcpClientChannel: PA enabled&lt;/p&gt;
&lt;div class=&quot;preformatted panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;preformattedContent panelContent&quot;&gt;
&lt;pre&gt;ClientRequestFuture fut = new ClientRequestFuture(requestId, ClientOperation.HANDSHAKE);

 // TcpClientChannel may be closed and fut will not complete.
assert !closed.get();

pendingReqs.put(requestId, fut);
...
ByteBuffer buf = timeout &amp;gt; 0 ? fut.get(timeout) : fut.get();
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</description>
