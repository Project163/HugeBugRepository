{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/24512","repository_url":"https://api.github.com/repos/yugabyte/yugabyte-db","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/24512/labels{/name}","comments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/24512/comments","events_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/24512/events","html_url":"https://github.com/yugabyte/yugabyte-db/issues/24512","id":2596937879,"node_id":"I_kwDOBlCVUc6ayiCX","number":24512,"title":"[YSQL] A max operation on a subquery with an OFFSET 0 clause returns the max value from the wrong column when yb_enable_expression_pushdown is true","user":{"login":"markpyb","id":128049842,"node_id":"U_kgDOB6Hisg","avatar_url":"https://avatars.githubusercontent.com/u/128049842?v=4","gravatar_id":"","url":"https://api.github.com/users/markpyb","html_url":"https://github.com/markpyb","followers_url":"https://api.github.com/users/markpyb/followers","following_url":"https://api.github.com/users/markpyb/following{/other_user}","gists_url":"https://api.github.com/users/markpyb/gists{/gist_id}","starred_url":"https://api.github.com/users/markpyb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/markpyb/subscriptions","organizations_url":"https://api.github.com/users/markpyb/orgs","repos_url":"https://api.github.com/users/markpyb/repos","events_url":"https://api.github.com/users/markpyb/events{/privacy}","received_events_url":"https://api.github.com/users/markpyb/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":711841622,"node_id":"MDU6TGFiZWw3MTE4NDE2MjI=","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/kind/bug","name":"kind/bug","color":"c2e0c6","default":false,"description":"This issue is a bug"},{"id":1280238232,"node_id":"MDU6TGFiZWwxMjgwMjM4MjMy","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/area/ysql","name":"area/ysql","color":"0c