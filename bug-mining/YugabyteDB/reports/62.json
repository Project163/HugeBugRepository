_url":"https://github.com/spolitov","followers_url":"https://api.github.com/users/spolitov/followers","following_url":"https://api.github.com/users/spolitov/following{/other_user}","gists_url":"https://api.github.com/users/spolitov/gists{/gist_id}","starred_url":"https://api.github.com/users/spolitov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/spolitov/subscriptions","organizations_url":"https://api.github.com/users/spolitov/orgs","repos_url":"https://api.github.com/users/spolitov/repos","events_url":"https://api.github.com/users/spolitov/events{/privacy}","received_events_url":"https://api.github.com/users/spolitov/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"spolitov","id":891914,"node_id":"MDQ6VXNlcjg5MTkxNA==","avatar_url":"https://avatars.githubusercontent.com/u/891914?v=4","gravatar_id":"","url":"https://api.github.com/users/spolitov","html_url":"https://github.com/spolitov","followers_url":"https://api.github.com/users/spolitov/followers","following_url":"https://api.github.com/users/spolitov/following{/other_user}","gists_url":"https://api.github.com/users/spolitov/gists{/gist_id}","starred_url":"https://api.github.com/users/spolitov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/spolitov/subscriptions","organizations_url":"https://api.github.com/users/spolitov/orgs","repos_url":"https://api.github.com/users/spolitov/repos","events_url":"https://api.github.com/users/spolitov/events{/privacy}","received_events_url":"https://api.github.com/users/spolitov/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2018-10-04T13:39:58Z","updated_at":"2018-10-12T05:10:43Z","closed_at":"2018-10-12T05:10:43Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"While trying to reproduce ENG-3945 TServer restarts were added to QLTransactionTest.WriteConflicts.\r\nThat uncovered several issues:\r\n\r\n1. Suppose the following scenario:\r\nTransaction is created and writes 2 intents to tablet TABLET1. last_write_id is set to 2.\r\nTServer restart happens.\r\nTransaction tries to write additional intents to TABLET1 (that could be retry for the same intents).\r\nSince write request contains metadata and transaction participant does not have such running transaction, it creates new running transaction from specified metadata, w/o checking rocksdb, so last_write_id is set to 0.\r\nSo newly added intents has write_id starting with 0, instead of 2. \r\n\r\n2. Log is running in appender_pool, but uses allocation_pool. And allocation_pool is being shutted down before appended_pool. There could be case when operation fails because allocation_pool is shutted down. But Log does not allow such failes, so whole tserver would crash. \r\n\r\n3. It is possible that transaction cannot be aborted, because of remote tserver shutdown. So conflict resolver could hang in endless retry loop. \r\n\r\n4. Verify checksum uses max read time to calculate checksum for cluster. That could hang checksum calculation, because it cannot determine state of pending transaction. \r\n\r\n5. Abort transaction did not check that this tserver is tablet leader. Usually it does not have side effect, because it fails to submit appropriate record to RAFT. But there could be case when we do appropriate checks in non leader mode, and concurrently become leader. So submit to RAFT is successful. That could cause abort of committed transaction. \r\n","closed_by":{"login":"spolitov","id":891914,"node_id":"MDQ6VXNlcjg5MTkxNA==","avatar_url":"https://avatars.githubusercontent.com/u/891914?v=4","gravatar_id":"","url":"https://api.github.com/users/spolitov","html_url":"https://github.com/spolitov","followers_url":"https://api.github.com/users/spolitov/followers","following_url":"https://api.github.com/users/spolitov/following{/other_user}","gists_url":"https://api.github.com/users/spolitov/gists{/gist_id}","starred_url":"https://api.github.com/users/spolitov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/spolitov/subscriptions","organizations_url":"https://api.github.com/users/spolitov/orgs","repos_url":"https://api.github.com/users/spolitov/repos","events_url":"https://api.github.com/users/spolitov/events{/privacy}","received_events_url":"https://api.github.com/users/spolitov/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/493/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/493/timeline","performed_via_github_app":null,"state_reason":"completed"}