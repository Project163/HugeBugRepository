-        PubSubRequest.Builder pubsubRequestBuilder = PubSubRequest.newBuilder();
-        pubsubRequestBuilder.setProtocolVersion(ProtocolVersion.VERSION_ONE);
-        pubsubRequestBuilder.setType(OperationType.CONSUME);
