s/pingustar/events{/privacy}","received_events_url":"https://api.github.com/users/pingustar/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-11-30T12:50:24Z","updated_at":"2023-11-30T12:50:24Z","body":"Same issue here. Plus more ...\r\n\r\nI am experiencing some weird behaviour in Next v14.0.3 when using \"Parallel Routes\" in the app directory:\r\n\r\n1. I have two parallel routes `@dashboard` and `@welcome` in the app folder. The problem is that the layout file for the dashboard is ignored. For welcome it works.\r\n\r\n2. /app/layout.tsx runs twice on first page load, causing my async requests to be fetched twice.\r\n\r\n3. Even though I am only rendering the `@dashboard` route, all async requests in the `@welcome` route are triggered as well.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1833727365/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"pingustar","id":7262066,"node_id":"MDQ6VXNlcjcyNjIwNjY=","avatar_url":"https://avatars.githubusercontent.com/u/7262066?v=4","gravatar_id":"","url":"https://api.github.com/users/pingustar","html_url":"https://github.com/pingustar","followers_url":"https://api.github.com/users/pingustar/followers","following_url":"https://api.github.com/users/pingustar/following{/other_user}","gists_url":"https://api.github.com/users/pingustar/gists{/gist_id}","starred_url":"https://api.github.com/users/pingustar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pingustar/subscriptions","organizations_url":"https://api.github.com/users/pingustar/orgs","repos_url":"https://api.github.com/users/pingustar/repos","events_url":"https://api.github.com/users/pingustar/events{/privacy}","received_events_url":"https://api.github.com/users/pingustar/received_events","type":"User","user_view_ty