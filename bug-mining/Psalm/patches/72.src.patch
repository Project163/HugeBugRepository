+    public static function getFunctionIdsFromCallableArg(
+        StatementsChecker $statements_checker,
+        $callable_arg
+    ) {
+        if ($callable_arg instanceof PhpParser\Node\Scalar\String_) {
+            return [$callable_arg->value];
