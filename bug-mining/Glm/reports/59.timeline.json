ovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"performed_via_github_app":null},{"url":"https://api.github.com/repos/g-truc/glm/issues/comments/34390242","html_url":"https://github.com/g-truc/glm/issues/165#issuecomment-34390242","issue_url":"https://api.github.com/repos/g-truc/glm/issues/165","id":34390242,"node_id":"MDEyOklzc3VlQ29tbWVudDM0MzkwMjQy","user":{"login":"jpvanoosten","id":1395769,"node_id":"MDQ6VXNlcjEzOTU3Njk=","avatar_url":"https://avatars.githubusercontent.com/u/1395769?v=4","gravatar_id":"","url":"https://api.github.com/users/jpvanoosten","html_url":"https://github.com/jpvanoosten","followers_url":"https://api.github.com/users/jpvanoosten/followers","following_url":"https://api.github.com/users/jpvanoosten/following{/other_user}","gists_url":"https://api.github.com/users/jpvanoosten/gists{/gist_id}","starred_url":"https://api.github.com/users/jpvanoosten/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jpvanoosten/subscriptions","organizations_url":"https://api.github.com/users/jpvanoosten/orgs","repos_url":"https://api.github.com/users/jpvanoosten/repos","events_url":"https://api.github.com/users/jpvanoosten/events{/privacy}","received_events_url":"https://api.github.com/users/jpvanoosten/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-02-06T23:57:42Z","updated_at":"2014-02-06T23:58:43Z","body":"After further investigation, I can confirm that this error only occurs if I include the **glm/gtx.hpp** header file. If I don't include the **gtx.hpp** header but instead only include the individual headers then I do not get this error.\n\nSo I changed this:\n\n``` c++\n#define GLM_FORCE_RADIANS\n#include <glm/glm.hpp>\n#include <glm/ext.hpp>\n```\n\nto this:\n\n``` c++\n#define GLM_FORCE_RADIANS\n#include <glm/glm.hpp>\n//#include <glm/ext.hpp>\n#include <glm/gtc/type_ptr.hpp>\n#include <glm/gtc/matrix_transform.hpp>\n#include <glm/gtx/transform.hpp>\n#include <glm/gtx/quaternion.hpp>\n```\n\nI was able to reproduce this error in the **glm/test/gtx/gtx_quaternion.cpp** test case by including the **ext.hpp** header instead of the separate header files.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/g-truc/glm/issues/comments/34390242/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"jpvanoosten","id":1395769,"node_id":"MDQ6VXNlcjEzOTU3Njk=","avatar_url":"https://avatars.githubusercontent.com/u/1395769?v=4","gravatar_id":"","url":"https://api.github.com/users/jpvanoosten","html_url":"https://github.com/jpvanoosten","followers_url":"https://api.github.com/users/jpvanoosten/followers","following_url":"https://api.github.com/users/jpvanoosten/following{/other_user}","gists_url":"https://api.github.com/users/jpvanoosten/gists{/gist_id}","starred_url":"https://api.github.com/users/jpvanoosten/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jpvanoosten/subscriptions","organizations_url":"https://api.github.com/users/jpvanoosten/orgs","repos_url":"https://api.github.com/users/jpvanoosten/repos","events_url":"https://api.github.com/users/jpvanoosten/events{/privacy}","received_events_url":"https://api.github.com/users/jpvanoosten/received_events","type":"User","user_v