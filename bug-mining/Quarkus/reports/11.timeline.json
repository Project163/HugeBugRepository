     @Override\r\n                public void accept(Path path) {\r\n                    if (!Files.isDirectory(path)) {\r\n                        res.add(root.getPath().relativize(path).toString());\r\n                    }\r\n                }\r\n            });\r\n        }\r\n        return new SubstrateResourceBuildItem(res);\r\n    }\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/454857670/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"emmanuelbernard","id":300760,"node_id":"MDQ6VXNlcjMwMDc2MA==","avatar_url":"https://avatars.githubusercontent.com/u/300760?v=4","gravatar_id":"","url":"https://api.github.com/users/emmanuelbernard","html_url":"https://github.com/emmanuelbernard","followers_url":"https://api.github.com/users/emmanuelbernard/followers","following_url":"https://api.github.com/users/emmanuelbernard/following{/other_user}","gists_url":"https://api.github.com/users/emmanuelbernard/gists{/gist_id}","starred_url":"https://api.github.com/users/emmanuelbernard/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/emmanuelbernard/subscriptions","organizations_url":"https://api.github.com/users/emmanuelbernard/orgs","repos_url":"https://api.github.com/users/emmanuelbernard/repos","events_url":"https://api.github.com/users/emmanuelbernard/events{/privacy}","received_events_url":"https://api.github.com/users/emmanuelbernard/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/454860270","html_url":"https://github.com/quarkusio/quarkus/issues/542#issuecomment-454860270","issue_url":"https://api.github.com/repos/quarkusio/quarkus/issues/542","id":454860270,"node_id":"MDEyOklzc3VlQ29tbWVudDQ1NDg2MDI3MA==","user":{"login":"Sanne","id":42573,"node_id