s_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/refs{/sha}","trees_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/trees{/sha}","statuses_url":"https://api.github.com/repos/yugabyte/yugabyte-db/statuses/{sha}","languages_url":"https://api.github.com/repos/yugabyte/yugabyte-db/languages","stargazers_url":"https://api.github.com/repos/yugabyte/yugabyte-db/stargazers","contributors_url":"https://api.github.com/repos/yugabyte/yugabyte-db/contributors","subscribers_url":"https://api.github.com/repos/yugabyte/yugabyte-db/subscribers","subscription_url":"https://api.github.com/repos/yugabyte/yugabyte-db/subscription","commits_url":"https://api.github.com/repos/yugabyte/yugabyte-db/commits{/sha}","git_commits_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/commits{/sha}","comments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/comments{/number}","issue_comment_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments{/number}","contents_url":"https://api.github.com/repos/yugabyte/yugabyte-db/contents/{+path}","compare_url":"https://api.github.com/repos/yugabyte/yugabyte-db/compare/{base}...{head}","merges_url":"https://api.github.com/repos/yugabyte/yugabyte-db/merges","archive_url":"https://api.github.com/repos/yugabyte/yugabyte-db/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/yugabyte/yugabyte-db/downloads","issues_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues{/number}","pulls_url":"https://api.github.com/repos/yugabyte/yugabyte-db/pulls{/number}","milestones_url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones{/number}","notifications_url":"https://api.github.com/repos/yugabyte/yugabyte-db/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels{/name}","releases_url":"https://api.github.com/repos/yugabyte/yugabyte-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"When we create table with indexes where one column is a prefix of the other column, the select queries that use both the column fail with \"Column doesn't exist\" error.\r\n\r\nSteps to reproduce:\r\n```\r\nycqlsh:ybdemo_keyspace> create table benchmark_table_0405 (k text, v text, v1 text, primary key(k)) WITH transactions = { 'enabled' : true };\r\nycqlsh:ybdemo_keyspace> create index idx on benchmark_table_0405 (v);\r\nycqlsh:ybdemo_keyspace>  create index idx1 on benchmark_table_0405 (v1);\r\nycqlsh:ybdemo_keyspace>\r\nycqlsh:ybdemo_keyspace> select * from benchmark_table_0405 where v = 'def' and v1 = 'efg';\r\nInvalidRequest: Error from server: code=2200 [Invalid query] message=\"Undefined Column. Column doesn't exist\r\nselect * from benchmark_table_0405 where v = 'def' and v1 = 'efg';\r\n                                                       ^^\r\n (ql error -203)\"\r\n```\r\n\r\nNote that without indexes the problem doesn't exist.\r\n```\r\nycqlsh:ybdemo_keyspace> create table benchmark_table_0405 (k text, v text, v1 text, primary key(k)) WITH transactions = { 'enabled' : true };\r\nycqlsh:ybdemo_keyspace> insert into benchmark_table_0405 (k,v,v1) values ('abc', 'def', 'efg');\r\nycqlsh:ybdemo_keyspace> select * from benchmark_table_0405 where v = 'def' and v1 = 'efg';\r\n k   | v   | v1\r\n-----+-----+-----\r\n abc | def | efg\r\n\r\n```\r\n\r\nAlso this is a problem only when one column is a prefix of the other:\r\n```\r\nycqlsh:ybdemo_keyspace> create table benchmark_table_0405 (k text, v2 text, v1 text, primary key(k)) WITH transactions = { 'enabled' : true };\r\nycqlsh:ybdemo_keyspace> create index idx1 on benchmark_table_0405 (v1);\r\nycqlsh:ybdemo_keyspace> create index idx2 on benchmark_table_0405 (v2);\r\nycqlsh:ybdemo_keyspace>  insert into benchmark_table_0405 (k,v1,v2) values ('abc', 'def', 'efg');\r\nycqlsh:ybdemo_keyspace> select * from benchmark_table_0405 where v1 = 'def' and v2 = 'efg';\r\n k   | v2  | v1\r\n-----+-----+-----\r\n abc | efg | def\r\n```","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/4881/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/4881/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/650606783","html_url":"https://github.com/yugabyte/yugabyte-db/issues/4908#issuecomment-650606783","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/4908","id":650606783,"node_id":"MDEyOklzc3VlQ29tbWVudDY1MDYwNjc4Mw==","user":{"login":"m-iancu","id":4038003,"node_id":"MDQ6VXNlcjQwMzgwMDM=","avatar_url":"h