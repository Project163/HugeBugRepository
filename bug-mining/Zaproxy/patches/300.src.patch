diff --git a/docker/zap-x.sh b/docker/zap-x.sh
index 7e70e75c8..9899eb52e 100755
--- a/docker/zap-x.sh
+++ b/docker/zap-x.sh
@@ -1,11 +1,20 @@
 #!/bin/sh
+
 export DISPLAY=:1.0
 if [ ! -f /tmp/.X1-lock ]
 then
   Xvfb :1 -screen 0 1024x768x16 -ac -nolisten tcp -nolisten unix &
 fi
+
+# Run ZAP and capture the exit code
 /zap/zap.sh "$@"
+exit_code=$?
+
+if [ -f /tmp/.X1-lock ]
+then
+  # Shutdown xvfb
+  kill -9 `cat /tmp/.X1-lock`
+  rm -f /tmp/.X1-lock
+fi
 
-# Shutdown xvfb
-kill -9 `cat /tmp/.X1-lock`
-rm -f /tmp/.X1-lock
+exit $exit_code
