s_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"In case of row update of table with multiple indexes postgres deletes all old indexes and creates new one even in case indexed columns has not been changed.\r\nReason is that in vanilla postgres updated row has new ctid.\r\nBut YB doesn't change ybctid in case of row update in this case indexes of unchanged columns may be preserved.\r\n\r\n```\r\nyugabyte=# create table t(k int, v1 int, v2 int);\r\nyugabyte=# create unique index on t(v1);\r\nyugabyte=# create unique index on t(v2);\r\nyugabyte=# insert into t values(1, 10, 100);\r\nyugabyte=# update t set v1=v1+9 where v2>0;\r\n```\r\n\r\nIn the following scenario one row will be updated. Both v1 and v2 indexes will be changed (delete + insert write operation).\r\nFor v1 index value '10' will be delete and '19' will be inserted\r\nFor v2 index value '100' will be deleted and '100' will be inserted. Operation on v2 index are unnecessary as row's ybctid is not changed by UPDATE command\n","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/3329/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/3329/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]