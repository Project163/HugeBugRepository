&lt;p&gt;&lt;span class=&quot;error&quot;&gt;&amp;#91;02:39:02&amp;#93;&lt;/span&gt;&lt;span class=&quot;error&quot;&gt;&amp;#91;Apache.Ignite.Core.Tests.exe&amp;#93;&lt;/span&gt; &lt;span class=&quot;error&quot;&gt;&amp;#91;23-05-2018 23:39:04&amp;#93;&lt;/span&gt;&lt;span class=&quot;error&quot;&gt;&amp;#91;INFO &amp;#93;&lt;/span&gt;&lt;a href=&quot;#7726&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;exchange-worker-#7726&lt;/a&gt;&lt;span class=&quot;error&quot;&gt;&amp;#91;GridCacheProcessor&amp;#93;&lt;/span&gt; Started cache &lt;span class=&quot;error&quot;&gt;&amp;#91;name=template_store*, id=-1227147570, memoryPolicyName=default, mode=LOCAL, atomicity=TRANSACTIONAL, backups=0&amp;#93;&lt;/span&gt;&lt;/p&gt;

