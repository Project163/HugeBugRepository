-void DuplexChannelManager::removeChannel(const DuplexChannelPtr& channel) {
-  {
-    boost::lock_guard<boost::shared_mutex> aclock(allchannels_lock);
-    allchannels.erase(channel); // channel should be deleted here
-  }
-  channel->close();
-}
