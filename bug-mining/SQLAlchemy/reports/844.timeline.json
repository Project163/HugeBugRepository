\nModelBase = declarative_base(cls=Base)\r\n\r\nclass TestModel(ModelBase):\r\n\t__tablename__ = 'tblTest'\r\n\tid = Column('id', Integer, primary_key=True)\r\n\tname = Column('name', String(length=32), default=None, nullable=True)\r\n\t\r\n# 1) Create Schema & Populate\r\n#############################\r\ntest_engine = create_engine('sqlite:///:memory:')\r\ntest_session_factory = sessionmaker(bind=test_engine)\r\ntest_session = test_session_factory()\r\n\r\nfor i in range(3):\r\n\t# This create_all will reset the\r\n\t# schema on flush in versions >1.3.0b1\r\n\tTestModel.metadata.create_all(test_engine)\r\n\tmodel = TestModel()\r\n\tmodel.name = 'Test'\r\n\ttest_session.add(model)\r\n\ttest_session.flush()\r\n\r\ntest_session.commit()\r\ntest_session.close()\r\n\r\n# 2) Query\r\n##########\r\ntest_session_factory = sessionmaker(bind=test_engine)\r\ntest_session = test_session_factory()\r\n\r\nquery = test_session.query(TestModel)\r\nprint(query.count())\r\n```\r\n\r\n\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/479333721/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"crosoftzach","id":44620162,"node_id":"MDQ6VXNlcjQ0NjIwMTYy","avatar_url":"https://avatars.githubusercontent.com/u/44620162?v=4","gravatar_id":"","url":"https://api.github.com/users/crosoftzach","html_url":"https://github.com/crosoftzach","followers_url":"https://api.github.com/users/crosoftzach/followers","following_url":"https://api.github.com/users/crosoftzach/following{/other_user}","gists_url":"https://api.github.com/users/crosoftzach/gists{/gist_id}","starred_url":"https://api.github.com/users/crosoftzach/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/crosoftzach/subscriptions","organizations_url":"https://api.github.com/users/crosoftzach/orgs","repos_url":"https://api.g