       Some("js") => Self::Js,
       Some("json") => Self::Json,
       Some("jsonld") => Self::Jsonld,
+      Some("mjs") => Self::Js,
       Some("rtf") => Self::Rtf,
       Some("svg") => Self::Svg,
       Some("mp4") => Self::Mp4,
@@ -115,6 +116,9 @@ mod tests {
     let jsonld: String = MimeType::parse_from_uri("https:/example.com/hello.jsonld").to_string();
     assert_eq!(jsonld, String::from("application/ld+json"));
 
