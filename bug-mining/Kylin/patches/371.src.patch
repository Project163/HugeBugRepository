+        Assertions.assertEquals("concat('\\\\\\\\', ifnull(\"c\".\"d\", '-'))",
+                StringHelper.backtickToDoubleQuote("concat('\\\\\\\\', ifnull(`c`.`d`, '-'))"));
+        // It's correct.
+        Assertions.assertEquals("concat(''', ifnull(`c`.`d`, 1)', '-')",
