+ f1 |  f2   
+----+-------
+  1 | one
+  2 | two
+  3 | three
+(3 rows)
+
+SELECT * FROM locktest WHERE f1 = 2 FOR UPDATE;
+ f1 | f2  
+----+-----
+  2 | two
+(1 row)
+
+SELECT * FROM locktest WHERE f1 IN (SELECT f1 FROM locktest WHERE f1 < 3) FOR UPDATE;
