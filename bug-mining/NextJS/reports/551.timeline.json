github.com/users/FNogueiraIntekMedical/following{/other_user}","gists_url":"https://api.github.com/users/FNogueiraIntekMedical/gists{/gist_id}","starred_url":"https://api.github.com/users/FNogueiraIntekMedical/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/FNogueiraIntekMedical/subscriptions","organizations_url":"https://api.github.com/users/FNogueiraIntekMedical/orgs","repos_url":"https://api.github.com/users/FNogueiraIntekMedical/repos","events_url":"https://api.github.com/users/FNogueiraIntekMedical/events{/privacy}","received_events_url":"https://api.github.com/users/FNogueiraIntekMedical/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-09-29T07:21:23Z","updated_at":"2023-09-29T07:21:23Z","body":"Hello, dear Contributors!\r\n\r\nWould like to know when this change will take effect on running the command 'npx create-next-app'. I just tried it and still face the same issue, all the dependencies are marked with 'latest' instead of the pinned versions. \r\n\r\n(Sorry for the ignorance on how these changes work in a big project like this.)\r\n\r\nThanks!","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1740422358/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"FNogueiraIntekMedical","id":131365805,"node_id":"U_kgDOB9R7rQ","avatar_url":"https://avatars.githubusercontent.com/u/131365805?v=4","gravatar_id":"","url":"https://api.github.com/users/FNogueiraIntekMedical","html_url":"https://github.com/FNogueiraIntekMedical","followers_url":"https://api.github.com/users/FNogueiraIntekMedical/followers","following_url":"https://api.github.com/users/FNogueiraIntekMedical/following{/other_user}","gists_url":"https://api.github.com/users/FNogueiraIntekMedical/gists{/gist_id}","starred_url":"https://api.github.com/users/FNogueiraIntekMedical/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/FNogueiraIntekMedical/subscriptions","organizations_url":"https://api.github.com/users/FNogueiraIntekMedical/orgs","repos_url":"https://api.github.com/users/FNogueiraIntekMedical/repos","events_url":"https://api.github.com/users/FNogueiraIntekMedical/events{/privacy}","received_events_url":"https://api.github.com/users/FNogueiraIntekMedical/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1740437543","html_url":"https://github.com/vercel/next.js/issues/56174#issuecomment-1740437543","issue_url":"https://api.github.com/repos/vercel/next.js/issues/56174","id":1740437543,"node_id":"IC_kwDOBC3Cis5nvPgn","user":{"login":"joulev","id":44609036,"node_id":"MDQ6VXNlcjQ0NjA5MDM2","avatar_url":"https://avatars.githubusercontent.com/u/44609036?v=4","gravatar_id":"","url":"https://api.github.com/users/joulev","html_url":"https://github.com/joulev","followers_url":"https://api.github.com/users/joulev/followers","following_url":"https://api.github.com/users/joulev/following{/other_user}","gists_url":"https://api.github.com/users/joulev/gists{/gist_id}","starred_url":"https://api.github.com/users/joulev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joulev/subscriptions","organizations_url":"https://api.github.com/users/joulev/orgs","repos_url":"https://api.github.com/users/joulev/repos","events_url":"https://api.github.com/users/joulev/events{/privacy}","received_events_url":"https://api.github.com/users/joulev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-09-29T07:32:50Z","updated_at":"2023-09-29T07:32:50Z","body":"@FNogueiraIntekMedical Right now it's not yet easily doable.\r\n\r\nWhen Next.js releases v13.5.4-canary.7, you can use `npx create-next-app@canary` for this.\r\n\r\nIf you want to use the stable channel, wait until v13.5.4 is released, then you can use `npx create-next-app@latest`.\r\n\r\nIf you need it right now, `npx create-next-app@13.5.2` should do the job (it will be the previous behaviour of `create-next-app`, not the changes applied in the above PR).\r\n\r\nNote that the behaviours of `create-next-app@13.5.2` is different from the changes above:\r\n\r\n* 13.5.2 and previous: all versions are pinned (`\"react\": \"18.2.0\"`) but all dependencies are `dependencies` (not separated to deps and devDeps – but this doesn't matter). I personally like this one the most.\r\n* 13.5.3: everything is `latest` (`\"react\": \"latest\"`).\r\n* 13.5.4 and later: it will be \"pinned to the major version\" (idk how to explain it). Basically it will be `\"react\": \"^18\"`, not `\"react\": \"18.2.0\"`.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1740437543/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"joulev","id":44609036,"node_id":"MDQ6VXNlcjQ0NjA5MDM2","avatar_url":"https://avatars.githubusercontent.com/u/44609036?v=4","gravatar_id":"","url":"https://api.github.com/users/joulev","html_url":"https://github.com/joulev","followers_url":"https://api.github.com/users/joulev/followers","following_url":"https://api.github.com/users/joulev/following{/other_user}","gists_url":"https://api.github.com/users/joulev/gists{/gist_id}","starred_url":"https://api.github.com/users/joulev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joulev/subscriptions","organizations_url":"https://api.github.com/users/joulev/orgs","repos_url":"https://api.github.com/users/joulev/repos","events_url":"https://api.github.com/users/joulev/events{/privacy}","received_events_url":"https://api.github.com/users/joulev/received_events","type":"User","user_view_type":"public","site_admin":fal