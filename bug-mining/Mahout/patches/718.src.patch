-    int numMappedElements = values.getNumMappings();
-    int numNonZeros = 0;
-    for (int index = 0; index < numMappedElements; index++) {
-      if (elementValues[index] != 0) {
-        numNonZeros++;
-      }
-    }
-    return numNonZeros;
-  }
-
-  @Override
-  public double getLookupCost() {
