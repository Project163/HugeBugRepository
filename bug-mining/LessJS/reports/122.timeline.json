o tree.Directive nodes. I added isRulesetLike\nmethod to the tree.Directive to differentiate between them.\n\nIssue #1954: The condition treated all tree.Anonymous types as rules and\ncaused them to float up. That is incorrect, because `@import (inline)` is\ncompiled into tree.Anonymous too, but should be treated as ruleset and\nstay where it is.\n","reactions":{"url":"https://api.github.com/repos/less/less.js/issues/2117/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/less/less.js/issues/2117/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":145782854,"node_id":"MDEyOkxhYmVsZWRFdmVudDE0NTc4Mjg1NA==","url":"https://api.github.com/repos/less/less.js/issues/events/145782854","actor":{"login":"SomMeri","id":618879,"node_id":"MDQ6VXNlcjYxODg3OQ==","avatar_url":"https://avatars.githubusercontent.com/u/618879?v=4","gravatar_id":"","url":"https://api.github.com/users/SomMeri","html_url":"https://github.com/SomMeri","followers_url":"https://api.github.com/users/SomMeri/followers","following_url":"https://api.github.com/users/SomMeri/following{/other_user}","gists_url":"https://api.github.com/users/SomMeri/gists{/gist_id}","starred_url":"https://api.github.com/users/SomMeri/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SomMeri/subscriptions","organizations_url":"https://api.github.com/users/SomMeri/orgs","repos_url":"https://api.github.com/users/SomMeri/repos","events_url":"https://api.github.com/users/SomMeri/events{/privacy}","received_events_url":"https://api.github.com/users/SomMeri/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2014-07-25T20:42:49Z","label":{"name":"Has Pull Request","color":"d7e102"},"performed_via_github_app":null},{"id":145986024,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDE0NTk4NjAyNA=