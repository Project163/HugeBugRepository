m/users/elazarg/following{/other_user}","gists_url":"https://api.github.com/users/elazarg/gists{/gist_id}","starred_url":"https://api.github.com/users/elazarg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elazarg/subscriptions","organizations_url":"https://api.github.com/users/elazarg/orgs","repos_url":"https://api.github.com/users/elazarg/repos","events_url":"https://api.github.com/users/elazarg/events{/privacy}","received_events_url":"https://api.github.com/users/elazarg/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2016-09-06T07:51:03Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/python/mypy/issues/comments/244876688","html_url":"https://github.com/python/mypy/issues/2098#issuecomment-244876688","issue_url":"https://api.github.com/repos/python/mypy/issues/2098","id":244876688,"node_id":"MDEyOklzc3VlQ29tbWVudDI0NDg3NjY4OA==","user":{"login":"elazarg","id":5108069,"node_id":"MDQ6VXNlcjUxMDgwNjk=","avatar_url":"https://avatars.githubusercontent.com/u/5108069?v=4","gravatar_id":"","url":"https://api.github.com/users/elazarg","html_url":"https://github.com/elazarg","followers_url":"https://api.github.com/users/elazarg/followers","following_url":"https://api.github.com/users/elazarg/following{/other_user}","gists_url":"https://api.github.com/users/elazarg/gists{/gist_id}","starred_url":"https://api.github.com/users/elazarg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elazarg/subscriptions","organizations_url":"https://api.github.com/users/elazarg/orgs","repos_url":"https://api.github.com/users/elazarg/repos","events_url":"https://api.github.com/users/elazarg/events{/privacy}","received_events_url":"https://api.github.com/users/elazarg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-09-06T07:55:51Z","updated_at":"2016-09-06T08:00:41Z","body":"I think that because `x = x * 0.5` is an assignment, mypy considers it as introducing a \"new variable\", whereas `x *= 0.5` is a method call, and it operates on a previously defined variable.\n\nIn other words,  `x = x * 0.5` contains two distinct variables with possibly distinct types, and `x *= 0.5` contains a single variable.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/244876688/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"elazarg","id":5108069,"node_id":"MDQ6VXNlcjUxMDgwNjk=","avatar_url":"https://avatars.githubusercontent.com/u/5108069?v=4","gravatar_id":"","url":"https://api.github.com/users/elazarg","html_url":"https://github.com/elazarg","followers_url":"https://api.github.com/users/elazarg/followers","following_url":"https://api.github.com/users/elazarg/following{/other_user}","gists_url":"https://api.github.com/users/elazarg/gists{/gist_id}","starred_url":"https://api.github.com/users/elazarg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elazarg/subscriptions","organizations_url":"https://api.github.com/users/elazarg/orgs","repos_url":"https://api.github.com/users/elazarg/repos","events_url":"https://api.github.com/users/elazarg/events{/privacy}","received_events_url":"https://api.github.com/users/elazarg/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/python/mypy/issues/comments/244910123","html_url":"https://github.com/python/mypy/issues/2098#issuecomment-244910123","issue_url":"https://api.github.com/repos/python/mypy/issues/2098","id":244910123,"node_id":"MDEyOklzc3VlQ29tbWVudDI0NDkxMDEyMw==","user":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-09-06T10:22:16Z","updated_at":"2016-09-06T10:22:16Z","body":"It seems that `*=` doesn't rebind the variable type, unlike `=`. However, I think that it should.\n\n`=` doesn't actually introduce new variable but it does introduce a new \"type binding\" for a variable. This means that the new binding must be compatible with the declared or inferred type of the variable -- mypy doesn't currently let you arbitrarily redefine a variable.\n","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/244910123/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/python/mypy/issues/comments/244911790","html_url":"https://github.com/python/mypy/issues/2098#issuecomment-244911790","issue_url":"https://api.github.com/repos/python/mypy/issues/2098","id":244911790,"node_id":"MDEyOklzc3VlQ29tbWVudDI0NDkxMTc5MA==","user":{"login":"JdeH","id":1730289,"node_id":"MDQ6VXNlcjE3MzAyODk=","avatar_url":"https://avatars.githubusercontent.com/u/1730289?v=4","gravatar_id":"","url":"https://api.github.com/users/JdeH","html_url":"https://github.com/JdeH","followers_url":"https://api.github.com/users/JdeH/followers","following_url":"https://api.github.com/users/JdeH/following{/other_user}","gists_url":"https://api.github.com/users/JdeH/gists{/gist_id}","starred_url":"https://api.github.com/users/JdeH/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JdeH/subscriptions","organizations_url":"https://api.github.com/users/JdeH/orgs","repos_url":"https://api.github.com/users/JdeH/repos","events_url":"https://api.github.com/users/JdeH/events{/privacy}","received_events_url":"https://api.github.com/users/JdeH/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-09-06T10:31:13Z","updated_at":"2016-09-06T10:31:13Z","body":"Indeed from a 'user' point of view, the disparity between simple assignment and augmented assignment is hard to comprehend. At least for me it was... So if it could be avoided I think it would be an improvement.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/244911790/reac