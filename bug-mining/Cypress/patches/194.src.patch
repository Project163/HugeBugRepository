+  const todo = {
+    title: 'clean',
+    done: false,
+    id: 1,
+  }
+  const handleChecked = cy.stub()
+  mount(<Todo todo={todo} key={todo.id} handleChecked={handleChecked} />)
+  cy.contains('clean')
