+                .when(queryRoutingEngine).execute(Mockito.anyString(), Mockito.any());
+        try {
+            queryRoutingEngine.queryWithSqlMassage(queryParams);
+        } catch (Exception e) {
+            Assert.assertTrue(e.getCause() instanceof NewQueryRefuseException);
