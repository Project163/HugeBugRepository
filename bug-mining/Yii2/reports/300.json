b.com/repos/yiisoft/yii2/milestones/4","html_url":"https://github.com/yiisoft/yii2/milestone/4","labels_url":"https://api.github.com/repos/yiisoft/yii2/milestones/4/labels","id":295313,"node_id":"MDk6TWlsZXN0b25lMjk1MzEz","number":4,"title":"2.0 RC","description":"* Close-to-release quality\r\n* No more new features\r\n* Similar to that in 1.1.\r\n* Continue fixing issues.\r\n* Should last around two or more weeks before GA release, depending on the issue reports.\r\n* No guarantee of BC","creator":{"login":"qiangxue","id":993322,"node_id":"MDQ6VXNlcjk5MzMyMg==","avatar_url":"https://avatars.githubusercontent.com/u/993322?v=4","gravatar_id":"","url":"https://api.github.com/users/qiangxue","html_url":"https://github.com/qiangxue","followers_url":"https://api.github.com/users/qiangxue/followers","following_url":"https://api.github.com/users/qiangxue/following{/other_user}","gists_url":"https://api.github.com/users/qiangxue/gists{/gist_id}","starred_url":"https://api.github.com/users/qiangxue/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qiangxue/subscriptions","organizations_url":"https://api.github.com/users/qiangxue/orgs","repos_url":"https://api.github.com/users/qiangxue/repos","events_url":"https://api.github.com/users/qiangxue/events{/privacy}","received_events_url":"https://api.github.com/users/qiangxue/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":1098,"state":"closed","created_at":"2013-03-25T02:58:32Z","updated_at":"2015-03-06T20:40:33Z","due_on":"2014-09-28T07:00:00Z","closed_at":"2014-09-28T13:09:58Z"},"comments":5,"created_at":"2014-09-06T11:28:17Z","updated_at":"2014-09-13T08:17:12Z","closed_at":"2014-09-12T20:46:20Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Relation definition:\n\n``` php\n    public function getCharacters()\n    {\n        return $this->hasMany(Character::class, ['show_id' => 'id']);\n    }\n\n    public function getGuestCharacters()\n    {\n        $query = $this->getCharacters()->select(['Character.*', 'count(*) as count'])->innerJoinWith('guestCasts', false)->groupBy('Character.id')->orderBy('count DESC');\n\n        return $query;\n    }\n```\n\nCommand:\n\n``` php\n$show->guestCharacters;\n```\n\nGenerated query (correct):\n\n``` sql\nSELECT `Character`.*, count(*) as count FROM `Character` INNER JOIN `GuestCast` ON `Character`.`id` = `GuestCast`.`character_id` WHERE `Character`.`show_id`=1012 GROUP BY `Character`.`id` ORDER BY `count` DESC LIMIT 20\n```\n\nPagination-count-query (incorrect):\n\n``` sql\nSELECT COUNT(*) FROM (SELECT `Character`.*, count(*) as count FROM `Character` INNER JOIN `GuestCast` ON `Character`.`id` = `GuestCast`.`character_id` GROUP BY `Character`.`id`) `c`\n```\n\nAs you can see the WHERE part (`WHERE Character.show_id=1012`) has disappeared from the query after it's gone through prepareTotalCount(), which causes the pagination to be completely off.\n","closed_by":{"login":"qiangxue","id":993322,"node_id":"MDQ6VXNlcjk5MzMyMg==","avatar_url":"https://avatars.githubusercontent.com/u/993322?v=4","gravatar_id":"","url":"https://api.github.com/users/qiangxue","html_url":"https://github.com/qiangxue","followers_url":"https://api.github.com/users/qiangxue/followers","following_url":"https://api.github.com/users/qiangxue/following{/other_user}","gists_url":"https://api.github.com/users/qiangxue/gists{/gist_id}","starred_url":"https://api.github.com/users/qiangxue/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qiangxue/subscriptions","organizations_url":"https://api.github.com/users/qiangxue/orgs","repos_url":"https://api.github.com/users/qiangxue/repos","events_url":"https://api.github.com/users/qiangxue/events{/privacy}","received_events_url":"https://a