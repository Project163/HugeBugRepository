+			{`#\(`, LiteralStringSymbol, Push("parenth")},
+			{`\)`, Text, Push("afterobject")},
+			{`(\d+r)?-?\d+(\.\d+)?(e-?\d+)?`, LiteralNumber, Push("afterobject")},
+		},
+		"_parenth_helper": {
+			Include("whitespaces"),
+			{`(\d+r)?-?\d+(\.\d+)?(e-?\d+)?`, LiteralNumber, nil},
