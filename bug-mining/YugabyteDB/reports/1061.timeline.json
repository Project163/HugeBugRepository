e/yugabyte-db/hooks","issue_events_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events{/number}","events_url":"https://api.github.com/repos/yugabyte/yugabyte-db/events","assignees_url":"https://api.github.com/repos/yugabyte/yugabyte-db/assignees{/user}","branches_url":"https://api.github.com/repos/yugabyte/yugabyte-db/branches{/branch}","tags_url":"https://api.github.com/repos/yugabyte/yugabyte-db/tags","blobs_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/refs{/sha}","trees_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/trees{/sha}","statuses_url":"https://api.github.com/repos/yugabyte/yugabyte-db/statuses/{sha}","languages_url":"https://api.github.com/repos/yugabyte/yugabyte-db/languages","stargazers_url":"https://api.github.com/repos/yugabyte/yugabyte-db/stargazers","contributors_url":"https://api.github.com/repos/yugabyte/yugabyte-db/contributors","subscribers_url":"https://api.github.com/repos/yugabyte/yugabyte-db/subscribers","subscription_url":"https://api.github.com/repos/yugabyte/yugabyte-db/subscription","commits_url":"https://api.github.com/repos/yugabyte/yugabyte-db/commits{/sha}","git_commits_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/commits{/sha}","comments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/comments{/number}","issue_comment_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments{/number}","contents_url":"https://api.github.com/repos/yugabyte/yugabyte-db/contents/{+path}","compare_url":"https://api.github.com/repos/yugabyte/yugabyte-db/compare/{base}...{head}","merges_url":"https://api.github.com/repos/yugabyte/yugabyte-db/merges","archive_url":"https://api.github.com/repos/yugabyte/yugabyte-db/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/yugabyte/yugabyte-db/downloads","issues_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues{/number}","pulls_url":"https://api.github.com/repos/yugabyte/yugabyte-db/pulls{/number}","milestones_url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones{/number}","notifications_url":"https://api.github.com/repos/yugabyte/yugabyte-db/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels{/name}","releases_url":"https://api.github.com/repos/yugabyte/yugabyte-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Jira Link: [DB-9035](https://yugabyte.atlassian.net/browse/DB-9035)\r\n### Description\n\nThis is a follow up issue for #19965 , the relevant code is in function `CheckCmdReplicaIdentity`:\r\n```\r\n    /*\r\n     * In per-database catalog version mode at the end of a global-impact\r\n     * DDL statement, we internally call yb_increment_all_db_catalog_versions\r\n     * which sets yb_non_ddl_txn_for_sys_tables_allowed to true in order to\r\n     * update pg_yb_catalog_version table. More generally, a user may want\r\n     * to manually set yb_non_ddl_txn_for_sys_tables_allowed to true and then\r\n     * perform an update on pg_yb_catalog_version table to force catalog cache\r\n     * refresh.\r\n     * NOTE: we may need to allow more system tables in YB context.\r\n     */\r\n    if (IsYugaByteEnabled() &&\r\n        yb_non_ddl_txn_for_sys_tables_allowed &&\r\n        RelationGetRelid(rel) == YBCatalogVersionRelationId)\r\n        return;\r\n```\r\nIn #19965 , I made a special case for `pg_yb_catalog_version` table. However in YSQL migration scripts, we have similar situation such as:\r\n```\r\n  SET LOCAL yb_non_ddl_txn_for_sys_tables_allowed TO true;\r\n\r\n  -- Add a column for stream ID in pg_get_replication_slots\r\n  -- TODO: As a workaround for GHI #13500, we perform a delete + insert instead\r\n  -- of an update into pg_proc. Restore to UPDATE once fixed.\r\n  DELETE FROM pg_catalog.pg_proc WHERE proname = 'pg_get_replication_slots' AND\r\n    pronamespace = 'pg_catalog'::regnamespace;\r\n```\r\nLet's say in a cluster where the user has executed:\r\n\r\n```\r\n    yugabyte=# CREATE PUBLICATION testpub_foralltables FOR ALL TABLES;\r\n    CREATE PUBLICATION\r\n```\r\n\r\nThen when running the above YSQL migration command `DELETE` can fail because of `CheckCmdReplicaIdentity`. As I understand, in YSQL we use `pg_publication` table but repurpose it for YSQL replication which does not use the same mechanism as PG's replication. In such a case, I am wondering whether the PG logic in `CheckCmdReplicaIdentity` still applies in Yugabyte context. In other words, can we simplify the above special case code to:\r\n\r\n```\r\n    if (IsYugaByteEnabled())\r\n        return;\r\n```\r\n\r\nOr a bit more conservatively:\r\n\r\n```\r\n    if (IsYugaByteEnabled() &&\r\n        yb_non_ddl_txn_for_sys_tables_allowed)\r\n        return;\r\n```\n\n### Issue Type\n\nkind/bug\n\n### Warning: Please confirm that this issue does not contain any sensitive information\n\n- [X] I confirm this issue does not contain any sensitive information.\n\n[DB-9035]: https://yugabyte.atlassian.net/browse/DB-9035?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/20085/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/20085/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":11157312801,"node_id":"CE_lADOBlCVUc5292jizwAAAAKZBxUh","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/11157312801","actor":{"login":"yugabyte-ci","id":17281578,"node_id":"MDQ6VXNlcjE3MjgxNTc4","avatar_url":"https://avatars.githubusercontent.com/u/17281578?v=4","gravatar_id":"","url":"https://api.github.com/users/yugabyte-ci","html_url":"https://github.com/yugabyte-ci","followers_url":"https://api.github.com/users/yugabyte-ci/followers","following_url":"https://api.github.com/users/yugabyte-ci/following{/other_user}","gists_url":"https://api.github.com/users/yugabyte-ci/gists{/gist_id}","starred_url":"https://api.github.com/users/yugabyte-ci/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yugabyte-ci/subscriptions","organizations_url":"https://api.github.com/users/yugabyte-ci/orgs","repos_url":"https://api.github.com/users/yugabyte-ci/repos","events_url":"https://api.github.com/users/yugabyte-ci/events{/privacy}","received_events_url":"https://api.github.com/users/yugabyte-ci/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2023-12-05T18:06:03Z","state_reason":null,"performed_via_github_app":null},{"id":11195413522,"node_id":"REFE_lADOBlCVUc5292jizwAAAAKbTHQS","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/11195413522","actor":{"login":"myang2021","id":79478033,"node_id":"MDQ6VXNlcjc5NDc4MDMz","avatar_url":"https://avatars.githubusercontent.com/u/79478033?v=4","gravatar_id":"","url":"https://api.github.com/users/myang2021","html_url":"https://github.com/myang2021","followers_url":"https://api.github.com/users/myang2021/followers","following_url":"https://api.github.com/users/myang2021/following{/other_user}","gists_url":"https://api.github.com/users/myang2021/gists{/gist_id}","starred_url":"https://api.github.com/users/myang2021/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/myang2021/subscriptions","organizations_url":"https://api.github.com/users/myang2021/orgs","repos_url":"https://api.github.com/users/myang2021/repos","events_url":"https://api.github.com/users/myang2021/events{/privacy}","received_events_url":"https://api.github.com/users/myang2021/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"d6a81eef1e9b8573ab7669cfeca55bfffd97cc93","commit_url":"https://api.github.com/repos/yugabyte/yugabyte-db/commits/d6a81eef1e9b8573ab7669cfeca55bfffd97cc93","created_at":"2023-12-08T16:19:36Z","performed_via_github_app":null}]