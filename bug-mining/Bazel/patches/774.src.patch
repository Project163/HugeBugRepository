+
+  private static byte[] readFile(Path path) throws IOException {
+    final byte[] data = new byte[(int) path.getFileSize()];
+
+    try (DataInputStream stream = new DataInputStream(path.getInputStream())) {
+      stream.readFully(data);
+    }
+
+    return data;
+  }
