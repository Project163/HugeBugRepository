tinit.c:0\r\n    frame #4: 0x000000010feff6cf postgres`PostgresMain(argc=1, argv=0x0000000119fc6318, dbname=<unavailable>, username=\"yugabyte\") at postgres.c:4040\r\n    frame #5: 0x000000010fe83e2a postgres`BackendRun(port=0x00000001101ca610) at postmaster.c:4417\r\n    frame #6: 0x000000010fe836a4 postgres`BackendStartup(port=<unavailable>) at postmaster.c:4083\r\n    frame #7: 0x000000010fe82b92 postgres`ServerLoop at postmaster.c:1724\r\n    frame #8: 0x000000010fe80a45 postgres`PostmasterMain(argc=19, argv=0x0000000119e3a0a0) at postmaster.c:1387\r\n    frame #9: 0x000000010fdeb88e postgres`PostgresServerProcessMain(argc=<unavailable>, argv=<unavailable>) at main.c:234\r\n    frame #10: 0x000000010fdebbc2 postgres`main + 34\r\n    frame #11: 0x00007fff7eb3f3d5 libdyld.dylib`start + 1\r\n    frame #12: 0x00007fff7eb3f3d5 libdyld.dylib`start + 1\r\n```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/536999547/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"frozenspider","id":2077017,"node_id":"MDQ6VXNlcjIwNzcwMTc=","avatar_url":"https://avatars.githubusercontent.com/u/2077017?v=4","gravatar_id":"","url":"https://api.github.com/users/frozenspider","html_url":"https://github.com/frozenspider","followers_url":"https://api.github.com/users/frozenspider/followers","following_url":"https://api.github.com/users/frozenspider/following{/other_user}","gists_url":"https://api.github.com/users/frozenspider/gists{/gist_id}","starred_url":"https://api.github.com/users/frozenspider/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/frozenspider/subscriptions","organizations_url":"https://api.github.com/users/frozenspider/orgs","repos_url":"https://api.github.com/users/frozenspider/repos","events_url":"https://api.github.com/users/frozenspider/events{/priv