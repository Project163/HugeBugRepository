+#define BM_DiagDev(N, T, TFTYPE, DEVICE)                           \
+  static void BM_Diag##_##N##_##TFTYPE##_##DEVICE(int iters) {   \
+    testing::UseRealTime();                                     \
+    testing::ItemsProcessed(static_cast<int64>(iters) * N * N); \
+    test::Benchmark(#DEVICE, Diag<T>(N, TFTYPE)).Run(iters);    \
