abarbo/orgs","repos_url":"https://api.github.com/users/rugabarbo/repos","events_url":"https://api.github.com/users/rugabarbo/events{/privacy}","received_events_url":"https://api.github.com/users/rugabarbo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-03-26T09:09:40Z","updated_at":"2018-03-26T09:09:40Z","body":"And I want to ask why we use the `NO_ZERO_IN_DATE` mode in the travis config?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/yiisoft/yii2/issues/comments/376098202/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"rugabarbo","id":6429469,"node_id":"MDQ6VXNlcjY0Mjk0Njk=","avatar_url":"https://avatars.githubusercontent.com/u/6429469?v=4","gravatar_id":"","url":"https://api.github.com/users/rugabarbo","html_url":"https://github.com/rugabarbo","followers_url":"https://api.github.com/users/rugabarbo/followers","following_url":"https://api.github.com/users/rugabarbo/following{/other_user}","gists_url":"https://api.github.com/users/rugabarbo/gists{/gist_id}","starred_url":"https://api.github.com/users/rugabarbo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rugabarbo/subscriptions","organizations_url":"https://api.github.com/users/rugabarbo/orgs","repos_url":"https://api.github.com/users/rugabarbo/repos","events_url":"https://api.github.com/users/rugabarbo/events{/privacy}","received_events_url":"https://api.github.com/users/rugabarbo/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/yiisoft/yii2/issues/comments/376109295","html_url":"https://github.com/yiisoft/yii2/issues/14834#issuecomment-376109295","issue_url":"https://api.github.com/repos/yiisoft/yii2/issues/14834","id":376109295,"node_id":"MDEyOklzc3VlQ29tbWVudDM3NjEwOTI5NQ==","user":{"login":"samdark","id":47294,"n