[{"id":3072303199,"node_id":"MDE3OlJlbmFtZWRUaXRsZUV2ZW50MzA3MjMwMzE5OQ==","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/3072303199","actor":{"login":"EricBorczuk","id":4205492,"node_id":"MDQ6VXNlcjQyMDU0OTI=","avatar_url":"https://avatars.githubusercontent.com/u/4205492?v=4","gravatar_id":"","url":"https://api.github.com/users/EricBorczuk","html_url":"https://github.com/EricBorczuk","followers_url":"https://api.github.com/users/EricBorczuk/followers","following_url":"https://api.github.com/users/EricBorczuk/following{/other_user}","gists_url":"https://api.github.com/users/EricBorczuk/gists{/gist_id}","starred_url":"https://api.github.com/users/EricBorczuk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/EricBorczuk/subscriptions","organizations_url":"https://api.github.com/users/EricBorczuk/orgs","repos_url":"https://api.github.com/users/EricBorczuk/repos","events_url":"https://api.github.com/users/EricBorczuk/events{/privacy}","received_events_url":"https://api.github.com/users/EricBorczuk/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2020-02-26T06:28:19Z","rename":{"from":"Attempting to set a second `OnConflictClause` on an `Insert` object should fail","to":"Attempting to set a second `OnConflictClause` on an `Insert` object should fail (Postgres dialect only)"},"performed_via_github_app":null},{"id":3074754581,"node_id":"MDEyOkxhYmVsZWRFdmVudDMwNzQ3NTQ1ODE=","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/3074754581","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2020-02-26T17:42:13Z","label":{"name":"use case","color":"b54650"},"performed_via_github_app":null},{"id":3074754789,"node_id":"MDE1Ok1pbGVzdG9uZWRFdmVudDMwNzQ3NTQ3ODk=","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/3074754789","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"milestoned","commit_id":null,"commit_url":null,"created_at":"2020-02-26T17:42:18Z","milestone":{"title":"1.4"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/591563594","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/5169#issuecomment-591563594","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5169","id":591563594,"node_id":"MDEyOklzc3VlQ29tbWVudDU5MTU2MzU5NA==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-02-26T18:07:55Z","updated_at":"2020-02-26T18:07:55Z","body":"hi there -\r\n\r\nSo I agree that setting on_conflict() multiple times should not silently overwrite the previous value.  \r\n\r\nHowever, I disagree that this change is only for PostgreSQL / DML and instead the issue is that the Insert.values() construct has ad-hoc logic that is not part of a more consistent pattern such that the many methods for which an implicit state change like this can be surprising are not able to participate in the same behavior.\r\n\r\nFor Insert.values() specifically, the state change involves the addition of state that is in conflict with other state already present.     In the case of the on conflict clause, the issue is simpler in that the method is replacing state that is already present.  I can immediately think of half a dozen other places where the same issue exists, including MySQL's \"on duplicate key update\", the distinct() method on select() and Query when an \"ON\" condition is present,  the limit() / offset() methods on select() / Query, to some extent the select().with_only_columns() method, maybe others.\r\n\r\nin ORM Query, there is another ad-hoc decorator pattern in use to try to apply some checks to things, like \"@_no_statement_condition\" meaning a certain method should not be allowed if the query already has .statement.   i think at the moment it might be feasible to create such a decorator in Core that applies to the \"single attribute being replaced\" issue, so that all methods that have this kind of behavior can just be marked and a pre-configured exception or warning can come out.   that way future occurrences of this issue don't require a new conditional, new exception text, new test, they just require a decorator be present and then can likely be tested through a common fixture.\r\n\r\nThe Query pattern is probably the simplest approach here, here's what this would look like for MySQL (looks exactly the same for PG):\r\n\r\n```\r\ndiff --git a/lib/sqlalchemy/dialects/mysql/dml.py b/lib/sqlalchemy/dialects/mysql/dml.py\r\nindex 531b31bc3..a812438fe 100644\r\n--- a/lib/sqlalchemy/dialects/mysql/dml.py\r\n+++ b/lib/sqlalchemy/dialects/mysql/dml.py\r\n@@ -1,6 +1,8 @@\r\n from ... import exc\r\n from ... import util\r\n+from ...sql.base import _assertions\r\n from ...sql.base import _generative\r\n+from ...sql.base import check_attribute\r\n from ...sql.dml import Insert as StandardInsert\r\n from ...sql.elements import ClauseElement\r\n from ...sql.expression import alias\r\n@@ -46,6 +48,7 @@ class Insert(StandardInsert):\r\n         return alias(self.table, name=\"inserted\")\r\n \r\n     @_generative\r\n+    @_assertions(check_attribute(\"_post_values_clause\"))\r\n     def on_duplicate_key_update(self, *args, **kw):\r\n         r\"\"\"\r\n         Specifies the ON DUPLICATE KEY UPDATE clause.\r\ndiff --git a/lib/sqlalchemy/sql/base.py b/lib/sqlalchemy/sql/base.py\r\nindex a7324c45f..8aed75f30 100644\r\n--- a/lib/sqlalchemy/sql/base.py\r\n+++ b/lib/sqlalchemy/sql/base.py\r\n@@ -84,6 +84,28 @@ def _generative(fn):\r\n     return decorated\r\n \r\n \r\n+def _assertions(*assertions):\r\n+    @util.decorator\r\n+    def generate(fn, *args, **kw):\r\n+        self = args[0]\r\n+        for assertion in assertions:\r\n+            assertion(self, fn.__name__)\r\n+        fn(self, *args[1:], **kw)\r\n+\r\n+    return generate\r\n+\r\n+\r\n+def check_attribute(attribute):\r\n+    def check(self, decorated_fn):\r\n+        if attribute in self.__dict__:\r\n+            raise exc.InvalidRequestError(\r\n+                \"Method %s has already been called on this %r\"\r\n+                % (decorated_fn, self)\r\n+            )\r\n+\r\n+    return check\r\n+\r\n+\r\n def _clone(element, **kw):\r\n     return element._clone()\r\n \r\ndiff --git a/test/dialect/mysql/test_compiler.py b/test/dialect/mysql/test_compiler.py\r\nindex d59c0549f..cae0ab794 100644\r\n--- a/test/dialect/mysql/test_compiler.py\r\n+++ b/test/dialect/mysql/test_compiler.py\r\n@@ -928,3 +928,17 @@ class InsertOnDuplicateTest(fixtures.TestBase, AssertsCompiledSQL):\r\n             \"ON DUPLICATE KEY UPDATE bar = %s\"\r\n         )\r\n         self.assert_compile(stmt, expected_sql)\r\n+\r\n+    def test_no_repeat(self):\r\n+        stmt = insert(self.table).values(\r\n+            [{\"id\": 1, \"bar\": \"ab\"}, {\"id\": 2, \"bar\": \"b\"}]\r\n+        )\r\n+        stmt = stmt.on_duplicate_key_update(bar=\"foobar\")\r\n+\r\n+        assert_raises_message(\r\n+            exc.InvalidRequestError,\r\n+            \"Method on_duplicate_key_update has already been called \"\r\n+            \"on this .*Insert \",\r\n+            stmt.on_duplicate_key_update,\r\n+            bar=\"hoho\",\r\n+        )\r\n\r\n```\r\n\r\nso this needs a lot of polish, like, I've copied the ORM's _assertions() decorator without moving it out of ORM, the error message is a little clumsy, and I didn't come up with pre-made test fixture.  but I think we should be checking for methods that silently replace the old value in the general case.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/591563594/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":3074839123,"node_id":"MDEyOkxhYmVsZWRFdmVudDMwNzQ4MzkxMjM=","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/3074839123","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2020-02-26T18:08:10Z","label":{"name":"sql","color":"5060F0"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/591564661","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/5169#issuecomment-591564661","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5169","id":591564661,"node_id":"MDEyOklzc3VlQ29tbWVudDU5MTU2NDY2MQ==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-02-26T18:10:26Z","updated_at":"2020-02-26T18:10:26Z","body":"also, we need to think about which methods for which silently replacing the old value is intuitive, vs. which is not.  limit() and offset(), I would argue are intuitive in that they replace the old value.   the two \"on conflict  / duplicate\" constructs we're talking about here, i agree they are not.   I think disitnct(ON=) is also a non-intuitive replacement.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/591564661/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/591645119","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/5169#issuecomment-591645119","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5169","id":591645119,"node_id":"MDEyOklzc3VlQ29tbWVudDU5MTY0NTExOQ==","user":{"login":"EricBorczuk","id":4205492,"node_id":"MDQ6VXNlcjQyMDU0OTI=","avatar_url":"https://avatars.githubusercontent.com/u/4205492?v=4","gravatar_id":"","url":"https://api.github.com/users/EricBorczuk","html_url":"https://github.com/EricBorczuk","followers_url":"https://api.github.com/users/EricBorczuk/followers","following_url":"https://api.github.com/users/EricBorczuk/following{/other_user}","gists_url":"https://api.github.com/users/EricBorczuk/gists{/gist_id}","starred_url":"https://api.github.com/users/EricBorczuk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/EricBorczuk/subscriptions","organizations_url":"https://api.github.com/users/EricBorczuk/orgs","repos_url":"https://api.github.com/users/EricBorczuk/repos","events_url":"https://api.github.com/users/EricBorczuk/events{/privacy}","received_events_url":"https://api.github.com/users/EricBorczuk/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-02-26T21:09:34Z","updated_at":"2020-02-26T21:09:34Z","body":"I totally didn't think about the more general case - thanks for weighing in on that.  Abstracting a decorator that restricts replacement makes perfect sense to me, from a perspective of testability and consistency, too.\r\n\r\nI also agree that by virtue of having a builder-like API, the method(s) that we feel should throw an error are the exception to the general rule, which is that all these builder methods should allow being called multiple times (i.e. query.limit(1).limit(5) should become LIMIT 5)\r\n\r\nWhile it's not necessarily an exhaustive list, I think that your proposal of not allowing replacement for \"on conflict / duplicate\" and \"distinct on\" is a totally reasonable starting point, and with that reusable decorator it would probably be simple to just add the decorator to other builder methods in the future should it make more sense for them to not be overwritten.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/591645119/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"EricBorczuk","id":4205492,"node_id":"MDQ6VXNlcjQyMDU0OTI=","avatar_url":"https://avatars.githubusercontent.com/u/4205492?v=4","gravatar_id":"","url":"https://api.github.com/users/EricBorczuk","html_url":"https://github.com/EricBorczuk","followers_url":"https://api.github.com/users/EricBorczuk/followers","following_url":"https://api.github.com/users/EricBorczuk/following{/other_user}","gists_url":"https://api.github.com/users/EricBorczuk/gists{/gist_id}","starred_url":"https://api.github.com/users/EricBorczuk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/EricBorczuk/subscriptions","organizations_url":"https://api.github.com/users/EricBorczuk/orgs","repos_url":"https://api.github.com/users/EricBorczuk/repos","events_url":"https://api.github.com/users/EricBorczuk/events{/privacy}","received_events_url":"https://api.github.com/users/EricBorczuk/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/591645915","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/5169#issuecomment-591645915","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5169","id":591645915,"node_id":"MDEyOklzc3VlQ29tbWVudDU5MTY0NTkxNQ==","user":{"login":"EricBorczuk","id":4205492,"node_id":"MDQ6VXNlcjQyMDU0OTI=","avatar_url":"https://avatars.githubusercontent.com/u/4205492?v=4","gravatar_id":"","url":"https://api.github.com/users/EricBorczuk","html_url":"https://github.com/EricBorczuk","followers_url":"https://api.github.com/users/EricBorczuk/followers","following_url":"https://api.github.com/users/EricBorczuk/following{/other_user}","gists_url":"https://api.github.com/users/EricBorczuk/gists{/gist_id}","starred_url":"https://api.github.com/users/EricBorczuk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/EricBorczuk/subscriptions","organizations_url":"https://api.github.com/users/EricBorczuk/orgs","repos_url":"https://api.github.com/users/EricBorczuk/repos","events_url":"https://api.github.com/users/EricBorczuk/events{/privacy}","received_events_url":"https://api.github.com/users/EricBorczuk/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-02-26T21:11:25Z","updated_at":"2020-02-26T21:28:43Z","body":"Oh but also, just perusing the repo a bit, I noticed that the `where()` method actually appends whatever WHERE clause was already built to the args you send (so query.where(X).where(Y) would be X and Y, rather than replacing X with Y).  So my statement above about `query.limit(1).limit(5) should become LIMIT 5` isn't _always_ generally true, for every builder method.\r\n\r\nSo it seems like there are actually at least 3 kinds of builder methods:\r\n1) Those that append to the previous (like `where`, even `distinct` with an expr, there are a lot of these)\r\n2) Those that replace the previous (like `returning`, `limit`, `offset`)\r\n3) Those that have bespoke cases where they should error (like `values`, as discussed above)\r\n\r\nAnd I had initially thought that `on_conflict_do_update` was of type 1), when in reality it's implemented as type 2), and we agree that it should be type 3)\r\n\r\nI don't think any of this would change your strategy above though, I still think a decorator that restricts overwriting in order to satisfy type 3) is a good choice.\r\n\r\nShould I take a stab at it? I'm glad I brought this up, but I don't want to impose more work for you if I can try to approach it as well. (Would also give me some exposure to the repo should I want to contribute down the line 😄  )  But if it would require a lot of context for me to get into it, I defer to you!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/591645915/reactions","total_count":