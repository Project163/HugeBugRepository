+
+SELECT
+    count(1)
+FROM
+    (SELECT
+         1
+     FROM
+         (SELECT
+              sum(SELLER_ID) as acct_bal_CURR,
+              1 AS DT
+          FROM
+              TEST_KYLIN_FACT) a
+             left JOIN
+         (
+             SELECT
+                 sum(ITEM_COUNT) acct_id_CURR,
+                 1 AS DT
+             FROM
+                 TEST_KYLIN_FACT
+         ) b
+         ON a.DT = b.DT
+    )
