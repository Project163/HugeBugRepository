tps://api.github.com/repos/laravel/framework/labels{/name}","releases_url":"https://api.github.com/repos/laravel/framework/releases{/id}","deployments_url":"https://api.github.com/repos/laravel/framework/deployments","created_at":"2013-01-10T21:27:28Z","updated_at":"2025-12-12T11:43:01Z","pushed_at":"2025-12-12T03:08:29Z","git_url":"git://github.com/laravel/framework.git","ssh_url":"git@github.com:laravel/framework.git","clone_url":"https://github.com/laravel/framework.git","svn_url":"https://github.com/laravel/framework","homepage":"https://laravel.com","size":94640,"stargazers_count":34350,"watchers_count":34350,"language":"PHP","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":11731,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":118,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["framework","laravel","php"],"visibility":"public","forks":11731,"open_issues":118,"watchers":34350,"default_branch":"12.x","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/laravel/framework/pulls/46694","html_url":"https://github.com/laravel/framework/pull/46694","diff_url":"https://github.com/laravel/framework/pull/46694.diff","patch_url":"https://github.com/laravel/framework/pull/46694.patch","merged_at":"2023-04-05T15:12:57Z"},"body":"Make it easier to register console events on specific test without adding a massive memory leak and make it easier to be documented.\r\n\r\nAlso, move `rerouteSymfonyCommandEvents` to only initiate after the application has been booted. Fixes laravel/framework#46693\r\n\r\n<!--\r\nPlease only send a pull request to branches that are currently supported: https://laravel.com/docs/releases#support-policy \r\n\r\nIf you are unsure which branch your pull request should be sent to, please read: https://laravel.com/docs/contributions#which-branch\r\n\r\nPull requests without a descriptive title, thorough description, or tests will be closed.\r\n\r\nIn addition, please describe the benefit to end users; the reasons it does not break any existing features; how it makes building web applications easier, etc.\r\n-->\r\n","reactions":{"url":"https://api.github.com/repos/laravel/framework/issues/46694/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/laravel/framework/issues/46694/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/laravel/framework/issues/comments/1496968682","html_url":"https://github.com/laravel/framework/issues/46693#issuecomment-1496968682","issue_url":"https://api.github.com/repos/laravel/framework/issues/46693","id":1496968682,"node_id":"IC_kwDOAHMwOs5ZOe3q","user":{"login":"cannahan","id":32390300,"node_id":"MDQ6VXNlcjMyMzkwMzAw","avatar_url":"https://avatars.githubusercontent.com/u/32390300?v=4","gravatar_id":"","url":"https://api.github.com/users/cannahan","html_url":"https://github.com/cannahan","followers_url":"https://api.github.com/users/cannahan/followers","following_url":"https://api.github.com/users/cannahan/following{/other_user}","gists_url":"https://api.github.com/users/cannahan/gists{/gist_id}","starred_url":"https://api.github.com/users/cannahan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cannahan/subscriptions","organizations_url":"https://api.github.com/users/cannahan/orgs","repos_url":"https://api.github.com/users/cannahan/repos","events_url":"https://api.github.com/users/cannahan/events{/privacy}","received_events_url":"https://api.github.com/users/cannahan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-04-05T06:10:23Z","updated_at":"2023-04-05T10:30:16Z","body":"@crynobone I dont want the events to be rerouted in the testing env either, but it still happens if the app is not bootstrapped yet. Then $this->app->runningUnitTests() will always return false even if it is running in the testing env, because env is not bound when the constructor of the Kernel-Class is called. \r\n\r\nWhat about my solution by adding \"$this->app->booted()\":\r\n\r\n```\r\n$this->app->booted(function () {\r\n    if (! $this->app->runningUnitTests()) {\r\n        $this->rerouteSymfonyCommandEvents();\r\n    }\r\n});\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/laravel/framework/issues/comments/1496968682/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"cannahan","id":32390300,"node_id":"MDQ6VXNlcjMyMzkwMzAw","avatar_url":"https://avatars.githubusercontent.com/u/32390300?v=4","gravatar_id":"","url":"https://api.github.com/users/cannahan","html_url":"https://github.com/cannahan","followers_url":"https://api.github.com/users/cannahan/followers","following_url":"https://api.github.com/users/cannahan/following{/other_user}","gists_url":"https://api.github.com/users/cannahan/gists{/gist_id}","starred_url":"https://api.github.com/users/cannahan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cannahan/subscriptions","organizations_url":"https://api.github.com/users/cannahan/orgs","repos_url":"https://api.github.com/users/cannahan/repos","events_url":"https://api.github.com/users/cannahan/events{/privacy}","received_events_url":"https://api.github.com/users/cannahan/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":8931334121,"node_id":"MEE_lADOAHMwOs5ioFI6zwAAAAIUWVfp","url":"https://api.github.com/repos/laravel/framework/issues/events/893