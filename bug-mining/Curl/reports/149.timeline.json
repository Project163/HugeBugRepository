rl.so is \"zlib-1.2.8.tar,openssl-0.9.8.tar.gz ,libssh2-1.8.0.tar,curl-7.61.0. Tar\".Thank you for your help.\r\nSFTP server I use is freeftpd, Serv-U, Serv-U can be created, freeftpd can not be created, freeftpd software version is '1.0.13 '. The source code of the file can not be created is as follows:\r\n\r\n~~~c\r\n long CFtp::SftpUploadForCounters(char *psLocalFile,\t  char *psRemoteFile)//in use\r\n  {\r\n  CURLcode res;\r\n  FILE *hd_src;\r\n  struct stat file_info;\r\n  curl_off_t fsize;\r\n  curl_easy_reset(curl);\r\n  if(!psLocalFile )\r\n  {\r\n\treturn R_FAIL;\r\n  } \r\n  if(stat(psLocalFile, &file_info)) {\r\n\tprintf(\"Couldnt open '%s': %s\\n\", psLocalFile, strerror(errno));\r\n\treturn R_FAIL;\r\n  }\r\n  fsize = (curl_off_t)file_info.st_size;\r\n  printf(\"Local file size: %\" CURL_FORMAT_CURL_OFF_T \" bytes.\\n\", fsize);\r\n  hd_src = fopen(psLocalFile, \"rb\");\r\n  \r\n  if(curl) {\r\n\r\n\tcurl_easy_setopt(curl, CURLOPT_TIMEOUT, 30L);\t\r\n\r\n\tcurl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);\r\n\r\n\tcurl_easy_setopt(curl, CURLOPT_READFUNCTION, read_callback); \r\n\r\n\tcurl_easy_setopt(curl, CURLOPT_UPLOAD, 1L);\r\n\t\r\n\tcurl_easy_setopt(curl, CURLOPT_FTP_CREATE_MISSING_DIRS, 1); \r\n\r\n\tchar sUserPass[256];\r\n\tmemset(sUserPass,0,sizeof(sUserPass));\r\n\tsnprintf(sUserPass, 256, \"%s:%s\", m_pstrUser, m_pstrPassword);\r\n\tcurl_easy_setopt(curl, CURLOPT_USERPWD, sUserPass);\r\n\r\n\tchar sRemoteFile[255];\r\n\tif( !m_pstrDir )\r\n\t\tsnprintf(sRemoteFile, 255, \"%s/%s\", m_pstrHost, psRemoteFile);\r\n\telse\r\n\t\tsnprintf(sRemoteFile, 255, \"%s/%s/%s\", m_pstrHost, m_pstrDir, psRemoteFile);\r\n\r\n\tstrcat(sRemoteFile,\".tmp\");\r\n\r\n\t\r\n\tif (m_nMode == 0) // PORT mode\r\n\t{\r\n\t\tcurl_easy_setopt(curl, CURLOPT_FTPPORT, \"-\");\r\n\t}\t\r\n\tcurl_easy_setopt(curl,CURLOPT_URL, sRemoteFile);\r\n\tcurl_easy_setopt(curl, CURLOPT_PORT, m_nPort);\r\n\tcurl_easy_setopt(curl, CURLOPT_FTP_USE_EPSV, TRUE);\r\n\tcurl_easy_setopt(curl, CURLOPT_SSL_VERIFYPEER, 0);\r\n\tcurl_easy_setopt(curl, CURLOPT_SSL_VERIFYHOST, 0);\r\n\tcurl_easy_setopt(curl, CURLOPT_READDATA, hd_src);\r\n\tcurl_easy_setopt(curl, CURLOPT_INFILESIZE_LARGE,(curl_off_t)fsize);\r\n\tres = curl_easy_perform(curl);\r\n\tfclose(hd_src); \r\n\t}\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/curl/curl/issues/comments/613343161/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zhanghlstudy","id":63382027,"node_id":"MDQ6VXNlcjYzMzgyMDI3","avatar_url":"https://avatars.githubusercontent.com/u/63382027?v=4","gravatar_id":"","url":"https://api.github.com/users/zhanghlstudy","html_url":"https://github.com/zhanghlstudy","followers_url":"https://api.github.com/users/zhanghlstudy/followers","following_url":"https://api.github.com/users/zhanghlstudy/following{/other_user}","gists_url":"https://api.github.com/users/zhanghlstudy/gists{/gist_id}","starred_url":"https://api.github.com/users/zhanghlstudy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zhanghlstudy/subscriptions","organizations_url":"https://api.github.com/users/zhanghlstudy/orgs","repos_url":"https://api.github.com/users/zhanghlstudy/repos","events_url":"https://api.github.com/users/zhanghlstudy/events{/privacy}","received_events_url":"https://api.github.com/users/zhanghlstudy/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":3626577434,"node_id":"MDE0OlVubGFiZWxlZEV2ZW50MzYyNjU3NzQzNA==","url":"https://api.github.com/repos/curl/curl/issues/events/3626577434","actor":{"login":"bagder","id":177011,"node_id":"MDQ6VXNlcjE3NzAxMQ==","avatar_url":"https://avatars.githubusercontent.com/u/177011?v=4","gravatar_id":"","url":"https://api.github.com/users/bagder","html_url":"https://github.com/bagder","followers_url":"https://api.github.com/users/bagder/followers","following_url":"