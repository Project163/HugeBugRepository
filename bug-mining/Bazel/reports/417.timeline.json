/avatars.githubusercontent.com/u/7756476?v=4","gravatar_id":"","url":"https://api.github.com/users/aj-michael","html_url":"https://github.com/aj-michael","followers_url":"https://api.github.com/users/aj-michael/followers","following_url":"https://api.github.com/users/aj-michael/following{/other_user}","gists_url":"https://api.github.com/users/aj-michael/gists{/gist_id}","starred_url":"https://api.github.com/users/aj-michael/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aj-michael/subscriptions","organizations_url":"https://api.github.com/users/aj-michael/orgs","repos_url":"https://api.github.com/users/aj-michael/repos","events_url":"https://api.github.com/users/aj-michael/events{/privacy}","received_events_url":"https://api.github.com/users/aj-michael/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/314129067","html_url":"https://github.com/bazelbuild/bazel/issues/3326#issuecomment-314129067","issue_url":"https://api.github.com/repos/bazelbuild/bazel/issues/3326","id":314129067,"node_id":"MDEyOklzc3VlQ29tbWVudDMxNDEyOTA2Nw==","user":{"login":"laszlocsomor","id":10532244,"node_id":"MDQ6VXNlcjEwNTMyMjQ0","avatar_url":"https://avatars.githubusercontent.com/u/10532244?v=4","gravatar_id":"","url":"https://api.github.com/users/laszlocsomor","html_url":"https://github.com/laszlocsomor","followers_url":"https://api.github.com/users/laszlocsomor/followers","following_url":"https://api.github.com/users/laszlocsomor/following{/other_user}","gists_url":"https://api.github.com/users/laszlocsomor/gists{/gist_id}","starred_url":"https://api.github.com/users/laszlocsomor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/laszlocsomor/subscriptions","organizations_url":"https://api.github.com/users/laszlocsomor/orgs","repos_url":"https://api.github.com/users/laszlocsomor/repos","events_url":"https://api.github.com/users/laszlocsomor/events{/privacy}","received_events_url":"https://api.github.com/users/laszlocsomor/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-07-10T14:48:21Z","updated_at":"2017-07-10T14:48:21Z","body":"> Have we verified that 93dc21f fixed the issue?\r\n\r\nYes, it's passing on CI post-push.\r\n\r\n> the first result is a directory, not the executable.\r\n\r\nThat's because the \"find\" that prints the debug info uses different flags than the \"find\" that actually tries to find zipper. Namely the debugging one was just looking for anything called \"zipper\" (so it matched the \"zipper\" binary and its parent directory too, also called \"zipper\"), while the actual ones match the path \"*/tools/android/zipper/zipper\", so it couldn't possibly match the parent directory. (The four matches were the two parent directories and two files.)\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/314129067/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"laszlocsomor","id":10532244,"node_id":"MDQ6VXNlcjEwNTMyMjQ0","avatar_url":"https://avatars.githubusercontent.com/u/10532244?v=4","gravatar_id":"","url":"https://api.github.com/users/laszlocsomor","html_url":"https://github.com/laszlocsomor","followers_url":"https://api.github.com/users/laszlocsomor/followers","following_url":"https://api.github.com/users/laszlocsomor/following{/other_user}","gists_url":"https://api.github.com/users/laszlocsomor/gists{/gist_id}","starred_url":"https://api.github.com/users/laszlocsomor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/laszlocsomor/subscriptions","organizations_url":"https://api.github.com/users/laszlocsomor/orgs","repos_url":"https://api.github.com/users/laszlocsomor/repos","events_url":"https://api.github.com/users/laszlocsomor/events{/privacy}","received_events_url":"https://api.github.com/users/laszlocsomor/received_events","type":"User","user_view_type":"public","site_admin":false}}]