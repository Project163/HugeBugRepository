<item>
            <title>[IGNITE-12503] Fix SSL configuration in Jetty REST: httpCfg assignment</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-12503</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
                            &amp;lt;New class=&lt;span class=&quot;code-quote&quot;&gt;&quot;org.eclipse.jetty.server.HttpConnectionFactory&quot;&lt;/span&gt;&amp;gt;
                                &amp;lt;Ref refid=&lt;span class=&quot;code-quote&quot;&gt;&quot;httpCfg&quot;&lt;/span&gt;/&amp;gt;
                            &amp;lt;/New&amp;gt;
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;should become&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
                            &amp;lt;New class=&lt;span class=&quot;code-quote&quot;&gt;&quot;org.eclipse.jetty.server.HttpConnectionFactory&quot;&lt;/span&gt;&amp;gt;
                                &amp;lt;Arg&amp;gt;&amp;lt;Ref refid=&lt;span class=&quot;code-quote&quot;&gt;&quot;httpCfg&quot;&lt;/span&gt;/&amp;gt;&amp;lt;/Arg&amp;gt;
                            &amp;lt;/New&amp;gt;
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;Or this assignment is not being made.&lt;/p&gt;</description>
