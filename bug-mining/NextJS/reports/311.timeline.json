[{"id":4919442114,"node_id":"MDEyOkxhYmVsZWRFdmVudDQ5MTk0NDIxMTQ=","url":"https://api.github.com/repos/vercel/next.js/issues/events/4919442114","actor":{"login":"cefn","id":159819,"node_id":"MDQ6VXNlcjE1OTgxOQ==","avatar_url":"https://avatars.githubusercontent.com/u/159819?v=4","gravatar_id":"","url":"https://api.github.com/users/cefn","html_url":"https://github.com/cefn","followers_url":"https://api.github.com/users/cefn/followers","following_url":"https://api.github.com/users/cefn/following{/other_user}","gists_url":"https://api.github.com/users/cefn/gists{/gist_id}","starred_url":"https://api.github.com/users/cefn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cefn/subscriptions","organizations_url":"https://api.github.com/users/cefn/orgs","repos_url":"https://api.github.com/users/cefn/repos","events_url":"https://api.github.com/users/cefn/events{/privacy}","received_events_url":"https://api.github.com/users/cefn/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2021-06-21T22:42:04Z","label":{"name":"template: bug","color":"fddf99"},"performed_via_github_app":null},{"id":4919442951,"node_id":"MDE3OlJlbmFtZWRUaXRsZUV2ZW50NDkxOTQ0Mjk1MQ==","url":"https://api.github.com/repos/vercel/next.js/issues/events/4919442951","actor":{"login":"cefn","id":159819,"node_id":"MDQ6VXNlcjE1OTgxOQ==","avatar_url":"https://avatars.githubusercontent.com/u/159819?v=4","gravatar_id":"","url":"https://api.github.com/users/cefn","html_url":"https://github.com/cefn","followers_url":"https://api.github.com/users/cefn/followers","following_url":"https://api.github.com/users/cefn/following{/other_user}","gists_url":"https://api.github.com/users/cefn/gists{/gist_id}","starred_url":"https://api.github.com/users/cefn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cefn/subscriptions","organizations_url":"https://api.github.com/users/cefn/orgs","repos_url":"https://api.github.com/users/cefn/repos","events_url":"https://api.github.com/users/cefn/events{/privacy}","received_events_url":"https://api.github.com/users/cefn/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2021-06-21T22:42:23Z","rename":{"from":"Sourcemapping fails unpredictably","to":"Sourcemapping fails unpredictably in Typescript Monorepo"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/865649483","html_url":"https://github.com/vercel/next.js/issues/26457#issuecomment-865649483","issue_url":"https://api.github.com/repos/vercel/next.js/issues/26457","id":865649483,"node_id":"MDEyOklzc3VlQ29tbWVudDg2NTY0OTQ4Mw==","user":{"login":"cefn","id":159819,"node_id":"MDQ6VXNlcjE1OTgxOQ==","avatar_url":"https://avatars.githubusercontent.com/u/159819?v=4","gravatar_id":"","url":"https://api.github.com/users/cefn","html_url":"https://github.com/cefn","followers_url":"https://api.github.com/users/cefn/followers","following_url":"https://api.github.com/users/cefn/following{/other_user}","gists_url":"https://api.github.com/users/cefn/gists{/gist_id}","starred_url":"https://api.github.com/users/cefn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cefn/subscriptions","organizations_url":"https://api.github.com/users/cefn/orgs","repos_url":"https://api.github.com/users/cefn/repos","events_url":"https://api.github.com/users/cefn/events{/privacy}","received_events_url":"https://api.github.com/users/cefn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-06-22T06:56:10Z","updated_at":"2021-06-22T06:56:10Z","body":"For reference I created a standalone app separate from the monorepo at https://github.com/cefn/nextjs-snake-debug \r\n\r\nIt has newer code based on async instead of generators. I am trying to debug this code as the snake doesn't move when you press keys as expected. There are no compiler errors and no console errors, meaning I have to try and step through the code to find the issue.\r\n\r\nThis isolated nextjs app can be run by checking it out, running `yarn` then `yarn run dev` and visiting `http://localhost:3000`\r\n\r\nIt seems to have all the source files bound and can accept some breakpoints in the Chrome inspector, but many attempted breakpoints are moved to the top of an async function declaration when you insert them, and source stepping usually doesn't function for more than one or two lines at a time.\r\n\r\nFor example I would like to step through the code from https://github.com/cefn/nextjs-snake-debug/blob/00229d5eb833f72e6838fd39996d816948323aff/src/game.ts#L46 but it is impossible to put a breakpoint there.\r\n\r\nOther lines DO accept breakpoints but stepping one or two lines causes the stack 'pointer' to go to the top of an async method and stay there for tens of ticks, followed by leaping into transpiled code and (presumably) webpack libraries.\r\n\r\nThese behaviours make debugging of the async issue in the application impossible.\r\n\r\nIn this standalone example app I targeted ES2020 to minimise the amount of transpilation needed from Typescript, but ES5 and ES2015 also have the same problems.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/865649483/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"cefn","id":159819,"node_id":"MDQ6VXNlcjE1OTgxOQ==","avatar_url":"https://avatars.githubusercontent.com/u/159819?v=4","gravatar_id":"","url":"https://api.github.com/users/cefn","html_url":"https://github.com/cefn","followers_url":"https://api.github.com/users/cefn/followers","following_url":"https://api.github.com/users/cefn/following{/other_user}","gists_url":"https://api.github.com/users/cefn/gists{/gist_id