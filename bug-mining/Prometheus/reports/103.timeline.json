ding the same exemplar again and\r\nagain, leading to an endless loop.\r\n\r\nWith this fix, the state is now tracked and the single exemplar is\r\nonly returned once.","reactions":{"url":"https://api.github.com/repos/prometheus/prometheus/issues/12737/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/prometheus/prometheus/issues/12737/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":10167237305,"node_id":"CE_lADOAGhaic5u0G2ZzwAAAAJeA7q5","url":"https://api.github.com/repos/prometheus/prometheus/issues/events/10167237305","actor":{"login":"bboreham","id":8125524,"node_id":"MDQ6VXNlcjgxMjU1MjQ=","avatar_url":"https://avatars.githubusercontent.com/u/8125524?v=4","gravatar_id":"","url":"https://api.github.com/users/bboreham","html_url":"https://github.com/bboreham","followers_url":"https://api.github.com/users/bboreham/followers","following_url":"https://api.github.com/users/bboreham/following{/other_user}","gists_url":"https://api.github.com/users/bboreham/gists{/gist_id}","starred_url":"https://api.github.com/users/bboreham/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bboreham/subscriptions","organizations_url":"https://api.github.com/users/bboreham/orgs","repos_url":"https://api.github.com/users/bboreham/repos","events_url":"https://api.github.com/users/bboreham/events{/privacy}","received_events_url":"https://api.github.com/users/bboreham/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2023-08-23T08:36:58Z","state_reason":null,"performed_via_github_app":null},{"id":10181073835,"node_id":"REFE_lADOAGhaic5u0G2ZzwAAAAJe1tur","url":"https://api.github.com/repos/prometheus/prometheus/issues/events/10181073835","actor":{"login":"zeitlinger","id":2832627,"node_id":"MDQ6VXNlcjI4MzI2Mjc=","avatar_url":"ht