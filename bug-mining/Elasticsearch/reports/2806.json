is/orgs","repos_url":"https://api.github.com/users/jakelandis/repos","events_url":"https://api.github.com/users/jakelandis/events{/privacy}","received_events_url":"https://api.github.com/users/jakelandis/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":5,"created_at":"2022-05-20T14:25:49Z","updated_at":"2022-05-26T14:24:28Z","closed_at":"2022-05-26T14:24:28Z","assignee":{"login":"dakrone","id":19060,"node_id":"MDQ6VXNlcjE5MDYw","avatar_url":"https://avatars.githubusercontent.com/u/19060?v=4","gravatar_id":"","url":"https://api.github.com/users/dakrone","html_url":"https://github.com/dakrone","followers_url":"https://api.github.com/users/dakrone/followers","following_url":"https://api.github.com/users/dakrone/following{/other_user}","gists_url":"https://api.github.com/users/dakrone/gists{/gist_id}","starred_url":"https://api.github.com/users/dakrone/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dakrone/subscriptions","organizations_url":"https://api.github.com/users/dakrone/orgs","repos_url":"https://api.github.com/users/dakrone/repos","events_url":"https://api.github.com/users/dakrone/events{/privacy}","received_events_url":"https://api.github.com/users/dakrone/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Elasticsearch Version\n\nlatest\n\n### Installed Plugins\n\n_No response_\n\n### Java Version\n\n18.0.1.1\n\n### OS Version\n\nLinux 5.17.6-1-MANJARO\n\n### Problem Description\n\nWe created a `hasData` service which utilizes the `resolve_index` api to check whether ES data exists. When making a call to `internal/index-pattern-management/resolve_index` to query whether data exists or not, in certain scenarios it fails with a 500 Internal Server Error.\r\n\r\nThe ES error being - \r\n\r\n> security_exception: [security_exception] Reason: action [indices:admin/resolve/index] is unauthorized for user [test_user] with roles [test_dashboard_user,reporting_user], this\r\naction is granted by the index privileges [view_index_metadata,manage,all]\r\n\r\nThe scenarios being:\r\nScenario one:\r\n1. There are 3 indices\r\n2. User has `read` access to 1 of the indices, but not to the other two\r\n3. The call fails with a 500 Internal Server Error. The user should be able to see the index they have access to.\r\n\r\nScenario two:\r\n1. This refers to a scenario where the user has `read` access to the index, but `no view_index_metadata` privileges.\r\n\r\nOriginal issue ticket in Kibana for reference - [#132478](https://github.com/elastic/kibana/issues/132478)\n\n### Steps to Reproduce\n\nThe user has `read` access to the index, but `no view_index_metadata` privileges.\r\nThe api fails with a 500 due to the missing permissions.\n\n### Logs (if relevant)\n\nsecurity_exception: [security_exception] Reason: action [indices:admin/resolve/index] is unauthorized for user [test_user] with roles [test_dashboard_user,reporting_user], this\r\naction is granted by the index privileges [view_index_metadata,manage,all]","closed_by":{"login":"elasticsearchmachine","id":58790826,"node_id":"MDQ6VXNlcjU4NzkwODI2","avatar_url":"https://avatars.githubusercontent.com/u/58790826?v=4","gravatar_id":"","url":"https://api.github.com/users/elasticsearchmachine","html_url":"https://github.com/elasticsearchmachine","followers_url":"https://api.github.com/users/elasticsearchmachine/followers","following_url":"https://api.github.com/users/elasticsearchmachine/following{/other_user}","gists_url":"https://api.github.com/users/elasticsearchmachine/gists{/gist_id}","starred_url":"https://api.github.com/users/elasticsearchmachine/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elasticsearchmachine/subscriptions","organizations_url":"https://api.github.com/users/elasticsearchmachine/orgs","repos_url":"https://api.github.com/users/elasticsearchmachine/repos","events_url":"https://api.github.com/users/elasticsearchmachine/events{/privacy}","received_events_url":"https://api.github.com/users/elasticsearchmachine/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/86977/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/elastic/elasticsearch/issues/86977/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}