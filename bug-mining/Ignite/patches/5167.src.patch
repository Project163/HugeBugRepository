+            tasks.add(new GridTestUtils.IgniteRunnableX() {
+                @Override public void runx() throws Exception {
+                    U.sleep(1);
+
+                    cntr.decrementAndGet();
+                }
+            });
+        }
+
+        // Add a long task to check the metric of active tasks.
