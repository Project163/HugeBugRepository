m-registry","vue"],"visibility":"public","forks":6255,"open_issues":2890,"watchers":52486,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/go-gitea/gitea/pulls/5055","html_url":"https://github.com/go-gitea/gitea/pull/5055","diff_url":"https://github.com/go-gitea/gitea/pull/5055.diff","patch_url":"https://github.com/go-gitea/gitea/pull/5055.patch","merged_at":"2018-12-27T16:51:19Z"},"body":"Resolves #3048\r\n\r\nIf you're using Active Directory and need to bind using the format user@domain.org or DOMAIN\\user LDAP simple auth will fail. The problem is that UserDN setting we bind on is also used for the search base and it's not a qualified DN.\r\n\r\nTo solve this I added the User Search Base field previously only on LDAP via BindDN to the simple auth as well. If you have a setting in this field on simple auth it will use that as the LDAP search base instead of the UserDN.\r\n\r\nIt works but I'm not a huge fan of my code to have User Search Base only required for BindDN but not simple auth. If somebody has suggestions for how to do it cleanly I'm open. The existing classes and js didn't have a good way for a field to be in both but only required in one.","reactions":{"url":"https://api.github.com/repos/go-gitea/gitea/issues/5055/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/go-gitea/gitea/issues/5055/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":1894317148,"node_id":"MDE0OlVubGFiZWxlZEV2ZW50MTg5NDMxNzE0OA==","url":"https://api.github.com/repos/go-gitea/gitea/issues/events/1894317148","actor":{"login":"techknowlogick","id":164197,"node_id":"MDQ6VXNlcjE2NDE5Nw==","avatar_url":"https://avatars.githubusercontent.com/u/164197?v=4","gravatar_id":"","url":"https://api.github.com/users/techknowlogick","html_