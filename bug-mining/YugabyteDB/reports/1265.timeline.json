api.github.com/users/foucher/followers","following_url":"https://api.github.com/users/foucher/following{/other_user}","gists_url":"https://api.github.com/users/foucher/gists{/gist_id}","starred_url":"https://api.github.com/users/foucher/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/foucher/subscriptions","organizations_url":"https://api.github.com/users/foucher/orgs","repos_url":"https://api.github.com/users/foucher/repos","events_url":"https://api.github.com/users/foucher/events{/privacy}","received_events_url":"https://api.github.com/users/foucher/received_events","type":"User","user_view_type":"public","site_admin":false},"performed_via_github_app":null},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/2504942736","html_url":"https://github.com/yugabyte/yugabyte-db/issues/24883#issuecomment-2504942736","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/24883","id":2504942736,"node_id":"IC_kwDOBlCVUc6VTmSQ","user":{"login":"foucher","id":6496319,"node_id":"MDQ6VXNlcjY0OTYzMTk=","avatar_url":"https://avatars.githubusercontent.com/u/6496319?v=4","gravatar_id":"","url":"https://api.github.com/users/foucher","html_url":"https://github.com/foucher","followers_url":"https://api.github.com/users/foucher/followers","following_url":"https://api.github.com/users/foucher/following{/other_user}","gists_url":"https://api.github.com/users/foucher/gists{/gist_id}","starred_url":"https://api.github.com/users/foucher/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/foucher/subscriptions","organizations_url":"https://api.github.com/users/foucher/orgs","repos_url":"https://api.github.com/users/foucher/repos","events_url":"https://api.github.com/users/foucher/events{/privacy}","received_events_url":"https://api.github.com/users/foucher/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-27T22:50:45Z","updated_at":"2024-11-27T22:51:48Z","body":"After fixing one or more basic bugs here, I'm running into a permission issue I believe is caused by upstream PG commit a117cebd638dd02e5c2e791c25e43745f233111b, combined with us not properly setting the tablegroup's ACL. The following is during mixed mode, after the catalog upgrade is complete:\r\n```\r\n[PG11]\r\nyugabyte=# SELECT tg.oid, tg.grpname AS tg_owner, r.rolname, tg.grpacl FROM pg_yb_tablegroup tg, pg_roles r WHERE tg.grpowner = r.oid;\r\n  oid  |  tg_owner  | rolname  |                 grpacl\r\n-------+------------+----------+-----------------------------------------\r\n 16384 | test_grant | yugabyte | {yugabyte=C/yugabyte,user_3=C/yugabyte}\r\n(1 row)\r\n\r\n[PG15]\r\nyugabyte=# SELECT tg.oid, tg.grpname AS tg_owner, r.rolname, tg.grpacl FROM pg_yb_tablegroup tg, pg_roles r WHERE tg.grpowner = r.oid;\r\n  oid  |  tg_owner  | rolname  | grpacl\r\n-------+------------+----------+--------\r\n 16384 | test_grant | yugabyte |\r\n(1 row)\r\n```\r\n\r\nI think the right thing to do here is just to correctly populate the tablegroup's ACL during the upgrade.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/2504942736/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"foucher","id":6496319,"node_id":"MDQ6VXNlcjY0OTYzMTk=","avatar_url":"https://avatars.githubusercontent.com/u/6496319?v=4","gravatar_id":"","url":"https://api.github.com/users/foucher","html_url":"https://github.com/foucher","followers_url":"https://api.github.com/users/foucher/followers","following_url":"https://api.github.com/users/foucher/following{/other_user}","gists_url":"https://api.github.com/users/foucher/gists{/gist_id}","starred_url":"https://api.github.com/users/foucher/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/foucher/subscriptions","organizations_url":"http