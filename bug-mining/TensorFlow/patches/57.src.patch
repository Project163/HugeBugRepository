+  def _raise_if_feeds_intersects(self, feeds1, feeds2, message):
+    intersection = set(feeds1.keys()) & set(feeds2.keys())
+    if intersection:
+      raise RuntimeError(message + ' Conflict(s): ' + str(list(intersection)))
