-    int n = this.weight.size();
-    if (n == 1) {
-      weight.add(w);
-      values.add(value);
-      items.put(value, 1);
-    } else {
-      // parent comes down
-      weight.add(weight.get(n / 2));
-      values.add(values.get(n / 2));
-      items.put(values.get(n / 2), n);
-      n++;
-
-      // new item goes in
-      items.put(value, n);
-      this.weight.add(w);
-      values.add(value);
-
-      // parents get incremented all the way to the root
-      while (n > 1) {
-        n /= 2;
-        this.weight.set(n, this.weight.get(n) + w);
-      }
-    }
-  }
