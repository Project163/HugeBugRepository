  Column(\"id\", Integer, primary_key=True),\r\n    Column(\"bar\", JSONB),\r\n)\r\n\r\nmetadata.create_all(engine)\r\n\r\nconn = engine.connect()\r\nwith conn.begin() as tran:\r\n    i_query = Foo.insert().values(\r\n        [\r\n            {\"id\": 1, \"bar\": [{\"buz\": 1}]}, \r\n            {\"id\": 2,\"bar\": None},\r\n        ]\r\n    )\r\n    conn.execute(i_query)\r\n    s_query = select([func.array_agg(Foo.c.bar).label(\"agg_val\")])\r\n    result=conn.execute(s_query).fetchall()\r\nprint(result[0].agg_val)\r\n```\r\nerror is \r\n```\r\nTraceback (most recent call last):\r\n  File \"test.py\", line 21, in <module>\r\n    print(result[0].agg_val)\r\n  File \"/site-packages/sqlalchemy/dialects/postgresql/array.py\", line 359, in process\r\n    return self._proc_array(\r\n  File \"/site-packages/sqlalchemy/dialects/postgresql/array.py\", line 306, in _proc_array\r\n    return collection(\r\n  File \"/site-packages/sqlalchemy/dialects/postgresql/array.py\", line 307, in <genexpr>\r\n    self._proc_array(\r\n  File \"/site-packages/sqlalchemy/dialects/postgresql/array.py\", line 289, in _proc_array\r\n    arr = list(arr)\r\nTypeError: 'NoneType' object is not iterable\r\n```\r\n\r\nI think think what's failing it the heuristic to guess the dimensions of the array. Maybe we could specify the dimension here:\r\nhttps://github.com/sqlalchemy/sqlalchemy/blob/7023c07aa6d31b3527cb1171410dcb6e8dff3ec3/lib/sqlalchemy/sql/functions.py#L1331-L1348\r\n\r\nIf you pass the array dimension in the array_agg function does it work? `func.array_agg(Foo.c.bar, tyoe_=Array(Jsonb, dimensions=1))`\r\n\r\nthoughts @zzzeek\r\n\r\n_Originally posted by @CaselIT in https://github.com/sqlalchemy/sqlalchemy/discussions/7080#discussioncomment-1376226_","closed_by":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://