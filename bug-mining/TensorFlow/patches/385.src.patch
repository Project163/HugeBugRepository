+bool IsFloatTensor(const SubGraphT* subgraph, int32_t tensor_idx) {
+  TensorT* tensor = subgraph->tensors[tensor_idx].get();
+  if (tensor->type != TensorType_FLOAT32) {
+    // Skip non-real-valued tensor.
+    return false;
+  }
+  return true;
+}
