[{"id":774088221,"node_id":"MDEyOkxhYmVsZWRFdmVudDc3NDA4ODIyMQ==","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/774088221","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2016-08-31T18:39:28Z","label":{"name":"question","color":"cc317c"},"performed_via_github_app":null},{"id":774088222,"node_id":"MDEyOkxhYmVsZWRFdmVudDc3NDA4ODIyMg==","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/774088222","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2016-08-31T18:39:28Z","label":{"name":"wontfix","color":"d4c5f9"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/243859809","html_url":"https://github.com/google/ExoPlayer/issues/1789#issuecomment-243859809","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/1789","id":243859809,"node_id":"MDEyOklzc3VlQ29tbWVudDI0Mzg1OTgwOQ==","user":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-08-31T18:39:29Z","updated_at":"2016-08-31T18:39:29Z","body":"The HLS specification is very clear that you must include EXT-X-DISCONTINUITY-SEQUENCE in this case. Specifically:\n\n> If the server wishes to remove segments from a Media Playlist containing an EXT-X-DISCONTINUITY tag, the Media Playlist MUST contain an EXT-X-DISCONTINUITY-SEQUENCE tag.\n\nAnd:\n\n> If the server removes an EXT-X-DISCONTINUITY tag from the Media Playlist, it MUST increment the value of the EXT-X-DISCONTINUITY-SEQUENCE tag so that the Discontinuity Sequence Numbers of the segments still in the Media Playlist remain unchanged.\n\nAnd:\n\n> Clients can malfunction if each Media Segment does not have a consistent Discontinuity Sequence Number.\n\nThe fact that EXT-X-DISCONTINUITY-SEQUENCE is pitched in the HLS spec as being useful to the client where there are multiple variants/renditions doesn't mean you can ignore MUST clauses in the specification in the single variant case. Adding EXT-X-DISCONTINUITY-SEQUENCE to be spec compliant will resolve the issue you're seeing.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/243859809/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":774088252,"node_id":"MDExOkNsb3NlZEV2ZW50Nzc0MDg4MjUy","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/774088252","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2016-08-31T18:39:30Z","state_reason":null,"performed_via_github_app":null},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/243869154","html_url":"https://github.com/google/ExoPlayer/issues/1789#issuecomment-243869154","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/1789","id":243869154,"node_id":"MDEyOklzc3VlQ29tbWVudDI0Mzg2OTE1NA==","user":{"login":"xenDev","id":4049820,"node_id":"MDQ6VXNlcjQwNDk4MjA=","avatar_url":"https://avatars.githubusercontent.com/u/4049820?v=4","gravatar_id":"","url":"https://api.github.com/users/xenDev","html_url":"https://github.com/xenDev","followers_url":"https://api.github.com/users/xenDev/followers","following_url":"https://api.github.com/users/xenDev/following{/other_user}","gists_url":"https://api.github.com/users/xenDev/gists{/gist_id}","starred_url":"https://api.github.com/users/xenDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xenDev/subscriptions","organizations_url":"https://api.github.com/users/xenDev/orgs","repos_url":"https://api.github.com/users/xenDev/repos","events_url":"https://api.github.com/users/xenDev/events{/privacy}","received_events_url":"https://api.github.com/users/xenDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-08-31T19:11:25Z","updated_at":"2016-08-31T19:18:18Z","body":"Thanks for the details but do you know why iOS devices have no issue playing the same stream.  Does Exoplayer expect the HLS stream to be a certain version compliant while the iOS players are able to support older rev?  I don't know which draft introduced EXT-X-DISCONTINUITY-SEQUENCE.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/243869154/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"xenDev","id":4049820,"node_id":"MDQ6VXNlcjQwNDk4MjA=","avatar_url":"https://avatars.githubusercontent.com/u/4049820?v=4","gravatar_id":"","url":"https://api.github.com/users/xenDev","html_url":"https://github.com/xenDev","followers_url":"https://api.github.com/users/xenDev/followers","following_url":"https://api.github.com/users/xenDev/following{/other_user}","gists_url":"https://api.github.com/users/xenDev/gists{/gist_id}","starred_url":"https://api.github.com/users/xenDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xenDev/subscriptions","organizations_url":"https://api.github.com/users/xenDev/orgs","repos_url":"https://api.github.com/users/xenDev/repos","events_url":"https://api.github.com/users/xenDev/events{/privacy}","received_events_url":"https://api.github.com/users/xenDev/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/243872208","html_url":"https://github.com/google/ExoPlayer/issues/1789#issuecomment-243872208","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/1789","id":243872208,"node_id":"MDEyOklzc3VlQ29tbWVudDI0Mzg3MjIwOA==","user":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-08-31T19:22:33Z","updated_at":"2016-08-31T19:23:31Z","body":"EXT-X-DISCONTINUITY was added to the spec quite a long time before EXT-X-DISCONTINUITY-SEQUENCE. It's likely that the iOS player doesn't rely on EXT-X-DISCONTINUITY-SEQUENCE as much as ExoPlayer does as a result. It's unclear to me whether or not the spec was under-specified (to the extent that the player had to \"guess what to do\" in some cases) prior to the addition of EXT-X-DISCONTINUITY-SEQUENCE, but I suspect this is likely to be the case.\n\nEXT-X-DISCONTINUITY-SEQUENCE has been in the spec for around 3 years now. Given it's relevant to live streams (only), it's not like there's a huge volume of legacy content that omits the tag. It seems reasonable for us to require that live stream providers aren't more than 3 years behind the spec.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/243872208/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/243872619","html_url":"https://github.com/google/ExoPlayer/issues/1789#issuecomment-243872619","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/1789","id":243872619,"node_id":"MDEyOklzc3VlQ29tbWVudDI0Mzg3MjYxOQ==","user":{"login":"hancockks","id":4013359,"node_id":"MDQ6VXNlcjQwMTMzNTk=","avatar_url":"https://avatars.githubusercontent.com/u/4013359?v=4","gravatar_id":"","url":"https://api.github.com/users/hancockks","html_url":"https://github.com/hancockks","followers_url":"https://api.github.com/users/hancockks/followers","following_url":"https://api.github.com/users/hancockks/following{/other_user}","gists_url":"https://api.github.com/users/hancockks/gists{/gist_id}","starred_url":"https://api.github.com/users/hancockks/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hancockks/subscriptions","organizations_url":"https://api.github.com/users/hancockks/orgs","repos_url":"https://api.github.com/users/hancockks/repos","events_url":"https://api.github.com/users/hancockks/events{/privacy}","received_events_url":"https://api.github.com/users/hancockks/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-08-31T19:23:57Z","updated_at":"2016-08-31T19:23:57Z","body":"The manifest in question uses EXT-X-VERSION:3.  According to the EXT-X-VERSION:\n3.4.17.  EXT-X-VERSION\n\n   The EXT-X-VERSION tag indicates the compatibility version of the\n   Playlist file.  The Playlist file, its associated media, and its\n   server MUST comply with all provisions of the most-recent version of\n   this document describing the protocol version indicated by the tag\n   value.\n\nThe most recent spec documenting protocol version 3 is https://tools.ietf.org/html/draft-pantos-http-live-streaming-06 which does not contain EXT-X-DISCONTINUITY-SEQUENCE.  It would be improper for the client that implements compatibility with VERSION 3 to require tags that are not part of the version 3 specification.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/243872619/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"hancockks","id":4013359,"node_id":"MDQ6VXNlcjQwMTMzNTk=","avatar_url":"https://avatars.githubusercontent.com/u/4013359?v=4","gravatar_id":"","url":"https://api.github.com/users/hancockks","html_url":"https://github.com/hancockks","followers_url":"https://api.github.com/users/hancockks/followers","following_url":"https://api.github.com/users/hancockks/following{/other_user}","gists_url":"https://api.github.com/users/hancockks/gists{/gist_id}","starred_url":"https://api.github.com/users/hancockks/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hancockks/subscriptions","organizations_url":"https://api.github.com/users/hancockks/orgs","repos_url":"https://api.github.com/users/hancockks/repos","events_url":"https://api.github.com/users/hancockks/events{/privacy}","received_events_url":"https://api.github.com/users/hancockks/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/243874473","html_url":"https://github.com/google/ExoPlayer/issues/1789#issuecomment-243874473","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/1789","id":243874473,"node_id":"MDEyOklzc3VlQ29tbWVudDI0Mzg3NDQ3Mw==","user":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-08-31T19:30:26Z","updated_at":"2016-08-31T19:30:26Z","body":"Yep. So I think you can consider ExoPlayer as not supporting live streams prior to version 6 in the specific case that they include EXT-X-DISCONTINUITY tags. As per above, it seems reasonable that live stream providers shouldn't be using a spec that's 3 years old.\n\nExoPlayer will successfully play on-demand streams and live streams that do not include EXT-X-DISCONTINUITY tags that are prior to version 6.\n\nWe could proactively detect the unsupported case and fail with a clearer warning, if you feel that would be worthwhile.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/243874473/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/243875259","html_url":"https://github.com/google/ExoPlayer/issues/1789#issuecomment-243875259","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/1789","id":243875259,"node_id":"MDEyOklzc3VlQ29tbWVudDI0Mzg3NTI1OQ==","user":{"login":"hancockks","id":4013359,"node_id":"MDQ6VXNlcjQwMTMzNTk=","avatar_url":"https://avatars.githubusercontent.com/u/4013359?v=4","gravatar_id":"","url":"https://api.github.com/users/hancockks","html_url":"https://github.com/hancockks","followers_url":"https://api.github.com/users/hancockks/