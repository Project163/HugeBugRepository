i.github.com/repos/google/ExoPlayer/issues/events/2335436457","actor":{"login":"google","id":1342004,"node_id":"MDEyOk9yZ2FuaXphdGlvbjEzNDIwMDQ=","avatar_url":"https://avatars.githubusercontent.com/u/1342004?v=4","gravatar_id":"","url":"https://api.github.com/users/google","html_url":"https://github.com/google","followers_url":"https://api.github.com/users/google/followers","following_url":"https://api.github.com/users/google/following{/other_user}","gists_url":"https://api.github.com/users/google/gists{/gist_id}","starred_url":"https://api.github.com/users/google/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/google/subscriptions","organizations_url":"https://api.github.com/users/google/orgs","repos_url":"https://api.github.com/users/google/repos","events_url":"https://api.github.com/users/google/events{/privacy}","received_events_url":"https://api.github.com/users/google/received_events","type":"Organization","user_view_type":"public","site_admin":false},"event":"comment_deleted","commit_id":null,"commit_url":null,"created_at":"2019-05-12T20:35:26Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/491627311","html_url":"https://github.com/google/ExoPlayer/issues/5876#issuecomment-491627311","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/5876","id":491627311,"node_id":"MDEyOklzc3VlQ29tbWVudDQ5MTYyNzMxMQ==","user":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-05-12T20:36:55Z","updated_at":"2019-05-12T20:37:09Z","body":"The problem is just that the first stream contains line terminators in the stream title. For example:\r\n```\r\nDJ MERT LEVENT - BON VOYAGE\r\n\r\n - \r\n```\r\nThe `Pattern` we use for matching doesn't handle that. It's easy to fix (note that it'll be working as intended that there are line terminators in the stream title, since that's what's in the underlying stream).","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/491627311/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/491941844","html_url":"https://github.com/google/ExoPlayer/issues/5876#issuecomment-491941844","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/5876","id":491941844,"node_id":"MDEyOklzc3VlQ29tbWVudDQ5MTk0MTg0NA==","user":{"login":"nightwolf738","id":16029779,"node_id":"MDQ6VXNlcjE2MDI5Nzc5","avatar_url":"https://avatars.githubusercontent.com/u/16029779?v=4","gravatar_id":"","url":"https://api.github.com/users/nightwolf738","html_url":"https://github.com/nightwolf738","followers_url":"https://api.github.com/users/nightwolf738/followers","following_url":"https://api.github.com/users/nightwolf738/following{/other_user}","gists_url":"https://api.github.com/users/nightwolf738/gists{/gist_id}","starred_url":"https://api.github.com/users/nightwolf738/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nightwolf738/subscriptions","organizations_url":"https://api.github.com/users/nightwolf738/orgs","repos_url":"https://api.github.com/users/nightwolf738/repos","events_url":"https://api.github.com/users/nightwolf738/events{/privacy}","received_events_url":"https://api.github.com/users/nightwolf738/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-05-13T18:50:14Z","updated_at":"2019-05-13T20:03:34Z","body":"Thank you for your response in such a short time. I would like to furher this issue to maintain the feature with minimum bugs:\r\n\r\n- Fetching ICY metadata does not work at all in my `Sony E5553 Android 6.0, API 23` device, `MetadataOutput` listener is never being invoked, while API 26 & API 28 devices work fine on the same stream. You can test the issue via [http://17773.live.streamtheworld.com/JOY_TURK2AAC_SC](http://17773.live.streamtheworld.com/JOY_TURK2AAC_SC)\r\n\r\n- [http://46.20.3.228/](http://46.20.3.228/) this radio stream has an empty 'Current Song' section but ExoPlayer invokes `MetadataOutput` with `IcyInfo` containing title field: `';StreamUrl='`. It seems like ExoPlayer wrongly parses metadata because there is also a 'Stream Url' section when you open the link in browser.\r\n\r\nThat's all I have found so far. I would like to continue to report more bugs as I face.\r\n\r\nThank you.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/491941844/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"nightwolf738","id":16029779,"node_id":"MDQ6VXNlcjE2MDI5Nzc5","avatar_url":"https://avatars.githubusercontent.com/u/16029779?v=4","gravatar_id":"","url":"https://api.github.com/users/nightwolf738","html_url":"https://github.com/nightwolf738","followers_url":"https://api.github.com/users/nightwolf738/followers","following_url":"https://api.github.com/users/nightwolf738/following{/other_user}","gists_url":"https://api.github.com/users/nightwolf738/gists{/gist_id}","starred_url":"https://api.github.com/users/nightwolf738/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nightwolf738/subscriptions","organizations_url":"https://api.github.com/users/nightwolf738/orgs","repos_url":"https://api.github.com/users/nightwolf738/repos","events_url":"https://api.github.com/users/nightwolf738/events{/privacy}","received_events_url":"https://api.github.com/users/nightwolf738/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/492022389","html_url":"https://github.com/google/ExoPlayer/issues/5876#issuecomment-492022389","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/5876","id":492022389,"node_id":"MDEyOklzc3VlQ29tbWVudDQ5MjAyMjM4OQ==","user":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-05-13T23:26:59Z","updated_at":"2019-05-13T23:27:33Z","body":"> http://46.20.3.228/ this radio stream has an empty 'Current Song' section but ExoPlayer invokes MetadataOutput with IcyInfo containing title field: ';StreamUrl='. It seems like ExoPlayer wrongly parses metadata because there is also a 'Stream Url' section when you open the link in browser.\r\n\r\nThis is because our `Pattern` doesn't expect empty values, and is also easy to fix.\r\n\r\n> Fetching ICY metadata does not work at all in my Sony E5553 Android 6.0, API 23 device, MetadataOutput listener is never being invoked, while API 26 & API 28 devices work fine on the same stream. You can test the issue via http://17773.live.streamtheworld.com/JOY_TURK2AAC_SC\r\n\r\nI'm less sure about this one. Does playback of the stream work at all? Does using the OkHttp extension rather than the default network stack resolve the problem? You should probably be using the OkHttp extension anyway if you're playing ICY streams, since on some devices the default network stack will not handle not-strictly-http status responses, and will fail playback with \"Unexpected status line: ICY 200 OK\" for some ICY streams. We should add an entry to our troubleshooting page about this!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/492022389/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":2338493824,"node_id":"MDExOkNsb3NlZEV2ZW50MjMzODQ5MzgyNA==","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/2338493824","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.