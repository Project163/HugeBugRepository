+                }
+                return null;
+            }
+
+            @Override
+            public Void visit(org.elasticsearch.geometry.Line line) {
+                checker.accept(ShapeType.LINESTRING);
+                if (line.isEmpty() == false) {
+                    geometries.add(toXYLine(line));
+                }
+                return null;
+            }
