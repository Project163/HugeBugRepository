@@ -379,7 +379,7 @@ &lt;span class=&quot;code-keyword&quot;&gt;public&lt;/span&gt; &lt;span class=&quot;code-keyword&quot;&gt;class &lt;/span&gt;GridNearCacheEntry &lt;span class=&quot;code-keyword&quot;&gt;extends&lt;/span&gt; GridDistributedCacheEntry {
                 CacheObject old = &lt;span class=&quot;code-keyword&quot;&gt;this&lt;/span&gt;.val;
                 &lt;span class=&quot;code-object&quot;&gt;boolean&lt;/span&gt; hasVal = hasValueUnlocked();

-                &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (&lt;span class=&quot;code-keyword&quot;&gt;this&lt;/span&gt;.dhtVer == &lt;span class=&quot;code-keyword&quot;&gt;null&lt;/span&gt; || &lt;span class=&quot;code-keyword&quot;&gt;this&lt;/span&gt;.dhtVer.compareTo(dhtVer) &amp;lt; 0) {
+                &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; ((&lt;span class=&quot;code-keyword&quot;&gt;this&lt;/span&gt;.dhtVer == &lt;span class=&quot;code-keyword&quot;&gt;null&lt;/span&gt; || &lt;span class=&quot;code-keyword&quot;&gt;this&lt;/span&gt;.dhtVer.compareTo(dhtVer) &amp;lt; 0) || !valid(topVer)) {
                     primaryNode(primaryNodeId, topVer);

                     update(val, expireTime, ttl, ver, &lt;span class=&quot;code-keyword&quot;&gt;true&lt;/span&gt;);
&lt;/pre&gt;
