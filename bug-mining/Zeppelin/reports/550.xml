		&lt;li&gt;
		&lt;ol&gt;
			&lt;li&gt;What is the Jira issue?&lt;br/&gt;
    &lt;a href=&quot;https://issues.apache.org/jira/browse/ZEPPELIN-1970&quot; title=&quot;Need to fix broken image link in &amp;quot;Writing a new Visualization&amp;quot;&quot; class=&quot;issue-link&quot; data-issue-key=&quot;ZEPPELIN-1970&quot;&gt;&lt;del&gt;ZEPPELIN-1970&lt;/del&gt;&lt;/a&gt;(&lt;a href=&quot;https://issues.apache.org/jira/browse/ZEPPELIN-1970&quot; class=&quot;external-link&quot; rel=&quot;nofollow&quot;&gt;https://issues.apache.org/jira/browse/ZEPPELIN-1970&lt;/a&gt;)&lt;/li&gt;
