diff --git a/doc/build/changelog/unreleased_13/5068.rst b/doc/build/changelog/unreleased_13/5068.rst
new file mode 100644
index 000000000..7a5fcd406
--- /dev/null
+++ b/doc/build/changelog/unreleased_13/5068.rst
@@ -0,0 +1,10 @@
+.. change::
+    :tags: bug, orm
+    :tickets: 5068
+
+    Repaired a warning in the ORM flush process that was not covered by  test
+    coverage when deleting objects that use the "version_id" feature. This
+    warning is generally unreachable unless using a dialect that sets the
+    "supports_sane_rowcount" flag to False, which  is not typically the case
+    however is possible for some MySQL configurations as well as older Firebird
+    drivers, and likely some third party dialects.
diff --git a/lib/sqlalchemy/engine/default.py b/lib/sqlalchemy/engine/default.py
index 7016adcf4..bfc6dfee8 100644
--- a/lib/sqlalchemy/engine/default.py
+++ b/lib/sqlalchemy/engine/default.py
@@ -271,6 +271,13 @@ class DefaultDialect(interfaces.Dialect):
 
     @property
     def supports_sane_rowcount_returning(self):
+        """True if this dialect supports sane rowcount even if RETURNING is
+        in use.
+
+        For dialects that don't support RETURNING, this is synomous
+        with supports_sane_rowcount.
+
+        """
         return self.supports_sane_rowcount
 
     @classmethod
