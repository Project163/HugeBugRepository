+import { Column, Entity, PrimaryColumn } from "../../../../src";
+import { Order } from "./order";
+
+@Entity({ name: "order_test" })
+export class OrderTestEntity {
+
+    @PrimaryColumn()
+    id: number;
+
+    @Column({ type: "enum", enum: Order, default: Order.FIRST })
+    order: Order;
+
+    @Column({ type: "enum", enum: Order, default: [Order.FIRST], array: true })
+    orders: Order[];
+
+}
diff --git a/test/github-issues/7651/entity/order.ts b/test/github-issues/7651/entity/order.ts
new file mode 100644
index 000000000..276b37d38
--- /dev/null
+++ b/test/github-issues/7651/entity/order.ts
@@ -0,0 +1,20 @@
+export enum Order {
+    FIRST = "first",
+    SECOND = "second",
+    THIRD = "third"
+}
+
+export namespace Order {
+    export function from(value: string): Order {
+        switch (value) {
+            case "_1":
+                return Order.FIRST;
+            case "_2":
+                return Order.SECOND;
+            case "_3":
+                return Order.THIRD;
+            default:
+                return Order.FIRST;
+        }
+    }
+}
diff --git a/test/github-issues/7651/issue-7651.ts b/test/github-issues/7651/issue-7651.ts
