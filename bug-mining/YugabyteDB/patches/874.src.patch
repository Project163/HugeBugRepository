+												attr->atttypid);
+		YBCPgTypeAttrs type_attrs;
+		type_attrs.typmod = attr->atttypmod;
+		type_attrs_arr[i] = type_attrs;
+		pkeys_atttypid[i] = attr->atttypid;
+	}
+	if (is_table)
+		relation_close(index_rel, AccessShareLock);
+	relation_close(rel, AccessShareLock);
 
