t":5586,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["elasticsearch","java","search-engine"],"visibility":"public","forks":25807,"open_issues":5586,"watchers":76300,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/elastic/elasticsearch/pulls/72152","html_url":"https://github.com/elastic/elasticsearch/pull/72152","diff_url":"https://github.com/elastic/elasticsearch/pull/72152.diff","patch_url":"https://github.com/elastic/elasticsearch/pull/72152.patch","merged_at":"2021-04-26T08:21:41Z"},"body":"The `minimum_should_match` parameter for queries like `match` or `query_string\"\r\naccepts either string values like \"2\" or \"25%\", numeric values and in most older\r\ncases also `null` as a no-op parameter. We also use examples for these different\r\nvalues in our documentation, so we should also support these value types for the\r\nnew `combined_fields` query. This changes the ConstructingObjectParser used in\r\nCombinedFieldsQueryBuilder so it also accepts integer value types and adds a\r\nparsing test for the different cases.\r\n\r\nCloses #72148","reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/72152/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/elastic/elasticsearch/issues/72152/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":4643220816,"node_id":"MDExOkNsb3NlZEV2ZW50NDY0MzIyMDgxNg==","url":"https://api.github.com/repos/elastic/elasticsearch/issues/events/4643220816","actor":{"login":"cbuescher","id":10398885,"node_id":"MDQ6VXNlcjEwMzk4ODg1","avatar_url":"https://avat