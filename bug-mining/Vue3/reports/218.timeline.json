1-0f056a33-a245-4581-bd14-f654caaf1851.png)\r\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/vuejs/core/issues/comments/893077719/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"edison1105","id":3705199,"node_id":"MDQ6VXNlcjM3MDUxOTk=","avatar_url":"https://avatars.githubusercontent.com/u/3705199?v=4","gravatar_id":"","url":"https://api.github.com/users/edison1105","html_url":"https://github.com/edison1105","followers_url":"https://api.github.com/users/edison1105/followers","following_url":"https://api.github.com/users/edison1105/following{/other_user}","gists_url":"https://api.github.com/users/edison1105/gists{/gist_id}","starred_url":"https://api.github.com/users/edison1105/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/edison1105/subscriptions","organizations_url":"https://api.github.com/users/edison1105/orgs","repos_url":"https://api.github.com/users/edison1105/repos","events_url":"https://api.github.com/users/edison1105/events{/privacy}","received_events_url":"https://api.github.com/users/edison1105/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/vuejs/core/issues/comments/894128125","html_url":"https://github.com/vuejs/core/issues/4244#issuecomment-894128125","issue_url":"https://api.github.com/repos/vuejs/core/issues/4244","id":894128125,"node_id":"IC_kwDOCCum1841S0_9","user":{"login":"Bigfish8","id":40156382,"node_id":"MDQ6VXNlcjQwMTU2Mzgy","avatar_url":"https://avatars.githubusercontent.com/u/40156382?v=4","gravatar_id":"","url":"https://api.github.com/users/Bigfish8","html_url":"https://github.com/Bigfish8","followers_url":"https://api.github.com/users/Bigfish8/followers","following_url":"https://api.github.com/users/Bigfish8/following{/other_user}","gists_url":"https://api.github.com/users/Bigfish8/gists{/gist_id}","starred_url":"https://api.github.com/users/Bigfish8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bigfish8/subscriptions","organizations_url":"https://api.github.com/users/Bigfish8/orgs","repos_url":"https://api.github.com/users/Bigfish8/repos","events_url":"https://api.github.com/users/Bigfish8/events{/privacy}","received_events_url":"https://api.github.com/users/Bigfish8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-08-06T09:20:38Z","updated_at":"2021-08-06T09:20:38Z","body":"I think the cause is the slot hint.\r\nIn this case,the outer Forward's slot hint is Stable,but the inner Forward's slot hint is Dynamic.When Child component updates,the outer Forward will not update because of the Stable hint.But component with dynamic slot does not track it own dependence.The inner Forward's re-render rely on the outer Forward, so it will not update.\r\nLook [this example](https://sfc.vuejs.org/#) works well.\r\nI will commit a PR to solve it.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/vuejs/core/issues/comments/894128125/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Bigfish8","id":40156382,"node_id":"MDQ6VXNlcjQwMTU2Mzgy","avatar_url":"https://avatars.githubusercontent.com/u/40156382?v=4","gravatar_id":"","url":"https://api.github.com/users/Bigfish8","html_url":"https://github.com/Bigfish8","followers_url":"https://api.github.com/users/Bigfish8/followers","following_url":"https://api.github.com/users/Bigfish8/following{/other_user}","gists_url":"https://api.github.com/users/Bigfish8/gists{/gist_id}","starred_url":"https://api.github.com/users/Bigfish8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bigfish8/subscriptions","organizations_url":"https://api.github.com/u