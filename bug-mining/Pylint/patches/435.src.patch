+++ b/tests/functional/u/use/used_before_assignment_issue85.py
@@ -0,0 +1,9 @@
+"""https://github.com/PyCQA/pylint/issues/85"""
+def main():
+    """When evaluating finally blocks, assume try statements fail."""
+    try:
+        res = 1 / 0
+        res = 42
+    finally:
+        print(res)  # [used-before-assignment]
+    print(res)
