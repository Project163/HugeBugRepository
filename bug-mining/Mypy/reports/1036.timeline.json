_url":"https://api.github.com/repos/python/mypy/milestones{/number}","notifications_url":"https://api.github.com/repos/python/mypy/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/python/mypy/labels{/name}","releases_url":"https://api.github.com/repos/python/mypy/releases{/id}","deployments_url":"https://api.github.com/repos/python/mypy/deployments","created_at":"2012-12-07T13:30:23Z","updated_at":"2025-12-12T11:48:01Z","pushed_at":"2025-12-11T20:11:30Z","git_url":"git://github.com/python/mypy.git","ssh_url":"git@github.com:python/mypy.git","clone_url":"https://github.com/python/mypy.git","svn_url":"https://github.com/python/mypy","homepage":"https://www.mypy-lang.org/","size":77161,"stargazers_count":20064,"watchers_count":20064,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":3065,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":3124,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["linter","python","typechecker","types","typing"],"visibility":"public","forks":3065,"open_issues":3124,"watchers":20064,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Similar to #14002; came up in python/typeshed#9084.\r\n\r\n```python\r\nfrom typing import TypeVar, Generic, overload\r\n\r\nT = TypeVar(\"T\", str, int)\r\n\r\nclass Base(Generic[T]):\r\n    @overload\r\n    def method(self, s: T) -> T: ...\r\n    @overload\r\n    def method(self: Base[str], s: bytes) -> str: ...\r\n    def method(self, s: object): ...\r\n\r\nclass Child(Base[int]):\r\n    def method(self, s: int) -> int:\r\n        raise NotImplementedError\r\n```\r\n(https://mypy-play.net/?mypy=latest&python=3.10&gist=da356a97851f7b7649d208e1359a6de4)\r\n\r\nwith mypy 1.1.1 produces:\r\n\r\n```\r\n/Users/jelle/bin/inerhit.py:13: error: Signature of \"method\" incompatible with supertype \"Base\"  [override]\r\n/Users/jelle/bin/inerhit.py:13: note:      Superclass:\r\n/Users/jelle/bin/inerhit.py:13: note:          @overload\r\n/Users/jelle/bin/inerhit.py:13: note:          def method(self, s: int) -> int\r\n/Users/jelle/bin/inerhit.py:13: note:          @overload\r\n/Users/jelle/bin/inerhit.py:13: note:          def method(self, s: bytes) -> str\r\n/Users/jelle/bin/inerhit.py:13: note:      Subclass:\r\n/Users/jelle/bin/inerhit.py:13: note:          def method(self, s: int) -> int\r\nFound 1 error in 1 file (checked 1 source file)\r\n```\r\n\r\nThere should be no errors. The second overload is not applicable to a `Base[int]`, so it should be fine that the subclass lacks it.","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/14866/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/mypy/issues/14866/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]