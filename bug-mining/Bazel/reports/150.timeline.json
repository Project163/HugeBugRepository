nfiguredTargetFunction.java:200)\n    at com.google.devtools.build.skyframe.ParallelEvaluator$Evaluate.run(ParallelEvaluator.java:966)\n    ... 4 more\nwt@frisbee:~/projects/bazel/rules_nodejs$\n```\n\nI would expect the second to work just as well as the first.\n\n@lberki fixed #1290, so maybe this one will also be of interest.\n","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/1296/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bazelbuild/bazel/issues/1296/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"actor":{"login":"wt","id":416255,"node_id":"MDQ6VXNlcjQxNjI1NQ==","avatar_url":"https://avatars.githubusercontent.com/u/416255?v=4","gravatar_id":"","url":"https://api.github.com/users/wt","html_url":"https://github.com/wt","followers_url":"https://api.github.com/users/wt/followers","following_url":"https://api.github.com/users/wt/following{/other_user}","gists_url":"https://api.github.com/users/wt/gists{/gist_id}","starred_url":"https://api.github.com/users/wt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wt/subscriptions","organizations_url":"https://api.github.com/users/wt/orgs","repos_url":"https://api.github.com/users/wt/repos","events_url":"https://api.github.com/users/wt/events{/privacy}","received_events_url":"https://api.github.com/users/wt/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-05-20T09:37:02Z","updated_at":"2016-05-20T09:37:02Z","source":{"type":"issue","issue":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/1297","repository_url":"https://api.github.com/repos/bazelbuild/bazel","labels_url":"https://api.github.com/repos/bazelbuild/bazel/issues/1297/labels{/name}","comments_url":"https://api.github.com/repos/bazelbuild/bazel/issues/1297/comments","events_url":"https://api.github.c