<item>
            <title>[KYLIN-6066] Error in &quot;Checking Spark Availability&quot;</title>
                <link>https://issues.apache.org/jira/browse/KYLIN-6066</link>
                <project id="12316121" key="KYLIN">Kylin</project>
                    <description>&lt;p&gt;1. Standalone Mode: Checking Spark Availability fails when Kylin starts. &#160;&lt;br/&gt;
2. YARN Mode: Checking Spark Availability is skipped.&lt;/p&gt;</description>
                <environment></environment>
        <key id="13609682">KYLIN-6066</key>
            <summary>Error in &quot;Checking Spark Availability&quot;</summary>
                <type id="1" iconUrl="https://issues.apache.org/jira/secure/viewavatar?size=xsmall&amp;avatarId=21133&amp;avatarType=issuetype">Bug</type>
