m/users/gkalpak/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"unlabeled","commit_id":null,"commit_url":null,"created_at":"2018-08-07T13:57:04Z","label":{"name":"PR target: TBD","color":"5319e7"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/angular/angular/issues/comments/411067673","html_url":"https://github.com/angular/angular/issues/25334#issuecomment-411067673","issue_url":"https://api.github.com/repos/angular/angular/issues/25334","id":411067673,"node_id":"MDEyOklzc3VlQ29tbWVudDQxMTA2NzY3Mw==","user":{"login":"gkalpak","id":8604205,"node_id":"MDQ6VXNlcjg2MDQyMDU=","avatar_url":"https://avatars.githubusercontent.com/u/8604205?v=4","gravatar_id":"","url":"https://api.github.com/users/gkalpak","html_url":"https://github.com/gkalpak","followers_url":"https://api.github.com/users/gkalpak/followers","following_url":"https://api.github.com/users/gkalpak/following{/other_user}","gists_url":"https://api.github.com/users/gkalpak/gists{/gist_id}","starred_url":"https://api.github.com/users/gkalpak/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gkalpak/subscriptions","organizations_url":"https://api.github.com/users/gkalpak/orgs","repos_url":"https://api.github.com/users/gkalpak/repos","events_url":"https://api.github.com/users/gkalpak/events{/privacy}","received_events_url":"https://api.github.com/users/gkalpak/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-08-07T14:03:54Z","updated_at":"2018-08-07T14:06:29Z","body":"Normally, the `$destroy` event is triggered by jqLite/jQuery, which is not used in Angular for removing the element.\r\n\r\nI don't see a reason not to trigger the event from `ngUpgrade` ([here][1] and [there][2]).\r\n\r\n##\r\nIn the meantime, you can augment `UpgradeComponent` to trigger the event (and then use your class instead of `UpgradeComponent` for you upgraded components):\r\n\r\n```ts\r\nimport {UpgradeComponent} from '@angular/upgrade/static';\r\n\r\nexport class AugmentedUpgradeComponent extends UpgradeComponent {\r\n  ngOnDestroy() {\r\n    super.ngOnDestroy();\r\n    (this as any).$element.triggerHandler('$destroy');\r\n  }\r\n}\r\n```\r\n\r\n[Demo][3]\r\n\r\n[1]: https://github.com/angular/angular/blob/2505c077d7e85421b32afed8b18e67b71e322654/packages/upgrade/src/static/upgrade_component.ts#L216-L224\r\n[2]: https://github.com/angular/angular/blob/2505c077d7e85421b32afed8b18e67b71e322654/packages/upgrade/src/dynamic/upgrade_ng1_adapter.ts#L265-L271\r\n[3]: https://stackblitz.com/edit/ngupgradestatic-playground-bgdmcz?file=ng1/ng1-demo.component.ts","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/comments/411067673/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"gkalpak","id":8604205,"node_id":"MDQ6VXNlcjg2MDQyMDU=","avatar_url":"https://avatars.githubusercontent.com/u/8604205?v=4","gravatar_id":"","url":"https://api.github.com/users/gkalpak","html_url":"https://github.com/gkalpak","followers_url":"https://api.github.com/users/gkalpak/followers","following_url":"https://api.github.com/users/gkalpak/following{/other_user}","gists_url":"https://api.github.com/users/gkalpak/gists{/gist_id}","starred_url":"https://api.github.com/users/gkalpak/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gkalpak/subscriptions","organizations_url":"https://api.github.com/users/gkalpak/orgs","repos_url":"https://api.github.com/users/gkalpak/repos","events_url":"https://api.github.com/users/gkalpak/events{/privacy}","received_events_url":"https://api.github.com/users/gkalpak/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1775635641,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDE3NzU2MzU2NDE=","url":"https://api.github.com/repos/angular/angular/iss