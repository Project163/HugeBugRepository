ept `MissingDependency`, which is a false positive.\r\n\r\nPossibly related: #1156\r\n\r\nExample:\r\n\r\n**example.php**:\r\n```php\r\n<?php\r\nclass Child extends Base {}\r\n\r\nnew Child(); // error\r\n\r\nChild::example(); // no error\r\n\r\nord(0); // no error\r\n```\r\n\r\n**stub.php**:\r\n```php\r\n<?php\r\nclass Base {}\r\n```\r\n\r\n**psalm.xml**:\r\n```xml\r\n<?xml version=\"1.0\"?>\r\n<psalm\r\n    totallyTyped=\"true\"\r\n    xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\r\n    xmlns=\"https://getpsalm.org/schema/config\"\r\n    xsi:schemaLocation=\"https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd\"\r\n>\r\n    <projectFiles>\r\n        <directory name=\".\" />\r\n        <ignoreFiles>\r\n            <directory name=\"vendor\" />\r\n        </ignoreFiles>\r\n    </projectFiles>\r\n    <stubs>\r\n        <file name=\"stub.php\" />\r\n    </stubs>\r\n</psalm>\r\n```","reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/1528/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vimeo/psalm/issues/1528/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/vimeo/psalm/issues/comments/720880513","html_url":"https://github.com/vimeo/psalm/issues/1156#issuecomment-720880513","issue_url":"https://api.github.com/repos/vimeo/psalm/issues/1156","id":720880513,"node_id":"MDEyOklzc3VlQ29tbWVudDcyMDg4MDUxMw==","user":{"login":"muglug","id":2292638,"node_id":"MDQ6VXNlcjIyOTI2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/2292638?v=4","gravatar_id":"","url":"https://api.github.com/users/muglug","html_url":"https://github.com/muglug","followers_url":"https://api.github.com/users/muglug/followers","following_url":"https://api.github.com/users/muglug/following{/other_user}","gists_url":"https://api.github.com/users/muglug/gists{/gist_id}","starr