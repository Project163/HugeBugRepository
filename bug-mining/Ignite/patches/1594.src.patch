+    private Integer findKey(Affinity<Integer> aff, int part) {
+        for (int i = 0; i < 10_000; i++) {
+            Integer key = i;
+
+            if (aff.partition(key) == part)
+                return key;
+        }
+
+        fail();
+
+        return null;
+    }
