\n        return;\n    }\n\n\n/***/ },\n/* 2 */\n/***/ function(module, exports, __webpack_require__) {\n\n    /* harmony import */ var __WEBPACK_IMPORTED_MODULE_0__module__ = __webpack_require__(0);\n    /* harmony import */ var __WEBPACK_IMPORTED_MODULE_1__module2__ = __webpack_require__(1);\n\n\n    /* harmony import */__WEBPACK_IMPORTED_MODULE_0__module__[\"a\"].bind()();\n    bar();\n\n\n\n\n/***/ }\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/webpack/webpack/issues/comments/225836418/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"maxhr","id":2169660,"node_id":"MDQ6VXNlcjIxNjk2NjA=","avatar_url":"https://avatars.githubusercontent.com/u/2169660?v=4","gravatar_id":"","url":"https://api.github.com/users/maxhr","html_url":"https://github.com/maxhr","followers_url":"https://api.github.com/users/maxhr/followers","following_url":"https://api.github.com/users/maxhr/following{/other_user}","gists_url":"https://api.github.com/users/maxhr/gists{/gist_id}","starred_url":"https://api.github.com/users/maxhr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/maxhr/subscriptions","organizations_url":"https://api.github.com/users/maxhr/orgs","repos_url":"https://api.github.com/users/maxhr/repos","events_url":"https://api.github.com/users/maxhr/events{/privacy}","received_events_url":"https://api.github.com/users/maxhr/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/webpack/webpack/issues/comments/226123869","html_url":"https://github.com/webpack/webpack/issues/2528#issuecomment-226123869","issue_url":"https://api.github.com/repos/webpack/webpack/issues/2528","id":226123869,"node_id":"MDEyOklzc3VlQ29tbWVudDIyNjEyMzg2OQ==","user":{"login":"sokra","id":1365881,"node_id":"MDQ6VXNlcjEzNjU4ODE=","avatar_url":"https://avatars.gith