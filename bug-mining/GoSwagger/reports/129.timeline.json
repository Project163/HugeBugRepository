ticipating}","labels_url":"https://api.github.com/repos/go-swagger/go-swagger/labels{/name}","releases_url":"https://api.github.com/repos/go-swagger/go-swagger/releases{/id}","deployments_url":"https://api.github.com/repos/go-swagger/go-swagger/deployments","created_at":"2014-11-16T20:13:15Z","updated_at":"2025-12-12T12:05:28Z","pushed_at":"2025-12-04T16:10:09Z","git_url":"git://github.com/go-swagger/go-swagger.git","ssh_url":"git@github.com:go-swagger/go-swagger.git","clone_url":"https://github.com/go-swagger/go-swagger.git","svn_url":"https://github.com/go-swagger/go-swagger","homepage":"https://goswagger.io","size":55802,"stargazers_count":9891,"watchers_count":9891,"language":"Go","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":true,"has_discussions":true,"forks_count":1291,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":592,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["api","code-generator","go","golang","swagger-codegen","swagger-spec","swagger-specification"],"visibility":"public","forks":1291,"open_issues":592,"watchers":9891,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"## Problem statement\r\nWhenever a schema declares a default value, the corresponding generated structure is properly initialized, like in:\r\n```yaml\r\nparameters:\r\n  - in: body\r\n    name: myBodyParam\r\n    schema:\r\n      type: object\r\n      properties:\r\n        p1: \r\n          type: string\r\n        p2:\r\n           type: integer\r\n      default:\r\n        p1: abc\r\n        p2: 12\r\n```\r\n\r\nHowever, when defaults are declared at a lower level, no initialization takes place, as in:\r\n```yaml\r\nparameters:\r\n  - in: body\r\n    name: myBodyParam\r\n    schema:\r\n      type: object\r\n      properties:\r\n        p1: \r\n          type: string\r\n          default: abc\r\n        p2:\r\n          type: integer\r\n          default: 12\r\n```\r\n\r\nIt looks like the \"schema\" term used in the [json schema spec](https://tools.ietf.org/html/draft-fge-json-schema-validation-00#section-6.2) has been taken to the letter, making it equivalent to the swagger schema term.\r\n\r\n\r\n## Steps to reproduce\r\ngenerate server with structures proposed  as examples and submit uninitialized body\r\n\r\n## Environment\r\nswagger version: x.x.x  \r\ngo version: x.x.x  \r\nOS:   \r\n","reactions":{"url":"https://api.github.com/repos/go-swagger/go-swagger/issues/1393/reactions","total_count":7,"+1":7,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/go-swagger/go-swagger/issues/1393/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/go-swagger/go-swagger/issues/comments/370277275","html_url":"https://github.com/go-swagger/go-swagger/issues/1062#issuecomment-370277275","issue_url":"https://api.github.com/repos/go-swagger/go-swagger/issues/1062","id":370277275,"node_id":"MDEyOklzc3VlQ29tbWVudDM3MDI3NzI3NQ==","user":{"login":"fredbi","id":14262513,"node_id":"MDQ6VXNlcjE0MjYyNTEz","avatar_url":"https://avatars.githubusercontent.com/u/14262513?v=4","gravatar_id":"","url":"https://api.github.com/users/fredbi","html_url":"https://github.com/fredbi","followers_url":"https://api.github.com/users/fredbi/followers","following_url":"https://api.github.com/users/fredbi/following{/other_user}","gists_url":"https://api.github.com/users/fredbi/gists{/gist_id}","starred_url":"https://api.github.com/users/fredbi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fredbi/subscriptions","organizations_url":"https://api.github.com/users/fredbi/orgs","repos_url":