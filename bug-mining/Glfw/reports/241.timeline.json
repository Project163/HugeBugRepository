.github.com/users/Hirosam1","html_url":"https://github.com/Hirosam1","followers_url":"https://api.github.com/users/Hirosam1/followers","following_url":"https://api.github.com/users/Hirosam1/following{/other_user}","gists_url":"https://api.github.com/users/Hirosam1/gists{/gist_id}","starred_url":"https://api.github.com/users/Hirosam1/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Hirosam1/subscriptions","organizations_url":"https://api.github.com/users/Hirosam1/orgs","repos_url":"https://api.github.com/users/Hirosam1/repos","events_url":"https://api.github.com/users/Hirosam1/events{/privacy}","received_events_url":"https://api.github.com/users/Hirosam1/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/glfw/glfw/issues/comments/570833837","html_url":"https://github.com/glfw/glfw/issues/1616#issuecomment-570833837","issue_url":"https://api.github.com/repos/glfw/glfw/issues/1616","id":570833837,"node_id":"MDEyOklzc3VlQ29tbWVudDU3MDgzMzgzNw==","user":{"login":"ideal-fire","id":8110008,"node_id":"MDQ6VXNlcjgxMTAwMDg=","avatar_url":"https://avatars.githubusercontent.com/u/8110008?v=4","gravatar_id":"","url":"https://api.github.com/users/ideal-fire","html_url":"https://github.com/ideal-fire","followers_url":"https://api.github.com/users/ideal-fire/followers","following_url":"https://api.github.com/users/ideal-fire/following{/other_user}","gists_url":"https://api.github.com/users/ideal-fire/gists{/gist_id}","starred_url":"https://api.github.com/users/ideal-fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ideal-fire/subscriptions","organizations_url":"https://api.github.com/users/ideal-fire/orgs","repos_url":"https://api.github.com/users/ideal-fire/repos","events_url":"https://api.github.com/users/ideal-fire/events{/privacy}","received_events_url":"https://api.github.com/users/ideal-fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-01-05T00:56:57Z","updated_at":"2020-01-05T00:56:57Z","body":"i have the same issue.\r\nthis is the test code i'm using. it prints key events from glfwSetKeyCallback along with the time.\r\nhttps://pastebin.com/raw/773hd0tX\r\n\r\non my system, i have `xset r rate 300 30`. initial repeat delay 300, sequential repeats 30.\r\nhere is the output if i push and hold the down and left arrow keys at the **same time**:\r\n[1578180561982] 263 is 1 (initial left key press at correct time)\r\n[1578180562282] 264 is 1 (down key press 300 ms later)\r\n[1578180562315] 264 is 2 (down key repeat 30 ms later)\r\n[1578180562347] 264 is 2  \r\n[1578180562381] 264 is 2  \r\n[1578180562406] 263 is 0  \r\n[1578180562406] 264 is 0  \r\nthere are no repeats for left arrow key even though it's also held.\r\nwhen using this particular combination, i can't seem to get the down arrow key to be the correct one and the left arrow key being the repeating one.\r\n\r\nif I try 'a' (65) and 'b' (66), then 'a' comes first.\r\nif I try 'b' (66) and 'c' (67), then 'b' comes first.\r\nif I try 'p' (80) and KEY_LEFT (263), then 'p' comes first.\r\nif I try 'q' (81) and 'p' (80), then 'p' comes first.\r\n\r\nif I push LEFT (263), Z (90), RIGHT (262), and DOWN (264) at the same time, here's the output:\r\n[1578183452213] 262 is 1\r\n[1578183452513] 264 is 1\r\n[1578183452546] 264 is 2\r\n[1578183452580] 264 is 2\r\n[1578183452614] 264 is 2\r\n[1578183452647] 264 is 2\r\n[1578183452680] 264 is 2\r\n[1578183452713] 264 is 2\r\n[1578183452741] 262 is 0\r\n[1578183452741] 264 is 0\r\ni confirmed using `xev` program that those 4 keys at once work on my keyboard.\r\n\r\nthis is on arch linux with X11 and the latest release software. except i compiled glfw today.\r\nglxinfo shows `OpenGL version string: 4.6.0 NVIDIA 440.44`\r\nreverting to 3.3 does not fix the problem.\r\nreverting to 3.2.1 does fix the problem.\r\n\r\nHere is the output with LEFT, Z, RIGHT, and DOWN at once test with version 3.2.1:\r\n[1578185069503] 262 is 1\r\n[1578185069503] 90 is 1\r\n[1578185069503] 263 is 1\r\n[1578185069503] 264 is 1\r\n[1578185069804] 264 is 2\r\n[1578185069837] 264 is 2\r\n[1578185069870] 264 is 2\r\n[1578185069887] 262 is 0\r\n[1578185069887] 263 is 0\r\n[1578185069887] 264 is 0\r\n[1578185069903] 90 is 0\r\neven in this version, the repeat events only fire for one key. the initial pressed events work though. it appears to be the same key that repeats in my tests with the latest version.\r\n\r\non another updated machine running arch linux with native glfw wayland, this bug does not happen. From glxinfo, that machine has `OpenGL version string: 2.1 Mesa 19.3.1` however, the key callback function never runs multiple times on the same millisecond (possibly due to slower hardware, possibly due to wayland) and the key repeat only works for one key still.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/glfw/glfw/issues/comments/570833837/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ideal-fire","id":8110008,"node_id":"MDQ6VXNlcjgxMTAwMDg=","avatar_url":"https://avatars.githubusercontent.com/u/8110008?v=4","gravatar_id":"","url":"https://api.github.com/users/ideal-fire","html_url":"https://github.com/ideal-fire","followers_url":"https://api.github.com/users/ideal-fire/followers","following_url":"https://api.github.com/users/ideal-fire/following{/other_user}","gists_url":"https://api.github.com/users/ideal-fire/gists{/gist_id}","starred_url":"https://api.github.com/users/ideal-fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ideal-fire/subscriptions","organizations_url":"https://api.github.com/users/ideal-fire/orgs","repos_url":"https://api.github.com/users/ideal-fire/repos","events_url":"https://api.github.com/users/ideal-fire/events{/privacy}","received_events_url":"https: