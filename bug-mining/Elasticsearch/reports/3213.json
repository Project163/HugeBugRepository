ity/Authentication","color":"0e8a16","default":false,"description":"Logging in, Usernames/passwords, Realms (Native/LDAP/AD/SAML/PKI/etc)"},{"id":1967499607,"node_id":"MDU6TGFiZWwxOTY3NDk5NjA3","url":"https://api.github.com/repos/elastic/elasticsearch/labels/Team:Security","name":"Team:Security","color":"fef2c0","default":false,"description":"Meta label for security team"}],"state":"closed","locked":false,"assignees":[{"login":"ankit--sethi","id":4641264,"node_id":"MDQ6VXNlcjQ2NDEyNjQ=","avatar_url":"https://avatars.githubusercontent.com/u/4641264?v=4","gravatar_id":"","url":"https://api.github.com/users/ankit--sethi","html_url":"https://github.com/ankit--sethi","followers_url":"https://api.github.com/users/ankit--sethi/followers","following_url":"https://api.github.com/users/ankit--sethi/following{/other_user}","gists_url":"https://api.github.com/users/ankit--sethi/gists{/gist_id}","starred_url":"https://api.github.com/users/ankit--sethi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ankit--sethi/subscriptions","organizations_url":"https://api.github.com/users/ankit--sethi/orgs","repos_url":"https://api.github.com/users/ankit--sethi/repos","events_url":"https://api.github.com/users/ankit--sethi/events{/privacy}","received_events_url":"https://api.github.com/users/ankit--sethi/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":1,"created_at":"2025-08-26T12:00:34Z","updated_at":"2025-12-01T16:56:53Z","closed_at":"2025-12-01T16:56:53Z","assignee":{"login":"ankit--sethi","id":4641264,"node_id":"MDQ6VXNlcjQ2NDEyNjQ=","avatar_url":"https://avatars.githubusercontent.com/u/4641264?v=4","gravatar_id":"","url":"https://api.github.com/users/ankit--sethi","html_url":"https://github.com/ankit--sethi","followers_url":"https://api.github.com/users/ankit--sethi/followers","following_url":"https://api.github.com/users/ankit--sethi/following{/other_user}","gists_url":"https://api.github.com/users/ankit--sethi/gists{/gist_id}","starred_url":"https://api.github.com/users/ankit--sethi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ankit--sethi/subscriptions","organizations_url":"https://api.github.com/users/ankit--sethi/orgs","repos_url":"https://api.github.com/users/ankit--sethi/repos","events_url":"https://api.github.com/users/ankit--sethi/events{/privacy}","received_events_url":"https://api.github.com/users/ankit--sethi/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","type":{"id":656002,"node_id":"IT_kwDOAGc3Zs4ACgKC","name":"Bug","description":"An unexpected problem or behavior","color":"red","created_at":"2024-01-25T10:19:15Z","updated_at":"2024-07-26T10:13:23Z","is_enabled":true},"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Description \n\nCurrently, SAML realm supports loading IdP metadata ([`idp.metadata.path`](https://www.elastic.co/docs/deploy-manage/users-roles/cluster-or-deployment-auth/saml#idp-metadata-path)) from a file or URL. When URL is configured, SAML will periodically poll changes at a frequency determined by the realm's `idp.metadata.http.refresh` and `idp.metadata.http.minimum_refresh` settings. \n\nThe polling and refresh of metadata is done by OpenSAML's `HTTPMetadataResolver`. The HTTP client that's created and provided to HTTP metadata resolver, [does not specify connect nor read timeouts](https://github.com/elastic/elasticsearch/blob/9848a6029813582a889cee434f6184882769505b/x-pack/plugin/security/src/main/java/org/elasticsearch/xpack/security/authc/saml/SamlRealm.java#L717-L741). This defaults to 0 (infinite) and can cause other threads (`generic` or `transport_worker` - see https://github.com/elastic/elasticsearch/issues/126609) to be blocked infinitely when read from a connection hangs.\n\n## Proposal \n\nSAML realm should define default (non zero) timeouts and allow configuring connect and read timeouts via settings, for example:\n - `idp.metadata.http.connect_timeout` that defaults to `5s`\n - `idp.metadata.http.read_timeout` that defaults to `10s`\n\n\n## Workaround \n\nThe workaround is to download metadata, make it available in the ES config directory on all nodes and configure `idp.metadata.path` to point to a file path instead of URL.","closed_by":{"login":"ankit--sethi","id":4641264,"node_id":"MDQ6VXNlcjQ2NDEyNjQ=","avatar_url":"https://avatars.githubusercontent.com/u/4641264?v=4","gravatar_id":"","url":"https://api.github.com/users/ankit--sethi","html_url":"https://github.com/ankit--sethi","followers_url":"https://api.github.com/users/ankit--sethi/followers","following_url":"https://api.github.com/users/ankit--sethi/following{/other_user}","gists_url":"https://api.github.com/users/ankit--sethi/gists{/gist_id}","starred_url":"https://api.github.com/users/ankit--sethi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ankit--sethi/subscriptions","organizations_url":"https://api.github.com/users/ankit--sethi/orgs","repos_url":"https://api.github.com/users/ankit--sethi/repos","events_url":"https://api.github.com/users/ankit--sethi/events{/privacy}","received_events_url":"https://api.github.com/users/ankit--sethi/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/133542/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/elastic/elasticsearch/issues/133542/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}