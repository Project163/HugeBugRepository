here's a null check for `$retryURL` at the top of the function.\r\n\r\nProperly-formatted:\r\n\r\n```php\r\n<?php\r\nfunction bar() {\r\n\treturn \"hello\";  \r\n}\r\n/**\r\n* Check for session cookie, and show missing-cookie page if it is missing.\r\n*\r\n* @param string|null $retryURL The URL the user should access to retry the operation. Defaults to null.\r\n*\r\n* @return void If there is a session cookie, nothing will be returned. Otherwise, the user will be redirected to a\r\n* page telling about the missing cookie.\r\n* @throws \\InvalidArgumentException If $retryURL is neither a string nor null.\r\n*/\r\nfunction checkSessionCookie($retryURL = null)\r\n{\r\n    if (!is_null($retryURL) && !is_string($retryURL)) {\r\n        throw new \\InvalidArgumentException('Invalid input parameters.');\r\n    }\r\n    $session = bar();\r\n    if ($session->hasSessionCookie()) {\r\n        return;\r\n    }\r\n    // we didn't have a session cookie. Redirect to the no-cookie page\r\n    $url = bar();\r\n    if ($retryURL !== null) { \r\n    }\r\n}\r\n```","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/comments/355963075/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"muglug","id":2292638,"node_id":"MDQ6VXNlcjIyOTI2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/2292638?v=4","gravatar_id":"","url":"https://api.github.com/users/muglug","html_url":"https://github.com/muglug","followers_url":"https://api.github.com/users/muglug/followers","following_url":"https://api.github.com/users/muglug/following{/other_user}","gists_url":"https://api.github.com/users/muglug/gists{/gist_id}","starred_url":"https://api.github.com/users/muglug/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/muglug/subscriptions","organizations_url":"https://api.github.com/users/muglug/orgs"