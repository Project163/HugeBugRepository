ed up will cause the same error.\nto reproduce:\n`npm init -y && npm install jspm@beta && jspm init -y && jspm install fs`\nthen create two files importing the modules differently:\n`1.js: import fs from 'fs'; console.log(fs)`\n`2.js: import * as fs from 'fs'; console.log(fs)`\n(console.log is to stop rollup from omitting the imports)\nthen build them together: `jspm build 1.js + 2.js`\n\n```\nR:\\Coding\\Test\\jspm-14>jspm build 1.js + 2.js\n     Creating the single-file build for 1.js + 2.js...\n\nerr  TypeError: unknown: Duplicate declaration \"fs\"\n> 1 | import fs, * as fs from 'fs';\n    |                 ^\n  2 |\n  3 | console.log(fs);\n  4 |\n    at File.buildCodeFrameError (R:\\Coding\\Test\\jspm-14\\node_modules\\babel-core\\lib\\transformation\\file\\index.js:407:15)\n    at Scope.checkBlockScopedCollisions (R:\\Coding\\Test\\jspm-14\\node_modules\\babel-traverse\\lib\\scope\\index.js:407:27)\n    at Scope.<anonymous> (R:\\Coding\\Test\\jspm-14\\node_modules\\babel-traverse\\lib\\scope\\index.js:548:18)\n    at Scope.registerBinding (R:\\Coding\\Test\\jspm-14\\node_modules\\babel-traverse\\lib\\scope\\index.js:567:8)\n    at Scope.registerDeclaration (R:\\Coding\\Test\\jspm-14\\node_modules\\babel-traverse\\lib\\scope\\index.js:492:14)\n    at Object.Declaration (R:\\Coding\\Test\\jspm-14\\node_modules\\babel-traverse\\lib\\scope\\index.js:109:36)\n    at NodePath._call (R:\\Coding\\Test\\jspm-14\\node_modules\\babel-traverse\\lib\\path\\context.js:63:18)\n    at NodePath.call (R:\\Coding\\Test\\jspm-14\\node_modules\\babel-traverse\\lib\\path\\context.js:47:17)\n    at NodePath.visit (R:\\Coding\\Test\\jspm-14\\node_modules\\babel-traverse\\lib\\path\\context.js:93:12)\n    at TraversalContext.visitQueue (R:\\Coding\\Test\\jspm-14\\node_modules\\babel-traverse\\lib\\context.js:152:16)\n    at TraversalContext.visitMultiple (R:\\Coding\\Test\\jspm-14\\node_modules\\babel-traverse\\lib\\context.js:110:17)\n    at TraversalContext.visit (R:\\Coding\\Test\\jspm-14\\node_modules\\babel-traverse\\lib\\context.js:182:19)\n    at Function.traverse.node (R:\\Coding\\Test\\jspm-14\\node_modules\\babel-traverse\\lib\\index.js:135:17)\n    at Object.traverse [as default] (R:\\Coding\\Test\\jspm-14\\node_modules\\babel-traverse\\lib\\index.js:69:12)\n    at NodePath.traverse (R:\\Coding\\Test\\jspm-14\\node_modules\\babel-traverse\\lib\\path\\index.js:141:23)\n    at Scope._crawl (R:\\Coding\\Test\\jspm-14\\node_modules\\babel-traverse\\lib\\scope\\index.js:773:10)\n```\n\nwhat's expected: (and what happens in jspm 13, afaik) rollup changes the second fs to be fs$2 or similar, avoiding the duplicate\n","reactions":{"url":"https://api.github.com/repos/jspm/jspm/issues/1765/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/jspm/jspm/issues/1765/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":646501557,"node_id":"MDEyOkxhYmVsZWRFdmVudDY0NjUwMTU1Nw==","url":"https://api.github.com/repos/rollup/rollup/issues/events/646501557","actor":{"login":"Victorystick","id":703602,"node_id":"MDQ6VXNlcjcwMzYwMg==","avatar_url":"https://avatars.githubusercontent.com/u/703602?v=4","gravatar_id":"","url":"https://api.github.com/users/Victorystick","html_url":"https://github.com/Victorystick","followers_url":"https://api.github.com/users/Victorystick/followers","following_url":"https://api.github.com/users/Victorystick/following{/other_user}","gists_url":"https://api.github.com/users/Victorystick/gists{/gist_id}","starred_url":"https://api.github.com/users/Victorystick/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Victorystick/subscriptions","organizations_url":"https://api.github.com/users/Victorystick/orgs","repos_url":"https://api.github.com/users/Victorystick/repos","events_url":"https://api.github.com/users/Victorystick/events{/privacy}","received_events_url":"