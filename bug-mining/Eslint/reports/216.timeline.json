`\ndoSomething(function (err) {\n  doSomethingElse(function (err) {\n    // ...\n  });\n});\n```\n\nHere, the `no-shadow` rule complains about the second `err` shadowing the first one, but IMHO this is perfectly fine and common in Node.js programming.\n\nWhat do you think about this?\n","reactions":{"url":"https://api.github.com/repos/eslint/eslint/issues/1613/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/eslint/eslint/issues/1613/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":234676382,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDIzNDY3NjM4Mg==","url":"https://api.github.com/repos/eslint/eslint/issues/events/234676382","actor":{"login":"Holixus","id":1699159,"node_id":"MDQ6VXNlcjE2OTkxNTk=","avatar_url":"https://avatars.githubusercontent.com/u/1699159?v=4","gravatar_id":"","url":"https://api.github.com/users/Holixus","html_url":"https://github.com/Holixus","followers_url":"https://api.github.com/users/Holixus/followers","following_url":"https://api.github.com/users/Holixus/following{/other_user}","gists_url":"https://api.github.com/users/Holixus/gists{/gist_id}","starred_url":"https://api.github.com/users/Holixus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Holixus/subscriptions","organizations_url":"https://api.github.com/users/Holixus/orgs","repos_url":"https://api.github.com/users/Holixus/repos","events_url":"https://api.github.com/users/Holixus/events{/privacy}","received_events_url":"https://api.github.com/users/Holixus/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"1e9352e7f8047d4d57bb501be823164581373ceb","commit_url":"https://api.github.com/repos/Holixus/eslint/commits/1e9352e7f8047d4d57bb501be823164581373ceb","created_at":"2015-02-12T13:53:52Z","performed_via_github_app":null},{"id":1461446973,"node_id":"MDExOkxv