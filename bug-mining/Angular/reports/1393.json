    at new RuntimeError (/turbo_modules/@angular/core@11.2.7/__ivy_ngcc__/bundles/core.umd.js:450)\r\n    at throwMultipleComponentError (/turbo_modules/@angular/core@11.2.7/__ivy_ngcc__/bundles/core.umd.js:7060)\r\n    at findDirectiveDefMatches (/turbo_modules/@angular/core@11.2.7/__ivy_ngcc__/bundles/core.umd.js:10779)\r\n    at resolveDirectives (/turbo_modules/@angular/core@11.2.7/__ivy_ngcc__/bundles/core.umd.js:10593)\r\n    at elementStartFirstCreatePass (/turbo_modules/@angular/core@11.2.7/__ivy_ngcc__/bundles/core.umd.js:15245)\r\n    at Object.ɵɵelementStart (/turbo_modules/@angular/core@11.2.7/__ivy_ngcc__/bundles/core.umd.js:15282)\r\n    at AppComponent_gmat_card_0_Template (/~/src/app/app.component.ts:10)\r\n    at executeTemplate (/turbo_modules/@angular/core@11.2.7/__ivy_ngcc__/bundles/core.umd.js:10035)\r\n    at renderView (/turbo_modules/@angular/core@11.2.7/__ivy_ngcc__/bundles/core.umd.js:9842)\r\n    at TemplateRef.createEmbeddedView (/turbo_modules/@angular/core@11.2.7/__ivy_ngcc__/bundles/core.umd.js:23531)\r\n</code></pre>\r\n\r\n\r\n## 🌍  Your Environment\r\n\r\n**Angular Version:**\r\nAngular packages v11.2.7\r\n\r\n**Anything else relevant?**\r\nThis error was originally reported internally in Google and in local tests the DI error was not present at all, making the whole situation even more confusing.\r\n","closed_by":{"login":"atscott","id":479713,"node_id":"MDQ6VXNlcjQ3OTcxMw==","avatar_url":"https://avatars.githubusercontent.com/u/479713?v=4","gravatar_id":"","url":"https://api.github.com/users/atscott","html_url":"https://github.com/atscott","followers_url":"https://api.github.com/users/atscott/followers","following_url":"https://api.github.com/users/atscott/following{/other_user}","gists_url":"https://api.github.com/users/atscott/gists{/gist_id}","starred_url":"https://api.github.com/users/atscott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/atscott/subscriptions","organizations_url":"https://api.github