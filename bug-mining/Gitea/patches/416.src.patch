-
-  const findLineBreak = function (row) {
-    if (!row) {
-      return -1;
-    }
-
-    let i = row.length;
-
-    while (i--
-    && !(row[i - 1] && row[i - 2] && row[i] === ' ' && row[i - 1] === '|' && row[i - 2] === '_'));
-
-    return i;
-  };
