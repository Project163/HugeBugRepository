rich/gists{/gist_id}","starred_url":"https://api.github.com/users/lukasjuhrich/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lukasjuhrich/subscriptions","organizations_url":"https://api.github.com/users/lukasjuhrich/orgs","repos_url":"https://api.github.com/users/lukasjuhrich/repos","events_url":"https://api.github.com/users/lukasjuhrich/events{/privacy}","received_events_url":"https://api.github.com/users/lukasjuhrich/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-07-20T22:19:06Z","updated_at":"2021-07-20T22:19:06Z","body":"To add to that, in my [real-world query](https://github.com/agdsn/pycroft/blob/da4864f4d9b309f511e12a6dd42c7d276e1dfa36/pycroft/lib/user_deletion.py#L32..L63) I'm using the `func`s in a CTE-select, and then the actual entities in the outer select just pass these values through.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/883743970/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"lukasjuhrich","id":10060406,"node_id":"MDQ6VXNlcjEwMDYwNDA2","avatar_url":"https://avatars.githubusercontent.com/u/10060406?v=4","gravatar_id":"","url":"https://api.github.com/users/lukasjuhrich","html_url":"https://github.com/lukasjuhrich","followers_url":"https://api.github.com/users/lukasjuhrich/followers","following_url":"https://api.github.com/users/lukasjuhrich/following{/other_user}","gists_url":"https://api.github.com/users/lukasjuhrich/gists{/gist_id}","starred_url":"https://api.github.com/users/lukasjuhrich/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lukasjuhrich/subscriptions","organizations_url":"https://api.github.com/users/lukasjuhrich/orgs","repos_url":"https://api.github.com/users/lukasjuhrich/repos","events_url":"https://api.github.com/users/lukasjuhrich/events{/privacy}","received_events_url":"https://api.github.com/users/lukasjuhrich/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/883830250","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/6769#issuecomment-883830250","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/6769","id":883830250,"node_id":"IC_kwDOCX5JB840ri3q","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-07-21T02:10:34Z","updated_at":"2021-07-21T02:10:34Z","body":"Ok that's an odd pattern that looks like it is resulting in a bug of some kind. Thats what we need in order to fix issues .  I'll have a look to see if it reproduces tomorrow.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/883830250/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/884354304","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/6769#issuecomment-884354304","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/6769","id":884354304,"node_id":"IC_kwDOCX5JB840ti0A","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-07-21T17:15:07Z","updated_at":"2021-07-21T17:15:07Z","body":"the issue is that the function being returned has no return datatype, and at the moment our own \"NullType\" has \"hashable=False\", which is incorrect as you can certainly hash None, so that's the bug.  additionally, the ORM implicitly using id() for non-hashable scalar columns seems like some old historical artifact, so I think this should be a deprecated behavior that emits a warning for now and will later raise an error if a truly non-hashable datatype is present in the row (such as JSON or ARRAY withotu using tuple).\r\n\r\nassign a type to your function to work around for now, which seems to be \"String\" in this example:\r\n\r\n    result = s.execute(select(union, union.data, union.date, func.abs(union.date, type_=String)))\r\n\r\n\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/884354304/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":5051773391,"node_id":"MDE3OlJlbmFtZWRUaXRsZUV2ZW50NTA1MTc3MzM5MQ==","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/5051773391","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2021-07-21T18:00:28Z","rename":{"from":"apparent mis-assignment of dedupe filters for ORM rows","to":"deprecate implicit use of id() for non hashable and emit warning; make NullType hashable"},"performed_via_github_app":null},{"id":5051774234,"node_id":"MDE0OlVubGFiZWxlZEV2ZW50NTA1MTc3NDIzNA==","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/5051774234","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.g