id integer NOT NULL,\n  grade double precision,\n  CONSTRAINT tests_pkey PRIMARY KEY (id),\n  CONSTRAINT tests_group_id_fkey FOREIGN KEY (group_id)\n      REFERENCES groups (id) MATCH SIMPLE\n      ON UPDATE NO ACTION ON DELETE NO ACTION,\n  CONSTRAINT tests_user_id_fkey FOREIGN KEY (user_id)\n      REFERENCES users (id) MATCH SIMPLE\n      ON UPDATE NO ACTION ON DELETE NO ACTION,\n  CONSTRAINT tests_unique_key UNIQUE (user_id, group_id)\n)\nWITH (\n  OIDS=FALSE\n);\n\n-- Index: tests_problem\n\nCREATE INDEX tests_problem\n  ON tests\n  USING btree\n  (group_id, grade NULLS FIRST);\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/165054678/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"beecrowd","id":5201116,"node_id":"MDQ6VXNlcjUyMDExMTY=","avatar_url":"https://avatars.githubusercontent.com/u/5201116?v=4","gravatar_id":"","url":"https://api.github.com/users/beecrowd","html_url":"https://github.com/beecrowd","followers_url":"https://api.github.com/users/beecrowd/followers","following_url":"https://api.github.com/users/beecrowd/following{/other_user}","gists_url":"https://api.github.com/users/beecrowd/gists{/gist_id}","starred_url":"https://api.github.com/users/beecrowd/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beecrowd/subscriptions","organizations_url":"https://api.github.com/users/beecrowd/orgs","repos_url":"https://api.github.com/users/beecrowd/repos","events_url":"https://api.github.com/users/beecrowd/events{/privacy}","received_events_url":"https://api.github.com/users/beecrowd/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":494272431,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDQ5NDI3MjQzMQ==","url":"https://api.github.com/repos/cakephp/cakephp/issues/events/494272431","actor":{"login":"markstory","id":24086