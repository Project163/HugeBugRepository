+BOOL isValidTextUnicode(NSEvent* event)
+{
+    if ([event keyCode] == 0x35) { // Escape
+        return false;
+    } else if ([[event characters] length] > 0) {
+        unichar code = [[event characters] characterAtIndex:0];
+        return code < 0xF700 || code > 0xF8FF;
+    } else {
+        return true;
+    }
+}
 
