+/**
+ * Convert a column list into a clean array.
+ *
+ * @param string $columns comma separated column list.
+ * @return array
+ */
+	protected function _convertColumnList($columns) {
+		$columns = explode(', ', $columns);
+		foreach ($columns as &$column) {
+			$column = trim($column, '"');
+		}
+		return $columns;
+	}
