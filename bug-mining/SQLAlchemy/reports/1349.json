:50Z","updated_at":"2022-10-24T16:18:38Z","closed_at":"2022-10-24T16:18:37Z","author_association":"MEMBER","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Discussed in https://github.com/sqlalchemy/sqlalchemy/discussions/8702\r\n\r\nsince we are emphasizing this loader, we should see if we can make this case work:\r\n\r\n```py\r\nfrom sqlalchemy import Column\r\nfrom sqlalchemy import ForeignKey\r\nfrom sqlalchemy import Integer\r\nfrom sqlalchemy import String\r\nfrom sqlalchemy import create_engine\r\nfrom sqlalchemy import select\r\nfrom sqlalchemy.orm import Session\r\nfrom sqlalchemy.orm import column_property\r\nfrom sqlalchemy.orm import declarative_base\r\n\r\n\r\nBase = declarative_base()\r\n\r\n\r\nclass TypeTable(Base):\r\n    __tablename__ = 'type'\r\n\r\n    id = Column(Integer, primary_key=True)\r\n    name = Column(String)\r\n\r\n\r\nclass PolyBase(Base):\r\n    __tablename__ = 'base'\r\n\r\n    id = Column(Integer, primary_key=True)\r\n    type_id = Column(ForeignKey(TypeTable.id))\r\n\r\n    # polymorphic = column_property(\r\n    #       select(TypeTable.name)\r\n    #        .where(TypeTable.id == type_id)\r\n    #        .scalar_subquery()\r\n    # )\r\n    __mapper_args__ = { \r\n        # works\r\n        # 'polymorphic_on': polymorphic,\r\n\r\n        # fails\r\n        'polymorphic_on':select(TypeTable.name)\r\n            .where(TypeTable.id == type_id)\r\n            .scalar_subquery()\r\n\r\n    }\r\n\r\n\r\nclass Foo(PolyBase):\r\n    __tablename__ = 'foo'\r\n    __mapper_args__ = {\r\n        'polymorphic_identity': 'foo',\r\n        'polymorphic_load': 'selectin',\r\n    }\r\n\r\n    id = Column(ForeignKey(PolyBase.id), primary_key=True)\r\n\r\n\r\nengine = create_engine('sqlite://', echo=True)\r\nBase.metadata.create_all(engine)\r\n\r\nwith Session(engine) as session:\r\n    foo_type = TypeTable(name='foo')\r\n    session.add(foo_type)\r\n    session.commit()\r\n    session.refresh(foo_type)\r\n\r\n    foo = Foo(type_id=foo_type.id)\r\n    session.add(foo)\r\n\r\n    print(session.execute(select(PolyBase)).scalars().all())\r\n```","closed_by":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/8704/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/8704/timeline","performed_via_github_app":null,"state_reason":"completed"}