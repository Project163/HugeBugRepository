id":7462919,"node_id":"MDQ6VXNlcjc0NjI5MTk=","avatar_url":"https://avatars.githubusercontent.com/u/7462919?v=4","gravatar_id":"","url":"https://api.github.com/users/mirandole","html_url":"https://github.com/mirandole","followers_url":"https://api.github.com/users/mirandole/followers","following_url":"https://api.github.com/users/mirandole/following{/other_user}","gists_url":"https://api.github.com/users/mirandole/gists{/gist_id}","starred_url":"https://api.github.com/users/mirandole/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mirandole/subscriptions","organizations_url":"https://api.github.com/users/mirandole/orgs","repos_url":"https://api.github.com/users/mirandole/repos","events_url":"https://api.github.com/users/mirandole/events{/privacy}","received_events_url":"https://api.github.com/users/mirandole/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-06-15T15:15:27Z","updated_at":"2017-06-15T15:29:32Z","body":"Hi !\r\n\r\nDid you find an alternate way to play flac on devices that get white noise when playing a flac track ?\r\n\r\nI have a device that play flac track but it's just white noise and I don't know how to detect if the device will play nicely flac file or if it won't.\r\n\r\nI know that there is Vanilla Player on GIT that play flac nicely. Unfortunately, it's an GPL licence project, not an Apache2 one.\r\n\r\n---------------------------------------------------------------------------------------------------------------\r\n\r\nedit :\r\n\r\nThis code solve my issue with this device :\r\n\r\n`@Override\r\npublic MediaCodecInfo getDecoderInfo(String mimeType, boolean requiresSecureDecoder)\r\n                throws MediaCodecUtil.DecoderQueryException {\r\n            if (mimeType.equals(\"audio/raw\")) {\r\n                return MediaCodecInfo.newInstance(\"OMX.google.raw.decoder\", \"audio/raw\", null);\r\n            }\r\n            return MediaCodecUtil.getDecoderInfo(mimeType, requiresSecureDecoder);\r\n }`\r\n\r\nSource : https://github.com/google/ExoPlayer/issues/2873\r\n\r\nThank you","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/308769485/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"mirandole","id":7462919,"node_id":"MDQ6VXNlcjc0NjI5MTk=","avatar_url":"https://avatars.githubusercontent.com/u/7462919?v=4","gravatar_id":"","url":"https://api.github.com/users/mirandole","html_url":"https://github.com/mirandole","followers_url":"https://api.github.com/users/mirandole/followers","following_url":"https://api.github.com/users/mirandole/following{/other_user}","gists_url":"https://api.github.com/users/mirandole/gists{/gist_id}","starred_url":"https://api.github.com/users/mirandole/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mirandole/subscriptions","organizations_url":"https://api.github.com/users/mirandole/orgs","repos_url":"https://api.github.com/users/mirandole/repos","events_url":"https://api.github.com/users/mirandole/events{/privacy}","received_events_url":"https://api.github.com/users/mirandole/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1142171671,"node_id":"MDExOkxvY2tlZEV2ZW50MTE0MjE3MTY3MQ==","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/1142171671","actor":{"login":"google","id":1342004,"node_id":"MDEyOk9yZ2FuaXphdGlvbjEzNDIwMDQ=","avatar_url":"https://avatars.githubusercontent.com/u/1342004?v=4","gravatar_id":"","url":"https://api.github.com/users/google","html_url":"https://github.com/google","followers_url":"https://api.github.com/users/google/followers","following_url":"https://api.github.com/users/google/following{/other_user}","gists_url":"https://api.github.com/users/google/gists{/gist_id}","starred_url":"https://api.github.com/users/google/