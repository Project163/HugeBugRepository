":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"repository":{"id":105944401,"node_id":"MDEwOlJlcG9zaXRvcnkxMDU5NDQ0MDE=","name":"yugabyte-db","full_name":"yugabyte/yugabyte-db","private":false,"owner":{"login":"yugabyte","id":17074854,"node_id":"MDEyOk9yZ2FuaXphdGlvbjE3MDc0ODU0","avatar_url":"https://avatars.githubusercontent.com/u/17074854?v=4","gravatar_id":"","url":"https://api.github.com/users/yugabyte","html_url":"https://github.com/yugabyte","followers_url":"https://api.github.com/users/yugabyte/followers","following_url":"https://api.github.com/users/yugabyte/following{/other_user}","gists_url":"https://api.github.com/users/yugabyte/gists{/gist_id}","starred_url":"https://api.github.com/users/yugabyte/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yugabyte/subscriptions","organizations_url":"https://api.github.com/users/yugabyte/orgs","repos_url":"https://api.github.com/users/yugabyte/repos","events_url":"https://api.github.com/users/yugabyte/events{/privacy}","received_events_url":"https://api.github.com/users/yugabyte/received_events","type":"Organization","user_view_type":"public","site_admin":false},"html_url":"https://github.com/yugabyte/yugabyte-db","description":"YugabyteDB - the cloud native distributed SQL database for mission-critical applications.","fork":false,"url":"https://api.github.com/repos/yugabyte/yugabyte-db","forks_url":"https://api.github.com/repos/yugabyte/yugabyte-db/forks","keys_url":"https://api.github.com/repos/yugabyte/yugabyte-db/keys{/key_id}","collaborators_url":"https://api.github.com/repos/yugabyte/yugabyte-db/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/yugabyte/yugabyte-db/teams","hooks_url":"https://api.github.com/repos/yugabyte/yugabyte-db/hooks","issue_events_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events{/number}","events_url":"https://api.github.com/repos/yugabyte/yugabyte-db/events","assignees_url":"https://api.github.com/repos/yugabyte/yugabyte-db/assignees{/user}","branches_url":"https://api.github.com/repos/yugabyte/yugabyte-db/branches{/branch}","tags_url":"https://api.github.com/repos/yugabyte/yugabyte-db/tags","blobs_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/refs{/sha}","trees_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/trees{/sha}","statuses_url":"https://api.github.com/repos/yugabyte/yugabyte-db/statuses/{sha}","languages_url":"https://api.github.com/repos/yugabyte/yugabyte-db/languages","stargazers_url":"https://api.github.com/repos/yugabyte/yugabyte-db/stargazers","contributors_url":"https://api.github.com/repos/yugabyte/yugabyte-db/contributors","subscribers_url":"https://api.github.com/repos/yugabyte/yugabyte-db/subscribers","subscription_url":"https://api.github.com/repos/yugabyte/yugabyte-db/subscription","commits_url":"https://api.github.com/repos/yugabyte/yugabyte-db/commits{/sha}","git_commits_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/commits{/sha}","comments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/comments{/number}","issue_comment_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments{/number}","contents_url":"https://api.github.com/repos/yugabyte/yugabyte-db/contents/{+path}","compare_url":"https://api.github.com/repos/yugabyte/yugabyte-db/compare/{base}...{head}","merges_url":"https://api.github.com/repos/yugabyte/yugabyte-db/merges","archive_url":"https://api.github.com/repos/yugabyte/yugabyte-db/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/yugabyte/yugabyte-db/downloads","issues_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues{/number}","pulls_url":"https://api.github.com/repos/yugabyte/yugabyte-db/pulls{/number}","milestones_url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones{/number}","notifications_url":"https://api.github.com/repos/yugabyte/yugabyte-db/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels{/name}","releases_url":"https://api.github.com/repos/yugabyte/yugabyte-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Jira Link: [DB-3742](https://yugabyte.atlassian.net/browse/DB-3742)\r\n### Description\n\nAs part of the investigation for [TestPgRegressTable failure](https://github.com/yugabyte/yugabyte-db/issues/13884) I found that `yb_pg_alter_table.sql` was facing a fatal error.\r\n\r\nThe crash was introduced from a change which attempts to [improve ALTER TABLE error messages](https://phabricator.dev.yugabyte.com/D12081) (change is applied from v2.7.2).\r\nTaking a look at the change in `yb_pg_alter_table.sql` line 13 - 85, those commands are exactly the same as the commands found in `alter_table.sql` file's line 1506 - 1578.\r\n\r\nThe problem is `alter_table.sql` is a test imported by Yugabot to regress test Postgres specifically. \r\nHowever, by reusing one of their query functions, `txid_current()`, it is causing a fatal crash for YSQL test.\r\nThe error is reproducible in YSQL:\r\n```\r\nselect txid_current();  -- server terminates the connection unexpectedly\r\n```\r\nIt's also reproducible inside transaction that commits:\r\n```\r\nbegin;\r\nselect  txid_current();\r\ntxid_current \r\n--------------\r\n           5\r\n(1 row)\r\ncommit; -- server terminates the connection unexpectedly\r\n```\r\n\r\n\r\nMore specifically, the crash comes from a failed assertion in `procarray.c` inside `ProcArrayEndTransaction function`:\r\n```\r\nTRAP: FailedAssertion(\"!(!((allPgXact[proc->pgprocno].xid) != ((TransactionId) 0)))\", File: \"../../../../../../../src/postgres/src/backend/storage/ipc/procarray.c\", Line: 440)\r\n```\r\nThis function attempts to mark a Postgres transaction as no longer running.\r\nIf the transaction ID passed from the caller is invalid, we first confirm the top-level transaction ID from the global process structure (ProcGlobal) is also invalid -- this is where it fails. \r\n\r\nSince `txid` is a concept used in Postgres and most of the API's used inside `procarray.c` are disabled for Yugabyte mode, we will be disallowing end users from running the `txid_current()` function to avoid this kind of misuse in the first place.\r\n\r\n","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/14144/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/14144/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":7665678601,"node_id":"REFE_lADOBlCVUc5RRfdTzwAAAAHI6PkJ","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/7665678601","actor":{"login":"emhna","id":66644511,"node_id":"MDQ6VXNlcjY2NjQ0NTEx","avatar_url":"https://avatars.githubusercontent.com/u/66644511?v=4","gravatar_id":"","url":"https://api.github.com/users/emhna","html_url":"https://github.com/emhna","followers_url":"https://api.github.com/users/emhna/followers","following_url":"https://api.github.com/users/emhna/following{/other_user}","gists_url":"https://api.github.com/users/emhna/gists{/gist_id}","starred_url":"https://api.github.com/users/emhna/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/emhna/subscriptions","organizations_url":"https://api.github.com/users/emhna/orgs","repos_url":"https://api.github.com/users/emhna/repos","events_url":"https://api.github.com/users/emhna/events{/privacy}","received_events_url":"https://api.github.com/users/emhna/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"d51fbfa1f343d551a64276d61c8489fd45591cf1","commit_url":"https://api.github.com/repos/yugabyte/yugabyte-db/commits/d51fbfa1f343d551a64276d61c8489fd45591cf1","created_at":"2022-10-25T17:18:18Z","performed_via_github_app":null},{"id":7684285282,"node_id":"CE_lADOBlCVUc5RRfdTzwAAAAHKBONi","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/7684285282","actor":{"login":"emhna","id":66644511,"node_id":"MDQ6VXNlcjY2NjQ0NTEx","avatar_url":"https://avatars.githubusercontent.com/u/66644511?v=4","gravatar_id":"","url":"https://api.github.com/users/emhna","html_url":"https://github.com/emhna","followers_url":"https://api.github.com/users/emhna/followers","following_url":"https://api.github.com/users/emhna/following{/other_user}","gists_url":"https://api.git