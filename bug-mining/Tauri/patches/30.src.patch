diff --git a/.changes/js-prompt.md b/.changes/js-prompt.md
new file mode 100644
index 000000000..b592d067e
--- /dev/null
+++ b/.changes/js-prompt.md
@@ -0,0 +1,6 @@
+---
+"tauri": patch
+---
+
+Use native dialog on `window.alert` and `window.confirm`.
+Since every communication with the webview is asynchronous, the `window.confirm` returns a Promise resolving to a boolean value.
diff --git a/cli/tauri.js/templates/tauri.js b/cli/tauri.js/templates/tauri.js
index 842d6c359..e3efca6c1 100644
--- a/cli/tauri.js/templates/tauri.js
+++ b/cli/tauri.js/templates/tauri.js
@@ -247,4 +247,18 @@ if (!String.prototype.startsWith) {
         setNotificationPermission(response ? 'granted' : 'denied')
       }
     })
+
+  window.alert = function (message) {
+    window.__TAURI_INVOKE_HANDLER__({
+      cmd: 'messageDialog',
+      message: message
+    })
+  }
+
+  window.confirm = function (message) {
+    return window.__TAURI__.promisified({
+      cmd: 'askDialog',
+      message: message
+    })
+  }
 })()
