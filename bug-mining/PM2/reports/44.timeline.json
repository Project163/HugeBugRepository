avaScript","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":2672,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1077,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["command-line","command-line-tool","deploy","load-balancer","monitoring","node","nodejs","pm2","process-manager","production"],"visibility":"public","forks":2672,"open_issues":1077,"watchers":42794,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"<!--\r\n    Thank you for contributing to PM2!\r\n\r\n    About a new issue, please check that there is no duplicate:\r\n         https://github.com/Unitech/pm2/search?type=Issues\r\n\r\n    If not please fill out the following questions:\r\n-->\r\n\r\n**What's going wrong?**\r\nPm2 on docker fail to load ecosystem.config.js\r\n\r\n```\r\n/app # pm2 start ecosystem.config.js\r\n[PM2][WARN] Applications api, mqtt not running, starting...\r\n[PM2] Process config loading failed []\r\n[PM2] Process config loading failed []\r\n┌──────────┬────┬──────┬─────┬────────┬─────────┬────────┬─────┬─────┬──────────┐\r\n│ App name │ id │ mode │ pid │ status │ restart │ uptime │ cpu │ mem │ watching │\r\n└──────────┴────┴──────┴─────┴────────┴─────────┴────────┴─────┴─────┴──────────┘\r\n Use `pm2 show <id|name>` to get more details about an app\r\n```\r\n\r\n**How could we reproduce this issue?**\r\n\r\n\r\nUsing this config ...\r\n\r\n```\r\nconst nodeEnv = process.env.NODE_ENV || 'development';\r\n\r\nif (nodeEnv === 'development') {\r\n  require('dotenv').config();\r\n}\r\n\r\nconst maxMemory = process.env.WEB_MEMORY || 80;\r\n\r\nconst base = {\r\n  source_map_support: nodeEnv !== 'production',\r\n  node_args: [\r\n    '--optimize_for_size',\r\n    '--max_old_space_size=400',\r\n    '--gc_interval=100',\r\n  ],\r\n  instances: process.env.WEB_CONCURRENCY || -1,\r\n  exec_mode: nodeEnv === 'production' ? 'cluster' : 'fork',\r\n  max_memory_restart: `${maxMemory}M`,\r\n};\r\n\r\nmodule.exports = {\r\n  apps: [\r\n    Object.assign({}, {\r\n      name: 'api',\r\n      script: 'api/index.js',\r\n      env: {\r\n        NODE_ENV: nodeEnv,\r\n        PORT: process.env.PORT || 3000,\r\n        API_MONGO_URL: process.env.API_MONGO_URL,\r\n        MAILGUN_API: process.env.MAILGUN_API,\r\n        MAILGUN_DOMAIN: process.env.MAILGUN_DOMAIN,\r\n        MAILGUN_FROM: process.env.MAILGUN_FROM,\r\n        JWT_SECRET: process.env.JWT_SECRET,\r\n        SALT_WORK_FACTOR: process.env.SALT_WORK_FACTOR,\r\n      },\r\n      env_production: {\r\n        NODE_ENV: \"production\",\r\n      },\r\n    }, base),\r\n    Object.assign({}, {\r\n      name: 'mqtt',\r\n      script: 'mqtt/mqtt.babel.js',\r\n      env: {\r\n        NODE_ENV: nodeEnv,\r\n        MQTT_PORT: process.env.MQTT_PORT || 1886,\r\n        MQTT_HOST: process.env.MQTT_HOST || `mqtt://localhost:${1886}`,\r\n        MQTT_MONGO_URL: process.env.MQTT_MONGO_URL || 'mongodb://localhost/mqtt',\r\n        MQTT_HTTP_PORT: process.env.MQTT_HTTP_PORT || 9001,\r\n      },\r\n      env_production: {\r\n        NODE_ENV: \"production\",\r\n      },\r\n    }, base),\r\n  ],\r\n};\r\n```\r\n\r\nAfter build this docker ...\r\n\r\n```\r\nFROM keymetrics/pm2-docker-alpine:7\r\n\r\nARG NODE=production\r\n\r\nENV NODE_ENV $NODE\r\nENV MQTT_PORT 1886\r\nENV MQTT_HTTP_PORT 9001\r\nENV PORT 3000\r\n\r\n## Update\r\nRUN apk update && \\\r\n    apk upgrade && \\\r\n    apk add \\\r\n      git \\\r\n      bash\r\n\r\n# Update pm2\r\nRUN npm install pm2@2.5.0 -g\r\n\r\n# Add DockerCompose\r\nRUN apk add make py-pip && pip install docker-compose\r\n\r\nCOPY . ./\r\n\r\nEXPOSE $MQTT_PORT $MQTT_HTTP_PORT $MQTT_HTTP_PORT\r\n\r\nCMD pm2-docker ecosystem.config.js --env $NODE_ENV\r\n```\r\n\r\nWhen I enter into container and try manual start the process..\r\n\r\n```\r\n/app # pm2 start ecosystem.config.js\r\n[PM2][WARN] Applications api, mqtt not running, starting...\r\n[PM2] Process config loading failed []\r\n[PM2] Process config loading failed []\r\n┌──────────┬────┬──────┬─────┬────────┬─────────┬────────┬─────┬─────┬──────────┐\r\n│ App name │ id │ mode │ pid │ status │ restart │ uptime │ cpu │ mem │ watching │\r\n└──────────┴────┴──────┴─────┴────────┴─────────┴────────┴─────┴─────┴──────────┘\r\n Use `pm2 show <id|name>` to get more details about an app\r\n```\r\n\r\n\r\n## Supporting information\r\n\r\n```\r\n/app # uname -a\r\nLinux 6320bf95d141 4.4.66-boot2docker #1 SMP Fri May 5 20:44:25 UTC 2017 x86_64 Linux\r\n/app # node -v\r\nv7.10.0\r\n/app # pm2 -v\r\n2.5.0\r\n```\r\n","reactions":{"url":"https://api.github.com/repos/Unitech/pm2/issues/2964/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Unitech/pm2/issues/2964/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/Unitech/pm2/issues/comments/316642868","html_url":"https://github.com/Unitech/pm2/issues/2953#issuecomment-316642868","issue_url":"https://api.github.com/repos/Unitech/pm2/issues/2953","id":316642868,"node_id":"MDEyOklzc3VlQ29tbWVudDMxNjY0Mjg2OA==","user":{"login":"Unitech","id":757747,"node_id":"MDQ6VXNlcjc1Nzc0Nw==","avatar_url":"https://avatars.githubusercontent.com/u/757747?v=4","gravatar_id":"","url":"https://api.github.com/users/Unitech","html_url":"https://github.com/Unitech","followers_url":"https://api.github.com/users/Unitech/followers","following_url":"https://api.github.com/users/Unitech/following{/other_user}","gists_url":"https://api.github.com/users/Unitech/gists{/gist_id}","starred_url":"https://api.github.com/users/Unitech/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/us