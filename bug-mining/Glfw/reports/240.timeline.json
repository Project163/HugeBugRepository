               //       Corresponding release events are filtered out\r\n                 //       implicitly by the GLFW key repeat logic\r\n-                if (window->x11.lastKeyTime < event->xkey.time)\r\n-                {\r\n-                    if (keycode)\r\n-                        _glfwInputKey(window, key, keycode, GLFW_PRESS, mods);\r\n \r\n-                    window->x11.lastKeyTime = event->xkey.time;\r\n-                }\r\n+                //if (window->x11.lastKeyTime < event->xkey.time)\r\n+                //{\r\n+                //    if (keycode)\r\n+                //        _glfwInputKey(window, key, keycode, GLFW_PRESS, mods);\r\n+                //\r\n+                //    window->x11.lastKeyTime = event->xkey.time;\r\n+                //}\r\n+                _glfwInputKey(window, key, keycode, GLFW_PRESS, mods);\r\n \r\n                 if (!filtered)\r\n                 {\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/glfw/glfw/issues/comments/452462977/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zlsa","id":6366062,"node_id":"MDQ6VXNlcjYzNjYwNjI=","avatar_url":"https://avatars.githubusercontent.com/u/6366062?v=4","gravatar_id":"","url":"https://api.github.com/users/zlsa","html_url":"https://github.com/zlsa","followers_url":"https://api.github.com/users/zlsa/followers","following_url":"https://api.github.com/users/zlsa/following{/other_user}","gists_url":"https://api.github.com/users/zlsa/gists{/gist_id}","starred_url":"https://api.github.com/users/zlsa/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zlsa/subscriptions","organizations_url":"https://api.github.com/users/zlsa/orgs","repos_url":"https://api.github.com/users/zlsa/repos","events_url":"https://api.github.com/users/zlsa/events{/privacy}","received_events_url":"https://api.github.com/u