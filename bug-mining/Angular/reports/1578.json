crisbeto/orgs","repos_url":"https://api.github.com/users/crisbeto/repos","events_url":"https://api.github.com/users/crisbeto/events{/privacy}","received_events_url":"https://api.github.com/users/crisbeto/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Which @angular/* package(s) are the source of the bug?\n\ncore\n\n### Is this a regression?\n\nNo\n\n### Description\n\nStandalone migration's `prune-ng-modules` doesn't update imports properly when the pruned NgModule is referenced by a standalone component.\r\n\r\nThe following code:\r\n```ts\r\n@Component({\r\n  standalone: true,\r\n  template: `<app-child/>`,\r\n  imports: [ChildModule]\r\n})\r\nclass App {\r\n}\r\n\r\n@Component({\r\n  selector: 'app-child',\r\n  standalone: true,\r\n  template: `...`,\r\n})\r\nclass Child {\r\n}\r\n\r\n@NgModule({\r\n  imports: [Child],\r\n  exports: [Child]\r\n})\r\nclass ChildModule {}\r\n```\r\n\r\nproduces:\r\n\r\n```ts\r\n@Component({\r\n  standalone: true,\r\n  template: `<app-child/>`,\r\n  imports: []\r\n})\r\nclass App {\r\n}\r\n\r\n@Component({\r\n  selector: 'app-child',\r\n  standalone: true,\r\n  template: `...`,\r\n})\r\nclass Child {\r\n}\r\n```\r\n\r\nand breaks the app, while it should produce:\r\n\r\n\r\n```ts\r\n@Component({\r\n  standalone: true,\r\n  template: `<app-child/>`,\r\n  imports: [Child]\r\n})\r\nclass App {\r\n}\r\n\r\n@Component({\r\n  selector: 'app-child',\r\n  standalone: true,\r\n  template: `...`,\r\n})\r\nclass Child {\r\n}\r\n```\r\n\n\n### Please provide a link to a minimal reproduction of the bug\n\nhttps://github.com/yjaaidi/experiments/tree/repro-prune-ng-modules-standalone\n\n### Please provide the exception or error you saw\n\n_No response_\n\n### Please provide the environment you discovered this bug in (run `ng version`)\n\n```true\nAngular CLI: 16.2.0\r\nNode: 20.0.0 (Unsupported)\r\nPackage Manager: pnpm 8.6.2\r\nOS: darwin x64\r\n\r\nAngular: 16.2.0\r\n... animations, cli, common, compiler, compiler-cli, core, forms\r\n... platform-browser, platform-browser-dynamic, router\r\n\r\nPackage                         Version\r\n---------------------------------------------------------\r\n@angular-devkit/architect       0.1602.0\r\n@angular-devkit/build-angular   16.2.0\r\n@angular-devkit/core            16.2.0\r\n@angular-devkit/schematics      16.2.0\r\n@schematics/angular             16.2.0\r\nrxjs                            7.8.0\r\ntypescript                      5.1.3\r\nzone.js                         0.13.0\n```\n\n\n### Anything else?\n\n_No response_","closed_by":{"login":"thePunderWoman","id":1596273,"node_id":"MDQ6VXNlcjE1OTYyNzM=","avatar_url":"https://avatars.githubusercontent.com/u/1596273?v=4","gravatar_id":"","url":"https://api.github.com/users/thePunderWoman","html_url":"https://github.com/thePunderWoman","followers_url":"https://api.github.com/users/thePunderWoman/followers","following_url":"https://api.github.com/users/thePunderWoman/following{/other_user}","gists_url":"https://api.github.com/users/thePunderWoman/gists{/gist_id}","starred_url":"https://api.github.com/users/thePunderWoman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thePunderWoman/subscriptions","organizations_url":"https://api.github.com/users/thePunderWoman/orgs","repos_url":"https://api.github.com/users/thePunderWoman/repos","events_url":"https://api.github.com/users/thePunderWoman/events{/privacy}","received_events_url":"https://api.github.com/users/thePunderWoman/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/51420/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"ro