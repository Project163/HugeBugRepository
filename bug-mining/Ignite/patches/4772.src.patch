diff --git a/modules/extdata/p2p/src/main/java/org/apache/ignite/tests/p2p/cache/OddEvenCacheInterceptor.java b/modules/extdata/p2p/src/main/java/org/apache/ignite/tests/p2p/cache/OddEvenCacheInterceptor.java
