\\\\PuTTY\\\\PLINK.EXE\\\" -l username -i C:\\\\id_rsa.ppk \"\r\n```\r\n\n\noriginal issue: https://github.com/neovim/neovim/issues/13256","reactions":{"url":"https://api.github.com/repos/saccarosium/netrw.vim/issues/82/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/saccarosium/netrw.vim/issues/82/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"}]