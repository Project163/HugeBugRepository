i.github.com/repos/bazelbuild/bazel/downloads","issues_url":"https://api.github.com/repos/bazelbuild/bazel/issues{/number}","pulls_url":"https://api.github.com/repos/bazelbuild/bazel/pulls{/number}","milestones_url":"https://api.github.com/repos/bazelbuild/bazel/milestones{/number}","notifications_url":"https://api.github.com/repos/bazelbuild/bazel/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/bazelbuild/bazel/labels{/name}","releases_url":"https://api.github.com/repos/bazelbuild/bazel/releases{/id}","deployments_url":"https://api.github.com/repos/bazelbuild/bazel/deployments","created_at":"2014-06-12T16:00:38Z","updated_at":"2025-12-12T22:36:14Z","pushed_at":"2025-12-12T23:00:16Z","git_url":"git://github.com/bazelbuild/bazel.git","ssh_url":"git@github.com:bazelbuild/bazel.git","clone_url":"https://github.com/bazelbuild/bazel.git","svn_url":"https://github.com/bazelbuild/bazel","homepage":"https://bazel.build","size":992874,"stargazers_count":24886,"watchers_count":24886,"language":"Java","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":4359,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1819,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["bazel","build","build-system","correct","fast","multi-language","scalable","test"],"visibility":"public","forks":4359,"open_issues":1819,"watchers":24886,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"### Description of the problem / feature request / question:\r\n\r\nI want to use python multiprocessing module in a python test (python3.5), but it fails with OSError: [Error 30] Read-only file system. I think the following is the problem.\r\n\r\nwhen I run bazel test with --sandbox_tmpfs_path=/dev/shm/, I expect os.listdir(\"/dev/shm/\") to return [] and os.mkdir(\"/dev/shm/test\") to succeed (if I understand the --sandbox_tmpfs_path option correctly, it mounts a fresh writable filesystem at given path). however, what I got from os.listdir(\"/dev/shm/\") is the same list of files I got when I run that in a python interpreter without bazel/sandboxing, and os.mkdir(\"/dev/shm/test\") fails with OSError: [Error 30] Read-only file system: \"/dev/shm/test\".\r\n\r\nit seems that --sandbox_tmpfs_path is handling /dev/shm in a special way (maybe because it is already mounted? --sandbox_tmpfs_path /dev/shm seems to have no effect.). --sandbox_tmpfs_path /some/other/path seems to work as expected (i.e. os.listdir(\"/some/other/path\") returns [] and os.mkdir(\"/some/other/path/test\") succeeds).\r\n\r\n### Environment info\r\n* Operating System:\r\nUbuntu 14.04\r\n\r\n* Bazel version (output of `bazel info release`):\r\nrelease 0.4.0\r\n\r\n###  Have you found anything relevant by searching the web? (e.g. GitHub issues, email threads in the [bazel-discuss@googlegroups.com](https://groups.google.com/forum/#!forum/bazel-discuss) archive)\r\nrelated issues #1460 #1973\r\nthe suggestion in #1973 works, but still is the above the correct behavior for --sandbox_tmpfs_path=/dev/shm?\r\n\r\n","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/2056/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bazelbuild/bazel/issues/2056/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":888333809,"node_id":"MDE1Ok1pbGVzdG9uZWRFdmVudDg4ODMzMzgwOQ==","url":"https://api.github.com/repos/bazelbuild/bazel/issues/events/888333809","actor":{"login":"philwo","id":504652,"node_id":"MDQ6VXNlcjUwNDY1Mg==","avatar_url":"https://avatars.githubuser