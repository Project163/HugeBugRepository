hosts: es02\r\n      cluster.initial_master_nodes: es01\r\n      cluster.name: test\r\n      bootstrap.memory_lock: \"true\"\r\n      node.master: \"true\"\r\n      node.data: \"false\"\r\n      ES_JAVA_OPTS: -Xms256m -Xmx256m\r\n    ports:\r\n      - \"9200:9200\"\r\n    volumes:\r\n      - \"es-data-es01:/usr/share/elasticsearch/data\"\r\n    ulimits:\r\n      memlock:\r\n        soft: -1\r\n        hard: -1\r\n  es02:\r\n    image: \"docker.elastic.co/elasticsearch/elasticsearch-oss:7.5.2\"\r\n    environment:\r\n      node.name: es02\r\n      discovery.seed_hosts: es01\r\n      cluster.initial_master_nodes: es01\r\n      cluster.name: test\r\n      bootstrap.memory_lock: \"true\"\r\n      node.master: \"false\"\r\n      node.data: \"true\"\r\n      ES_JAVA_OPTS: -Xms256m -Xmx256m\r\n    volumes:\r\n      - \"es-data-es02:/usr/share/elasticsearch/data\"\r\n    ulimits:\r\n      memlock:\r\n        soft: -1\r\n        hard: -1\r\n    ports:\r\n      - \"9202:9200\"\r\n  es03:\r\n    image: \"docker.elastic.co/elasticsearch/elasticsearch-oss:7.5.2\"\r\n    environment:\r\n      node.name: es03\r\n      discovery.seed_hosts: es01\r\n      cluster.initial_master_nodes: es01\r\n      cluster.name: test\r\n      bootstrap.memory_lock: \"true\"\r\n      node.master: \"false\"\r\n      node.data: \"true\"\r\n      ES_JAVA_OPTS: -Xms256m -Xmx256m\r\n    volumes:\r\n      - \"es-data-es03:/usr/share/elasticsearch/data\"\r\n    ulimits:\r\n      memlock:\r\n        soft: -1\r\n        hard: -1\r\n    ports:\r\n      - \"9203:9200\"\r\n\r\nvolumes:\r\n  es-data-es01:\r\n  es-data-es02:\r\n  es-data-es03:\r\n```\r\n\r\nWith this setup and requesting an alias to the master node I cannot see any `404` and if I query through a data node I get the expected `503` status code with `master_not_discovered_exception` if the request times out (when the master node is down). Could you share more details about the configuration where you experience that behaviour @jamshid? Thanks!","auth