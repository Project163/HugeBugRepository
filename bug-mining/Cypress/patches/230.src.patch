+          <i18n-t
+            scope="global"
+            keypath="runs.empty.description"
+          >
+            <ExternalLink :href="guideUrl">
+              {{ t('runs.empty.link') }}
+            </ExternalLink>
+          </i18n-t>
+        </template>
+        <template #content>
+          <RecordPromptAdapter />
+        </template>
+      </PromoHeader>
+    </template>
+
+    <template #cards="{ step, goForward, reset }">
+      <TourCard
+        v-if="step === 0"
+        :action="goForward"
+      />
+      <GuideCard1
+        v-else-if="step === 1"
+        :action="goForward"
+      />
+      <GuideCard2
+        v-else-if="step === 2"
+        :action="goForward"
+      />
