id":5924452,"node_id":"MDQ6VXNlcjU5MjQ0NTI=","avatar_url":"https://avatars.githubusercontent.com/u/5924452?v=4","gravatar_id":"","url":"https://api.github.com/users/ilinum","html_url":"https://github.com/ilinum","followers_url":"https://api.github.com/users/ilinum/followers","following_url":"https://api.github.com/users/ilinum/following{/other_user}","gists_url":"https://api.github.com/users/ilinum/gists{/gist_id}","starred_url":"https://api.github.com/users/ilinum/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ilinum/subscriptions","organizations_url":"https://api.github.com/users/ilinum/orgs","repos_url":"https://api.github.com/users/ilinum/repos","events_url":"https://api.github.com/users/ilinum/events{/privacy}","received_events_url":"https://api.github.com/users/ilinum/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"ilinum","id":5924452,"node_id":"MDQ6VXNlcjU5MjQ0NTI=","avatar_url":"https://avatars.githubusercontent.com/u/5924452?v=4","gravatar_id":"","url":"https://api.github.com/users/ilinum","html_url":"https://github.com/ilinum","followers_url":"https://api.github.com/users/ilinum/followers","following_url":"https://api.github.com/users/ilinum/following{/other_user}","gists_url":"https://api.github.com/users/ilinum/gists{/gist_id}","starred_url":"https://api.github.com/users/ilinum/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ilinum/subscriptions","organizations_url":"https://api.github.com/users/ilinum/orgs","repos_url":"https://api.github.com/users/ilinum/repos","events_url":"https://api.github.com/users/ilinum/events{/privacy}","received_events_url":"https://api.github.com/users/ilinum/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":9,"created_at":"2022-12-17T17:22:28Z","updated_at":"2025-11-23T22:49:09Z","closed_at":"2025-11-23T22:49:09Z","author_association":"COLLABORATOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**Bug Report**\r\nSmall false-positive I noticed after #14114.\r\nSeems to be a scoping issue with `finally`.\r\n\r\n/CC: @ilinum \r\n\r\n**To Reproduce**\r\n\r\n```python\r\ntry:\r\n    try:\r\n        msg = some_func()\r\n    except Exception:\r\n        raise\r\n\r\n    print(msg)  # Name \"msg\" may be undefined  [possibly-undefined]\r\n\r\nfinally:\r\n    pass\r\n\r\nprint(msg)  # <-- should probably be emitted here\r\n# EDIT: exception is re-raised - no error should be emitted\r\n```\r\n\r\nThe first print will always safely execute since the inner Try block raises. If it throws an uncaught exception, the print will be skipped to the `finally` block and only the second print will execute which would then raise an error itself as `msg` would be undefined.\r\n\r\n**Your Environment**\r\n\r\n<!-- Include as many relevant details about the environment you experienced the bug in -->\r\n\r\n- Mypy version used: `mypy 1.0.0+dev.96ac8b3e71c743b02ea4e3c84da0248659e40f82 (compiled: no)`\r\n- Mypy command-line flags: `--enable-error-code possibly-undefined`\r\n- Python version used: 3.11","closed_by":{"login":"hauntsaninja","id":12621235,"node_id":"MDQ6VXNlcjEyNjIxMjM1","avatar_url":"https://avatars.githubusercontent.com/u/12621235?v=4","gravatar_id":"","url":"https://api.github.com/users/hauntsaninja","html_url":"https://github.com/hauntsaninja","followers_url":"https://api.github.com/users/hauntsaninja/followers","following_url":"https://api.github.com/users/hauntsaninja/following{/other_user}","gists_url":"https://api.github.com/users/hauntsaninja/gists{/gist_id}","starred_url":"https://api.github.com/users/hauntsaninja/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hauntsaninja/subscriptions","organizations_url":"https://api.github.com/users/hauntsaninja/orgs","repos_url":"https://api.github.com/users/hauntsaninja/repos","events_url":"https://api.github.com/users/hauntsaninja/events{/privacy}","received_events_url":"https://api.github.com/users/hauntsaninja/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/python/mypy/issues/14309/reactions","total_count":6,"+1":6,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/mypy/issues/14309/timeline","performed_via_github_app":null,"state_reason":"completed"}