yugabyte-db/issues/events/13267720428","actor":{"login":"ycybfhb","id":166219305,"node_id":"U_kgDOCehOKQ","avatar_url":"https://avatars.githubusercontent.com/u/166219305?v=4","gravatar_id":"","url":"https://api.github.com/users/ycybfhb","html_url":"https://github.com/ycybfhb","followers_url":"https://api.github.com/users/ycybfhb/followers","following_url":"https://api.github.com/users/ycybfhb/following{/other_user}","gists_url":"https://api.github.com/users/ycybfhb/gists{/gist_id}","starred_url":"https://api.github.com/users/ycybfhb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ycybfhb/subscriptions","organizations_url":"https://api.github.com/users/ycybfhb/orgs","repos_url":"https://api.github.com/users/ycybfhb/repos","events_url":"https://api.github.com/users/ycybfhb/events{/privacy}","received_events_url":"https://api.github.com/users/ycybfhb/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2024-06-24T14:51:06Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/2186901158","html_url":"https://github.com/yugabyte/yugabyte-db/issues/22989#issuecomment-2186901158","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/22989","id":2186901158,"node_id":"IC_kwDOBlCVUc6CWXam","user":{"login":"timothy-e","id":26841748,"node_id":"MDQ6VXNlcjI2ODQxNzQ4","avatar_url":"https://avatars.githubusercontent.com/u/26841748?v=4","gravatar_id":"","url":"https://api.github.com/users/timothy-e","html_url":"https://github.com/timothy-e","followers_url":"https://api.github.com/users/timothy-e/followers","following_url":"https://api.github.com/users/timothy-e/following{/other_user}","gists_url":"https://api.github.com/users/timothy-e/gists{/gist_id}","starred_url":"https://api.github.com/users/timothy-e/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timothy-e/subscriptions","organizations_url":"https://api.github.com/users/timothy-e/orgs","repos_url":"https://api.github.com/users/timothy-e/repos","events_url":"https://api.github.com/users/timothy-e/events{/privacy}","received_events_url":"https://api.github.com/users/timothy-e/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-06-24T15:55:38Z","updated_at":"2024-06-24T15:55:38Z","body":"Simpler repro: (`texticregexeq` is the same as `~*`, but easier to grep for in the codebase)\r\n\r\n```sql\r\ncreate table test_texticregex (t text);\r\ninsert into test_texticregex values ('a'), ('b'), (NULL), ('d');\r\nexplain (analyze, costs off, timing off, summary off) select * from test_texticregex where texticregexeq(t, t);\r\n                      QUERY PLAN\r\n------------------------------------------------------\r\n Seq Scan on test_texticregex (actual rows=2 loops=1)\r\n   Storage Filter: texticregexeq(t, t)\r\n(2 rows)\r\n```\r\n\r\nvaries between 1, 2 or 3 rows. \r\n\r\nThere's no consistent row that gets excluded. Every permutation of `a, b, d` is possible. ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/2186901158/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"timothy-e","id":26841748,"node_id":"MDQ6VXNlcjI2ODQxNzQ4","avatar_url":"https://avatars.githubusercontent.com/u/26841748?v=4","gravatar_id":"","url":"https://api.github.com/users/timothy-e","html_url":"https://github.com/timothy-e","followers_url":"https://api.github.com/users/timothy-e/followers","following_url":"https://api.github.com/users/timothy-e/following{/other_user}","gists_url":"https://api.github.com/users/timothy-e/gists{/gist_id}","starred_url":"https://api.github.com/users/timothy-e/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timothy-e/s