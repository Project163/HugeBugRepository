iZWwxNDE5ODIxOTAw","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/priority/medium","name":"priority/medium","color":"ffdc5e","default":false,"description":"Medium priority issue"}],"state":"closed","locked":false,"assignee":{"login":"andrei-mart","id":1223507,"node_id":"MDQ6VXNlcjEyMjM1MDc=","avatar_url":"https://avatars.githubusercontent.com/u/1223507?v=4","gravatar_id":"","url":"https://api.github.com/users/andrei-mart","html_url":"https://github.com/andrei-mart","followers_url":"https://api.github.com/users/andrei-mart/followers","following_url":"https://api.github.com/users/andrei-mart/following{/other_user}","gists_url":"https://api.github.com/users/andrei-mart/gists{/gist_id}","starred_url":"https://api.github.com/users/andrei-mart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andrei-mart/subscriptions","organizations_url":"https://api.github.com/users/andrei-mart/orgs","repos_url":"https://api.github.com/users/andrei-mart/repos","events_url":"https://api.github.com/users/andrei-mart/events{/privacy}","received_events_url":"https://api.github.com/users/andrei-mart/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"andrei-mart","id":1223507,"node_id":"MDQ6VXNlcjEyMjM1MDc=","avatar_url":"https://avatars.githubusercontent.com/u/1223507?v=4","gravatar_id":"","url":"https://api.github.com/users/andrei-mart","html_url":"https://github.com/andrei-mart","followers_url":"https://api.github.com/users/andrei-mart/followers","following_url":"https://api.github.com/users/andrei-mart/following{/other_user}","gists_url":"https://api.github.com/users/andrei-mart/gists{/gist_id}","starred_url":"https://api.github.com/users/andrei-mart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andrei-mart/subscriptions","organizations_url":"https://api.github.com/users/andrei-mart/orgs","repos_url":"https://api.github.com/users/andrei-mart/repos","events_url":"https://api.github.com/users/andrei-mart/events{/privacy}","received_events_url":"https://api.github.com/users/andrei-mart/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":1,"created_at":"2024-03-13T18:27:46Z","updated_at":"2024-04-19T17:24:47Z","closed_at":"2024-04-19T17:24:47Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Jira Link: [DB-10335](https://yugabyte.atlassian.net/browse/DB-10335)\r\n### Description\r\n\r\nMy coworker (JB) discovered this Yugabyte YSQL bug (yugabyte-2.20.1.3for linux-x86_64) and was able to come out the minimal test case (shown below) to demonstrate it:\r\n\r\n\"The IndexScan hint is not really part of the bug itself, but is needed for the test case to get the optimizer to use the index without the partial index filter in the original scenario.  The JSONB column is required to cause the bug.  Normal columns in the index/query do not seem to trigger the issue\" - JB\r\n\r\n*****  test case  starts  ******\r\n```sql\r\ndrop table IF EXISTS t1;\r\ncreate table t1 (\r\nc1 bigint,\r\nc2 jsonb,\r\nprimary key ((c1))\r\n);\r\ninsert into t1 (c1,c2) values (1,'{\"c3\":1,\"c4\":1}');\r\ninsert into t1 (c1,c2) values (2,'{\"c3\":2,\"c4\":2}');\r\ncreate index t1_idx on t1 (\r\n((c2->>'c3'),\r\n(c2->>'c4')) hash\r\n);\r\n```\r\nTable rows:\r\n```sql\r\nselect * from t1;\r\n c1 |         c2         \r\n----+--------------------\r\n  2 | {\"c3\": 2, \"c4\": 2}\r\n  1 | {\"c3\": 1, \"c4\": 1}\r\n(2 rows)\r\n\r\n```\r\nFails by returning rows:\r\n```sql\r\n/*+IndexScan(t1 t1_idx)*/\r\n--explain\r\nselect * from t1\r\nwhere (c2->>'c3') = '4';\r\n\r\nc1 |         c2        \r\n----+--------------------\r\n  2 | {\"c3\": 2, \"c4\": 2}\r\n  1 | {\"c3\": 1, \"c4\": 1}\r\n(2 rows)\r\n\r\n```\r\nWorks correctly:\r\n\r\n```sql\r\n/*+IndexScan(t1 t1_idx)*/\r\n--explain\r\nselect * from t1\r\nwhere (c2->>'c3') = '4'\r\nand (c2->>'c4') = '4';\r\n\r\nc1 | c2\r\n----+----\r\n(0 rows)\r\n```\r\n**** test case ends******\r\n\r\n### Issue Type\r\n\r\nkind/bug\r\n\r\n### Warning: Please confirm that this issue does not contain any sensitive information\r\n\r\n- [X] I confirm this issue does not contain any sensitive information.\r\n\r\n[DB-10335]: https://yugabyte.atlassian.net/browse/DB-10335?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","closed_by":{"login":"andrei-mart","id":1223507,"node_id":"MDQ6VXNlcjEyMjM1MDc=","avatar_url":"https://avatars.githubusercontent.com/u/1223507?v=4","gravatar_id":"","url":"https://api.github.com/users/andrei-mart","html_url":"https://github.com/andrei-mart","followers_url":"https://api.github.com/users/andrei-mart/followers","following_url":"https://api.github.com/users/andrei-mart/following{/other_user}","gists_url":"https://api.github.com/users/andrei-mart/gists{/gist_id}","starred_url":"https://api.github.com/users/andrei-mart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andrei-mart/subscriptions","organizations_url":"https://api.github.com/users/andrei-mart/orgs","repos_url":"https://api.github.com/users/andrei-mart/repos","events_url":"https://api.github.com/users/andrei-mart/events{/privacy}","received_events_url":"https://api.github.com/users/andrei-mart/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/21451/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/21451/timeline","performed_via_github_app":null,"state_reason":"completed"}