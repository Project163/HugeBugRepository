AND (EARNING_GROUP_NAME = &lt;span class=&quot;code-quote&quot;&gt;&apos;Events&apos;&lt;/span&gt;)
AND (EMPLOYEE_ID = &lt;span class=&quot;code-quote&quot;&gt;&apos;0053p000007bEzjAAE&apos;&lt;/span&gt;)
AND (
(lower(CUSTOMER_NAME) like &lt;span class=&quot;code-quote&quot;&gt;&apos;%abb4y000000ggzmcaq%&apos;&lt;/span&gt;)
OR (lower(PRODUCT_NAME) like&lt;span class=&quot;code-quote&quot;&gt;&apos;%abb4y000000ggzmcaq%&apos;&lt;/span&gt;)
OR (
lower(GEOGRAPHY_NAME) like&lt;span class=&quot;code-quote&quot;&gt;&apos;%abb4y000000ggzmcaq%&apos;&lt;/span&gt;
)
OR (lower(ORDER_CODE) like&lt;span class=&quot;code-quote&quot;&gt;&apos;%abb4y000000ggzmcaq%&apos;&lt;/span&gt;)
OR (
lower(ITEM_CODE) like&lt;span class=&quot;code-quote&quot;&gt;&apos;%abb&apos;&lt;/span&gt; 4y000000ggzmcaq % &apos;)
)&lt;/pre&gt;
