, platform-browser-dynamic, router\r\n\r\nPackage                         Version\r\n---------------------------------------------------------\r\n@angular-devkit/architect       0.1500.4\r\n@angular-devkit/build-angular   15.0.4\r\n@angular-devkit/core            15.0.4\r\n@angular-devkit/schematics      15.0.4\r\n@schematics/angular             15.0.4\r\nrxjs                            7.5.7\r\ntypescript                      4.8.4\r\n```\r\n\r\n\r\n### Anything else?\r\n\r\n_No response_","closed_by":{"login":"jessicajaniuk","id":72768744,"node_id":"MDQ6VXNlcjcyNzY4NzQ0","avatar_url":"https://avatars.githubusercontent.com/u/72768744?v=4","gravatar_id":"","url":"https://api.github.com/users/jessicajaniuk","html_url":"https://github.com/jessicajaniuk","followers_url":"https://api.github.com/users/jessicajaniuk/followers","following_url":"https://api.github.com/users/jessicajaniuk/following{/other_user}","gists_url":"https://api.github.com/users/jessicajaniuk/gists{/gist_id}","starred_url":"https://api.github.com/users/jessicajaniuk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jessicajaniuk/subscriptions","organizations_url":"https://api.github.com/users/jessicajaniuk/orgs","repos_url":"https://api.github.com/users/jessicajaniuk/repos","events_url":"https://api.github.com/users/jessicajaniuk/events{/privacy}","received_events_url":"https://api.github.com/users/jessicajaniuk/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/48524/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/angular/angular/issues/48524/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}