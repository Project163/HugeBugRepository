[{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/71238903","html_url":"https://github.com/google/ExoPlayer/issues/262#issuecomment-71238903","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/262","id":71238903,"node_id":"MDEyOklzc3VlQ29tbWVudDcxMjM4OTAz","user":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-01-23T18:23:27Z","updated_at":"2015-01-23T18:23:27Z","body":"As you've observed, we already handle indefinite live streams where the MPD doesn't need to be updated. The case you describe is different because, although it's a live broadcast, you already know the fixed duration of the broadcast.\n\nOne caveat that applies to both cases is that use of availabilityStartTime only works if the device can get a pretty accurate estimate of the server-side clock. Unless you want to assume that the device clock is accurate, this means a UtcTiming element needs to be present in the manifest (we don't currently use it, but will do soon - it's pretty easy to wire it up). Do you include such an element?\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/71238903/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":223866664,"node_id":"MDEyOkxhYmVsZWRFdmVudDIyMzg2NjY2NA==","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/223866664","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2015-01-23T18:23:32Z","label":{"name":"bug","color":"fc2929"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/71372996","html_url":"https://github.com/google/ExoPlayer/issues/262#issuecomment-71372996","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/262","id":71372996,"node_id":"MDEyOklzc3VlQ29tbWVudDcxMzcyOTk2","user":{"login":"bascel","id":10669613,"node_id":"MDQ6VXNlcjEwNjY5NjEz","avatar_url":"https://avatars.githubusercontent.com/u/10669613?v=4","gravatar_id":"","url":"https://api.github.com/users/bascel","html_url":"https://github.com/bascel","followers_url":"https://api.github.com/users/bascel/followers","following_url":"https://api.github.com/users/bascel/following{/other_user}","gists_url":"https://api.github.com/users/bascel/gists{/gist_id}","starred_url":"https://api.github.com/users/bascel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bascel/subscriptions","organizations_url":"https://api.github.com/users/bascel/orgs","repos_url":"https://api.github.com/users/bascel/repos","events_url":"https://api.github.com/users/bascel/events{/privacy}","received_events_url":"https://api.github.com/users/bascel/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-01-25T13:25:05Z","updated_at":"2015-01-25T13:25:05Z","body":"I also observed this issue (+- a few seconds wallclock time accuracy with NITZ synchronization). I solved this by implementing an SNTP client using several NTP servers from http://www.pool.ntp.org/en . This way, the accuracy improved to ~50ms at worst, which is good enough i guess. I didn't look into UtcTiming elements so far, maybe that's a better approach.\n","author_association":"NONE","rea