+            .check();
+
+        // EXISTS
+        assertQuery("SELECT ID1 FROM T1 WHERE REF1 IN " +
+            "(SELECT REF2 FROM T2 WHERE NOT EXISTS (SELECT REF3 FROM T3 WHERE REF3 = T1.REF1))")
