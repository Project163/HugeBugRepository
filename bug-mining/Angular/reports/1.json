s when:\n- items are being removed from the list of items,\n- items are being moved in the lists of items.\n\nWhen items are being moved, there is no need to dehydrate the view as the view will still be present in the end DOM. However when views are being removed, they should be de-hydrated.\n\n`ViewPort.clear()` remove all the attached view. They should probably also be dehydrated there.\n","closed_by":{"login":"rkirov","id":95713,"node_id":"MDQ6VXNlcjk1NzEz","avatar_url":"https://avatars.githubusercontent.com/u/95713?v=4","gravatar_id":"","url":"https://api.github.com/users/rkirov","html_url":"https://github.com/rkirov","followers_url":"https://api.github.com/users/rkirov/followers","following_url":"https://api.github.com/users/rkirov/following{/other_user}","gists_url":"https://api.github.com/users/rkirov/gists{/gist_id}","starred_url":"https://api.github.com/users/rkirov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rkirov/subscriptions","organizations_url":"https://api.github.com/users/rkirov/orgs","repos_url":"https://api.github.com/users/rkirov/repos","events_url":"https://api.github.com/users/rkirov/events{/privacy}","received_events_url":"https://api.github.com/users/rkirov/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/416/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/angular/angular/issues/416/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}