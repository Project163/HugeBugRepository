<item>
            <title>[IGNITE-5492] Local cache metrics is broken</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-5492</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;Reproducer:&lt;br/&gt;
    IgniteConfiguration cfg = new IgniteConfiguration();&lt;br/&gt;
    Ignite ignite = Ignition.start(cfg);&lt;/p&gt;

&lt;p&gt;    CacheConfiguration&amp;lt;String, String&amp;gt; locCacheCfg = new CacheConfiguration&amp;lt;&amp;gt;(&quot;local&quot;);&lt;br/&gt;
    locCacheCfg.setCacheMode(CacheMode.LOCAL);&lt;br/&gt;
    locCacheCfg.setStatisticsEnabled(true);&lt;/p&gt;

&lt;p&gt;    IgniteCache locCache = ignite.getOrCreateCache(locCacheCfg);&lt;/p&gt;

&lt;p&gt;    assert(locCache.get(&quot;ZZZ&quot;) == null)&lt;br/&gt;
    assert(locCache.localMetrics().getCacheMisses == 1)&lt;/p&gt;</description>
