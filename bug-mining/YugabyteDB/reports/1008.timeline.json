te-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Jira Link: [DB-3946](https://yugabyte.atlassian.net/browse/DB-3946)\r\n### Description\n\nIn tpcc, we have a method _enableForeignKeys_, which creates FKs after data is loaded. In this method, drop constraint with 'if exists' is giving ERROR, causing this statement to fail, and as a result other alter statements in the code(that create FKs) were not executed.\r\n**Error:**\r\n```\r\n\"02:38:33,081 (DBWorkload.java:362) INFO  - Loading data into TPCC database with 48 threads...\", \r\n\"10:13:27,402 (SchemaManager.java:29) INFO  - ALTER TABLE DISTRICT DROP CONSTRAINT IF EXISTS D_FKEY_W\", \r\n\"10:13:27,454 (Loader.java:223) ERROR - Could not create foreign keysERROR: constraint \\\"d_fkey_w\\\" for table \\\"district\\\" does not exist\", \r\n\"10:13:27,455 (DBWorkload.java:366) INFO  - Finished!\", \r\n\"10:13:27,455 (DBWorkload.java:367) INFO  - \r\n```\r\n**In 2.15.3.0-b56**, drop constraint with if exists gives a NOTICE if constraint does not exists.\r\n```\r\nyugabyte=# ALTER TABLE contacts drop  CONSTRAINT IF EXISTS D_FKEY_W;\r\nNOTICE:  constraint \"d_fkey_w\" of relation \"contacts\" does not exist, skipping\r\nALTER TABLE\r\n```\r\n**In 2.15.3.0-b107**, drop constraint with if exists gives ERROR if constraint does not exists, causing the failure, which results in non-execution of the other alter statements.\r\n```\r\nyugabyte=# ALTER TABLE contacts drop  CONSTRAINT IF EXISTS D_FKEY_W;\r\nERROR:  constraint \"d_fkey_w\" for table \"contacts\" does not exist\r\nSo, some changes between 2.15.3.0-b56 and 2.15.3.0-b107 has triggered the issue. \r\n```\r\nThis ERROR seems to be a bug in the product, as with if exists, any error for non-existing constraints should be ignored. ","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/14566/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/14566/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":10646422927,"node_id":"REFE_lADOBlCVUc5nkrFDzwAAAAJ6k4WP","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/10646422927","actor":{"login":"yifanguan","id":31666298,"node_id":"MDQ6VXNlcjMxNjY2Mjk4","avatar_url":"https://avatars.githubusercontent.com/u/31666298?v=4","gravatar_id":"","url":"https://api.github.com/users/yifanguan","html_url":"https://github.com/yifanguan","followers_url":"https://api.github.com/users/yifanguan/followers","following_url":"https://api.github.com/users/yifanguan/following{/other_user}","gists_url":"https://api.github.com/users/yifanguan/gists{/gist