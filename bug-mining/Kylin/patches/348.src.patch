+            val newIndexes = Stream
+                    .concat(modelSchemaChange.getNewItems().stream()
+                            .filter(schemaChange -> schemaChange.getType() == SchemaNodeType.RULE_BASED_INDEX)
+                            .map(SchemaChangeCheckResult.ChangedItem::getDetail),
