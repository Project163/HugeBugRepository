.com/users/roulpriya/followers","following_url":"https://api.github.com/users/roulpriya/following{/other_user}","gists_url":"https://api.github.com/users/roulpriya/gists{/gist_id}","starred_url":"https://api.github.com/users/roulpriya/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/roulpriya/subscriptions","organizations_url":"https://api.github.com/users/roulpriya/orgs","repos_url":"https://api.github.com/users/roulpriya/repos","events_url":"https://api.github.com/users/roulpriya/events{/privacy}","received_events_url":"https://api.github.com/users/roulpriya/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/testcontainers/testcontainers-java/issues/comments/1273259414","html_url":"https://github.com/testcontainers/testcontainers-java/issues/5026#issuecomment-1273259414","issue_url":"https://api.github.com/repos/testcontainers/testcontainers-java/issues/5026","id":1273259414,"node_id":"IC_kwDOAgP_mc5L5GWW","user":{"login":"kiview","id":5088104,"node_id":"MDQ6VXNlcjUwODgxMDQ=","avatar_url":"https://avatars.githubusercontent.com/u/5088104?v=4","gravatar_id":"","url":"https://api.github.com/users/kiview","html_url":"https://github.com/kiview","followers_url":"https://api.github.com/users/kiview/followers","following_url":"https://api.github.com/users/kiview/following{/other_user}","gists_url":"https://api.github.com/users/kiview/gists{/gist_id}","starred_url":"https://api.github.com/users/kiview/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kiview/subscriptions","organizations_url":"https://api.github.com/users/kiview/orgs","repos_url":"https://api.github.com/users/kiview/repos","events_url":"https://api.github.com/users/kiview/events{/privacy}","received_events_url":"https://api.github.com/users/kiview/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-10-10T12:44:04Z","updated_at":"2022-10-10T12:44:04Z","body":"Hey @roulpriya, great that you want to look into it.\r\n\r\nThis issue occurs, if `docker.host` is set in the `~/.testcontainers.properties` file (e.g. to a valid value), but `DOCKER_HOST` is also set and is empty.\r\n\r\nIt will show such an error:\r\n```\r\nEnvironmentAndSystemPropertyClientProviderStrategy: failed with exception NullPointerException (Cannot invoke \"String.hashCode()\" because \"<local5>\" is null)As no valid configuration was found, execution cannot continue.\r\n```\r\n\r\nThe culprit is like this code right here, since it check only for a key, but not for empty value:\r\nhttps://github.com/testcontainers/testcontainers-java/blob/de1324ed2800eff4da326d0c23d281399d006bc0/core/src/main/java/org/testcontainers/utility/TestcontainersConfiguration.java#L232-L234","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/testcontainers/testcontainers-java/issues/comments/1273259414/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"kiview","id":5088104,"node_id":"MDQ6VXNlcjUwODgxMDQ=","avatar_url":"https://avatars.githubusercontent.com/u/5088104?v=4","gravatar_id":"","url":"https://api.github.com/users/kiview","html_url":"https://github.com/kiview","followers_url":"https://api.github.com/users/kiview/followers","following_url":"https://api.github.com/users/kiview/following{/other_user}","gists_url":"https://api.github.com/users/kiview/gists{/gist_id}","starred_url":"https://api.github.com/users/kiview/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kiview/subscriptions","organizations_url":"https://api.github.com/users/kiview/orgs","repos_url":"https://api.github.com/users/kiview/repos","events_url":"https://api.github.com/users/kiview/events{/privacy}","received_events_url":"https://api.github.com/users/kiview/received_events","type":"User","user_view_type":"public","site_adm