diff --git a/pylint/test/functional/missing_kwoa_py3.py b/pylint/test/functional/missing_kwoa_py3.py
index 97f4f73a4..3b6e1c0d8 100644
--- a/pylint/test/functional/missing_kwoa_py3.py
+++ b/pylint/test/functional/missing_kwoa_py3.py
@@ -23,3 +23,14 @@ target(1, keyword=2)
 
 PARAM = 1
 target(2, PARAM) # [too-many-function-args, missing-kwoa]
+
+
+def some_function(*, param):
+    return param + 2
+
+
+def other_function(**kwargs):
+    return some_function(**kwargs)  # Does not trigger missing-kwoa
+
+
+other_function(param=2)
