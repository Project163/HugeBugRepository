e-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Jira Link: [DB-9089](https://yugabyte.atlassian.net/browse/DB-9089)\r\n### Description\r\n\r\nTruncating a colocated table within an explicit transaction results in t-server crash and an assertion failure in debug mode.\r\n\r\nRepro:\r\n\r\n```\r\nCREATE DATABASE x WITH colocation=true;\r\n\\c x;\r\nCREATE TABLE x (t int);\r\nbegin;\r\ninsert into x values (1);\r\ntruncate x;\r\nWARNING:  AbortSubTransaction while in ABORT state\r\nERROR:  recvmsg error: Connection refused\r\n\r\n```\r\n\r\nT-server logs show:\r\n`F1130 22:52:46.761531 4033330 wait_queue.cc:260] Check failed: txn_start_us || id.IsNil() \r\n`\r\n\r\nThe above issue was introduced with this change:\r\n[D25252](https://phorge.dev.yugabyte.com/D25252) [#17290] DocDB: Enable wait-on-conflict behavior in debug\r\n\r\n\r\n### Issue Type\r\n\r\nkind/bug\r\n\r\n### Warning: Please confirm that this issue does not contain any sensitive information\r\n\r\n- [X] I confirm this issue does not contain any sensitive information.\r\n\r\n[DB-9089]: https://yugabyte.atlassian.net/browse/DB-9089?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/20153/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/20153/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]