6-03-11T08:09:26Z","pushed_at":"2026-03-10T23:39:43Z","git_url":"git://github.com/angular/angular.git","ssh_url":"git@github.com:angular/angular.git","clone_url":"https://github.com/angular/angular.git","svn_url":"https://github.com/angular/angular","homepage":"https://angular.dev","size":616697,"stargazers_count":100153,"watchers_count":100153,"language":"TypeScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":27109,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1141,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["angular","javascript","pwa","typescript","web","web-framework","web-performance"],"visibility":"public","forks":27109,"open_issues":1141,"watchers":100153,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"<!--\r\nPLEASE HELP US PROCESS GITHUB ISSUES FASTER BY PROVIDING THE FOLLOWING INFORMATION.\r\n\r\nISSUES MISSING IMPORTANT INFORMATION MAY BE CLOSED WITHOUT INVESTIGATION.\r\n-->\r\n\r\n## I'm submitting a...\r\n<!-- Check one of the following options with \"x\" -->\r\n<pre><code>\r\n[ ] Regression (a behavior that used to work and stopped working in a new release)\r\n[x ] Bug report  <!-- Please search GitHub for a similar issue or PR before submitting -->\r\n[ ] Feature request\r\n[ ] Documentation issue or request\r\n[ ] Support request => Please do not submit support request here, instead see https://github.com/angular/angular/blob/master/CONTRIBUTING.md#question\r\n</code></pre>\r\n\r\n## Current behavior\r\n<!-- Describe how the issue manifests. -->\r\nRecently, my team has updates to angular 5.0.0 and we went to implement locale code to handle different numeric representation by region.  We read up on issues in 5.0.0 and updated to 5.1.  The problem is that every time we try to import the locales to register them we get an error thrown.\r\n\r\n`import { registerLocaleData } from '@angular/common';\r\nimport localeFr from '@angular/common/locales/fr';\r\nimport localeFrExtra from '@angular/common/locales/extra/fr';`\r\n\r\nThe weird thing about the error is that it is saying it is an issue with reading the json metadata and it is saying the angular language service is 5.0.0 even though we just updated to 5.1.0.\r\n\r\n> Search path: c:/Users/DevAdmin/Documents/GitHub/v15-a2/st-site/src/app\r\nFailed to read JSON file c:/Users/DevAdmin/Documents/GitHub/v15-a2/st-site/node_modules/@angular/common/locales/fr.metadata.json\r\nConfig file name: c:/Users/DevAdmin/Documents/GitHub/v15-a2/st-site/tsconfig.json\r\nAngular Language Service: 5.0.0-beta.5\r\nTypeScript: 2.4.2\r\nError for getTemplateRefrences:\r\n    TypeError: Cannot read property 'version' of null\r\n    at C:\\Users\\DevAdmin\\.vscode\\extensions\\Angular.ng-template-0.1.7\\server\\node_modules\\@angular\\language-service\\bundles\\language-service.umd.js:21442:70\r\n    at Array.find (native)\r\n    at ReflectorHost.BaseAotCompilerHost.readMetadata (C:\\Users\\DevAdmin\\.vscode\\extensions\\Angular.ng-template-0.1.7\\server\\node_modules\\@angular\\language-service\\bundles\\language-service.umd.js:21442:42)\r\n    at ReflectorHost.BaseAotCompilerHost.getMetadataFor (C:\\Users\\DevAdmin\\.vscode\\extensions\\Angular.ng-template-0.1.7\\server\\node_modules\\@angular\\language-service\\bundles\\language-service.umd.js:21419:29)\r\n    at StaticSymbolResolver.getModuleMetadata (C:\\Users\\DevAdmin\\.vscode\\extensions\\Angular.ng-template-0.1.7\\server\\node_modules\\@angular\\language-service\\bundles\\language-service.umd.js:17910:45)\r\n    at StaticSymbolResolver._createSymbolsOf (C:\\Users\\DevAdmin\\.vscode\\extensions\\Angular.ng-template-0.1.7\\server\\node_modules\\@angular\\language-service\\bundles\\language-service.umd.js:17740:29)\r\n    at StaticSymbolResolver.getSymbolsOf (C:\\Users\\DevAdmin\\.vscode\\extensions\\Angular.ng-template-0.1.7\\server\\node_modules\\@angular\\language-service\\bundles\\language-service.umd.js:17725:14)\r\n    at C:\\Users\\DevAdmin\\.vscode\\extensions\\Angular.ng-template-0.1.7\\server\\node_modules\\@angular\\language-service\\bundles\\language-service.umd.js:16800:30\r\n    at Array.forEach (native)\r\n    at extractProgramSymbols (C:\\Users\\DevAdmin\\.vscode\\extensions\\Angular.ng-template-0.1.7\\server\\node_modules\\@angular\\language-service\\bundles\\language-service.umd.js:16799:79)\r\ngetTemplateRefrences: 1154ms\r\nSERVER ERROR: Cannot read property 'length' of null\r\nTypeError: Cannot read property 'length' of null\r\n    at Project.updateFileMap (C:\\Users\\DevAdmin\\.vscode\\extensions\\Angular.ng-template-0.1.7\\server\\editorServices.js:797:94)\r\n    at Project.updateGraph (C:\\Users\\DevAdmin\\.vscode\\extensions\\Angular.ng-template-0.1.7\\server\\editorServices.js:815:14)\r\n    at Project.finishGraph (C:\\Users\\DevAdmin\\.vscode\\extensions\\Angular.ng-template-0.1.7\\server\\editorServices.js:807:14)\r\n    at ProjectService.openConfigFile (C:\\Users\\DevAdmin\\.vscode\\extensions\\Angular.ng-template-0.1.7\\server\\editorServices.js:1634:17)\r\n    at ProjectService.openOrUpdateConfiguredProjectForFile (C:\\Users\\DevAdmin\\.vscode\\extensions\\Angular.ng-template-0.1.7\\server\\editorServices.js:1486:41)\r\n    at ProjectService.openClientFile (C:\\Users\\DevAdmin\\.vscode\\extensions\\Angular.ng-template-0.1.7\\server\\editorServices.js:1404:23)\r\n    at C:\\Users\\DevAdmin\\.vscode\\extensions\\Angular.ng-template-0.1.7\\server\\documents.js:135:47\r\n    at TextDocuments.logErrors (C:\\Users\\DevAdmin\\.vscode\\extensions\\Angular.ng-template-0.1.7\\server\\documents.js:235:13)\r\n    at C:\\Users\\DevAdmin\\.vscode\\extensions\\Angular.ng-template-0.1.7\\server\\documents.js:131:74\r\n    at handleNotification (C:\\Users\\DevAdmin\\.vscode\\extensions\\Angular.ng-template-0.1.7\\server\\node_modules\\vscode-jsonrpc\\lib\\main.js:353:21)\r\n[Error - 9:42:43 AM] Notification handler 'textDocument/didOpen' failed with message: Cannot read property 'length' of null\r\n\r\nIf we run ng -v, it tells us that 5.1.0 is running but for some reason when importing it is using the 5.0.0 Angular language service.\r\n\r\n> Angular CLI: 1.6.0 (e)\r\nNode: 6.11.1\r\nOS: win32 x64\r\nAngular: 5.1.0\r\n\r\nAlso, this issue seems to persist until we remove the lines of code from our app.module, then close visual code, and force kill node.js.\r\n\r\n## Expected behavior\r\n<!-- Describe what the desired behavior would be. -->\r\nThis should simply just import the locale information to be able to register.\r\n\r\n## Minimal reproduction of the problem with instructions\r\n<!--\r\nFor bug reports please provide the *STEPS TO REPRODUCE* and if possible a *MINIMAL DEMO* of the problem via\r\nhttps://plnkr.co or similar (you can use this template as a starting point: http://plnkr.co/edit/tpl:AvJOMERrnz94ekVua0u5).\r\n-->\r\n\r\n## What is the motivation / use case for changing the behavior?\r\n<!-- Describe the motivation or the concrete use case. -->\r\n\r\n\r\n## Environment\r\nAngular CLI: 1.6.0 (e)\r\nNode: 6.11.1\r\nOS: win32 x64\r\nAngular: 5.1.0\r\n... animations, common, compiler, compiler-cli, core, forms\r\n... http, language-service, platform-browser\r\n... platform-browser-dynamic, router\r\n\r\n@angular/cli: 1.6.0\r\n@angular-devkit/build-optimizer: 0.0.35\r\n@angular-devkit/core: 0.0.22\r\n@angular-devkit/schematics: 0.0.41\r\n@ngtools/json-schema: 1.1.0\r\n@ngtools/webpack: 1.7.4\r\n@schematics/angular: 0.1.10\r\n@schematics/schematics: 0.0.10\r\ntypescript: 2.4.2\r\nwebpack-dev-server: 2.9.7\r\nwebpack: 3.10.0\r\n<pre><code>\r\nAngular version: X.Y.Z\r\n<!-- Check whether this is still an issue in