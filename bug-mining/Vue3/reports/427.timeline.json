n }>();\r\n\r\n  const getter = () => {\r\n    return isMulti ? [] : '';\r\n  }\r\n  const model = defineModel({\r\n    get:getter,\r\n  })\r\n\r\n</script>\r\n```\r\n\r\nThe direct reason is that the compiler will first convert defineModel, and then convert props, that is, add the __props prefix. In this process, due to the use of magicString to operate the defineModel part, props cannot be converted again, resulting in an error.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/vuejs/core/issues/comments/1876470103/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"baiwusanyu-c","id":32354856,"node_id":"MDQ6VXNlcjMyMzU0ODU2","avatar_url":"https://avatars.githubusercontent.com/u/32354856?v=4","gravatar_id":"","url":"https://api.github.com/users/baiwusanyu-c","html_url":"https://github.com/baiwusanyu-c","followers_url":"https://api.github.com/users/baiwusanyu-c/followers","following_url":"https://api.github.com/users/baiwusanyu-c/following{/other_user}","gists_url":"https://api.github.com/users/baiwusanyu-c/gists{/gist_id}","starred_url":"https://api.github.com/users/baiwusanyu-c/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/baiwusanyu-c/subscriptions","organizations_url":"https://api.github.com/users/baiwusanyu-c/orgs","repos_url":"https://api.github.com/users/baiwusanyu-c/repos","events_url":"https://api.github.com/users/baiwusanyu-c/events{/privacy}","received_events_url":"https://api.github.com/users/baiwusanyu-c/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":11385918142,"node_id":"LE_lADOCCum18567hZKzwAAAAKmp1K-","url":"https://api.github.com/repos/vuejs/core/issues/events/11385918142","actor":{"login":"baiwusanyu-c","id":32354856,"node_id":"MDQ6VXNlcjMyMzU0ODU2","avatar_url":"https://avatars.githubusercontent.com/u/32354856?v=4","gra