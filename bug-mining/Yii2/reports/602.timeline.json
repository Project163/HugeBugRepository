pos/yiisoft/yii2/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/yiisoft/yii2/labels{/name}","releases_url":"https://api.github.com/repos/yiisoft/yii2/releases{/id}","deployments_url":"https://api.github.com/repos/yiisoft/yii2/deployments","created_at":"2012-02-13T15:32:36Z","updated_at":"2025-12-13T02:47:07Z","pushed_at":"2025-12-09T16:34:01Z","git_url":"git://github.com/yiisoft/yii2.git","ssh_url":"git@github.com:yiisoft/yii2.git","clone_url":"https://github.com/yiisoft/yii2.git","svn_url":"https://github.com/yiisoft/yii2","homepage":"http://www.yiiframework.com","size":87780,"stargazers_count":14308,"watchers_count":14308,"language":"PHP","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":6857,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":521,"license":{"key":"bsd-3-clause","name":"BSD 3-Clause \"New\" or \"Revised\" License","spdx_id":"BSD-3-Clause","url":"https://api.github.com/licenses/bsd-3-clause","node_id":"MDc6TGljZW5zZTU="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["framework","hacktoberfest","php","php-framework","yii","yii2"],"visibility":"public","forks":6857,"open_issues":521,"watchers":14308,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"### What steps will reproduce the problem?\r\n\r\nСоздать форму ActiveForm.\r\nЗадать ей ID - любой, например my-form.\r\nПосле ActiveForm::end(); - подчеркиваю это важно!\r\nЗадать чек бокс с указанием значения при снятом флажке, указать какой форме принадлежит этот чекбокс. \r\nНапример\r\n\r\n`<?= $form->field($model, 'edited')->checkbox(['uncheck' => 'no', 'value' => 'yes', 'form' => 'my-form'], false) ?>`\r\n \r\n### What is the expected result?\r\n\r\nВ итоге мы должны получить\r\n\r\n```\r\n<div class=\"col-sm-10\">\r\n<input type=\"hidden\" name=\"Objects[edited]\" form=\"my-form\" value=\"no\">\r\n<input type=\"checkbox\" id=\"objects-edited\" name=\"Objects[edited]\" value=\"yes\" checked=\"\" form=\"my-form\">\r\n<div class=\"help-block help-block-error \"></div>\r\n</div>\r\n```\r\n\r\n### What do you get instead?\r\n\r\n```\r\n<div class=\"col-sm-10\">\r\n<input type=\"hidden\" name=\"Objects[edited]\" value=\"no\">\r\n<input type=\"checkbox\" id=\"objects-edited\" name=\"Objects[edited]\" value=\"yes\" checked=\"\" form=\"my-form\">\r\n<div class=\"help-block help-block-error \"></div>\r\n</div>\r\n```\r\n\r\nВ скрытом поле пропущен атрибут принадлежности формы.\r\nВ итоге если флажок снят то не передается значение \"no\".\r\n\r\n### Additional info\r\n\r\n| Q                | A\r\n| ---------------- | ---\r\n| Yii version      | 2.0.10\r\n| PHP version      | 5.6.19\r\n| Operating system | windows 7 sp1\r\n","reactions":{"url":"https://api.github.com/repos/yiisoft/yii2/issues/13053/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yiisoft/yii2/issues/13053/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"actor":{"login":"Kolyunya","id":2682768,"node_id":"MDQ6VXNlcjI2ODI3Njg=","avatar_url":"https://avatars.githubusercontent.com/u/2682768?v=4","gravatar_id":"","url":"https://api.github.com/users/Kolyunya","html_url":"https://github.com/Kolyunya","followers_url":"https://api.github.com/users/Kolyunya/followers","following_url":"https://api.github.com/users/Kolyunya/following{/other_user}","gists_url":"https://api.github.com/users/Kolyunya/gists{/gist_id}","starred_url":"https://api.github.com/users/Kolyunya/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kolyunya/subscriptions","organizations_url":"https://api.github.com/users/Kolyunya/orgs","repos_url":"https://api.github.com/users/Kolyunya/repos","events_url":"https://api.github.co