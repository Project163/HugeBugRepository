		&lt;ol&gt;
			&lt;li&gt;What is the Jira issue?&lt;br/&gt;
    &lt;a href=&quot;https://issues.apache.org/jira/browse/ZEPPELIN-2033&quot; title=&quot;paragraph focus/blur doesn&amp;#39;t work when editor is hidden&quot; class=&quot;issue-link&quot; data-issue-key=&quot;ZEPPELIN-2033&quot;&gt;&lt;del&gt;ZEPPELIN-2033&lt;/del&gt;&lt;/a&gt;(&lt;a href=&quot;https://issues.apache.org/jira/browse/ZEPPELIN-2033&quot; class=&quot;external-link&quot; rel=&quot;nofollow&quot;&gt;https://issues.apache.org/jira/browse/ZEPPELIN-2033&lt;/a&gt;)&lt;/li&gt;
		&lt;/ol&gt;
