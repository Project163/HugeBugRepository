-  private static Matrix reshape(double[] values, int rows, int columns) {
-    Matrix m = new DenseMatrix(rows, columns);
-    int i = 0;
-    for (double v : values) {
-      m.set(i % rows, i / rows, v);
-      i++;
-    }
-    return m;
-  }
-}
