&lt;pre class=&quot;code-java&quot;&gt;&lt;span class=&quot;code-keyword&quot;&gt;public&lt;/span&gt; JsonResponse(javax.ws.rs.core.Response.Status status, &lt;span class=&quot;code-object&quot;&gt;String&lt;/span&gt; message, T body)
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</description>
