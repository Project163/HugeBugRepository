[{"url":"https://api.github.com/repos/rails/rails/issues/comments/17788874","html_url":"https://github.com/rails/rails/issues/10444#issuecomment-17788874","issue_url":"https://api.github.com/repos/rails/rails/issues/10444","id":17788874,"node_id":"MDEyOklzc3VlQ29tbWVudDE3Nzg4ODc0","user":{"login":"nielsbuus","id":3750087,"node_id":"MDQ6VXNlcjM3NTAwODc=","avatar_url":"https://avatars.githubusercontent.com/u/3750087?v=4","gravatar_id":"","url":"https://api.github.com/users/nielsbuus","html_url":"https://github.com/nielsbuus","followers_url":"https://api.github.com/users/nielsbuus/followers","following_url":"https://api.github.com/users/nielsbuus/following{/other_user}","gists_url":"https://api.github.com/users/nielsbuus/gists{/gist_id}","starred_url":"https://api.github.com/users/nielsbuus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nielsbuus/subscriptions","organizations_url":"https://api.github.com/users/nielsbuus/orgs","repos_url":"https://api.github.com/users/nielsbuus/repos","events_url":"https://api.github.com/users/nielsbuus/events{/privacy}","received_events_url":"https://api.github.com/users/nielsbuus/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2013-05-13T00:58:14Z","updated_at":"2013-05-13T00:58:14Z","body":"I'm no Rails framework contributor, but I just stumbled about this very issue today. I was surprised to discover that translation calls were evaluated in the context of the partial, rather than the block passed to it. It makes no sense to evaluate block translation calls in the context of the partial as it would mean polluting the partials namespace in I18n, unless using fully qualified keys.  I would appreciate a fix.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/rails/rails/issues/comments/17788874/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"