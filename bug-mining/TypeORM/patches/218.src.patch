+                    upQueries.push(
+                        new Query(
+                            `ALTER TABLE ${this.escapePath(
+                                table,
+                            )} ADD UNIQUE INDEX \`${uniqueIndex.name}\` (\`${
+                                newColumn.name
+                            }\`)`,
+                        ),
+                    )
+                    downQueries.push(
+                        new Query(
+                            `ALTER TABLE ${this.escapePath(
+                                table,
+                            )} DROP INDEX \`${uniqueIndex.name}\``,
