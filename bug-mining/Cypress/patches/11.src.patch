diff --git a/app/js/api/cypress/mouse.coffee b/app/js/api/cypress/mouse.coffee
index 4e607d9032..7c1a155306 100644
--- a/app/js/api/cypress/mouse.coffee
+++ b/app/js/api/cypress/mouse.coffee
@@ -2,14 +2,25 @@ $Cypress.Mouse = do ($Cypress, _, Promise) ->
 
   stopPropagation = MouseEvent.prototype.stopPropagation
 
+  ## clientX and clientY by their definition
+  ## are calculated from viewport edge
+  ## and should subtract the pageX or pageY offset
+  ## see img: https://camo.githubusercontent.com/9963a83071b4b14c8dee6699335630f29d668d1f/68747470733a2f2f692d6d73646e2e7365632e732d6d7366742e636f6d2f64796e696d672f49433536313937302e706e67
+
+  getClientX = (coords, win) ->
+    coords.x - win.pageXOffset
+
+  getClientY = (coords, win) ->
+    coords.y - win.pageYOffset
+
   return {
     mouseDown: ($elToClick, coords, win) ->
       mdownEvt = new MouseEvent "mousedown", {
         bubbles: true
         cancelable: true
         view: win
-        clientX: coords.x
-        clientY: coords.y
+        clientX: getClientX(coords, win)
+        clientY: getClientY(coords, win)
         buttons: 1
         detail: 1
       }
@@ -33,8 +44,8 @@ $Cypress.Mouse = do ($Cypress, _, Promise) ->
         bubbles: true
         cancelable: true
         view: win
-        clientX: coords.x
-        clientY: coords.y
+        clientX: getClientX(coords, win)
+        clientY: getClientY(coords, win)
         buttons: 0
         detail: 1
       }
@@ -58,8 +69,8 @@ $Cypress.Mouse = do ($Cypress, _, Promise) ->
         bubbles: true
         cancelable: true
         view: win
-        clientX: coords.x
-        clientY: coords.y
+        clientX: getClientX(coords, win)
+        clientY: getClientY(coords, win)
         buttons: 0
         detail: 1
       }
