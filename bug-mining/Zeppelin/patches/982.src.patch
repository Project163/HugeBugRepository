+            .newerThanEqualsPatchVersion(SparkVersion.fromVersionString("2.2.0")));
+
     // conversion
     assertEquals(20300, SparkVersion.SPARK_2_3_0.toNumber());
     assertEquals("2.3.0", SparkVersion.SPARK_2_3_0.toString());
