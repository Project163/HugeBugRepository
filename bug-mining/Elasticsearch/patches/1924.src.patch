+            throw new InvalidTypeNameException("mapping type name [" + type + "] should not include ',' in it");
+        }
+        if (type.charAt(0) == '.') {
+            throw new IllegalArgumentException("mapping type name [" + type + "] must not start with a '.'");
+        }
+    }
