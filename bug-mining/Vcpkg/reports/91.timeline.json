.com/users/PhoebeHui/gists{/gist_id}","starred_url":"https://api.github.com/users/PhoebeHui/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhoebeHui/subscriptions","organizations_url":"https://api.github.com/users/PhoebeHui/orgs","repos_url":"https://api.github.com/users/PhoebeHui/repos","events_url":"https://api.github.com/users/PhoebeHui/events{/privacy}","received_events_url":"https://api.github.com/users/PhoebeHui/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2019-06-06T09:21:57Z","label":{"name":"port bug","color":"e99695"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/microsoft/vcpkg/issues/comments/499428707","html_url":"https://github.com/microsoft/vcpkg/issues/6708#issuecomment-499428707","issue_url":"https://api.github.com/repos/microsoft/vcpkg/issues/6708","id":499428707,"node_id":"MDEyOklzc3VlQ29tbWVudDQ5OTQyODcwNw==","user":{"login":"emptyVoid","id":13639229,"node_id":"MDQ6VXNlcjEzNjM5MjI5","avatar_url":"https://avatars.githubusercontent.com/u/13639229?v=4","gravatar_id":"","url":"https://api.github.com/users/emptyVoid","html_url":"https://github.com/emptyVoid","followers_url":"https://api.github.com/users/emptyVoid/followers","following_url":"https://api.github.com/users/emptyVoid/following{/other_user}","gists_url":"https://api.github.com/users/emptyVoid/gists{/gist_id}","starred_url":"https://api.github.com/users/emptyVoid/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/emptyVoid/subscriptions","organizations_url":"https://api.github.com/users/emptyVoid/orgs","repos_url":"https://api.github.com/users/emptyVoid/repos","events_url":"https://api.github.com/users/emptyVoid/events{/privacy}","received_events_url":"https://api.github.com/users/emptyVoid/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-06-06T09:52:13Z","updated_at":"2019-06-06T09:52:13Z","body":"These are ```vcpkg``` commit hashes you are seeing.\r\n\r\n```OpenCV``` tries to be clever while determining its \"version\" and fails at that. I've seen similar behavior in other ```GitHub``` repositories (e.g. ```AWS SDK for C++```) -- whenever they are extracted from a release archive in other repository's tree (with ```vcpkg``` it's ```buildtrees``` subdirectory), their versioning scripts erroneously pick container repository's git info.\r\n\r\nHere's where they are determining version control string:\r\nhttps://github.com/opencv/opencv/blob/3.4.3/CMakeLists.txt#L527-L537\r\nAnd here's how they are doing it:\r\nhttps://github.com/opencv/opencv/blob/3.4.3/cmake/OpenCVUtils.cmake#L1625-L1659\r\n\r\nIMO the procedure should be improved in similar manner to [how it was done in AWS SDK for C++](https://github.com/aws/aws-sdk-cpp/pull/425/files#diff-198ad692bfaa08553bc0dc7b00415241).","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/microsoft/vcpkg/issues/comments/499428707/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"emptyVoid","id":13639229,"node_id":"MDQ6VXNlcjEzNjM5MjI5","avatar_url":"https://avatars.githubusercontent.com/u/13639229?v=4","gravatar_id":"","url":"https://api.github.com/users/emptyVoid","html_url":"https://github.com/emptyVoid","followers_url":"https://api.github.com/users/emptyVoid/followers","following_url":"https://api.github.com/users/emptyVoid/following{/other_user}","gists_url":"https://api.github.com/users/emptyVoid/gists{/gist_id}","starred_url":"https://api.github.com/users/emptyVoid/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/emptyVoid/subscriptions","organizations_url":"https://api.github.com/users/emptyVoid/orgs","repos_url":"https://api.github.com/users/emptyVoid/repos","events_url":"https://api.github.com/users/emptyVoid