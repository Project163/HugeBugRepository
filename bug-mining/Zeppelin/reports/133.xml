            <title>[ZEPPELIN-309] Redirect to created/cloned notebook page on notebook creation/clone</title>
                <link>https://issues.apache.org/jira/browse/ZEPPELIN-309</link>
                <project id="12316221" key="ZEPPELIN">Zeppelin</project>
