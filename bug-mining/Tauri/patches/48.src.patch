+      return await execa(stringCommand, {
+        stdio: "inherit",
+        cwd: process.cwd(),
+        env: process.env,
+        ...options,
+      });
+    } else {
+      if (log) console.log(`[running]: ${command}`);
+      return await execa(command, args, {
+        stdio: "inherit",
+        cwd: process.cwd(),
+        env: process.env,
+        ...options,
+      });
+    }
+  } catch (error) {
+    console.error("Error with command: %s", command);
+    throw new Error(error);
+  }
+};
