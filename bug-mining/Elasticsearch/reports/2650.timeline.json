stargazers_count":76300,"watchers_count":76300,"language":"Java","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":25807,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":5586,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["elasticsearch","java","search-engine"],"visibility":"public","forks":25807,"open_issues":5586,"watchers":76300,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/elastic/elasticsearch/pulls/74809","html_url":"https://github.com/elastic/elasticsearch/pull/74809","diff_url":"https://github.com/elastic/elasticsearch/pull/74809.diff","patch_url":"https://github.com/elastic/elasticsearch/pull/74809.patch","merged_at":"2021-07-30T13:28:00Z"},"body":"Resolves #74311\r\n\r\nThe goal of this PR is to make implicit and explicit groupings behave consistently on empty result sets no matter whether the query is run on ES or optimized to a local relation. A typical example is a query like `SELECT COUNT(*) FROM test_emp WHERE languages = 2` vs `SELECT COUNT(*) FROM test_emp WHERE 1 = 2` where the later used to produce an empty result set instead of the expected 1 row with a count of 0.\r\n\r\nThe PR also fixes other edge case around contradictions in `HAVING` clauses that used to produce a wrong result: `SELECT COUNT(*) c, 'a' a HAVING COUNT(*) > 1000`\r\n\r\nPreviously:\r\n```\r\n       c       |       a       \r\n---------------+---------------\r\n1              |a              \r\n```\r\n\r\nNow:\r\n```\r\n       c       |       a       \r\n---------------+---------------\r\n```\r\n","reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/74809/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/elastic/elasticsearch/issues/74809/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":5091490319,"node_id":"MDExOkNsb3NlZEV2ZW50NTA5MTQ5MDMxOQ==","url":"https://api.github.com/repos/elastic/elasticsearch/issues/events/5091490319","actor":{"login":"Luegg","id":1016746,"node_id":"MDQ6VXNlcjEwMTY3NDY=","avatar_url":"https://avatars.githubusercontent.com/u/1016746?v=4","gravatar_id":"","url":"https://api.github.com/users/Luegg","html_url":"https://github.com/Luegg","followers_url":"https://api.github.com/users/Luegg/followers","following_url":"https://api.github.com/users/Luegg/following{/other_user}","gists_url":"https://api.github.com/users/Luegg/gists{/gist_id}","starred_url":"https://api.github.com/users/Luegg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Luegg/subscriptions","organizations_url":"https://api.github.com/users/Luegg/orgs","repos_url":"https://api.github.com/users/Luegg/repos","events_url":"https://api.github.com/users/Luegg/events{/privacy}","received_events_url":"https://api.github.com/users/Luegg/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2021-07-30T13:28:00Z","state_reason":null,"performed_via_github_app":null},{"id":5091491075,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDUwOTE0OTEwNzU=","url":"https://api.github.com/repos/elastic/elasticsearch/issues/events/5091491075","actor":{"login":"Luegg","id":1016746,"node_id":"MDQ6VXNlcjEwMTY3NDY=","avatar_url":"https://avatars.githubusercontent.com/u/1016746?v=4","gravatar_id":"","url":"https://api.github.com/users/Luegg","html_url":"https://github.com/Luegg","followers_url":"https://api.github.com/users/Luegg/followers","following_url":"https://api.github.com/users/Lue