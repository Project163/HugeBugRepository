--- a/lib/formatters/checkstyle.js
+++ b/lib/formatters/checkstyle.js
@@ -26,6 +26,23 @@ function getMessageType(message, rules) {
     return "warning";
 }
 
+function escape(s) {
+    return ("" + s).replace(/[<>&"']/g, function(c) {
+        switch(c) {
+            case "<":
+                return "&lt;";
+            case ">":
+                return "&gt;";
+            case "&":
+                return "&amp;";
+            case "\"":
+                return "&quot;";
+            case "'":
+                return "&apos;";
+        }
+    });
+}
+
 //------------------------------------------------------------------------------
 // Public Interface
 //------------------------------------------------------------------------------
@@ -41,13 +58,13 @@ module.exports = function(results, config) {
     results.forEach(function(result) {
         var messages = result.messages;
 
-        output += "<file name=\"" + result.filePath + "\">";
+        output += "<file name=\"" + escape(result.filePath) + "\">";
 
         messages.forEach(function(message) {
-            output += "<error line=\"" + message.line + "\" " +
-                "column=\"" + message.column + "\" " +
-                "severity=\"" + getMessageType(message, rules) + "\" " +
-                "message=\"" + message.message + "\" />";
+            output += "<error line=\"" + escape(message.line) + "\" " +
+                "column=\"" + escape(message.column) + "\" " +
+                "severity=\"" + escape(getMessageType(message, rules)) + "\" " +
+                "message=\"" + escape(message.message) + "\" />";
         });
 
         output += "</file>";
