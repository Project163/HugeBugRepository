diff --git a/pylint/test/functional/iterable_context_py35.py b/pylint/test/functional/iterable_context_py35.py
new file mode 100644
index 000000000..148fbe0b3
--- /dev/null
+++ b/pylint/test/functional/iterable_context_py35.py
@@ -0,0 +1,16 @@
+# pylint: disable=missing-docstring,too-few-public-methods
+
+
+class AIter:
+    async def __aiter__(self):
+        for value in range(20):
+            yield value
+
+    async def to_list(self):
+        values = [m async for m in self]
+        other_values = [m for m in self] # [not-an-iterable]
+        for value in self: # [not-an-iterable]
+            yield value
+        async for value in self:
+            yield value
+        yield values, other_values
