signees":[],"milestone":null,"comments":7,"created_at":"2022-03-21T15:16:26Z","updated_at":"2025-07-17T21:50:55Z","closed_at":null,"author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"This issue is observed when using napalm and a Cisco ASR9001 running IOS-XR 6.7.3.\r\nWhen trying to connect to such a device, paramiko only tries `ssh-rsa512`, fails and then gives up.\r\nI would expect it to try the other algorithms in its list until it finds one that is working.\r\n\r\nI am aware of the possibility to set `disabled_algorithm` but to my knowledge, napalm does not support setting this option.\r\nThis however is an issue that I will report to the napalm team.\r\n\r\nNonetheless, I think the behaviour of paramiko should be changed to regain compatibility with these legacy SSH daemons.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/paramiko/paramiko/issues/2012/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/paramiko/paramiko/issues/2012/timeline","performed_via_github_app":null,"state_reason":null}