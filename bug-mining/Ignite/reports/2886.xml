                            <comment id="16192798" author="alexey.tank2" created="Thu, 5 Oct 2017 12:21:02 +0000"  >&lt;p&gt;&lt;a href=&quot;https://issues.apache.org/jira/secure/ViewProfile.jspa?name=ntikhonov%40apache.org&quot; class=&quot;user-hover&quot; rel=&quot;ntikhonov@apache.org&quot;&gt;ntikhonov@apache.org&lt;/a&gt;&lt;br/&gt;
