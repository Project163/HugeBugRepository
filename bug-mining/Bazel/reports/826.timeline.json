ithub.com/repos/bazelbuild/bazel/issues/9412","id":598307687,"node_id":"MDEyOklzc3VlQ29tbWVudDU5ODMwNzY4Nw==","user":{"login":"Qinusty","id":7274845,"node_id":"MDQ6VXNlcjcyNzQ4NDU=","avatar_url":"https://avatars.githubusercontent.com/u/7274845?v=4","gravatar_id":"","url":"https://api.github.com/users/Qinusty","html_url":"https://github.com/Qinusty","followers_url":"https://api.github.com/users/Qinusty/followers","following_url":"https://api.github.com/users/Qinusty/following{/other_user}","gists_url":"https://api.github.com/users/Qinusty/gists{/gist_id}","starred_url":"https://api.github.com/users/Qinusty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Qinusty/subscriptions","organizations_url":"https://api.github.com/users/Qinusty/orgs","repos_url":"https://api.github.com/users/Qinusty/repos","events_url":"https://api.github.com/users/Qinusty/events{/privacy}","received_events_url":"https://api.github.com/users/Qinusty/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-03-12T17:13:03Z","updated_at":"2020-03-12T17:13:03Z","body":"Which version of bazel does this affect and is it fixed in the 3.0 release candidates?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/598307687/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Qinusty","id":7274845,"node_id":"MDQ6VXNlcjcyNzQ4NDU=","avatar_url":"https://avatars.githubusercontent.com/u/7274845?v=4","gravatar_id":"","url":"https://api.github.com/users/Qinusty","html_url":"https://github.com/Qinusty","followers_url":"https://api.github.com/users/Qinusty/followers","following_url":"https://api.github.com/users/Qinusty/following{/other_user}","gists_url":"https://api.github.com/users/Qinusty/gists{/gist_id}","starred_url":"https://api.github.com/users/Qinusty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Qinusty/subscriptions","organizations_url":"https://api.github.com/users/Qinusty/orgs","repos_url":"https://api.github.com/users/Qinusty/repos","events_url":"https://api.github.com/users/Qinusty/events{/privacy}","received_events_url":"https://api.github.com/users/Qinusty/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/598880105","html_url":"https://github.com/bazelbuild/bazel/issues/9412#issuecomment-598880105","issue_url":"https://api.github.com/repos/bazelbuild/bazel/issues/9412","id":598880105,"node_id":"MDEyOklzc3VlQ29tbWVudDU5ODg4MDEwNQ==","user":{"login":"Qinusty","id":7274845,"node_id":"MDQ6VXNlcjcyNzQ4NDU=","avatar_url":"https://avatars.githubusercontent.com/u/7274845?v=4","gravatar_id":"","url":"https://api.github.com/users/Qinusty","html_url":"https://github.com/Qinusty","followers_url":"https://api.github.com/users/Qinusty/followers","following_url":"https://api.github.com/users/Qinusty/following{/other_user}","gists_url":"https://api.github.com/users/Qinusty/gists{/gist_id}","starred_url":"https://api.github.com/users/Qinusty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Qinusty/subscriptions","organizations_url":"https://api.github.com/users/Qinusty/orgs","repos_url":"https://api.github.com/users/Qinusty/repos","events_url":"https://api.github.com/users/Qinusty/events{/privacy}","received_events_url":"https://api.github.com/users/Qinusty/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-03-13T19:31:52Z","updated_at":"2020-03-13T19:31:52Z","body":"After looking into this for a little bit, this seems to be caused by the combination of the effects of the `--remote_executor=` flag and the tag `no-remote-exec`.\r\n\r\nFrom what I can see, the `--remote-executor=` flag forces the `BlazeExecutor` class to be instantiated with it's spawn cache configured as `NoSpawnCache`. \r\n\r\nAdditionally, the use of `no-remote-exec` as a tag forces the `ProxySpawnActionContext.resolve()` function to filter out `RemoteSpawnStrategy` as a possible spawn execution strategy for the action. \r\n\r\nSo this leaves us with a Standalone/Sandboxed runner etc, making use of the `AbstractSpawnStrategy` logic for caching (The only alternative to this is the `RemoteSpawnRunner` class which handles remote caching in relation to remote exection).\r\n\r\nThe `AbstractSpawnStrategy` caching logic depends on the `SpawnCache` for the executor being configured as part of it's ContextMap. All in all, this leaves `no-remote-exec` actions falling into a code path without any remote caching configuration.\r\n\r\nI'll continue looking into this, just thought I'd document my findings so far.\r\n\r\n**NOTE**: All of this analysis was done on bazel version 1.2.1 but I have confirmed this issue exists in version 2.0 (Unsure about 3.0).\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/598880105/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Qinusty","id":7274845,"node_id":"MDQ6VXNlcjcyNzQ4NDU=","avatar_url":"https://avatars.githubusercontent.com/u/7274845?v=4","gravatar_id":"","url":"https://api.github.com/users/Qinusty","html_url":"https://github.com/Qinusty","followers_url":"https://api.github.com/users/Qinusty/followers","following_url":"https://api.github.com/users/Qinusty/following{/other_user}","gists_url":"https://api.github.com/users/Qinusty/gists{/gist_id}","starred_url":"https://api.github.com/users/Qinusty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Qinusty/subscriptions","organizations_url":"https://api.github.com/users/Qinusty/orgs","repos_url":"https://api.github.com/users/Qinusty/r