w_type":"public","site_admin":false}],"milestone":null,"comments":2,"created_at":"2021-10-14T19:40:21Z","updated_at":"2021-12-02T16:27:03Z","closed_at":"2021-12-02T16:27:03Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Split off of #2397.\r\nHere's @robertsami 's simple test case and his comment:\r\n```\r\n➜  bin/ysqlsh\r\nysqlsh (11.2-YB-2.7.3.0-b0)\r\nType \"help\" for help.\r\n\r\nyugabyte=# create table t1(k int primary key, v text);\r\nCREATE TABLE\r\nyugabyte=# insert into t1(k, v) values(1, 'dog');\r\nINSERT 0 1\r\nyugabyte=# do $body$\r\nyugabyte$# begin\r\nyugabyte$#   insert into t1(k, v) values(2, 'cat');\r\nyugabyte$#   begin\r\nyugabyte$#     insert into t1(k, v) values(1, 'frog');\r\nyugabyte$#   exception when unique_violation then\r\nyugabyte$#     null;\r\nyugabyte$#   end;\r\nyugabyte$# end;\r\nyugabyte$# $body$;\r\nFATAL:  RollbackAndReleaseCurrentSubTransaction: unexpected state STARTED\r\nCONTEXT:  PL/pgSQL function inline_code_block line 4 during exception cleanup\r\nserver closed the connection unexpectedly\r\n\tThis probably means the server terminated abnormally\r\n\tbefore or while processing the request.\r\nThe connection to the server was lost. Attempting reset: Succeeded.\r\n```\r\n\r\n>It looks like whatever path is calling `RollbackAndReleaseCurrentSubTransaction` on the exception triggered by duplicate insert is doing so when `CurrentTransactionState->blockState` is in the wrong state\r\n>\r\n>note that from `RollbackAndReleaseCurrentSubTransaction` it's expected we're in either `TBLOCK_SUBINPROGRESS` or `TBLOCK_SUBABORT` state before this is called\r\n","closed_by":{"login":"mtakahar","id":8877300,"node_id":"MDQ6VXNlcjg4NzczMDA=","avatar_url":"https://avatars.githubusercontent.com/u/8877300?v=4","gravatar_id":"","url":"https://api.g