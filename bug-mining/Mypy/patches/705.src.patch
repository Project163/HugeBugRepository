+def test_slicing() -> None:
+    # Use dummy adds to avoid constant folding
+    zero = int()
+    two = zero + 2
+    s = ["f", "o", "o", "b", "a", "r"]
+    assert s[two:] == ["o", "b", "a", "r"]
