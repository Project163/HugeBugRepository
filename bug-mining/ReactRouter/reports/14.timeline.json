 (potential) [`<Link hash>`](https://github.com/rackt/react-router/issues/2176#issuecomment-145948925) props and provide one place for people to put all their location-related data. It also makes it easy for people to see how they can wrap up \"named routes\" into a simple function:\n\n``` js\nfunction chapter(number, verse) {\n  return {\n    pathname: `/chapters/${number}`,\n    hash: `#verse-${verse}`\n  }\n}\n\n<Link to={chapter(1, 3)}>Chapter 1, verse 3</Link>\n```\n\nI personally like the idea. Just wanted to start some discussion here to see what others think.\n","reactions":{"url":"https://api.github.com/repos/remix-run/react-router/issues/2177/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/remix-run/react-router/issues/2177/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"actor":{"login":"zdavis","id":255909,"node_id":"MDQ6VXNlcjI1NTkwOQ==","avatar_url":"https://avatars.githubusercontent.com/u/255909?v=4","gravatar_id":"","url":"https://api.github.com/users/zdavis","html_url":"https://github.com/zdavis","followers_url":"https://api.github.com/users/zdavis/followers","following_url":"https://api.github.com/users/zdavis/following{/other_user}","gists_url":"https://api.github.com/users/zdavis/gists{/gist_id}","starred_url":"https://api.github.com/users/zdavis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zdavis/subscriptions","organizations_url":"https://api.github.com/users/zdavis/orgs","repos_url":"https://api.github.com/users/zdavis/repos","events_url":"https://api.github.com/users/zdavis/events{/privacy}","received_events_url":"https://api.github.com/users/zdavis/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-10-06T19:35:11Z","updated_at":"2015-10-06T19:35:11Z","source":{"type":"issue","issue":{"url":"https://api.github.com/rep