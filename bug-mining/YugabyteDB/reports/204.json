ts_url":"https://api.github.com/users/nocaway/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones/3","html_url":"https://github.com/yugabyte/yugabyte-db/milestone/3","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones/3/labels","id":4242639,"node_id":"MDk6TWlsZXN0b25lNDI0MjYzOQ==","number":3,"title":"v2.0","description":"YB 2.0 release","creator":{"login":"ndeodhar","id":15746068,"node_id":"MDQ6VXNlcjE1NzQ2MDY4","avatar_url":"https://avatars.githubusercontent.com/u/15746068?v=4","gravatar_id":"","url":"https://api.github.com/users/ndeodhar","html_url":"https://github.com/ndeodhar","followers_url":"https://api.github.com/users/ndeodhar/followers","following_url":"https://api.github.com/users/ndeodhar/following{/other_user}","gists_url":"https://api.github.com/users/ndeodhar/gists{/gist_id}","starred_url":"https://api.github.com/users/ndeodhar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ndeodhar/subscriptions","organizations_url":"https://api.github.com/users/ndeodhar/orgs","repos_url":"https://api.github.com/users/ndeodhar/repos","events_url":"https://api.github.com/users/ndeodhar/events{/privacy}","received_events_url":"https://api.github.com/users/ndeodhar/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":100,"state":"closed","created_at":"2019-04-18T21:03:32Z","updated_at":"2020-06-23T19:02:00Z","due_on":null,"closed_at":"2020-06-23T19:02:00Z"},"comments":3,"created_at":"2019-06-24T20:06:38Z","updated_at":"2019-08-09T17:57:27Z","closed_at":"2019-08-09T17:57:26Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**Summary:** When a table is divided into multiple tablets (this does not happen with only one tablet per table), it is possible for a whole-column update on a non-indexed column to cause a unique constraint violation on a different column, when no violation exists.\r\n\r\n**Test Case:**\r\n```\r\nCREATE TABLE test (\r\n  pk int PRIMARY KEY,\r\n  a int UNIQUE,\r\n  b int\r\n);\r\nINSERT INTO test VALUES (1, 2, 2), (2, 3, 3);\r\nUPDATE test SET b = 10;\r\n```\r\n\r\n**Actual Results:** The following error is returned after the `UPDATE` statement:\r\n```\r\nERROR:  duplicate key value violates unique constraint \"test_a_key\"\r\n```\r\n\r\n**Expected Results:** No error.\r\n\r\n**Note:** Updating each row individually (as in the SQL below) does not produce an error.\r\n```\r\nCREATE TABLE test (\r\n  pk int PRIMARY KEY,\r\n  a int UNIQUE,\r\n  b int\r\n);\r\nINSERT INTO test VALUES (1, 2, 2), (2, 3, 3);\r\nUPDATE test SET b = 10 WHERE pk = 1;\r\nUPDATE test SET b = 10 WHERE pk = 2;\r\n```\r\n**Note:** If no primary key column is specified, this error will only occur occasionally, hinting that this issue could be related to the placement of rows in different tablets.","closed_by":{"login":"nocaway","id":31016169,"node_id":"MDQ6VXNlcjMxMDE2MTY5","avatar_url":"https://avatars.githubusercontent.com/u/31016169?v=4","gravatar_id":"","url":"https://api.github.com/users/nocaway","html_url":"https://github.com/nocaway","followers_url":"https://api.github.com/users/nocaway/followers","following_url":"https://api.github.com/users/nocaway/following{/other_user}","gists_url":"https://api.github.com/users/nocaway/gists{/gist_id}","starred_url":"https://api.github.com/users/nocaway/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nocaway/subscriptions","organizations_url":"https://api.github.com/users/nocaway/orgs","repos_url":"https://api.github.com/users/nocaway/repos","events_url":"https://api.github.com/users/nocaway/events{/privacy}","received_events_url":"https://api.github.com/users/nocaway/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/1611/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/1611/timeline","performed_via_github_app":null,"state_reason":"completed"}