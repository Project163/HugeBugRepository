[{"id":1742293581,"node_id":"MDEyOkxhYmVsZWRFdmVudDE3NDIyOTM1ODE=","url":"https://api.github.com/repos/grafana/k6/issues/events/1742293581","actor":{"login":"na--","id":3336773,"node_id":"MDQ6VXNlcjMzMzY3NzM=","avatar_url":"https://avatars.githubusercontent.com/u/3336773?v=4","gravatar_id":"","url":"https://api.github.com/users/na--","html_url":"https://github.com/na--","followers_url":"https://api.github.com/users/na--/followers","following_url":"https://api.github.com/users/na--/following{/other_user}","gists_url":"https://api.github.com/users/na--/gists{/gist_id}","starred_url":"https://api.github.com/users/na--/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/na--/subscriptions","organizations_url":"https://api.github.com/users/na--/orgs","repos_url":"https://api.github.com/users/na--/repos","events_url":"https://api.github.com/users/na--/events{/privacy}","received_events_url":"https://api.github.com/users/na--/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2018-07-19T11:17:48Z","label":{"name":"bug","color":"b60205"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/grafana/k6/issues/comments/406399281","html_url":"https://github.com/grafana/k6/issues/717#issuecomment-406399281","issue_url":"https://api.github.com/repos/grafana/k6/issues/717","id":406399281,"node_id":"MDEyOklzc3VlQ29tbWVudDQwNjM5OTI4MQ==","user":{"login":"mariolopjr","id":2067324,"node_id":"MDQ6VXNlcjIwNjczMjQ=","avatar_url":"https://avatars.githubusercontent.com/u/2067324?v=4","gravatar_id":"","url":"https://api.github.com/users/mariolopjr","html_url":"https://github.com/mariolopjr","followers_url":"https://api.github.com/users/mariolopjr/followers","following_url":"https://api.github.com/users/mariolopjr/following{/other_user}","gists_url":"https://api.github.com/users/mariolopjr/gists{/gist_id}","starred_url":"https://api.github.com/users/mariolopjr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mariolopjr/subscriptions","organizations_url":"https://api.github.com/users/mariolopjr/orgs","repos_url":"https://api.github.com/users/mariolopjr/repos","events_url":"https://api.github.com/users/mariolopjr/events{/privacy}","received_events_url":"https://api.github.com/users/mariolopjr/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-07-19T20:11:25Z","updated_at":"2018-07-19T20:11:25Z","body":"Hi @piotrkedzia,\r\n\r\nAnother way to keep the image version the same, is to do the following:\r\n\r\nUnder the FROM grafana/grafana line, before the RUN apt-get line in the Dockerfile.grafana, add the following: ```USER root```\r\n\r\nI think in the latest images for grafana, they are using a new grafana user which breaks this build. Do NOT switch back to ```USER grafana``` later on in the Dockerfile, it will not work and break the linking between grafana and indexdb.\r\n\r\nEntire Dockerfile below:\r\n```Dockerfile\r\nFROM grafana/grafana\r\nUSER root\r\nRUN apt-get update && apt-get -y install curl\r\n\r\n# Change the default data directory (otherwise grafana.db won't persist)\r\nRUN mkdir /var/lib/grafanadb\r\nENV GF_PATHS_DATA /var/lib/grafanadb\r\n\r\n# Init Grafana sqlite db and preconfigure our data source to be our influxdb k6 db\r\nRUN bash -c '/run.sh & sleep 15 && curl -s -H \"Content-Type: application/json\" -X POST \\\r\n    --data '\"'\"'{\"name\": \"myinfluxdb\", \"type\": \"influxdb\", \"access\": \"proxy\", \"url\": \"http://influxdb:8086\", \"database\": \"k6\", \"isDefault\": true}'\"'\"' \\\r\n    http://admin:admin@localhost:3000/api/datasources \\\r\n    && kill -SIGINT %%'\r\n\r\n\r\nCMD [\"/run.sh\"]\r\n```\r\n\r\n***NOTE***: There _may_ be security implications with this change, I really don't know. Use at your own risk. 😈 ","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/grafana/k6/issues/comments/406399281/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"mariolopjr","id":2067324,"node_id":"MDQ6VXNlcjIwNjczMjQ=","avatar_url":"https://avatars.githubusercontent.com/u/2067324?v=4","gravatar_id":"","url":"https://api.github.com/users/mariolopjr","html_url":"https://github.com/mariolopjr","followers_url":"https://api.github.com/users/mariolopjr/followers","following_url":"https://api.github.com/users/mariolopjr/following{/other_user}","gists_url":"https://api.github.com/users/mariolopjr/gists{/gist_id}","starred_url":"https://api.github.com/users/mariolopjr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mariolopjr/subscriptions","organizations_url":"https://api.github.com/users/mariolopjr/orgs","repos_url":"https://api.github.com/users/mariolopjr/repos","events_url":"https://api.github.com/users/mariolopjr/events{/privacy}","received_events_url":"https://api.github.com/users/mariolopjr/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1743434052,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50MTc0MzQzNDA1Mg==","url":"https://api.github.com/repos/grafana/k6/issues/events/1743434052","actor":{"login":"piotrkedzia","id":8421929,"node_id":"MDQ6VXNlcjg0MjE5Mjk=","avatar_url":"https://avatars.githubusercontent.com/u/8421929?v=4","gravatar_id":"","url":"https://api.github.com/users/piotrkedzia","html_url":"https://github.com/piotrkedzia","followers_url":"https://api.github.com/users/piotrkedzia/followers","following_url":"https://api.github.com/users/piotrkedzia/following{/other_user}","gists_url":"https://api.github.com/users/piotrkedzia/gists{/gist_id}","starred_url":"https://api.github.com/users/piotrkedzia/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/piotrkedzia/subscriptions","organizations_url":"https://api.github.com/users/piotrkedzia/orgs","repos_url":"https://api.gi