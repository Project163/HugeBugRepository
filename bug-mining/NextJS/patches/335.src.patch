+}): Promise<PageStaticInfo> {
+  const pageStaticInfo = await getPageStaticInfo({
+    nextConfig: config,
+    pageFilePath,
+    isDev,
+    page,
+    pageType: isInsideAppDir ? 'app' : 'pages',
