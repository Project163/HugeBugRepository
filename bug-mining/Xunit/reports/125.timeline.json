AATxQvVZ","url":"https://api.github.com/repos/xunit/xunit/issues/events/21227566425","actor":{"login":"bradwilson","id":16944,"node_id":"MDQ6VXNlcjE2OTQ0","avatar_url":"https://avatars.githubusercontent.com/u/16944?v=4","gravatar_id":"","url":"https://api.github.com/users/bradwilson","html_url":"https://github.com/bradwilson","followers_url":"https://api.github.com/users/bradwilson/followers","following_url":"https://api.github.com/users/bradwilson/following{/other_user}","gists_url":"https://api.github.com/users/bradwilson/gists{/gist_id}","starred_url":"https://api.github.com/users/bradwilson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bradwilson/subscriptions","organizations_url":"https://api.github.com/users/bradwilson/orgs","repos_url":"https://api.github.com/users/bradwilson/repos","events_url":"https://api.github.com/users/bradwilson/events{/privacy}","received_events_url":"https://api.github.com/users/bradwilson/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2025-11-27T19:13:45Z","state_reason":null,"performed_via_github_app":null},{"url":"https://api.github.com/repos/xunit/xunit/issues/comments/3588409489","html_url":"https://github.com/xunit/xunit/issues/3448#issuecomment-3588409489","issue_url":"https://api.github.com/repos/xunit/xunit/issues/3448","id":3588409489,"node_id":"IC_kwDOAJbtsc7V4siR","user":{"login":"i-love-dnb","id":48851483,"node_id":"MDQ6VXNlcjQ4ODUxNDgz","avatar_url":"https://avatars.githubusercontent.com/u/48851483?v=4","gravatar_id":"","url":"https://api.github.com/users/i-love-dnb","html_url":"https://github.com/i-love-dnb","followers_url":"https://api.github.com/users/i-love-dnb/followers","following_url":"https://api.github.com/users/i-love-dnb/following{/other_user}","gists_url":"https://api.github.com/users/i-love-dnb/gists{/gist_id}","starred_url":"https://api.github.com/users/i-love-dnb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/i-love-dnb/subscriptions","organizations_url":"https://api.github.com/users/i-love-dnb/orgs","repos_url":"https://api.github.com/users/i-love-dnb/repos","events_url":"https://api.github.com/users/i-love-dnb/events{/privacy}","received_events_url":"https://api.github.com/users/i-love-dnb/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-28T08:47:56Z","updated_at":"2025-11-28T08:47:56Z","body":"Hi @bradwilson , thank you for fixing the issue! I should have given you the background in the first place. So here is the simplified real use case:\n\n``` cs\nusing System;\nusing System.Diagnostics;\nusing System.Net;\nusing System.Threading;\nusing System.Threading.Tasks;\n\nusing Microsoft.Azure.Cosmos; // <PackageReference Include=\"Microsoft.Azure.Cosmos\" Version=\"3.56.0\" />\n\nusing Moq; // <PackageReference Include=\"Moq\" Version=\"4.20.72\" />\n\nusing Xunit; // <PackageReference Include=\"xunit.v3\" Version=\"3.2.0\" />\n\nnamespace CosmosTests;\n\npublic static class ContainerExtensions\n{\n    public static async Task<T> GetEntityAsync<T>(this Container container, string id, string pk, CancellationToken cancel)\n    {\n        try\n        {\n            return await container.ReadItemAsync<T>(id, new(pk), default, cancel).ConfigureAwait(false);\n        }\n        catch (CosmosException e) when (e.StatusCode == HttpStatusCode.NotFound)\n        {\n            return default;\n        }\n    }\n}\n\npublic sealed class ContainerExtensionsTest\n{\n    private readonly Mock<Container> container = new();\n\n    [Theory]\n    [InlineData(HttpStatusCode.BadRequest)]\n    public async Task GetEntityAsync_ShouldRethrow_WhenStatusIsNotSupported(HttpStatusCode status)\n    {\n        // Arrange\n        container.Setup(c => c.ReadItemAsync<object>(It.IsAny<string>(), It.IsAny<PartitionKey>(), It.IsAny<ItemRequestOptions>(), It.IsAny<CancellationToken>()))\n            .ThrowsAsync(new CosmosException(message: default, statusCode: status, default, default, default));\n\n        // Act\n        Task ExecuteAsync() => container.Object.GetEntityAsync<object>(\"id\", \"pk\", TestContext.Current.CancellationToken);\n\n        // Assert\n        try\n        {\n            await Assert.ThrowsAsync<CosmosException>(ExecuteAsync);\n        }\n        catch (NullReferenceException)\n        {\n            Debugger.Break();\n            throw;\n        }\n\n        container.Verify(c => c.ReadItemAsync<object>(It.IsAny<string>(), It.IsAny<PartitionKey>(), It.IsAny<ItemRequestOptions>(), It.IsAny<CancellationToken>()), Times.Once());\n        container.VerifyNoOtherCalls();\n    }\n}\n\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/xunit/xunit/issues/comments/3588409489/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"i-love-dnb","id":48851483,"node_id":"MDQ6VXNlcjQ4ODUxNDgz","avatar_url":"https://avatars.githubusercontent.com/u/48851483?v=4","gravatar_id":"","url":"https://api.github.com/users/i-love-dnb","html_url":"https://github.com/i-love-dnb","followers_url":"https://api.github.com/users/i-love-dnb/followers","following_url":"https://api.github.com/users/i-love-dnb/following{/other_user}","gists_url":"https://api.github.com/users/i-love-dnb/gists{/gist_id}","starred_url":"https://api.github.com/users/i-love-dnb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/i-love-dnb/subscriptions","organizations_url":"https://api.github.com/users/i-love-dnb/orgs","repos_url":"https://api.github.com/users/i-love-dnb/repos","events_url":"https://api.github.com/users/i-love-dnb/events{/privacy}","received_events_url":"https://api.github.com/users/i-love-dnb/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":21237688194,"node_id":"MEE_l