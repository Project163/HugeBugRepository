a bug then it's benign in production anyway since we're shutting down so everything will be cleaned up soon, but it's still untidy and might cause test issues.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/77539/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/elastic/elasticsearch/issues/77539/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}