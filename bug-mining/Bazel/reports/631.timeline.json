.com/users/katre/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/443830058","html_url":"https://github.com/bazelbuild/bazel/issues/6831#issuecomment-443830058","issue_url":"https://api.github.com/repos/bazelbuild/bazel/issues/6831","id":443830058,"node_id":"MDEyOklzc3VlQ29tbWVudDQ0MzgzMDA1OA==","user":{"login":"katre","id":326527,"node_id":"MDQ6VXNlcjMyNjUyNw==","avatar_url":"https://avatars.githubusercontent.com/u/326527?v=4","gravatar_id":"","url":"https://api.github.com/users/katre","html_url":"https://github.com/katre","followers_url":"https://api.github.com/users/katre/followers","following_url":"https://api.github.com/users/katre/following{/other_user}","gists_url":"https://api.github.com/users/katre/gists{/gist_id}","starred_url":"https://api.github.com/users/katre/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/katre/subscriptions","organizations_url":"https://api.github.com/users/katre/orgs","repos_url":"https://api.github.com/users/katre/repos","events_url":"https://api.github.com/users/katre/events{/privacy}","received_events_url":"https://api.github.com/users/katre/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-12-03T19:05:49Z","updated_at":"2018-12-03T19:05:49Z","body":"Okay, that commit fixes the problem by causing the `toolchain` rule to not require toolchain resolution. While this is the correct result, it's not a good general solution, because based on this, any use of `register_execution_platforms` with a wildcard target that expands to a target which _does_ require toolchain resolution will fail with this cycle error.\r\n\r\nThe target pattern expansion for `register_execution_platforms` needs to be fixed. Either:\r\n1. Detect which targets require toolchains, and ignore them, or\r\n2. Only allow target patterns to match targets which explicitly use the `platform` rule.\r\n\r