-	search := path
-
-	for t, nds := range nn.children {
-		ntyp := nodeTyp(t)
-		if len(nds) == 0 {
-			continue
-		}
-
-		var xn *node
-		xsearch := search
-
-		var label byte
-		if search != "" {
-			label = search[0]
-		}
-
-		switch ntyp {
-		case ntStatic:
-			xn = nds.findEdge(label)
-			if xn == nil || !strings.HasPrefix(xsearch, xn.prefix) {
-				continue
-			}
-			xsearch = xsearch[len(xn.prefix):]
