-                  topItemsPerThing.enqueue(candidate)
-                } else if (orderByScore.lt(candidate, topItemsPerThing.head)) {
-                  topItemsPerThing.dequeue()
-                  topItemsPerThing.enqueue(candidate)
-                }
-              }
-            }
-          }
