pi.github.com/users/geiseri/subscriptions","organizations_url":"https://api.github.com/users/geiseri/orgs","repos_url":"https://api.github.com/users/geiseri/repos","events_url":"https://api.github.com/users/geiseri/events{/privacy}","received_events_url":"https://api.github.com/users/geiseri/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/microsoft/vcpkg/issues/comments/593187897","html_url":"https://github.com/microsoft/vcpkg/issues/10091#issuecomment-593187897","issue_url":"https://api.github.com/repos/microsoft/vcpkg/issues/10091","id":593187897,"node_id":"MDEyOklzc3VlQ29tbWVudDU5MzE4Nzg5Nw==","user":{"login":"mschofie","id":6693197,"node_id":"MDQ6VXNlcjY2OTMxOTc=","avatar_url":"https://avatars.githubusercontent.com/u/6693197?v=4","gravatar_id":"","url":"https://api.github.com/users/mschofie","html_url":"https://github.com/mschofie","followers_url":"https://api.github.com/users/mschofie/followers","following_url":"https://api.github.com/users/mschofie/following{/other_user}","gists_url":"https://api.github.com/users/mschofie/gists{/gist_id}","starred_url":"https://api.github.com/users/mschofie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mschofie/subscriptions","organizations_url":"https://api.github.com/users/mschofie/orgs","repos_url":"https://api.github.com/users/mschofie/repos","events_url":"https://api.github.com/users/mschofie/events{/privacy}","received_events_url":"https://api.github.com/users/mschofie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-03-02T02:16:33Z","updated_at":"2020-03-02T02:16:33Z","body":"I repro the same error on a Windows 10 host environment. It looks like the wrong clang `--target` command-line is being built into the `user-config.jam`. Clang wants `--target=<value>` but `--target= <value>` is being passed (i.e. extra space after the `=`). It looks like [`ports/boost-modular-build-helper/CMakeLists.txt`](https://github.com/microsoft/vcpkg/blob/c3ac3b24ffbc1c6e4fb759c8cd8e7a5aff9a3b94/ports/boost-modular-build-helper/CMakeLists.txt#L86) is responsible for specifying the target:\r\n\r\n```\r\n    set(CXXFLAGS \"${CXXFLAGS} <compileflags>${CMAKE_CXX_COMPILE_OPTIONS_TARGET} <compileflags>${CMAKE_CXX_COMPILER_TARGET}\")\r\n```\r\n\r\nWhich appears to be how gcc expects the target to be passed. So adding a check for Clang, and passing the target in a Clang-like way fixes things for me, i.e.\r\n\r\n```\r\nif(CMAKE_CXX_COMPILER_TARGET)\r\n    if(CMAKE_CXX_COMPILER_ID STREQUAL \"Clang\")\r\n        set(CXXFLAGS \"${CXXFLAGS} <compileflags>${CMAKE_CXX_COMPILE_OPTIONS_TARGET}${CMAKE_CXX_COMPILER_TARGET}\")\r\n    else()\r\n        set(CXXFLAGS \"${CXXFLAGS} <compileflags>${CMAKE_CXX_COMPILE_OPTIONS_TARGET} <compileflags>${CMAKE_CXX_COMPILER_TARGET}\")\r\n    endif()\r\nendif()\r\n```\r\n\r\nBut I'm a bit out of my depth here - so it's not clear if this is the Right Thing to do. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/microsoft/vcpkg/issues/comments/593187897/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"mschofie","id":6693197,"node_id":"MDQ6VXNlcjY2OTMxOTc=","avatar_url":"https://avatars.githubusercontent.com/u/6693197?v=4","gravatar_id":"","url":"https://api.github.com/users/mschofie","html_url":"https://github.com/mschofie","followers_url":"https://api.github.com/users/mschofie/followers","following_url":"https://api.github.com/users/mschofie/following{/other_user}","gists_url":"https://api.github.com/users/mschofie/gists{/gist_id}","starred_url":"https://api.github.com/users/mschofie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mschofie/subscriptions","organizations_url":"https://api.github.com/users/mschofie/orgs","repos_url":"https://api.github.com/users/mschof