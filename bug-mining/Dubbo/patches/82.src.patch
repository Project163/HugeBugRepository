+        ClassLoader workingClassLoader = (ClassLoader) invocation.get(WORKING_CLASSLOADER_KEY);
+        if (workingClassLoader != null) {
+            Thread.currentThread().setContextClassLoader(workingClassLoader);
+        }
+    }
+}
