.github.com/users/HcySunYang/subscriptions","organizations_url":"https://api.github.com/users/HcySunYang/orgs","repos_url":"https://api.github.com/users/HcySunYang/repos","events_url":"https://api.github.com/users/HcySunYang/events{/privacy}","received_events_url":"https://api.github.com/users/HcySunYang/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2021-03-30T02:33:56Z","label":{"name":":exclamation: p4-important","color":"8155e0"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/vuejs/core/issues/comments/810053634","html_url":"https://github.com/vuejs/core/issues/3513#issuecomment-810053634","issue_url":"https://api.github.com/repos/vuejs/core/issues/3513","id":810053634,"node_id":"MDEyOklzc3VlQ29tbWVudDgxMDA1MzYzNA==","user":{"login":"HcySunYang","id":14146560,"node_id":"MDQ6VXNlcjE0MTQ2NTYw","avatar_url":"https://avatars.githubusercontent.com/u/14146560?v=4","gravatar_id":"","url":"https://api.github.com/users/HcySunYang","html_url":"https://github.com/HcySunYang","followers_url":"https://api.github.com/users/HcySunYang/followers","following_url":"https://api.github.com/users/HcySunYang/following{/other_user}","gists_url":"https://api.github.com/users/HcySunYang/gists{/gist_id}","starred_url":"https://api.github.com/users/HcySunYang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HcySunYang/subscriptions","organizations_url":"https://api.github.com/users/HcySunYang/orgs","repos_url":"https://api.github.com/users/HcySunYang/repos","events_url":"https://api.github.com/users/HcySunYang/events{/privacy}","received_events_url":"https://api.github.com/users/HcySunYang/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-03-30T09:08:33Z","updated_at":"2021-03-30T11:42:20Z","body":"A hint, this problem occurs when rendering components with manually written render function between ssr optimized components. E.g.\r\n\r\n`ComA` is scoped, and SSR-optimized:\r\n\r\n```js\r\nconst _withId =_withScopeId(\"scope-id\")\r\n\r\nconst CompA = {\r\n  ssrRender = _withId((_ctx, _push, _parent, _attrs) => {\r\n    const RouterView = _resolveComponent(\"RouterView\")\r\n    // Render the <RouterView> component\r\n    _push(_ssrRenderComponent(RouterView, _attrs, null, _parent))\r\n  })\r\n}\r\n```\r\n\r\n`RouterView` has a hand-written render function:\r\n\r\n```js\r\nconst RouterView = {\r\n  render() { return h(ViewComp) }\r\n}\r\n```\r\n\r\n`ViewComp` is also optimized by SSR:\r\n\r\n```js\r\nconst ViewComp = {\r\n  ssrRender(_ctx, _push, _parent, _attrs) {\r\n    _push(`<p${_attrs}></p>`)\r\n  }\r\n}\r\n```\r\n\r\nThis issue occurs in the [renderComponentSubTree](https://github.com/vuejs/vue-next/blob/master/packages/server-renderer/src/render.ts#L104) function, alternating rendering of SSR-optimized and non-SSR-optimized components will break the inheritance of `scopeId`. \r\n\r\n**Edit: The following test case can be used as a minimum reproduction:**\r\n\r\n```js\r\n  test('repro', async () => {\r\n    const Child = {\r\n      ssrRender: (ctx: any, push: any, parent: any, attrs: any) => {\r\n        push(`<div${ssrRenderAttrs(attrs)}></div>`)\r\n      }\r\n    }\r\n\r\n    const Middle = {\r\n      render() {\r\n        return h(Child)\r\n      }\r\n    }\r\n\r\n    const Comp = {\r\n      __scopeId: 'parent',\r\n      ssrRender: (ctx: any, push: any, parent: any) => {\r\n        push(ssrRenderComponent(Middle, null, null, parent))\r\n      }\r\n    }\r\n\r\n    const result = await renderToString(createApp(Comp)) // output: `<div></div>`\r\n    expect(result).toBe(`<div parent></div>`)\r\n  })\r\n```","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/vuejs/core/issues/comments/810053634/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"HcySunYang","id":14146560,"node_id":"MDQ6VXNlcjE0MTQ2NTYw","avatar_url":"https://avatars.githubusercontent.com/u/14146560?v=4","gravatar_id":"","url":"https://api.github.com/users/HcySunYang","html_url":"https://github.com/HcySunYang","followers_url":"https://api.github.com/users/HcySunYang/followers","following_url":"https://api.github.com/users/HcySunYang/following{/other_user}","gists_url":"https://api.github.com/users/HcySunYang/gists{/gist_id}","starred_url":"https://api.github.com/users/HcySunYang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HcySunYang/subscriptions","organizations_url":"https://api.github.com/users/HcySunYang/orgs","repos_url":"https://api.github.com/users/HcySunYang/repos","events_url":"https://api.github.com/users/HcySunYang/events{/privacy}","received_events_url":"https://api.github.com/users/HcySunYang/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":4526502355,"node_id":"MDEyOkxhYmVsZWRFdmVudDQ1MjY1MDIzNTU=","url":"https://api.github.com/repos/vuejs/core/issues/events/4526502355","actor":{"login":"HcySunYang","id":14146560,"node_id":"MDQ6VXNlcjE0MTQ2NTYw","avatar_url":"https://avatars.githubusercontent.com/u/14146560?v=4","gravatar_id":"","url":"https://api.github.com/users/HcySunYang","html_url":"https://github.com/HcySunYang","followers_url":"https://api.github.com/users/HcySunYang/followers","following_url":"https://api.github.com/users/HcySunYang/following{/other_user}","gists_url":"https://api.github.com/users/HcySunYang/gists{/gist_id}","starred_url":"https://api.github.com/users/HcySunYang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HcySunYang/subscriptions","organizations_url":"https://api.github.com/users/HcySunYang/orgs","repos_url":"https://api.github.com/users/HcySunYang/repos","events_url":"https://api.github.com/users/HcySunYang/events{/privacy}","received_events_url":"https://api.github.com/users/HcySunYang/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2021-03-30T09:58:53Z","label":{"name":"feat: ssr","color":"7441a8"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/vuejs/core/issues/comments/810167160","html_url":"https://github.com/vuejs/core/issues/3513#issuecomment-810167160","issue_url":"https://api.github.com/repos/vuejs/core/issues/3513","id":810167160,"node_id":"MDEyOklzc3VlQ29tbWVudDgxMDE2NzE2MA==","user":{"login":"HcySunYang","id":14146560,"node_id":"MDQ6VXNlcjE0MTQ2NTYw","avatar_url":"https://avatars.githubusercontent.com/u/14146560?v=4","gravatar_id":"","url":"https://api.github.com/users/HcySunYang","html_url":"https://github.com/HcySunYang","followers_url":"https://api.github.com/users/HcySunYang/followers","following_url":"https://api.github.com/users/HcySunYang/following{/other_user}","gists_url":"https://api.github.com/users/HcySunYang/gists{/gist_id}","starred_url":"https://api.github.com/users/HcySunYang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HcySunYang/subscriptions","organizations_url":"https://api.github.com/users/HcySunYang/orgs","repos_url":"https://api.github.com/users/HcySunYang/repos","events_url":"https://api.github.com/users/HcySunYang/events{/privacy}","received_events_url":"https://api.github.com/users/HcySunYang/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-03-30T12:07:48Z","updated_at":"2021-03-30T12:07:48Z","body":"The [resolveScopeId](https://github.com/vuejs/vue-next/blob/master/packages/server-renderer/src/render.ts#L290) function is also problematic. When a component is SSR-optimized, it will no longer have `subTree`, this will cause the inheritance of scopeId to be broken, the following example can be used to reproduce:\r\n\r\n```js\r\nconst Child = {\r\n  render() {\r\n    return h('div')\r\n  }\r\n}\r\n\r\nconst Comp2 = {\r\n  __scopeId: 'parent2',\r\n  ssrRender: (ctx: any, push: any, parent: any) => {\r\n    push(ssrRenderComponent(Child, null, null, parent))\r\n  }\r\n}\r\n\r\nconst Comp = {\r\n  __scopeId: 'parent',\r\n  ssrRender: (ctx: any, push: any, parent: any) => {\r\n    push(ssrRenderComponent(Comp2, null, null, parent))\r\n  }\r\n}\r\n\r\nasync function run () {\r\n  // Should output: `<div parent parent2></div>`\r\n  // Actual behavior: `<div parent2></div>`\r\n  console.log(await renderToString(createApp(Comp)))\r\n}\r\nrun()\r\n```","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/vuejs/core/issues/comments/810167160/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"HcySunYang","id":14146560,"node_id":"MDQ6VXNlcjE0MTQ2NTYw","avatar_url":"https://avatars.githubusercontent.com/u/14146560?v=4","gravatar_id":"","url":"https://api.github.com/users/HcySunYang","html_url":"https://github.com/HcySunYang","followers_url":"https://api.github.com/users/HcySunYang/followers","following_url":"https://api.github.com/users/HcySunYang/following{/other_user}","gists_url":"https://api.github.com/users/HcySunYang/gists{/gist_id}","starred_url":"https://api.github.com/users/HcySunYang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HcySunYang/subscriptions","organizations_url":"https://api.github.com/users/HcySunYang/orgs","repos_url":"https://api.github.com/users/HcySunYang/repos","events_url":"https://api.github.com/users/HcySunYang/events{/privacy}","received_events_url":"https://api.github.com/users/HcySunYang/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/vuejs/core/issues/comments/810168134","html_url":"https://github.com/vuejs/core/issues/3513#issuecomment-810168134","issue_url":"https://api.github.com/repo