tion":null}],"state":"closed","locked":false,"assignee":null,"assignees":[],"milestone":{"url":"https://api.github.com/repos/storybookjs/storybook/milestones/14","html_url":"https://github.com/storybookjs/storybook/milestone/14","labels_url":"https://api.github.com/repos/storybookjs/storybook/milestones/14/labels","id":4111869,"node_id":"MDk6TWlsZXN0b25lNDExMTg2OQ==","number":14,"title":"5.0.x","description":"","creator":{"login":"shilman","id":488689,"node_id":"MDQ6VXNlcjQ4ODY4OQ==","avatar_url":"https://avatars.githubusercontent.com/u/488689?v=4","gravatar_id":"","url":"https://api.github.com/users/shilman","html_url":"https://github.com/shilman","followers_url":"https://api.github.com/users/shilman/followers","following_url":"https://api.github.com/users/shilman/following{/other_user}","gists_url":"https://api.github.com/users/shilman/gists{/gist_id}","starred_url":"https://api.github.com/users/shilman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shilman/subscriptions","organizations_url":"https://api.github.com/users/shilman/orgs","repos_url":"https://api.github.com/users/shilman/repos","events_url":"https://api.github.com/users/shilman/events{/privacy}","received_events_url":"https://api.github.com/users/shilman/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":318,"state":"closed","created_at":"2019-03-05T12:38:50Z","updated_at":"2023-06-15T11:50:14Z","due_on":null,"closed_at":"2019-06-05T15:00:45Z"},"comments":6,"created_at":"2019-03-06T17:40:20Z","updated_at":"2020-07-24T23:58:43Z","closed_at":"2019-03-10T00:45:35Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"The border of `#storybook-preview-iframe` reduces the width and height of the document by 20px thanks to `* { box-sizing: border-box; }`.\r\n\r\nThis means that a viewport is not the size it says it is.\r\n\r\nWith the following viewport defined:\r\n```js\r\nviewports: {\r\n  bp1: {\r\n    name: 'Breakpoint 1',\r\n    styles: {\r\n      width: '320px',\r\n      height: '480px',\r\n    },\r\n  }\r\n}\r\n```\r\nThe iFrame document should be 320px by 460px, but instead it actually is 300px by 460px.\r\n\r\n![image](https://user-images.githubusercontent.com/46780058/53901383-c2ac6380-4036-11e9-8b4e-15091ba93cf7.png)\r\n\r\n![image](https://user-images.githubusercontent.com/46780058/53901339-adcfd000-4036-11e9-98e3-8c93fd58dd06.png)\r\n\r\n\r\n**System:**\r\n - OS: MacOS\r\n - Device: Macbook Pro 13\" 2017\r\n - Browser: Chrome\r\n - Framework: react\r\n - Addons: @storybook/addon-viewport\r\n - Version: ^5.0.0\r\n","closed_by":{"login":"shilman","id":488689,"node_id":"MDQ6VXNlcjQ4ODY4OQ==","avatar_url":"https://avatars.githubusercontent.com/u/488689?v=4","gravatar_id":"","url":"https://api.github.com/users/shilman","html_url":"https://github.com/shilman","followers_url":"https://api.github.com/users/shilman/followers","following_url":"https://api.github.com/users/shilman/following{/other_user}","gists_url":"https://api.github.com/users/shilman/gists{/gist_id}","starred_url":"https://api.github.com/users/shilman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shilman/subscriptions","organizations_url":"https://api.github.com/users/shilman/orgs","repos_url":"https://api.github.com/users/shilman/repos","events_url":"https://api.github.com/users/shilman/events{/privacy}","received_events_url":"https://api.github.com/users/shilman/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/storybookjs/storybook/issues/5927/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/storybookjs/storybook/issues/59