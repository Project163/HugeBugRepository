/pulls{/number}","milestones_url":"https://api.github.com/repos/vimeo/psalm/milestones{/number}","notifications_url":"https://api.github.com/repos/vimeo/psalm/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/vimeo/psalm/labels{/name}","releases_url":"https://api.github.com/repos/vimeo/psalm/releases{/id}","deployments_url":"https://api.github.com/repos/vimeo/psalm/deployments","created_at":"2016-11-21T17:04:41Z","updated_at":"2025-12-12T13:56:46Z","pushed_at":"2025-12-11T08:59:09Z","git_url":"git://github.com/vimeo/psalm.git","ssh_url":"git@github.com:vimeo/psalm.git","clone_url":"https://github.com/vimeo/psalm.git","svn_url":"https://github.com/vimeo/psalm","homepage":"https://psalm.dev","size":116606,"stargazers_count":5784,"watchers_count":5784,"language":"PHP","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":684,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1949,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["hacktoberfest","php","security-analysis","static-analysis","taint-analysis","type-inference"],"visibility":"public","forks":684,"open_issues":1949,"watchers":5784,"default_branch":"6.x","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Mentioned in TypeScript [here](https://www.youtube.com/watch?v=hDACN-BGvI8#t=23m0s) (thanks @ocramius)\r\n\r\nRelated to https://github.com/vimeo/psalm/issues/730#issuecomment-388483171\r\n\r\n```php\r\n<?php\r\n  namespace NS;\r\n  /**\r\n   * @template T\r\n   * @psalm-param callable():T $action\r\n   * @psalm-return T\r\n   */\r\n  function retry(int $maxRetries, callable $action) {\r\n    try {\r\n      return $action();\r\n    } catch (\\Throwable $e) {\r\n      if ($maxRetries-- > 0) {\r\n        return retry($maxRetries, $action);\r\n      }\r\n      throw $e;\r\n    }\r\n  }\r\n\r\n  function takesInt(int $p): void{};\r\n  \r\n  takesInt(retry(1, function(): int { return 1; }));\r\n```\r\n\r\nExpected: no issues\r\nActual: [`Could not verify return type 'T' for NS\\retry` (among others)](https://getpsalm.org/r/0999ce12f7)\r\n\r\nExplicit version (no templated types) can be verified: https://getpsalm.org/r/556485b35e","reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/732/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vimeo/psalm/issues/732/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]