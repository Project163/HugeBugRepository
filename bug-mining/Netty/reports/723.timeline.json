  @Value(\"${ssh.local.host}\")\r\n    private String localHost;\r\n\r\n    @Value(\"${ssh.local.port}\")\r\n    private String localPortString;\r\n\r\n    private Channel channel;\r\n\r\n    private Processor processor;\r\n\r\n    @Inject\r\n    private MapperService mapperService;\r\n\r\n    @Inject\r\n    private IsoQueueRepository isoQueueRepository;\r\n\r\n    public boolean init() {\r\n        EventLoopGroup eventLoopGroup = EPOLL ? new EpollEventLoopGroup() : new NioEventLoopGroup();\r\n\r\n        try {\r\n            int port = Integer.parseInt(localPortString);\r\n\r\n            channel = new Bootstrap()\r\n                .group(eventLoopGroup)\r\n                .channel(EPOLL ? EpollSocketChannel.class : NioSocketChannel.class)\r\n                .option(ChannelOption.SO_KEEPALIVE, Boolean.TRUE)\r\n                .option(ChannelOption.CONNECT_TIMEOUT_MILLIS, 5000)\r\n                .option(ChannelOption.SO_TIMEOUT, 5000)\r\n                .handler(new ChannelInitializer<Channel>() {\r\n                    @Override\r\n                    protected void initChannel(Channel channel) throws Exception {\r\n                        channel\r\n                            .pipeline()\r\n                            .addLast(new StringDecoder(StandardCharsets.UTF_8))\r\n                            .addLast(new StringEncoder(StandardCharsets.UTF_8))\r\n                            .addLast(new NettyNetworkHandler());\r\n                    }\r\n                }).connect(localHost, port).sync().channel();\r\n\r\n            return channel.isActive();\r\n        } catch (Exception e) {\r\n            e.printStackTrace();\r\n\r\n            return false;\r\n        } finally {\r\n//            eventLoopGroup.shutdownGracefully();\r\n        }\r\n    }\r\n\r\n    public void send(IsoQueue isoQueue, String iso) throws InterruptedException {\r\n        if (channel == null) {\r\n            if (init()) {\r\n                processSend(isoQueue, iso);\r\n            }\r\n        } else {\r\n            if (!channel.isActive() || !channel.isOpen()) {\r\n                close();\r\n\r\n                if (init()) {\r\n                    processSend(isoQueue, iso);\r\n                }\r\n            } else {\r\n                processSend(isoQueue, iso);\r\n            }\r\n        }\r\n    }\r\n\r\n    private void processSend(IsoQueue isoQueue, String iso) {\r\n        if (channel.isWritable()) {\r\n            processor = getProcessor(isoQueue);\r\n\r\n            Message isoMessage = processor.stringToMessage(iso);\r\n\r\n            isoQueue.setIso(iso);\r\n\r\n            String systemTraceAuditNumber = isoMessage.getDataElementContent().get(11);\r\n\r\n            isoQueue.setIdentificationNumber(systemTraceAuditNumber);\r\n\r\n            isoQueue = isoQueueRepository.save(isoQueue);\r\n\r\n            ChannelFuture channelFuture = channel.writeAndFlush(iso);\r\n\r\n            try {\r\n                channelFuture.await();\r\n            } catch (InterruptedException e) {\r\n                e.printStackTrace();\r\n            }\r\n        }\r\n    }\r\n\r\n    private Processor getProcessor(IsoQueue isoQueue) {\r\n        String type = isoQueue.getType();\r\n\r\n        processor = new Processor();\r\n\r\n        switch (type) {\r\n            case Constants.ISO_QUEUE_TYPE.LOGON:\r\n            case Constants.ISO_QUEUE_TYPE.ECHO:\r\n            case Constants.ISO_QUEUE_TYPE.LOGOFF:\r\n                processor.setMapper(mapperService.network());\r\n                break;\r\n            default:\r\n                processor.setMapper(mapperService.financial());\r\n                break;\r\n        }\r\n\r\n        return processor;\r\n    }\r\n\r\n    public boolean isActive() {\r\n        return channel.isActive();\r\n    }\r\n\r\n    public boolean isWritable() {\r\n        return channel.isWritable();\r\n    }\r\n\r\n    public void close() {\r\n        channel.flush();\r\n\r\n        if (channel.isOpen()) {\r\n            channel.closeFuture();\r\n            channel.close();\r\n        }\r\n    }\r\n\r\n}\r\n```\r\n\r\n```java\r\n// NettyNetworkHandler.java\r\n\r\nimport io.netty.channel.Channel;\r\nimport io.netty.channel.ChannelHandlerContext;\r\nimport io.netty.channel.SimpleChannelInboundHandler;\r\nimport org.springframework.beans.factory.annotation.Autowired;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.Arrays;\r\nimport java.util.List;\r\n\r\n/**\r\n * Created by heru on 5/31/17.\r\n */\r\npublic class NettyNetworkHandler extends SimpleChannelInboundHandler<String> {\r\n\r\n    @Autowired\r\n    private IsoQueueResponseRepository isoQueueResponseRepository;\r\n\r\n    @Autowired\r\n    private IsoQueueCheckerService isoQueueCheckerService;\r\n\r\n    private Channel channel;\r\n\r\n    private List<String> previousIso = new ArrayList<>();\r\n\r\n    public NettyNetworkHandler() {\r\n        AutowireHelper.autowire(this, this.isoQueueResponseRepository);\r\n        AutowireHelper.autowire(this, this.isoQueueCheckerService);\r\n    }\r\n\r\n    @Override\r\n    public void channelActive(ChannelHandlerContext ctx) throws Exception {\r\n        super.channelActive(ctx);\r\n\r\n        channel = ctx.channel();\r\n    }\r\n\r\n    @Override\r\n    public void channelInactive(ChannelHandlerContext ctx) throws Exception {\r\n        super.channelInactive(ctx);\r\n\r\n        channel = ctx.channel();\r\n\r\n        if (channel.eventLoop().isShuttingDown()) return;\r\n    }\r\n\r\n    @Override\r\n    protected void channelRead0(ChannelHandlerContext channelHandlerContext, String iso) throws Exception {\r\n        String header = Constants.ISO_HEADER;\r\n\r\n        String[] splitIso = iso.split(\"(?=\" + header + \")\");\r\n\r\n        // ada lebih\r\n        if (splitIso.length > 1) {\r\n            int index = 0;\r\n            int jumlah = splitIso.length;\r\n            int akhir = jumlah - 1;\r\n\r\n            for (String split : splitIso) {\r\n                if (index == 0) {\r\n                    if (split.startsWith(header)) {\r\n                        saveResponse(splitIso[index]);\r\n                    } else {\r\n                        String previous = previousIso.get(0);\r\n\r\n                        previousIso.remove(0);\r\n\r\n                        saveResponse(splitIso[index]);\r\n                    }\r\n                } else {\r\n                    if (index < akhir) {\r\n                        if (split.startsWith(header)) {\r\n                            saveResponse(splitIso[index]);\r\n                        } else {\r\n                            String previous = previousIso.get(0);\r\n\r\n                            previousIso.remove(0);\r\n\r\n                            saveResponse(splitIso[index]);\r\n                        }\r\n                    } else {\r\n                        previousIso.add(splitIso[index]);\r\n                    }\r\n                }\r\n\r\n                index++;\r\n            }\r\n            // tidak ada lebih\r\n        } else {\r\n            saveResponse(splitIso[0]);\r\n\r\n            if (previousIso.size() > 0) {\r\n                for (int index = 0; index < previousIso.size(); index++) {\r\n                    saveResponse(previousIso.get(index));\r\n\r\n                    previousIso.remove(index);\r\n                }\r\n            }\r\n        }\r\n    }\r\n\r\n    @Override\r\n    public void channelReadComplete(ChannelHandlerContext ctx) throws Exception {\r\n        super.channelReadComplete(ctx);\r\n\r\n        ctx.flush();\r\n    }\r\n\r\n    private void saveResponse(String iso) {\r\n        IsoQueueResponse isoQueueResponse = new IsoQueueResponse();\r\n\r\n        isoQueueResponse.setIso(iso);\r\n\r\n        isoQueueResponse = isoQueueResponseRepository.save(isoQueueResponse);\r\n\r\n        isoQueueCheckerService.process(isoQueueResponse);\r\n    }\r\n}\r\n```","reactions":{"url":"https://api.github.com/repos/netty/netty/issues/6799/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/netty/netty/issues/6799/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"actor":{"login":"dckone","id":4988483,"node_id":"MDQ6VXNlcjQ5ODg0ODM=","avatar_url":"https://avatars.githubusercontent.com/u/4988483?v=4","gravatar_id":"","url":"https://api.github.com/users/dckone","html_url":"https://github.com/dckone","followers_url":"https://api.github.com/users/dckone/followers","following_url":"https://api.github.com/users/dckone/following{/other_user}","gists_url":"https://api.github.com/users/dckone/gists{/gist_id}","starred_url":"https://api.github.com/users/dckone/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dckone/subscriptions","organizations_url":"https://api.github.com/users/dckone/orgs","repos_url":"https://api.github.com/users/dckone/repos","events_url":"https://api.github.com/users/dckone/events{/privacy}","received_events_url":"https://api.github.com/users/dckone/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-10-15T12:26:08Z","updated_at":"2019-10-15T12:26:08Z","source":{"type":"issue","issue":{"url":"https://api.github.com/repos/netty/netty/issues/9669","repository_url":"https://api.github.com/repos/netty/netty","labels_url":"https://api.github.com/repos/netty/netty/issues/9669/labels{/name}","comments_url":"https://api.github.com/repos/netty/netty/issues/9669/comments","events_url":"https://api.github.com/repos/netty/netty/issues/9669/events","html_url":"https://github.com/netty/netty/issues/9669","id":507209024,"node_id":"MDU6SXNzdWU1MDcyMDkwMjQ=","number":9669,"title":"IllegalStateException: complete already on notifyListener / operationComplete","user":{"login":"dckone","id":4988483,"node_id":"MDQ6VXNlcjQ5ODg0ODM=","avatar_url":"https://avatars.githubusercontent.com/u/4988483?v