uilder/ReturningResultsEntityUpdator.ts:96:69\\n    at Array.map (<anonymous>)\\n    at ReturningResultsEntityUpdator.<anonymous> (/project/src/query-builder/ReturningResultsEntityUpdator.ts:87:40)\\n    at step (/project/node_modules/typeorm/node_modules/tslib/tslib.js:141:27)\\n    at Object.next (/project/node_modules/typeorm/node_modules/tslib/tslib.js:122:57)\\n    at /project/node_modules/typeorm/node_modules/tslib/tslib.js:115:75\\n    at new Promise (<anonymous>)\\n    at Object.__awaiter (/project/node_modules/typeorm/node_modules/tslib/tslib.js:111:16)\\n    at ReturningResultsEntityUpdator.insert (/project/node_modules/typeorm/query-builder/ReturningResultsEntityUpdator.js:87:24)\\n    at InsertQueryBuilder.<anonymous> (/project/src/query-builder/InsertQueryBuilder.ts:116:53)\\n    at step (/project/node_modules/typeorm/node_modules/tslib/tslib.js:141:27)\\n    at Object.next (/project/node_modules/typeorm/node_modules/tslib/tslib.js:122:57)\\n    at fulfilled (/project/node_modules/typeorm/node_modules/tslib/tslib.js:112:62)\r\n\r\n\r\n### Expected Behavior\r\n\r\n<!--\r\n  A clear and concise description of what you expected to happen.\r\n-->\r\nInsert a row without throwing an error just like Typeorm `v0.2.28` :D\r\n\r\n### Actual Behavior\r\n\r\n<!--\r\n  A clear and concise description of what actually happened.\r\n\r\n  Please wrap any error messages or output in code tags, instead of images.\r\n-->\r\nThrow ```Cannot assign to read only property 'CQN_OPCODE_ALL_OPS' of object '#<OracleDb>'``` error.\r\n\r\n\r\n### Steps to Reproduce\r\n\r\n<!--\r\n  Your bug will be investigated much faster if we can run your code and it doesn't\r\n  have dependencies other than TypeORM. Issues without reproduction steps or\r\n  code examples may be closed as not actionable.\r\n\r\n  Please try to provide a Minimal, Complete, and Verifiable example.\r\n  http://stackoverflow.com/help/mcve\r\n-->\r\n\r\n### My Environment\r\n\r\n<!--\r\n  Please add any other relevant dependencies to this table at the end.\r\n  For example: Electron, React Native, or NestJS.\r\n-->\r\n\r\n| Dependency          | Version  |\r\n| ---                 | ---      |\r\n| Operating System    |   OSX 10.15.3  |\r\n| Node.js version     | v12.18.3 | <!-- run `node -v` to obtain this -->\r\n| Typescript version  | v4.1.5 | <!-- run `npm list typescript` to obtain this -->\r\n| TypeORM version     | v0.2.31 | <!-- run `npm list typeorm` to obtain this -->\r\n| oracledb version     | v5.0.0 |\r\n\r\n\r\n### Additional Context\r\n\r\n### Relevant Database Driver(s)\r\n\r\n- [ ] `aurora-data-api`\r\n- [ ] `aurora-data-api-pg`\r\n- [ ] `better-sqlite3`\r\n- [ ] `cockroachdb`\r\n- [ ] `cordova`\r\n- [ ] `expo`\r\n- [ ] `mongodb`\r\n- [ ] `mysql`\r\n- [ ] `nativescript`\r\n- [x] `oracle`\r\n- [ ] `postgres`\r\n- [ ] `react-native`\r\n- [ ] `sap`\r\n- [ ] `sqlite`\r\n- [ ] `sqlite-abstract`\r\n- [ ] `sqljs`\r\n- [ ] `sqlserver`\r\n\r\n\r\n### Are you willing to resolve this issue by submitting a Pull Request?\r\n\r\n<!--\r\n  Remember that first-time contributors are welcome! 🙌\r\n-->\r\n\r\n- [ ] Yes, I have the time, and I know how to start.\r\n- [ ] Yes, I have the time, but I don't know how to start. I would need guidance.\r\n- [ ] No, I don't have the time, although I believe I could do it if I had the time...\r\n- [x] No, I don't have the time and I wouldn't even know how to start.\r\n\r\n\r\n<!--\r\n  👋 Have a great day and thank you for the bug report!\r\n-->\r\n","reactions":{"url":"https://api.github.com/repos/typeorm/typeorm/issues/7403/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/typeorm/typeorm/issues/7403/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":4976330030,"node_id":"MDEzOkFzc2lnbmVkRXZlbnQ0OTc2MzMwMDMw","url":"https://api.github.com/repos/typeorm/typeorm/issues/events/4976330030"