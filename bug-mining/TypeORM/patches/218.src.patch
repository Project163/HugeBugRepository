+
+/**
+ * Organizes communication with MySQL DBMS.
+ */
+export class AuroraMysqlDriver implements Driver {
+    // -------------------------------------------------------------------------
+    // Public Properties
+    // -------------------------------------------------------------------------
+
+    connection: DataSource
+
+    /**
+     * Aurora Data API underlying library.
