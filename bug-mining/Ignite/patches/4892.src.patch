+
+        assertEquals("Bar`1[[Qux`2[[String],[Int32]]]]",
+                mapper.typeName("Foo.Bar`1[[Baz.Qux`2[[System.String],[System.Int32]]]]"));
+
+        assertEquals("Bar`1[[Qux`2[[C],[Int32]]]]",
+                mapper.typeName("Foo.Outer+Bar`1[[Baz.Outer2+Qux`2[[A.B+C],[System.Int32]]]]"));
