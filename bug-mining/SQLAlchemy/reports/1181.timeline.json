om/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2021-07-15T02:50:35Z","rename":{"from":"Default deduplication filter in `.unique()` based on `id`, not `hash`","to":"apparent mis-assignment of dedupe filters for ORM rows"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/883672434","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/6769#issuecomment-883672434","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/6769","id":883672434,"node_id":"IC_kwDOCX5JB840q8Vy","user":{"login":"lukasjuhrich","id":10060406,"node_id":"MDQ6VXNlcjEwMDYwNDA2","avatar_url":"https://avatars.githubusercontent.com/u/10060406?v=4","gravatar_id":"","url":"https://api.github.com/users/lukasjuhrich","html_url":"https://github.com/lukasjuhrich","followers_url":"https://api.github.com/users/lukasjuhrich/followers","following_url":"https://api.github.com/users/lukasjuhrich/following{/other_user}","gists_url":"https://api.github.com/users/lukasjuhrich/gists{/gist_id}","starred_url":"https://api.github.com/users/lukasjuhrich/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lukasjuhrich/subscriptions","organizations_url":"https://api.github.com/users/lukasjuhrich/orgs","repos_url":"https://api.github.com/users/lukasjuhrich/repos","events_url":"https://api.github.com/users/lukasjuhrich/events{/privacy}","received_events_url":"https://api.github.com/users/lukasjuhrich/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-07-20T20:24:32Z","updated_at":"2021-07-20T20:24:32Z","body":"Got it! I had `func`-terms in my `select`, so e.g. adding `[…], func.abs(union.date)` to your program reproduces it:\r\n\r\n```python\r\nimport datetime\r\nfrom pprint import pprint\r\n\r\nfrom sqlalchemy import Column\r\nfrom sqlalchemy import DateTime\r\nfrom sqlalchemy import Integer\r\nfrom sqlalchemy import create_engine\r\nfrom sqlalchemy import func\r\nfrom sqlalchemy import select\r\nfrom sqlalchemy import union_all\r\nfrom sqlalchemy.orm import Session, aliased\r\nfrom sqlalchemy.orm import declarative_base\r\n\r\nBase = declarative_base()\r\n\r\n\r\nclass A(Base):\r\n    __tablename__ = \"a\"\r\n\r\n    id = Column(Integer, primary_key=True)\r\n    data = Column(Integer)\r\n    date = Column(DateTime)\r\n\r\n\r\ne = create_engine(\"sqlite://\", echo=False)\r\nBase.metadata.create_all(e)\r\n\r\ns = Session(e)\r\n\r\ns.add(A(id=1, data=5, date=datetime.datetime.now()))\r\ns.commit()\r\n\r\n\r\ndef go():\r\n\r\n    union = aliased(\r\n        A,\r\n        union_all(\r\n            select(A),\r\n            select(A),\r\n            select(A),\r\n        ).subquery(),\r\n    )\r\n\r\n    result = s.execute(select(union, union.data, union.date, func.abs(union.date)))\r\n    return result\r\n\r\n\r\nprint(\"\\nthe filters:\")\r\nprint(go()._metadata._unique_filters)\r\n\r\nprint(\"\\n\\nno deduplication:\")\r\npprint(go().all())\r\n\r\nprint(\"\\n\\ndeduplication:\")\r\npprint(go().unique().all())\r\n\r\n```\r\nResult:\r\n```\r\nthe filters:\r\n[<built-in function id>, None, None, <built-in function id>]\r\n\r\n\r\nno deduplication:\r\n[(<__main__.A object at 0x7f3c27e7bee0>, 5, datetime.datetime(2021, 7, 20, 22, 7, 45, 307522), 2021.0),\r\n (<__main__.A object at 0x7f3c27e7bee0>, 5, datetime.datetime(2021, 7, 20, 22, 7, 45, 307522), 2021.0),\r\n (<__main__.A object at 0x7f3c27e7bee0>, 5, datetime.datetime(2021, 7, 20, 22, 7, 45, 307522), 2021.0)]\r\n\r\n\r\ndeduplication:\r\n[(<__main__.A object at 0x7f3c27e09cd0>, 5, datetime.datetime(2021, 7, 20, 22, 7, 45, 307522), 2021.0),\r\n (<__main__.A object at 0x7f3c27e09cd0>, 5, datetime.datetime(2021, 7, 20, 22, 7, 45, 307522), 2021.0),\r\n (<__main__.A object at 0x7f3c27e09cd0>, 5, datetime.datetime(2021, 7, 20, 22, 7, 45, 307522), 2021.0)]\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/883672434/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"lukasjuhrich","id":10060406,"node_id":"MDQ6VXNlcjEwMDYwNDA2","avatar_url":"https://avatars.githubusercontent.com/u/10060406?v=4","gravatar_id":"","url":"https://api.github.com/users/lukasjuhrich","html_url":"https://github.com/lukasjuhrich","followers_url":"https://api.github.com/users/lukasjuhrich/followers","following_url":"https://api.github.com/users/lukasjuhrich/following{/other_user}","gists_url":"https://api.github.com/users/lukasjuhrich/gists{/gist_id}","starred_url":"https://api.github.com/users/lukasjuhrich/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lukasjuhrich/subscriptions","organizations_url":"https://api.github.com/users/lukasjuhrich/orgs","repos_url":"https://api.github.com/users/lukasjuhrich/repos","events_url":"https://api.github.com/users/lukasjuhrich/events{/privacy}","received_events_url":"https://api.github.com/users/lukasjuhrich/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":5047037399,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDUwNDcwMzczOTk=","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/5047037399","a