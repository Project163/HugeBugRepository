l":"https://api.github.com/users/kamipo/gists{/gist_id}","starred_url":"https://api.github.com/users/kamipo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kamipo/subscriptions","organizations_url":"https://api.github.com/users/kamipo/orgs","repos_url":"https://api.github.com/users/kamipo/repos","events_url":"https://api.github.com/users/kamipo/events{/privacy}","received_events_url":"https://api.github.com/users/kamipo/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"unlabeled","commit_id":null,"commit_url":null,"created_at":"2020-03-08T22:35:53Z","label":{"name":"stale","color":"444444"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/rails/rails/issues/comments/599402818","html_url":"https://github.com/rails/rails/issues/36910#issuecomment-599402818","issue_url":"https://api.github.com/repos/rails/rails/issues/36910","id":599402818,"node_id":"MDEyOklzc3VlQ29tbWVudDU5OTQwMjgxOA==","user":{"login":"tjallingvanderwal","id":396336,"node_id":"MDQ6VXNlcjM5NjMzNg==","avatar_url":"https://avatars.githubusercontent.com/u/396336?v=4","gravatar_id":"","url":"https://api.github.com/users/tjallingvanderwal","html_url":"https://github.com/tjallingvanderwal","followers_url":"https://api.github.com/users/tjallingvanderwal/followers","following_url":"https://api.github.com/users/tjallingvanderwal/following{/other_user}","gists_url":"https://api.github.com/users/tjallingvanderwal/gists{/gist_id}","starred_url":"https://api.github.com/users/tjallingvanderwal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tjallingvanderwal/subscriptions","organizations_url":"https://api.github.com/users/tjallingvanderwal/orgs","repos_url":"https://api.github.com/users/tjallingvanderwal/repos","events_url":"https://api.github.com/users/tjallingvanderwal/events{/privacy}","received_events_url":"https://api.github.com/users/tjallingvanderwal/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-03-16T08:20:53Z","updated_at":"2020-06-02T08:17:49Z","body":"For those stumbling across this issue, we decided to monkey patch: \r\n```ruby\r\nraise 'Reevaluate if this patch is still needed' if Rails.gem_version >= Gem::Version.new(\"6.1\")\r\n\r\nActiveModel::Type::Helpers::TimeValue.module_eval do\r\n  def apply_seconds_precision(value)\r\n    return value unless precision && value.respond_to?(:nsec)\r\n\r\n    number_of_insignificant_digits = 9 - precision\r\n    round_power = 10**number_of_insignificant_digits\r\n    rounded_off_nsec = value.nsec % round_power\r\n\r\n    if rounded_off_nsec > 0\r\n      value.change(nsec: value.nsec - rounded_off_nsec)\r\n    else\r\n      # Look superfluous and is ugly, but guarentees both\r\n      # branches return the same class.\r\n      value.change(nsec: value.nsec)\r\n    end\r\n  end\r\nend\r\n```\r\n\r\n_edit: updated to support datetime columns with nanosecond precision_\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/rails/rails/issues/comments/599402818/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"tjallingvanderwal","id":396336,"node_id":"MDQ6VXNlcjM5NjMzNg==","avatar_url":"https://avatars.githubusercontent.com/u/396336?v=4","gravatar_id":"","url":"https://api.github.com/users/tjallingvanderwal","html_url":"https://github.com/tjallingvanderwal","followers_url":"https://api.github.com/users/tjallingvanderwal/followers","following_url":"https://api.github.com/users/tjallingvanderwal/following{/other_user}","gists_url":"https://api.github.com/users/tjallingvanderwal/gists{/gist_id}","starred_url":"https://api.github.com/users/tjallingvanderwal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tjallingvanderwal/subscriptions","organizations_url":"https://api.github.com/users/tjallingvanderw