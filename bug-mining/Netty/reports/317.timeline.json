.com/users/trustin/events{/privacy}","received_events_url":"https://api.github.com/users/trustin/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"e79ca269b8bf057f0b4250a9b9e193c398104998","commit_url":"https://api.github.com/repos/netty/netty/commits/e79ca269b8bf057f0b4250a9b9e193c398104998","created_at":"2014-06-02T09:23:33Z","performed_via_github_app":null},{"id":126946479,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDEyNjk0NjQ3OQ==","url":"https://api.github.com/repos/netty/netty/issues/events/126946479","actor":{"login":"trustin","id":173918,"node_id":"MDQ6VXNlcjE3MzkxOA==","avatar_url":"https://avatars.githubusercontent.com/u/173918?v=4","gravatar_id":"","url":"https://api.github.com/users/trustin","html_url":"https://github.com/trustin","followers_url":"https://api.github.com/users/trustin/followers","following_url":"https://api.github.com/users/trustin/following{/other_user}","gists_url":"https://api.github.com/users/trustin/gists{/gist_id}","starred_url":"https://api.github.com/users/trustin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/trustin/subscriptions","organizations_url":"https://api.github.com/users/trustin/orgs","repos_url":"https://api.github.com/users/trustin/repos","events_url":"https://api.github.com/users/trustin/events{/privacy}","received_events_url":"https://api.github.com/users/trustin/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"ed6df98653ffff0838dcb7c21d6e32dd9d159c7f","commit_url":"https://api.github.com/repos/netty/netty/commits/ed6df98653ffff0838dcb7c21d6e32dd9d159c7f","created_at":"2014-06-02T09:23:57Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/netty/netty/issues/comments/47196535","html_url":"https://github.com/netty/netty/issues/2519#issuecomment-47196535","issue_url":"https://api.github.com/repos/netty/netty/issues/2519","id":47196535,"node_id":"MDEyOklzc3VlQ29tbWVudDQ3MTk2NTM1","user":{"login":"d-t-w","id":2832467,"node_id":"MDQ6VXNlcjI4MzI0Njc=","avatar_url":"https://avatars.githubusercontent.com/u/2832467?v=4","gravatar_id":"","url":"https://api.github.com/users/d-t-w","html_url":"https://github.com/d-t-w","followers_url":"https://api.github.com/users/d-t-w/followers","following_url":"https://api.github.com/users/d-t-w/following{/other_user}","gists_url":"https://api.github.com/users/d-t-w/gists{/gist_id}","starred_url":"https://api.github.com/users/d-t-w/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/d-t-w/subscriptions","organizations_url":"https://api.github.com/users/d-t-w/orgs","repos_url":"https://api.github.com/users/d-t-w/repos","events_url":"https://api.github.com/users/d-t-w/events{/privacy}","received_events_url":"https://api.github.com/users/d-t-w/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-06-26T07:42:02Z","updated_at":"2014-06-26T07:42:02Z","body":"This seems to be the cause of an issue I was grappling with today when using PooledByteBuf allocation from within Clojure - specifically when using core.async (which executes a process within a separate executor pool).\n\nSpecifically, any use of PooledByteBuf allocation within a (go or (thread call will prevent the JVM from exiting. i.e.\n\n``` clojure\n(ns async-pooled.core-test\n  (:import (io.netty.buffer PooledByteBufAllocator ByteBuf))\n  (:require [clojure.core.async :refer [go thread <!!]]))\n\n(<!! (go (.buffer PooledByteBufAllocator/DEFAULT 1)))\n(<!! (thread (.buffer PooledByteBufAllocator/DEFAULT 1)))\n```\n\nUpgraded to 4.0.20 and no longer have a problem. \n\nThanks for the issue and resolution, this was a particularly tricky to debug in my application.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/netty/netty/issues/comments/47196535/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":