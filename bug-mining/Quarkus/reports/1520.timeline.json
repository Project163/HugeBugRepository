ository.CrudRepository;\r\nimport org.springframework.data.repository.query.Param;\r\nimport org.springframework.stereotype.Repository;\r\n\r\n\r\n\r\n@Repository\r\npublic interface UserRepository extends CrudRepository<KiwiUser, Long> {\r\n    Page<KiwiUser> findByLastNameAndFirstNameAndEmail(String lastName, String firstName,\r\n             String email, Pageable pageable);\r\n}\r\n```\r\n\r\n\r\nhere you have the entity:\r\n\r\n```java\r\n\r\nimport java.time.LocalDate;\r\nimport java.time.LocalDateTime;\r\nimport java.util.List;\r\nimport java.util.Set;\r\nimport java.util.UUID;\r\nimport java.util.stream.Collectors;\r\nimport java.util.stream.Stream;\r\n\r\nimport javax.persistence.CascadeType;\r\nimport javax.persistence.Column;\r\nimport javax.persistence.Entity;\r\nimport javax.persistence.FetchType;\r\nimport javax.persistence.GeneratedValue;\r\nimport javax.persistence.GenerationType;\r\nimport javax.persistence.Id;\r\nimport javax.persistence.ManyToMany;\r\nimport javax.persistence.OneToMany;\r\nimport javax.persistence.OneToOne;\r\nimport javax.persistence.Table;\r\nimport javax.persistence.Transient;\r\nimport javax.validation.constraints.Email;\r\nimport javax.validation.constraints.NotBlank;\r\nimport javax.validation.constraints.NotNull;\r\n\r\n\r\nimport org.hibernate.annotations.CreationTimestamp;\r\n\r\nimport lombok.AllArgsConstructor;\r\nimport lombok.Builder;\r\nimport lombok.Data;\r\nimport lombok.EqualsAndHashCode;\r\nimport lombok.NoArgsConstructor;\r\nimport lombok.ToString;\r\n\r\n@Data\r\n@Builder\r\n@EqualsAndHashCode(of = \"id\")\r\n@Entity\r\n@ToString(of = {\"id\", \"username\", \"email\"})\r\n@Table(name = \"kiwi_user\")\r\npublic class KiwiUser {\r\n    @Id\r\n    @GeneratedValue(strategy = GenerationType.IDENTITY)\r\n    @Column(name = \"id\", updatable = false, nullable = false)\r\n    private Long id;\r\n    \r\n    @NotBlank\r\n    private String username;\r\n    // really useful ?\r\n    private boolean activated;\r\n    \r\n    @Builder.Default\r\n    private boolean isPrivate = false;\r\n\r\n    // basic user infos\r\n    @NotBlank\r\n    private String firstName;\r\n    @NotBlank\r\n    private String lastName;\r\n    // enum ?\r\n    private String civility;\r\n    @NotNull\r\n    private LocalDate birthDate;\r\n\r\n    @Email\r\n    @Column(unique = true)\r\n    private String email;\r\n\r\n   //\r\n}\r\n\r\n```\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/1042745185/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Plawn","id":29287749,"node_id":"MDQ6VXNlcjI5Mjg3NzQ5","avatar_url":"https://avatars.githubusercontent.com/u/29287749?v=4","gravatar_id":"","url":"https://api.github.com/users/Plawn","html_url":"https://github.com/Plawn","followers_url":"https://api.github.com/users/Plawn/followers","following_url":"https://api.github.com/users/Plawn/following{/other_user}","gists_url":"https://api.github.com/users/Plawn/gists{/gist_id}","starred_url":"https://api.github.com/users/Plawn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Plawn/subscriptions","organizations_url":"https://api.github.com/users/Plawn/orgs","repos_url":"https://api.github.com/users/Plawn/repos","events_url":"https://api.github.com/users/Plawn/events{/privacy}","received_events_url":"https://api.github.com/users/Plawn/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":6088920085,"node_id":"REFE_lADOCFbutM5D-w2RzwAAAAFq7YwV","url":"https://api.github.com/repos/quarkusio/quarkus/issues/events/6088920085","actor":{"login":"geoand","id":4374975,"node_id":"MDQ6VXNlcjQzNzQ5NzU=","avatar_url":"https://avatars.githubusercontent.com/u/4374975?v=4","gravatar_id":"","url":"https://api.github.com/users/geoand","html_url":"https://github.com/geoand","followers_url":"https://a