glm/gtx/fast_square_root.inl\r\nfrom\r\n```\r\n\t// fastInversesqrt\r\n\ttemplate<typename genType>\r\n\tGLM_FUNC_QUALIFIER genType fastInverseSqrt(genType x)\r\n\t{\r\n#\t\tifdef __CUDACC__ // Wordaround for a CUDA compiler bug up to CUDA6\r\n\t\t\tvec<1, T, Q> tmp(detail::compute_inversesqrt<tvec1, genType, lowp, detail::is_aligned<lowp>::value>::call(vec<1, genType, lowp>(x)));\r\n\t\t\treturn tmp.x;\r\n#\t\telse\r\n\t\t\treturn detail::compute_inversesqrt<1, genType, lowp, detail::is_aligned<lowp>::value>::call(vec<1, genType, lowp>(x)).x;\r\n#\t\tendif\r\n\t}\r\n```\r\n\r\nto\r\n```\r\n\t// fastInversesqrt\r\n\ttemplate<typename genType>\r\n\tGLM_FUNC_QUALIFIER genType fastInverseSqrt(genType x)\r\n\t{\r\n//#\t\tifdef __CUDACC__ // Wordaround for a CUDA compiler bug up to CUDA6\r\n//\t\t\tvec<1, T, Q> tmp(detail::compute_inversesqrt<tvec1, genType, lowp, detail::is_aligned<lowp>::value>::call(vec<1, genType, lowp>(x)));\r\n//\t\t\treturn tmp.x;\r\n//#\t\telse\r\n\t\t\treturn detail::compute_inversesqrt<1, genType, lowp, detail::is_aligned<lowp>::value>::call(vec<1, genType, lowp>(x)).x;\r\n//#\t\tendif\r\n\t}\r\n```\r\n\r\nresolves the issue, however i suspect this will break CUDA6 support...","closed_by":{"login":"Groovounet","id":367227,"node_id":"MDQ6VXNlcjM2NzIyNw==","avatar_url":"https://avatars.githubusercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.gi