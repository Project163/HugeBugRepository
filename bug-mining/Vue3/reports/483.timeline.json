t@github.com:element-plus/element-plus.git","clone_url":"https://github.com/element-plus/element-plus.git","svn_url":"https://github.com/element-plus/element-plus","homepage":"https://element-plus.org","size":907984,"stargazers_count":27206,"watchers_count":27206,"language":"TypeScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":true,"has_discussions":true,"forks_count":19885,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1278,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["component-library","element-plus","element-ui","vue","vue-components","vuejs"],"visibility":"public","forks":19885,"open_issues":1278,"watchers":27206,"default_branch":"dev","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"<!-- generated by https://issue.element-plus.org/ DO NOT REMOVE -->\r\n\r\nBug Type: **`Component`**\r\n\r\n## Environment\r\n\r\n- Vue Version: `3.3.11`\r\n- Element Plus Version: `2.4.3`\r\n- Browser / OS: `Chrome/120.0.0.0, Intel Mac OS X 10_15_7`\r\n- Build Tool: `Webpack`\r\n\r\n## Reproduction\r\n\r\n### Related Component\r\n\r\n- `el-form`\r\n- `el-form-item`\r\n\r\n### Reproduction Link\r\n\r\n[Docs](https://element-plus.org/zh-CN/component/form.html#%E6%B7%BB%E5%8A%A0-%E5%88%A0%E9%99%A4%E8%A1%A8%E5%8D%95%E9%A1%B9)\r\n\r\n### Steps to reproduce\r\n\r\n- This bug is caused by vue lifecycle hooks is executed in the wrong order [vuejs#8898](https://github.com/vuejs/core/issues/8898)\r\n\r\n- In some special cases(v-if=\"dynamicRefValue\")`el-form-item` lifecycle it will be executed in the following order: `onBeforeMount => onBeforeUnmount => onMounted`\r\n\r\n- This will cause the el-form `fields` to be incorrect, `removeField()` executes before `addField()`, unmounted form-item prop error exists in in fields: https://github.com/element-plus/element-plus/blob/ec34092e455823ba43693d7846de39e6f9cfaa1c/packages/components/form/src/form-item.vue#L393\r\n\r\n- When the final validate, the unmounted form-item prop verify will be triggered.\r\n\r\n\r\n- **Temp solution: replace `onMounted` with `onBeforeMount` and waiting for vue fix it.**\r\n\r\n\r\n### What is Expected?\r\n\r\nDo not verify unmounted form-item prop\r\n\r\n### What is actually happening?\r\n\r\nwill verify unmounted form-item prop\r\n\r\n### Additional comments\r\n\r\n<img width=\"922\" alt=\"image\" src=\"https://github.com/element-plus/element-plus/assets/11495164/613b126e-3019-4e4a-a840-2b87388e32bf\">\r\n\r\n<img width=\"762\" alt=\"image\" src=\"https://github.com/element-plus/element-plus/assets/11495164/87fdad30-b968-41bd-bfcf-280ae33e64de\">\r\n\r\n<img width=\"517\" alt=\"image\" src=\"https://github.com/element-plus/element-plus/assets/11495164/52a7be88-2e4a-4c1e-b5fd-b21766888fe2\">\r\n\r\n\r\n\r\n\r\n<!-- 如果你需要插入截图，请在这粘贴。 -->","reactions":{"url":"https://api.github.com/repos/element-plus/element-plus/issues/15145/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/element-plus/element-plus/issues/15145/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/vuejs/core/issues/comments/1855437855","html_url":"https://github.com/vuejs/core/issues/8898#issuecomment-1855437855","issue_url":"https://api.github.com/repos/vuejs/core/issues/8898","id":1855437855,"node_id":"IC_kwDOCCum185ul7wf","user":{"login":"roojay","id":11495164,"node_id":"MDQ6VXNlcjExNDk1MTY0","avatar_url":"https://avatars.githubusercontent.com/u/11495164?v=4","gravatar_id":"","url":"https://api.github.com/users/roojay","html_url":"https://github.com/roojay