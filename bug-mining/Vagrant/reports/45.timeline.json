aster/lib/vagrant/action/builtin/box_remove.rb#L108)? Or should I also somehow check if there are multiple instances of vagrant running, as it was mentioned by @mitchellh ?\n\nTIA.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/hashicorp/vagrant/issues/comments/121346692/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"jane-eagles","id":2123664,"node_id":"MDQ6VXNlcjIxMjM2NjQ=","avatar_url":"https://avatars.githubusercontent.com/u/2123664?v=4","gravatar_id":"","url":"https://api.github.com/users/jane-eagles","html_url":"https://github.com/jane-eagles","followers_url":"https://api.github.com/users/jane-eagles/followers","following_url":"https://api.github.com/users/jane-eagles/following{/other_user}","gists_url":"https://api.github.com/users/jane-eagles/gists{/gist_id}","starred_url":"https://api.github.com/users/jane-eagles/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jane-eagles/subscriptions","organizations_url":"https://api.github.com/users/jane-eagles/orgs","repos_url":"https://api.github.com/users/jane-eagles/repos","events_url":"https://api.github.com/users/jane-eagles/events{/privacy}","received_events_url":"https://api.github.com/users/jane-eagles/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":355698086,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50MzU1Njk4MDg2","url":"https://api.github.com/repos/hashicorp/vagrant/issues/events/355698086","actor":{"login":"mitchellh","id":1299,"node_id":"MDQ6VXNlcjEyOTk=","avatar_url":"https://avatars.githubusercontent.com/u/1299?v=4","gravatar_id":"","url":"https://api.github.com/users/mitchellh","html_url":"https://github.com/mitchellh","followers_url":"https://api.github.com/users/mitchellh/followers","following_url":"https://api.github.com/users/mitchellh/following{/other_user}","gists_url":"https://api.github