lery/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/celery/celery/labels{/name}","releases_url":"https://api.github.com/repos/celery/celery/releases{/id}","deployments_url":"https://api.github.com/repos/celery/celery/deployments","created_at":"2009-04-24T11:31:24Z","updated_at":"2026-03-11T11:08:53Z","pushed_at":"2026-03-10T15:04:28Z","git_url":"git://github.com/celery/celery.git","ssh_url":"git@github.com:celery/celery.git","clone_url":"https://github.com/celery/celery.git","svn_url":"https://github.com/celery/celery","homepage":"https://docs.celeryq.dev","size":36397,"stargazers_count":28268,"watchers_count":28268,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":4989,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":773,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["amqp","python","python-library","python3","queue-tasks","queue-workers","queued-jobs","redis","redis-queue","sqs","sqs-queue","task-manager","task-runner","task-scheduler"],"visibility":"public","forks":4989,"open_issues":773,"watchers":28268,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/celery/celery/pulls/8619","html_url":"https://github.com/celery/celery/pull/8619","diff_url":"https://github.com/celery/celery/pull/8619.diff","patch_url":"https://github.com/celery/celery/pull/8619.patch","merged_at":"2023-11-08T08:22:50Z"},"body":"Fixed RecursionError caused by giving `config_from_object` nested module that does not exist (#8517)\r\n\r\n\r\n## Description\r\n\r\nThe problem is described by new unit test: t/unit/app/test_app.py::test_config_form_object__module_attr_does_not_exist\r\n\r\nWhen you provide a string with valid module name but invalid submodule (attr) to `app.config_from_object` the 3rd party util `kombu.utils.imports.symbol_by_name` would raise `AttributeError` which would be \"handled\" by `PendingConfiguration(UserDict)` and would cause infinite recursion. This happens during the \"lazy initialization\" of the `app.conf` when `app.conf` attr is accessed.\r\n\r\nThe fix is to catch `AttributeError` and raise `ModuleNotFoundError` which would be propagated correctly and would provide the real error message to the end user.\r\n\r\nI don't feel very good re: this fix, I am new to this project, so your criticism is highly desired.\r\n\r\n","reactions":{"url":"https://api.github.com/repos/celery/celery/issues/8619/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/celery/celery/issues/8619/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/celery/celery/issues/comments/1799084558","html_url":"https://github.com/celery/celery/issues/8517#issuecomment-1799084558","issue_url":"https://api.github.com/repos/celery/celery/issues/8517","id":1799084558,"node_id":"IC_kwDOAALQjM5rO9oO","user":{"login":"frolenkov-nikita","id":594249,"node_id":"MDQ6VXNlcjU5NDI0OQ==","avatar_url":"https://avatars.githubusercontent.com/u/594249?v=4","gravatar_id":"","url":"https://api.github.com/users/frolenkov-nikita","html_url":"https://github.com/frolenkov-nikita","followers_url":"https://api.github.com/users/frolenkov-nikita/followers","following_url":"https://api.github.com/users/frolenkov-nikita/following{/other_user}","gists_url":"https://api.github.com/users/frolenkov-nikita/gists{/gist_id}","starred_url":"https://api.github.com/users/frolenkov-nikita/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/