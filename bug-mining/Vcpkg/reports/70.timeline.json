e。\r\n\r\n```\r\n    # If we use Ninja, make sure it's on PATH\r\n    if(GENERATOR STREQUAL \"Ninja\")\r\n        vcpkg_find_acquire_program(NINJA)\r\n        get_filename_component(NINJA_PATH ${NINJA} DIRECTORY)\r\n        set(ENV{PATH} \"$ENV{PATH};${NINJA_PATH}\")\r\n        list(APPEND _csc_OPTIONS \"-DCMAKE_MAKE_PROGRAM=${NINJA}\")\r\n    endif()\r\n```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/microsoft/vcpkg/issues/comments/411944512/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"icedream2linxi","id":3735828,"node_id":"MDQ6VXNlcjM3MzU4Mjg=","avatar_url":"https://avatars.githubusercontent.com/u/3735828?v=4","gravatar_id":"","url":"https://api.github.com/users/icedream2linxi","html_url":"https://github.com/icedream2linxi","followers_url":"https://api.github.com/users/icedream2linxi/followers","following_url":"https://api.github.com/users/icedream2linxi/following{/other_user}","gists_url":"https://api.github.com/users/icedream2linxi/gists{/gist_id}","starred_url":"https://api.github.com/users/icedream2linxi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/icedream2linxi/subscriptions","organizations_url":"https://api.github.com/users/icedream2linxi/orgs","repos_url":"https://api.github.com/users/icedream2linxi/repos","events_url":"https://api.github.com/users/icedream2linxi/events{/privacy}","received_events_url":"https://api.github.com/users/icedream2linxi/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1781501464,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50MTc4MTUwMTQ2NA==","url":"https://api.github.com/repos/microsoft/vcpkg/issues/events/1781501464","actor":{"login":"ras0219-msft","id":12301622,"node_id":"MDQ6VXNlcjEyMzAxNjIy","avatar_url":"https://avatars.githubusercontent.com/u/12301622?v=4","gravatar_id":"","url":"https://api.github.com