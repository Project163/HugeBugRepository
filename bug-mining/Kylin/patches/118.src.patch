+        modelService.setSemanticUpdater(semanticService);
+        modelService.setIndexPlanService(indexPlanService);
+
+        try {
+            new JdbcRawRecStore(getTestConfig());
+        } catch (Exception e) {
+            //
+        }
+    }
+
+    @After
