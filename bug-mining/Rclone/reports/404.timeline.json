ssues{/number}","pulls_url":"https://api.github.com/repos/rclone/rclone/pulls{/number}","milestones_url":"https://api.github.com/repos/rclone/rclone/milestones{/number}","notifications_url":"https://api.github.com/repos/rclone/rclone/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/rclone/rclone/labels{/name}","releases_url":"https://api.github.com/repos/rclone/rclone/releases{/id}","deployments_url":"https://api.github.com/repos/rclone/rclone/deployments","created_at":"2014-03-16T16:19:57Z","updated_at":"2025-12-12T14:25:40Z","pushed_at":"2025-12-12T13:53:05Z","git_url":"git://github.com/rclone/rclone.git","ssh_url":"git@github.com:rclone/rclone.git","clone_url":"https://github.com/rclone/rclone.git","svn_url":"https://github.com/rclone/rclone","homepage":"https://rclone.org","size":216098,"stargazers_count":54045,"watchers_count":54045,"language":"Go","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":4794,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1082,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["azure-blob","azure-blob-storage","azure-files","backblaze-b2","cloud-storage","dropbox","encryption","ftp","fuse-filesystem","go","golang","google-cloud-storage","google-drive","onedrive","openstack-swift","rclone","s3","sftp","sync","webdav"],"visibility":"public","forks":4794,"open_issues":1082,"watchers":54045,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"<!--\r\n\r\nWelcome :-) We understand you are having a problem with rclone; we want to help you with that!\r\n\r\nIf you've just got a question or aren't sure if you've found a bug then please use the rclone forum:\r\n\r\n    https://forum.rclone.org/\r\n\r\ninstead of filing an issue for a quick response.\r\n\r\nIf you think you might have found a bug, please can you try to replicate it with the latest beta?\r\n\r\n    https://beta.rclone.org/\r\n    \r\nIf you can still replicate it with the latest beta, then please fill in the info below which makes our lives much easier.  A log with -vv will make our day :-)\r\n\r\nThank you\r\n\r\nThe Rclone Developers\r\n\r\n-->\r\n\r\n#### What is the problem you are having with rclone?\r\nWhen copying files from a large remote, --include-from doesn't work as expected.\r\nEach remote file gets queried separately, before the main transfer even starts.\r\nSee discussion here:\r\nhttps://forum.rclone.org/t/is-it-possible-to-disable-checkers/9413\r\n\r\n\r\n#### What is your rclone version (output from `rclone version`)\r\nrclone v1.46\r\n- os/arch: linux/amd64\r\n- go version: go1.12.1 \r\n\r\n\r\n#### Which OS you are using and how many bits (eg Windows 7, 64 bit)\r\nDebian Linux, 64 bit\r\n\r\n\r\n####  Which cloud storage system are you using? (eg Google Drive)\r\nGoogle Drive\r\n\r\n\r\n#### The command you were trying to run (eg `rclone copy /tmp remote:tmp`)\r\nrclone copy gdrive:test/ copy2/ --files-from ls2.txt -v -v --stats 10s --log-file log.download2.5m.fastlist --fast-list\r\n\r\n\r\n#### A log from the command with the `-vv` flag (eg output from `rclone -vv copy /tmp remote:tmp`)\r\nAttached. It's large, because this problem only shows up once you have a certain number of files in your remote, that you're trying to pull.\r\n[rclone.log](https://github.com/ncw/rclone/files/3051890/rclone.log)\r\n","reactions":{"url":"https://api.github.com/repos/rclone/rclone/issues/3102/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/rclone/rclone/issues/3102/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":2266508314,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDIyNjY1MDgzMTQ=","url":"https://api.github.com/repos/rclone/rclone/issues/events/2266508314","actor":{"login":"ncw","id":536803,"node_id":"MDQ6VXNlcjUzNjgwMw==","avatar_url":"https://avatars.githubusercontent.com/u/536803?v=4","gravatar_id":"","url":"https://api.github.com/users/ncw","html_url":"https://github.com/ncw","followers_url":"https://api.github.com/users/ncw/followers","following_url":"https://api.github.com/users/ncw/following{/other_user}","gists_url":"https://api.github.com/users/ncw/gists{/gist_id}","starred_url":"https://api.github.com/users/ncw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ncw/subscriptions","organizations_url":"https://api.github.com/users/ncw/orgs","repos_url":"https://api.github.com/users/ncw/repos","events_url":"https://api.github.com/users/ncw/events{/privacy}","received_events_url":"https://api.github.com/users/ncw/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"eb6ff029e10d589ac784e4d926f91f3d4a4ba3e3","commit_url":"https://api.github.com/repos/rclone/rclone/commits/eb6ff029e10d589ac784e4d926f91f3d4a4ba3e3","created_at":"2019-04-10T15:34:44Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/rclone/rclone/issues/comments/481742041","html_url":"https://github.com/rclone/rclone/issues/3095#issuecomment-481742041","issue_url":"https://api.github.com/repos/rclone/rclone/issues/3095","id":481742041,"node_id":"MDEyOklzc3VlQ29tbWVudDQ4MTc0MjA0MQ==","user":{"login":"ncw","id":536803,"node_id":"MDQ6VXNlcjUzNjgwMw==","avatar_url":"https://avatars.githubusercontent.com/u/536803?v=4","gravatar_id":"","url":"https://api.github.com/users/ncw","html_url":"https://github.com/ncw","followers_url":"https://api.github.com/users/ncw/followers","following_url":"https://api.github.com/users/ncw/following{/other_user}","gists_url":"https://api.github.com/users/ncw/gists{/gist_id}","starred_url":"https://api.github.com/users/ncw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ncw/subscriptions","organizations_url":"https://api.github.com/users/ncw/orgs","repos_url":"https://api.github.com/users/ncw/repos","events_url":"https://api.github.com/users/ncw/events{/privacy}","received_events_url":"https://api.github.com/users/ncw/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-04-10T15:35:13Z","updated_at":"2019-04-10T15:35:13Z","body":"I warmed up the beta here\r\n\r\nhttps://beta.rclone.org/branch/v1.46.0-114-geb6ff029-fix-files-from-traverse-beta/ (uploaded in 15-30 mins)\r\n\r\nEnable the workaround with `--files-from-traverse`\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/rclone/rclone/issues/comments/481742041/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ncw","id":536803,"node_id":"MDQ6VXNlcjUzNjgwMw==","avatar_url":"https://avatars.githubusercontent.com/u/536803?v=4","gravatar_id":"","url":"https://api.github.com/users/ncw","html_url":"https://github.com/ncw","followers_url":"https://api.github.com/users/ncw/followers","following_url":"https://api.github.com/users/ncw/following{/other_user}","gists_url":"https://api.github.com/users/ncw/gists{/gist_id}","starred_url":"https://api.github.com/users/ncw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ncw/subscriptions","organizations_url":"https://api.github.com/users/ncw/orgs","repos_url":"https://api.github.com/users/ncw/repos","events_url":"https://api.github.com/users/ncw/events{/privacy}","received_events_url":"https://api.github.com/users/ncw/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/rclone/rclone/issues/comments/481788792","html_url":"https://github.com/rclone/rclone/issues/3095#issuecomment-481788792","issue_url":"https://api.github.com/repos/rclone/rclone/issues/3095","id":481788792,"node_id":"MDEyOklzc3VlQ29tbWVudDQ4MTc4ODc5Mg==","user":{"login":"usbpc","id":3638901,"node_id":"MDQ6VXNlcjM2Mzg5MDE=","avatar_url":"https://avatars.githubusercontent.com/u/3638901?v=4","gravatar_id":"","url":"https://api.github.com/users/usbpc","html_url":"https://github.com/usbpc","followers_url":"https://api.github.com/users/usbpc/followers","following_url":"https://api.github.com/users/usbpc/following{/other_user}","gists_url":"https://api.github.com/users/usbpc/gists{/gist_id}","starred_url":"https://api.github.com/users/usbpc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/usbpc/subscriptions","organizations_url":"https://api.github.com/users/usbpc/orgs","repos_url":"https://api.github.com/users/usbpc/repos","events_url":"https://api.github.com/users/usbpc/events{/privacy}","received_events_url":"https://api.github.com/users/usbpc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-04-10T17:36:42Z","updated_at":"2019-04-10T17:36:42Z","body":"Nice, good to know when it was changed. Looking through the backblaze API it seems like there would be no good way for rclone to know if listing all files or just the files specified with `--files-from` would be cheaper.\r\n\r\nThe way to do this would be to see how many files are in the bucket in total and that information dosen't seem to be available in the b2 api.\r\n\r\nWith that in mind I feel like the best way to handle the situation is kind of what you are doing with the beta with allowing the use to choose how to handle the situation since they can easily decide what would be better for them.\r\n\r\nAlso is the way I'm doing things actually a good way to do it? What I'm trying to do is update a rendered map of my Minecraft server this way, that means that some files will have changed each time and there may also be files that are not already in the b2 bucket. And in the bucket currently there are 1.2 Million files and about 200_000 files are changed/created every time I update the map. ","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/rclone/rclone/issues/comments/481788792/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"usbpc","id":3638901,"node_id":"MDQ6VXNlcjM2Mzg5MDE=","avatar_url":"https://avatars.githubusercontent.com/u/3638901?v=4","gravatar_id":"","url":"https://api.github.com/users/usbpc","html_url":"https://github.com/usbpc","followers_url":"https://api.github.com/users/usbpc/followers","following_url":"https://api.github.com/users/usbpc/following{/other_user}","gists_url":"https://api.github.com/users/usbpc/gists{/gist_id}","starred_url":"https://api.github.com/users/usbpc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/usbpc/subscriptions","organizations_url":"https://api.github.com/users/usbpc/orgs","repos_url":"https://api.github.com/users/usbpc/repos","events_url":"https://api.github.com/users/usbpc/events{/privacy}","received_events_url":"https://api.github.com/users/usbpc/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/rclone/rclone/issues/comments/481862868","html_url":"https://github.com/rclone/rclone/issues/3095#issuecomment-481862868","issue_url":"https://api.github.com/repos/rclone/rclone/issues/3095","id":481862868,"node_id":"MDEyOklzc3VlQ29tbWVudDQ4MTg2Mjg2OA==","user":{"login":"ncw","id":536803,"node_id":"MDQ6VXNlcjUzNjgwMw==","avatar_url":"https://avatars.githubusercontent.com/u/536803?v=4","gravatar_id":"","url":"https://api.github.com/users/ncw","html_url":"https://github.com/ncw","followers_url":"https://api.github.com/users/ncw/followers","following_url":"https://api.github.com/users/ncw/following{/other_user}","gists_url":"https://api.github.com/users/ncw/gists{/gist_id}","starred_url":"https://api.github.com/users/ncw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ncw/subscriptions","organizations_url":"https://api.github.com/users/ncw/orgs","repos_url":"https://api.github.com/users/ncw/repos","events_url":"https://api.github.com/users/ncw/events{/privacy}","received_events_url":"https://api.github.com/users/ncw/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-04-10T20:58:41Z","updated_at":"2019-04-10T20:58:41Z","body":"> With that in mind I feel like the best way to handle the situation is kind of what you are doing with the beta with allowing the use to choose how to handle the situation since they can easily decide what would be better for them.\r\n\r\nI'm leaning towards making the previous behavior the default and making the new behaviour selectable with the `--no-traverse` flag which has exactly the correct semantics.\r\n\r\n> Also is the way I'm doing things actually a good way to do it? What I'm trying to do is update a rendered map of my Minecraft server this way, that means that some files will have changed each time and there may also be files that are not already in the b2 bucket. And in the bucket currently there are 1.2 Million files and about 200_000 files are changed/created every time I update the map.\r\n\r\nIf you are updating such a large % of files (16%) you might just be better doing a `sync` with `--fast-list` and forgetting the `--files-from` list.  It probably depends on whether the updates are spread all over, or whether they are concentrated into a subset of directories.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/rclone/rclone/issues/comments/481862868/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ncw","id":536803,"node_id":"MDQ6VXNlcjUzNjgwMw==","avatar_url":"https://avatars.githubusercontent.com/u/536803?v=4","gravatar_id":"","url":"https://api.github.com/users/ncw","html_url":"https://github.com/ncw","followers_url":"https://api.github.com/users/ncw/followers","following_url":"https://api.github.com/users/ncw/following{/other_user}","gists_url":"https://api.github.com/users/ncw/gists{/gist_id}","starred_url":"https://api.github.com/users/ncw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ncw/subscriptions","organizations_url":"https://api.github.com/users/ncw/orgs","repos_url":"https://api.github.com/users/ncw/repos","events_url":"https://api.github.com/users/ncw/events{/privacy}","received_events_url":"https://api.github.com/users/ncw/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":2272493674,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDIyNzI0OTM2NzQ=","url":"https://api.github.com/repos/rclone/rclone/issues/events/2272493674","actor":{"login":"ncw","id":536803,"node_id":"MDQ6VXNlcjUzNjgwMw==","avatar_url":"https://avatars.githubusercontent.com/u/536803?v=4","gravatar_id":"","url":"https://api.github.com/users/ncw","html_url":"https://github.com/ncw","followers_url":"https://api.github.com/users/ncw/followers","following_url":"https://api.github.com/users/ncw/following{/other_user}","gists_url":"https://api.github.com/users/ncw/gists{/gist_id}","starred_url":"https://api.github.com/users/ncw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ncw/subscriptions","organizations_url":"https://api.github.com/users/ncw/orgs","repos_url":"https://api.github.com/users/ncw/repos","events_url":"https://api.github.com/users/ncw/events{/privacy}","received_events_url":"https://api.github.com/users/ncw/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"c7bf473c9c1d13a53e218b2821443e3d547fb277","commit_url":"https://api.github.com/repos/rclone/rclone/commits/c7bf473c9c1d13a53e218b2821443e3d547fb277","created_at":"2019-04-12T13:42:54Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/rclone/rclone/issues/comments/482581046","html_url":"https://github.com/rclone/rclone/issues/3095#issuecomment-482581046","issue_url":"https://api.github.com/repos/rclone/rclone/issues/3095","id":482581046,"node_id":"MDEyOklzc3VlQ29tbWVudDQ4MjU4MTA0Ng==","user":{"login":"ncw","id":536803,"node_id":"MDQ6VXNlcjUzNjgwMw==","avatar_url":"https://avatars.githubusercontent.com/u/536803?v=4","gravatar_id":"","url":"https://api.github.com/users/ncw","html_url":"https://github.com/ncw","followers_url":"https://api.github.com/users/ncw/followers","following_url":"https://api.github.com/users/ncw/following{/other_user}","gists_url":"https://api.github.com/users/ncw/gists{/gist_id}","starred_url":"https://api.github.com/users/ncw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ncw/subscriptions","organizations_url":"https://api.github.com/users/ncw/orgs","repos_url":"https://api.github.com/users/ncw/repos","events_url":"https://api.github.com/users/ncw/events{/privacy}","received_events_url":"https://api.github.com/users/ncw/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-04-12T13:47:58Z","updated_at":"2019-04-12T13:47:58Z","body":"I've fixed this here - testing appreciated :-) I changed tack and made the default behavior as it was, and you'll need the `--no-traverse flag` to enable the new behaviour.  So in your case you don't want the `--no-traverse` flag.\r\n    filter: Make --files-from traverse as before unless --no-traverse is set\r\n    \r\n    In c5ac96e9e7 we made --files-from only read the objects specified and\r\n    don't scan directories.\r\n    \r\n    This caused problems with Google drive (very very slow) and B2\r\n    (excessive API consumption) so it was decided to make the old\r\n    behaviour (traversing the directories) the default with --files-from\r\n    and use the existing --no-traverse flag (which has exactly the right\r\n    semantics) to enable the new non scanning behaviour.\r\n\r\n\r\nhttps://beta.rclone.org/branch/v1.46.0-114-gc7bf473c-fix-files-from-traverse-beta/ (uploaded in 15-30 mins)","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/rclone/rclone/issues/comments/482581046/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ncw","id":536803,"node_id":"MDQ6VXNlcjUzNjgwMw==","avatar_url":"https://avatars.githubusercontent.com/u/536803?v=4","gravatar_id":"","url":"https://api.github.com/users/ncw","html_url":"https://github.com/ncw","followers_url":"https://api.github.com/users/ncw/followers","following_url":"https://api.github.com/users/ncw/following{/other_user}","gists_url":"https://api.github.com/users/ncw/gists{/gist_id}","starred_url":"https://api.github.com/users/ncw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ncw/subscriptions","organizations_url":"https://api.github.com/users/ncw/orgs","repos_url":"https://api.github.com/users/ncw/repos","events_url":"https://api.github.com/users/ncw/events{/privacy}","received_events_url":"https://api.github.com/users/ncw/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":2272937178,"node_id":"MDExOkNsb3NlZEV2ZW50MjI3MjkzNzE3OA==","url":"https://api.github.com/repos/rclone/rclone/issues/events/2272937178","actor":{"login":"ncw","id":536803,"node_id":"MDQ6VXNlcjUzNjgwMw==","avatar_url":"https://avatars.githubusercontent.com/u/536803?v=4","gravatar_id":"","url":"https://api.github.com/users/ncw","html_url":"https://github.com/ncw","followers_url":"https://api.github.com/users/ncw/followers","following_url":"https://api.github.com/users/ncw/following{/other_user}","gists_url":"https://api.github.com/users/ncw/gi