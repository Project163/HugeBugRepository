ediaSource, DownloadHelper downloadHelper) {\r\n      this.mediaSource = mediaSource;\r\n      this.downloadHelper = downloadHelper;\r\n      allocator = new DefaultAllocator(true, C.DEFAULT_BUFFER_SEGMENT_SIZE);\r\n      @SuppressWarnings(\"methodref.receiver.bound.invalid\")\r\n      Handler downloadThreadHandler = Util.createHandler(this::handleDownloadHelperCallbackMessage);\r\n      this.downloadHelperHandler = downloadThreadHandler;\r\n      mediaSourceThread = new HandlerThread(\"DownloadHelper\");\r\n      pendingMediaPeriods = new ArrayList<>();\r\n      mediaSourceThread.start();\r\n      mediaSourceHandler = Util.createHandler(mediaSourceThread.getLooper(), /* callback= */ this);\r\n      mediaSourceHandler.sendEmptyMessage(MESSAGE_PREPARE_SOURCE);\r\n    }\r\n```\r\n\r\nNo all the test suits pass successfully.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/509561825/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"drayan85","id":4456232,"node_id":"MDQ6VXNlcjQ0NTYyMzI=","avatar_url":"https://avatars.githubusercontent.com/u/4456232?v=4","gravatar_id":"","url":"https://api.github.com/users/drayan85","html_url":"https://github.com/drayan85","followers_url":"https://api.github.com/users/drayan85/followers","following_url":"https://api.github.com/users/drayan85/following{/other_user}","gists_url":"https://api.github.com/users/drayan85/gists{/gist_id}","starred_url":"https://api.github.com/users/drayan85/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/drayan85/subscriptions","organizations_url":"https://api.github.com/users/drayan85/orgs","repos_url":"https://api.github.com/users/drayan85/repos","events_url":"https://api.github.com/users/drayan85/events{/privacy}","received_events_url":"https://api.github.com/users/drayan85/received_events","type":