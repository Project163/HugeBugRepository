 }
+
+fn find_icon<F: Fn(&&String) -> bool>(
+  config: &Config,
+  config_parent: &Path,
+  predicate: F,
+  default: &str,
+) -> String {
+  let icon_path = config
+    .tauri
+    .bundle
+    .icon
+    .iter()
+    .find(|i| predicate(i))
+    .cloned()
+    .unwrap_or_else(|| default.to_string());
+  config_parent.join(icon_path).display().to_string()
+}
