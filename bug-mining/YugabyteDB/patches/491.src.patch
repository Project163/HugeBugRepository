+  @Test
+  public void simplest() throws Exception {
+    try (Statement stmt = connection.createStatement()) {
+      stmt.executeUpdate("CREATE TABLE nopk (id int)");
+      alterAddPrimaryKey(stmt, "nopk", "ADD PRIMARY KEY (id)");
+    }
+  }
