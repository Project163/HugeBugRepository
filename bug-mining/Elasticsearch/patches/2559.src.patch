index 00000000000..adc99017ca5
--- /dev/null
+++ b/x-pack/plugin/sql/qa/server/single-node/src/test/java/org/elasticsearch/xpack/sql/qa/single_node/ConsistentFunctionArgHandlingIT.java
@@ -0,0 +1,283 @@
+/*
