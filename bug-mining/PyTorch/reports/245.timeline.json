torch/blob/8acadd54d1836171f46b43177cd7aac82a7d9b3d/torch/utils/cpp_extension.py#L2693-L2700\n\n\nThis pattern is vulnerable to command injection if inputs are not strictly controlled, and it generally violates secure coding practices.\n\nBut I am not sure about it, whether to fix it or not?\n\nCWE-78:https://cwe.mitre.org/data/definitions/78.html\n\n\n### Versions\n\nNone\n\ncc @malfet @cyyever ","reactions":{"url":"https://api.github.com/repos/pytorch/pytorch/issues/169955/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/pytorch/pytorch/issues/169955/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}},"event":"cross-referenced"},{"actor":{"login":"lingebeng","id":102455956,"node_id":"U_kgDOBhtalA","avatar_url":"https://avatars.githubusercontent.com/u/102455956?v=4","gravatar_id":"","url":"https://api.github.com/users/lingebeng","html_url":"https://github.com/lingebeng","followers_url":"https://api.github.com/users/lingebeng/followers","following_url":"https://api.github.com/users/lingebeng/following{/other_user}","gists_url":"https://api.github.com/users/lingebeng/gists{/gist_id}","starred_url":"https://api.github.com/users/lingebeng/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lingebeng/subscriptions","organizations_url":"https://api.github.com/users/lingebeng/orgs","repos_url":"https://api.github.com/users/lingebeng/repos","events_url":"https://api.github.com/users/lingebeng/events{/privacy}","received_events_url":"https://api.github.com/users/lingebeng/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-10T01:30:43Z","updated_at":"2025-12-10T01:30:43Z","source":{"type":"issue","issue":{"url":"https://api.github.com/repos/pytorch/pytorch/issues/170022","repository_url":"https://api.github.com/repos/pytorch/pytorch","labels_url":"https://api.github.com/re