ub.com/repos/bazelbuild/bazel/issues/comments/558722045/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"baryluk","id":110322,"node_id":"MDQ6VXNlcjExMDMyMg==","avatar_url":"https://avatars.githubusercontent.com/u/110322?v=4","gravatar_id":"","url":"https://api.github.com/users/baryluk","html_url":"https://github.com/baryluk","followers_url":"https://api.github.com/users/baryluk/followers","following_url":"https://api.github.com/users/baryluk/following{/other_user}","gists_url":"https://api.github.com/users/baryluk/gists{/gist_id}","starred_url":"https://api.github.com/users/baryluk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/baryluk/subscriptions","organizations_url":"https://api.github.com/users/baryluk/orgs","repos_url":"https://api.github.com/users/baryluk/repos","events_url":"https://api.github.com/users/baryluk/events{/privacy}","received_events_url":"https://api.github.com/users/baryluk/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/569559259","html_url":"https://github.com/bazelbuild/bazel/issues/6815#issuecomment-569559259","issue_url":"https://api.github.com/repos/bazelbuild/bazel/issues/6815","id":569559259,"node_id":"MDEyOklzc3VlQ29tbWVudDU2OTU1OTI1OQ==","user":{"login":"gnu-andrew","id":962817,"node_id":"MDQ6VXNlcjk2MjgxNw==","avatar_url":"https://avatars.githubusercontent.com/u/962817?v=4","gravatar_id":"","url":"https://api.github.com/users/gnu-andrew","html_url":"https://github.com/gnu-andrew","followers_url":"https://api.github.com/users/gnu-andrew/followers","following_url":"https://api.github.com/users/gnu-andrew/following{/other_user}","gists_url":"https://api.github.com/users/gnu-andrew/gists{/gist_id}","starred_url":"https://api.github.com/users/gnu-andrew/starred{/owner}{/repo}","subscriptio