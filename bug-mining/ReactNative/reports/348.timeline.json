13:08Z","updated_at":"2019-07-18T00:13:08Z","body":"**UPDATE**\r\n\r\nAs I said above, using `react-native start` inside a fresh new project created by `react-native-cli` triggers the absurd consumption of RAM by the bundler, but if you stop the bundler and start it again, the issue stops.\r\n\r\nAfter that, I tried running `watchman watch-del-all && react-native start --reset-cache` and **it triggered the RAM consumption issue again**.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/facebook/react-native/issues/comments/512614889/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"josecarlosns","id":28950443,"node_id":"MDQ6VXNlcjI4OTUwNDQz","avatar_url":"https://avatars.githubusercontent.com/u/28950443?v=4","gravatar_id":"","url":"https://api.github.com/users/josecarlosns","html_url":"https://github.com/josecarlosns","followers_url":"https://api.github.com/users/josecarlosns/followers","following_url":"https://api.github.com/users/josecarlosns/following{/other_user}","gists_url":"https://api.github.com/users/josecarlosns/gists{/gist_id}","starred_url":"https://api.github.com/users/josecarlosns/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/josecarlosns/subscriptions","organizations_url":"https://api.github.com/users/josecarlosns/orgs","repos_url":"https://api.github.com/users/josecarlosns/repos","events_url":"https://api.github.com/users/josecarlosns/events{/privacy}","received_events_url":"https://api.github.com/users/josecarlosns/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/facebook/react-native/issues/comments/512632472","html_url":"https://github.com/facebook/react-native/issues/25698#issuecomment-512632472","issue_url":"https://api.github.com/repos/facebook/react-native/issues/25698","id":512632472,"node_id":"MDEyOklzc3VlQ29tbWVudDUxMjYzMjQ3Mg==","user":{"login":"josecarlosns","id":28950443,"node_id":"MDQ6VXNlcjI4OTUwNDQz","avatar_url":"https://avatars.githubusercontent.com/u/28950443?v=4","gravatar_id":"","url":"https://api.github.com/users/josecarlosns","html_url":"https://github.com/josecarlosns","followers_url":"https://api.github.com/users/josecarlosns/followers","following_url":"https://api.github.com/users/josecarlosns/following{/other_user}","gists_url":"https://api.github.com/users/josecarlosns/gists{/gist_id}","starred_url":"https://api.github.com/users/josecarlosns/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/josecarlosns/subscriptions","organizations_url":"https://api.github.com/users/josecarlosns/orgs","repos_url":"https://api.github.com/users/josecarlosns/repos","events_url":"https://api.github.com/users/josecarlosns/events{/privacy}","received_events_url":"https://api.github.com/users/josecarlosns/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-07-18T01:50:12Z","updated_at":"2019-07-18T01:50:12Z","body":"**UPDATE 2 WITH WORKAROUND**\r\n\r\nReturning to `react-native@0.59.8` solved the issue for me. \r\n\r\nSadly I had to remake the project using `react-native init myproj --version 0.59.8` (with an earlier version of `react-native-cli`, for the current version forbids creating new apps with versions pre-0.60) because while simply downgrading the `react-native` dependency solved the RAM consumption issue, it created many more issues when I tried to run on a device/emulator because the build configurations from the android/ios modules where made to work with RN 0.60+. Since I've only started learning and working with RN a few weeks ago, those files are still too complex for me to manually fix, so it was easier just to rely on `react-native init` to create those for me.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/facebook/react-nativ