mework.com","size":87780,"stargazers_count":14308,"watchers_count":14308,"language":"PHP","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":6857,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":521,"license":{"key":"bsd-3-clause","name":"BSD 3-Clause \"New\" or \"Revised\" License","spdx_id":"BSD-3-Clause","url":"https://api.github.com/licenses/bsd-3-clause","node_id":"MDc6TGljZW5zZTU="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["framework","hacktoberfest","php","php-framework","yii","yii2"],"visibility":"public","forks":6857,"open_issues":521,"watchers":14308,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"### What steps will reproduce the problem?\r\n\r\n```\r\nclass PostQuery extends \\yii\\db\\ActiveQuery {\r\n\r\n    public function init(){\r\n        $this->innerJoinWith('category'); // Join category table for every query\r\n        $this->addWhere(['{{%category}}.id' => Yii::$app->category->id]); // required condition for every query at current application\r\n        parent::init();\r\n    }\r\n\r\n}\r\n```\r\n\r\n```\r\n$model = Post::findOne(1);\r\n$model->refresh();\r\n```\r\n\r\nIn method BaseActiveRecord::refresh() we got:\r\n```\r\n$record = static::findOne($this->getPrimaryKey(true));\r\n```\r\n\r\nmethod BaseActiveRecord::getPrimaryKey(true) return array ['id' => 1]\r\nand we got ambiguous column 'id'\r\n\r\nP.S.: sorry for my english :)\r\n\r\n### What is the expected result?\r\n\r\nduplicate refresh() method in ActiveRecord class\r\nand replace\r\n\r\n```\r\npublic function refresh()\r\n{\r\n\t$query = static::find();\r\n\tif (!empty($query->join) || !empty($query->joinWith)) {\r\n\t\t$condition = [];\r\n\t\tforeach ($this->getPrimaryKey(true) as $column=>$value){\r\n\t\t\t$condition[static::tableName() . '.' . $column] = $value;\r\n\t\t}\r\n\t} else {\r\n\t\t$condition = $this->getPrimaryKey(true);\r\n\t}\r\n\r\n\t/* @var $record BaseActiveRecord */\r\n\t$record = static::findOne($condition);\r\n\tif ($record === null) {\r\n\t\treturn false;\r\n\t}\r\n\tforeach ($this->attributes() as $name) {\r\n\t\t$this->_attributes[$name] = isset($record->_attributes[$name]) ? $record->_attributes[$name] : null;\r\n\t}\r\n\t$this->_oldAttributes = $record->_oldAttributes;\r\n\t$this->_related = [];\r\n\t$this->afterRefresh();\r\n\r\n\treturn true;\r\n}\r\n```\r\n\r\n### What do you get instead?\r\nSQL error:\r\n\r\n```\r\nSQLSTATE[23000]: Integrity constraint violation: 1052 Column 'id' in where clause is ambiguous\r\nThe SQL being executed was: SELECT `training_module`.* FROM `training_module` INNER JOIN `training_category` ON `training_module`.`training_category_id` = `training_category`.`id` WHERE (`id`=15) AND (`training_category`.`training_id`=1)\r\n```\r\n\r\n### Additional info\r\n\r\n| Q                | A\r\n| ---------------- | ---\r\n| Yii version      | 2.0.11.2\r\n| PHP version      | 7.0\r\n| Operating system | Ubuntu 16.04\r\n","reactions":{"url":"https://api.github.com/repos/yiisoft/yii2/issues/13757/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yiisoft/yii2/issues/13757/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"actor":{"login":"snyk-bot","id":19733683,"node_id":"MDQ6VXNlcjE5NzMzNjgz","avatar_url":"https://avatars.githubusercontent.com/u/19733683?v=4","gravatar_id":"","url":"https://api.github.com/users/snyk-bot","html_url":"https://github.com/snyk-bot","followers_url":"https://api.github.com/users/snyk-bot/followers","following_url":"https://api.github.com/users/snyk-bot/following{/other_user}","gists_url":"https://api.github.com/users/snyk-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/snyk-bot/starred{/own