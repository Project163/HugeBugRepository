+package io.quarkus.it.panache;
+
+import javax.enterprise.context.ApplicationScoped;
+
+import io.quarkus.hibernate.orm.panache.PanacheRepositoryBase;
+
+@ApplicationScoped
+public class DuplicateRepository implements PanacheRepositoryBase<DuplicateEntity, Integer> {
+
+    @Override
+    public DuplicateEntity findById(Integer id) {
+        DuplicateEntity duplicate = new DuplicateEntity();
+        duplicate.id = id;
+        return duplicate;
+    }
+}
diff --git a/integration-tests/hibernate-orm-panache/src/test/java/io/quarkus/it/panache/DuplicateMethodTest.java b/integration-tests/hibernate-orm-panache/src/test/java/io/quarkus/it/panache/DuplicateMethodTest.java
