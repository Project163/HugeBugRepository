NlcjM2NzIyNw==","avatar_url":"https://avatars.githubusercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":69,"state":"open","created_at":"2012-09-12T10:39:14Z","updated_at":"2019-04-22T10:38:08Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2015-01-16T05:10:52Z","updated_at":"2015-02-10T00:02:32Z","closed_at":"2015-02-10T00:02:32Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"This may be an issue with clang and not glm.\n\nOn line 783 in setup.hpp GLM_INLINE is defined as \"**attribute**((**always_inline**))\". I have a static library that uses GLM linking to my application that also uses GLM. I'm also using the GLM_FORCE_INLINE macro.\n\nWhen linking as is, I'll get duplicate definition problems. Modifying GLM_INLINE to be defined the same as the GCC line above \"inline **attribute**((**always_inline**))\" resolves this issue, but I don't want to submit a pull because I don't know if this has unintended consequences for other users of the library (and I really don't know pull etiquette). I'm also not sure if it is even a proper fix, as my reading around lead me to believe we're hinting to the compiler and its up to  the compiler rather or not to disregard the inline attribute. Also, I'm not really a programmer, I just like to pretend I am.\n\nAs far as my env setup goes, as reported from #GLM_MESSAGES\nGLM: version 0.9.7\nGLM: Linux platform detected\nGLM: LLVM compiler detected\nGLM: 64 bits model\nGLM: C++11\nGLM: SSE2 instruction set\nGLM: Swizzling operators disabled [..etc]\nGLM: .length() returns glm::length_t [..etc]\n\nI hope I'm not wasting your time, but I've been banging my head against this wall for a couple of days now because everything looked correct to me. I just hope to save someone else some grief. The only other thing I think could be relevent to this, is it seems llvm-ld/link has been deprecated, and these days the the system linker is used (gnu ld in my case), at least until their lld project matures.\n","closed_by":{"login":"Groovounet","id":367227,"node_id":"MDQ6VXNlcjM2NzIyNw==","avatar_url":"https://avatars.githubusercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.gi