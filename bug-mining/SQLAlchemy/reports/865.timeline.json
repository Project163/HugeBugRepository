f columns inside of _proxies also and need the test case here to reproduce","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/507848205/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":2455698215,"node_id":"MDEzOlJlb3BlbmVkRXZlbnQyNDU1Njk4MjE1","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/2455698215","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"reopened","commit_id":null,"commit_url":null,"created_at":"2019-07-02T21:18:00Z","state_reason":null,"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/507863844","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/4747#issuecomment-507863844","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/4747","id":507863844,"node_id":"MDEyOklzc3VlQ29tbWVudDUwNzg2Mzg0NA==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-07-02T22:11:33Z","updated_at":"2019-07-02T22:12:15Z","body":"while this can be fixed, it's a major problem because by putting the annotated column into proxy_set, we pull in its very expensive ``__eq__()`` and ``__hash__()`` methods and blow up all the performance tests.    So I can't find a way to generalize being able to use a Column's proxy_set along with annotations unless we change how proxy_set works.    I've tried adding an uncached version but that puts us back into the performance situation.   Basically any column that has an \"annotated\" inside of its proxy set is now expensive, so I think we may need to make this datastructure different so that the annotations or annotated version of the column can be held separate.\r\n\r\n\r\n```\r\n    def test_proxy_set_iteration_includes_annotated_two(self):\r\n        from sqlalchemy.schema import Column\r\n\r\n        c1 = Column(\"foo\", Integer)\r\n\r\n        stmt = select([c1]).alias()\r\n        proxy = stmt.c.foo\r\n        c1.proxy_set\r\n\r\n        proxy._proxies = [c1._annotate({\"weight\": 10})]\r\n\r\n        d = {}\r\n        for col in proxy.proxy_set:\r\n            d.update(col._annotations)\r\n        eq_(d, {\"weight\": 10})\r\n\r\n```\r\n\r\n\r\nin particular, we maybe should prevent annotated columns in the proxy_set at all because comparisons are more expensive:\r\n\r\n```\r\ndiff --git a/lib/sqlalchemy/sql/elements.py b/lib/sqlalchemy/sql/elements.py\r\nindex aa7b7f6888..50baf734d1 100644\r\n--- a/lib/sqlalchemy/sql/elements.py\r\n+++ b/lib/sqlalchemy/sql/elements.py\r\n@@ -4384,10 +4384,12 @@ def _corresponding_column_or_error(fromclause, column, require_embedded=False):\r\n \r\n class AnnotatedColumnElement(Annotated):\r\n     def __init__(self, element, values):\r\n+        element.proxy_set  # make sure Annotated does *not* go into the\r\n+                           # proxy set, because it's expensive! :)\r\n+                           # this might be where we add some annotations or\r\n+                           # something.\r\n         Annotated.__init__(self, element, values)\r\n         ColumnElement.comparator._reset(self)\r\n-        if self._proxies:\r\n-            ColumnElement.proxy_set._reset(self)\r\n         for attr in (\"name\", \"key\", \"table\"):\r\n             if self.__dict__.get(attr, False) is None:\r\n                 self.__dict__.pop(attr)\r\n\r\n\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/507863844/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/507865422","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/4747#issuecomment-507865422","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/4747","id":507865422,"node_id":"MDEyOklzc3VlQ29tbWVudDUwNzg2NTQyMg==","user":{"login":"sqla-tester","id":8250554,"node_id":"MDQ6VXNlcjgyNTA1NTQ=","avatar_url":"https://avatars.githubusercontent.com/u/8250554?v=4","gravatar_id":"","url":"https://api.github.com/users/sqla-tester","html_url":"https://github.com/sqla-tester","followers_url":"https://api.github.com/users/sqla-tester/followers","following_url":"https://api.g