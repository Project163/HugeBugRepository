+      register,
+    }: {
+      control: Control<FormValues>;
+      index: number;
+      register: UseFormRegister<FormValues>;
+    }) => {
+      const { fields, append } = useFieldArray({
+        name: `root.${index}.children`,
+        control,
+      });
+
+      return (
+        <div>
+          {fields.map((field, k) => {
