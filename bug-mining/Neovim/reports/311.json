f0-4072-b806-0303a05f6640.png)\n\n### Actual behavior\n\nThe first byte of the `个` is missing:\r\n![nvim](https://user-images.githubusercontent.com/35768171/208832513-de5e04b5-0d63-4813-8349-d406d74fdea4.png)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/neovim/neovim/issues/21486/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/neovim/neovim/issues/21486/timeline","performed_via_github_app":null,"state_reason":null}