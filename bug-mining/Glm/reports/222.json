/avatars.githubusercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":2,"closed_issues":212,"state":"open","created_at":"2012-09-12T10:39:38Z","updated_at":"2023-12-21T16:45:01Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2018-06-06T12:20:17Z","updated_at":"2018-06-18T11:02:57Z","closed_at":"2018-06-18T10:43:01Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"FreeBSD 11.1, clang 4:\r\n\r\n```\r\n.../glm-0.9.9.0/test/core/core_func_matrix.cpp:300:71: error: format specifies type 'unsigned long' but the argument has type 'int' [-Werror,-Wformat]                                                                       \r\n        printf(\"inverse<%s>(%f): %lu\\n\", Message, static_cast<double>(Diff), EndTime - StartTime);                                                                                                                                                                    \r\n                                 ~~~                                         ^~~~~~~~~~~~~~~~~~~                                                                                                                                                                      \r\n                                 %d                                                                                                                                                                                                                                   \r\n```\r\n\r\nThis problem exists in\r\n- test/gtc/gtc_integer.cpp\r\n- test/core/core_type_vec4.cpp\r\n- test/core/core_func_matrix.cpp\r\n- test/gtx/gtx_fast_trigonometry.cpp\r\n\r\nstd::clock_t size is [unspecified](http://en.cppreference.com/w/cpp/chrono/c/clock_t), so passing it directly into printf is a bad idea. Either casts are needed, or printfs should be replaced with streams (which seems better and more C++ish solution to me).","closed_by":{"login":"Groovounet","id":367227,"node_id":"MDQ6VXNlcjM2NzIyNw==","avatar_url":"https://avatars.githubusercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/g-truc/glm/issues/778/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"h