mpare_url":"https://api.github.com/repos/yugabyte/yugabyte-db/compare/{base}...{head}","merges_url":"https://api.github.com/repos/yugabyte/yugabyte-db/merges","archive_url":"https://api.github.com/repos/yugabyte/yugabyte-db/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/yugabyte/yugabyte-db/downloads","issues_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues{/number}","pulls_url":"https://api.github.com/repos/yugabyte/yugabyte-db/pulls{/number}","milestones_url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones{/number}","notifications_url":"https://api.github.com/repos/yugabyte/yugabyte-db/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels{/name}","releases_url":"https://api.github.com/repos/yugabyte/yugabyte-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Jira Link: [DB-3003](https://yugabyte.atlassian.net/browse/DB-3003)\r\n### Description\n\nWhen a cluster is being upgraded we automatically run `upgrade_ysql` from YBAnywhere after the rest of the upgrade steps have completed. This command opens 1 client connection per DB in the cluster. In YBManaged, we limit free tier clusters to 13 connections (with 3 of those reserved for superuser). This means that there is a possibility where `num_active_client_connections + num_db_in_cluster > max_ysql_connections` which results in the upgrade failing.\r\n\r\nIt would be really useful to us on the YBManaged team for there to be some option (gflag?) to limit the `upgrade_ysql` command to only 1 client connection such that it's much less likely that we run into this issue in the future.","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/13364/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/13364/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":7483970194,"node_id":"REFE_lADOBlCVUc5QuXyDzwAAAAG-FFKS","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/7483970194","actor":{"login":"frozenspider","id":2077017,"node_id":"MDQ6VXNlcjIwNzcwMTc=","avatar_url":"https://avatars.githubusercontent.com/u/2077017?v=4","gravatar_id":"","url":"https://api.github.com/users/frozenspider","html_url":"https://github.com/frozenspider","followers_url":"https://api.github.com/users/frozenspider/followers","following_url":"https://api.github.com/users/frozenspider/following{/other_user}","gists_url":"https://api.github.com/users/frozenspider/gists{/gist_id}","starred_url":"https://api.github.com/users/frozenspider/starred{/owner}{/re