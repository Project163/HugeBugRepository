-813f35d3b6a2.png)\r\n\r\nThe only difference is the Vue version.\r\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/vuejs/core/issues/comments/934571082/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"kad-tijhuo","id":63776953,"node_id":"MDQ6VXNlcjYzNzc2OTUz","avatar_url":"https://avatars.githubusercontent.com/u/63776953?v=4","gravatar_id":"","url":"https://api.github.com/users/kad-tijhuo","html_url":"https://github.com/kad-tijhuo","followers_url":"https://api.github.com/users/kad-tijhuo/followers","following_url":"https://api.github.com/users/kad-tijhuo/following{/other_user}","gists_url":"https://api.github.com/users/kad-tijhuo/gists{/gist_id}","starred_url":"https://api.github.com/users/kad-tijhuo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kad-tijhuo/subscriptions","organizations_url":"https://api.github.com/users/kad-tijhuo/orgs","repos_url":"https://api.github.com/users/kad-tijhuo/repos","events_url":"https://api.github.com/users/kad-tijhuo/events{/privacy}","received_events_url":"https://api.github.com/users/kad-tijhuo/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":5412140479,"node_id":"LE_lADOCCum1848la4azwAAAAFClrW_","url":"https://api.github.com/repos/vuejs/core/issues/events/5412140479","actor":{"login":"posva","id":664177,"node_id":"MDQ6VXNlcjY2NDE3Nw==","avatar_url":"https://avatars.githubusercontent.com/u/664177?v=4","gravatar_id":"","url":"https://api.github.com/users/posva","html_url":"https://github.com/posva","followers_url":"https://api.github.com/users/posva/followers","following_url":"https://api.github.com/users/posva/following{/other_user}","gists_url":"https://api.github.com/users/posva/gists{/gist_id}","starred_url":"https://api.github.com/users/posva/starred{/owner}{/repo}","subscriptions_url":"https://api.