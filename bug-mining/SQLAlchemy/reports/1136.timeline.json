emy import Integer\r\nfrom sqlalchemy import select\r\nfrom sqlalchemy.ext.declarative import declarative_base\r\nfrom sqlalchemy.orm import declarative_base\r\nBase = declarative_base()\r\n\r\n\r\nclass A(Base):\r\n    __tablename__ = 'a'\r\n\r\n    id = Column(Integer, primary_key=True)\r\n\r\n\r\nclass B(Base):\r\n    __tablename__ = 'b'\r\n    id = Column(Integer, primary_key=True)\r\n\r\n\r\nsubq = select(A.id)\r\n\r\ns1 = select(B).where(B.id.in_(subq.subquery()))\r\ns2 = select(B).where(B.id.in_(subq.subquery()))\r\n\r\n```\r\n\r\n```\r\nFile \"/home/classic/dev/sqlalchemy/lib/sqlalchemy/sql/operators.py\", line 604, in in_\r\n    return self.operate(in_op, other)\r\n  File \"/home/classic/dev/sqlalchemy/lib/sqlalchemy/sql/type_api.py\", line 75, in operate\r\n    return o[0](self.expr, op, *(other + o[1:]), **kwargs)\r\n  File \"/home/classic/dev/sqlalchemy/lib/sqlalchemy/sql/default_comparator.py\", line 155, in _in_impl\r\n    seq_or_selectable = coercions.expect(\r\n  File \"/home/classic/dev/sqlalchemy/lib/sqlalchemy/sql/coercions.py\", line 200, in expect\r\n    return impl._implicit_coercions(\r\n  File \"/home/classic/dev/sqlalchemy/lib/sqlalchemy/sql/coercions.py\", line 513, in _implicit_coercions\r\n    return self._post_coercion(resolved.select(), **kw)\r\n  File \"/home/classic/dev/sqlalchemy/lib/sqlalchemy/sql/coercions.py\", line 558, in _post_coercion\r\n    return element.scalar_subquery()\r\n  File \"/home/classic/dev/sqlalchemy/lib/sqlalchemy/sql/selectable.py\", line 2961, in scalar_subquery\r\n    return ScalarSelect(self)\r\n  File \"/home/classic/dev/sqlalchemy/lib/sqlalchemy/sql/selectable.py\", line 5990, in __init__\r\n    self.type = element._scalar_type()\r\n  File \"/home/classic/dev/sqlalchemy/lib/sqlalchemy/sql/selectable.py\", line 4975, in _scalar_type\r\n    return cols[0].type\r\nIndexError: list index out of range\r\n```","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/6394/reactions","total_co