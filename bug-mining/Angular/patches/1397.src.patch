diff --git a/packages/router/test/router_link_spec.ts b/packages/router/test/router_link_spec.ts
new file mode 100644
index 0000000000..bbdb6d3542
--- /dev/null
+++ b/packages/router/test/router_link_spec.ts
@@ -0,0 +1,104 @@
+/**
