ers/caarlos0/subscriptions","organizations_url":"https://api.github.com/users/caarlos0/orgs","repos_url":"https://api.github.com/users/caarlos0/repos","events_url":"https://api.github.com/users/caarlos0/events{/privacy}","received_events_url":"https://api.github.com/users/caarlos0/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"75c373bdf26f52b34e9cb980d9c8da52de7fb7ce","commit_url":"https://api.github.com/repos/goreleaser/goreleaser/commits/75c373bdf26f52b34e9cb980d9c8da52de7fb7ce","created_at":"2020-04-22T11:47:06Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/goreleaser/goreleaser/issues/comments/618907607","html_url":"https://github.com/goreleaser/goreleaser/issues/1462#issuecomment-618907607","issue_url":"https://api.github.com/repos/goreleaser/goreleaser/issues/1462","id":618907607,"node_id":"MDEyOklzc3VlQ29tbWVudDYxODkwNzYwNw==","user":{"login":"terrabitz","id":11320431,"node_id":"MDQ6VXNlcjExMzIwNDMx","avatar_url":"https://avatars.githubusercontent.com/u/11320431?v=4","gravatar_id":"","url":"https://api.github.com/users/terrabitz","html_url":"https://github.com/terrabitz","followers_url":"https://api.github.com/users/terrabitz/followers","following_url":"https://api.github.com/users/terrabitz/following{/other_user}","gists_url":"https://api.github.com/users/terrabitz/gists{/gist_id}","starred_url":"https://api.github.com/users/terrabitz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/terrabitz/subscriptions","organizations_url":"https://api.github.com/users/terrabitz/orgs","repos_url":"https://api.github.com/users/terrabitz/repos","events_url":"https://api.github.com/users/terrabitz/events{/privacy}","received_events_url":"https://api.github.com/users/terrabitz/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-04-24T09:31:12Z","updated_at":"2020-04-24T09:31:12Z","body":"After a lot more trial-and-error, I think I've narrowed down the scope of the problem. It seems like the problem only manifests if a templated value is used in the `builds[].binary` section. For example, the docker pipeline in this `.goreleaser.yml` works just fine:\r\n\r\n```yaml\r\nproject_name: gowebapptemplate\r\nbuilds:\r\n  - \r\n    goos:\r\n      - linux\r\n\r\ndockers:\r\n  - \r\n    image_templates:\r\n      - \"terrabitz/{{ .ProjectName }}:latest\"\r\n```\r\n\r\nHowever, this `.goreleaser.yml` says that it can't find the binary during the docker phase:\r\n\r\n```yaml\r\nproject_name: gowebapptemplate\r\nbuilds:\r\n  - \r\n    goos:\r\n      - linux\r\n    binary: \"{{ .ProjectName }}\"\r\ndockers:\r\n  - \r\n    image_templates:\r\n      - \"terrabitz/{{ .ProjectName }}:latest\"\r\n```\r\n\r\nThis problem seems to be isolated to using a templated value like `\"{{ .ProjectName }}\"` in `builds[].binary`. For example, the following works just fine\r\n\r\n```yaml\r\nproject_name: gowebapptemplate\r\nbuilds:\r\n  - \r\n    goos:\r\n      - linux\r\n    binary: foo\r\ndockers:\r\n  - \r\n    binaries:\r\n      - foo\r\n    image_templates:\r\n      - \"terrabitz/{{ .ProjectName }}:latest\"\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/goreleaser/goreleaser/issues/comments/618907607/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"terrabitz","id":11320431,"node_id":"MDQ6VXNlcjExMzIwNDMx","avatar_url":"https://avatars.githubusercontent.com/u/11320431?v=4","gravatar_id":"","url":"https://api.github.com/users/terrabitz","html_url":"https://github.com/terrabitz","followers_url":"https://api.github.com/users/terrabitz/followers","following_url":"https://api.github.com/users/terrabitz/following{/other_user}","gists_url":"https://api.github.com/users/terrabitz/gists{/gist_id}","starred_url":"https://api.github.com/users/terrabitz/starre