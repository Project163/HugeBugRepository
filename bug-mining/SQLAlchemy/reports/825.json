E0","default":false,"description":null},{"id":1141273914,"node_id":"MDU6TGFiZWwxMTQxMjczOTE0","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/labels/postgresql","name":"postgresql","color":"60A070","default":false,"description":""},{"id":1142415575,"node_id":"MDU6TGFiZWwxMTQyNDE1NTc1","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/labels/reflection","name":"reflection","color":"60e0cb","default":false,"description":"reflection of tables, columns, constraints, defaults, sequences, views, everything else"}],"state":"closed","locked":false,"assignee":null,"assignees":[],"milestone":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/milestones/84","html_url":"https://github.com/sqlalchemy/sqlalchemy/milestone/84","labels_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/milestones/84/labels","id":3850672,"node_id":"MDk6TWlsZXN0b25lMzg1MDY3Mg==","number":84,"title":"1.2.x","description":"","creator":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":120,"state":"closed","created_at":"2018-11-27T04:36:03Z","updated_at":"2019-05-18T20:58:54Z","due_on":null,"closed_at":"2019-05-18T20:58:54Z"},"comments":10,"created_at":"2019-01-23T17:33:09Z","updated_at":"2019-01-25T16:14:49Z","closed_at":"2019-01-25T14:31:15Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Summary\r\n\r\nReflection of check constraints against PostgreSQL databases queries the `pg_constraint.consrc` column.  This has been deprecated in PostgreSQL 12, so constraint reflection will fail against that version.\r\n\r\n### Details\r\n\r\nCheck constraint reflection takes place in the following code function:\r\n\r\nhttps://github.com/sqlalchemy/sqlalchemy/blob/bd735eba637cbf2c157046f72dc795a8b2b803e7/lib/sqlalchemy/dialects/postgresql/base.py#L3376\r\n\r\nHowever, this query will fail in PostgreSQL 12, when the `consrc` column of the table is deprecated:\r\n\r\nhttps://git.postgresql.org/gitweb/?p=postgresql.git;a=commit;h=96b00c433cd615144a34ff1a79d691d8b297120d\r\n\r\n### Potential fix\r\n\r\nThe recommended way to fix this is to use the `pg_get_constraintdef` function instead.  The PostGIS project hit this issue and their solution may be helpful: https://trac.osgeo.org/postgis/ticket/4231\r\n\r\n### Is this a bug?\r\n\r\nI think this counts as a bug. I encountered the issue when models generated by sqlacodegen had different constraints to those displayed in PGAdmin4's SQL view.  However, I can't provide a script to demonstrate this because I don't know how the results from `pg_get_constraintdef` and `pg_constraint.consrc` came to be different in the first place!\r\n\r\nThis will be a bug when run with PostgreSQL 12.  A potential way to test it is to add check constraints to a PostgreSQL 12 table and then try to reflect them.\r\n\r\n### SQLAlchemy version\r\n\r\nIssue noticed against version 1.2.12 (but applies to [latest commit at time of writing](https://github.com/sqlalchemy/sqlalchemy/commit/bd735eba637cbf2c157046f72dc795a8b2b803e7))\r\n","closed_by":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/4463/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/4463/timeline","performed_via_github_app":null,"state_reason":"completed"}