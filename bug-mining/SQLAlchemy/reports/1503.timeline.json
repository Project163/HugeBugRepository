ivacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-03-02T15:07:40Z","updated_at":"2024-03-02T15:07:40Z","body":"then the other way is if we can somehow get those replace params in a dictionary of some kind that somehow gets propagated out to `construct_params()` to be part of the \"extracted_parameters\".   ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1974824796/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1974828962","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/11085#issuecomment-1974828962","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/11085","id":1974828962,"node_id":"IC_kwDOCX5JB851tX-i","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-03-02T15:25:26Z","updated_at":"2024-03-02T15:25:26Z","body":"ok i dont have time to do this right now but this can work if _apply_params_to_element applies the diciontary of bound paramters **to the cache key that the target element generates, not the SQL expression itself**.  that is we make a shallow clone of the cached expression, apply a memoized bound parameter dict, and we then access that when that element generates its cache key to affect that new .bindparams collection.   \r\n\r\nthat should be able to work here","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1974828962/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1974831765","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/11085#issuecomment-1974831765","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/11085","id":1974831765,"node_id":"IC_kwDOCX5JB851tYqV","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-03-02T15:37:16Z","updated_at":"2024-03-02T15:37:16Z","body":"here's a POC, this can work, this solves everything\r\n\r\n```diff\r\ndiff --git a/lib/sqlalchemy/orm/strategy_options.py b/lib/sqlalchemy/orm/strategy_options.py\r\nindex c77260434..9c1fa6d20 100644\r\n--- a/lib/sqlalchemy/orm/strategy_options.py\r\n+++ b/lib/sqlalchemy/orm/strategy_options.py\r\n@@ -1060,16 +1060,6 @@ class Load(_AbstractLoad):\r\n         def process(opt: _LoadElement) -> _LoadElement:\r\n             nonlocal orig_cache_key, replacement_cache_key, found_crit\r\n \r\n-            # issue #11085.   check each _extra_criteria for bound parameters.\r\n-            # if none found, we dont need to do the quite expensive clone /\r\n-            # apply operation\r\n-            for elem in opt._extra_criteria:\r\n-                eck = elem._generate_cache_key()\r\n-                if eck.bindparams:\r\n-                    break\r\n-            else:\r\n-                return opt\r\n-\r\n             cloned_opt = opt._clone()\r\n \r\n             found_crit = True\r\ndiff --git a/lib/sqlalchemy/sql/cache_key.py b/lib/sqlalchemy/sql/cache_key.py\r\nindex b4b6b23fa..5cd4b142e 100644\r\n--- a/lib/sqlalchemy/sql/cache_key.py\r\n+++ b/lib/sqlalchemy/sql/cache_key.py\r\n@@ -560,15 +560,10 @@ class CacheKey(NamedTuple):\r\n     def _apply_params_to_element(\r\n         self, original_cache_key: CacheKey, target_element: ClauseElement\r\n     ) -> ClauseElement:\r\n-        if target_element._is_immutable:\r\n+        if target_element._is_immutable or original_cache_key is self:\r\n             return target_element\r\n \r\n-        translate = {\r\n-            k.key: v.value\r\n-            for k, v in zip(original_cache_key.bindparams, self.bindparams)\r\n-        }\r\n-\r\n-        return target_element.params(translate)\r\n+        return _WrappyThing(target_element, self.bindparams)\r\n \r\n \r\n def _ad_hoc_cache_key_from_args(\r\n@@ -608,6 +603,20 @@ def _ad_hoc_cache_key_from_args(\r\n     return tup\r\n \r\n \r\n+class _WrappyThing:\r\n+    def __init__(self, element, bindparams):\r\n+        self.element = element\r\n+        self.bindparams = bindparams\r\n+\r\n+    def _gen_cache_key(\r\n+        self, anon_map: anon_map, bindparams: List[BindParameter[Any]]\r\n+    ) -> Optional[Tuple[Any, ...]]:\r\n+\r\n+        new_bp = []\r\n+        ck = self.element._gen_cache_key(anon_map, new_bp)\r\n+        bindparams.extend(self.bindparams)\r\n+        return ck\r\n+\r\n class _CacheKeyTraversal(HasTraversalDispatch):\r\n     # very common elements are inlined into the main _get_cache_key() method\r\n     # to produce a dramatic savings in Python function call overhead\r\n\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1974831765/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1974846243","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/11085#issuecomment-1974846243","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/11085","id":19748462