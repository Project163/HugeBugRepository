e page won't be reloaded.\r\n* If there are draft comments, show a confirm dialog before reloading, to avoid losing comments.\r\n\r\nThat's the best effect can be done at the moment, unless completely refactor these dropdown related code.\r\n\r\nScreenshot of the confirm dialog:\r\n\r\n<details>\r\n\r\n![image](https://user-images.githubusercontent.com/2114189/220538288-e2da8459-6a4e-43cb-8596-74057f8a03a2.png)\r\n\r\n</details>\r\n","reactions":{"url":"https://api.github.com/repos/go-gitea/gitea/issues/23102/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/go-gitea/gitea/issues/23102/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":8597314715,"node_id":"REFE_lADOBFIx285PcKXbzwAAAAIAcJyb","url":"https://api.github.com/repos/go-gitea/gitea/issues/events/8597314715","actor":{"login":"yardenshoham","id":20454870,"node_id":"MDQ6VXNlcjIwNDU0ODcw","avatar_url":"https://avatars.githubusercontent.com/u/20454870?v=4","gravatar_id":"","url":"https://api.github.com/users/yardenshoham","html_url":"https://github.com/yardenshoham","followers_url":"https://api.github.com/users/yardenshoham/followers","following_url":"https://api.github.com/users/yardenshoham/following{/other_user}","gists_url":"https://api.github.com/users/yardenshoham/gists{/gist_id}","starred_url":"https://api.github.com/users/yardenshoham/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yardenshoham/subscriptions","organizations_url":"https://api.github.com/users/yardenshoham/orgs","repos_url":"https://api.github.com/users/yardenshoham/repos","events_url":"https://api.github.com/users/yardenshoham/events{/privacy}","received_events_url":"https://api.github.com/users/yardenshoham/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"ad252a77af56c576dd6269e86ec4ca0899550911","commit_