+        String str = parameter.toString();
+        if (str.length() != 1) {
+            throw new IllegalArgumentException("invalid char value: " + str);
+        }
+        return str.charAt(0);
+    }
+
+    public static class Supplier implements ParameterConverterSupplier {
+
