"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["angular","javascript","pwa","typescript","web","web-framework","web-performance"],"visibility":"public","forks":27109,"open_issues":1141,"watchers":100153,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"- **I'm submitting a ...**\n- [X] feature request\n\n**Current behavior**\nValidators are callback functions\n\n**Expected/desired behavior**\nValidators should be observables.\n- **What is the motivation / use case for changing the behavior?**\n\nCurrently it is very counter intuitive to build debounced async validators (http://plnkr.co/edit/2NuNj1lBj2e6OdUJjFra?p=preview). It would be much cleaner to work with an observable chain that is subscribed once, instead of subscribed for every value change of a control.\n\nIt could look like this:\n\n```\nnew Control('',validator$=>{\n    return validator$.map(valid=>{\n        valid.errors.minLen=valid.value.length>5?null,\"Length must be at least 5\";\n        return valid;\n    });\n});\n```\n","reactions":{"url":"https://api.github.com/repos/angular/angular/issues/9119/reactions","total_count":62,"+1":52,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":10,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/angular/angular/issues/9119/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}},"event":"cross-referenced"},{"id":775679928,"node_id":"MDEyOkxhYmVsZWRFdmVudDc3NTY3OTkyOA==","url":"https://api.github.com/repos/angular/angular/issues/events/775679928","actor":{"login":"pkozlowski-opensource","id":973550,"node_id":"MDQ6VXNlcjk3MzU1MA==","avatar_url":"https://avatars.githubusercontent.com/u/973550?v=4","gravatar_id":"","url":"https://api.github.com/users/pkozlowski-opensource","html_url":"https://github.com/pkozlowski-opensource","follo