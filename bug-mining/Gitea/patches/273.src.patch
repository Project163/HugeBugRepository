+
+func TestSMTPLogger(t *testing.T) {
+	prefix := "TestPrefix "
+	level := INFO
+	flags := LstdFlags | LUTC | Lfuncname
+	username := "testuser"
+	password := "testpassword"
+	host := "testhost"
+	subject := "testsubject"
+	sendTos := []string{"testto1", "testto2"}
