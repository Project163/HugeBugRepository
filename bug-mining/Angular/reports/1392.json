ithub.com/users/IgorMinar/subscriptions","organizations_url":"https://api.github.com/users/IgorMinar/orgs","repos_url":"https://api.github.com/users/IgorMinar/repos","events_url":"https://api.github.com/users/IgorMinar/events{/privacy}","received_events_url":"https://api.github.com/users/IgorMinar/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":681,"closed_issues":22796,"state":"open","created_at":"2018-01-18T16:52:20Z","updated_at":"2026-03-11T09:12:24Z","due_on":null,"closed_at":null},"comments":21,"created_at":"2018-01-02T13:39:34Z","updated_at":"2021-08-21T16:06:04Z","closed_at":"2021-07-21T22:35:41Z","assignee":null,"author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"<!--\r\nPLEASE HELP US PROCESS GITHUB ISSUES FASTER BY PROVIDING THE FOLLOWING INFORMATION.\r\n\r\nISSUES MISSING IMPORTANT INFORMATION MAY BE CLOSED WITHOUT INVESTIGATION.\r\n-->\r\n\r\n## I'm submitting a...\r\n<!-- Check one of the following options with \"x\" -->\r\n<pre><code>\r\n[ ] Regression (a behavior that used to work and stopped working in a new release)\r\n[x] Bug report  <!-- Please search GitHub for a similar issue or PR before submitting -->\r\n[ ] Feature request\r\n[ ] Documentation issue or request\r\n[ ] Support request => Please do not submit support request here, instead see https://github.com/angular/angular/blob/master/CONTRIBUTING.md#question\r\n</code></pre>\r\n\r\n## Current behavior\r\nThe following provider will cause Angular to throw an error.\r\n``` TypeScript\r\nconst INIT_PROVIDER = {\r\n  provide: APP_INITIALIZER,\r\n  useFactory: initFactory,\r\n  multi: true\r\n};\r\n\r\nfunction initFactory() {\r\n  return () => init();\r\n}\r\n\r\nfunction init() {\r\n  return new Promise((resolve, reject) => {\r\n    reject();\r\n  });\r\n}\r\n```\r\n\r\nThe error occurs here: https://github.com/angular/angular/blob/0cc77b4a6954e563b6eb7999c9d3f08e2ba7dfeb/packages/core/src/errors.ts#L25-L27\r\n\r\n`ERROR_ORIGINAL_ERROR` (`'ngOriginalError'`) doesn't exist on `error` at this point.\r\n\r\nRelated: https://github.com/angular/angular/issues/18523\r\n\r\n## Expected behavior\r\nThe error should not occur. Unsure on what should happen in case the `Promise` is rejected but logging an error and continue operating seems like a good solution.\r\n\r\n## Minimal reproduction of the problem with instructions\r\nhttps://stackblitz.com/edit/angular-gitter-p6cngp\r\n\r\nOpen up the console and following error will appear:\r\n> Unhandled Promise rejection: Cannot read property 'ngOriginalError' of undefined\r\n\r\n\r\n## Environment\r\n\r\n<pre><code>\r\nAngular version: 5.1.2\r\n<!-- Check whether this is still an issue in the most recent Angular version -->\r\n</code></pre>\r\n\r\n  \r\n  ","closed_by":{"login":"dylhunn","id":7135246,"node_id":"MDQ6VXNlcjcxMzUyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/7135246?v=4","gravatar_id":"","url":"https://api.github.com/users/dylhunn","html_url":"https://github.com/dylhunn","followers_url":"https://api.github.com/users/dylhunn/followers","following_url":"https://api.github.com/users/dylhunn/following{/other_user}","gists_url":"https://api.github.com/users/dylhunn/gists{/gist_id}","starred_url":"https://api.github.com/users/dylhunn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dylhunn/subscriptions","organizations_url":"https://api.github.com/users/dylhunn/orgs","repos_url":"https://api.github.com/users/dylhunn/repos","events_url":"https://api.github.com/users/dylhunn/events{/privacy}","received_events_url":"https://api.github.com/users/dylhunn/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/21252/reactions","total_count":5,"+1":5,"-1":0,