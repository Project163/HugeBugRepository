sers/wvpaf/events{/privacy}","received_events_url":"https://api.github.com/users/wvpaf/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2017-02-03T14:36:36Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/277567607","html_url":"https://github.com/google/ExoPlayer/issues/2414#issuecomment-277567607","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/2414","id":277567607,"node_id":"MDEyOklzc3VlQ29tbWVudDI3NzU2NzYwNw==","user":{"login":"wendong-li","id":16127612,"node_id":"MDQ6VXNlcjE2MTI3NjEy","avatar_url":"https://avatars.githubusercontent.com/u/16127612?v=4","gravatar_id":"","url":"https://api.github.com/users/wendong-li","html_url":"https://github.com/wendong-li","followers_url":"https://api.github.com/users/wendong-li/followers","following_url":"https://api.github.com/users/wendong-li/following{/other_user}","gists_url":"https://api.github.com/users/wendong-li/gists{/gist_id}","starred_url":"https://api.github.com/users/wendong-li/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wendong-li/subscriptions","organizations_url":"https://api.github.com/users/wendong-li/orgs","repos_url":"https://api.github.com/users/wendong-li/repos","events_url":"https://api.github.com/users/wendong-li/events{/privacy}","received_events_url":"https://api.github.com/users/wendong-li/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-02-06T01:34:48Z","updated_at":"2017-02-06T01:34:48Z","body":"@ojw28 \r\nThanks for the comment. Yes, using ICrypto doesn't seem to be an official solution since it's not part of the NDK APIs. But, the existing opus decoder seems to be using the Widevine DRM somehow, I was making a guess from the parameter name `wvCrypto`.\r\n```\r\n  private native int opusSecureDecode(long decoder, long timeUs, ByteBuffer inputBuffer,\r\n      int inputSize, SimpleOutputBuffer outputBuffer, int sampleRate,\r\n      ExoMediaCrypto wvCrypto, int inputMode, byte[] key, byte[] iv,\r\n      int numSubSamples, int[] numBytesOfClearData, int[] numBytesOfEncryptedData);\r\n```\r\n\r\nThe NDK does provide the AMediaDrm API for native apps, but it's not clear whether it's possible to associate it with the DRM session opened by the Java MediaDrm.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/277567607/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"wendong-li","id":16127612,"node_id":"MDQ6VXNlcjE2MTI3NjEy","avatar_url":"https://avatars.githubusercontent.com/u/16127612?v=4","gravatar_id":"","url":"https://api.github.com/users/wendong-li","html_url":"https://github.com/wendong-li","followers_url":"https://api.github.com/users/wendong-li/followers","following_url":"https://api.github.com/users/wendong-li/following{/other_user}","gists_url":"https://api.github.com/users/wendong-li/gists{/gist_id}","starred_url":"https://api.github.com/users/wendong-li/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wendong-li/subscriptions","organizations_url":"https://api.github.com/users/wendong-li/orgs","repos_url":"https://api.github.com/users/wendong-li/repos","events_url":"https://api.github.com/users/wendong-li/events{/privacy}","received_events_url":"https://api.github.com/users/wendong-li/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":949639639,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50OTQ5NjM5NjM5","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/949639639","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"mentioned","commit_id":null,"commit_url":null,"created_at":"2017-02-06T01:34:48Z","performed_via_github_app":null},{"id":949639640,"node_id":"MDE1OlN1YnNjcmliZWRFdmVudDk0OTYzOTY0MA==","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/949639640","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2017-02-06T01:34:48Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/279283583","html_url":"https://github.com/google/ExoPlayer/issues/2414#issuecomment-279283583","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/2414","id":279283583,"node_id":"MDEyOklzc3VlQ29tbWVudDI3OTI4MzU4Mw==","user":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-02-13T03:00:22Z","updated_at":"2017-02-13T03:02:21Z","body":"That parameter name isn't accurate, so don't read anything into it. If you look at what happens on the JNI side of the opus extension, you'll see that `opusSecureDecode` is hardcoded to fail (see [here](https://github.com/google/ExoPlayer/blob/r2.2.0/extensions/opus/src/main/jni/opus_jni.cc#L128)).\r\n\r\nIt is theoretically possible to:\r\n- Implement your own native library that implements DRM and an opus decoder.\r\n- Build `ExoMediaCrypto` and `ExoMediaDrm` implementations on top of this native library.\r\n- Specify that this native library should be used by the opus extension, by calling [`OpusLibrary.setLibraries`](https://github.com/google/ExoPlayer/blob/r2.2.0/extensions/opus/src/main/java/com/google/android/exoplayer2/ext/opus/OpusLibrary.java#L34).\r\nIf you were to do all this you could have a software based DRM solution that works with the opus extension, and the reason `OpusLibrary.setLibraries` and `opusSecureDecode` exist is to make this possible.\r\n\r\nThe above is not something I'd recommend attempting unless you're a DRM expert. It's quite involved on several fronts.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/279283583/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":958962347,"node_id":"MDExOkNsb3NlZEV2ZW50OTU4OTYyMzQ3","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/958962347","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/oj