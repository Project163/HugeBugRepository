```\n        $webroot = APP . 'webroot' . DS;\n        $fileFragment = implode(DS, $parts);\n        if (file_exists($webroot . $parts[0])) {\n            return $webroot . $fileFragment;\n        }\n```\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/40298617/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zoghal","id":174688,"node_id":"MDQ6VXNlcjE3NDY4OA==","avatar_url":"https://avatars.githubusercontent.com/u/174688?v=4","gravatar_id":"","url":"https://api.github.com/users/zoghal","html_url":"https://github.com/zoghal","followers_url":"https://api.github.com/users/zoghal/followers","following_url":"https://api.github.com/users/zoghal/following{/other_user}","gists_url":"https://api.github.com/users/zoghal/gists{/gist_id}","starred_url":"https://api.github.com/users/zoghal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zoghal/subscriptions","organizations_url":"https://api.github.com/users/zoghal/orgs","repos_url":"https://api.github.com/users/zoghal/repos","events_url":"https://api.github.com/users/zoghal/events{/privacy}","received_events_url":"https://api.github.com/users/zoghal/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/40300412","html_url":"https://github.com/cakephp/cakephp/issues/3305#issuecomment-40300412","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/3305","id":40300412,"node_id":"MDEyOklzc3VlQ29tbWVudDQwMzAwNDEy","user":{"login":"ADmad","id":142658,"node_id":"MDQ6VXNlcjE0MjY1OA==","avatar_url":"https://avatars.githubusercontent.com/u/142658?v=4","gravatar_id":"","url":"https://api.github.com/users/ADmad","html_url":"https://github.com/ADmad","followers_url":"https://api.github.com/users/ADmad/followers","following_url":"https://api.github.com/users/ADmad/following{/other_user}","gists_url":"https://api.github.com/users/ADmad/gists{/gist_id}","starred_url":"https://api.github.com/users/ADmad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ADmad/subscriptions","organizations_url":"https://api.github.com/users/ADmad/orgs","repos_url":"https://api.github.com/users/ADmad/repos","events_url":"https://api.github.com/users/ADmad/events{/privacy}","received_events_url":"https://api.github.com/users/ADmad/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-04-13T06:04:00Z","updated_at":"2014-04-13T06:04:00Z","body":"Adding any overhead to all requests just to make pages with broken asset urls load faster is unacceptable in my book. There are already multiple ways to avoid the issue:\n- Don't have broken url in your pages\n- Use your own dispatch filter\n- Move all plugin assets to app's webroot and add rewrite urls to prevent requests for assets being routed to cake.\n\n@dereuromark Can you please PR the test case you have provided. After that patch merged in #2750 should be reverted.\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/40300412/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ADmad","id":142658,"node_id":"MDQ6VXNlcjE0MjY1OA==","avatar_url":"https://avatars.githubusercontent.com/u/142658?v=4","gravatar_id":"","url":"https://api.github.com/users/ADmad","html_url":"https://github.com/ADmad","followers_url":"https://api.github.com/users/ADmad/followers","following_url":"https://api.github.com/users/ADmad/following{/other_user}","gists_url":"https://api.github.com/users/ADmad/gists{/gist_id}","starred_url":"https://api.github.com/users/ADmad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AD