+        double minX = points[0].x;
+        double maxX = points[0].x;
+        double minY = points[0].y;
+        double maxY = points[0].y;
+        // compute the bounding coordinates (@todo: cleanup brute force)
+        for (int i = 1; i < length; ++i) {
+            if (points[i].x < minX) {
+                minX = points[i].x;
+            }
+            if (points[i].x > maxX) {
+                maxX = points[i].x;
+            }
+            if (points[i].y < minY) {
+                minY = points[i].y;
+            }
+            if (points[i].y > maxY) {
+                maxY = points[i].y;
+            }
+        }
