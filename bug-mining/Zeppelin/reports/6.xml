<item>
            <title>[ZEPPELIN-34] PySpark Indentation Issues</title>
                <link>https://issues.apache.org/jira/browse/ZEPPELIN-34</link>
                <project id="12316221" key="ZEPPELIN">Zeppelin</project>
                    <description>&lt;p&gt;When trying to run PySpark code with indented blocks, I get errors:&lt;/p&gt;

&lt;div class=&quot;preformatted panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;preformattedContent panelContent&quot;&gt;
&lt;pre&gt;%pyspark
count = 0
for word in data.collect():
    for c in word:
        count += 1

(&amp;lt;type &apos;exceptions.IndentationError&apos;&amp;gt;, IndentationError(&apos;expected an indented block&apos;, (&apos;&amp;lt;string&amp;gt;&apos;, 2, 18, &apos; for c in word:&apos;)), &amp;lt;traceback object at 0xd12f80&amp;gt;)
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;and&lt;/p&gt;

&lt;div class=&quot;preformatted panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;preformattedContent panelContent&quot;&gt;
&lt;pre&gt;%pyspark
if True:
    print &quot;Yup&quot;
else:
    print &quot;Nope&quot;

(&amp;lt;type &apos;exceptions.SyntaxError&apos;&amp;gt;, SyntaxError(&apos;invalid syntax&apos;, (&apos;&amp;lt;string&amp;gt;&apos;, 1, 4, &apos;else:&apos;)), &amp;lt;traceback object at 0xd12e60&amp;gt;)
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;I&apos;m using Spark 1.3 and Python 2.7.&lt;/p&gt;</description>
