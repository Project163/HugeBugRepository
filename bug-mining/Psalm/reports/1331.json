leted":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"In this situation usage of `no-named-arguments` violates contract of `Foo::foo`.\r\nIt requires `array<array-key, mixed>`. But `Bar::foo` requires more concrete type `list<mixed>`.\r\nThis snippet should trigger `MethodSignatureMismatch`. Actually no issues.\r\n\r\n```php\r\n<?php\r\n\r\ninterface Foo {\r\n    public function foo(mixed ...$_args): void;\r\n}\r\n\r\nfinal class Bar implements Foo {\r\n    /**\r\n     * @no-named-arguments\r\n     * !!! violates contract of Foo !!!\r\n     */\r\n    public function foo(mixed ...$_args): void\r\n    {\r\n    }\r\n}\r\n\r\nfunction getFoo(): Foo\r\n{\r\n    return new Bar();\r\n}\r\n\r\n$foo = getFoo();\r\n$foo->foo(name: ''); // may cause runtime error\r\n```\r\nhttps://psalm.dev/r/c58ce00af0","closed_by":{"login":"muglug","id":2292638,"node_id":"MDQ6VXNlcjIyOTI2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/2292638?v=4","gravatar_id":"","url":"https://api.github.com/users/muglug","html_url":"https://github.com/muglug","followers_url":"https://api.github.com/users/muglug/followers","following_url":"https://api.github.com/users/muglug/following{/other_user}","gists_url":"https://api.github.com/users/muglug/gists{/gist_id}","starred_url":"https://api.github.com/users/muglug/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/muglug/subscriptions","organizations_url":"https://api.github.com/users/muglug/orgs","repos_url":"https://api.github.com/users/muglug/repos","events_url":"https://api.github.com/users/muglug/events{/privacy}","received_events_url":"https://api.github.com/users/muglug/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/5622/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.githu