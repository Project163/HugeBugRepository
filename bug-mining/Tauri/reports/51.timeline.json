107-ac4b08af4092)\r\n","reactions":{"url":"https://api.github.com/repos/threefoldtech/mycelium/issues/385/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/threefoldtech/mycelium/issues/385/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/tauri-apps/tauri/issues/comments/2432649056","html_url":"https://github.com/tauri-apps/tauri/issues/749#issuecomment-2432649056","issue_url":"https://api.github.com/repos/tauri-apps/tauri/issues/749","id":2432649056,"node_id":"IC_kwDOC7lts86Q_0dg","user":{"login":"ekkolon","id":18242749,"node_id":"MDQ6VXNlcjE4MjQyNzQ5","avatar_url":"https://avatars.githubusercontent.com/u/18242749?v=4","gravatar_id":"","url":"https://api.github.com/users/ekkolon","html_url":"https://github.com/ekkolon","followers_url":"https://api.github.com/users/ekkolon/followers","following_url":"https://api.github.com/users/ekkolon/following{/other_user}","gists_url":"https://api.github.com/users/ekkolon/gists{/gist_id}","starred_url":"https://api.github.com/users/ekkolon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ekkolon/subscriptions","organizations_url":"https://api.github.com/users/ekkolon/orgs","repos_url":"https://api.github.com/users/ekkolon/repos","events_url":"https://api.github.com/users/ekkolon/events{/privacy}","received_events_url":"https://api.github.com/users/ekkolon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-10-23T15:34:18Z","updated_at":"2024-10-23T15:34:18Z","body":"I also encountered this error when trying to build my Tauri v2 app *without* specifying an icon in the `bundle.icons` field of the `tauri.conf.json` file.\r\n\r\n### Example\r\n\r\n**BEFORE**\r\n\r\n```json\r\n{\r\n    ...\r\n    \"bundle\": {\r\n        \"icons\": []\r\n    }\r\n}\r\n```\r\n\r\n**AFTER**\r\n\r\n```json\r