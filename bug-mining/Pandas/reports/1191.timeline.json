s/pandas/core/indexes/datetimes.py in get_loc(self, key, method, tolerance)\r\n   1019                 if 'list-like' in str(e):\r\n   1020                     raise e\r\n-> 1021                 raise KeyError(key)\r\n   1022 \r\n   1023     def _maybe_cast_slice_bound(self, label, side, kind):\r\n\r\nKeyError: 'pippo'\r\n\r\n```","reactions":{"url":"https://api.github.com/repos/pandas-dev/pandas/issues/23540/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/pandas-dev/pandas/issues/23540/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":1951006927,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDE5NTEwMDY5Mjc=","url":"https://api.github.com/repos/pandas-dev/pandas/issues/events/1951006927","actor":{"login":"toobaz","id":1224492,"node_id":"MDQ6VXNlcjEyMjQ0OTI=","avatar_url":"https://avatars.githubusercontent.com/u/1224492?v=4","gravatar_id":"","url":"https://api.github.com/users/toobaz","html_url":"https://github.com/toobaz","followers_url":"https://api.github.com/users/toobaz/followers","following_url":"https://api.github.com/users/toobaz/following{/other_user}","gists_url":"https://api.github.com/users/toobaz/gists{/gist_id}","starred_url":"https://api.github.com/users/toobaz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/toobaz/subscriptions","organizations_url":"https://api.github.com/users/toobaz/orgs","repos_url":"https://api.github.com/users/toobaz/repos","events_url":"https://api.github.com/users/toobaz/events{/privacy}","received_events_url":"https://api.github.com/users/toobaz/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"e44b2491d7fabce24a357614cf89a085ca828dab","commit_url":"https://api.github.com/repos/toobaz/pandas/commits/e44b2491d7fabce24a357614cf89a085ca828dab","created_at":"2018-11-07T08:30:06Z","performed_via_github_app":n