<item>
            <title>[IGNITE-6339] WAL: Avoid closed by interruption exception when user thread is interrupted</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-6339</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;We should have a separate writer thread for WAL that will write completed serialized chunks of data. This will allow us avoid closed by interruption exception when user thread is interrupted.&lt;/p&gt;</description>
                <environment></environment>
        <key id="13101263">IGNITE-6339</key>
            <summary>WAL: Avoid closed by interruption exception when user thread is interrupted</summary>
                <type id="1" iconUrl="https://issues.apache.org/jira/secure/viewavatar?size=xsmall&amp;avatarId=21133&amp;avatarType=issuetype">Bug</type>
