e":"closed","locked":true,"assignee":{"login":"christosts","id":54315740,"node_id":"MDQ6VXNlcjU0MzE1NzQw","avatar_url":"https://avatars.githubusercontent.com/u/54315740?v=4","gravatar_id":"","url":"https://api.github.com/users/christosts","html_url":"https://github.com/christosts","followers_url":"https://api.github.com/users/christosts/followers","following_url":"https://api.github.com/users/christosts/following{/other_user}","gists_url":"https://api.github.com/users/christosts/gists{/gist_id}","starred_url":"https://api.github.com/users/christosts/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/christosts/subscriptions","organizations_url":"https://api.github.com/users/christosts/orgs","repos_url":"https://api.github.com/users/christosts/repos","events_url":"https://api.github.com/users/christosts/events{/privacy}","received_events_url":"https://api.github.com/users/christosts/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"christosts","id":54315740,"node_id":"MDQ6VXNlcjU0MzE1NzQw","avatar_url":"https://avatars.githubusercontent.com/u/54315740?v=4","gravatar_id":"","url":"https://api.github.com/users/christosts","html_url":"https://github.com/christosts","followers_url":"https://api.github.com/users/christosts/followers","following_url":"https://api.github.com/users/christosts/following{/other_user}","gists_url":"https://api.github.com/users/christosts/gists{/gist_id}","starred_url":"https://api.github.com/users/christosts/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/christosts/subscriptions","organizations_url":"https://api.github.com/users/christosts/orgs","repos_url":"https://api.github.com/users/christosts/repos","events_url":"https://api.github.com/users/christosts/events{/privacy}","received_events_url":"https://api.github.com/users/christosts/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":5,"created_at":"2021-05-05T21:43:42Z","updated_at":"2021-11-10T02:04:30Z","closed_at":"2021-09-10T14:12:57Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Passing a negative value to the `player.seekTo()` function makes the ExoPlayer puts itself in a \"pause\" state and it never re-positions the `playhead` to 0 seconds. Still, we can see that the seek command is executed in the logcat.\r\n\r\nTo reproduce this we can use the Exo demo app. In the `PlayerActivity` set a delay of, could be 10 seconds, and then execute a `player.seetTo(-3000)`. Then the video will pause, the current position label will be at -0:00 but the Play/Pause button will stay as playing, and nothing else will happen. \r\nThere is no error message returned/thrown by the ExoPlayer nor printed in the logcat. \r\n\r\nThis is only with HLS videos. DASH and SmoothStreaming videos work fine.\r\n\r\nCould you take a look, please?\r\n","closed_by":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/8906/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/google/ExoPlayer/issues/8906/timeline","performed_via_github_app":null,"state_reason":"completed"}