[{"id":103634523,"node_id":"MDE3OlJlbmFtZWRUaXRsZUV2ZW50MTAzNjM0NTIz","url":"https://api.github.com/repos/syncthing/syncthing/issues/events/103634523","actor":{"login":"jpjp","id":6050800,"node_id":"MDQ6VXNlcjYwNTA4MDA=","avatar_url":"https://avatars.githubusercontent.com/u/6050800?v=4","gravatar_id":"","url":"https://api.github.com/users/jpjp","html_url":"https://github.com/jpjp","followers_url":"https://api.github.com/users/jpjp/followers","following_url":"https://api.github.com/users/jpjp/following{/other_user}","gists_url":"https://api.github.com/users/jpjp/gists{/gist_id}","starred_url":"https://api.github.com/users/jpjp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jpjp/subscriptions","organizations_url":"https://api.github.com/users/jpjp/orgs","repos_url":"https://api.github.com/users/jpjp/repos","events_url":"https://api.github.com/users/jpjp/events{/privacy}","received_events_url":"https://api.github.com/users/jpjp/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2014-03-19T21:33:58Z","rename":{"from":"check how syncthing behaved with mismatched character sets","to":"check how syncthing behaves with mismatched character sets"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/syncthing/syncthing/issues/comments/38111397","html_url":"https://github.com/syncthing/syncthing/issues/96#issuecomment-38111397","issue_url":"https://api.github.com/repos/syncthing/syncthing/issues/96","id":38111397,"node_id":"MDEyOklzc3VlQ29tbWVudDM4MTExMzk3","user":{"login":"jpjp","id":6050800,"node_id":"MDQ6VXNlcjYwNTA4MDA=","avatar_url":"https://avatars.githubusercontent.com/u/6050800?v=4","gravatar_id":"","url":"https://api.github.com/users/jpjp","html_url":"https://github.com/jpjp","followers_url":"https://api.github.com/users/jpjp/followers","following_url":"https://api.github.com/users/jpjp/following{/other_user}","gists_url":"https://api.github.com/users/jpjp/gists{/gist_id}","starred_url":"https://api.github.com/users/jpjp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jpjp/subscriptions","organizations_url":"https://api.github.com/users/jpjp/orgs","repos_url":"https://api.github.com/users/jpjp/repos","events_url":"https://api.github.com/users/jpjp/events{/privacy}","received_events_url":"https://api.github.com/users/jpjp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-03-19T21:48:34Z","updated_at":"2014-03-19T21:50:03Z","body":"Something weird is going on here.\n\nI create two files, one from linux named l-ääööüü, and one on mac named m-ääööüü\n\nOn the Mac I don't see a difference between the two filenames, but under Linux I do:\n\n```\n$ ls -a ?-*|cat -vte\nl-M-CM-$M-CM-$M-CM-6M-CM-6M-CM-<M-CM-<$\nm-aM-LM-^HaM-LM-^HoM-LM-^HoM-LM-^HuM-LM-^HuM-LM-^H$\n```\n\nBut if I wait a little while, I see this instead (again from Linux):\n\n```\n$ ls -a ?-*|cat -vte\nl-aM-LM-^HaM-LM-^HoM-LM-^HoM-LM-^HuM-LM-^HuM-LM-^H$\nm-aM-LM-^HaM-LM-^HoM-LM-^HoM-LM-^HuM-LM-^HuM-LM-^H$\n```\n\nSo then I do this under Linux:\n\n```\n$ mv l-ääööüü moved   # typing the characters\nmv: cannot stat ‘l-ääööüü’: No such file or directory\n```\n\nUsing tab completion works. So I guess Linux gets the \"corrected\" filename from OS X and syncing it across. Typing the characters under OS X works fine.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/syncthing/syncthing/issues/comments/38111397/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"jpjp","id":6050800,"node_id":"MDQ6VXNlcjYwNTA4MDA=","avatar_url":"https://avatars.githubusercontent.com/u/6050800?v=4","gravatar_id":"","url":"https://api.github.com/users/jpjp","html_url":"https://github.com/jpjp","followers_url":"https://api.github.com/users