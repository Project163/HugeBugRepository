+    CHECK(win32_fix_path_case(L"C:/") == L"C:\\");
+    CHECK(win32_fix_path_case(L"C:\\") == L"C:\\");
+    CHECK(win32_fix_path_case(L"c:\\") == L"C:\\");
+    CHECK(win32_fix_path_case(L"C:\\WiNdOws") == L"C:\\Windows");
