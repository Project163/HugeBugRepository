+        // It's correct.
+        Assertions.assertEquals("concat('\\', ifnull(\"c\".\"d\", 1)', '-')",
+                StringHelper.doubleQuoteToBacktick("concat('\\', ifnull(\"c\".\"d\", 1)', '-')"));
     }
 
