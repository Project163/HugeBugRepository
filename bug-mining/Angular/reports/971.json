.github.com/users/IgorMinar/subscriptions","organizations_url":"https://api.github.com/users/IgorMinar/orgs","repos_url":"https://api.github.com/users/IgorMinar/repos","events_url":"https://api.github.com/users/IgorMinar/events{/privacy}","received_events_url":"https://api.github.com/users/IgorMinar/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":680,"closed_issues":22796,"state":"open","created_at":"2018-01-18T16:52:20Z","updated_at":"2026-03-11T06:25:22Z","due_on":null,"closed_at":null},"comments":6,"created_at":"2017-12-27T18:12:11Z","updated_at":"2019-12-26T16:04:45Z","closed_at":"2019-11-25T16:37:51Z","assignee":{"login":"kapunahelewong","id":4116963,"node_id":"MDQ6VXNlcjQxMTY5NjM=","avatar_url":"https://avatars.githubusercontent.com/u/4116963?v=4","gravatar_id":"","url":"https://api.github.com/users/kapunahelewong","html_url":"https://github.com/kapunahelewong","followers_url":"https://api.github.com/users/kapunahelewong/followers","following_url":"https://api.github.com/users/kapunahelewong/following{/other_user}","gists_url":"https://api.github.com/users/kapunahelewong/gists{/gist_id}","starred_url":"https://api.github.com/users/kapunahelewong/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kapunahelewong/subscriptions","organizations_url":"https://api.github.com/users/kapunahelewong/orgs","repos_url":"https://api.github.com/users/kapunahelewong/repos","events_url":"https://api.github.com/users/kapunahelewong/events{/privacy}","received_events_url":"https://api.github.com/users/kapunahelewong/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## I'm submitting a...\r\n<!-- Check one of the following options with \"x\" -->\r\n<pre><code>\r\n[ ] Regression (a behavior that used to work and stopped working in a new release)\r\n[ ] Bug report  <!-- Please search GitHub for a similar issue or PR before submitting -->\r\n[ ] Feature request\r\n[x] Documentation issue or request\r\n[ ] Support request => Please do not submit support request here, instead see https://github.com/angular/angular/blob/master/CONTRIBUTING.md#question\r\n</code></pre>\r\n\r\n## Current behavior\r\nThe ToH defines the Hero model using a **class**, but in the tutorial \"instances\" of this class arent created using the ctor of the class, promoting a bad practice. \r\n\r\nFurthermore the use of a class for this model is IMO inappropriate, as the class defines no behavior (methods). An interface would be better suited for this use case.\r\n\r\nAn example extracted from the tutorial:\r\n\r\n```\r\nclass Hero {\r\n  id: number,\r\n  name: string,\r\n}\r\n\r\nconst aHero: Hero = {\r\n  id: 1,\r\n  name: 'Superman'\r\n}\r\n````\r\nType checking will result in the following:\r\n\r\n````\r\nconsole.log(aHero instanceof Hero); //false\r\n````\r\n\r\n## Expected behavior\r\nThe Hero model should be defined using an **interface**.\r\n\r\n## Minimal reproduction of the problem with instructions\r\n\r\nCheck the [ToH](https://angular.io/tutorial/toh-pt1#create-a-hero-class)","closed_by":{"login":"matsko","id":93018,"node_id":"MDQ6VXNlcjkzMDE4","avatar_url":"https://avatars.githubusercontent.com/u/93018?v=4","gravatar_id":"","url":"https://api.github.com/users/matsko","html_url":"https://github.com/matsko","followers_url":"https://api.github.com/users/matsko/followers","following_url":"https://api.github.com/users/matsko/following{/other_user}","gists_url":"https://api.github.com/users/matsko/gists{/gist_id}","starred_url":"https://api.github.com/users/matsko/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matsko/subscriptions","organizations_url":"https://api.github.com/users/matsko/orgs","repos_url"