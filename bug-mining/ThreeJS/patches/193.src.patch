 			for ( var i = 0, il = targets.length; i < il; i ++ ) {
@@ -2246,7 +2247,11 @@ THREE.GLTFLoader = ( function () {
 						vector.setY( Math.max( Math.abs( min[ 1 ] ), Math.abs( max[ 1 ] ) ) );
