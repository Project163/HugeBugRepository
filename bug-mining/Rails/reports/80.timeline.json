ating}","labels_url":"https://api.github.com/repos/rails/rails/labels{/name}","releases_url":"https://api.github.com/repos/rails/rails/releases{/id}","deployments_url":"https://api.github.com/repos/rails/rails/deployments","created_at":"2008-04-11T02:19:47Z","updated_at":"2025-12-13T07:43:35Z","pushed_at":"2025-12-13T03:40:43Z","git_url":"git://github.com/rails/rails.git","ssh_url":"git@github.com:rails/rails.git","clone_url":"https://github.com/rails/rails.git","svn_url":"https://github.com/rails/rails","homepage":"https://rubyonrails.org","size":275235,"stargazers_count":57965,"watchers_count":57965,"language":"Ruby","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":22063,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1385,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["activejob","activerecord","framework","html","mvc","rails","ruby"],"visibility":"public","forks":22063,"open_issues":1385,"watchers":57965,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/rails/rails/pulls/12588","html_url":"https://github.com/rails/rails/pull/12588","diff_url":"https://github.com/rails/rails/pull/12588.diff","patch_url":"https://github.com/rails/rails/pull/12588.patch","merged_at":"2013-10-21T21:14:17Z"},"body":"Generated sub-query for Relation as array condition for `where` method\ndid not take in account bind values of the Relation.\nFixed by inlining bind values into the sub-query.\n\nThere is another solution, but it's more complicated, to pass bind values like: https://github.com/rails/rails/blob/master/activerecord/lib/active_record/relation/query_methods.rb#L902\n\n``` ruby\n        opts = PredicateBuilder.resolve_column_aliases(klass, opts)\n        attributes = @klass.send(:expand_hash_conditions_for_aggregates, opts)\n\n        attributes.values.grep(ActiveRecord::Relation) do |rel|\n          self.bind_values += rel.bind_values\n        end\n\n        PredicateBuilder.build_from_hash(klass, attributes, table)\n```\n\nCloses: #12586\n","reactions":{"url":"https://api.github.com/repos/rails/rails/issues/12588/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/rails/rails/issues/12588/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":71145736,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDcxMTQ1NzM2","url":"https://api.github.com/repos/rails/rails/issues/events/71145736","actor":{"login":"pftg","id":125715,"node_id":"MDQ6VXNlcjEyNTcxNQ==","avatar_url":"https://avatars.githubusercontent.com/u/125715?v=4","gravatar_id":"","url":"https://api.github.com/users/pftg","html_url":"https://github.com/pftg","followers_url":"https://api.github.com/users/pftg/followers","following_url":"https://api.github.com/users/pftg/following{/other_user}","gists_url":"https://api.github.com/users/pftg/gists{/gist_id}","starred_url":"https://api.github.com/users/pftg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pftg/subscriptions","organizations_url":"https://api.github.com/users/pftg/orgs","repos_url":"https://api.github.com/users/pftg/repos","events_url":"https://api.github.com/users/pftg/events{/privacy}","received_events_url":"https://api.github.com/users/pftg/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"380fce5297bb612b30fd30f5639cab1d6e7bb062","commit_url":"https://api.github.com/repos/jetthoughts/rails/commits/380fce5297bb612b30fd30f5639cab1d6e7bb062","created_at":"2013-10-18T20:36:27Z","performed_via_github_app":null},{"id":71261278,"