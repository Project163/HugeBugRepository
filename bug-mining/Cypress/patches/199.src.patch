     file = Object.assign(new EventEmitter(), {
       filePath,
@@ -28,32 +34,75 @@ describe('webpack preprocessor - e2e', () => {
     })
   })
 
+  afterEach(async () => {
+    if (file.shouldWatch) {
+      await new Promise((resolve) => {
+        file.emit('close', resolve)
+      })
+    }
