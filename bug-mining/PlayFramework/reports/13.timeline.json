ub.com/users/julienrf/following{/other_user}","gists_url":"https://api.github.com/users/julienrf/gists{/gist_id}","starred_url":"https://api.github.com/users/julienrf/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/julienrf/subscriptions","organizations_url":"https://api.github.com/users/julienrf/orgs","repos_url":"https://api.github.com/users/julienrf/repos","events_url":"https://api.github.com/users/julienrf/events{/privacy}","received_events_url":"https://api.github.com/users/julienrf/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"54d20f69e931c5d70c21daef8c7399d289fdd8b5","commit_url":"https://api.github.com/repos/julienrf/playframework/commits/54d20f69e931c5d70c21daef8c7399d289fdd8b5","created_at":"2013-11-05T13:56:48Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/playframework/playframework/issues/comments/27860372","html_url":"https://github.com/playframework/playframework/issues/1862#issuecomment-27860372","issue_url":"https://api.github.com/repos/playframework/playframework/issues/1862","id":27860372,"node_id":"MDEyOklzc3VlQ29tbWVudDI3ODYwMzcy","user":{"login":"huntc","id":694893,"node_id":"MDQ6VXNlcjY5NDg5Mw==","avatar_url":"https://avatars.githubusercontent.com/u/694893?v=4","gravatar_id":"","url":"https://api.github.com/users/huntc","html_url":"https://github.com/huntc","followers_url":"https://api.github.com/users/huntc/followers","following_url":"https://api.github.com/users/huntc/following{/other_user}","gists_url":"https://api.github.com/users/huntc/gists{/gist_id}","starred_url":"https://api.github.com/users/huntc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/huntc/subscriptions","organizations_url":"https://api.github.com/users/huntc/orgs","repos_url":"https://api.github.com/users/huntc/repos","events_url":"https://api.github.com/users/huntc/events{/privacy}","received_events_url":"https://api.github.com/users/huntc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2013-11-06T10:26:55Z","updated_at":"2013-11-06T10:26:55Z","body":"> who uses event source with anything but JSON? I suspect no one\n\nI agree that we should not escape the SSE data. I see SSE as a signalling mechanism that isn't intended to convey structured content.\n\nFrom my experience SSE clients are intended to respond to signals that may cause them to subsequently act e.g. perform an HTTP GET to get some data. Whether the client does or not though depends on its UI state.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/playframework/playframework/issues/comments/27860372/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"huntc","id":694893,"node_id":"MDQ6VXNlcjY5NDg5Mw==","avatar_url":"https://avatars.githubusercontent.com/u/694893?v=4","gravatar_id":"","url":"https://api.github.com/users/huntc","html_url":"https://github.com/huntc","followers_url":"https://api.github.com/users/huntc/followers","following_url":"https://api.github.com/users/huntc/following{/other_user}","gists_url":"https://api.github.com/users/huntc/gists{/gist_id}","starred_url":"https://api.github.com/users/huntc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/huntc/subscriptions","organizations_url":"https://api.github.com/users/huntc/orgs","repos_url":"https://api.github.com/users/huntc/repos","events_url":"https://api.github.com/users/huntc/events{/privacy}","received_events_url":"https://api.github.com/users/huntc/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":74302918,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDc0MzAyOTE4","url":"https://api.github.com/repos/playframework/playframework/issues/events/74302918","actor":{"login":"julienrf","id":332812,"node_id":"MDQ6VXNlcjMzMj