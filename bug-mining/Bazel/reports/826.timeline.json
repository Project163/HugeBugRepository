.com/bazelbuild/bazel.git","svn_url":"https://github.com/bazelbuild/bazel","homepage":"https://bazel.build","size":992874,"stargazers_count":24886,"watchers_count":24886,"language":"Java","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":4359,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1818,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["bazel","build","build-system","correct","fast","multi-language","scalable","test"],"visibility":"public","forks":4359,"open_issues":1818,"watchers":24886,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"### Description of the problem / feature request:\r\n\r\nWhen a target depends on the file `volatile-status.txt` as an input, that target will not be rebuilt if `volatile-status.txt` changes and the target is cached locally. However, the remote cache does not behave in the same way, and a change in the hash of `volatile-status.txt` will cause the target not to read from the remote cache.\r\n\r\n### Bugs: what's the simplest, easiest way to reproduce this bug? Please provide a minimal example if possible.\r\n\r\nClone the repo [test_volatile_status](https://github.com/Panfilwk/test_volatile_status) and set up a [bazel remote cache](https://docs.bazel.build/versions/master/remote-caching.html#bazel-remote-cache). Then run the following commands at the root of the repo:\r\n```\r\nbazel build --remote_cache=<your_remote_cache> //:artifact\r\nbazel build --remote_cache=<your_remote_cache> //:artifact \r\n# the above will read from the local cache, as expected\r\n\r\nbazel clean\r\nbazel build --remote_cache=<your_remote_cache> //:artifact\r\n# this will not read from the remote cache\r\n```\r\n\r\n### What operating system are you running Bazel on?\r\n\r\nUbuntu 16.04.6 LTS\r\n\r\n### What's the output of `bazel info release`?\r\n\r\nrelease 0.29.0\r\n\r\n### What's the output of `git remote get-url origin ; git rev-parse master ; git rev-parse HEAD` ?\r\n\r\nhttps://github.com/Panfilwk/test_volatile_status.git\r\nda002118b6c79bd7e33b017221c772fbfba4f009\r\nda002118b6c79bd7e33b017221c772fbfba4f009\r\n\r\n###  Have you found anything relevant by searching the web?\r\n\r\n[This issue](https://github.com/bazelbuild/bazel/issues/5573) touches on this concept for local caching, but nothing about how the behavior of this file works with remote caching.\r\n\r\n\r\n### Any other information, logs, or outputs that you want to share?\r\n\r\n[exec1.log.txt](https://github.com/bazelbuild/bazel/files/3752492/exec1.log.txt) and [exec2.log.txt](https://github.com/bazelbuild/bazel/files/3752498/exec2.log.txt) are the resulting parsed experimental execution logs from the first and third build commands following the debug instructions [here](https://docs.bazel.build/versions/master/remote-execution-caching-debug.html#troubleshooting-cache-hits)\r\n\r\n","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/10075/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bazelbuild/bazel/issues/10075/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":3279626838,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDMyNzk2MjY4Mzg=","url":"https://api.github.com/repos/bazelbuild/bazel/issues/events/3279626838","actor":{"login":"Qinusty","id":7274845,"node_id":"MDQ6VXNlcjcyNzQ4NDU=","avatar_url":"https://avatars.githubusercontent.com/u/7274845?v=4","gravatar_id":"","url":"https://api.github.com/users/Qinusty","html_url":"https://github.com/Qinusty","followers_url":"https://api.github.com/users/Qinusty