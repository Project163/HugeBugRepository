diff --git a/examples/nextjs/components/Search.jsx b/examples/nextjs/components/Search.jsx
new file mode 100644
index 0000000000..d76504e731
--- /dev/null
+++ b/examples/nextjs/components/Search.jsx
@@ -0,0 +1,26 @@
+import * as React from 'react'
+
+export function Search() {
+  const [value, setValue] = React.useState('')
+  return (
+    <div>
+      <input
+        aria-label="search"
+        value={value}
+        onChange={e => setValue(e.currentTarget.value)}
+      />
+
+      <p className="search-text">You are searching for: {value}</p>
+
+      <style jsx>{`
+        input {
+          border-radius: 20px;
+        }
+        div {
+          padding: 16px;
+          background: tomato;
+        }
+      `}</style>
+    </div>
+  )
+}
