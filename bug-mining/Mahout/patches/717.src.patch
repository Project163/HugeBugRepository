-        double r = pk / qk;
-        t = Math.abs((ans - r) / r);
-        ans = r;
-      } else {
-        t = 1.0;
-      }
-
-      pkm2 = pkm1;
-      pkm1 = pk;
-      qkm2 = qkm1;
-      qkm1 = qk;
-      if (Math.abs(pk) > Constants.BIG) {
-        pkm2 *= Constants.BIG_INVERSE;
-        pkm1 *= Constants.BIG_INVERSE;
-        qkm2 *= Constants.BIG_INVERSE;
-        qkm1 *= Constants.BIG_INVERSE;
-      }
-    } while (t > Constants.MACHEP);
-
-    return ans * ax;
-  }
