view_type":"public","site_admin":false}],"milestone":{"url":"https://api.github.com/repos/glfw/glfw/milestones/2","html_url":"https://github.com/glfw/glfw/milestone/2","labels_url":"https://api.github.com/repos/glfw/glfw/milestones/2/labels","id":325603,"node_id":"MDk6TWlsZXN0b25lMzI1NjAz","number":2,"title":"3.1","description":"","creator":{"login":"elmindreda","id":133714,"node_id":"MDQ6VXNlcjEzMzcxNA==","avatar_url":"https://avatars.githubusercontent.com/u/133714?v=4","gravatar_id":"","url":"https://api.github.com/users/elmindreda","html_url":"https://github.com/elmindreda","followers_url":"https://api.github.com/users/elmindreda/followers","following_url":"https://api.github.com/users/elmindreda/following{/other_user}","gists_url":"https://api.github.com/users/elmindreda/gists{/gist_id}","starred_url":"https://api.github.com/users/elmindreda/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elmindreda/subscriptions","organizations_url":"https://api.github.com/users/elmindreda/orgs","repos_url":"https://api.github.com/users/elmindreda/repos","events_url":"https://api.github.com/users/elmindreda/events{/privacy}","received_events_url":"https://api.github.com/users/elmindreda/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":109,"state":"closed","created_at":"2013-05-02T14:52:21Z","updated_at":"2015-02-25T03:23:01Z","due_on":null,"closed_at":"2015-01-18T20:33:36Z"},"comments":14,"created_at":"2014-10-29T12:24:47Z","updated_at":"2018-05-31T21:44:59Z","closed_at":"2014-12-30T14:27:21Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Hello, \n\nI'm trying the GLFW 3.1 in OS X and Linux, and found that: with the latest code from git repository, the glfwWaitEvent() takes too much CPU consumption in OS X 10.10 when the mouse cursor is hovering on the glfw window.\n![activity_monitor_screenshot](https://cloud.githubusercontent.com/assets/1978235/4825234/ded4c9ee-5f62-11e4-9be2-16e0c7113db0.png)\n\nIt's very easy to reproduce this issue:\n1. just use the example code on http://www.glfw.org/documentation.html to create a glfw window.\nbut replace the \"glfwPollEvents();\" with \"glfwWaitEvents();\"\n2. Build and run your program, check the activity monitor in OS X.\n3. Move your cursor and you'll find that when the cursor hovers on the window, the CPU consumption will increase (more than 50% on my iMac: i7 3.5GHz) immediately.\n\nThe Xcode/Instruments/Time Profiler may help to find the root cause:\n![time_profiler_screenshot](https://cloud.githubusercontent.com/assets/1978235/4825250/163bc040-5f63-11e4-8e81-54dc27bb2858.jpg)\n","closed_by":{"login":"elmindreda","id":133714,"node_id":"MDQ6VXNlcjEzMzcxNA==","avatar_url":"https://avatars.githubusercontent.com/u/133714?v=4","gravatar_id":"","url":"https://api.github.com/users/elmindreda","html_url":"https://github.com/elmindreda","followers_url":"https://api.github.com/users/elmindreda/followers","following_url":"https://api.github.com/users/elmindreda/following{/other_user}","gists_url":"https://api.github.com/users/elmindreda/gists{/gist_id}","starred_url":"https://api.github.com/users/elmindreda/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elmindreda/subscriptions","organizations_url":"https://api.github.com/users/elmindreda/orgs","repos_url":"https://api.github.com/users/elmindreda/repos","events_url":"https://api.github.com/users/elmindreda/events{/privacy}","received_events_url":"https://api.github.com/users/elmindreda/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/glfw/glfw/issues/375/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":