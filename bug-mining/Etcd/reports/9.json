er":15,"title":"v2.1.0-alpha0","description":"","creator":{"login":"xiang90","id":4479947,"node_id":"MDQ6VXNlcjQ0Nzk5NDc=","avatar_url":"https://avatars.githubusercontent.com/u/4479947?v=4","gravatar_id":"","url":"https://api.github.com/users/xiang90","html_url":"https://github.com/xiang90","followers_url":"https://api.github.com/users/xiang90/followers","following_url":"https://api.github.com/users/xiang90/following{/other_user}","gists_url":"https://api.github.com/users/xiang90/gists{/gist_id}","starred_url":"https://api.github.com/users/xiang90/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xiang90/subscriptions","organizations_url":"https://api.github.com/users/xiang90/orgs","repos_url":"https://api.github.com/users/xiang90/repos","events_url":"https://api.github.com/users/xiang90/events{/privacy}","received_events_url":"https://api.github.com/users/xiang90/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":52,"state":"closed","created_at":"2015-01-15T22:04:44Z","updated_at":"2015-04-23T22:48:19Z","due_on":"2015-04-16T07:00:00Z","closed_at":"2015-04-23T22:48:19Z"},"comments":2,"created_at":"2015-03-12T05:47:01Z","updated_at":"2018-08-28T01:29:28Z","closed_at":"2015-04-09T16:46:56Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"The advertised client URLs returned from /v2/members and /v2/machines are resolved to IP addresses. \n\nFor clients that use these to discover the endpoint to query, this forces one of two conditions:\n1. the SSL client must not verify the hostname it is connecting to against the names in the SSL cert\n2. the server must have it's IP address in the CN or SAN of the SSL cert\n\nIs there any reason we want to resolve the advertise client URLs or would it make sense to leave them unresolved?\n\nThe specific problem I am running into is with etcdctl. Lets say that my nodes are called:\nhttps://node0.example.com:4001\nhttps://node1.example.com:4001\nhttps://node2.example.com:4001\n\nAnd each one is configured with the server certificate that matches the domain \"*.example.com\"\n\nEtcdctl will make a request against /v2/machines and will get back:\nhttps://10.0.0.1:4001, https://10.0.0.2:4001, https://10.0.0.3:4001\n\nSince the server's certificate does not have an IP address in its CN or SAN, etcdctl will fail to validate the server certificate when it makes the request for /v2/keys/\n","closed_by":{"login":"xiang90","id":4479947,"node_id":"MDQ6VXNlcjQ0Nzk5NDc=","avatar_url":"https://avatars.githubusercontent.com/u/4479947?v=4","gravatar_id":"","url":"https://api.github.com/users/xiang90","html_url":"https://github.com/xiang90","followers_url":"https://api.github.com/users/xiang90/followers","following_url":"https://api.github.com/users/xiang90/following{/other_user}","gists_url":"https://api.github.com/users/xiang90/gists{/gist_id}","starred_url":"https://api.github.com/users/xiang90/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xiang90/subscriptions","organizations_url":"https://api.github.com/users/xiang90/orgs","repos_url":"https://api.github.com/users/xiang90/repos","events_url":"https://api.github.com/users/xiang90/events{/privacy}","received_events_url":"https://api.github.com/users/xiang90/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/etcd-io/etcd/issues/2488/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/etcd-io/etcd/issues/2488/timeline","performed_via_github_app":null,"state_reason":"completed"}