thub.com/repos/pytest-dev/pytest/deployments","created_at":"2015-06-15T20:28:27Z","updated_at":"2025-12-12T15:15:52Z","pushed_at":"2025-12-12T15:15:44Z","git_url":"git://github.com/pytest-dev/pytest.git","ssh_url":"git@github.com:pytest-dev/pytest.git","clone_url":"https://github.com/pytest-dev/pytest.git","svn_url":"https://github.com/pytest-dev/pytest","homepage":"https://pytest.org","size":37819,"stargazers_count":13369,"watchers_count":13369,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":2969,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":955,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["hacktoberfest","python","test","testing","unit-testing"],"visibility":"public","forks":2969,"open_issues":955,"watchers":13369,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Hi everyone,\r\n\r\nI've been thinking about some time now to use an automatic code formatter to our codebase such as [black](https://github.com/ambv/black) or [yapf](https://github.com/google/yapf), together with [pre-commit](https://pre-commit.com/) and tox environments to check for compliance on CI.\r\n\r\nPros:\r\n\r\n* Consistent code formatting: currently the format is very mixed and we don't enforce it.\r\n* Help new contributors: no need to think or follow a style guide, it is done automatically.\r\n\r\nCons:\r\n\r\n* We will pollute the repository and lose some of the blame history.\r\n\r\nOpinions?","reactions":{"url":"https://api.github.com/repos/pytest-dev/pytest/issues/3464/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/pytest-dev/pytest/issues/3464/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]