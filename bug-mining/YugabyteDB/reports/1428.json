iption":"Yugabyte SQL (YSQL)"},{"id":1419821900,"node_id":"MDU6TGFiZWwxNDE5ODIxOTAw","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/priority/medium","name":"priority/medium","color":"ffdc5e","default":false,"description":"Medium priority issue"}],"state":"closed","locked":false,"assignee":{"login":"myang2021","id":79478033,"node_id":"MDQ6VXNlcjc5NDc4MDMz","avatar_url":"https://avatars.githubusercontent.com/u/79478033?v=4","gravatar_id":"","url":"https://api.github.com/users/myang2021","html_url":"https://github.com/myang2021","followers_url":"https://api.github.com/users/myang2021/followers","following_url":"https://api.github.com/users/myang2021/following{/other_user}","gists_url":"https://api.github.com/users/myang2021/gists{/gist_id}","starred_url":"https://api.github.com/users/myang2021/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/myang2021/subscriptions","organizations_url":"https://api.github.com/users/myang2021/orgs","repos_url":"https://api.github.com/users/myang2021/repos","events_url":"https://api.github.com/users/myang2021/events{/privacy}","received_events_url":"https://api.github.com/users/myang2021/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"myang2021","id":79478033,"node_id":"MDQ6VXNlcjc5NDc4MDMz","avatar_url":"https://avatars.githubusercontent.com/u/79478033?v=4","gravatar_id":"","url":"https://api.github.com/users/myang2021","html_url":"https://github.com/myang2021","followers_url":"https://api.github.com/users/myang2021/followers","following_url":"https://api.github.com/users/myang2021/following{/other_user}","gists_url":"https://api.github.com/users/myang2021/gists{/gist_id}","starred_url":"https://api.github.com/users/myang2021/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/myang2021/subscriptions","organizations_url":"https://api.github.com/users/myang2021/orgs","repos_url":"https://api.github.com/users/myang2021/repos","events_url":"https://api.github.com/users/myang2021/events{/privacy}","received_events_url":"https://api.github.com/users/myang2021/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2025-09-30T01:29:08Z","updated_at":"2025-10-27T22:02:52Z","closed_at":"2025-10-27T22:02:52Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Jira Link: [DB-18451](https://yugabyte.atlassian.net/browse/DB-18451)\r\n### Description\n\nThe tests TestAlterTableWithConcurrentTxn and TestDropTableWithConcurrentTxn verifies that DDL effect is seen or not seen by a DML on another connection. For example, if DML connections starts a BEGIN transaction, then DDL connection alters a table, then DML connection makes a query on the table. Depending on whether the DML connection has already cached the table or not, the expected result is verified by these two tests.\n\nHowever I have identified two cases (one in each test) where the DML connection is meant to test the scenario where the table is not cached, but in reality the DML connection has actually cached the table. The reason that the DML connection has cached the table is because the DML connection happens to be the first connection after a previous DDL statement that incremented the catalog version. Therefore the DML connection during its establishment needed to rebuild the relcache init file. As part of that it preloaded the catalog caches and therefore has accidentally cached the test table. So in these two scenarios the test is not doing what it meant to test.\n\nWe can fix these two scenarios by making a temp connection prior to the DML connection so that the temp connection is responsible for rebuilding relcache init file, and the DML connection becomes a \"subsequent\" connection that does not need to rebuild relcache init file, and therefore avoids caching the table accidentally.\n\n### Issue Type\n\nkind/bug\n\n### Warning: Please confirm that this issue does not contain any sensitive information\n\n- [x] I confirm this issue does not contain any sensitive information.\n\n[DB-18451]: https://yugabyte.atlassian.net/browse/DB-18451?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","closed_by":{"login":"myang2021","id":79478033,"node_id":"MDQ6VXNlcjc5NDc4MDMz","avatar_url":"https://avatars.githubusercontent.com/u/79478033?v=4","gravatar_id":"","url":"https://api.github.com/users/myang2021","html_url":"https://github.com/myang2021","followers_url":"https://api.github.com/users/myang2021/followers","following_url":"https://api.github.com/users/myang2021/following{/other_user}","gists_url":"https://api.github.com/users/myang2021/gists{/gist_id}","starred_url":"https://api.github.com/users/myang2021/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/myang2021/subscriptions","organizations_url":"https://api.github.com/users/myang2021/orgs","repos_url":"https://api.github.com/users/myang2021/repos","events_url":"https://api.github.com/users/myang2021/events{/privacy}","received_events_url":"https://api.github.com/users/myang2021/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/28743/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/28743/timeline","performed_via_github_app":null,"state_reason":"completed"}