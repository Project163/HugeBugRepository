+                }
+
+                @Override
+                public void handleException(TransportException exp) {
+                    original.handleException(exp);
+                    markTaskAsCompleted("ping [" + node + "] (error)");
+                }
+
+                @Override
+                public String executor() {
+                    return original.executor();
+                }
+            };
+        }
     }
 
