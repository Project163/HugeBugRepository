.com/repos/google/ExoPlayer/merges","archive_url":"https://api.github.com/repos/google/ExoPlayer/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/google/ExoPlayer/downloads","issues_url":"https://api.github.com/repos/google/ExoPlayer/issues{/number}","pulls_url":"https://api.github.com/repos/google/ExoPlayer/pulls{/number}","milestones_url":"https://api.github.com/repos/google/ExoPlayer/milestones{/number}","notifications_url":"https://api.github.com/repos/google/ExoPlayer/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/google/ExoPlayer/labels{/name}","releases_url":"https://api.github.com/repos/google/ExoPlayer/releases{/id}","deployments_url":"https://api.github.com/repos/google/ExoPlayer/deployments","created_at":"2014-06-13T21:19:18Z","updated_at":"2025-12-12T08:47:27Z","pushed_at":"2024-08-07T18:54:48Z","git_url":"git://github.com/google/ExoPlayer.git","ssh_url":"git@github.com:google/ExoPlayer.git","clone_url":"https://github.com/google/ExoPlayer.git","svn_url":"https://github.com/google/ExoPlayer","homepage":"https://developer.android.com/media/media3/exoplayer","size":484242,"stargazers_count":21911,"watchers_count":21911,"language":"Java","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":true,"has_discussions":false,"forks_count":6031,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":634,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":[],"visibility":"public","forks":6031,"open_issues":634,"watchers":21911,"default_branch":"release-v2","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"### Issue description\r\nSIGSEGV when playing HLS video on Samsung Galaxy Nexus\r\n\r\n### Reproduction steps\r\nRun demo app and play this media\r\nhttp://edge.tpr-3ehznk.top.comcast.net/demo/content/PDK_(VMS)/501/291/2014_Seattle_to_Portland_(STP)_Bicycle_Classic.m3u8\r\n\r\n### Version of ExoPlayer being used\r\nIssue is reproducible on Exo 2.4.0 but is NOT reproducible on 1.5.16\r\n\r\n### Device(s) and version(s) of Android being used\r\nSo far able to repro only on Samsung Galaxy Nexus API level 17\r\n\r\n### A full bug report captured from the device\r\nPlease see logcat and adb bugreport attached\r\n[crashlog.txt](https://github.com/google/ExoPlayer/files/977906/crashlog.txt)\r\n[adbbugreport.txt](https://github.com/google/ExoPlayer/files/977907/adbbugreport.txt)\r\n\r\n","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/2778/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/google/ExoPlayer/issues/2778/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/299856432","html_url":"https://github.com/google/ExoPlayer/issues/2607#issuecomment-299856432","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/2607","id":299856432,"node_id":"MDEyOklzc3VlQ29tbWVudDI5OTg1NjQzMg==","user":{"login":"nokite","id":2574061,"node_id":"MDQ6VXNlcjI1NzQwNjE=","avatar_url":"https://avatars.githubusercontent.com/u/2574061?v=4","gravatar_id":"","url":"https://api.github.com/users/nokite","html_url":"https://github.com/nokite","followers_url":"https://api.github.com/users/nokite/followers","following_url":"https://api.github.com/users/nokite/following{/other_user}","gists_url":"https://api.github.com/users/nokite/gists{/gist_id}","starred_url":"https://api.github.com/users/nokite/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nokite/subscriptions","organizations_url":"https://api.github.com/users/nokite/orgs","repos_url":"https://api.github.com/users/nokite/repos","events_url":"https://api.github.com/users/nokite/events{/privacy}","received_events_url":"https://api.github.com/users/nokite/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-05-08T12:44:16Z","updated_at":"2017-05-08T12:44:16Z","body":"Thanks for the explanation and the change! I think it makes perfect sense. (I cannot comment on the code changes due to my limited knowledge here)\r\n\r\nIt works on my Galaxy Nexus (and a few other devices that didn't have the issue in the first place). I find the playback indistinguishable from the \"KEY_MAX_INPUT_SIZE==0\" fix on the Nexus. I imagine that your fix may have advantages on other devices or different test videos, since it is cleaner.\r\n\r\nOnce difference that I noticed is on the emulator. On some occasions I see improved performance in an emulator with API 17. Both fixes make the playback on one of my test videos pretty choppy (dropping almost half of the frames). But with your fix it plays smoothly sometimes. I'm still trying to figure out when and why. Of course, this is not a real issue if it's limited to the emulator.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/299856432/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"nokite","id":2574061,"node_id":"MDQ6VXNlcjI1NzQwNjE=","avatar_url":"https://avatars.githubusercontent.com/u/2574061?v=4","gravatar_id":"","url":"https://api.github.com/users/nokite","html_url":"https://github.com/nokite","followers_url":"https://api.github.com/users/nokite/followers","following_url":"https://api.github.com/users/nokite/following{/other_user}","gists_url":"https://api.github.com/users/nokite/gists{/gist_id}","starred_url":"https://api.github.com/users/nokite/starred{/owner}{/repo}","subscriptions_url":"h