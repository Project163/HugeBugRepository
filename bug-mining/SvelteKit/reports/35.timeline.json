\r\n+                                       /* never resolves */\r\n+                               });\r\n+                       }\r\n                }\r\n\r\n                location.href = href;\r\n```\r\n\r\nIdeally, we should render `$error.svelte` instead, but I haven't figured out how to do that.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/sveltejs/kit/issues/comments/825918762/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"mattiash","id":588898,"node_id":"MDQ6VXNlcjU4ODg5OA==","avatar_url":"https://avatars.githubusercontent.com/u/588898?v=4","gravatar_id":"","url":"https://api.github.com/users/mattiash","html_url":"https://github.com/mattiash","followers_url":"https://api.github.com/users/mattiash/followers","following_url":"https://api.github.com/users/mattiash/following{/other_user}","gists_url":"https://api.github.com/users/mattiash/gists{/gist_id}","starred_url":"https://api.github.com/users/mattiash/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mattiash/subscriptions","organizations_url":"https://api.github.com/users/mattiash/orgs","repos_url":"https://api.github.com/users/mattiash/repos","events_url":"https://api.github.com/users/mattiash/events{/privacy}","received_events_url":"https://api.github.com/users/mattiash/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":4640184269,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDQ2NDAxODQyNjk=","url":"https://api.github.com/repos/sveltejs/kit/issues/events/4640184269","actor":{"login":"mattiash","id":588898,"node_id":"MDQ6VXNlcjU4ODg5OA==","avatar_url":"https://avatars.githubusercontent.com/u/588898?v=4","gravatar_id":"","url":"https://api.github.com/users/mattiash","html_url":"https://github.com/mattiash","followers_url":"https://api.github.com/users/mattiash/followers","following_url":"ht