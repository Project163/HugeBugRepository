users/ztane/following{/other_user}","gists_url":"https://api.github.com/users/ztane/gists{/gist_id}","starred_url":"https://api.github.com/users/ztane/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ztane/subscriptions","organizations_url":"https://api.github.com/users/ztane/orgs","repos_url":"https://api.github.com/users/ztane/repos","events_url":"https://api.github.com/users/ztane/events{/privacy}","received_events_url":"https://api.github.com/users/ztane/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2013-02-03T10:36:17Z","updated_at":"2013-02-03T10:36:17Z","body":"is this coded for a general case, so that X f(): pass returns X()?\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/13045128/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ztane","id":704200,"node_id":"MDQ6VXNlcjcwNDIwMA==","avatar_url":"https://avatars.githubusercontent.com/u/704200?v=4","gravatar_id":"","url":"https://api.github.com/users/ztane","html_url":"https://github.com/ztane","followers_url":"https://api.github.com/users/ztane/followers","following_url":"https://api.github.com/users/ztane/following{/other_user}","gists_url":"https://api.github.com/users/ztane/gists{/gist_id}","starred_url":"https://api.github.com/users/ztane/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ztane/subscriptions","organizations_url":"https://api.github.com/users/ztane/orgs","repos_url":"https://api.github.com/users/ztane/repos","events_url":"https://api.github.com/users/ztane/events{/privacy}","received_events_url":"https://api.github.com/users/ztane/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/python/mypy/issues/comments/13068076","html_url":"https://github.com/python/mypy/issues/81#issuecomment-13068076","issue_url":"https://api.github.com/repos/python/mypy/issues/81","id":13068076,"node_id":"MDEyOklzc3VlQ29tbWVudDEzMDY4MDc2","user":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2013-02-04T09:28:23Z","updated_at":"2013-02-04T09:28:23Z","body":"ztane: No, at least not in general. Like Python, mypy uses an implicit None return value when it can. However, the primitive types int, float and bool don't include the None value, and we will use 0 / 0.0 / False in those cases. These values are chosen since they are false in a boolean context, similar to None (and they are also the result of int(), float() and bool(), respectively).\n\nIf mypy would support defining new primitive types or non-nullable types (which is currently not the case), we would need a way of specifying the default value on a per-type basis (of course, we could also disallow implicit return values for such types, but it would be inconistent). In this case an implicit return value X() could be the right way to do it.\n\nHowever, relying on the implicit 0 is generally a bad idea from a style point of view: it's there mainly to speed up prototyping and to make mypy similar to Python. There should probably be an optional warning that is given when a function implementation defaults to implicit None/0 etc. return.\n","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/13068076/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/python/mypy/issues/comments/13074943","html_url":"https://github.com/python/mypy/issues/81#issuecomment-13074943","issue_url":"https://api.github.com/repos/python/mypy/issues/81","id":13074943,"node_id":"MDEyOklzc3VlQ29tbWVudDEzMDc0OTQz","user":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url"