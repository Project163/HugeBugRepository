+        @writer1.rewrites(ops.CreateTableOp)
+        def rewrite_alter_column(context, revision, op):
+            op.table_name += "_pass"
+            return op
+
+        directives = [
+            ops.MigrationScript(
+                util.rev_id(),
+                ops.UpgradeOps(
+                    ops=[
+                        ops.CreateTableOp(
+                            "test_table",
+                            [sa.Column("id", sa.Integer(), primary_key=True)],
+                        )
+                    ]
+                ),
+                ops.DowngradeOps(ops=[]),
