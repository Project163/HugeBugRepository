ue mentioned [here](https://github.com/vuejs/core/issues/5374), and after the fix was released in Vue v3.2.42, discovered type conversion still fails in the situation mentioned above.","reactions":{"url":"https://api.github.com/repos/vuejs/core/issues/7096/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vuejs/core/issues/7096/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}},"event":"cross-referenced"},{"id":8437673160,"node_id":"REFE_lADOCCum185DMb4MzwAAAAH27KzI","url":"https://api.github.com/repos/vuejs/core/issues/events/8437673160","actor":{"login":"chrislone","id":16998691,"node_id":"MDQ6VXNlcjE2OTk4Njkx","avatar_url":"https://avatars.githubusercontent.com/u/16998691?v=4","gravatar_id":"","url":"https://api.github.com/users/chrislone","html_url":"https://github.com/chrislone","followers_url":"https://api.github.com/users/chrislone/followers","following_url":"https://api.github.com/users/chrislone/following{/other_user}","gists_url":"https://api.github.com/users/chrislone/gists{/gist_id}","starred_url":"https://api.github.com/users/chrislone/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chrislone/subscriptions","organizations_url":"https://api.github.com/users/chrislone/orgs","repos_url":"https://api.github.com/users/chrislone/repos","events_url":"https://api.github.com/users/chrislone/events{/privacy}","received_events_url":"https://api.github.com/users/chrislone/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"feb187103274e7de1a583b250c4b4b78ba2fb1e4","commit_url":"https://api.github.com/repos/chrislone/core/commits/feb187103274e7de1a583b250c4b4b78ba2fb1e4","created_at":"2023-02-04T02:44:53Z","performed_via_github_app":null},{"id":8979658236,"node_id":"REFE_lADOCCum185DMb4MzwAAAAIXOrX8","url":"https://api.github.com/repos/vuejs/