+
+                        map.put(0, a1);
+                        map.put(1, a2);
+                    }
+
+                    cache.putAll(map);
+
+                    tx.commit();
+                }
+
+                assertEquals(ACCOUNTS * VAL_PER_ACCOUNT, sum);
+            }
+        }
+        finally {
+            srv.destroyCache(cacheName);
+        }
+    }
