(NSRect)aRect; \n @end\n\n @implementation NSWindow (AdditionsFor10_6)\n\n - (NSRect)convertRectToScreen:(NSRect)aRect\n {\n   float x = aRect.origin.x;\n   float y = aRect.origin.y;\n   NSPoint transformed = [self convertBaseToScreen:NSMakePoint(x, y)];\n   return NSMakeRect(transformed.x, transformed.y, aRect.size.width, aRect.size.height);\n }\n\n @end\n```\n\nAlso, the 'cocoa' app from examples won't build on my mac (10.6). See http://pastebin.com/raw.php?i=T9gue6HD .\n\nThanks.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/SFML/SFML/issues/comments/5265180/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"bibhas","id":94200,"node_id":"MDQ6VXNlcjk0MjAw","avatar_url":"https://avatars.githubusercontent.com/u/94200?v=4","gravatar_id":"","url":"https://api.github.com/users/bibhas","html_url":"https://github.com/bibhas","followers_url":"https://api.github.com/users/bibhas/followers","following_url":"https://api.github.com/users/bibhas/following{/other_user}","gists_url":"https://api.github.com/users/bibhas/gists{/gist_id}","starred_url":"https://api.github.com/users/bibhas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bibhas/subscriptions","organizations_url":"https://api.github.com/users/bibhas/orgs","repos_url":"https://api.github.com/users/bibhas/repos","events_url":"https://api.github.com/users/bibhas/events{/privacy}","received_events_url":"https://api.github.com/users/bibhas/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":13897124,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50MTM4OTcxMjQ=","url":"https://api.github.com/repos/SFML/SFML/issues/events/13897124","actor":{"login":"interface","id":566687,"node_id":"MDQ6VXNlcjU2NjY4Nw==","avatar_url":"https://avatars.githubusercontent.com/u/566687?v=4","gravatar_id":"","url":"https://api.github.com/users/inte