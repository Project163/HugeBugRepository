&lt;pre&gt;0: jdbc:ignite:thin://127.0.0.1/&amp;gt; create table t10 (a int, b varchar, primary key(a)) with &quot;ATOMICITY=TRANSACTIONAL_SNAP
SHOT,backups=1&quot;;
No rows affected (0,032 seconds)
0: jdbc:ignite:thin://127.0.0.1/&amp;gt; begin;
No rows affected (0 seconds)
