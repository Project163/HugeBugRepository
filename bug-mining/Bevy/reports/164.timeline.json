":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/bevyengine/bevy/pulls/5305","html_url":"https://github.com/bevyengine/bevy/pull/5305","diff_url":"https://github.com/bevyengine/bevy/pull/5305.diff","patch_url":"https://github.com/bevyengine/bevy/pull/5305.patch","merged_at":null},"body":"# Objective\r\n\r\nFixes #5304 \r\n\r\n## Solution\r\n\r\nInstead of using a simple utility function for loading, which uses a default allocation limit of 512MB, we use a Reader object which can be configured ad hoc.\r\n\r\n## Changelog\r\n\r\n> This section is optional. If this was a trivial fix, or has no externally-visible impact, you can delete this section.\r\n\r\n- Allows loading of textures larger than 512MB\r\n","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/5305/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bevyengine/bevy/issues/5305/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1182832213","html_url":"https://github.com/bevyengine/bevy/issues/5304#issuecomment-1182832213","issue_url":"https://api.github.com/repos/bevyengine/bevy/issues/5304","id":1182832213,"node_id":"IC_kwDODf6-U85GgJZV","user":{"login":"fgiordana","id":2255425,"node_id":"MDQ6VXNlcjIyNTU0MjU=","avatar_url":"https://avatars.githubusercontent.com/u/2255425?v=4","gravatar_id":"","url":"https://api.github.com/users/fgiordana","html_url":"https://github.com/fgiordana","followers_url":"https://api.github.com/users/fgiordana/followers","following_url":"https://api.github.com/users/fgiordana/following{/other_user}","gists_url":"https://api.github.com/users/fgiordana/gists{/gist_id}","starred_url":"https://api.github.com/users/fgiordana/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fgiordana/subscriptions","organizations