+    }
+
+    /**
+     * @throws Exception If failed.
+     */
+    public void testConcurrentUpdateNoDeadlockFromClientsNodeRestart() throws Exception {
+        concurrentUpdateNoDeadlock(clients(), 20, false, true, false);
+    }
