ed_via_github_app":null},{"id":1999319630,"node_id":"MDE1Ok1pbGVzdG9uZWRFdmVudDE5OTkzMTk2MzA=","url":"https://api.github.com/repos/scikit-learn/scikit-learn/issues/events/1999319630","actor":{"login":"qinhanmin2014","id":12003569,"node_id":"MDQ6VXNlcjEyMDAzNTY5","avatar_url":"https://avatars.githubusercontent.com/u/12003569?v=4","gravatar_id":"","url":"https://api.github.com/users/qinhanmin2014","html_url":"https://github.com/qinhanmin2014","followers_url":"https://api.github.com/users/qinhanmin2014/followers","following_url":"https://api.github.com/users/qinhanmin2014/following{/other_user}","gists_url":"https://api.github.com/users/qinhanmin2014/gists{/gist_id}","starred_url":"https://api.github.com/users/qinhanmin2014/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qinhanmin2014/subscriptions","organizations_url":"https://api.github.com/users/qinhanmin2014/orgs","repos_url":"https://api.github.com/users/qinhanmin2014/repos","events_url":"https://api.github.com/users/qinhanmin2014/events{/privacy}","received_events_url":"https://api.github.com/users/qinhanmin2014/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"milestoned","commit_id":null,"commit_url":null,"created_at":"2018-12-01T03:07:12Z","milestone":{"title":"0.20.2"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/scikit-learn/scikit-learn/issues/comments/443408347","html_url":"https://github.com/scikit-learn/scikit-learn/issues/12703#issuecomment-443408347","issue_url":"https://api.github.com/repos/scikit-learn/scikit-learn/issues/12703","id":443408347,"node_id":"MDEyOklzc3VlQ29tbWVudDQ0MzQwODM0Nw==","user":{"login":"jorisvandenbossche","id":1020496,"node_id":"MDQ6VXNlcjEwMjA0OTY=","avatar_url":"https://avatars.githubusercontent.com/u/1020496?v=4","gravatar_id":"","url":"https://api.github.com/users/jorisvandenbossche","html_url":"https://github.com/jorisvandenbossche","followers_url":"https://api.github.com/users/jorisvandenbossche/followers","following_url":"https://api.github.com/users/jorisvandenbossche/following{/other_user}","gists_url":"https://api.github.com/users/jorisvandenbossche/gists{/gist_id}","starred_url":"https://api.github.com/users/jorisvandenbossche/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jorisvandenbossche/subscriptions","organizations_url":"https://api.github.com/users/jorisvandenbossche/orgs","repos_url":"https://api.github.com/users/jorisvandenbossche/repos","events_url":"https://api.github.com/users/jorisvandenbossche/events{/privacy}","received_events_url":"https://api.github.com/users/jorisvandenbossche/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-12-01T08:01:26Z","updated_at":"2018-12-01T08:01:26Z","body":"The bug actually also exists \"in the future\" for numpy arrays:\r\n\r\n```\r\nIn [14]: cat_features= np.array([1, 2, 3])   \r\n\r\nIn [15]: ct = make_column_transformer((cat_features, OneHotEncoder(sparse=False)), \r\n    ...:                              remainder=StandardScaler()) \r\n    ...: ct.transformers \r\n/home/joris/scipy/scikit-learn/sklearn/compose/_column_transformer.py:695: \r\nFutureWarning: elementwise comparison failed; returning scalar instead, but in the future will perform elementwise comparison\r\n  if t in ('drop', 'passthrough'):\r\n/home/joris/scipy/scikit-learn/sklearn/compose/_column_transformer.py:739: \r\nDeprecationWarning: `make_column_transformer` now expects (transformer, columns) as input tuples instead of (columns, transformer). \r\nThis has been introduced in v0.20.1. `make_column_transformer` will stop accepting the deprecated (columns, transformer) order in v0.22.\r\n  warnings.warn(message, DeprecationWarning)\r\nOut[15]: \r\n[('onehotencoder', OneHotEncoder(categorical_features=None, categories=None,\r\n         dtype=<class 'numpy.float64'>, handle_unknown='error',\r\n         n_values=None, sparse=False), array([1, 2, 3]))]\r\n```\r\n\r\nSo for numpy arrays, the check of `t in ('drop', 'passthrough')` still gives a warning, but in the future it will also raise. Pandas Series / Index already has the future behaviour (always had I think).\r\n\r\nJust as a side note, as the fix is already there I see :)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/scikit-learn/scikit-learn/issues/comments/443408347/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"jorisvandenbossche","id":1020496,"node_id":"MDQ6VXNlcjEwMjA0OTY=","avatar_url":"https://avatars.githubusercontent.com/u/1020496?v=4","gravatar_id":"","url":"https://api.github.com/users/jorisvandenbossche","html_url":"https://github.com/jorisvandenbossche","followers_url":"https://api.github.com/users/jorisvandenbossche/followers","following_url":"https://api.github.com/users/jorisvandenbossche/following{/other_user}","gists_url":"https://api.github.com/users/jorisvandenbossche/gists{/gist_id}","starred_url":"https://api.github.com/users/jorisvandenbossche/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jorisvandenbossche/subscriptions","organizations_url":"https://api.github.com/users/jorisvandenbossche/orgs","repos_url":"https://api.github.com/users/jorisvandenbossche/repos","events_url":"https://api.github.com/users/jorisvandenbossche/events{/privacy}","received_events_url":"https://api.github.com/users/jorisvandenbossche/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":2000996056,"node_id":"MDExOkNsb3NlZEV2ZW50MjAwMDk5NjA1Ng==","url":"https://api.github.com/repos/scikit-learn/scikit-learn/issues/events/2000996056","actor":{"login":"jnothman","id":78827,"node_id":"MDQ6VXNlcjc4ODI3","avatar_url":"https://avatars.githubusercontent.com/u/78827?v=4","gravatar_id":"","url":"https://api.github.com/users/jnothman","html_url":