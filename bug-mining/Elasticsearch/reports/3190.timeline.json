ercontent.com/u/1223797?v=4","gravatar_id":"","url":"https://api.github.com/users/prwhelan","html_url":"https://github.com/prwhelan","followers_url":"https://api.github.com/users/prwhelan/followers","following_url":"https://api.github.com/users/prwhelan/following{/other_user}","gists_url":"https://api.github.com/users/prwhelan/gists{/gist_id}","starred_url":"https://api.github.com/users/prwhelan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/prwhelan/subscriptions","organizations_url":"https://api.github.com/users/prwhelan/orgs","repos_url":"https://api.github.com/users/prwhelan/repos","events_url":"https://api.github.com/users/prwhelan/events{/privacy}","received_events_url":"https://api.github.com/users/prwhelan/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"assigned","commit_id":null,"commit_url":null,"created_at":"2025-09-08T12:16:04Z","assignee":{"login":"prwhelan","id":1223797,"node_id":"MDQ6VXNlcjEyMjM3OTc=","avatar_url":"https://avatars.githubusercontent.com/u/1223797?v=4","gravatar_id":"","url":"https://api.github.com/users/prwhelan","html_url":"https://github.com/prwhelan","followers_url":"https://api.github.com/users/prwhelan/followers","following_url":"https://api.github.com/users/prwhelan/following{/other_user}","gists_url":"https://api.github.com/users/prwhelan/gists{/gist_id}","starred_url":"https://api.github.com/users/prwhelan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/prwhelan/subscriptions","organizations_url":"https://api.github.com/users/prwhelan/orgs","repos_url":"https://api.github.com/users/prwhelan/repos","events_url":"https://api.github.com/users/prwhelan/events{/privacy}","received_events_url":"https://api.github.com/users/prwhelan/received_events","type":"User","user_view_type":"public","site_admin":false},"performed_via_github_app":null},{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/comments/3267277944","html_url":"https://github.com/elastic/elasticsearch/issues/134263#issuecomment-3267277944","issue_url":"https://api.github.com/repos/elastic/elasticsearch/issues/134263","id":3267277944,"node_id":"IC_kwDOAAe_f87CvrR4","user":{"login":"prwhelan","id":1223797,"node_id":"MDQ6VXNlcjEyMjM3OTc=","avatar_url":"https://avatars.githubusercontent.com/u/1223797?v=4","gravatar_id":"","url":"https://api.github.com/users/prwhelan","html_url":"https://github.com/prwhelan","followers_url":"https://api.github.com/users/prwhelan/followers","following_url":"https://api.github.com/users/prwhelan/following{/other_user}","gists_url":"https://api.github.com/users/prwhelan/gists{/gist_id}","starred_url":"https://api.github.com/users/prwhelan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/prwhelan/subscriptions","organizations_url":"https://api.github.com/users/prwhelan/orgs","repos_url":"https://api.github.com/users/prwhelan/repos","events_url":"https://api.github.com/users/prwhelan/events{/privacy}","received_events_url":"https://api.github.com/users/prwhelan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-08T17:37:28Z","updated_at":"2025-09-08T17:37:28Z","body":"Can repro:\n```java\n    public void testGetTransformsDoesNotErrorOnPageSize() throws Exception {\n        var transformId1 = \"multiple-transforms-1\";\n        var transformSrc = \"reviews_multiple_transforms_test\";\n        createReviewsIndex(transformSrc);\n        createAndStartTransform(transformId1, transformSrc, transformId1 + \"_idx\");\n\n        var transformId2 = \"multiple-transforms-2\";\n        createAndStartTransform(transformId2, transformSrc, transformId2 + \"_idx\");\n\n        // get a single transform from `_all`\n        var request = new Request(\"GET\", getTransformEndpoint() + \"_all?size=1\");\n        var response = adminClient().performRequest(request);\n        var transforms = entityAsMap(response);\n        var transformConfigs = (List<Map<String, Object>>) XContentMapValues.extractValue(\"transforms\", transforms);\n        var errors = (List<Map<String, String>>) XContentMapValues.extractValue(\"errors\", transforms);\n        assertThat(errors, is(nullValue()));\n        assertThat(transformConfigs, hasSize(2));\n\n        var actualIds = transformConfigs.stream().map(config -> (String) config.get(\"id\")).toList();\n        assertThat(actualIds, containsInAnyOrder(transformId1, transformId2));\n    }\n```\n\nThis happens if we have N number of Transforms running, but we call `GET _transform/_all` with a size < N. So if we have 2 transforms and query `_transform/_all?size=1`, we will say the second transform is running without a config (which is incorrect):\nhttps://github.com/elastic/elasticsearch/blob/main/x-pack/plugin/transform/src/main/java/org/elasticsearch/xpack/transform/action/TransportGetTransformAction.java#L83","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/comments/3267277944/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"prwhelan","id":1223797,"node_id":"MDQ6VXNlcjEyMjM3OTc=","avatar_url":"https://avatars.githubusercontent.com/u/1223797?v=4","gravatar_id":"","url":"https://api.github.com/users/prwhelan","html_url":"https://github.com/prwhelan","followers_url":"https://api.github.com/users/prwhelan/followers","following_url":"https://api.github.com/users/prwhelan/following{/other_user}","gists_url":"https://api.github.com/users/prwhelan/gists{/gist_id}","starred_url":"https://api.github.com/users/prwhelan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/prwhelan/subscriptions","organizations_url":"https://api.github.com/users/prwhelan/orgs","repos_url":"https://api.github.com/users/prwhelan/repos","events_url":"https://api.github.com/users/prwhelan/events{/privacy}","received_events_url":"https://api.github.com/users/prwhelan/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":19664048934,"node_id":"SE_lADOAAe_f87KE-aYzwAAAASUEZMm","url":"https://api.github.com/repos/elastic/elasticsearch/issues/events/19664048934","actor":{"login":"jasonrhodes","id":159370,"node_id":"MDQ6VXNlcjE1OTM3MA==","avatar_url":"https://avatars.githubusercontent.com/u/159370?v=4","gravatar_id":"","url":"https://api.github.com/users/jasonrhodes","html_url":"https://github.com/jasonrhodes","followers_url":"https://api.github.com/users/jasonrhodes/followers","following_url":"https://api.github.com/users/jasonrhodes/following{/other_user}","gists_url":"https://api.github.com/users/jasonrhodes/gists{/gist_id}","starred_url":"https://api.github.com/users/jasonrhodes/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jasonrhodes/subscriptions","organizations_url":"https://api.github.com/users/jasonrhodes/orgs","repos_url":"https://api.github.com/users/jasonrhodes/repos","events_url":"https://api.github.com/users/jasonrhodes/events{/privacy}","received_events_url":"https://api.github.com/users/jasonrhodes/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2025-09-12T15:47:37Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/comments/3285809949","html_url":"https://github.com/elastic/elasticsearch/issues/134263#issuecomment-3285809949","issue_url":"https://api.github.com/repos/elastic/elasticsearch/issues/134263","id":3285809949,"node_id":"IC_kwDOAAe_f87D2Xsd","user":{"login":"jasonrhodes","id":159370,"node_id":"MDQ6VXNlcjE1OTM3MA==","avatar_url":"https://avatars.githubusercontent.com/u/159370?v=4","gravatar_id":"","url":"https://api.github.com/users/jasonrhodes","html_url":"https://github.com/jasonrhodes","followers_url":"https://api.github.com/users/jasonrh