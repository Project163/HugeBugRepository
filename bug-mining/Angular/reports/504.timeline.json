.com/users/DzmitryShylovich","html_url":"https://github.com/DzmitryShylovich","followers_url":"https://api.github.com/users/DzmitryShylovich/followers","following_url":"https://api.github.com/users/DzmitryShylovich/following{/other_user}","gists_url":"https://api.github.com/users/DzmitryShylovich/gists{/gist_id}","starred_url":"https://api.github.com/users/DzmitryShylovich/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DzmitryShylovich/subscriptions","organizations_url":"https://api.github.com/users/DzmitryShylovich/orgs","repos_url":"https://api.github.com/users/DzmitryShylovich/repos","events_url":"https://api.github.com/users/DzmitryShylovich/events{/privacy}","received_events_url":"https://api.github.com/users/DzmitryShylovich/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/angular/angular/issues/comments/289824216","html_url":"https://github.com/angular/angular/issues/15535#issuecomment-289824216","issue_url":"https://api.github.com/repos/angular/angular/issues/15535","id":289824216,"node_id":"MDEyOklzc3VlQ29tbWVudDI4OTgyNDIxNg==","user":{"login":"IEvangelist","id":7679720,"node_id":"MDQ6VXNlcjc2Nzk3MjA=","avatar_url":"https://avatars.githubusercontent.com/u/7679720?v=4","gravatar_id":"","url":"https://api.github.com/users/IEvangelist","html_url":"https://github.com/IEvangelist","followers_url":"https://api.github.com/users/IEvangelist/followers","following_url":"https://api.github.com/users/IEvangelist/following{/other_user}","gists_url":"https://api.github.com/users/IEvangelist/gists{/gist_id}","starred_url":"https://api.github.com/users/IEvangelist/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/IEvangelist/subscriptions","organizations_url":"https://api.github.com/users/IEvangelist/orgs","repos_url":"https://api.github.com/users/IEvangelist/repos","events_url":"https://api.github.com/users/IEvangelist/events{/privacy}","received_events_url":"https://api.github.com/users/IEvangelist/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-03-28T16:20:33Z","updated_at":"2017-03-28T18:04:06Z","body":"I believe that an invocation to the `.resetConfig` should invalidate the entire route tree and force a re-evaluation. If the URL doesn't change, that should not matter - as the routes that existed before are potentially no longer valid at all.\r\n\r\n@zoechi any ideas or thoughts on this?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/comments/289824216/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"IEvangelist","id":7679720,"node_id":"MDQ6VXNlcjc2Nzk3MjA=","avatar_url":"https://avatars.githubusercontent.com/u/7679720?v=4","gravatar_id":"","url":"https://api.github.com/users/IEvangelist","html_url":"https://github.com/IEvangelist","followers_url":"https://api.github.com/users/IEvangelist/followers","following_url":"https://api.github.com/users/IEvangelist/following{/other_user}","gists_url":"https://api.github.com/users/IEvangelist/gists{/gist_id}","starred_url":"https://api.github.com/users/IEvangelist/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/IEvangelist/subscriptions","organizations_url":"https://api.github.com/users/IEvangelist/orgs","repos_url":"https://api.github.com/users/IEvangelist/repos","events_url":"https://api.github.com/users/IEvangelist/events{/privacy}","received_events_url":"https://api.github.com/users/IEvangelist/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/angular/angular/issues/comments/289827981","html_url":"https://github.com/angular/angular/issues/15535#issuecomment-289827981","issue_url":"https://api.github.com/repos/angular/angular/issues/15535","id":289827981,"node_id":"MDEyOklzc3VlQ29tbWVudDI4OTgyNzk4MQ==","user":{"login":"AHelper","id":2072395,"node_id":"MDQ6VXNlcjIwNzIzOTU=","avatar_url":"https://avatars.githubusercontent.com/u/2072395?v=4","gravatar_id":"","url":"https://api.github.com/users/AHelper","html_url":"https://github.com/AHelper","followers_url":"https://api.github.com/users/AHelper/followers","following_url":"https://api.github.com/users/AHelper/following{/other_user}","gists_url":"https://api.github.com/users/AHelper/gists{/gist_id}","starred_url":"https://api.github.com/users/AHelper/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AHelper/subscriptions","organizations_url":"https://api.github.com/users/AHelper/orgs","repos_url":"https://api.github.com/users/AHelper/repos","events_url":"https://api.github.com/users/AHelper/events{/privacy}","received_events_url":"https://api.github.com/users/AHelper/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-03-28T16:32:56Z","updated_at":"2017-03-28T16:32:56Z","body":"From what I see in what's trying to be done in #13340 and some of the linked issues, the router is attempting navigation to the same URL, however no navigation actually happens, which makes sense as no state has changed (maybe to re-run guards, etc. that are part of the route). Although in this case, I think the navigation in my plunker is hiding the larger issue here.   If you look at the router as a state machine, then no change in URL means no change in state... except when the config that defines the states has changed.\r\n\r\nI would expect that by changing the configuration in the router that it would have to re-evaluate whether or not a state change has occurred.  The URL would not change, however the config defining states would.\r\n\r\nHaving `.resetConfig` check if the resulting route changed seems logical, except (afaik) the only way to change routes in a lazy loaded module (scoped to that module, not going out to the router and touching routes from the root of the application) is to modify route config on `ActivatedRoute`.  If there was a mechanism to change the config that worked across the board that gave the router a chance to evaluate what changes happened, (like .resetConfig on `ActivatedRoute` or some other way to update config in lazy-loaded modules), then the navigation wouldn't be necessary, just reset the config and check if the resulting states changed to decide whether or not to change state.  I don't know if that could still be called \"navigation\" at that point, but the resulting state isn't the same.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/comments/289827981/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"AHelper","id":2072395,"node_id":"MDQ6VXNlcjIwNzIzOTU=","avatar_url":"https://avatars.githubusercontent.com/u/2072395?v=4","gravatar_id":"","url":"https://api.github.com/users/AHelper","html_url":"https://github.com/AHelper","followers_url":"https://api.github.com/users/AHelper/followers","following_url":"https://api.github.com/users/AHelper/following{/other_user}","gists_url":"https://api.github.com/users/AHelper/gists{/gist_id}","starred_url":"https://api.github.com/users/AHelper/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AHelper/subscriptions","organizations_url":"https://api.github.com/users/AHelper/orgs","repos_url":"https://api.github.com/users/AHelper/repos","events_url":"https://api.github.com/users/AHelper/events{/privacy}","received_events_url":"https://api.github.com/users/AHelper/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1019055561,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50MTAxOTA1NTU2MQ==","url":"https://api.github.com/repos/angular/angular/issues/events/1019055561","actor":{