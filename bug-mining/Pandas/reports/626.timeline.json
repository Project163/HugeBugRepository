om.random(size=(3,3)))\n\nIn [4]: print df.to_string(col_space=2)\n          0         1         2\n0  0.972671  0.735920  0.186650\n1  0.092195  0.544714  0.750312\n2  0.534684  0.685200  0.887377\n\nIn [5]: print df.to_string(col_space=5)\n          0         1         2\n0  0.972671  0.735920  0.186650\n1  0.092195  0.544714  0.750312\n2  0.534684  0.685200  0.887377\n\nIn [6]: print df.to_string(col_space=10)\n          0         1         2\n0  0.972671  0.735920  0.186650\n1  0.092195  0.544714  0.750312\n2  0.534684  0.685200  0.887377\n\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/pandas-dev/pandas/issues/comments/7504517/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"vincentarelbundock","id":987057,"node_id":"MDQ6VXNlcjk4NzA1Nw==","avatar_url":"https://avatars.githubusercontent.com/u/987057?v=4","gravatar_id":"","url":"https://api.github.com/users/vincentarelbundock","html_url":"https://github.com/vincentarelbundock","followers_url":"https://api.github.com/users/vincentarelbundock/followers","following_url":"https://api.github.com/users/vincentarelbundock/following{/other_user}","gists_url":"https://api.github.com/users/vincentarelbundock/gists{/gist_id}","starred_url":"https://api.github.com/users/vincentarelbundock/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vincentarelbundock/subscriptions","organizations_url":"https://api.github.com/users/vincentarelbundock/orgs","repos_url":"https://api.github.com/users/vincentarelbundock/repos","events_url":"https://api.github.com/users/vincentarelbundock/events{/privacy}","received_events_url":"https://api.github.com/users/vincentarelbundock/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":22072992,"node_id":"MDE1OlN1YnNjcmliZWRFdmVudDIyMDcyOTky","url":"https://api.github.com/repos/panda