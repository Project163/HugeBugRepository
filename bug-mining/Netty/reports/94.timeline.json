ler.channelInactive(SslHandler.java:570) [netty-4.0.0.Beta1-SNAPSHOT.jar:na]\n        at io.netty.channel.DefaultChannelHandlerContext.invokeChannelInactive(DefaultChannelHandlerContext.java:1035) [netty-4.0.0.Beta1-SNAPSHOT.jar:na]\n        at io.netty.channel.DefaultChannelHandlerContext.access$1100(DefaultChannelHandlerContext.java:39) [netty-4.0.0.Beta1-SNAPSHOT.jar:na]\n        at io.netty.channel.DefaultChannelHandlerContext$9.run(DefaultChannelHandlerContext.java:1024) [netty-4.0.0.Beta1-SNAPSHOT.jar:na]\n        at io.netty.channel.SingleThreadEventExecutor.runAllTasks(SingleThreadEventExecutor.java:259) [netty-4.0.0.Beta1-SNAPSHOT.jar:na]\n        at io.netty.channel.socket.nio.NioEventLoop.run(NioEventLoop.java:298) [netty-4.0.0.Beta1-SNAPSHOT.jar:na]\n        at io.netty.channel.SingleThreadEventExecutor$2.run(SingleThreadEventExecutor.java:110) [netty-4.0.0.Beta1-SNAPSHOT.jar:na]\n        at java.lang.Thread.run(Thread.java:722) [na:1.7.0_09]\n```\n\nIn order to run them, i had to fix imports for socket.nio and fix new StringEncoder/Decoder parameters.\n","reactions":{"url":"https://api.github.com/repos/netty/netty/issues/1045/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/netty/netty/issues/1045/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]