+                    self.meta_level == other.meta_level)
+        else:
+            return False
+
+    def __ne__(self, other: object) -> bool:
+        return not (self == other)
+
+    def __hash__(self) -> int:
+        return hash((self.raw_id, self.meta_level))
+
+    def is_meta_var(self) -> bool:
+        return self.meta_level > 0
