hub.com/users/yugabyte-ci/followers","following_url":"https://api.github.com/users/yugabyte-ci/following{/other_user}","gists_url":"https://api.github.com/users/yugabyte-ci/gists{/gist_id}","starred_url":"https://api.github.com/users/yugabyte-ci/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yugabyte-ci/subscriptions","organizations_url":"https://api.github.com/users/yugabyte-ci/orgs","repos_url":"https://api.github.com/users/yugabyte-ci/repos","events_url":"https://api.github.com/users/yugabyte-ci/events{/privacy}","received_events_url":"https://api.github.com/users/yugabyte-ci/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2023-08-30T15:30:24Z","label":{"name":"priority/medium","color":"ffdc5e"},"performed_via_github_app":null},{"id":10235609093,"node_id":"UNLE_lADOBlCVUc5vsbq5zwAAAAJiFwAF","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/10235609093","actor":{"login":"yugabyte-ci","id":17281578,"node_id":"MDQ6VXNlcjE3MjgxNTc4","avatar_url":"https://avatars.githubusercontent.com/u/17281578?v=4","gravatar_id":"","url":"https://api.github.com/users/yugabyte-ci","html_url":"https://github.com/yugabyte-ci","followers_url":"https://api.github.com/users/yugabyte-ci/followers","following_url":"https://api.github.com/users/yugabyte-ci/following{/other_user}","gists_url":"https://api.github.com/users/yugabyte-ci/gists{/gist_id}","starred_url":"https://api.github.com/users/yugabyte-ci/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yugabyte-ci/subscriptions","organizations_url":"https://api.github.com/users/yugabyte-ci/orgs","repos_url":"https://api.github.com/users/yugabyte-ci/repos","events_url":"https://api.github.com/users/yugabyte-ci/events{/privacy}","received_events_url":"https://api.github.com/users/yugabyte-ci/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"unlabeled","commit_id":null,"commit_url":null,"created_at":"2023-08-30T17:19:26Z","label":{"name":"status/awaiting-triage","color":"E33F0D"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1706327857","html_url":"https://github.com/yugabyte/yugabyte-db/issues/18919#issuecomment-1706327857","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/18919","id":1706327857,"node_id":"IC_kwDOBlCVUc5ltH8x","user":{"login":"arybochkin","id":79331145,"node_id":"MDQ6VXNlcjc5MzMxMTQ1","avatar_url":"https://avatars.githubusercontent.com/u/79331145?v=4","gravatar_id":"","url":"https://api.github.com/users/arybochkin","html_url":"https://github.com/arybochkin","followers_url":"https://api.github.com/users/arybochkin/followers","following_url":"https://api.github.com/users/arybochkin/following{/other_user}","gists_url":"https://api.github.com/users/arybochkin/gists{/gist_id}","starred_url":"https://api.github.com/users/arybochkin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arybochkin/subscriptions","organizations_url":"https://api.github.com/users/arybochkin/orgs","repos_url":"https://api.github.com/users/arybochkin/repos","events_url":"https://api.github.com/users/arybochkin/events{/privacy}","received_events_url":"https://api.github.com/users/arybochkin/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-09-05T10:08:13Z","updated_at":"2023-09-05T12:22:20Z","body":"It is looking like a data race due to which a value of `DocDBRocksDBUtil::doc_read_context_` can be initialised with a new allocation more than once, but its content is accessed without any protection, directly or via `DocDBRocksDBUtil::doc_read_context()`. For example:\r\n```\r\nResult<CompactionSchemaInfo> DocDBRocksDBUtil::CotablePacking(\r\n    const Uuid& table_id, uint32_t schema_version, HybridTime history_cutoff) {\r\n  if (schema_version == kLatestSchemaVersion) {\r\n    schema_version = 0;\r\n  }\r\n  ANNOTATE_IGNORE_READS_BEGIN();\r\n  auto& packing = VERIFY_RESULT_REF(\r\n      doc_read_context().schema_packing_storage.GetPacking(schema_version));\r\n  ANNOTATE_IGNORE_READS_END();\r\n  return CompactionSchemaInfo {\r\n    .table_type = TableType::YQL_TABLE_TYPE,\r\n    .schema_version = schema_version,\r\n    .schema_packing = rpc::SharedField(doc_read_context_, &packing),\r\n    .cotable_id = table_id,\r\n    .deleted_cols = {},\r\n    .packed_row_version = PackedRowVersion(TableType::YQL_TABLE_TYPE, false),\r\n    .schema = rpc::SharedField(doc_read_context_, &doc_read_context_->schema())\r\n  };\r\n}\r\n```\r\nFor the line `.schema_packing = rpc::SharedField(doc_read_context_, &packing),`, the value of `packing` can belong to the old instance preempted in  `doc_read_context()` by another thread. The same is fair for the last line, where `doc_read_context_` and `doc_read_context_->schema()` can belong to a different instances of doc_read_context_.\r\nIn accordance with logs:\r\n```\r\nI0827 16:11:37.415853 21810 event_logger.cc:66] [R] EVENT_LOG_v1 {\"time_micros\": 1693152697415771, \"job\": 3, \"event\": \"compaction_started\", \"files_L0\": [28, 27, 26, 25, 24], \"score\": 4, \"input_data_size\": 332295}\r\n...\r\nI0827 16:11:37.416949 21811 event_logger.cc:66] [R] EVENT_LOG_v1 {\"time_micros\": 1693152697416893, \"job\": 4, \"event\": \"compaction_started\", \"files_L0\": [22, 21, 20, 19, 18, 17], \"score\": 4, \"input_data_size\": 398754}\r\nI0827 16:11:37.417572 21810 docdb_compaction_context.cc:1273] Retention directive from manual policy { cotables cutoff: <invalid>, primary cutoff: <min> }\r\nI0827 16:11:37.418045 21810 docdb_compaction_context.cc:751] DocDB compaction feed, min_other_data_ht: HT<max>, history_cutoff = { cotables cutoff: <invalid>, primary cutoff: <min> }\r\nI0827 16:11:37.418283 21811 docdb_compaction_context.cc:1273] Retention directive from manual policy { cotables cutoff: <invalid>, primary cutoff: <min> }\r\nI0827 16:11:37.418342 21811 docdb_compaction_context.cc:751] DocDB compaction feed, min_other_data_ht: HT<max>, history_cutoff = { cotables cutoff: <invalid>, primary cutoff: <min> }\r\n...\r\nI0827 16:11:37.428221 21810 event_logger.cc:76] [R] EVENT_LOG_v1 {\"time_micros\": 1693152697427717, \"job\": 3, \"event\": \"compaction_finished\", \"compaction_time_micros\": 9111, \"output_level\": 0, \"num_output_files\": 1, \"total_output_size\": 66548, \"num_input_records\": 5, \"num_output_records\": 5, \"num_subcompactions\": 1, \"lsm_state\": [16]}\r\n...\r\nI0827 16:11:37.429086 21810 event_logger.cc:66] [R] EVENT_LOG_v1 {\"time_micros\": 1693152697429064, \"job\": 5, \"event\": \"compaction_started\", \"files_L0\": [15, 14, 13, 12, 11, 10], \"score\": 4, \"input_data_size\": 398754}\r\n...\r\nI0827 16:11:37.430210 21811 event_logger.cc:76] [R] EVENT_LOG_v1 {\"time_micros\": 1693152697429594, \"job\": 4, \"event\": \"compaction_finished\", \"compaction_time_micros\": 8012, \"output_level\": 0, \"num_output_files\": 1, \"total_output_size\": 66569, \"num_input_records\": 6, \"num_output_records\": 6, \"num_subcompactions\": 1, \"lsm_state\": [11]}\r\n...\r\nI0827 16:11:37.435722 21810 event_logger.cc:76] [R] EVENT_LOG_v1 {\"time_micros\": 1693152697435448, \"job\": 5, \"event\": \"compaction_finished\", \"compaction_time_micros\": 5141, \"output_level\": 0, \"num_output_files\": 1, \"total_output_size\": 66574, \"num_input_records\": 6, \"num_output_records\": 6, \"num_subcompactions\": 1, \"lsm_state\": [6]}\r\n...\r\nIndirect leak of 480 byte(s) in 1 object(s) allocated from:\r\n   ...\r\n    #8 0x7fd5fdd4feb3 in yb::docdb::DocDBRocksDBUtil::doc_read_context() ${BUILD_ROOT}/../../src/yb/docdb/docdb_util.cc:69:25\r\n    #9 0x7fd5fdd5e901 in yb::docdb::DocDBRocksDBUtil::CotablePacking(yb::Uuid const&, unsigned int, yb::HybridTime) ${BUILD_ROOT}/../../src/yb/docdb/docdb_util.cc:570:19\r\n    #10 0x7fd5fdd7a37c in yb::docdb::(anonymous namespace)::PackedRowData::GetCompactionSchemaInfo(yb::Slice) ${BUILD_ROOT}/../../src/yb/docdb/docdb_compaction_context.cc:452:40\r\n    #11 0x7fd5fdd7a37c in yb::docdb::(anonymous namespace)::PackedRowData::UpdateCoprefix(yb::Slice const&) ${BUILD_ROOT}/../../src/yb/docdb/docdb_compaction_context.cc:433:20\r\n    #12 0x7fd5fdd7a37c in yb::docdb::(anonymous namespace)::DocDBCompactionFeed::Feed(yb::Slice const&, yb::Slice const&) ${BUILD_ROOT}/../../src/yb/docdb/docdb_compaction_context.cc:811:3\r\n    #13 0x7fd5fc8f5b5e in rocksdb::CompactionJob::ProcessKeyValueCompaction(rocksdb::FileNumbersHolder*, rocksdb::CompactionJob::SubcompactionState*) ${BUILD_ROOT}/../../src/yb/rocksdb/db/compaction_job.cc:693:33\r\n    #14 0x7fd5fc8f1760 in rocksdb::CompactionJob::Run() ${BUILD_ROOT}/../../src/yb/rocksdb/db/compaction_job.cc:469:3\r\n    #15 0x7fd5fc9bcaa0 in rocksdb::DBImpl::BackgroundCompaction(bool*, rocksdb::JobContext*, rocksdb::LogBuffer*, rocksdb::DBImpl::ManualCompaction*, std::unique_ptr<rocksdb::Compaction, std::default_delete<rocksdb::Compaction>>) ${BUILD_ROOT}/../../src/yb/rocksdb/db/db_impl.cc:3758:29\r\n...\r\nIndirect leak of 416 byte(s) in 1 object(s) allocated from:\r\n    ...\r\n    #16 0x7fd5fdd4feb3 in yb::docdb::DocDBRocksDBUtil::doc_read_context() ${BUILD_ROOT}/../../src/yb/docdb/docdb_util.cc:69:25\r\n    #17 0x7fd5fdd5e901 in yb::docdb::DocDBRocksDBUtil::CotablePacking(yb::Uuid const&, unsigned int, yb::HybridTime) ${BUILD_ROOT}/../../src/yb/docdb/docdb_util.cc:570:19\r\n    #18 0x7fd5fdd7a37c in yb::docdb::(anonymous namespace)::PackedRowData::GetCompactionSchemaInfo(yb::Slice) ${BUILD_ROOT}/../../src/yb/docdb/docdb_compaction_context.cc:452:40\r\n    #19 0x7fd5fdd7a37c in yb::docdb::(anonymous namespace)::PackedRowData::UpdateCoprefix(yb::Slice const&) ${BUILD_ROOT}/../../src/yb/docdb/docdb_compaction_context.cc:433:20\r\n    #20 0x7fd5fdd7a37c in yb::docdb::(anonymous namespace)::DocDBCompactionFeed::Feed(yb::Slice const&, yb::Slice const&) ${BUILD_ROOT}/../../src/yb/docdb/docdb_compaction_context.cc:811:3\r\n    #21 0x7fd5fc8f5b5e in rocksdb::CompactionJob::ProcessKeyValueCompaction(rocksdb::FileNumbersHolder*, rocksdb::CompactionJob::SubcompactionState*) ${BUILD_ROOT}/../../src/yb/rocksdb/db/compaction_job.cc:693:33\r\n    #22 0x7fd5fc8f1760 in rocksdb::CompactionJob::Run() ${BUILD_ROOT}/../../src/yb/rocksdb/db/compaction_job.cc:469:3\r\n    #23 0x7fd5fc9bcaa0 in rocksdb::DBImpl::BackgroundCompaction(bool*, rocksdb::JobContext*, rocksdb::LogBuffer*, rocksdb::DBImpl::ManualCompaction*, std::unique_ptr<rocksdb::Compaction, std::default_delete<rocksdb::Compaction>>) ${BUILD_ROOT}/../../src/yb/rocksdb/db/db_impl.cc:3758:29\r\n```\r\nSeveral compactions are running the same time from different threads, however the DocDBRocksDBUtil instance (as the implementation of SchemaPackingProvider) does not protects data from an access from multiple threads. TSAN is either does not detecting the issue or does not complaining because of\r\n```\r\n  ANNOTATE_IGNORE_READS_BEGIN();\r\n  auto& packing = VERIFY_RESULT_REF(\r\n      doc_read_context().schema_packing_storage.GetPacking(schema_version));\r\n  ANNOTATE_IGNORE_READS_END();\r\n```\r\nAs of now `DocDBRocksDBUtil` is used for tests and bulk load tool, so both of these areas are potentially impacted by the issue. In addition to SchemaPackingProvider's methods, the implementation of at least `DocDBRocksDBUtil::doc_read_context()` should also guarantee thread safety.\r\nAdditionally, all other implementation of `SchemaPackingProvider` should be checked for thread-safetyness or their usage should be thread-safe.\r\ncc @spolitov @Huqicheng ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1706327857/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"arybochkin","id":79331145,"node_id":"MDQ6VXN