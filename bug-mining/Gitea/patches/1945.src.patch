+		_, job2LinuxJob, _ := getTaskAndJobAndRunByTaskID(t, job2LinuxTask.Id)
+		assert.Equal(t, "wf2-job (linux)", job2LinuxJob.Name)
+		assert.Equal(t, "job-os-linux", job2LinuxJob.ConcurrencyGroup)
+	})
+}
