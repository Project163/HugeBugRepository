=4","gravatar_id":"","url":"https://api.github.com/users/vicb","html_url":"https://github.com/vicb","followers_url":"https://api.github.com/users/vicb/followers","following_url":"https://api.github.com/users/vicb/following{/other_user}","gists_url":"https://api.github.com/users/vicb/gists{/gist_id}","starred_url":"https://api.github.com/users/vicb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vicb/subscriptions","organizations_url":"https://api.github.com/users/vicb/orgs","repos_url":"https://api.github.com/users/vicb/repos","events_url":"https://api.github.com/users/vicb/events{/privacy}","received_events_url":"https://api.github.com/users/vicb/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2018-06-06T21:08:13Z","label":{"name":"type: bug/fix","color":"EEEEEE"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/angular/angular/issues/comments/395500735","html_url":"https://github.com/angular/angular/issues/24324#issuecomment-395500735","issue_url":"https://api.github.com/repos/angular/angular/issues/24324","id":395500735,"node_id":"MDEyOklzc3VlQ29tbWVudDM5NTUwMDczNQ==","user":{"login":"jenniferfell","id":31675481,"node_id":"MDQ6VXNlcjMxNjc1NDgx","avatar_url":"https://avatars.githubusercontent.com/u/31675481?v=4","gravatar_id":"","url":"https://api.github.com/users/jenniferfell","html_url":"https://github.com/jenniferfell","followers_url":"https://api.github.com/users/jenniferfell/followers","following_url":"https://api.github.com/users/jenniferfell/following{/other_user}","gists_url":"https://api.github.com/users/jenniferfell/gists{/gist_id}","starred_url":"https://api.github.com/users/jenniferfell/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jenniferfell/subscriptions","organizations_url":"https://api.github.com/users/jenniferfell/orgs","repos_url":"https://api.github.com/users/jenniferfell/repos","events_url":"https://api.github.com/users/jenniferfell/events{/privacy}","received_events_url":"https://api.github.com/users/jenniferfell/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-06-07T17:25:11Z","updated_at":"2018-06-07T17:25:11Z","body":"Thank you for reaching out to us. What I see on my desktop with Chrome appears to behave as designed. \r\n\r\nThe masthead items at the top (features, docs, etc.) are the primary navigation for the site. When you are on the home screen https://angular.io, you are at the top of the site, so these top items are the only navigation displayed. The screen shot that you include is what you should see. I see the same thing on Chrome at all widths. \r\n\r\nOnly the Docs subarea (https://angular.io/docs) offers additional subnavigation on the left side. When the browser is narrow, the left navigation collapses so you can read the main body text. You can reopen the navigation from the collapsed navigation menu at the top left by the Angular logo. \r\n\r\n![nav-menu-collapsed](https://user-images.githubusercontent.com/31675481/41115508-f690f5f8-6a44-11e8-8e6f-dd26cabba844.png)\r\n\r\nDoes this explanation make sense? Does this address your question or concern? Or did I misunderstand?\r\n\r\n\r\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/comments/395500735/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"jenniferfell","id":31675481,"node_id":"MDQ6VXNlcjMxNjc1NDgx","avatar_url":"https://avatars.githubusercontent.com/u/31675481?v=4","gravatar_id":"","url":"https://api.github.com/users/jenniferfell","html_url":"https://github.com/jenniferfell","followers_url":"https://api.github.com/users/jenniferfell/followers","following_url":"https://api.github.com/users/jenniferfell/following{/other