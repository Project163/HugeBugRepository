int to recover\r\n```\r\n\r\nAnd I get this error on tests : \r\n```\r\nTestInstanceFactory [io.quarkus.test.junit.QuarkusTestExtension] failed to instantiate test class [org.acme.ExampleResourceTest]: For input string: \"${PORT:8080}\"\r\n```\r\n\r\n**To Reproduce**\r\nSteps to reproduce the behavior:\r\n1. Create an app \r\n2. Add quarkus.http.port=${PORT:8080} to the application.properties\r\n3. package or start","closed_by":{"login":"dmlloyd","id":124581,"node_id":"MDQ6VXNlcjEyNDU4MQ==","avatar_url":"https://avatars.githubusercontent.com/u/124581?v=4","gravatar_id":"","url":"https://api.github.com/users/dmlloyd","html_url":"https://github.com/dmlloyd","followers_url":"https://api.github.com/users/dmlloyd/followers","following_url":"https://api.github.com/users/dmlloyd/following{/other_user}","gists_url":"https://api.github.com/users/dmlloyd/gists{/gist_id}","starred_url":"https://api.github.com/users/dmlloyd/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dmlloyd/subscriptions","organizations_url":"https://api.github.com/users/dmlloyd/orgs","repos_url":"https://api.github.com/users/dmlloyd/repos","events_url":"https://api.github.com/users/dmlloyd/events{/privacy}","received_events_url":"https://api.github.com/users/dmlloyd/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/5192/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/quarkusio/quarkus/issues/5192/timeline","performed_via_github_app":null,"state_reason":"completed"}