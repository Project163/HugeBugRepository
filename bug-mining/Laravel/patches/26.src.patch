+            'date_field' => '2019-10',
+            'datetime_field' => '2019-10-01 10:15:20',
+            'immutable_date_field' => '2019-10-01',
+            'immutable_datetime_field' => '2019-10-01 10:15',
+        ]);
+
+        $expected = [
+            'date_field' => '2019-10',
+            'datetime_field' => '2019-10 10:15',
+            'immutable_date_field' => '2019-10',
