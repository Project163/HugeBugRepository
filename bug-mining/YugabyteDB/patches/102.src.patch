+void VerifyFlushedFrontier(const UserFrontierPtr& frontier, OpId* op_id) {
+  ASSERT_TRUE(frontier);
+  if (frontier) {
+    *op_id = down_cast<docdb::ConsensusFrontier*>(frontier.get())->op_id();
+    ASSERT_GT(op_id->term, 0);
+    ASSERT_GT(op_id->index, 0);
+  }
