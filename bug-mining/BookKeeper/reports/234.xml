<item>
            <title>[BOOKKEEPER-567] ReadOnlyBookieTest hangs on shutdown</title>
                <link>https://issues.apache.org/jira/browse/BOOKKEEPER-567</link>
                <project id="12311293" key="BOOKKEEPER">Bookkeeper</project>
                    <description>&lt;p&gt;ReadOnlyBookieTest hangs on shutdown. It occurs when I run bookie tests.&lt;/p&gt;</description>
                <environment></environment>
        <key id="12631576">BOOKKEEPER-567</key>
