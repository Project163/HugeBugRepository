lastic/elasticsearch.git","svn_url":"https://github.com/elastic/elasticsearch","homepage":"https://www.elastic.co/products/elasticsearch","size":1565901,"stargazers_count":76300,"watchers_count":76300,"language":"Java","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":25807,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":5586,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["elasticsearch","java","search-engine"],"visibility":"public","forks":25807,"open_issues":5586,"watchers":76300,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/elastic/elasticsearch/pulls/72170","html_url":"https://github.com/elastic/elasticsearch/pull/72170","diff_url":"https://github.com/elastic/elasticsearch/pull/72170.diff","patch_url":"https://github.com/elastic/elasticsearch/pull/72170.patch","merged_at":"2021-04-27T06:45:06Z"},"body":"A scheduled runnable can get reset to null while it is supposed to get\r\nrescheduled, this change adds a local variable, that way a background \r\nchange does not result in a NPE. \r\nNote: the runable uses RunOnce(secured by atomics) to ensure single execution\r\n\r\nfixes #72066\r\n\r\nNote: The reason why we haven't see this issue before:\r\n\r\n - it only happens if throttling is used\r\n - delayed execution only kicks in, if delay > `10ms`, the NPE only happens if the machine runs super slow, normally `10ms` is more than enough\r\n - even if the NPE happens, it gets catched and transform goes into a retry loop, so in order to completely fail it has to run into the NPE 10 times in a row, which is extremely unlikely\r\n   - otherwise you only see it in logs, which is how this has been found ","reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/72170/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/elastic/elasticsearch/issues/72170/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":4648906296,"node_id":"MDExOkNsb3NlZEV2ZW50NDY0ODkwNjI5Ng==","url":"https://api.github.com/repos/elastic/elasticsearch/issues/events/4648906296","actor":{"login":"hendrikmuhs","id":7126422,"node_id":"MDQ6VXNlcjcxMjY0MjI=","avatar_url":"https://avatars.githubusercontent.com/u/7126422?v=4","gravatar_id":"","url":"https://api.github.com/users/hendrikmuhs","html_url":"https://github.com/hendrikmuhs","followers_url":"https://api.github.com/users/hendrikmuhs/followers","following_url":"https://api.github.com/users/hendrikmuhs/following{/other_user}","gists_url":"https://api.github.com/users/hendrikmuhs/gists{/gist_id}","starred_url":"https://api.github.com/users/hendrikmuhs/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hendrikmuhs/subscriptions","organizations_url":"https://api.github.com/users/hendrikmuhs/orgs","repos_url":"https://api.github.com/users/hendrikmuhs/repos","events_url":"https://api.github.com/users/hendrikmuhs/events{/privacy}","received_events_url":"https://api.github.com/users/hendrikmuhs/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2021-04-27T06:45:06Z","state_reason":null,"performed_via_github_app":null},{"id":4648906726,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDQ2NDg5MDY3MjY=","url":"https://api.github.com/repos/elastic/elasticsearch/issues/events/4648906726","actor":{"login":"hendrikmuhs","id":7126422,"node_id":"MDQ6VXNlcjcxMjY0MjI=","avatar_url":"https://avatars.githubusercontent.com/u/7126422?v=4","gravatar_id":"