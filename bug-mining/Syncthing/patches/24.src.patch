diff --git a/cmd/syncthing/normalize.go b/cmd/syncthing/normalize.go
new file mode 100644
index 000000000..ccedaccd4
--- /dev/null
+++ b/cmd/syncthing/normalize.go
@@ -0,0 +1,11 @@
+//+build !darwin
+
+package main
+
+import "code.google.com/p/go.text/unicode/norm"
+
+// FSNormalize returns the string with the required unicode normalization for
+// the host operating system.
+func FSNormalize(s string) string {
+	return norm.NFC.String(s)
+}
