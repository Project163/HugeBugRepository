,"has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"While updating json documents, users might specify multiple updates as follows:\r\n\r\nUPDATE foo SET c2->'a'->'b'->'c' = '1', c2->'x'->'y'->'z' = '2', .... WHERE .....\r\n\r\nIn such cases currently, we deserialize and serialize the jsonb for each update to the same column. If there are a lot of such updates in the same UPDATE statement, this would be pretty expensive.\r\n\r\nAn optimization would be to accumulate all the json updates to the same column and perform all the updates together.","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/319/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/319/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]