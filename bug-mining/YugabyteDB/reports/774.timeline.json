hub.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Jira Link: [DB-3914](https://yugabyte.atlassian.net/browse/DB-3914)\r\n### Description\r\n\r\nAll the handler_latency metrics on both ports 12000 and 9000 are missing the quantile metrics — i.e. for every variant of handler_latency-* I see only the _sum and _count metrics in the metrics output by tserver.\r\n\r\nThis has been reproduced on our internal portal environment. \r\nWe can see the YCQL P99 metric graph for this universe: \r\nhttps://portal.dev.yugabyte.com/universes/25bb1fc6-d74c-41ec-afa0-b0b331bdecc8/metrics\r\nbut not for this one: \r\nhttps://portal.dev.yugabyte.com/universes/2965792c-f913-4c14-89ba-22dac0e5751a/metrics\r\n\r\nIn general, we see the metrics are missing from many clusters 2.13 and newer. This looks like a regression!\r\n\r\nInternal slack thread: https://yugabyte.slack.com/archives/C4K1838GL/p1664466730801269","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/14531/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/14531/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]