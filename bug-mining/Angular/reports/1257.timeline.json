.github.com/users/AndrewKushnir/orgs","repos_url":"https://api.github.com/users/AndrewKushnir/repos","events_url":"https://api.github.com/users/AndrewKushnir/events{/privacy}","received_events_url":"https://api.github.com/users/AndrewKushnir/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2020-08-26T18:22:00Z","label":{"name":"state: confirmed","color":"5ce05c"},"performed_via_github_app":null},{"id":3696068224,"node_id":"MDEyOkxhYmVsZWRFdmVudDM2OTYwNjgyMjQ=","url":"https://api.github.com/repos/angular/angular/issues/events/3696068224","actor":{"login":"AndrewKushnir","id":43554145,"node_id":"MDQ6VXNlcjQzNTU0MTQ1","avatar_url":"https://avatars.githubusercontent.com/u/43554145?v=4","gravatar_id":"","url":"https://api.github.com/users/AndrewKushnir","html_url":"https://github.com/AndrewKushnir","followers_url":"https://api.github.com/users/AndrewKushnir/followers","following_url":"https://api.github.com/users/AndrewKushnir/following{/other_user}","gists_url":"https://api.github.com/users/AndrewKushnir/gists{/gist_id}","starred_url":"https://api.github.com/users/AndrewKushnir/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AndrewKushnir/subscriptions","organizations_url":"https://api.github.com/users/AndrewKushnir/orgs","repos_url":"https://api.github.com/users/AndrewKushnir/repos","events_url":"https://api.github.com/users/AndrewKushnir/events{/privacy}","received_events_url":"https://api.github.com/users/AndrewKushnir/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2020-08-26T18:22:00Z","label":{"name":"type: bug/fix","color":"EEEEEE"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/angular/angular/issues/comments/685950715","html_url":"https://github.com/angular/angular/issues/38587#issuecomment-685950715","issue_url":"https://api.github.com/repos/angular/angular/issues/38587","id":685950715,"node_id":"MDEyOklzc3VlQ29tbWVudDY4NTk1MDcxNQ==","user":{"login":"mhombach","id":34406120,"node_id":"MDQ6VXNlcjM0NDA2MTIw","avatar_url":"https://avatars.githubusercontent.com/u/34406120?v=4","gravatar_id":"","url":"https://api.github.com/users/mhombach","html_url":"https://github.com/mhombach","followers_url":"https://api.github.com/users/mhombach/followers","following_url":"https://api.github.com/users/mhombach/following{/other_user}","gists_url":"https://api.github.com/users/mhombach/gists{/gist_id}","starred_url":"https://api.github.com/users/mhombach/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mhombach/subscriptions","organizations_url":"https://api.github.com/users/mhombach/orgs","repos_url":"https://api.github.com/users/mhombach/repos","events_url":"https://api.github.com/users/mhombach/events{/privacy}","received_events_url":"https://api.github.com/users/mhombach/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-09-02T19:30:44Z","updated_at":"2020-09-02T19:30:44Z","body":"I dived into the code, debugged and i found the problem, but I am not 100% which part should be changed because i have 0 knowledge in the angular internal mechanisms. So i am describing my findings here. Maybe some of you have already a solution in mind.\r\n\r\nI very slightly adjusted the repo mention in the description: I changed the SCSS code of the app-component to the following:\r\n```css\r\n@import url('https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap');\r\n\r\ndiv {\r\n    color: red;\r\n}\r\n```\r\n## Findings\r\nThe problem lies in the `compiler.umd.js` file ( @angular/compiler/bundles).\r\nThere you can find the following line.\r\n```js\r\nfunction processRules(input, ruleCallback) {\r\n```\r\nThis stringreplace-function receives the full SCSS string and applies `escapeBlocks(input)` on it, which produces the following object;\r\n```js\r\nStringWithEscapedBlocks {\r\n  escapedString: '@import url(\"https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap\");\\n' +\r\n    'div {%BLOCK%}\\n',\r\n  blocks: [ '\\n  color: red;\\n' ]\r\n}\r\n```\r\nSo far the import-line is still correct.\r\nNow the following regex  is applied on it:\r\n```\r\n/(\\s*)([^;\\{\\}]+?)(\\s*)((?:{%BLOCK%}?\\s*;?)|(?:\\s*;))/g\r\n```\r\n\r\nThis regex splits the import-line wrongly. It generates the following pieces:\r\n\r\n- `@import url(\"https://fonts.googleapis.com/css2?family=Roboto:wght@400;`\r\n- `500;`\r\n- `700&display=swap\");`\r\n- `\\ndiv {%BLOCK%}\\n`\r\n\r\nYes, my first intuition was that the regex has some problem.\r\nBut on my way of finding this regex, i passed through the `ShadowCss.prototype._scopeSelectors` function (which internally then calls the `processRules`-function).\r\nIn this function there are several checks and actions on substrings like\r\n- `@`\r\n- `@media`\r\n- `@supports`\r\n- `@page`\r\n- `@document`\r\n\r\nSo my guess is that those are kind of exceptions so that those rules are not processed the same way as \"normal\" rules so they maybe don't get corrupted?\r\nBut the context of this extra-checking is the **callback** of the `processRules`-function so the order of execution is:\r\n1. apply `processRules()`, which corrupts the import-line by the regex\r\n2. do some checking if the rule starts with `@something`\r\n\r\nSo my theory of having some pre-checking there is wrong i guess.\r\n\r\nSo this would only leave my initial guess that it is correct that the regex is applied to **every** rule but there is some bug in the regex itself which breaks certain import-lines apart (the rest of the logic then treats each segment as css-rule and so makes wrong followup-errors based on those segments).\r\n\r\nI'm not good enough at regex to fix this sadly.\r\nAlso i am wondering if it might be maybe a better approach to exclude lines starting with `@import` from the beginning, because there is no reason, im my eyes, to modify those lines **ever**.\r\n\r\nMaybe one of the more angular-experienced devs can enlighten me here :)\r\n\r\nI hope that this finding is helpfull.\r\n\r\nRegarding the severity of this bug i was having thoughts, because it seems that this bug is existing since multiple major-versions and i have a gut feeling that there are some angular-applications out there where fonts can't be loaded because of this bug but the devs are not checking the network-log but only the console log and so maybe don't even realize that they are using slightly wrong fonts :/","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/comments/685950715/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"mhombach","id":34406120,"node_id":"MDQ6VXNlcjM0NDA2MTIw","avatar_url":"https://avatars.githubusercontent.com/u/34406120?v=4","gravatar_id":"","url":"https://api.github.com/users/mhombach","html_url":"https://github.com/mhombach","followers_url":"https://api.github.com/users/mhombach/followers","following_url":"https://api.github.com/users/mhombach/following{/other_user}","gists_url":"https://api.github.com/users/mhombach/gists{/gist_id}","starred_url":"https://api.github.com/users/mhombach/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mhombach/subscriptions","organizations_url":"https://api.github.com/users/mhombach/orgs","repos_url":"https://api.github.com/users/mhombach/repos","events_url":"https://api.github.com/users/mhombach/events{/privacy}","received_events_url":"https://api.github.com/users/mhombach/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":3731121236,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDM3MzExMjEyMzY=","url":"https://api.github.com/repos/angular/angular/issues/events/37311212