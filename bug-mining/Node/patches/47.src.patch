             lastCommonSep = 3;
@@ -1300,16 +1300,26 @@ const posix = {
     var i = 0;
     for (; i <= length; ++i) {
       if (i === length) {
-        if (lastCommonSep === -1) {
-          lastCommonSep = i;
-        } else if (toLen > length && to.charCodeAt(i + 1) === 47/*/*/) {
-          // We get here if `from` is the exact base path for `to`.
