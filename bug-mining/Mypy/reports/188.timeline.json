users/gvanrossum/subscriptions","organizations_url":"https://api.github.com/users/gvanrossum/orgs","repos_url":"https://api.github.com/users/gvanrossum/repos","events_url":"https://api.github.com/users/gvanrossum/events{/privacy}","received_events_url":"https://api.github.com/users/gvanrossum/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"milestoned","commit_id":null,"commit_url":null,"created_at":"2016-04-28T18:14:19Z","milestone":{"title":"0.4.x"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/python/mypy/issues/comments/220641619","html_url":"https://github.com/python/mypy/issues/1432#issuecomment-220641619","issue_url":"https://api.github.com/repos/python/mypy/issues/1432","id":220641619,"node_id":"MDEyOklzc3VlQ29tbWVudDIyMDY0MTYxOQ==","user":{"login":"rwbarton","id":22628,"node_id":"MDQ6VXNlcjIyNjI4","avatar_url":"https://avatars.githubusercontent.com/u/22628?v=4","gravatar_id":"","url":"https://api.github.com/users/rwbarton","html_url":"https://github.com/rwbarton","followers_url":"https://api.github.com/users/rwbarton/followers","following_url":"https://api.github.com/users/rwbarton/following{/other_user}","gists_url":"https://api.github.com/users/rwbarton/gists{/gist_id}","starred_url":"https://api.github.com/users/rwbarton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rwbarton/subscriptions","organizations_url":"https://api.github.com/users/rwbarton/orgs","repos_url":"https://api.github.com/users/rwbarton/repos","events_url":"https://api.github.com/users/rwbarton/events{/privacy}","received_events_url":"https://api.github.com/users/rwbarton/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-05-20T15:42:21Z","updated_at":"2016-05-20T15:42:21Z","body":"This diff fixes this issue:\n\n``` diff\n--- a/mypy/checkmember.py\n+++ b/mypy/checkmember.py\n@@ -237,6 +237,10 @@ def check_method_type(functype: FunctionLike, itype: Instance, is_classmethod: b\n         elif not is_classmethod:\n             # Check that self argument has type 'Any' or valid instance type.\n             selfarg = item.arg_types[0]\n+            # If this is a method of a tuple class, correct for the fact that\n+            # we passed to typ.fallback in analyze_member_access.\n+            if isinstance(selfarg, TupleType):\n+                selfarg = selfarg.fallback\n             if not subtypes.is_equivalent(selfarg, itype):\n                 msg.invalid_method_type(item, context)\n         else:\n```\n\nBut it's awkward that we have both `Tuple[int, float, fallback=Derived]` and `Derived` as distinct types. Maybe `is_equivalent` should consider them equivalent? I'm not sure I totally understand the design around NamedTuple types.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/220641619/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"rwbarton","id":22628,"node_id":"MDQ6VXNlcjIyNjI4","avatar_url":"https://avatars.githubusercontent.com/u/22628?v=4","gravatar_id":"","url":"https://api.github.com/users/rwbarton","html_url":"https://github.com/rwbarton","followers_url":"https://api.github.com/users/rwbarton/followers","following_url":"https://api.github.com/users/rwbarton/following{/other_user}","gists_url":"https://api.github.com/users/rwbarton/gists{/gist_id}","starred_url":"https://api.github.com/users/rwbarton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rwbarton/subscriptions","organizations_url":"https://api.github.com/users/rwbarton/orgs","repos_url":"https://api.github.com/users/rwbarton/repos","events_url":"https://api.github.com/users/rwbarton/events{/privacy}","received_events_url":"https://api.github.com/users/rwbarton/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/python/mypy/issues/comments/220652108","html_url":"https://github.com/python/mypy/issues/1432#issuecomment-220652108","issue_url":"https://api.github.com/repos/python/mypy/issues/1432","id":220652108,"node_id":"MDEyOklzc3VlQ29tbWVudDIyMDY1MjEwOA==","user":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-05-20T16:22:19Z","updated_at":"2016-05-20T16:22:19Z","body":"`Tuple[int, float, fallback=Derived]` is the actual named tuple type, which approximates an intersection of an `Instance` (`Derived`) and the special features of the corresponding tuple type. This is not entirely true as the tuple type features take precedence over `Instance` features when there is ambiguity.\n\n`Tuple[...]` itself, if we ignore the fallback, only provides a few tuple-specific magic features such as `t[n]` where `n` is an integer literal. When these features aren't important we can safely fall back to the fallback instance type.\n\nYour diff seems right, as there is conceptually a one-to-one mapping between `Tuple[int, float, fallback=Derived]` and `Derived`. They aren't equivalent but one can't normally exist without the other, except in intermediate steps within the type checker, as seems to be the case here.\n","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/220652108/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false}},{"actor":{"login":"rwbarton","id":22628,"node_id":"MDQ6VXNlcjIyNjI4","avatar_url":"https://avatars.githubusercontent.com/u/22628?v=4","gravatar_id":"","url":"https://api.github.com/users/rwbarton","html_url":"https://github.com/rwbarton","followers_url":"https://api.github.com/users/rwbarton/followers","following_url":"https://api.github.com/users/rwbarton/following{/other_user}","gists_url":"https://api.github.com/users/rwbarton/gists{/gist_id}","starred_url":"https://api.github.com/users/rwbarton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rwbarton/subscriptions","organizations_url":"https://api.github.com/users/rwbarton/orgs","re