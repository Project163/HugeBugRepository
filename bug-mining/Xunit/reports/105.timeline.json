github.com/users/bradwilson/events{/privacy}","received_events_url":"https://api.github.com/users/bradwilson/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"cab6a3e275d3bd4ed4d567110079e2133bac2fc4","commit_url":"https://api.github.com/repos/xunit/xunit/commits/cab6a3e275d3bd4ed4d567110079e2133bac2fc4","created_at":"2024-01-28T22:42:14Z","performed_via_github_app":null},{"id":11621085278,"node_id":"REFE_lADOAJbtsc59LmcZzwAAAAK0q7Be","url":"https://api.github.com/repos/xunit/xunit/issues/events/11621085278","actor":{"login":"bradwilson","id":16944,"node_id":"MDQ6VXNlcjE2OTQ0","avatar_url":"https://avatars.githubusercontent.com/u/16944?v=4","gravatar_id":"","url":"https://api.github.com/users/bradwilson","html_url":"https://github.com/bradwilson","followers_url":"https://api.github.com/users/bradwilson/followers","following_url":"https://api.github.com/users/bradwilson/following{/other_user}","gists_url":"https://api.github.com/users/bradwilson/gists{/gist_id}","starred_url":"https://api.github.com/users/bradwilson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bradwilson/subscriptions","organizations_url":"https://api.github.com/users/bradwilson/orgs","repos_url":"https://api.github.com/users/bradwilson/repos","events_url":"https://api.github.com/users/bradwilson/events{/privacy}","received_events_url":"https://api.github.com/users/bradwilson/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"afc2a79262504f267efe6941a2038457d0c68bee","commit_url":"https://api.github.com/repos/xunit/xunit/commits/afc2a79262504f267efe6941a2038457d0c68bee","created_at":"2024-01-28T22:42:19Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/xunit/xunit/issues/comments/1913750433","html_url":"https://github.com/xunit/xunit/issues/2871#issuecomment-1913750433","issue_url":"https://api.github.com/repos/xunit/xunit/issues/2871","id":1913750433,"node_id":"IC_kwDOAJbtsc5yEYOh","user":{"login":"bradwilson","id":16944,"node_id":"MDQ6VXNlcjE2OTQ0","avatar_url":"https://avatars.githubusercontent.com/u/16944?v=4","gravatar_id":"","url":"https://api.github.com/users/bradwilson","html_url":"https://github.com/bradwilson","followers_url":"https://api.github.com/users/bradwilson/followers","following_url":"https://api.github.com/users/bradwilson/following{/other_user}","gists_url":"https://api.github.com/users/bradwilson/gists{/gist_id}","starred_url":"https://api.github.com/users/bradwilson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bradwilson/subscriptions","organizations_url":"https://api.github.com/users/bradwilson/orgs","repos_url":"https://api.github.com/users/bradwilson/repos","events_url":"https://api.github.com/users/bradwilson/events{/privacy}","received_events_url":"https://api.github.com/users/bradwilson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-01-28T23:00:14Z","updated_at":"2024-01-28T23:02:06Z","body":"Figured it out. The formatting of the error in the new message leaves out the stack trace from the error. The older assertion library didn't format the error, so it's just one big stack trace.\r\n\r\nWith a simplified test:\r\n\r\n```csharp\r\n[Fact]\r\npublic void TestMethod()\r\n{\r\n\tvar list = new[] { true, false };\r\n\r\n\tAssert.Collection(\r\n\t\tlist,\r\n\t\tx => Assert.True(x),\r\n\t\tx => Assert.True(x)\r\n\t);\r\n}\r\n```\r\n\r\nHere's the output from `2.4.2`: (includes the lambda on line 15)\r\n\r\n![image](https://github.com/xunit/xunit/assets/16944/cd52d6c1-1c98-4539-86df-c7829221e607)\r\n\r\nHere's the output from `2.5.0`: (does not include the lambda)\r\n\r\n![image](https://github.com/xunit/xunit/assets/16944/022a8fb1-04c2-4a50-8171-f2f3f564ff82)\r\n\r\nHere's the output from `2.6.7-pre.8`: (includes the lambda) https://xunit.net/docs/using-ci-builds\r\n\r\n![image](https://github.com/xunit/xunit/assets/16944/303ab4d8-f9c9-4110-b215-9c1b0c8e9854)\r\n\r\nThe inner stack trace is now printed below the error message, which includes the failure line of the lambda. It looks slightly different because of the way stack traces are filtered by the console runner, which doesn't see the inner stack trace as an actual stack trace; it's part of the message.\r\n\r\nVSTest (aka `dotnet test`) looks different as well, but in a different way:\r\n\r\n![image](https://github.com/xunit/xunit/assets/16944/f2e5edd5-73d9-4c77-890f-a763f73ef0ef)\r\n\r\nI experimented with a few different ways to display the information, and although the filename format is different across runners, this still seemed like the cleanest way to present the information.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/xunit/xunit/issues/comments/1913750433/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"bradwilson","id":16944,"node_id":"MDQ6VXNlcjE2OTQ0","avatar_url":"https://avatars.githubusercontent.com/u/16944?v=4","gravatar_id":"","url":"https://api.github.com/users/bradwilson","html_url":"https://github.com/bradwilson","followers_url":"https://api.github.com/users/bradwilson/followers","following_url":"https://api.github.com/users/bradwilson/following{/other_user}","gists_url":"https://api.github.com/users/bradwilson/gists{/gist_id}","starred_url":"https://api.github.com/users/bradwilson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bradwilson/subscriptions","organizations_url":"https://api.github.com/users/bradwilson/orgs","repos_url":"https://api.github.com/users/bradwilson/repos","events_url":"https://api.github.com/users/bradwilson/events{/privacy}","received_events_url":"https://api.github.com/users/bradwilson/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1