-        HChannel hChannel;
-        if (OperationType.PUBLISH.equals(pubSubData.operationType) ||
-            OperationType.UNSUBSCRIBE.equals(pubSubData.operationType)) {
-            hChannel = createAndStoreNonSubscriptionChannel(channel);
-        } else {
