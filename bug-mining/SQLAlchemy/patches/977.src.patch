             "CREATE SEQUENCE [SCHEMA_foo].s2 START WITH 1",
             schema_translate_map=schema_translate_map,
         )
 
+        self.assert_compile(
+            s2.next_value(),
+            "<next sequence value: [SCHEMA_foo].s2>",
