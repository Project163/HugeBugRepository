<item>
            <title>[IGNITE-5358] .NET: Nullable enum field in binary object causes type cast exception</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-5358</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;Reproducer:&lt;/p&gt;

&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;&lt;span class=&quot;code-keyword&quot;&gt;enum&lt;/span&gt; TestEnum
{
	TestValue1,
	TestValue2
};

&lt;span class=&quot;code-keyword&quot;&gt;class &lt;/span&gt;TestClass
{
	&lt;span class=&quot;code-keyword&quot;&gt;public&lt;/span&gt; string Name { get; }
	&lt;span class=&quot;code-keyword&quot;&gt;public&lt;/span&gt; TestEnum? EnumValue { get; }

	&lt;span class=&quot;code-keyword&quot;&gt;public&lt;/span&gt; TestClass(string name, TestEnum? enumValue)
	{
		Name = name;
		EnumValue = enumValue;
	}
}
...

cache.Put(&lt;span class=&quot;code-quote&quot;&gt;&quot;TestElem1&quot;&lt;/span&gt;, &lt;span class=&quot;code-keyword&quot;&gt;new&lt;/span&gt; TestClass(&lt;span class=&quot;code-quote&quot;&gt;&quot;TestElem1&quot;&lt;/span&gt;, TestEnum.TestValue1));
cache.Get(&lt;span class=&quot;code-quote&quot;&gt;&quot;TestElem1&quot;&lt;/span&gt;);  &lt;span class=&quot;code-comment&quot;&gt;// exception&lt;/span&gt;
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;Exception:&lt;/p&gt;
&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;No coercion &lt;span class=&quot;code-keyword&quot;&gt;operator&lt;/span&gt; is defined between types &lt;span class=&quot;code-quote&quot;&gt;&apos;Apache.Ignite.Core.Impl.Binary.BinaryEnum&apos;&lt;/span&gt; and &lt;span class=&quot;code-quote&quot;&gt;&apos;&lt;span class=&quot;code-object&quot;&gt;System&lt;/span&gt;.Nullable`1[UserQuery+TestEnum]&apos;&lt;/span&gt;. 
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</description>
