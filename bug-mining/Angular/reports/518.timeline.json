[{"url":"https://api.github.com/repos/angular/angular/issues/comments/317633257","html_url":"https://github.com/angular/angular/issues/18314#issuecomment-317633257","issue_url":"https://api.github.com/repos/angular/angular/issues/18314","id":317633257,"node_id":"MDEyOklzc3VlQ29tbWVudDMxNzYzMzI1Nw==","user":{"login":"trotyl","id":6059170,"node_id":"MDQ6VXNlcjYwNTkxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/6059170?v=4","gravatar_id":"","url":"https://api.github.com/users/trotyl","html_url":"https://github.com/trotyl","followers_url":"https://api.github.com/users/trotyl/followers","following_url":"https://api.github.com/users/trotyl/following{/other_user}","gists_url":"https://api.github.com/users/trotyl/gists{/gist_id}","starred_url":"https://api.github.com/users/trotyl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/trotyl/subscriptions","organizations_url":"https://api.github.com/users/trotyl/orgs","repos_url":"https://api.github.com/users/trotyl/repos","events_url":"https://api.github.com/users/trotyl/events{/privacy}","received_events_url":"https://api.github.com/users/trotyl/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-07-25T05:27:31Z","updated_at":"2017-07-25T06:00:23Z","body":"Seems to be compiler-related, the last `<tr>` never exists in the View Definition:\r\n\r\n![image](https://user-images.githubusercontent.com/6059170/28556452-152c6d2c-7139-11e7-93ff-c8e42a57cb64.png)\r\n\r\nMade a minimal reproduction in [plunker here](https://plnkr.co/edit/2i5SVAjJFWgN77p9sedD?p=preview), the problem is not relevant to attribute selector.\r\n\r\nThis may be a parser bug, the wrong result can be observed in the [`Parser#build()`](https://github.com/angular/angular/blob/master/packages/compiler/src/ml_parser/parser.ts#L61) method: \r\n\r\n![image](https://user-images.githubusercontent.com/6059170/28557016-a058c604-713c-11e7-8a2a-b5093ff20341.png)\r\n\r\nAnd could be general for **using `requiredParents: true` element inside `<ng-container>`**, so that:\r\n\r\n```html\r\n<ng-container>\r\n  <col>\r\n</ng-container>\r\n<p>bar</p>\r\n```\r\n\r\nWould also have this problem.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/comments/317633257/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"trotyl","id":6059170,"node_id":"MDQ6VXNlcjYwNTkxNzA=","avatar_url":"https://avatars.githubusercontent.com/u/6059170?v=4","gravatar_id":"","url":"https://api.github.com/users/trotyl","html_url":"https://github.com/trotyl","followers_url":"https://api.github.com/users/trotyl/followers","following_url":"https://api.github.com/users/trotyl/following{/other_user}","gists_url":"https://api.github.com/users/trotyl/gists{/gist_id}","starred_url":"https://api.github.com/users/trotyl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/trotyl/subscriptions","organizations_url":"https://api.github.com/users/trotyl/orgs","repos_url":"https://api.github.com/users/trotyl/repos","events_url":"https://api.github.com/users/trotyl/events{/privacy}","received_events_url":"https://api.github.com/users/trotyl/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1178585023,"node_id":"MDEyOkxhYmVsZWRFdmVudDExNzg1ODUwMjM=","url":"https://api.github.com/repos/angular/angular/issues/events/1178585023","actor":{"login":"vicb","id":248818,"node_id":"MDQ6VXNlcjI0ODgxOA==","avatar_url":"https://avatars.githubusercontent.com/u/248818?v=4","gravatar_id":"","url":"https://api.github.com/users/vicb","html_url":"https://github.com/vicb","followers_url":"https://api.github.com/users/vicb/followers","following_url":"https://api.github.com/users/vicb/following{/other_user}","gists_url":"https://api.github.com/users/vicb/gists{/gist_id}","starred_url":"