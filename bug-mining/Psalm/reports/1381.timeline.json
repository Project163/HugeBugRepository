ub.com/users/TysonAndre/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TysonAndre/subscriptions","organizations_url":"https://api.github.com/users/TysonAndre/orgs","repos_url":"https://api.github.com/users/TysonAndre/repos","events_url":"https://api.github.com/users/TysonAndre/events{/privacy}","received_events_url":"https://api.github.com/users/TysonAndre/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"mentioned","commit_id":null,"commit_url":null,"created_at":"2021-09-06T11:34:41Z","performed_via_github_app":null},{"id":5260627311,"node_id":"SE_lADOBG8K98468n2fzwAAAAE5js1v","url":"https://api.github.com/repos/vimeo/psalm/issues/events/5260627311","actor":{"login":"TysonAndre","id":1904430,"node_id":"MDQ6VXNlcjE5MDQ0MzA=","avatar_url":"https://avatars.githubusercontent.com/u/1904430?v=4","gravatar_id":"","url":"https://api.github.com/users/TysonAndre","html_url":"https://github.com/TysonAndre","followers_url":"https://api.github.com/users/TysonAndre/followers","following_url":"https://api.github.com/users/TysonAndre/following{/other_user}","gists_url":"https://api.github.com/users/TysonAndre/gists{/gist_id}","starred_url":"https://api.github.com/users/TysonAndre/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TysonAndre/subscriptions","organizations_url":"https://api.github.com/users/TysonAndre/orgs","repos_url":"https://api.github.com/users/TysonAndre/repos","events_url":"https://api.github.com/users/TysonAndre/events{/privacy}","received_events_url":"https://api.github.com/users/TysonAndre/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2021-09-06T11:34:41Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/vimeo/psalm/issues/comments/913716730","html_url":"https://github.com/vimeo/psalm/issues/6439#issuecomment-913716730","issue_url":"https://api.github.com/repos/vimeo/psalm/issues/6439","id":913716730,"node_id":"IC_kwDOBG8K9842djX6","user":{"login":"TysonAndre","id":1904430,"node_id":"MDQ6VXNlcjE5MDQ0MzA=","avatar_url":"https://avatars.githubusercontent.com/u/1904430?v=4","gravatar_id":"","url":"https://api.github.com/users/TysonAndre","html_url":"https://github.com/TysonAndre","followers_url":"https://api.github.com/users/TysonAndre/followers","following_url":"https://api.github.com/users/TysonAndre/following{/other_user}","gists_url":"https://api.github.com/users/TysonAndre/gists{/gist_id}","starred_url":"https://api.github.com/users/TysonAndre/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TysonAndre/subscriptions","organizations_url":"https://api.github.com/users/TysonAndre/orgs","repos_url":"https://api.github.com/users/TysonAndre/repos","events_url":"https://api.github.com/users/TysonAndre/events{/privacy}","received_events_url":"https://api.github.com/users/TysonAndre/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-09-06T15:08:43Z","updated_at":"2021-09-06T15:08:43Z","body":"I think my change only affected the sealed array (TKeyedArray, i.e. array literals) and not the branch being referred to, but I may be mistaken\r\n\r\nBut my change still introduced a bug. For now, the conservative approach of returning the empty array for non-literals would avoid the false positives at the cost of not inferring types.\r\n\r\n```php\r\nfunction contains2(string $a, string $b, $element): void\r\n{\r\n    if (in_array($element, [$a], true)) {\r\n    } elseif (in_array($element, [$b], true)) { // false positive Condition ($element is string) contradicts a previously-established condition ($element is not string)\r\n    }\r\n}\r\n```\r\n\r\nThe code for handling strict equality in AssertionFinder::scrapeEqualityAssertions may be of use.\r\n\r\nUnfortunately,\r\n- The example only works for union types with a single type (literal or non-literal)\r\n- The isSingle check seems to be related to union types only working for getAssertionString with a single type\r\n- `$var_type->getAssertionString() !== $assertion` for atomic types seems useful in avoiding redundant condition warnings, but not paradoxical condition warnings. Type\\Union::getAssertionString won't work for variables with more than one type, it only works for union types of a single type, which is why I see isSingle checks elsewhere\r\n- Not sure why that code in scrapeEqualityAssertions is using `~` for approximate equality. Possibly a bug or workaround. Seems to be used in AssertionReconciler::reconcile(). Probably, it's so that negated the condition such as `if ($var === $otherString)` in the else branch isn't treated as a non-string, which happened when I tried to change it.\r\n\r\n  Changing it would do a better job of removing mixed, though\r\n- Not sure why getAssertionString() sometimes needs to be prefixed with `=` (strict equality) to be a valid assertion string. I'm guessing there might be special cases for `null` that aren't written for `=null`.\r\n\r\n```php\r\n                // both side of the Identical can be asserted to the intersection of both\r\n                $intersection_type = Type::intersectUnionTypes($var_type, $other_type, $codebase);\r\n\r\n                if ($intersection_type !== null && $intersection_type->isSingle()) {\r\n                    $assertion = $intersection_type->getAssertionString();\r\n\r\n                    $if_types = [];\r\n\r\n                    $var_name_left = ExpressionIdentifier::getArrayVarId(\r\n                        $conditional->left,\r\n                        $this_class_name,\r\n                        $source\r\n                    );\r\n\r\n                    if ($var_name_left &&\r\n                        (!$var_type->isSingle() || $var_type->getAssertionString() !== $assertion)) {\r\n                        $if_types[$var_name_left] = [['~'.$assertion]];\r\n                    }\r\n\r\n                    $var_name_right = ExpressionIdentifier::getArrayVarId(\r\n                        $conditional->right,\r\n                        $this_class_name,\r\n                        $source\r\n                    );\r\n\r\n                    if ($var_name_right &&\r\n                        (!$other_type->isSingle() || $other_type->getAssertionString() !== $assertion)) {\r\n                        $if_types[$var_name_right] = [['~'.$assertion]];\r\n                    }\r\n\r\n                    return $if_types ? [$if_types] : [];\r\n                }\r\n```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/comments/913716730/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"TysonAndre","id":1904430,"node_id":"MDQ6VXNlcjE5MDQ0MzA=","avatar_url":"https://avatars.githubusercontent.com/u/1904430?v=4","gravatar_id":"","url":"https://api.github.com/users/TysonAndre","html_url":"https://github.com/TysonAndre","followers_url":"https://api.github.com/users/TysonAndre/followers","following_url":"https://api.github.com/users/TysonAndre/following{/other_user}","gists_url":"https://api.github.com/users/TysonAndre/gists{/gist_id}","starred_url":"https://api.github.com/users/TysonAndre/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TysonAndre/subscriptions","organizations_url":"https://api.github.com/users/TysonAndre/orgs","repos_url":"https://api.github.com/users/TysonAndre/repos","events_url":"https://api.github.com/users/TysonAndre/events{/privacy}","received_events_url":"https://api.github.com/users/TysonAndre/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/vimeo/psalm/issues/comments/913771531","html_url":"https://github.com/vimeo/psalm/issues/6439#issuecomment-913771531","issue_url":"https://api.github.com/repos/vimeo/psalm/issues/6439","id":913771531,"node_id":"IC_kwDOBG8K9842dwwL","user":{"login":"TysonAndre","id":1904430,"node_id":"MDQ6VXNlcjE5MDQ0MzA=","avatar_url":"https://avatars.githubusercontent.com/u/1904430?v=4","gravatar_id":"","url":"https://api.github.com/users/TysonAndre","html_url":"https://github.com/TysonAndre","followers_url":"https://api.github.com/users/TysonAndre/followers","following_url":"https://api.github.com/users/TysonAndre/following{/other_user}","gists_url":"https://api.github.com/users/TysonAndre/gists{/gist_id}","starred_url":"https://api.github.com/users/TysonAndre/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TysonAndre/subscriptions","organizations_url":"https://api.github.com/users/TysonAndre/orgs","repos_url":"https://api.github.com/users/TysonAndre/repos","events_url":"https://api.github.com/users/TysonAndre/events{/privacy}","received_events_url":"https://api.github.com/users/TysonAndre/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-09-06T16:57:58Z","updated_at":"2021-09-06T16:57:58Z","body":"```patch\r\n--- a/src/Psalm/Internal/Algebra.php\r\n+++ b/src/Psalm/Internal/Algebra.php\r\n@@ -68,6 +68,10 @@ class Algebra\r\n         if ($type === 'mixed') {\r\n             return $type;\r\n         }\r\n+        if (substr($type, 0, 9) === 'in-array-') {\r\n+            // TODO: Return negation of the subset of literal types instead?\r\n+            return 'mixed';\r\n+        }\r\n \r\n         return $type[0] === '!' ? substr($type, 1) : '!' . $type;\r\n     }\r\n```\r\n\r\nThis approach sort of works for avoiding the original false positive for categories with multiple values such as `string`. I assume Type::parseType + filtering out single types such as TFalse would improve accuracy even more","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/comments/913771531/reactions","total_count"