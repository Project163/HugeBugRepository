as_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":4989,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":773,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["amqp","python","python-library","python3","queue-tasks","queue-workers","queued-jobs","redis","redis-queue","sqs","sqs-queue","task-manager","task-runner","task-scheduler"],"visibility":"public","forks":4989,"open_issues":773,"watchers":28268,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/celery/celery/pulls/6848","html_url":"https://github.com/celery/celery/pull/6848","diff_url":"https://github.com/celery/celery/pull/6848.diff","patch_url":"https://github.com/celery/celery/pull/6848.patch","merged_at":"2021-07-13T07:11:45Z"},"body":"\r\n*Note*: Before submitting this pull request, please review our [contributing\r\nguidelines](https://docs.celeryproject.org/en/master/contributing.html).\r\n\r\n## Description\r\nFixes #6828\r\n\r\nThe Donate button is not visible anywhere on the [https://docs.celeryproject.org/en/stable/](https://docs.celeryproject.org/en/stable/) site.\r\n\r\n## The Problem\r\n- The [Open Collective button.js script](https://opencollective.com/celery/donate/button.js) uses the color attribute to form `donate-button-<color>.svg` filenames.\r\n- This filename is used to form a URL e.g. https://opencollective.com/static/images/buttons/donate-button-blue.svg.\r\n- The URL is then used as the background image to the donate button.\r\n\r\nWhen `color=\"[white|green]\"` was used, the resulting filename, `donate-button-[white|green].svg`, could not be found (HTTP 404).\r\n\r\n## Solution\r\n[It appears that Open Collective only has static assets for \"blue\" and \"white\" donate buttons](https://github.com/opencollective/opencollective-frontend/tree/main/public/static/images/buttons).\r\n\r\nThis PR has currently set that color value to \"blue\" which looks like this.\r\n\r\n<img src=\"https://opencollective.com/static/images/buttons/donate-button-blue.svg\" />\r\n\r\nThe \"white\" alternative looks like this.\r\n\r\n<img src=\"https://opencollective.com/static/images/buttons/donate-button-white.svg\" />\r\n\r\nPlease let me know which one works better.\r\n\r\n<!-- Please describe your pull request.\r\n\r\nNOTE: All patches should be made against master, not a maintenance branch like\r\n3.1, 2.5, etc.  That is unless the bug is already fixed in master, but not in\r\nthat version series.\r\n\r\nIf it fixes a bug or resolves a feature request,\r\nbe sure to link to that issue via (Fixes #4412) for example.\r\n-->\r\n","reactions":{"url":"https://api.github.com/repos/celery/celery/issues/6848/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/celery/celery/issues/6848/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":5205161023,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDUyMDUxNjEwMjM=","url":"https://api.github.com/repos/celery/celery/issues/events/5205161023","actor":{"login":"jeyrce","id":33649388,"node_id":"MDQ6VXNlcjMzNjQ5Mzg4","avatar_url":"https://avatars.githubusercontent.com/u/33649388?v=4","gravatar_id":"","url":"https://api.github.com/users/jeyrce","html_url":"https://github.com/jeyrce","followers_url":"https://api.github.com/users/jeyrce/followers","following_url":"https://api.github.com/users/jeyrce/following{/other_user}","gists_url":"https://api.github.com/users/jeyrce/gists{/gist_id}","starred_url":"https://api.github.com/users/jeyrce/starred{/owner}{/repo}","subscriptions_url":"https://api.githu