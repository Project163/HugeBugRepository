&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;%pyspark
&lt;span class=&quot;code-keyword&quot;&gt;try&lt;/span&gt;:
    raise Exception(&lt;span class=&quot;code-quote&quot;&gt;&quot;Ok&quot;&lt;/span&gt;)
except Exception as e:
    print e
&lt;span class=&quot;code-keyword&quot;&gt;finally&lt;/span&gt;:
    print &lt;span class=&quot;code-quote&quot;&gt;&quot;Finally&quot;&lt;/span&gt;
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;%pyspark
data = sc.textFile(&lt;span class=&quot;code-quote&quot;&gt;&quot;/usr/share/dict/words&quot;&lt;/span&gt;)
count = 0
&lt;span class=&quot;code-keyword&quot;&gt;for&lt;/span&gt; data.map(lambda x: x) \
        .collect():
    count += 1
print count
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</comment>
