t.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":72,"state":"open","created_at":"2012-09-12T10:39:21Z","updated_at":"2020-01-05T13:48:31Z","due_on":null,"closed_at":null},"comments":4,"created_at":"2015-06-14T00:35:03Z","updated_at":"2015-07-24T00:12:48Z","closed_at":"2015-07-24T00:12:48Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"In glm/gtx/quaternion.inl, the function pow (reproduced below) provides incorrect results. For example, glm::pow(glm::quat(0,1,0,0), 1.0f) returns the quaternion (1, nan, nan, nan). A fix is provided below\n#### original function\n\ntemplate <typename T, precision P>\n    GLM_FUNC_QUALIFIER tquat<T, P> pow\n    (\n        tquat<T, P> const & x,\n        T const & y\n    )\n    {\n        if(abs(x.w) > (static_cast<T>(1) - epsilon<T>()))\n            return x;\n        T Angle = acos(y);\n        T NewAngle = Angle \\* y;\n        T Div = sin(NewAngle) / sin(Angle);\n        return tquat<T, P>(\n            cos(NewAngle),\n            x.x \\* Div,\n            x.y \\* Div,\n            x.z \\* Div);\n    }\n#### fixed function\n\ntemplate <typename T, glm::precision P>\n    GLM_FUNC_QUALIFIER tquat<T, P> pow\n    (\n        tquat<T, P> const & x,\n        T const & y\n    )\n    {\n            if(std::abs(x.w) > (static_cast<T>(1) - glm::epsilon<T>())) {\n            return x;\n        }\n        T Angle = acos(x.w);\n        T NewAngle = Angle \\* y;\n        T Div = sin(NewAngle) / sqrt(x.x_x.x + x.y_x.y + x.z*x.z);\n        return glm::tquat<T, P>(\n                            cos(NewAngle),\n                            x.x \\* Div,\n                            x.y \\* Div,\n                            x.z \\* Div);\n    }\n","closed_by":{"login":"Groovounet","id":367227,"node_id":"MDQ6VXNlcjM2NzIyNw==","avatar_url":"https://avatars.githubusercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/g-truc/glm/issues/346/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/g-truc/glm/issues/346/timeline","performed_via_github_app":null,"state_reason":"completed"}