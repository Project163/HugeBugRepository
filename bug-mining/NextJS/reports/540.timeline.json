:true,"is_template":false,"web_commit_signoff_required":false,"topics":["blog","browser","compiler","components","hybrid","nextjs","node","react","server-rendering","ssg","static","static-site-generator","universal","vercel"],"visibility":"public","forks":30029,"open_issues":3156,"watchers":136480,"default_branch":"canary","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/vercel/next.js/pulls/54948","html_url":"https://github.com/vercel/next.js/pull/54948","diff_url":"https://github.com/vercel/next.js/pull/54948.diff","patch_url":"https://github.com/vercel/next.js/pull/54948.patch","merged_at":"2023-09-03T20:31:48Z"},"body":"The original logic here was introduced to unblock client side navigations if a server action was in flight, however this introduced a bug where subsequent actions would fetch twice after navigation. \r\n\r\nThis was happening because the promise handling was in the wrong spot: previously this would potentially cause both the `then` callback to fire while simultaneously the action reducer would handle the result. Moving it to where we're first checking if there's a pending navigation will more reliably indicate if the action was resolved after we discarded it in the reducer.\r\n\r\nCloses NEXT-1589\r\nFixes #54746\r\n\r\n","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/54948/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vercel/next.js/issues/54948/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":10267279712,"node_id":"CE_lADOBC3Cis5vn7FezwAAAAJj-kFg","url":"https://api.github.com/repos/vercel/next.js/issues/events/10267279712","actor":{"login":"kodiakhq[bot]","id":49736102,"node_id":"MDM6Qm90NDk3MzYxMDI=","avatar_url":"https://avatars.githubusercontent.com/in/29196?v=4","gravatar_id"