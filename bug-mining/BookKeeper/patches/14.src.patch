-            JAVAFLAGS="-Dmode=sub -Dcount=$count -Dnpar=$npar -Dstart=$start $JAVAFLAGS" app "$@" >& ${outfile:-sub/sync-$sync-count-$count-npar-$npar-rep-$rep.out}
