-    private <T, E> Map<UUID, List<E>> call(Map<UUID, List<T>> params,
-        Function<List<T>, LongRunningProcessTask<List<E>>> taskSupplier, Consumer<Map<UUID, List<E>>> rollback,
-        boolean onlyIfNodeExists) {
