+class DefaultPanacheEntityToStringTest {
+    @Test
+    fun testDefaultToStringMethod() {
+        val myPanacheEntityWithId = MyPanacheEntity(2912L)
+        Assertions.assertEquals("MyPanacheEntity<2912>", myPanacheEntityWithId.toString())
