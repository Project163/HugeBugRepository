ub.com/users/ambv/followers","following_url":"https://api.github.com/users/ambv/following{/other_user}","gists_url":"https://api.github.com/users/ambv/gists{/gist_id}","starred_url":"https://api.github.com/users/ambv/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ambv/subscriptions","organizations_url":"https://api.github.com/users/ambv/orgs","repos_url":"https://api.github.com/users/ambv/repos","events_url":"https://api.github.com/users/ambv/events{/privacy}","received_events_url":"https://api.github.com/users/ambv/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"544ea9c217cad9459d7b60665db787e94b52f93d","commit_url":"https://api.github.com/repos/psf/black/commits/544ea9c217cad9459d7b60665db787e94b52f93d","created_at":"2020-05-08T12:56:25Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/psf/black/issues/comments/1073781713","html_url":"https://github.com/psf/black/issues/1183#issuecomment-1073781713","issue_url":"https://api.github.com/repos/psf/black/issues/1183","id":1073781713,"node_id":"IC_kwDOB3dpmM5AAJvR","user":{"login":"peterjc","id":63959,"node_id":"MDQ6VXNlcjYzOTU5","avatar_url":"https://avatars.githubusercontent.com/u/63959?v=4","gravatar_id":"","url":"https://api.github.com/users/peterjc","html_url":"https://github.com/peterjc","followers_url":"https://api.github.com/users/peterjc/followers","following_url":"https://api.github.com/users/peterjc/following{/other_user}","gists_url":"https://api.github.com/users/peterjc/gists{/gist_id}","starred_url":"https://api.github.com/users/peterjc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/peterjc/subscriptions","organizations_url":"https://api.github.com/users/peterjc/orgs","repos_url":"https://api.github.com/users/peterjc/repos","events_url":"https://api.github.com/users/peterjc/events{/privacy}","received_events_url":"https://api.github.com/users/peterjc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-03-21T11:26:59Z","updated_at":"2022-03-21T11:26:59Z","body":"(Reviewing this with black v22.1.0 now that the functionality is in a stable release)\r\n\r\nInput (with a hidden wrong assumption about the four spaces for indentation):\r\n\r\n```python\r\nif True:\r\n    # Pointless if-statement just for indentation here:\r\n    print(\"\\\r\n    \\nMESSAGE - printing a multi-line message to the user here as a single\\\r\n    \\nlong string literal taking multiple lines of Python source code.\")\r\n```\r\n\r\nWith black v22.1.0 (no change from when I opened this issue),\r\n\r\n```python\r\nif True:\r\n    # Pointless if-statement just for indentation here:\r\n    print(\r\n        \"\\\r\n    \\nMESSAGE - printing a multi-line message to the user here as a single\\\r\n    \\nlong string literal taking multiple lines of Python source code.\"\r\n    )\r\n```\r\n\r\nWith black v22.1.0 and ``--preview``:\r\n\r\n```python\r\nif True:\r\n    # Pointless if-statement just for indentation here:\r\n    print(\r\n        \"    \\nMESSAGE - printing a multi-line message to the user here as a single   \"\r\n        \" \\nlong string literal taking multiple lines of Python source code.\"\r\n    )\r\n```\r\n\r\nNote that the original really does mean the output lines have four trailing spaces! This is probably a common user error, a wrong assumption about how the line continuation ``\\`` is interpreted.\r\n\r\nThat means black with ``--preview`` highlights this error, and the author might then revise their code so something like this:\r\n\r\n```python\r\nif True:\r\n    # Pointless if-statement just for indentation here:\r\n    print(\r\n        \"\\nMESSAGE - printing a multi-line message to the user here as a single\"\r\n        \"\\nlong string literal taking multiple lines of Python source code.\"\r\n    )\r\n```\r\n\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/psf/black/issues/comments/1073781713/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"peterjc","id":63959,"node_id":"MDQ6VXNlcjYzOTU5","avatar_url":"https://avatars.githubusercontent.com/u/63959?v=4","gravatar_id":"","url":"https://api.github.com/users/peterjc","html_url":"https://github.com/peterjc","followers_url":"https://api.github.com/users/peterjc/followers","following_url":"https://api.github.com/users/peterjc/following{/other_user}","gists_url":"https://api.github.com/users/peterjc/gists{/gist_id}","starred_url":"https://api.github.com/users/peterjc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/peterjc/subscriptions","organizations_url":"https://api.github.com/users/peterjc/orgs","repos_url":"https://api.github.com/users/peterjc/repos","events_url":"https://api.github.com/users/peterjc/events{/privacy}","received_events_url":"https://api.github.com/users/peterjc/received_events","type":"User","user_view_type":"public","site_admin":false}}]