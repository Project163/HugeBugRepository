 controller that fetches the data for the JSON reply.\nIn this example: `/jobs/poll/<job_id>`\n\nwhere `<job_id>` specifies the 'job' that's being polled.\nI construct the URL with `Url->build()`\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/138319586/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"thpar","id":5950674,"node_id":"MDQ6VXNlcjU5NTA2NzQ=","avatar_url":"https://avatars.githubusercontent.com/u/5950674?v=4","gravatar_id":"","url":"https://api.github.com/users/thpar","html_url":"https://github.com/thpar","followers_url":"https://api.github.com/users/thpar/followers","following_url":"https://api.github.com/users/thpar/following{/other_user}","gists_url":"https://api.github.com/users/thpar/gists{/gist_id}","starred_url":"https://api.github.com/users/thpar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thpar/subscriptions","organizations_url":"https://api.github.com/users/thpar/orgs","repos_url":"https://api.github.com/users/thpar/repos","events_url":"https://api.github.com/users/thpar/events{/privacy}","received_events_url":"https://api.github.com/users/thpar/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/138407996","html_url":"https://github.com/cakephp/cakephp/issues/7360#issuecomment-138407996","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/7360","id":138407996,"node_id":"MDEyOklzc3VlQ29tbWVudDEzODQwNzk5Ng==","user":{"login":"markstory","id":24086,"node_id":"MDQ6VXNlcjI0MDg2","avatar_url":"https://avatars.githubusercontent.com/u/24086?v=4","gravatar_id":"","url":"https://api.github.com/users/markstory","html_url":"https://github.com/markstory","followers_url":"https://api.github.com/users/markstory/followers","following_url"