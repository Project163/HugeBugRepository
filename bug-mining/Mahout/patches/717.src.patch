-  val minusScalar: ReduceFuncScalar = (A, s) => A -= s
-  val scalarMinus: ReduceFuncScalar = (A, s) => s -=: A
-  val timesScalar: ReduceFuncScalar = (A, s) => A *= s
-  val divScalar: ReduceFuncScalar = (A, s) => A /= s
-  val scalarDiv: ReduceFuncScalar = (A, s) => s /=: A
