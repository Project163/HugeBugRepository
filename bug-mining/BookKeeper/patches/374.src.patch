-        Thread.sleep(1000);
-        messages.clear();
-        LOG.info("cleared messages, now sending the messages");
-
-        sendMessages();
-
-        assertMessagesAreReceived();
-        LOG.info("" + data.length + " messages(s) received, closing down connections");
-    }
