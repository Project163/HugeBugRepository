+def parse_version(version):
+  import re
+  splitted = re.split('[.-]', version)
+  if len(splitted) == 3:
+    splitted = splitted + ['GA']
+  splitted = [s.lower() for s in splitted]
+  assert len(splitted) == 4;
+  return splitted
+
