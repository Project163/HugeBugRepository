-
-    val r = new BufferedReader(new InputStreamReader(p.getInputStream))
-    closeables += r
-
-    val w = new StringWriter()
-    closeables += w
-
-    var continue = true
-    val jars = new mutable.ArrayBuffer[String]()
-    do {
-      val cp = r.readLine()
-      if (cp == null)
