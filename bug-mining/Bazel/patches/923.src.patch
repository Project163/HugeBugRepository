+)
+toolchain(
+    name = 'test_toolchain_bar',
+    toolchain_type = ':toolchain_type',
+    exec_compatible_with = [
+        ':value_bar',
+    ],
+    target_compatible_with = [],
+    toolchain = ':test_toolchain_impl_bar',
+)
 
