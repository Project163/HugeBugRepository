e/{base}...{head}","merges_url":"https://api.github.com/repos/vimeo/psalm/merges","archive_url":"https://api.github.com/repos/vimeo/psalm/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/vimeo/psalm/downloads","issues_url":"https://api.github.com/repos/vimeo/psalm/issues{/number}","pulls_url":"https://api.github.com/repos/vimeo/psalm/pulls{/number}","milestones_url":"https://api.github.com/repos/vimeo/psalm/milestones{/number}","notifications_url":"https://api.github.com/repos/vimeo/psalm/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/vimeo/psalm/labels{/name}","releases_url":"https://api.github.com/repos/vimeo/psalm/releases{/id}","deployments_url":"https://api.github.com/repos/vimeo/psalm/deployments","created_at":"2016-11-21T17:04:41Z","updated_at":"2025-12-12T13:56:46Z","pushed_at":"2025-12-11T08:59:09Z","git_url":"git://github.com/vimeo/psalm.git","ssh_url":"git@github.com:vimeo/psalm.git","clone_url":"https://github.com/vimeo/psalm.git","svn_url":"https://github.com/vimeo/psalm","homepage":"https://psalm.dev","size":116606,"stargazers_count":5784,"watchers_count":5784,"language":"PHP","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":684,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1949,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["hacktoberfest","php","security-analysis","static-analysis","taint-analysis","type-inference"],"visibility":"public","forks":684,"open_issues":1949,"watchers":5784,"default_branch":"6.x","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Psalm gives many undefined errors for this example, but nothing is undefined, since include.php includes everything. Surprisingly, the example is minimal.\r\n\r\nProbably related to https://github.com/vimeo/psalm/issues/1338.\r\n\r\nExample:\r\n\r\n**include.php**\r\n```php\r\n<?php\r\ninclude 'func.php';\r\ninclude 'Base.php';\r\ninclude 'Child.php';\r\n```\r\n\r\n**func.php**\r\n```php\r\n<?php\r\nnamespace ns;\r\n\r\nfunction func(): void {}\r\n\r\ndefine('ns\\\\cons', 0);\r\n\r\ncons;\r\n```\r\n\r\n**Base.php**\r\n```php\r\n<?php\r\nnamespace ns;\r\n\r\nfunc();\r\n\r\ncons;\r\n\r\nclass Base {\r\n    public function __construct() {}\r\n}\r\n```\r\n\r\n**Child.php**\r\n```php\r\n<?php\r\nnamespace ns;\r\n\r\nfunc();\r\n\r\ncons;\r\n\r\nclass Child extends Base {\r\n    /**\r\n     * @var int\r\n     */\r\n    public $x;\r\n\r\n    public function __construct() {\r\n        parent::__construct();\r\n    }\r\n}\r\n```\r\n\r\nExample output (using commit 8ec188a):\r\n```\r\n$ psalm include.php\r\nERROR: UndefinedFunction - Base.php:4:1 - Function ns\\func does not exist\r\n\r\nERROR: UndefinedConstant - Base.php:6:1 - Const cons is not defined\r\n\r\nERROR: UndefinedConstant - Child.php:6:1 - Const cons is not defined\r\n\r\nINFO: PropertyNotSetInConstructor - Child.php:12:12 - Property ns\\Child::$x is not defined in constructor of ns\\Child or in any methods called in the constructor\r\n\r\nERROR: UndefinedConstant - func.php:8:1 - Const cons is not defined\r\n```","reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/1417/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vimeo/psalm/issues/1417/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"actor":{"login":"andrewprofile","id":7659096,"node_id":"MDQ6VXNlcjc2NTkwOTY=","avatar_url":"https://avatars.githubusercontent.com/u/7659096?v=4","gravatar_id":"","url":"https://api.github.com/users/andrewprofile","html_url":"https://github.com/andrewprofile","followers_url":"h