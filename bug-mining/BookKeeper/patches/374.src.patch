-    boost::lock_guard<boost::shared_mutex> lock(deliverystate_lock);
-    if (STARTING_DELIVERY == deliverystate) {
-      LOG4CXX_ERROR(logger, "someone is starting delivery for " << *this
-                            << ". we could not stop delivery now.");
