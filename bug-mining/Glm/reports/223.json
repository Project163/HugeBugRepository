n\t\tResult[3][0] = - (right + left) / (right - left);\r\n\t\tResult[3][1] = - (top + bottom) / (top - bottom);\r\n\t\treturn Result;\r\n\t}\r\n```\r\nAnd what code was in 0.9.8.4:\r\n```CPP\r\ntemplate <typename T>\r\n\tGLM_FUNC_QUALIFIER tmat4x4<T, defaultp> ortho\r\n\t(\r\n\t\tT left, T right,\r\n\t\tT bottom, T top\r\n\t)\r\n\t{\r\n\t\ttmat4x4<T, defaultp> Result(static_cast<T>(1));\r\n\t\tResult[0][0] = static_cast<T>(2) / (right - left);\r\n\t\tResult[1][1] = static_cast<T>(2) / (top - bottom);\r\n\t\tResult[2][2] = - static_cast<T>(1); // This line was forgotten in new releases\r\n\t\tResult[3][0] = - (right + left) / (right - left);\r\n\t\tResult[3][1] = - (top + bottom) / (top - bottom);\r\n\t\treturn Result;\r\n\t}\r\n```","closed_by":{"login":"Groovounet","id":367227,"node_id":"MDQ6VXNlcjM2NzIyNw==","avatar_url":"https://avatars.githubusercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/g-truc/glm/issues/790/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/g-truc/glm/issues/790/timeline","performed_via_github_app":null,"stat