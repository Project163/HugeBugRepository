8223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2024-08-12T22:45:01Z","label":{"name":"orm","color":"20C0B0"},"performed_via_github_app":null},{"id":13855476378,"node_id":"LE_lADOCX5JB86SvRITzwAAAAM52cqa","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/13855476378","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2024-08-12T22:45:01Z","label":{"name":"hard orm","color":"EF69D6"},"performed_via_github_app":null},{"id":13855476829,"node_id":"MIE_lADOCX5JB86SvRITzwAAAAM52cxd","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/13855476829","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"milestoned","commit_id":null,"commit_url":null,"created_at":"2024-08-12T22:45:05Z","milestone":{"title":"2.1"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/2285034882","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/11728#issuecomment-2285034882","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/11728","id":2285034882,"node_id":"IC_kwDOCX5JB86IMt2C","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-08-12T22:54:50Z","updated_at":"2024-08-12T22:54:50Z","body":"hi - \r\n\r\nthanks for reporting.\r\n\r\nthis issue occurs deep in an extremely central set of methods that have wide reaching effects throughout the Core and ORM; these methods were carefully rewritten in the 1.4 series to suit the new column architectures and it took many months. \r\n\r\nit's not clear the extent to which the required changes would be backwards compatible as this was not really the primary intended use of a hybrid property (but certainly, this should work consistently.  it's not clear to me if there was ever a guarantee that the name of a hybrid expression in a result set would be named the same as the attribute but that seems to be current behavior).   so for the moment this is targeted at 2.1 and hopefully can be targeted at 2.0.  1.4 not the current release series so we aren't backporting new code issues (that is, issues that only show up when someone writes new code that never worked in 1.4).\r\n\r\nI think in your case you should be using [synonym](https://docs.sqlalchemy.org/en/20/orm/mapped_attributes.html#sqlalchemy.orm.synonym) if want an attribute that's a total mirror of a column.\r\n\r\n\r\npartial fix but not full looks like\r\n\r\n```diff\r\ndiff --git a/lib/sqlalchemy/sql/selectable.py b/lib/sqlalchemy/sql/selectable.py\r\nindex 632e2e792..555c2b9a9 100644\r\n--- a/lib/sqlalchemy/sql/selectable.py\r\n+++ b/lib/sqlalchemy/sql/selectable.py\r\n@@ -4626,12 +4626,12 @@ class SelectState(util.MemoizedSlots, CompileState):\r\n                 assert is_column_element(c)\r\n \r\n             if not dedupe:\r\n-                name = c._proxy_key\r\n+                name = col_name if col_name else c._proxy_key\r\n                 if name is None:\r\n                     name = \"_no_label\"\r\n                 return name\r\n \r\n-            name = c._tq_key_label if table_qualified else c._proxy_key\r\n+            name = c._tq_key_label if table_qualified else col_name if col_name else c._proxy_key\r\n \r\n             if name is None:\r\n                 name = \"_no_label\"\r\n\r\n```\r\n\r\nthis fixes the result set portion of it, tests seem to pass with this so will have to find some time to see how this didn't get tested already plus fix the `.c` case.     ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/2285034882/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/2285047612","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/11728#issuecomment-2285047612","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/11728","id":2285047612,"node_id":"IC_kwDOCX5JB86IMw88","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-08-12T23:08:43Z","updated_at":"2024-08-12T23:08:43Z","body":"OK this is better, this is a memoization in the annotated that should fix this \r\n\r\n```diff\r\ndiff --git a/lib/sqlalchemy/sql/elements.py b/lib/sqlalchemy/sql/elements.py\r\nindex 64b686fc0..2b6835a6a 100644\r\n--- a/lib/sqlalchemy/sql/elements.py\r\n+++ b/lib/sqlalchemy/sql/elements.py\r\n@@ -5347,7 +5347,14 @@ class AnnotatedColumnElement(Annotated):\r\n \r\n     def _with_annotations(self, values):\r\n         clone = super()._with_annotations(values)\r\n-        clone.__dict__.pop(\"comparator\", None)\r\n+        for attr in (\r\n+            \"comparator\",\r\n+            \"_proxy_key\",\r\n+            \"_tq_key_label\",\r\n+            \"_tq_label\",\r\n+            \"_non_anon_label\",\r\n+        ):\r\n+            clone.__dict__.pop(attr, None)\r\n         return clone\r\n \r\n     @util.memoized_property\r\n\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/2285047612/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":13855617388,"node_id":"DEME_lADOCX5JB86SvRITzwAAAAM52_Fs","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/13855617388","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_