1.0.Beta6","description":"","creator":{"login":"normanmaurer","id":439362,"node_id":"MDQ6VXNlcjQzOTM2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/439362?v=4","gravatar_id":"","url":"https://api.github.com/users/normanmaurer","html_url":"https://github.com/normanmaurer","followers_url":"https://api.github.com/users/normanmaurer/followers","following_url":"https://api.github.com/users/normanmaurer/following{/other_user}","gists_url":"https://api.github.com/users/normanmaurer/gists{/gist_id}","starred_url":"https://api.github.com/users/normanmaurer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/normanmaurer/subscriptions","organizations_url":"https://api.github.com/users/normanmaurer/orgs","repos_url":"https://api.github.com/users/normanmaurer/repos","events_url":"https://api.github.com/users/normanmaurer/events{/privacy}","received_events_url":"https://api.github.com/users/normanmaurer/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":102,"state":"closed","created_at":"2015-05-07T19:29:09Z","updated_at":"2015-11-08T03:17:09Z","due_on":null,"closed_at":"2015-09-04T17:07:03Z"},"comments":5,"created_at":"2015-03-12T14:50:00Z","updated_at":"2015-05-08T20:14:27Z","closed_at":"2015-05-08T20:14:27Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Running 5.0.0.Alpha2 on EC2 I get the following warning:\n\nWARN  DefaultChannelId - Failed to find a usable hardware address from the network interfaces; using random bytes: xxxxxxxxxxxxxxx\n\nThe system has two network interfaces:\n\neth0      Link encap:Ethernet  HWaddr 22:00:0B:7A:47:BD  \n          inet addr:10.61.194.198  Bcast:10.61.194.255  Mask:255.255.255.0\n          inet6 addr: fe80::2000:bff:fe7a:47bd/64 Scope:Link\n          UP BROADCAST RUNNING MULTICAST  MTU:9001  Metric:1\n          RX packets:13458177 errors:0 dropped:0 overruns:0 frame:0\n          TX packets:6024704 errors:0 dropped:0 overruns:0 carrier:0\n          collisions:0 txqueuelen:1000 \n          RX bytes:14279224426 (13.2 GiB)  TX bytes:6007218439 (5.5 GiB)\n\nlo        Link encap:Local Loopback  \n          inet addr:127.0.0.1  Mask:255.0.0.0\n          inet6 addr: ::1/128 Scope:Host\n          UP LOOPBACK RUNNING  MTU:65536  Metric:1\n          RX packets:7704 errors:0 dropped:0 overruns:0 frame:0\n          TX packets:7704 errors:0 dropped:0 overruns:0 carrier:0\n          collisions:0 txqueuelen:0 \n          RX bytes:4912763 (4.6 MiB)  TX bytes:4912763 (4.6 MiB)\n\nThe problem as I see it comes down to the scoreAddress method.  The default 127.0.0.1 best address is scored as a 4 and the 10.61.194.198 address is scored as a 2.  This results in a compareAddresses score of 2 which in turn does not replace the 127.0.0.1 with 10.61.194.198.\n\nhttps://github.com/netty/netty/blob/master/transport/src/main/java/io/netty/channel/DefaultChannelId.java#L182\n\nI am pretty sure the scoreAddress method needs to handle the case where it is a loopback address and if it is then return 0.  This would fix the scoring and the appropriate interface would be replaced and used.\n\nhttps://github.com/netty/netty/blob/master/transport/src/main/java/io/netty/channel/DefaultChannelId.java#L283\n","closed_by":{"login":"nmittler","id":6493296,"node_id":"MDQ6VXNlcjY0OTMyOTY=","avatar_url":"https://avatars.githubusercontent.com/u/6493296?v=4","gravatar_id":"","url":"https://api.github.com/users/nmittler","html_url":"https://github.com/nmittler","followers_url":"https://api.github.com/users/nmittler/followers","following_url":"https://api.github.com/users/nmittler/following{/other_user}","gists_url":"https://api.github.com/users/nmittler/gists{/gist_id}","starred_url":"https://api.github.com/users/nmittler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nmittler/subscriptions","organizations_url":"https://api.github.com/users/nmittler/orgs","repos_url":"https://api.github.com/users/nmittler/repos","events_url":"https://api.github.com/users/nmittler/events{/privacy}","received_events_url":"https://api.github.com/users/nmittler/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/netty/netty/issues/3490/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/netty/netty/issues/3490/timeline","performed_via_github_app":null,"state_reason":"completed"}