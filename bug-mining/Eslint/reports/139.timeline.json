ndeeps/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gyandeeps/subscriptions","organizations_url":"https://api.github.com/users/gyandeeps/orgs","repos_url":"https://api.github.com/users/gyandeeps/repos","events_url":"https://api.github.com/users/gyandeeps/events{/privacy}","received_events_url":"https://api.github.com/users/gyandeeps/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2014-07-09T23:27:18Z","rename":{"from":"env doesnt work when passed to cli object as","to":"env doesnt work when passed to cli object as array of strings"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/eslint/eslint/issues/comments/48548674","html_url":"https://github.com/eslint/eslint/issues/1064#issuecomment-48548674","issue_url":"https://api.github.com/repos/eslint/eslint/issues/1064","id":48548674,"node_id":"MDEyOklzc3VlQ29tbWVudDQ4NTQ4Njc0","user":{"login":"jonvuri","id":2074135,"node_id":"MDQ6VXNlcjIwNzQxMzU=","avatar_url":"https://avatars.githubusercontent.com/u/2074135?v=4","gravatar_id":"","url":"https://api.github.com/users/jonvuri","html_url":"https://github.com/jonvuri","followers_url":"https://api.github.com/users/jonvuri/followers","following_url":"https://api.github.com/users/jonvuri/following{/other_user}","gists_url":"https://api.github.com/users/jonvuri/gists{/gist_id}","starred_url":"https://api.github.com/users/jonvuri/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jonvuri/subscriptions","organizations_url":"https://api.github.com/users/jonvuri/orgs","repos_url":"https://api.github.com/users/jonvuri/repos","events_url":"https://api.github.com/users/jonvuri/events{/privacy}","received_events_url":"https://api.github.com/users/jonvuri/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-07-09T23:33:30Z","updated_at":"2014-07-09T23:35:29Z","body":"Can you clarify what you mean by calling the cli interface with \n\n```\n               options:{\n                    env:[\"node\"],  // doesnt work\n                    global:[\"test\"]  // works\n                }\n```\n\n?\n\nBecause that looks more like an .eslintrc. And eslintrc works with objects, as shown in http://eslint.org/docs/configuring/:\n\n```\n{\n    \"env\": {\n        \"browser\": true,\n        \"node\": true\n    },\n    \"globals\": {\n        \"var1\": true,\n        \"var2\": false\n    }\n}\n```\n\nSo, the reason you are seeing this behavior is because eslint is trying to read the array as an object - it thinks you want to set an environment with the name of the array's index, since it looks like an object of this form:\n\n```\n{\n    \"0\": \"node\"\n}\n```\n\nMaybe we should check that it's an object explicitly and throw an error if it's not.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/eslint/eslint/issues/comments/48548674/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"jonvuri","id":2074135,"node_id":"MDQ6VXNlcjIwNzQxMzU=","avatar_url":"https://avatars.githubusercontent.com/u/2074135?v=4","gravatar_id":"","url":"https://api.github.com/users/jonvuri","html_url":"https://github.com/jonvuri","followers_url":"https://api.github.com/users/jonvuri/followers","following_url":"https://api.github.com/users/jonvuri/following{/other_user}","gists_url":"https://api.github.com/users/jonvuri/gists{/gist_id}","starred_url":"https://api.github.com/users/jonvuri/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jonvuri/subscriptions","organizations_url":"https://api.github.com/users/jonvuri/orgs","repos_url":"https://api.github.com/users/jonvuri/repos","events_url":"https://api.github.com/users/jonvuri/events{/privacy}","received_events_url":"https://api.github.com/users/jonvuri/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/eslint/eslint/issues/comments/48549287","html_url":"https://github.com/eslint/eslint/issues/1064#issuecomment-48549287","issue_url":"https://api.github.com/repos/eslint/eslint/issues/1064","id":48549287,"node_id":"MDEyOklzc3VlQ29tbWVudDQ4NTQ5Mjg3","user":{"login":"gyandeeps","id":5554486,"node_id":"MDQ6VXNlcjU1NTQ0ODY=","avatar_url":"https://avatars.githubusercontent.com/u/5554486?v=4","gravatar_id":"","url":"https://api.github.com/users/gyandeeps","html_url":"https://github.com/gyandeeps","followers_url":"https://api.github.com/users/gyandeeps/followers","following_url":"https://api.github.com/users/gyandeeps/following{/other_user}","gists_url":"https://api.github.com/users/gyandeeps/gists{/gist_id}","starred_url":"https://api.github.com/users/gyandeeps/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gyandeeps/subscriptions","organizations_url":"https://api.github.com/users/gyandeeps/orgs","repos_url":"https://api.github.com/users/gyandeeps/repos","events_url":"https://api.github.com/users/gyandeeps/events{/privacy}","received_events_url":"https://api.github.com/users/gyandeeps/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-07-09T23:41:23Z","updated_at":"2014-07-09T23:45:37Z","body":"The options file explictly says that `env` is of type `[string]`, which means array of strings.\n\n``` .js\noptions:{\n    env:[\"node\"],  // doesnt work\n    global:[\"test\"]  // works\n}\n\nrequire(\"eslint\").cli.execute(options);\n```\n\nThis works for everything else except the `env`.\n\nI agree that it works woith `objects` but you cannot pass them through `cli` because it throws error for unrecognized variable (mainly because of the format)\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/eslint/eslint/issues/comments/48549287/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"gyandeeps","id":5554486,"node_id":"MDQ6VXNlcjU1NTQ0ODY=","avatar_url":"https://avatars.githubusercontent.com/u/5554486?v=4","gravatar_id":"","url":"https://api.github.com/users/gyandeeps","html_url":"https://github.com/gyandeeps","followers_url":"https://api.github.com/users/gyandeeps/followers","following_url":"https://api.github.com/users/gyandeeps/following{/other_user}","gists_url":"https://api.github.com/users/gyandeeps/gists{/gist_id}","starred_url":"https://api.github.com/users/gyandeeps/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gyandeeps/subscriptions","organizations_url":"https://api.github.com/users/gyandeeps/orgs","repos_url":"https://api.github.com/users/gyandeeps/repos","events_url":"https://api.github.com/users/gyandeeps/events{/privacy}","received_events_url":"https://api.github.com/users/gyandeeps/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/eslint/eslint/issues/comments/48553718","html_url":"https://github.com/eslint/eslint/issues/1064#issuecomment-48553718","issue_url":"https://api.github.com/repos/eslint/eslint/issues/1064","id":48553718,"node_id":"MDEyOklzc3VlQ29tbWVudDQ4NTUzNzE4","user":{"login":"jonvuri","id":2074135,"node_id":"MDQ6VXNlcjIwNzQxMzU=","avatar_url":"https://avatars.githubusercontent.com/u/2074135?v=4","gravatar_id":"","url":"https://api.github.com/users/jonvuri","html_url":"https://github.com/jonvuri","followers_url":"https://api.github.com/users/jonvuri/followers","following_url":"https://api.github.com/users/jonvuri/following{/other_user}","gists_url":"https://api.github.com/users/jonvuri/gists{/gist_id}","starred_url":"https://api.github.com/users/jonvuri/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jonvuri/subscriptions","organizations_url":"https://api.github.com/users/jonvuri/orgs","repos_url":"https://api.github.com/users/jonvuri/repos","events_url":"https://api.github.com/users/jonvuri/events{/privacy}","received_events_url":"https://api.github.com/users/jonvuri/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-07-10T00:51:41Z","updated_at":"2014-07-10T00:51:41Z","body":"Ah! So you're referring to the command line options object that's passed through.\n\nYou're absolutely right, there's a problem with the way it's being interpreted now. The createEnvironmentConfig doesn't accurately reproduce this block that it replaced in https://github.com/eslint/eslint/commit/15d135a637f2488c49f90d0af5f7d11bdda86de6 (among other things):\n\n``` js\n     // Add cli-supplied environments\n     if (this.env) {\n         if (!userConfig.env) {\n             userConfig.env = {};\n         }\n         this.env.forEach(function (env) {\n             userConfig.env[env] = true;\n         });\n     }\n```\n\nThe fix would be to either have a new method for the command-line configs, which will be an array `[\"browser\", \"node\"]` instead of an object `{\"browser\": true, \"node\": true}`, or to transform the array to the object before passing it in.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/eslint/eslint/issues/comments/48553718/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"jonvuri","id":2074135,"node_id":"MDQ6VXNlcjIwNzQxMzU=","avatar_url":"https://avatars.githubusercontent.com/u/2074135?v=4","gravatar_id":"","url":"https://api.github.com/users/jonvuri","html_url":"https://github.com/jonvuri","followers_url":"https://api.github.com/users/jonvuri/followers","following_url":"https://api.github.com/users/jonvuri/following{/other_user}","gists_url":"https://api.github.com/users/jonvuri/gists{/gist_id}","starred_ur