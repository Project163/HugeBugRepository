rm/typeorm/pulls{/number}","milestones_url":"https://api.github.com/repos/typeorm/typeorm/milestones{/number}","notifications_url":"https://api.github.com/repos/typeorm/typeorm/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/typeorm/typeorm/labels{/name}","releases_url":"https://api.github.com/repos/typeorm/typeorm/releases{/id}","deployments_url":"https://api.github.com/repos/typeorm/typeorm/deployments","created_at":"2016-02-29T07:41:14Z","updated_at":"2025-12-12T16:46:06Z","pushed_at":"2025-12-12T10:50:18Z","git_url":"git://github.com/typeorm/typeorm.git","ssh_url":"git@github.com:typeorm/typeorm.git","clone_url":"https://github.com/typeorm/typeorm.git","svn_url":"https://github.com/typeorm/typeorm","homepage":"http://typeorm.io","size":33014,"stargazers_count":36125,"watchers_count":36125,"language":"TypeScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":6469,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":540,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["active-record","cockroachdb","data-mapper","database","electron","hacktoberfest","javascript","mariadb","mysql","oracle","orm","postgresql","react-native","sap","sap-hana","sqlite","sqlserver","typeorm","typescript","websql"],"visibility":"public","forks":6469,"open_issues":540,"watchers":36125,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"## Issue Description\r\n\r\nI just added the `@UpdateDateColumn` to an entity to try it out and it is producing hours which are correct in the database, but broken when retrieving them.\r\n\r\n### Expected Behavior\r\n\r\nI would expect the time retrieved from a `find` result to be the current time in UTC.\r\n\r\nE.g. If I am in UTC + 1, and it is 15:00:00, I expect a time of 14:00:00 in the database, and in the return value from `find`.\r\n\r\n### Actual Behavior\r\n\r\nWhat is actually happening is that the time in the database is being stored as UTC, and when being returned from the database it seems to be be converting to UTC a second time.\r\n\r\nE.g. If I am in UTC + 1, and it is 15:00:00, what is actually happening is:\r\n1. Time string 14:00:00 is stored in the database ✅\r\n2. Time string 13:00:00 is being returned after a `find` ❌\r\n\r\nI haven't tested this but I'm pretty if I was in UTC + 2, it will subtract 2 hours twice. if I am in UTC + 3, it will subtract 3 hours twice, etc.\r\n\r\n### Steps to Reproduce\r\n\r\n```ts\r\n@Entity()\r\nexport class Foo {\r\n  @PrimaryColumn()\r\n  id: number;\r\n\r\n  @Column()\r\n  name: string;\r\n\r\n  @UpdateDateColumn()\r\n  syncDate: Date;\r\n}\r\n\r\nasync function save(id: number, name: string) {\r\n  await getRepository(Foo).save({ id, name });\r\n  console.log('Current UTC Time:', new Date());\r\n  const findResult = await getRepository(Foo).findOne(id);\r\n  console.log('Result from db:  ', findResult?.syncDate);\r\n  return findResult;\r\n}\r\n\r\nexport async function test() {\r\n  await save(1, 'test');\r\n}\r\n```\r\n\r\nStored in db: (no offset! see my reply below)\r\n```\r\n2020-12-07 16:00:53.1100000\r\n```\r\n\r\nOutput:\r\n\r\n```\r\nCurrent UTC Time: 2020-12-07T15:34:11.211Z\r\nResult from db:   2020-12-07T14:34:11.220Z\r\n```\r\n\r\n### My Environment\r\n\r\n<!--\r\n  Please add any other relevant dependencies to this table at the end.\r\n  For example: Electron, React Native, or NestJS.\r\n-->\r\n\r\n| Dependency          | Version  |\r\n| ---                 | ---      |\r\n| Operating System    |    Mac OS      |\r\n| Node.js version     | v12.10.0 | <!-- run `node -v` to obtain this -->\r\n| Typescript version  | v4.0.5 | <!-- run `npm list typescript` to obtain this -->\r\n| TypeORM version     | v0.2.29 | <!-- run `npm list typeorm` to obtain this -->\r\n\r\n\r\n### Additional Context\r\n\r\nI'm not sure, but maybe this is just an MS SQL issue? I tried searching but couldn't find any information on it though.\r\n\r\nI am using the following MS SQL sever image: **mcr.microsoft.com/mssql/server:2019-CU8-ubuntu-16.04**\r\n\r\nStill in development phase so no production server timezones to worry about, this is all on local machine\r\n\r\n### Relevant Database Driver(s)\r\n\r\n- [ ] `aurora-data-api`\r\n- [ ] `aurora-data-api-pg`\r\n- [ ] `better-sqlite3`\r\n- [ ] `cockroachdb`\r\n- [ ] `cordova`\r\n- [ ] `expo`\r\n- [ ] `mongodb`\r\n- [ ] `mysql`\r\n- [x] `mssql`\r\n- [ ] `nativescript`\r\n- [ ] `oracle`\r\n- [ ] `postgres`\r\n- [ ] `react-native`\r\n- [ ] `sap`\r\n- [ ] `sqlite`\r\n- [ ] `sqlite-abstract`\r\n- [ ] `sqljs`\r\n- [ ] `sqlserver`\r\n\r\n\r\n### Are you willing to resolve this issue by submitting a Pull Request?\r\n\r\n- [ ] Yes, I have the time, and I know how to start.\r\n- [x] Yes, I have the time, but I don't know how to start. I would need guidance.\r\n- [ ] No, I don't have the time, although I believe I could do it if I had the time...\r\n- [ ] No, I don't have the time and I wouldn't even know how to start.\r\n","reactions":{"url":"https://api.github.com/repos/typeorm/typeorm/issues/7167/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/typeorm/typeorm/issues/7167/timeline","performed_via_github_app":null,"state_reason":"not_planned"}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/typeorm/typeorm/issues/comments/751404697","html_url":"https://github.com/typeorm/typeorm/issues/7047#issuecomment-751404697","issue_url":"https://api.github.com/repos/typeorm/typeorm/issues/7047","id":751404697,"node_id":"MDEyOklzc3VlQ29tbWVudDc1MTQwNDY5Nw==","user":{"login":"elvinmeza","id":633517,"node_id":"MDQ6VXNlcj