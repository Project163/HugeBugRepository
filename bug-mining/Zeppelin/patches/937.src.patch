+
+      /* This is kept here puropsly to show preloader */
+      #pre-loader {
+        height: 100%;
+        min-height: 100%;
+        background-color: #ECF0F1;
+        width: 100%;
+        position: fixed;
+        top: 0px;
+        margin-left: -8px;
+        z-index: 99
+      }
+
+      .pre-loader-content {
+        position: absolute;
+        top: 45%;
+        left: 50%
+      }
+
+      .loader {
