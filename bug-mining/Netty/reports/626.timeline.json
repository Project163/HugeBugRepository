_issues":610,"watchers":34635,"default_branch":"4.2","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/netty/netty/pulls/6982","html_url":"https://github.com/netty/netty/pull/6982","diff_url":"https://github.com/netty/netty/pull/6982.diff","patch_url":"https://github.com/netty/netty/pull/6982.patch","merged_at":null},"body":"Motivation:\r\nSslHandlerTest#TlsReadTest attempts to carefully orchestrate when reads are done and that they are done independent of auto read being enabled in some scenarios. However the use of EmbeddedChannel enables auto read in the constructor before the unit test has a change to effectively disable it. This gives a false sense of security when verifying that reads were done independently of auto read.\r\n\r\nModifications:\r\n- EmbeddedChannel should allow some channel options in the constructor and apply them before initializing the channel handlers\r\n\r\nResult:\r\nFixes https://github.com/netty/netty/issues/6968","reactions":{"url":"https://api.github.com/repos/netty/netty/issues/6982/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/netty/netty/issues/6982/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":1167765956,"node_id":"MDEzOkFzc2lnbmVkRXZlbnQxMTY3NzY1OTU2","url":"https://api.github.com/repos/netty/netty/issues/events/1167765956","actor":{"login":"Scottmitch","id":7562868,"node_id":"MDQ6VXNlcjc1NjI4Njg=","avatar_url":"https://avatars.githubusercontent.com/u/7562868?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottmitch","html_url":"https://github.com/Scottmitch","followers_url":"https://api.github.com/users/Scottmitch/followers","following_url":"https://api.github.com/users/Scottmitch/following{/other_user}","gists_url":"https://api.github.com/users/Scottmitch/gists{/gist_id}","s