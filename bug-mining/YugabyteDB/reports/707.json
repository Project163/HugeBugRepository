ption":"High Priority"},{"id":2156857038,"node_id":"MDU6TGFiZWwyMTU2ODU3MDM4","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/area/ycql","name":"area/ycql","color":"0c4fcc","default":false,"description":"Yugabyte CQL (YCQL)"},{"id":4118183456,"node_id":"LA_kwDOBlCVUc71dn4g","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/jira-originated","name":"jira-originated","color":"ededed","default":false,"description":null}],"state":"closed","locked":false,"assignee":{"login":"arpang","id":9985824,"node_id":"MDQ6VXNlcjk5ODU4MjQ=","avatar_url":"https://avatars.githubusercontent.com/u/9985824?v=4","gravatar_id":"","url":"https://api.github.com/users/arpang","html_url":"https://github.com/arpang","followers_url":"https://api.github.com/users/arpang/followers","following_url":"https://api.github.com/users/arpang/following{/other_user}","gists_url":"https://api.github.com/users/arpang/gists{/gist_id}","starred_url":"https://api.github.com/users/arpang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arpang/subscriptions","organizations_url":"https://api.github.com/users/arpang/orgs","repos_url":"https://api.github.com/users/arpang/repos","events_url":"https://api.github.com/users/arpang/events{/privacy}","received_events_url":"https://api.github.com/users/arpang/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"arpang","id":9985824,"node_id":"MDQ6VXNlcjk5ODU4MjQ=","avatar_url":"https://avatars.githubusercontent.com/u/9985824?v=4","gravatar_id":"","url":"https://api.github.com/users/arpang","html_url":"https://github.com/arpang","followers_url":"https://api.github.com/users/arpang/followers","following_url":"https://api.github.com/users/arpang/following{/other_user}","gists_url":"https://api.github.com/users/arpang/gists{/gist_id}","starred_url":"https://api.github.com/users/arpang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arpang/subscriptions","organizations_url":"https://api.github.com/users/arpang/orgs","repos_url":"https://api.github.com/users/arpang/repos","events_url":"https://api.github.com/users/arpang/events{/privacy}","received_events_url":"https://api.github.com/users/arpang/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2022-08-11T16:43:53Z","updated_at":"2024-06-29T06:05:48Z","closed_at":"2022-10-04T12:00:01Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Jira Link: [DB-3166](https://yugabyte.atlassian.net/browse/DB-3166)\r\n\r\nHello,\r\n\r\nWe have a bug where every time a select query is run with type MAP, it queries out only the last value of the key that is in the query.\r\n\r\n```\r\nycqlsh> CREATE TABLE data.users(username TEXT PRIMARY KEY,emails SET<TEXT>,phones MAP<TEXT,TEXT>,top_cities LIST<TEXT>);\r\n\r\nycqlsh> INSERT INTO data.users(username, emails, phones, top_cities) VALUES ('foo',{'c@example.com', 'a@example.com'}, {'home' : '999-9999', 'mobile' : '000-0000', 'work':'222-222'},['New York', 'Paris']);\r\n\r\nycqlsh> SELECT phones FROM data.users ;\r\n\r\n phones\r\n---------------------------------------------------------------\r\n {'home': '999-9999', 'mobile': '000-0000', 'work': '222-222'}\r\n {'home': '123-3456', 'mobile': '223-6789', 'work': '333-333'}       --->  This works as expected\r\n\r\n(2 rows)\r\n\r\nycqlsh> SELECT username, phones['work'],phones['home'] from data.users WHERE username = 'foo';\r\n\r\n username | expr     | expr\r\n----------+----------+----------\r\n      foo | 999-9999 | 999-9999   ---> shows same value for both fields; incorrect.\r\n\r\n(1 rows)\r\nycqlsh> SELECT username, phones['work'],phones['home'],phones['mobile'] from data.users WHERE username = 'foo';\r\n\r\n username | expr     | expr     | expr\r\n----------+----------+----------+----------\r\n      foo | 000-0000 | 000-0000 | 000-0000      ---> shows same value for all three fields; incorrect.\r\n\r\n(1 rows)\r\n\r\n```\r\n\r\n**Workaround:**\r\n\r\nAs a workaround, you can use `AS` clause in the query to get the correct output.\r\n\r\n```\r\nycqlsh> SELECT username, phones['work'] AS work ,phones['home'] AS home from data.users WHERE username = 'foo';\r\n\r\n username | work     | home\r\n----------+----------+----------\r\n      foo | 222-222 | 999-9999   ---> works as expected.\r\n```","closed_by":{"login":"arpang","id":9985824,"node_id":"MDQ6VXNlcjk5ODU4MjQ=","avatar_url":"https://avatars.githubusercontent.com/u/9985824?v=4","gravatar_id":"","url":"https://api.github.com/users/arpang","html_url":"https://github.com/arpang","followers_url":"https://api.github.com/users/arpang/followers","following_url":"https://api.github.com/users/arpang/following{/other_user}","gists_url":"https://api.github.com/users/arpang/gists{/gist_id}","starred_url":"https://api.github.com/users/arpang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arpang/subscriptions","organizations_url":"https://api.github.com/users/arpang/orgs","repos_url":"https://api.github.com/users/arpang/repos","events_url":"https://api.github.com/users/arpang/events{/privacy}","received_events_url":"https://api.github.com/users/arpang/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/13591/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/13591/timeline","performed_via_github_app":null,"state_reason":"completed"}