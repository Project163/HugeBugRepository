       throws IOException {&lt;br/&gt;
     recordConsumer.flush();&lt;/li&gt;
	&lt;li&gt;LOG.info(&quot;Flushing mem columnStore to file. allocated memory: {}&quot;, columnStore.getAllocatedSize());&lt;br/&gt;
+    LOG.debug(&quot;Flushing mem columnStore to file. allocated memory: {}&quot;, columnStore.getAllocatedSize());&lt;br/&gt;
     if (columnStore.getAllocatedSize() &amp;gt; (3 * rowGroupSizeThreshold)) {&lt;br/&gt;
       LOG.warn(&quot;Too much memory used: {}&quot;, columnStore.memUsageString());&lt;br/&gt;
     }&lt;/li&gt;
&lt;/ul&gt;





