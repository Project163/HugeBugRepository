ub.com/users/ramonvg/orgs","repos_url":"https://api.github.com/users/ramonvg/repos","events_url":"https://api.github.com/users/ramonvg/events{/privacy}","received_events_url":"https://api.github.com/users/ramonvg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-03-21T00:14:05Z","updated_at":"2019-03-21T00:14:05Z","body":"Hi again, that was clearly our mistake and definetely we should catch those bugs on testing. We love SQLAlchemy and we just want users not repeating our mistakes, that's basically why I was opening the issue.There was not any hostility intended. Sad to hear that you read it that way!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/475075707/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ramonvg","id":19570455,"node_id":"MDQ6VXNlcjE5NTcwNDU1","avatar_url":"https://avatars.githubusercontent.com/u/19570455?v=4","gravatar_id":"","url":"https://api.github.com/users/ramonvg","html_url":"https://github.com/ramonvg","followers_url":"https://api.github.com/users/ramonvg/followers","following_url":"https://api.github.com/users/ramonvg/following{/other_user}","gists_url":"https://api.github.com/users/ramonvg/gists{/gist_id}","starred_url":"https://api.github.com/users/ramonvg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ramonvg/subscriptions","organizations_url":"https://api.github.com/users/ramonvg/orgs","repos_url":"https://api.github.com/users/ramonvg/repos","events_url":"https://api.github.com/users/ramonvg/events{/privacy}","received_events_url":"https://api.github.com/users/ramonvg/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/475083860","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/4556#issuecomment-475083860","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/4556","id":475083860,"node_id":"MDEyOklzc3VlQ29tbWVudDQ3NTA4Mzg2MA==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-03-21T01:07:28Z","updated_at":"2019-03-21T01:07:28Z","body":"> Hi again, that was clearly our mistake and definetely we should catch those bugs on testing. We love SQLAlchemy and we just want users not repeating our mistakes, that's basically why I was opening the issue.There was not any hostility intended. Sad to hear that you read it that way!\r\n\r\nHi Ramon -\r\n\r\nI would say that I sense frustration in that SQLAlchemy did something that screwed up your production database, but as far as \"hostility\" I don't perceive any hostility here, my own internal tendency towards projection (that is, my imagination of an emotion that then clouds my perception of an interpersonal situation) is very hyperactive and that's what you might have seen me tweeting about (that I need to meditate and try to figure out where my own reactions are clouding things), I try to get that under wraps before I actually respond to things and I apologize if I failed to cap it enough in this case.\r\n\r\nas for this issue we can catch the mistake but it needs to be some kind of heuristic that is ensuring it doesn't block valid use cases while catching the bad ones; probably a flag that is set up when someone passes a Table object to Query will allow us to differentiate that kind of column expression from other arbitrary ones.\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/475083860/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":3477531933,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDM0Nzc1MzE5MzM=","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/3477531933","actor":{"login":"ramonvg","id":19570455,"node_id":"MDQ6VXNlcjE5NTcwNDU1","avatar_url":"https://avatars.githubusercontent.com/u/19570455?v=4","gravatar_id":"","url":"https://api.github.com/users/