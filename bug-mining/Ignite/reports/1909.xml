<item>
            <title>[IGNITE-114] Value is not loaded from store for invoke in transactional cache</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-114</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;Added test IgniteCacheInvokeReadThroughTest. Value is not in cache but exists in store, when invoke EntryProcessor is executed on backup it gets null value instead of value loaded from store.&lt;/p&gt;</description>
                <environment></environment>
        <key id="12769041">IGNITE-114</key>
            <summary>Value is not loaded from store for invoke in transactional cache</summary>
                <type id="1" iconUrl="https://issues.apache.org/jira/secure/viewavatar?size=xsmall&amp;avatarId=21133&amp;avatarType=issuetype">Bug</type>
                                            <priority id="3" iconUrl="https://issues.apache.org/jira/images/icons/priorities/major.svg">Major</priority>
                        <status id="6" iconUrl="https://issues.apache.org/jira/images/icons/statuses/closed.png" description="The issue is considered finished, the resolution is correct. Issues which are not closed can be reopened.">Closed</status>
                    <statusCategory id="3" key="done" colorName="green"/>
                                    <resolution id="1">Fixed</resolution>
                                        <assignee username="-1">Unassigned</assignee>
                                    <reporter username="sboikov">Semen Boikov</reporter>
                        <labels>
                            <label>Muted_test</label>
                    </labels>
                <created>Wed, 21 Jan 2015 17:44:31 +0000</created>
                <updated>Fri, 17 Jun 2016 08:25:21 +0000</updated>
                            <resolved>Fri, 17 Jun 2016 08:25:10 +0000</resolved>
                                    <version>sprint-1</version>
