+                String forwardedPrefix = forwardedInfo.getPrefix();
+                if (!forwardedPrefix.startsWith("/")) {
+                    forwardedPrefix = "/" + forwardedPrefix;
+                }
+                prefix = forwardedPrefix + prefix;
+            }
+        }
