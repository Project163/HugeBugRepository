starksm64/gists{/gist_id}","starred_url":"https://api.github.com/users/starksm64/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/starksm64/subscriptions","organizations_url":"https://api.github.com/users/starksm64/orgs","repos_url":"https://api.github.com/users/starksm64/repos","events_url":"https://api.github.com/users/starksm64/events{/privacy}","received_events_url":"https://api.github.com/users/starksm64/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/465337269","html_url":"https://github.com/quarkusio/quarkus/issues/959#issuecomment-465337269","issue_url":"https://api.github.com/repos/quarkusio/quarkus/issues/959","id":465337269,"node_id":"MDEyOklzc3VlQ29tbWVudDQ2NTMzNzI2OQ==","user":{"login":"dmlloyd","id":124581,"node_id":"MDQ6VXNlcjEyNDU4MQ==","avatar_url":"https://avatars.githubusercontent.com/u/124581?v=4","gravatar_id":"","url":"https://api.github.com/users/dmlloyd","html_url":"https://github.com/dmlloyd","followers_url":"https://api.github.com/users/dmlloyd/followers","following_url":"https://api.github.com/users/dmlloyd/following{/other_user}","gists_url":"https://api.github.com/users/dmlloyd/gists{/gist_id}","starred_url":"https://api.github.com/users/dmlloyd/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dmlloyd/subscriptions","organizations_url":"https://api.github.com/users/dmlloyd/orgs","repos_url":"https://api.github.com/users/dmlloyd/repos","events_url":"https://api.github.com/users/dmlloyd/events{/privacy}","received_events_url":"https://api.github.com/users/dmlloyd/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-02-19T22:28:48Z","updated_at":"2019-02-19T22:28:48Z","body":"Yeah this validation needs improvement.  The error is likely happening because the `ConfigPhase` should be `BUILD_AND_RUN_TIME_FIXED` which makes it visible to run time code... theoretically.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/465337269/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"dmlloyd","id":124581,"node_id":"MDQ6VXNlcjEyNDU4MQ==","avatar_url":"https://avatars.githubusercontent.com/u/124581?v=4","gravatar_id":"","url":"https://api.github.com/users/dmlloyd","html_url":"https://github.com/dmlloyd","followers_url":"https://api.github.com/users/dmlloyd/followers","following_url":"https://api.github.com/users/dmlloyd/following{/other_user}","gists_url":"https://api.github.com/users/dmlloyd/gists{/gist_id}","starred_url":"https://api.github.com/users/dmlloyd/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dmlloyd/subscriptions","organizations_url":"https://api.github.com/users/dmlloyd/orgs","repos_url":"https://api.github.com/users/dmlloyd/repos","events_url":"https://api.github.com/users/dmlloyd/events{/privacy}","received_events_url":"https://api.github.com/users/dmlloyd/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/465416593","html_url":"https://github.com/quarkusio/quarkus/issues/959#issuecomment-465416593","issue_url":"https://api.github.com/repos/quarkusio/quarkus/issues/959","id":465416593,"node_id":"MDEyOklzc3VlQ29tbWVudDQ2NTQxNjU5Mw==","user":{"login":"starksm64","id":332210,"node_id":"MDQ6VXNlcjMzMjIxMA==","avatar_url":"https://avatars.githubusercontent.com/u/332210?v=4","gravatar_id":"","url":"https://api.github.com/users/starksm64","html_url":"https://github.com/starksm64","followers_url":"https://api.github.com/users/starksm64/followers","following_url":"https://api.github.com/users/starksm64/following{/other_user}","gists_url":"https://api.github.com/users/starksm64/gists{/gist_id}","starred_url":"https://api.github.com/users/starksm64/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/starksm64/subscriptions","organizations_url":"https://api.github.com/users/starksm64/orgs","repos_url":"https://api.github.com/users/starksm64/repos","events_url":"https://api.github.com/users/starksm64/events{/privacy}","received_events_url":"https://api.github.com/users/starksm64/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-02-20T04:18:32Z","updated_at":"2019-02-20T04:18:32Z","body":"The issue is that block of code that generates the ConfigRoot.class checks if the config root phase is available at runtime, while the ObjectLoader code that deserializes the config root does not. The following change to the latter:\r\n\r\n```java\r\n        objectLoaderConsumer.accept(new BytecodeRecorderObjectLoaderBuildItem(new ObjectLoader() {\r\n            public ResultHandle load(final BytecodeCreator body, final Object obj) {\r\n                final ConfigDefinition.RootInfo rootInfo = configDefinition.getInstanceInfo(obj);\r\n                if (rootInfo == null) return null;\r\n\r\n                if (!rootInfo.getConfigPhase().isAvailableAtRun()) { <1>\r\n                    String msg = String.format(\"You are trying to use a ConfigRoot[%s] at runtime whose phase[%s] does not allow this\",\r\n                                               rootInfo.getRootClass().getName(), rootInfo.getConfigPhase());\r\n                    throw new IllegalStateException(msg);\r\n                }\r\n                final FieldDescriptor fieldDescriptor = rootInfo.getFieldDescriptor();\r\n                final ResultHandle configRoot = body.invokeStaticMethod(GET_ROOT_METHOD);\r\n                return body.readInstanceField(fieldDescriptor, configRoot);\r\n            }\r\n        }));\r\n```\r\n<1> Check runtime availability\r\n\r\ncatches the problem and lets the user know about it:\r\n\r\n```java\r\nCaused by: java.lang.IllegalStateException: You are trying to use a ConfigRoot[org.jboss.shamrock.extest.TestBuildTimeConfig] at runtime whose phase[BUILD_TIME] does not allow this\r\n\tat org.jboss.shamrock.deployment.steps.ConfigurationSetup$2.load(ConfigurationSetup.java:387)\r\n\tat org.jboss.shamrock.deployment.recording.BytecodeRecorderImpl.findLoaded(BytecodeRecorderImpl.java:547)\r\n\tat org.jboss.shamrock.deployment.recording.BytecodeRecorderImpl.loadObjectInstance(BytecodeRecorderImpl.java:317)\r\n\tat org.jboss.shamrock.deployment.recording.BytecodeRecorderImpl.writeBytecode(BytecodeRecorderImpl.java:280)\r\n\tat org.jboss.shamrock.deployment.steps.MainClassBuildStep.build(MainClassBuildStep.java:108)\r\n\tat sun.reflect.NativeMethodAccessorImpl.invoke0(Native Method)\r\n\tat sun.reflect.NativeMethodAccessorImpl.invoke(NativeMethodAccessorImpl.java:62)\r\n\tat sun.reflect.DelegatingMethodAccessorImpl.invoke(DelegatingMethodAccessorImpl.java:43)\r\n\tat java.lang.reflect.Method.invoke(Method.java:498)\r\n\tat org.jboss.shamrock.deployment.ExtensionLoader$1.execute(ExtensionLoader.java:383)\r\n\tat org.jboss.builder.BuildContext.run(BuildContext.java:402)\r\n\tat org.jboss.threads.ContextClassLoaderSavingRunnable.run(ContextClassLoaderSavingRunnable.java:35)\r\n\tat org.jboss.threads.EnhancedQueueExecutor.safeRun(EnhancedQueueExecutor.java:1998)\r\n\tat org.jboss.threads.EnhancedQueueExecutor$ThreadBody.doRunTask(EnhancedQueueExecutor.java:1525)\r\n\tat org.jboss.threads.EnhancedQueueExecutor$ThreadBody.run(EnhancedQueueExecutor.java:1416)\r\n\tat java.lang.Thread.run(Thread.java:748)\r\n\tat org.jboss.threads.JBossThread.run(JBossThread.java:479)\r\n```\r\n\r\nI'll create a PR for that change. If it conflicts with what your currently doing, just grab the change and close the PR.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/465416593/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confus