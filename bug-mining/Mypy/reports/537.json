ity-0-high","name":"priority-0-high","color":"fbca04","default":false,"description":null}],"state":"closed","locked":false,"assignee":null,"assignees":[],"milestone":null,"comments":18,"created_at":"2017-06-23T21:56:18Z","updated_at":"2020-01-30T00:56:14Z","closed_at":"2020-01-30T00:56:14Z","author_association":"COLLABORATOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"In the following example, the branch of an if-statement is not being typechecked.\r\n\r\n```py\r\nclass Parent1: pass\r\n\r\nclass Parent2: pass\r\n\r\nclass Child(Parent1, Parent2): pass\r\n\r\ndef goo(p: Parent1) -> None:\r\n    if isinstance(p, Parent2):\r\n        # this branch is not typechecked\r\n        1 + 'boom'  # no error from mypy here.\r\n\r\n\r\ngoo(Child())\r\n```\r\n\r\nHere is the output from `mypy` and `python`.\r\n```\r\n$ mypy i.py \r\n$ python3 i.py \r\nTraceback (most recent call last):\r\n  File \"i.py\", line 13, in <module>\r\n    goo(Child())\r\n  File \"i.py\", line 10, in goo\r\n    1 + 'boom'  # no error from mypy but there's an error at runtime\r\nTypeError: unsupported operand type(s) for +: 'int' and 'str'\r\n```","closed_by":{"login":"Michael0x2a","id":1424628,"node_id":"MDQ6VXNlcjE0MjQ2Mjg=","avatar_url":"https://avatars.githubusercontent.com/u/1424628?v=4","gravatar_id":"","url":"https://api.github.com/users/Michael0x2a","html_url":"https://github.com/Michael0x2a","followers_url":"https://api.github.com/users/Michael0x2a/followers","following_url":"https://api.github.com/users/Michael0x2a/following{/other_user}","gists_url":"https://api.github.com/users/Michael0x2a/gists{/gist_id}","starred_url":"https://api.github.com/users/Michael0x2a/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Michael0x2a/subscriptions","organizations_url":"https://api.github.com/users/Michael0x2a/or