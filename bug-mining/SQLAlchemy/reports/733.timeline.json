\n+++ b/lib/sqlalchemy/sql/sqltypes.py\n@@ -1352,13 +1352,17 @@ class Enum(Emulated, String, SchemaType):\n         self.enums = list(values)\n \n         self._valid_lookup = dict(\n-            zip(objects, values)\n+            zip(reversed(objects), reversed(values))\n         )\n         self._object_lookup = dict(\n-            (value, key) for key, value in self._valid_lookup.items()\n+            zip(values, objects)\n         )\n+\n         self._valid_lookup.update(\n-            [(value, value) for value in self._valid_lookup.values()]\n+            [\n+                (value, self._valid_lookup[self._object_lookup[value]])\n+                for value in values\n+            ]\n         )\n \n     @property\n\n```\n\nthat gives you `self._object_lookup` with a mapping of the original keys to the objects and also gives you `_valid_lookup`  with a list of objects to the keys, and also original / aliased keys to original keys.\n","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/441940351/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.gi