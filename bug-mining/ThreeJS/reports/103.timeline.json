_comment_url":"https://api.github.com/repos/mrdoob/three.js/issues/comments{/number}","contents_url":"https://api.github.com/repos/mrdoob/three.js/contents/{+path}","compare_url":"https://api.github.com/repos/mrdoob/three.js/compare/{base}...{head}","merges_url":"https://api.github.com/repos/mrdoob/three.js/merges","archive_url":"https://api.github.com/repos/mrdoob/three.js/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/mrdoob/three.js/downloads","issues_url":"https://api.github.com/repos/mrdoob/three.js/issues{/number}","pulls_url":"https://api.github.com/repos/mrdoob/three.js/pulls{/number}","milestones_url":"https://api.github.com/repos/mrdoob/three.js/milestones{/number}","notifications_url":"https://api.github.com/repos/mrdoob/three.js/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/mrdoob/three.js/labels{/name}","releases_url":"https://api.github.com/repos/mrdoob/three.js/releases{/id}","deployments_url":"https://api.github.com/repos/mrdoob/three.js/deployments","created_at":"2010-03-23T18:58:01Z","updated_at":"2025-12-12T21:37:33Z","pushed_at":"2025-12-12T15:03:31Z","git_url":"git://github.com/mrdoob/three.js.git","ssh_url":"git@github.com:mrdoob/three.js.git","clone_url":"https://github.com/mrdoob/three.js.git","svn_url":"https://github.com/mrdoob/three.js","homepage":"https://threejs.org/","size":1541931,"stargazers_count":109825,"watchers_count":109825,"language":"JavaScript","has_issues":true,"has_projects":false,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":false,"forks_count":36156,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":609,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["3d","augmented-reality","canvas","html5","javascript","svg","virtual-reality","webaudio","webgl","webgl2","webgpu","webxr"],"visibility":"public","forks":36156,"open_issues":609,"watchers":109825,"default_branch":"dev","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Hello mrdoob,\n\nThanks for the great library!   I love Three.js. :)\n\nI just noticed that when adding texts to the CanvasRenderer's canvas, they are flipped upside down.\nMay be I'm doing something that is not supposed to...Anyhow just wanted to letting you know.\n\n```\nvar camera, scene, renderer;\ninit();\nanimate();\n\nfunction init() {           \n    camera = new THREE.PerspectiveCamera( 50, window.innerWidth / window.innerHeight, 1, 1000 );\n    camera.position.set(0, 0, 0);\n\n    scene = new THREE.Scene();\n\n    renderer = new THREE.CanvasRenderer();\n    renderer.setClearColor( 0xccccff );\n    renderer.setSize(300, 300);\n    renderer.domElement.setAttribute(\"id\", \"rendererCanvas\");\n    document.body.appendChild( renderer.domElement );\n}\n\nfunction animate() {\n    //requestAnimationFrame( animate );\n    render();\n    drawText(\"regularCanvas\", \"Text on regular canvas\");\n    drawText(\"rendererCanvas\", \"Text on CanvasRenderer's canvas\");\n}\n\nfunction render() {\n    renderer.render( scene, camera );\n}\n\nfunction drawText(canvasId, displayText){\n    var canvas = document.getElementById(canvasId);\n    if (canvas.getContext) {\n        ctx = canvas.getContext(\"2d\");\n        ctx.font = '12pt Calibri';\n        ctx.fillStyle = 'red';\n        ctx.textAlign = 'center';\n        ctx.fillText(displayText, 100, 100);\n    }else{\n        console.log(\"failed getting canvas\");\n    }\n}\n```\n","reactions":{"url":"https://api.github.com/repos/mrdoob/three.js/issues/5040/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/mrdoob/three.js/issues/5040/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event