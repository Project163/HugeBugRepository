s/repos","events_url":"https://api.github.com/users/GuidoHendriks/events{/privacy}","received_events_url":"https://api.github.com/users/GuidoHendriks/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-07-08T07:20:57Z","updated_at":"2015-07-08T07:20:57Z","body":"Quick example, please let me know if it’s enough. Here are the relevant parts of my models:\n\n**ProductsTable.php**\n\n```\nclass ProductsTable extends Table\n{\n    public function initialize(array $config)\n    {\n        $this->table(‘products’);\n        $this->belongsToMany(‘CategoryProperties’, [\n            ‘foreignKey’ => ‘product_id’,\n            ‘targetForeignKey’ => ‘category_property_id’,\n            ‘joinTable’ => ‘category_properties_products’\n        ]);\n    }\n}\n```\n\n**CategoryPropertiesTable.php**\n\n```\nclass CategoryPropertiesTable extends Table\n{\n    public function initialize(array $config)\n    {\n        $this->table(‘category_properties’);\n        $this->belongsToMany(‘Products’, [\n            ‘foreignKey’ => ‘category_property_id’,\n            ‘targetForeignKey’ => ‘product_id’,\n            ‘joinTable’ => ‘category_properties_products’\n        ]);\n    }\n}\n```\n\nNow this happens when creating / patching the entities:\n\n```\n$product = $this->Products->newEntity([\n    ‘name’ => ‘Foo’,\n    ‘price’ => 123,\n    ‘category_properties’ => [\n        [\n            ‘id’ => 1,\n            ‘_joinData’ => [\n                ‘value’ => ‘foo’\n            ]\n            // Added like it should. :)\n        ]\n    ]\n]);\n\n$this->Products->patchEntity($product, [\n    ‘name’ => ‘Foo’,\n    ‘price’ => 123,\n    ‘category_properties’ => [\n        [\n            ‘id’ => 1,\n            ‘_joinData’ => [\n                ‘value’ => ‘foo-123’\n            ]\n            // Updated like it should. :)\n        ],\n        [\n            ‘id’ => 3,\n            ‘_joinData’ => [\n                ‘value’ => ‘foo’\n            ]\n            // Added without the join data… :(\n        ],\n    ]\n], [\n    ‘associated’ => [‘CategoryProperties._joinData’]\n]);\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/119466598/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"GuidoHendriks","id":5393965,"node_id":"MDQ6VXNlcjUzOTM5NjU=","avatar_url":"https://avatars.githubusercontent.com/u/5393965?v=4","gravatar_id":"","url":"https://api.github.com/users/GuidoHendriks","html_url":"https://github.com/GuidoHendriks","followers_url":"https://api.github.com/users/GuidoHendriks/followers","following_url":"https://api.github.com/users/GuidoHendriks/following{/other_user}","gists_url":"https://api.github.com/users/GuidoHendriks/gists{/gist_id}","starred_url":"https://api.github.com/users/GuidoHendriks/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/GuidoHendriks/subscriptions","organizations_url":"https://api.github.com/users/GuidoHendriks/orgs","repos_url":"https://api.github.com/users/GuidoHendriks/repos","events_url":"https://api.github.com/users/GuidoHendriks/events{/privacy}","received_events_url":"https://api.github.com/users/GuidoHendriks/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":350997507,"node_id":"MDEyOkxhYmVsZWRFdmVudDM1MDk5NzUwNw==","url":"https://api.github.com/repos/cakephp/cakephp/issues/events/350997507","actor":{"login":"markstory","id":24086,"node_id":"MDQ6VXNlcjI0MDg2","avatar_url":"https://avatars.githubusercontent.com/u/24086?v=4","gravatar_id":"","url":"https://api.github.com/users/markstory","html_url":"https://github.com/markstory","followers_url":"https://api.github.com/users/markstory/followers","following_url":"https://api.github.com/users/markstory/following{/other_user}","gists_url":"https://api.github.com/users/markstory/gists{/gist