tle_report.txt)\n[subtitle_log.txt](https://github.com/google/ExoPlayer/files/397552/subtitle_log.txt)\n\nLet me know if there is any additional info I can send along. \n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/236964304/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"cstew","id":42011,"node_id":"MDQ6VXNlcjQyMDEx","avatar_url":"https://avatars.githubusercontent.com/u/42011?v=4","gravatar_id":"","url":"https://api.github.com/users/cstew","html_url":"https://github.com/cstew","followers_url":"https://api.github.com/users/cstew/followers","following_url":"https://api.github.com/users/cstew/following{/other_user}","gists_url":"https://api.github.com/users/cstew/gists{/gist_id}","starred_url":"https://api.github.com/users/cstew/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cstew/subscriptions","organizations_url":"https://api.github.com/users/cstew/orgs","repos_url":"https://api.github.com/users/cstew/repos","events_url":"https://api.github.com/users/cstew/events{/privacy}","received_events_url":"https://api.github.com/users/cstew/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/238189396","html_url":"https://github.com/google/ExoPlayer/issues/1712#issuecomment-238189396","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/1712","id":238189396,"node_id":"MDEyOklzc3VlQ29tbWVudDIzODE4OTM5Ng==","user":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/fo