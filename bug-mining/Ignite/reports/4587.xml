                    <description>&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
sqlline version 1.3.0
sqlline&amp;gt; !connect jdbc:ignite:thin:&lt;span class=&quot;code-comment&quot;&gt;//localhost
&lt;/span&gt;Enter username &lt;span class=&quot;code-keyword&quot;&gt;for&lt;/span&gt; jdbc:ignite:thin:&lt;span class=&quot;code-comment&quot;&gt;//localhost: 
&lt;/span&gt;Enter password &lt;span class=&quot;code-keyword&quot;&gt;for&lt;/span&gt; jdbc:ignite:thin:&lt;span class=&quot;code-comment&quot;&gt;//localhost: 
&lt;/span&gt;0: jdbc:ignite:thin:&lt;span class=&quot;code-comment&quot;&gt;//localhost&amp;gt; CREATE TABLE Person(ID INTEGER PRIMARY KEY,  NAME VARCHAR(100),  NAME
&lt;/span&gt;. . . . . . . . . . . . . . . .&amp;gt; VARCHAR(100),  AGE INTEGER (64));
No rows affected (0,229 seconds)
0: jdbc:ignite:thin:&lt;span class=&quot;code-comment&quot;&gt;//localhost&amp;gt; select * from person;
&lt;/span&gt;+--------------------------------+--------------------------------+--------------------------------+
|               ID               |              NAME              |              AGE               |
+--------------------------------+--------------------------------+--------------------------------+
+--------------------------------+--------------------------------+--------------------------------+
No rows selected (0,073 seconds)
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;This is on master branch. &quot;NAME VARCHAR(100)&quot; twice.&lt;/p&gt;</description>
