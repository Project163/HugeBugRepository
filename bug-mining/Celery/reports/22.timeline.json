ithub.com/repos/celery/celery/milestones{/number}","notifications_url":"https://api.github.com/repos/celery/celery/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/celery/celery/labels{/name}","releases_url":"https://api.github.com/repos/celery/celery/releases{/id}","deployments_url":"https://api.github.com/repos/celery/celery/deployments","created_at":"2009-04-24T11:31:24Z","updated_at":"2026-03-11T11:08:53Z","pushed_at":"2026-03-10T15:04:28Z","git_url":"git://github.com/celery/celery.git","ssh_url":"git@github.com:celery/celery.git","clone_url":"https://github.com/celery/celery.git","svn_url":"https://github.com/celery/celery","homepage":"https://docs.celeryq.dev","size":36397,"stargazers_count":28268,"watchers_count":28268,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":4989,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":772,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["amqp","python","python-library","python3","queue-tasks","queue-workers","queued-jobs","redis","redis-queue","sqs","sqs-queue","task-manager","task-runner","task-scheduler"],"visibility":"public","forks":4989,"open_issues":772,"watchers":28268,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/celery/celery/pulls/4437","html_url":"https://github.com/celery/celery/pull/4437","diff_url":"https://github.com/celery/celery/pull/4437.diff","patch_url":"https://github.com/celery/celery/pull/4437.patch","merged_at":"2017-12-12T07:36:03Z"},"body":"In https://github.com/celery/celery/issues/3323 a change was made to fix an error with nested chords which meant that chords with a header containing a single task were converted to chains.\r\n\r\nIn my opinion and those of many others (see linked tickets) this is a mis-feature. You define a chord body function expecting a list of results as its first argument, but if the header contains only a single element - as in a dynamically-generated list of header tasks - your callback function will fail.\r\n\r\nThis PR reverts that change to make chord behaviour more consistent.\r\n\r\nIt also fixes a problem with deeply-nested chords. As a nested chord is recursively evaluated, the `chord` option passed down always refers to the top-level chord, meaning the outermost chord ends up being resolved with the result of the innermost signature and chords in between are not executed properly.\r\n\r\nI've only got integration tests for this currently - they were easier to write, I'll look at how best to unit test this stuff as soon as I have time.\r\n\r\nThanks!\r\n\r\nOther tickets related to this issue: #4393 #4055 #3885 #3597 #3574 #3323","reactions":{"url":"https://api.github.com/repos/celery/celery/issues/4437/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/celery/celery/issues/4437/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":1382969638,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDEzODI5Njk2Mzg=","url":"https://api.github.com/repos/celery/celery/issues/events/1382969638","actor":{"login":"auvipy","id":6212603,"node_id":"MDQ6VXNlcjYyMTI2MDM=","avatar_url":"https://avatars.githubusercontent.com/u/6212603?v=4","gravatar_id":"","url":"https://api.github.com/users/auvipy","html_url":"https://github.com/auvipy","followers_url":"https://api.github.com/users/auvipy/followers","following_url":"https://api.github.com/users/auvipy/following{/other_user}","gists_url":"https://api.github.com/users/auvipy/gists{/gist_id}","star