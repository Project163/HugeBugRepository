<item>
            <title>[IGNITE-18766] Incorrect id check in ClusterGroupAdapter.forNodeId</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-18766</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;ClusterGroup.forNodeId checks &lt;b&gt;id&lt;/b&gt; in a loop instead of &lt;b&gt;id0&lt;/b&gt;:&lt;/p&gt;

&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
                &lt;span class=&quot;code-keyword&quot;&gt;for&lt;/span&gt; (UUID id0 : ids) {
                    &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; (contains(id))
                        nodeIds.add(id0);
                }
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;&lt;a href=&quot;https://github.com/apache/ignite/blob/3de1dc44f53ea510328badf6cb6b423fe6975bd8/modules/core/src/main/java/org/apache/ignite/internal/cluster/ClusterGroupAdapter.java#L461&quot; class=&quot;external-link&quot; target=&quot;_blank&quot; rel=&quot;nofollow noopener&quot;&gt;https://github.com/apache/ignite/blob/3de1dc44f53ea510328badf6cb6b423fe6975bd8/modules/core/src/main/java/org/apache/ignite/internal/cluster/ClusterGroupAdapter.java#L461&lt;/a&gt;&lt;/p&gt;

&lt;p&gt;The following unit test demonstrates the problem:&lt;/p&gt;


&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;
    @Test
    &lt;span class=&quot;code-keyword&quot;&gt;public&lt;/span&gt; void testProjectionWithBadId() {
        ClusterNode locNode = ignite.cluster().localNode();

        ClusterGroup prj = ignite.cluster().forNodeId(UUID.randomUUID(), locNode.id());
        Collection&amp;lt;ClusterNode&amp;gt; nodes = prj.nodes();

        assertEquals(1, nodes.size());
    }
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;(add to GridProjectionForCachesSelfTest)&lt;/p&gt;</description>
