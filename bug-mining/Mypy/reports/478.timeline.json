mypy/milestones{/number}","notifications_url":"https://api.github.com/repos/python/mypy/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/python/mypy/labels{/name}","releases_url":"https://api.github.com/repos/python/mypy/releases{/id}","deployments_url":"https://api.github.com/repos/python/mypy/deployments","created_at":"2012-12-07T13:30:23Z","updated_at":"2025-12-12T11:48:01Z","pushed_at":"2025-12-11T20:11:30Z","git_url":"git://github.com/python/mypy.git","ssh_url":"git@github.com:python/mypy.git","clone_url":"https://github.com/python/mypy.git","svn_url":"https://github.com/python/mypy","homepage":"https://www.mypy-lang.org/","size":77161,"stargazers_count":20064,"watchers_count":20064,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":3065,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":3124,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["linter","python","typechecker","types","typing"],"visibility":"public","forks":3065,"open_issues":3124,"watchers":20064,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/python/mypy/pulls/5461","html_url":"https://github.com/python/mypy/pull/5461","diff_url":"https://github.com/python/mypy/pull/5461.diff","patch_url":"https://github.com/python/mypy/pull/5461.patch","merged_at":"2018-08-14T16:41:30Z"},"body":"Fixes #5454 \r\n\r\nThis fixes few similar overload crash scenarios.\r\n\r\nThe idea is quite simple: previously during first phase of function analysis we only set the full name and added it to locals, while during the second phase we analysed the signature and the function body. This however doesn't work with overloads, since we want to collect all item types into a single `Overloaded(...)`. What I propose is to just move analysis of signature and the initialisers to the first phase. IMO this is more logical (we just want to postpone the bodies), and is more close to runtime semantics (especially the initialisers that are evaluated immediately during function definition).","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/5461/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/mypy/issues/5461/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":1788270519,"node_id":"MDExOkNsb3NlZEV2ZW50MTc4ODI3MDUxOQ==","url":"https://api.github.com/repos/python/mypy/issues/events/1788270519","actor":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2018-08-14T16:41:30Z","state_reason":null,"performed_via_github_app":null},{"id":1788270682,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDE3ODgyNzA2ODI=","url":"https://api.gith