+
+createNextDescribe(
+  'custom-app-render',
+  {
+    files: __dirname,
+    skipDeployment: true,
+    startCommand: 'node server.js',
+  },
+  ({ next }) => {
+    it.each(['/', '/render'])('should render %s', async (page) => {
+      const $ = await next.render$(page)
+      expect($('#page').data('page')).toBe(page)
+    })
+  }
+)
