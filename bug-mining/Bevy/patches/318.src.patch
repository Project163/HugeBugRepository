+        foo: T,
+        #[reflect(ignore)]
+        _ignored: NonReflect,
+    }
+
+    #[derive(Reflect, FromReflect)]
+    #[rustfmt::skip]
+    struct FromReflectGenericWithWhereNoTrailingComma<T>
+        where
+            T: Clone
+    {
+        foo: T,
+        #[reflect(ignore)]
+        _ignored: NonReflect,
