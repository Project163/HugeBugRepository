---+------\r\n         12 |  999\r\n         22 |    1\r\n 1234567890 | null\r\n         33 | null\r\n(4 rows)\r\ncqlsh:q> select count(b) from t1;\r\n system.count(b)\r\n-----------------\r\n               2\r\n(1 rows)\r\ncqlsh:q> select sum(b) from t1;\r\n system.sum(b)\r\n---------------\r\n          1000\r\n(1 rows)\r\n```\r\n\r\n\r\nFor TEXT b:\r\n```create table t2 (a int primary key, b text);\r\ncqlsh:q> select * from t2;\r\n a  | b\r\n----+------\r\n 55 |  aaa\r\n 44 | null\r\n 66 |  bbb\r\n 33 | null\r\n(4 rows)\r\ncqlsh:q> select count(*) from t2;\r\n count\r\n-------\r\n     4\r\n(1 rows)\r\ncqlsh:q> select count(a) from t2;\r\n system.count(a)\r\n-----------------\r\n               4\r\n(1 rows)\r\ncqlsh:q> select count(b) from t2;\r\n system.count(b)\r\n-----------------\r\n               2\r\n(1 rows)\r\ncqlsh:q> select sum(b) from t2;\r\nInvalidRequest: Error from server: code=2200 [Invalid query] message=\"Query error: Invalid Function Call. Failed calling 'sum(text)'. Not found: Signature mismatch in call to builtin function 'sum'\r\nselect sum(b) from t2;\r\n       ^^^\r\n (error -214)\"\r\ncqlsh:q> select min(b) from t2;\r\n system.min(b)\r\n---------------\r\n           aaa\r\n(1 rows)\r\ncqlsh:q> select max(b) from t2;\r\n system.max(b)\r\n---------------\r\n           bbb\r\n(1 rows)\r\n```\r\nThe cases look correct.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/469245489/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"OlegLoginov","id":31254529,"node_id":"MDQ6VXNlcjMxMjU0NTI5","avatar_url":"https://avatars.githubusercontent.com/u/31254529?v=4","gravatar_id":"","url":"https://api.github.com/users/OlegLoginov","html_url":"https://github.com/OlegLoginov","followers_url":"https://api.github.com/users/OlegLoginov/followers","following_url":"https: