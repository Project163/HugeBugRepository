re features"}],"state":"closed","locked":false,"assignee":{"login":"ttyusupov","id":903044,"node_id":"MDQ6VXNlcjkwMzA0NA==","avatar_url":"https://avatars.githubusercontent.com/u/903044?v=4","gravatar_id":"","url":"https://api.github.com/users/ttyusupov","html_url":"https://github.com/ttyusupov","followers_url":"https://api.github.com/users/ttyusupov/followers","following_url":"https://api.github.com/users/ttyusupov/following{/other_user}","gists_url":"https://api.github.com/users/ttyusupov/gists{/gist_id}","starred_url":"https://api.github.com/users/ttyusupov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ttyusupov/subscriptions","organizations_url":"https://api.github.com/users/ttyusupov/orgs","repos_url":"https://api.github.com/users/ttyusupov/repos","events_url":"https://api.github.com/users/ttyusupov/events{/privacy}","received_events_url":"https://api.github.com/users/ttyusupov/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"ttyusupov","id":903044,"node_id":"MDQ6VXNlcjkwMzA0NA==","avatar_url":"https://avatars.githubusercontent.com/u/903044?v=4","gravatar_id":"","url":"https://api.github.com/users/ttyusupov","html_url":"https://github.com/ttyusupov","followers_url":"https://api.github.com/users/ttyusupov/followers","following_url":"https://api.github.com/users/ttyusupov/following{/other_user}","gists_url":"https://api.github.com/users/ttyusupov/gists{/gist_id}","starred_url":"https://api.github.com/users/ttyusupov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ttyusupov/subscriptions","organizations_url":"https://api.github.com/users/ttyusupov/orgs","repos_url":"https://api.github.com/users/ttyusupov/repos","events_url":"https://api.github.com/users/ttyusupov/events{/privacy}","received_events_url":"https://api.github.com/users/ttyusupov/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2019-07-02T10:31:01Z","updated_at":"2019-07-04T19:51:51Z","closed_at":"2019-07-04T19:51:51Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"`TSTabletManager` has a global memory monitor which runs flushes on tablets when rocksdb memory usage exceeds `global_memstore_size_mb_max` (or `global_memstore_size_percentage` in case `global_memstore_size_mb_max` is not set).\r\nThe tablet to flush in this case is selected based on the oldest write to memstore. For this reason, each tablet has a `TabletFlushStats`instance which is monitoring writes and flushes and tracking `oldest_write_in_memstore`. `TabletFlushStats::OnFlushScheduled` resets `oldest_write_in_memstore`to max value, this was supposed to prevent empty tablets from participating in selection for flush. But in reality, `TabletFlushStats::OnFlushScheduled` is called from `DBImpl::SchedulePendingFlush` even if there is no pending flush to schedule. In its turn, `DBImpl::SchedulePendingFlush` could be called after compaction, rocksdb opening, deleting obsolete SST files. This will reset `oldest_write_in_memstore` to max value for the tablet and if there are no further writes to tablet - the tablet will never be picked for flush by tserver memory monitor.","closed_by":{"login":"ttyusupov","id":903044,"node_id":"MDQ6VXNlcjkwMzA0NA==","avatar_url":"https://avatars.githubusercontent.com/u/903044?v=4","gravatar_id":"","url":"https://api.github.com/users/ttyusupov","html_url":"https://github.com/ttyusupov","followers_url":"https://api.github.com/users/ttyusupov/followers","following_url":"https://api.github.com/users/ttyusupov/following{/other_user}","gists_url":"https://api.github.com/users/ttyusupov/gists{/gist_id}","starred_url":"https://api.github.com/users/ttyusupov/starred{/owner}{/repo}","subscriptions_url":"https:/