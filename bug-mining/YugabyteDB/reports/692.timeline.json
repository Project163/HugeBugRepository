/repos","events_url":"https://api.github.com/users/Huqicheng/events{/privacy}","received_events_url":"https://api.github.com/users/Huqicheng/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-08-17T16:55:37Z","updated_at":"2022-08-17T16:55:37Z","body":"`readable_to_offset_` is updated in `UpdateSegmentReadableOffset` when doing `Log::Sync`.\r\n\r\n`UpdateIndexForBatch` is done in `Log::DoAppend` which happens earlier.\r\n\r\nThere is a gap between setting op index and update the readable offset, which seems cause the issue.\r\n\r\nSetting up a unit test for verification.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1218272048/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Huqicheng","id":31775227,"node_id":"MDQ6VXNlcjMxNzc1MjI3","avatar_url":"https://avatars.githubusercontent.com/u/31775227?v=4","gravatar_id":"","url":"https://api.github.com/users/Huqicheng","html_url":"https://github.com/Huqicheng","followers_url":"https://api.github.com/users/Huqicheng/followers","following_url":"https://api.github.com/users/Huqicheng/following{/other_user}","gists_url":"https://api.github.com/users/Huqicheng/gists{/gist_id}","starred_url":"https://api.github.com/users/Huqicheng/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Huqicheng/subscriptions","organizations_url":"https://api.github.com/users/Huqicheng/orgs","repos_url":"https://api.github.com/users/Huqicheng/repos","events_url":"https://api.github.com/users/Huqicheng/events{/privacy}","received_events_url":"https://api.github.com/users/Huqicheng/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1218346892","html_url":"https://github.com/yugabyte/yugabyte-db/issues/13627#issuecomment-1218346892","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/13627","id":1218346892,"node_id":"IC_kwDOBlCVUc5Inn-M","user":{"login":"Huqicheng","id":31775227,"node_id":"MDQ6VXNlcjMxNzc1MjI3","avatar_url":"https://avatars.githubusercontent.com/u/31775227?v=4","gravatar_id":"","url":"https://api.github.com/users/Huqicheng","html_url":"https://github.com/Huqicheng","followers_url":"https://api.github.com/users/Huqicheng/followers","following_url":"https://api.github.com/users/Huqicheng/following{/other_user}","gists_url":"https://api.github.com/users/Huqicheng/gists{/gist_id}","starred_url":"https://api.github.com/users/Huqicheng/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Huqicheng/subscriptions","organizations_url":"https://api.github.com/users/Huqicheng/orgs","repos_url":"https://api.github.com/users/Huqicheng/repos","events_url":"https://api.github.com/users/Huqicheng/events{/privacy}","received_events_url":"https://api.github.com/users/Huqicheng/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-08-17T18:16:36Z","updated_at":"2022-08-17T18:16:36Z","body":"Set up a test for reproducing same error.\r\n\r\n```\r\nTEST_F(LogTest, TestLogNotReadable) {\r\n  BuildLog();\r\n\r\n  FLAGS_TEST_pause_before_sync = true;\r\n\r\n  // Append 1 replicate pair asynchronously with appender.\r\n  AppendReplicateBatchToLog(1, AppendSync::kFalse);\r\n\r\n  // Wait for log index is written.\r\n  sleep(5);\r\n\r\n  const auto log_index = CHECK_RESULT(log_->GetLogReader()->TEST_GetIndexEntry(1));\r\n  ASSERT_EQ(log_index.op_id.index, 1);\r\n\r\n  faststring tmp_buf;\r\n  LogEntryBatchPB batch;\r\n  Status s = log_->GetLogReader()->ReadBatchUsingIndexEntry(log_index, &tmp_buf,  &batch);\r\n  LOG(INFO) << s;\r\n  ASSERT_NOK(s);\r\n\r\n  FLAGS_TEST_pause_before_sync = false;\r\n}\r\n```\r\n\r\n```\r\nI0817 18:13:30.002017 339791 log-test.cc:819] Corruption (yb/consensus/log_util.cc:912): Failed to read LogEntry for index 1 from log segment 1 offset 153: Could not read 176-byte log entry from offset 165 in /tmp/yb_test.tmp.24113.31049.26374.pid339728/log-test.LogTest.TestLogNotReadable.1660760004989037-339791/fs_root/yb-data/tserver_test/wals/table-test-log-table/tablet-test-log-tablet/wal-000000001: log only readable up to offset 153\r\n```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1218346892/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Huqicheng","id":31775227,"node_id":"MDQ6VXNlcjMxNzc1MjI3","avatar_url":"https://avatars.githubusercontent.com/u/31775227?v=4","gravatar_id":"","url":"https://api.github.com/users/Huqicheng","html_url":"https://github.com/Huqicheng","followers_url":"https://api.github.com/users/Huqicheng/followers","following_url":"https://api.github.com/users/Huqicheng/following{/other_user}","gists_url":"https://api.github.com/users/Huqicheng/gists{/gist_id}","starred_url":"https://api.github.com/users/Huqicheng/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Huqicheng/subscriptions","organizations_url":"https://api.github.com/users/Huqicheng/orgs","repos_url":"https://api.github.com/users/Huqicheng/repos","events_url":"https://api.github.com/users/Huqicheng/events{/privacy}","received_events_url":"https://api.github.com/users/Huqicheng/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1221460459","html_url":"https://github.com/yugabyte/yugabyte-db/issues/13627#issuecomment-1221460459","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/13627","id":1221460459,"node_id":"IC_kwDOBlCVUc5IzgHr","user":{"login":"Huqicheng","id":31775227,"node_id":"MDQ6VXNlcjMxNzc1MjI3","avatar_url":"https://avatars.githubusercontent.com/u/31775227?v=4","gravatar_id":"","url":"https://api.github.com/users/Huqicheng","html_url":"https://github.com/Huqicheng","followers_url":"https://api.github.com/users/Huqicheng/followers","following_url":"https://api.github.com/users/Huqicheng/following{/other_user}","gists_url":"https://api.github.com/users/Huqicheng/gists{/gist_id}","starred_url":"https://api.github.com/users/Huqicheng/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Huqicheng/subscriptions","organizations_url":"https://api.github.com/users/Huqicheng/orgs","repos_url":"https://api.github.com/users/Huqicheng/repos","events_url":"https://api.github.com/users/Huqicheng/events{/privacy}","received_events_url":"https://api.github.com/users/Huqicheng/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-08-21T03:34:15Z","updated_at":"2022-08-21T23:21:28Z","body":"The scenario described above might happen but not the real root cause because the LogCache should be expected to protect it with min_pinned_op_index_ and any index >= min_pinned_op_index_ shouldn't be evicted from the cache. But in this case, from the wal file, we get\r\n```\r\n13.5@6800808162097811456\tREPLICATE NO_OP, SIZE: 26\r\n\tid { term: 13 index: 5 } hybrid_time: 6800808162097811456 op_type: NO_OP committed_op_id { term: 12 index: 4 } noop_request { }\r\n19.6@6800809148036087808\tREPLICATE NO_OP, SIZE: 26\r\n\tid { term: 19 index: 6 } hybrid_time: 6800809148036087808 op_type: NO_OP committed_op_id { term: 12 index: 4 } noop_request { }\r\n22.5@6800810362737205248\tREPLICATE NO_OP, SIZE: 26\r\n\tid { term: 22 index: 5 } hybrid_time: 6800810362737205248 op_type: NO_OP committed_op_id { term: 12 index: 4 } noop_request { }\r\n24.6@6800825019105226752\tREPLICATE NO_OP, SIZE: 26\r\n\tid { term: 24 index: 6 } hybrid_time: 6800825019105226752 op_type: NO_OP committed_op_id { term: 22 index: 5 } noop_request { }\r\n```\r\nwe have 19.6 persisted so that min_pinned_op_index_ is already 7 so the cache entry could be evicted and read from disk which is not synced yet.\r\n\r\n```cpp\r\nvoid LogCache::LogCallback(int64_t last_idx_in_batch,\r\n                           const StatusCallback& user_callback,\r\n                           const Status& log_status) {\r\n  if (log_status.ok()) {\r\n    std::lock_guard<simple_spinlock> l(lock_);\r\n    if (min_pinned_op_index_ <= last_idx_in_batch) {\r\n      VLOG_WITH_PREFIX_UNLOCKED(1) << \"Updating pinned index to \" << (last_idx_in_batch + 1);\r\n      min_pinned_op_index_ = last_idx_in_batch + 1;\r\n    }\r\n  }\r\n  user_callback.Run(log_status);\r\n}\r\n```\r\nIt's set in LogCallback when replicated it locally but will not set back if a lower index comes in when leader change happens.\r\n\r\nSeems we should make it always up to date to make sure later logs with lower index will not be evicted before it's synced to disk.\r\n\r\nThe test case can represent the scenario above:\r\n```cpp\r\nTEST_F(LogCacheTest, TestNotReadableLogInCache) {\r\n  // Write one NoOp and wait sync done, min_pinned_op_index_ should be 2.\r\n  ASSERT_OK(AppendReplicateMessagesToCache(1, 1));\r\n  ASSERT_OK(log_->WaitUntilAllFlushed());\r\n\r\n  FLAGS_TEST_pause_before_wal_sync = true;\r\n\r\n  // Overwrite the op to simulate the leader change.\r\n  ASSERT_OK(AppendReplicateMessagesToCache(1, 1));\r\n\r\n  ASSERT_OK(WaitFor([&]() -> Result<bool>{\r\n    return log_->GetLogReader()->LookupOpId(1).ok();\r\n  }, 20s * kTimeMultiplier, \"Waiting for having first op in log segment.\"));\r\n\r\n  // 1 < min_pinned_op_index_ so that it can be evicted.\r\n  cache_->EvictThroughOp(1);\r\n\r\n  // ReadOps can not read op from cache, instead will read from disk, but sync is not done,\r\n  // readable_to_offset_ is still not updated.\r\n  ASSERT_OK(cache_->ReadOps(0, 8_MB));\r\n}\r\n```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1221460459/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Huqicheng","id":31775227,"node_id":"MDQ6VXNlcjMxNzc1MjI3","avatar_url":"https://avatars.githubusercontent.com/u/31775227?v=4","gravatar_id":"","url":"https://api.github.com/users/Huqicheng","html_url":"https://github.com/Huqicheng","followers_url":"https://api.github.com/users/Huqicheng/followers","following_url":"https://api.github.com/users/Huqicheng/following{/other_user}","gists_url":"https://api.github.com/users/Huqicheng/gists{/gist_id}","starred_url":"https://api.github.com/users/Huqicheng/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Huqicheng/subscriptions","organizations_url":"https://api.github.com/users/Huqicheng/orgs","repos_url":"https://api.github.com/users/Huqicheng/repos","events_url":"https://api.github.com/users/Huqicheng/events{/privacy}","received_events_url":"https://api.github.com/users/Huqicheng/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":7237716228,"node_id":"REFE_lADOBlCVUc5PytRlzwAAAAGvZskE","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/7237716228","actor":{"login":"Huqicheng","id":31775227,"node_id":"MDQ6VXNlcjMxNzc1MjI3","avatar_url":"https://avatars.githubusercontent.com/u/31775227?v=4","gravatar_id":"","url":"https://api.github.com/users/Huqicheng","html_url":"https://github.com/Huqicheng","followers_url":"https://api.github.com/users/Huqicheng/followers","following_url":"https://api.github.com/users/Huqicheng/following{/other_user}","gists_url":"https://api.github.com/users/Huqicheng/gists{/gist_id}","starred_url":"https://api.github.com/users/Huqicheng/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Huqicheng/subscriptions","organizations_url":"https://api.github.com/users/Huqicheng/orgs","repos_url":"