[{"id":2631445252,"node_id":"MDEyOkxhYmVsZWRFdmVudDI2MzE0NDUyNTI=","url":"https://api.github.com/repos/curl/curl/issues/events/2631445252","actor":{"login":"bagder","id":177011,"node_id":"MDQ6VXNlcjE3NzAxMQ==","avatar_url":"https://avatars.githubusercontent.com/u/177011?v=4","gravatar_id":"","url":"https://api.github.com/users/bagder","html_url":"https://github.com/bagder","followers_url":"https://api.github.com/users/bagder/followers","following_url":"https://api.github.com/users/bagder/following{/other_user}","gists_url":"https://api.github.com/users/bagder/gists{/gist_id}","starred_url":"https://api.github.com/users/bagder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bagder/subscriptions","organizations_url":"https://api.github.com/users/bagder/orgs","repos_url":"https://api.github.com/users/bagder/repos","events_url":"https://api.github.com/users/bagder/events{/privacy}","received_events_url":"https://api.github.com/users/bagder/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2019-09-13T07:32:00Z","label":{"name":"SCP/SFTP","color":"bfd4f2"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/curl/curl/issues/comments/531141971","html_url":"https://github.com/curl/curl/issues/4344#issuecomment-531141971","issue_url":"https://api.github.com/repos/curl/curl/issues/4344","id":531141971,"node_id":"MDEyOklzc3VlQ29tbWVudDUzMTE0MTk3MQ==","user":{"login":"bagder","id":177011,"node_id":"MDQ6VXNlcjE3NzAxMQ==","avatar_url":"https://avatars.githubusercontent.com/u/177011?v=4","gravatar_id":"","url":"https://api.github.com/users/bagder","html_url":"https://github.com/bagder","followers_url":"https://api.github.com/users/bagder/followers","following_url":"https://api.github.com/users/bagder/following{/other_user}","gists_url":"https://api.github.com/users/bagder/gists{/gist_id}","starred_url":"https://api.github.com/users/bagder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bagder/subscriptions","organizations_url":"https://api.github.com/users/bagder/orgs","repos_url":"https://api.github.com/users/bagder/repos","events_url":"https://api.github.com/users/bagder/events{/privacy}","received_events_url":"https://api.github.com/users/bagder/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-09-13T08:05:16Z","updated_at":"2019-09-13T08:05:16Z","body":"The SFTP protocol doesn't have a concept of \"read until eof\". It instead reads a block of data from a specified offset. To read a full file numerous such read instructions are sent to the server.\r\n\r\ncurl starts out by checking the file size of the remote file and then iterates through and ask for block after block until its done. To take account for that the server *lies* about the size, or that the size changes during the transfer, curl would have to either do size checks during transfer or just try reading beyond the (supposedly known) file size to see if that works.\r\n\r\nIt can certainly be done, but is not something curl does now. With any of the SSH backends.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/curl/curl/issues/comments/531141971/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"bagder","id":177011,"node_id":"MDQ6VXNlcjE3NzAxMQ==","avatar_url":"https://avatars.githubusercontent.com/u/177011?v=4","gravatar_id":"","url":"https://api.github.com/users/bagder","html_url":"https://github.com/bagder","followers_url":"https://api.github.com/users/bagder/followers","following_url":"https://api.github.com/users/bagder/following{/other_user}","gists_url":"https://api.github.com/users/bagder/gists{/gist_id}","starred_url":"https://api.github.com/users/bagder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bagder/subscriptions","organizations_url":"https://api.github.com/users/bagder/orgs","repos_url":"https://api.github.com/users/bagder/repos","events_url":"https://api.github.com/users/bagder/events{/privacy}","received_events_url":"https://api.github.com/users/bagder/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/curl/curl/issues/comments/531240218","html_url":"https://github.com/curl/curl/issues/4344#issuecomment-531240218","issue_url":"https://api.github.com/repos/curl/curl/issues/4344","id":531240218,"node_id":"MDEyOklzc3VlQ29tbWVudDUzMTI0MDIxOA==","user":{"login":"Ben-Voris","id":31499002,"node_id":"MDQ6VXNlcjMxNDk5MDAy","avatar_url":"https://avatars.githubusercontent.com/u/31499002?v=4","gravatar_id":"","url":"https://api.github.com/users/Ben-Voris","html_url":"https://github.com/Ben-Voris","followers_url":"https://api.github.com/users/Ben-Voris/followers","following_url":"https://api.github.com/users/Ben-Voris/following{/other_user}","gists_url":"https://api.github.com/users/Ben-Voris/gists{/gist_id}","starred_url":"https://api.github.com/users/Ben-Voris/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ben-Voris/subscriptions","organizations_url":"https://api.github.com/users/Ben-Voris/orgs","repos_url":"https://api.github.com/users/Ben-Voris/repos","events_url":"https://api.github.com/users/Ben-Voris/events{/privacy}","received_events_url":"https://api.github.com/users/Ben-Voris/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-09-13T13:37:49Z","updated_at":"2019-09-13T13:37:49Z","body":"As shown, when run directly, sftp reads until the server returns no more data. (The eof indicator is that read returns a count of zero.) So, curl has added an unnecessary dependency, at least for sftp. ","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/curl/curl/issues/comments/531240218/reactio