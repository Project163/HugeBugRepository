byte/yugabyte-db/git/commits{/sha}","comments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/comments{/number}","issue_comment_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments{/number}","contents_url":"https://api.github.com/repos/yugabyte/yugabyte-db/contents/{+path}","compare_url":"https://api.github.com/repos/yugabyte/yugabyte-db/compare/{base}...{head}","merges_url":"https://api.github.com/repos/yugabyte/yugabyte-db/merges","archive_url":"https://api.github.com/repos/yugabyte/yugabyte-db/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/yugabyte/yugabyte-db/downloads","issues_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues{/number}","pulls_url":"https://api.github.com/repos/yugabyte/yugabyte-db/pulls{/number}","milestones_url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones{/number}","notifications_url":"https://api.github.com/repos/yugabyte/yugabyte-db/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels{/name}","releases_url":"https://api.github.com/repos/yugabyte/yugabyte-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Jira Link: [DB-504](https://yugabyte.atlassian.net/browse/DB-504)\r\n### Description\r\n\r\nTo add the unit tests that helps simulate scenarios like #11932 easily, we should extend the test framework in src/test/isolation to run statements in multiple connections simultaneously.\r\n\r\nFor example, in the test yb_pg_skip-locked-2.spec, we run a few permutations, one of which is -\r\n`permutation \"s1a\" \"s2a\" \"s2b\" \"s1b\" \"s2c\"`\r\n\r\nIn this s2a is issued only after s1a either completes or waits. We might want to test a scenario where s2a is issued simultaneously with s1a (which can be done because these are run in separate sessions).\r\n\r\nA syntax like follows with curly braces can be devised, that helps users instruct isolationtester.c which statements to issue in parallel. This will also require someway by which the user can specify the different possible outcomes of the same test in the .out file.\r\n\r\n`permutation {\"s1a\" \"s2a\"} \"s2b\" \"s1b\" \"s2c\"`\r\n\r\nhttps://github.com/yugabyte/yugabyte-db/blob/master/src/postgres/src/test/isolation/README\r\n","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/11935/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/11935/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":6358574653,"node_id":"AE_lADOBlCVUc5GvnS0zwAAAAF7ACY9","url":"https://api.github.com/repos/yuga