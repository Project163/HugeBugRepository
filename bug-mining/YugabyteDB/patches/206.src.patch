-void SecureStream::Established(SecureState state) {
-  VLOG_WITH_PREFIX(4) << "Established with state: " << state;
-
-  state_ = state;
-  ResetLogPrefix();
-  context_->Connected();
-  for (auto& data : pending_data_) {
-    Send(std::move(data));
-  }
-  pending_data_.clear();
-}
