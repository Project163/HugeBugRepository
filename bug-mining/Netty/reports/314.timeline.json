sers/Teots/events{/privacy}","received_events_url":"https://api.github.com/users/Teots/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2014-04-18T09:37:37Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/netty/netty/issues/comments/40798703","html_url":"https://github.com/netty/netty/issues/2400#issuecomment-40798703","issue_url":"https://api.github.com/repos/netty/netty/issues/2400","id":40798703,"node_id":"MDEyOklzc3VlQ29tbWVudDQwNzk4NzAz","user":{"login":"Teots","id":2549326,"node_id":"MDQ6VXNlcjI1NDkzMjY=","avatar_url":"https://avatars.githubusercontent.com/u/2549326?v=4","gravatar_id":"","url":"https://api.github.com/users/Teots","html_url":"https://github.com/Teots","followers_url":"https://api.github.com/users/Teots/followers","following_url":"https://api.github.com/users/Teots/following{/other_user}","gists_url":"https://api.github.com/users/Teots/gists{/gist_id}","starred_url":"https://api.github.com/users/Teots/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Teots/subscriptions","organizations_url":"https://api.github.com/users/Teots/orgs","repos_url":"https://api.github.com/users/Teots/repos","events_url":"https://api.github.com/users/Teots/events{/privacy}","received_events_url":"https://api.github.com/users/Teots/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-04-18T09:48:03Z","updated_at":"2014-04-18T09:48:03Z","body":"Sure you can. Here we go:\n\n```\n// channel is passed into the function and is of type Channel\nif (channel instanceof LocalChannel) {\n   Class<?> clazz = channel.getClass();\n   Field stateField = clazz.getDeclaredField(\"state\");\n   stateField.setAccessible(true);\n   stateField.setInt(channel, 3);\n}\n\nchannel.deregister().addListener(new ChannelFutureListener() {\n   @Override\n   public void operationComplete(ChannelFuture future) throws Exception {\n      try {\n        Channel channel = future.channel();\n        EventLoopGroup eventLoopGroup = \n        if (channel instanceof LocalChannel) {\n           eventLoopGroup = Helper.localInputEventLoopGroup;\n\n           Class<?> clazz = channel.getClass();\n           Field stateField = clazz.getDeclaredField(\"state\");\n           stateField.setAccessible(true);\n           stateField.setInt(channel, 0);\n\n           Field peerField = clazz.getDeclaredField(\"peer\");\n           peerField.setAccessible(true);\n           LocalChannel peer = (LocalChannel) peerField.get(channel);\n\n           Field connectPromiseField = clazz.getDeclaredField(\"connectPromise\");\n           connectPromiseField.setAccessible(true);\n           connectPromiseField.set(peer, peer.unsafe().voidPromise());\n\n           // Change event loop group.\n           eventLoopGroup.register(channel).sync();\n        } else {\n           eventLoopGroup = Helper.networkInputEventLoopGroup;\n\n           // Change event loop group.\n           eventLoopGroup.register(channel).sync();\n        }\n\n         // Enable auto read again.\n         channel.config().setAutoRead(true);\n      } catch (Throwable t) {\n        LOG.error(t.getLocalizedMessage(), t);\n      }\n   }\n}).sync();\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/netty/netty/issues/comments/40798703/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Teots","id":2549326,"node_id":"MDQ6VXNlcjI1NDkzMjY=","avatar_url":"https://avatars.githubusercontent.com/u/2549326?v=4","gravatar_id":"","url":"https://api.github.com/users/Teots","html_url":"https://github.com/Teots","followers_url":"https://api.github.com/users/Teots/followers","following_url":"https://api.github.com/users/Teots/following{/other_user}","gists_url":"https://api.github.com/users/Teots/gis