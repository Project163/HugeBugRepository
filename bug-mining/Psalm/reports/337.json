endencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"https://getpsalm.org/r/75fc67974a\r\n\r\n```php\r\n<?php\r\n  /** \r\n   * @param mixed $data\r\n   * @throws \\Exception\r\n   */\r\n  function assertIsLongString($data): void {\r\n     if (!is_string($data)) {\r\n       throw new Exception;\r\n     }\r\n     if (strlen($data) < 100) {\r\n       throw new Exception;\r\n     }\r\n  }\r\n  \r\n  /**\r\n   * @throws Exception\r\n   */\r\n  function f(string $s): void {\r\n    assertIsLongString($s);\r\n  }\r\n```\r\nHere, Psalm complains the call to `assert*` is redundant, as it can only figure out the types asserted. However it actually is totally not redundant, as other factors are checked as well.","closed_by":{"login":"muglug","id":2292638,"node_id":"MDQ6VXNlcjIyOTI2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/2292638?v=4","gravatar_id":"","url":"https://api.github.com/users/muglug","html_url":"https://github.com/muglug","followers_url":"https://api.github.com/users/muglug/followers","following_url":"https://api.github.com/users/muglug/following{/other_user}","gists_url":"https://api.github.com/users/muglug/gists{/gist_id}","starred_url":"https://api.github.com/users/muglug/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/muglug/subscriptions","organizations_url":"https://api.github.com/users/muglug/orgs","repos_url":"https://api.github.com/users/muglug/repos","events_url":"https://api.github.com/users/muglug/events{/privacy}","received_events_url":"https://api.github.com/users/muglug/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/1095/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vimeo/psalm/issues/1095/timeline","performed_via_github_app":null,"state_reason":"completed"}