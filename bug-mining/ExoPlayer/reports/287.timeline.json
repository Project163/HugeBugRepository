fused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/349768902","html_url":"https://github.com/google/ExoPlayer/issues/3534#issuecomment-349768902","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/3534","id":349768902,"node_id":"MDEyOklzc3VlQ29tbWVudDM0OTc2ODkwMg==","user":{"login":"zsmatyas","id":8737074,"node_id":"MDQ6VXNlcjg3MzcwNzQ=","avatar_url":"https://avatars.githubusercontent.com/u/8737074?v=4","gravatar_id":"","url":"https://api.github.com/users/zsmatyas","html_url":"https://github.com/zsmatyas","followers_url":"https://api.github.com/users/zsmatyas/followers","following_url":"https://api.github.com/users/zsmatyas/following{/other_user}","gists_url":"https://api.github.com/users/zsmatyas/gists{/gist_id}","starred_url":"https://api.github.com/users/zsmatyas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zsmatyas/subscriptions","organizations_url":"https://api.github.com/users/zsmatyas/orgs","repos_url":"https://api.github.com/users/zsmatyas/repos","events_url":"https://api.github.com/users/zsmatyas/events{/privacy}","received_events_url":"https://api.github.com/users/zsmatyas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-12-06T20:44:12Z","updated_at":"2017-12-06T20:44:12Z","body":"All these alignment options in 608Decoder are based on assumptions what the content provider intended to achieve by adding whitespaces around the text. As the negative value is caused by incorrect content, we should probably not trust the values and the safest could be center alignment for Pop-on captioning mode. But other modes cannot be center aligned, the only other common mode is Roll-up, always left aligned.\r\nSo something like this:\r\n\r\n```\r\n@@ -726,7 +726,7 @@ public final class Cea608Decoder extends CeaDecoder {\r\n       // The number of empty columns after the end of the text, in the same range.\r\n       int endPadding = SCREEN_CHARWIDTH - startPadding - cueString.length();\r\n       int startEndPaddingDelta = startPadding - endPadding;\r\n-      if (captionMode == CC_MODE_POP_ON && Math.abs(startEndPaddingDelta) < 3) {\r\n+      if (captionMode == CC_MODE_POP_ON && (endPadding < 0 || (Math.abs(startEndPaddingDelta) < 3 && startPadding > 0))) {\r\n         // Treat approximately centered pop-on captions are middle aligned.\r\n         position = 0.5f;\r\n         positionAnchor = Cue.ANCHOR_TYPE_MIDDLE;\r\n```\r\nNote: also added the condition suggested in https://github.com/google/ExoPlayer/issues/3533","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/349768902/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zsmatyas","id":8737074,"node_id":"MDQ6VXNlcjg3MzcwNzQ=","avatar_url":"https://avatars.githubusercontent.com/u/8737074?v=4","gravatar_id":""