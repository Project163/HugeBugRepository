diff --git a/lib/rules/object-curly-spacing.js b/lib/rules/object-curly-spacing.js
index 7c531f963..572b83826 100644
--- a/lib/rules/object-curly-spacing.js
+++ b/lib/rules/object-curly-spacing.js
@@ -45,7 +45,7 @@ module.exports = function(context) {
     * @returns {void}
     */
     function reportNoBeginningSpace(node, token) {
-        context.report(node, token.loc.start,
+        context.report(node, token.loc.end,
             "There should be no space after '" + token.value + "'");
     }
 
@@ -67,7 +67,7 @@ module.exports = function(context) {
     * @returns {void}
     */
     function reportRequiredBeginningSpace(node, token) {
-        context.report(node, token.loc.start,
+        context.report(node, token.loc.end,
             "A space is required after '" + token.value + "'");
     }
 
