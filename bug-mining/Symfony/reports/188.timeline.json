y/symfony.git","clone_url":"https://github.com/symfony/symfony.git","svn_url":"https://github.com/symfony/symfony","homepage":"https://symfony.com","size":314248,"stargazers_count":30844,"watchers_count":30844,"language":"PHP","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":9759,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":811,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["bundle","framework","hacktoberfest","php","php-framework","symfony","symfony-bundle"],"visibility":"public","forks":9759,"open_issues":811,"watchers":30844,"default_branch":"8.1","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/symfony/symfony/pulls/39263","html_url":"https://github.com/symfony/symfony/pull/39263","diff_url":"https://github.com/symfony/symfony/pull/39263.diff","patch_url":"https://github.com/symfony/symfony/pull/39263.patch","merged_at":"2020-12-01T12:10:27Z"},"body":"| Q             | A\r\n| ------------- | ---\r\n| Branch?       | 5.2 (bug not here in 5.1.x)\r\n| Bug fix?      | yes\r\n| New feature?  | no\r\n| Deprecations? | no\r\n| Tickets       | Fix #39262\r\n| License       | MIT\r\n| Doc PR        | /\r\n\r\nThis proposed fix makes `PasswordMigratingListener` code more robust. It should handle Passports which does not contain an `UserBadge`, as it is not enforced by `UserPassportInterface`. Developers should be free to implement different passports with different badges (as I did on my own project), and it shouldn't lead to a crash in *frameworkland*.\r\n\r\nThe issue became apparent in 5.2.0 exactly, as `PasswordMigratingListener` is now called in (almost) every login, as `PasswordUpgradeBadge` is automatically added.","reactions":{"url":"https://api.github.com/repos/symfony/symfony/issues/39263/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/symfony/symfony/issues/39263/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/symfony/symfony/issues/comments/736374213","html_url":"https://github.com/symfony/symfony/issues/39262#issuecomment-736374213","issue_url":"https://api.github.com/repos/symfony/symfony/issues/39262","id":736374213,"node_id":"MDEyOklzc3VlQ29tbWVudDczNjM3NDIxMw==","user":{"login":"romaricdrigon","id":919405,"node_id":"MDQ6VXNlcjkxOTQwNQ==","avatar_url":"https://avatars.githubusercontent.com/u/919405?v=4","gravatar_id":"","url":"https://api.github.com/users/romaricdrigon","html_url":"https://github.com/romaricdrigon","followers_url":"https://api.github.com/users/romaricdrigon/followers","following_url":"https://api.github.com/users/romaricdrigon/following{/other_user}","gists_url":"https://api.github.com/users/romaricdrigon/gists{/gist_id}","starred_url":"https://api.github.com/users/romaricdrigon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/romaricdrigon/subscriptions","organizations_url":"https://api.github.com/users/romaricdrigon/orgs","repos_url":"https://api.github.com/users/romaricdrigon/repos","events_url":"https://api.github.com/users/romaricdrigon/events{/privacy}","received_events_url":"https://api.github.com/users/romaricdrigon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-12-01T10:09:18Z","updated_at":"2020-12-01T10:09:18Z","body":"This issue is that this BC layer is within `Passport` ; nothing forbids a developer from implementing its own Passport (actually, I did), and then nothing in `UserPassportInterface` guides him. IMO, `UserPassportInterface` should be modified to enforce p