pos/rails/rails/issues/events/125179777","actor":{"login":"rails-bot","id":7468109,"node_id":"MDQ6VXNlcjc0NjgxMDk=","avatar_url":"https://avatars.githubusercontent.com/u/7468109?v=4","gravatar_id":"","url":"https://api.github.com/users/rails-bot","html_url":"https://github.com/rails-bot","followers_url":"https://api.github.com/users/rails-bot/followers","following_url":"https://api.github.com/users/rails-bot/following{/other_user}","gists_url":"https://api.github.com/users/rails-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/rails-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rails-bot/subscriptions","organizations_url":"https://api.github.com/users/rails-bot/orgs","repos_url":"https://api.github.com/users/rails-bot/repos","events_url":"https://api.github.com/users/rails-bot/events{/privacy}","received_events_url":"https://api.github.com/users/rails-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2014-05-27T16:25:18Z","state_reason":null,"performed_via_github_app":null},{"url":"https://api.github.com/repos/rails/rails/issues/comments/50643822","html_url":"https://github.com/rails/rails/issues/7640#issuecomment-50643822","issue_url":"https://api.github.com/repos/rails/rails/issues/7640","id":50643822,"node_id":"MDEyOklzc3VlQ29tbWVudDUwNjQzODIy","user":{"login":"EverybodyKurts","id":879734,"node_id":"MDQ6VXNlcjg3OTczNA==","avatar_url":"https://avatars.githubusercontent.com/u/879734?v=4","gravatar_id":"","url":"https://api.github.com/users/EverybodyKurts","html_url":"https://github.com/EverybodyKurts","followers_url":"https://api.github.com/users/EverybodyKurts/followers","following_url":"https://api.github.com/users/EverybodyKurts/following{/other_user}","gists_url":"https://api.github.com/users/EverybodyKurts/gists{/gist_id}","starred_url":"https://api.github.com/users/EverybodyKurts/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/EverybodyKurts/subscriptions","organizations_url":"https://api.github.com/users/EverybodyKurts/orgs","repos_url":"https://api.github.com/users/EverybodyKurts/repos","events_url":"https://api.github.com/users/EverybodyKurts/events{/privacy}","received_events_url":"https://api.github.com/users/EverybodyKurts/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-07-30T16:43:36Z","updated_at":"2014-07-30T16:45:18Z","body":"Ran in to the same problem today :(. Does anybody have a workaround?\n\nIf I ran the `after_rollback` callback without `on: :destroy`, is there a way to see that `destroy` was called for the record?\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/rails/rails/issues/comments/50643822/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"EverybodyKurts","id":879734,"node_id":"MDQ6VXNlcjg3OTczNA==","avatar_url":"https://avatars.githubusercontent.com/u/879734?v=4","gravatar_id":"","url":"https://api.github.com/users/EverybodyKurts","html_url":"https://github.com/EverybodyKurts","followers_url":"https://api.github.com/users/EverybodyKurts/followers","following_url":"https://api.github.com/users/EverybodyKurts/following{/other_user}","gists_url":"https://api.github.com/users/EverybodyKurts/gists{/gist_id}","starred_url":"https://api.github.com/users/EverybodyKurts/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/EverybodyKurts/subscriptions","organizations_url":"https://api.github.com/users/EverybodyKurts/orgs","repos_url":"https://api.github.com/users/EverybodyKurts/repos","events_url":"https://api.github.com/users/EverybodyKurts/events{/privacy}","received_events_url":"https://api.github.com/users/EverybodyKurts/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/rails/rails/issues/comments/50650712","html_url":"https://github.com/rails/rails/issues/7640#issuecomment-50650712","issue_url":"https://api.github.com/repos/rails/rails/issues/7640","id":50650712,"node_id":"MDEyOklzc3VlQ29tbWVudDUwNjUwNzEy","user":{"login":"EverybodyKurts","id":879734,"node_id":"MDQ6VXNlcjg3OTczNA==","avatar_url":"https://avatars.githubusercontent.com/u/879734?v=4","gravatar_id":"","url":"https://api.github.com/users/EverybodyKurts","html_url":"https://github.com/EverybodyKurts","followers_url":"https://api.github.com/users/EverybodyKurts/followers","following_url":"https://api.github.com/users/EverybodyKurts/following{/other_user}","gists_url":"https://api.github.com/users/EverybodyKurts/gists{/gist_id}","starred_url":"https://api.github.com/users/EverybodyKurts/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/EverybodyKurts/subscriptions","organizations_url":"https://api.github.com/users/EverybodyKurts/orgs","repos_url":"https://api.github.com/users/EverybodyKurts/repos","events_url":"https://api.github.com/users/EverybodyKurts/events{/privacy}","received_events_url":"https://api.github.com/users/EverybodyKurts/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-07-30T17:31:29Z","updated_at":"2014-07-30T17:33:14Z","body":"Here's my _current_ workaround:\n\n``` ruby\nclass Enrollment < ActiveRecord::Base\n  # Callbacks\n  # ---------------------------------------------------------\n\n  before_destroy :cancel_destroy\n  after_rollback :set_as_inactive\n\n  private\n\n  def set_as_inactive\n    if @destroy_attempted\n      write_attribute(:active, false)\n      @destroy_attempted = false\n      save!\n    end\n  end\n\n\n  # Enrollments are never actually deleted - they are just set to inactive.\n  def cancel_destroy\n    @destroy_attempted = true\n\n    false\n  end\nend\n```\n\nBy the way, I would love it if somebody pointed out anything wrong or potentially dangerous about this.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/rails/rails/issues/comments/50650712/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"EverybodyKurts","id":879734,"node_id":"MDQ6VXNlcjg3OTczNA==","avatar_url":"https://avatars.githubusercontent.com/u/879734?v=4","gravatar_id":"","url":"https://api.github.com/users/EverybodyKurts","html_url":"https://github.com/EverybodyKurts","followers_url":"https://api.github.com/users/EverybodyKurts/followers","following_url":"https://api.github.com/users/EverybodyKurts/following{/other_user}","gists_url":"https://api.github.com/users/EverybodyKurts/gists{/gist_id}","starred_url":"https://api.github.com/users/EverybodyKurts/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/EverybodyKurts/subscriptions","organizations_url":"https://api.github.com/users/EverybodyKurts/orgs","repos_url":"https://api.github.com/users/EverybodyKurts/repos","events_url":"https://api.github.com/users/EverybodyKurts/events{/privacy}","received_events_url":"https://api.github.com/users/EverybodyKurts/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/rails/rails/issues/comments/50666289","html_url":"https://github.com/rails/rails/issues/7640#issuecomment-50666289","issue_url":"https://api.github.com/repos/rails/rails/issues/7640","id":50666289,"node_id":"MDEyOklzc3VlQ29tbWVudDUwNjY2Mjg5","user":{"login":"al2o3cr","id":1191,"node_id":"MDQ6VXNlcjExOTE=","avatar_url":"https://avatars.githubusercontent.com/u/1191?v=4","gravatar_id":"","url":"https://api.github.com/users/al2o3cr","html_url":"https://github.com/al2o3cr","followers_url":"https://api.github.com/users/al2o3cr/followers","following_url":"https://api.github.com/users/al2o3cr/following{/other_user}","gists_url":"https://api.github.com/