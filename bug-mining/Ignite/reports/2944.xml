                <link>https://issues.apache.org/jira/browse/IGNITE-6859</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;&lt;b&gt;What happens:&lt;/b&gt;&lt;br/&gt;
