-apps/tauri/releases{/id}","deployments_url":"https://api.github.com/repos/tauri-apps/tauri/deployments","created_at":"2019-07-13T09:09:37Z","updated_at":"2025-12-13T06:22:21Z","pushed_at":"2025-12-12T22:06:32Z","git_url":"git://github.com/tauri-apps/tauri.git","ssh_url":"git@github.com:tauri-apps/tauri.git","clone_url":"https://github.com/tauri-apps/tauri.git","svn_url":"https://github.com/tauri-apps/tauri","homepage":"https://tauri.app","size":100473,"stargazers_count":99901,"watchers_count":99901,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":3226,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1282,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["desktop-app","high-performance","mobile-app","native-app","rust","web-frontend","webview"],"visibility":"public","forks":3226,"open_issues":1282,"watchers":99901,"default_branch":"dev","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/tauri-apps/tauri/pulls/10039","html_url":"https://github.com/tauri-apps/tauri/pull/10039","diff_url":"https://github.com/tauri-apps/tauri/pull/10039.diff","patch_url":"https://github.com/tauri-apps/tauri/pull/10039.patch","merged_at":"2024-06-12T01:25:11Z"},"body":"This fixes the first problem mentioned in #10022: SVG text nodes are generally not rendering in `cargo tauri icon`.\r\n\r\nAfter applying this patch, it should be observed that running `cargo tauri icon` against an SVG with a `<text>` node no longer warns about not finding fonts that exist on a (Linux) system. Further, visually reviewing the resulting image files created should now show text rendered.\r\n\r\nHowever, the correct font is still not selected for generic font-families on Linux systems that are using `fontconfig`. This includes \"_sans-serif_\", \"_sans_\", \"_comic_\", etc. In reviewing the [fontdb](/RazrFalcon/fontdb) library, which is used for font selection, I found that the font that the library selects for generic families is not the one that `fc-match` selects. There is no warning associated here, the user would have to visually confirm that this is the case.\r\n\r\nThe fontdb team is aware of the issue and has an open issue for it:\r\n[fontdb: Support automatic determination of default family names on Linux from fontconfig #24](/RazrFalcon/fontdb/issues/24)\r\n\r\nFor the time being, I would recommend explicitly defining the exact font to use in an SVG, which is typically the case anyway. Of course, distributing the font with the SVG would ensure better cross-platform compatibility regardless.\r\n","reactions":{"url":"https://api.github.com/repos/tauri-apps/tauri/issues/10039/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/tauri-apps/tauri/issues/10039/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/tauri-apps/tauri/issues/comments/2161523364","html_url":"https://github.com/tauri-apps/tauri/issues/10022#issuecomment-2161523364","issue_url":"https://api.github.com/repos/tauri-apps/tauri/issues/10022","id":2161523364,"node_id":"IC_kwDOC7lts86A1jqk","user":{"login":"roylaurie","id":281087,"node_id":"MDQ6VXNlcjI4MTA4Nw==","avatar_url":"https://avatars.githubusercontent.com/u/281087?v=4","gravatar_id":"","url":"https://api.github.com/users/roylaurie","html_url":"https://github.com/roylaurie","followers_url":"https://api.github.com/users/roylaurie/followers","following_url":"https://api.github.com/users/roylaurie/following{/other_user}","gists_url":"https://api.github.com/users/roylauri