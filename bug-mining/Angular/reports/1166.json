er","user_view_type":"public","site_admin":false},"open_issues":680,"closed_issues":22796,"state":"open","created_at":"2018-01-18T16:52:20Z","updated_at":"2026-03-11T06:25:22Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2018-07-31T08:28:48Z","updated_at":"2020-07-27T16:13:07Z","closed_at":"2020-06-26T21:54:21Z","assignee":null,"author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## I'm submitting a...\r\n<!-- Check one of the following options with \"x\" -->\r\n<pre><code>\r\n[ ] Regression (a behavior that used to work and stopped working in a new release)\r\n[X] Bug report  <!-- Please search GitHub for a similar issue or PR before submitting -->\r\n[ ] Performance issue\r\n[ ] Feature request\r\n[ ] Documentation issue or request\r\n[ ] Support request => Please do not submit support request here, instead see https://github.com/angular/angular/blob/master/CONTRIBUTING.md#question\r\n[ ] Other... Please describe:\r\n</code></pre>\r\n\r\n## Current behavior\r\nIf [innerHTML] is used in a component and the Content-Security-Policy does not allow inline styles, a CSP violation will be reported by Firefox (but not by Chrome).\r\n\r\nThis is similar to AngularJS issue https://github.com/angular/angular.js/issues/16463 (also reported by me) and I think the current behaviour was introduced in https://github.com/angular/angular/pull/17019 .\r\n\r\n## Expected behavior\r\nIt should be possible to use [innerHTML] in all supported browsers without automatically triggering a CSP violation.\r\n\r\n## Minimal reproduction of the problem with instructions\r\nSee: https://stackblitz.com/edit/angular-gitter-8kfndn\r\n\r\n1. Set a Content-Security-Policy which does not allow inline styles.\r\n2. Use [innerHTML] in a component\r\n3. Open with Firefox.\r\n\r\nNote: Some CSP violations are generated by Stackblitz itself and should be ignored. If the example div with [innerHTML] is removed the last two CSP violations will disappear.\r\n\r\n## What is the motivation / use case for changing the behavior?\r\nIn our application we want to use a strict CSP which does not allow inline styles. We also want CSP reports (via report-uri) whenever the CSP is violated. The current behaviour generates a large number of false positives since all our Firefox users always send a CSP report.\r\n\r\n\r\n## Environment\r\n\r\n<pre><code>\r\nAngular version: 6.1.0\r\n<!-- Check whether this is still an issue in the most recent Angular version -->\r\n\r\nBrowser:\r\n- [ ] Chrome (desktop) version 68.0.3440.75\r\n- [X] Firefox version 62.0b12\r\n\r\n","closed_by":{"login":"AndrewKushnir","id":43554145,"node_id":"MDQ6VXNlcjQzNTU0MTQ1","avatar_url":"https://avatars.githubusercontent.com/u/43554145?v=4","gravatar_id":"","url":"https://api.github.com/users/AndrewKushnir","html_url":"https://github.com/AndrewKushnir","followers_url":"https://api.github.com/users/AndrewKushnir/followers","following_url":"https://api.github.com/users/AndrewKushnir/following{/other_user}","gists_url":"https://api.github.com/users/AndrewKushnir/gists{/gist_id}","starred_url":"https://api.github.com/users/AndrewKushnir/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AndrewKushnir/subscriptions","organizations_url":"https://api.github.com/users/AndrewKushnir/orgs","repos_url":"https://api.github.com/users/AndrewKushnir/repos","events_url":"https://api.github.com/users/AndrewKushnir/events{/privacy}","received_events_url":"https://api.github.com/users/AndrewKushnir/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/25214/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/angul