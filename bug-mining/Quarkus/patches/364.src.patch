+                        final BranchResult if1 = mc.ifNonZero(mc.invokeVirtualMethod(NI_HAS_NEXT, keyIter));
+                        try (BytecodeCreator true1 = if1.trueBranch()) {
+                            true1.invokeVirtualMethod(NI_NEXT, keyIter);
