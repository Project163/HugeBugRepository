],"state":"closed","locked":false,"assignee":{"login":"ttyusupov","id":903044,"node_id":"MDQ6VXNlcjkwMzA0NA==","avatar_url":"https://avatars.githubusercontent.com/u/903044?v=4","gravatar_id":"","url":"https://api.github.com/users/ttyusupov","html_url":"https://github.com/ttyusupov","followers_url":"https://api.github.com/users/ttyusupov/followers","following_url":"https://api.github.com/users/ttyusupov/following{/other_user}","gists_url":"https://api.github.com/users/ttyusupov/gists{/gist_id}","starred_url":"https://api.github.com/users/ttyusupov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ttyusupov/subscriptions","organizations_url":"https://api.github.com/users/ttyusupov/orgs","repos_url":"https://api.github.com/users/ttyusupov/repos","events_url":"https://api.github.com/users/ttyusupov/events{/privacy}","received_events_url":"https://api.github.com/users/ttyusupov/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"ttyusupov","id":903044,"node_id":"MDQ6VXNlcjkwMzA0NA==","avatar_url":"https://avatars.githubusercontent.com/u/903044?v=4","gravatar_id":"","url":"https://api.github.com/users/ttyusupov","html_url":"https://github.com/ttyusupov","followers_url":"https://api.github.com/users/ttyusupov/followers","following_url":"https://api.github.com/users/ttyusupov/following{/other_user}","gists_url":"https://api.github.com/users/ttyusupov/gists{/gist_id}","starred_url":"https://api.github.com/users/ttyusupov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ttyusupov/subscriptions","organizations_url":"https://api.github.com/users/ttyusupov/orgs","repos_url":"https://api.github.com/users/ttyusupov/repos","events_url":"https://api.github.com/users/ttyusupov/events{/privacy}","received_events_url":"https://api.github.com/users/ttyusupov/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2020-04-27T18:23:04Z","updated_at":"2020-05-23T10:35:32Z","closed_at":"2020-05-23T10:35:32Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Deadlock can occur between Heartbeater and Raft threads during tablet split applying:\r\n1) `Heartbeater::Thread` calls `TSTabletManager::GetLeaderCount` which holds `TSTabletManager::lock_` and under that lock is trying to lock `ReplicaState` for read.\r\n2) `TSTabletManager::ApplyTabletSplit` is called under `ReplicaState` locked for update and calling `TSTabletManager:: StartTabletStateTransitionForCreation` which is locking `TSTabletManager::lock_`.\r\n3) `TSTabletManager::ApplyTabletSplit` is also calling `TSTabletManager::CreateAndRegisterTabletPeer` which calls `TSTabletManager::RegisterTablet` which is locking `TSTabletManager::lock_`.\r\n","closed_by":{"login":"ttyusupov","id":903044,"node_id":"MDQ6VXNlcjkwMzA0NA==","avatar_url":"https://avatars.githubusercontent.com/u/903044?v=4","gravatar_id":"","url":"https://api.github.com/users/ttyusupov","html_url":"https://github.com/ttyusupov","followers_url":"https://api.github.com/users/ttyusupov/followers","following_url":"https://api.github.com/users/ttyusupov/following{/other_user}","gists_url":"https://api.github.com/users/ttyusupov/gists{/gist_id}","starred_url":"https://api.github.com/users/ttyusupov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ttyusupov/subscriptions","organizations_url":"https://api.github.com/users/ttyusupov/orgs","repos_url":"https://api.github.com/users/ttyusupov/repos","events_url":"https://api.github.com/users/ttyusupov/events{/privacy}","received_events_url":"https://api.github.com/users/ttyusupov/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/4312/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/4312/timeline","performed_via_github_app":null,"state_reason":"completed"}