+        Set<String> roles = identity.getRoles();
+        if (roles != null) {
+            for (String role : allowedRoles) {
+                if (roles.contains(role)) {
+                    return;
+                }
+            }
+        }
+        if (identity.isAnonymous()) {
+            throw new UnauthorizedException();
+        } else {
+            throw new ForbiddenException();
+        }
+    }
+}
