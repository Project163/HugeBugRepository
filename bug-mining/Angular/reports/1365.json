s://api.github.com/users/IgorMinar/events{/privacy}","received_events_url":"https://api.github.com/users/IgorMinar/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":681,"closed_issues":22796,"state":"open","created_at":"2018-01-18T16:52:20Z","updated_at":"2026-03-11T09:12:24Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2019-10-22T17:16:27Z","updated_at":"2021-06-25T16:08:12Z","closed_at":"2021-05-25T22:09:57Z","assignee":{"login":"josephperrott","id":10864441,"node_id":"MDQ6VXNlcjEwODY0NDQx","avatar_url":"https://avatars.githubusercontent.com/u/10864441?v=4","gravatar_id":"","url":"https://api.github.com/users/josephperrott","html_url":"https://github.com/josephperrott","followers_url":"https://api.github.com/users/josephperrott/followers","following_url":"https://api.github.com/users/josephperrott/following{/other_user}","gists_url":"https://api.github.com/users/josephperrott/gists{/gist_id}","starred_url":"https://api.github.com/users/josephperrott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/josephperrott/subscriptions","organizations_url":"https://api.github.com/users/josephperrott/orgs","repos_url":"https://api.github.com/users/josephperrott/repos","events_url":"https://api.github.com/users/josephperrott/events{/privacy}","received_events_url":"https://api.github.com/users/josephperrott/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"\r\n# 🚀 feature request\r\n\r\n### Relevant Package\r\n@angular/cli\r\n\r\n### Description\r\nThe documentation around library creation[ suggests](https://angular.io/guide/creating-libraries#use-typescript-path-mapping-for-peer-dependencies) listing all @angular/* dependencies as peer dependencies. \r\n\r\n#### Problem\r\nBut, the user has to do this manually.\r\n\r\n#### Solution\r\n\r\nI suggest that if you are creating a library only project via the ng commands, Angular should do this for the user automatically in the tsconfig.json along with a code comment describing why and pointing them to the relevant documentation.\r\n\r\nHere's an example creating a library this way as described in [Angular Workspace: No Application for You!](https://blog.angularindepth.com/angular-workspace-no-application-for-you-4b451afcc2ba)\r\n\r\nng new foo-lib --create-application=false\r\ncd foo-lib\r\nng generate library foo-lib --prefix=foo\r\n\r\n\r\n### Describe alternatives you've considered\r\n\r\n- Have the ng build command for a library inform the user that they should really set the @angular packages as peer dependencies and point them to the relevant documentation.\r\n- Have users search StackOverflow when they run into a problem and are scratching their heads about a mismatched dependency.\r\n\r\n","closed_by":{"login":"zarend","id":7720245,"node_id":"MDQ6VXNlcjc3MjAyNDU=","avatar_url":"https://avatars.githubusercontent.com/u/7720245?v=4","gravatar_id":"","url":"https://api.github.com/users/zarend","html_url":"https://github.com/zarend","followers_url":"https://api.github.com/users/zarend/followers","following_url":"https://api.github.com/users/zarend/following{/other_user}","gists_url":"https://api.github.com/users/zarend/gists{/gist_id}","starred_url":"https://api.github.com/users/zarend/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zarend/subscriptions","organizations_url":"https://api.github.com/users/zarend/orgs","repos_url":"https://api.github.com/users/zarend/repos","events_url":"https://api.github.com/users/zarend/events{/privacy}","received_events_url":"https://api.github.com/users/zarend/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/37304/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/angular/angular/issues/37304/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}