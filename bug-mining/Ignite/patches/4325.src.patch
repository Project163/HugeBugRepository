+
+    /** {@inheritDoc} */
+    @Override public void init(long initUpdCntr, @Nullable byte[] cntrUpdData) {
+        super.init(initUpdCntr, cntrUpdData);
+
+        log.debug("[op=init" +
+            ", grpId=" + grp.groupId() +
