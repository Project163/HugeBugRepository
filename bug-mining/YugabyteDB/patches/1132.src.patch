diff --git a/src/postgres/src/backend/replication/slot.c b/src/postgres/src/backend/replication/slot.c
index 862fc4acb7..3121b1996f 100644
--- a/src/postgres/src/backend/replication/slot.c
+++ b/src/postgres/src/backend/replication/slot.c
@@ -1288,8 +1288,17 @@ StartupReplicationSlots(void)
 			continue;
 		}
 
-		/* looks like a slot in a normal state, restore */
-		RestoreSlotFromDisk(replication_de->d_name);
+		/*
+		 * YB Note: We do not store the replication slot metadata on disk. This
+		 * directory is only used for storing spilled large txns by the
