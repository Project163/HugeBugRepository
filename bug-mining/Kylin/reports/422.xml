<item>
            <title>[KYLIN-6037] Metadata migration fails when the backup metadata contains an &quot;upgrade&quot; directory</title>
                <link>https://issues.apache.org/jira/browse/KYLIN-6037</link>
                <project id="12316121" key="KYLIN">Kylin</project>
                    <description></description>
                <environment></environment>
        <key id="13609020">KYLIN-6037</key>
            <summary>Metadata migration fails when the backup metadata contains an &quot;upgrade&quot; directory</summary>
                <type id="1" iconUrl="https://issues.apache.org/jira/secure/viewavatar?size=xsmall&amp;avatarId=21133&amp;avatarType=issuetype">Bug</type>
