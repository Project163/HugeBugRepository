atars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/441940906","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/4216#issuecomment-441940906","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/4216","id":441940906,"node_id":"MDEyOklzc3VlQ29tbWVudDQ0MTk0MDkwNg==","user":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-03-12T19:01:56Z","updated_at":"2018-11-27T06:19:07Z","body":"**Michael Bayer ([@zzzeek](https://github.com/zzzeek)) wrote:**\n\nusers can work around this issue for now using ``TypeDecorator``:\n\n\n```\nfrom sqlalchemy import Column, Integer, create_engine, TypeDecorator\nfrom sqlalchemy.sql import operators\nfrom sqlalchemy.orm import Session\nfrom sqlalchemy.sql.expression import UnaryExpression, BindParameter\nfrom sqlalchemy.ext.declarative import declarative_base\nfrom sqlalchemy.dialects import mysql\n\nBase = declarative_base()\n\n\nclass SafeBlob(TypeDecorator):\n    impl = mysql.BLOB\n\n    def bind_expression(self, bindvalue):\n        # future-proof for #3981\n        if isinstance(bindvalue, BindParameter):\n            return UnaryExpression(\n                bindvalue, operator=operators.custom_op(\"_binary\")\n            )\n        else:\n            return bindvalue\n\n\nclass A(Base):\n    __tablename__ = 'a'\n    id = Column(Integer, primary_key=True)\n    city = Column(SafeBlob())\n\ne = create_engine(\"mysql://scott:tiger@mysql57/test?charset=utf8mb4\", echo=True)\nBase.metadata.drop_all(e)\nBase.metadata.create_all(e)\n\ndata = b'z\\xf9\\x87jS?\\xd4i\\xa5\\xa3\\r\\xa7\\x1e\\xed\\x16\\xe0\\xb5\\x05R\\xa4\\xec\\x16\\x8f\\x06\\xb5\\xea+\\xaf<\\x00\\\\\\x94I9A\\xe0\\x82\\xa7\\x13\\x0c\\x8c'\ns = Session(e)\ns.add(A(city=data))\ns.commit()\n\n```\n","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/441940906/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MD