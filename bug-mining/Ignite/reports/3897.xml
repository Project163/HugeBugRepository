&lt;p&gt;    &lt;a href=&quot;https://github.com/apache/ignite/pull/5074&quot; class=&quot;external-link&quot; target=&quot;_blank&quot; rel=&quot;nofollow noopener&quot;&gt;https://github.com/apache/ignite/pull/5074&lt;/a&gt;&lt;/p&gt;

&lt;p&gt;    &lt;a href=&quot;https://issues.apache.org/jira/browse/IGNITE-9622&quot; title=&quot;MVCC Cache API: prohibit non PESSIMISTIC REPEATABLE_READ transactions&quot; class=&quot;issue-link&quot; data-issue-key=&quot;IGNITE-9622&quot;&gt;&lt;del&gt;IGNITE-9622&lt;/del&gt;&lt;/a&gt;: MVCC Cache API: prohibit non PESSIMISTIC REPEATABLE_READ transactions&lt;/p&gt;



