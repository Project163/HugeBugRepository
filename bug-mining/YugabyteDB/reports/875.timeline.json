rgsans-yb/following{/other_user}","gists_url":"https://api.github.com/users/gargsans-yb/gists{/gist_id}","starred_url":"https://api.github.com/users/gargsans-yb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gargsans-yb/subscriptions","organizations_url":"https://api.github.com/users/gargsans-yb/orgs","repos_url":"https://api.github.com/users/gargsans-yb/repos","events_url":"https://api.github.com/users/gargsans-yb/events{/privacy}","received_events_url":"https://api.github.com/users/gargsans-yb/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-09-27T15:50:47Z","updated_at":"2022-09-27T15:50:47Z","body":"Hi @zuohuadong, as I can see that while starting the nodes in their respective VMs, `--base_dir` flag was also used. \r\nThis caused all the data, configs and logs to be stored at the given location. \r\nThen while running `./bin/yugabyted configure` command, the `--base_dir` wasn't provided, so it tried to check the default directory, which is `~/var`. \r\nYou should run the configure command along with the `--base_dir`.\r\nTry:\r\n```\r\n./bin/yugabyted configure --base_dir=/home/yugabyte --fault_tolerance=zone\r\n```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1259703049/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"gargsans-yb","id":41946894,"node_id":"MDQ6VXNlcjQxOTQ2ODk0","avatar_url":"https://avatars.githubusercontent.com/u/41946894?v=4","gravatar_id":"","url":"https://api.github.com/users/gargsans-yb","html_url":"https://github.com/gargsans-yb","followers_url":"https://api.github.com/users/gargsans-yb/followers","following_url":"https://api.github.com/users/gargsans-yb/following{/other_user}","gists_url":"https://api.github.com/users/gargsans-yb/gists{/gist_id}","starred_url":"https