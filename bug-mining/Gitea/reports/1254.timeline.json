ine.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/go-gitea/gitea/issues/comments/1614599584/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"pmandalka","id":93120661,"node_id":"U_kgDOBYzolQ","avatar_url":"https://avatars.githubusercontent.com/u/93120661?v=4","gravatar_id":"","url":"https://api.github.com/users/pmandalka","html_url":"https://github.com/pmandalka","followers_url":"https://api.github.com/users/pmandalka/followers","following_url":"https://api.github.com/users/pmandalka/following{/other_user}","gists_url":"https://api.github.com/users/pmandalka/gists{/gist_id}","starred_url":"https://api.github.com/users/pmandalka/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pmandalka/subscriptions","organizations_url":"https://api.github.com/users/pmandalka/orgs","repos_url":"https://api.github.com/users/pmandalka/repos","events_url":"https://api.github.com/users/pmandalka/events{/privacy}","received_events_url":"https://api.github.com/users/pmandalka/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/go-gitea/gitea/issues/comments/1614602527","html_url":"https://github.com/go-gitea/gitea/issues/25564#issuecomment-1614602527","issue_url":"https://api.github.com/repos/go-gitea/gitea/issues/25564","id":1614602527,"node_id":"IC_kwDOBFIx285gPOEf","user":{"login":"KN4CK3R","id":1666336,"node_id":"MDQ6VXNlcjE2NjYzMzY=","avatar_url":"https://avatars.githubusercontent.com/u/1666336?v=4","gravatar_id":"","url":"https://api.github.com/users/KN4CK3R","html_url":"https://github.com/KN4CK3R","followers_url":"https://api.github.com/users/KN4CK3R/followers","following_url":"https://api.github.com/users/KN4CK3R/following{/other_user}","gists_url":"https://api.github.com/users/KN4CK3R/gists{/gist_id}","starred_url":"https://api.github.co