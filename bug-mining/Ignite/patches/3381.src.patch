+    private void startSimpleLoadThread(
+        IgniteEx ig,
+        String cacheName,
+        AtomicBoolean stopFlag,
+        AtomicReference<Throwable> loadError,
+        ConcurrentMap<Long, Long> threadProgressTracker
+    ) {
