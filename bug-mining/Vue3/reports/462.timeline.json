jY3NTIzOA==","avatar_url":"https://avatars.githubusercontent.com/u/675238?v=4","gravatar_id":"","url":"https://api.github.com/users/bgondy","html_url":"https://github.com/bgondy","followers_url":"https://api.github.com/users/bgondy/followers","following_url":"https://api.github.com/users/bgondy/following{/other_user}","gists_url":"https://api.github.com/users/bgondy/gists{/gist_id}","starred_url":"https://api.github.com/users/bgondy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bgondy/subscriptions","organizations_url":"https://api.github.com/users/bgondy/orgs","repos_url":"https://api.github.com/users/bgondy/repos","events_url":"https://api.github.com/users/bgondy/events{/privacy}","received_events_url":"https://api.github.com/users/bgondy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-03-06T16:53:30Z","updated_at":"2024-03-06T16:57:42Z","body":"Any update on this issue ?\r\n\r\nI've created a reproduction link (library mode) : https://stackblitz.com/edit/vitejs-vite-zz3d8x?file=dist%2Fmy-lib.js&view=editor and I've noticed a weird case. \r\n\r\nWhen typing using TypeScript AND setting `type` option, the property is duplicated : \r\n\r\n```vue\r\n<script setup lang=\"ts\">\r\nconst a = defineModel<boolean>('a');\r\nconst b = defineModel<string>('b');\r\nconst c = defineModel<string | boolean>('c');\r\nconst d = defineModel<string | boolean>('d', { type: [String, Boolean] });\r\nconst e = defineModel('e', {type: [String, Boolean]});\r\n</script>\r\n```\r\n\r\n```js\r\n// lib output\r\nimport { defineComponent as t, useModel as o } from 'vue';\r\nconst n = /* @__PURE__ */ t({\r\n  __name: 'SampleComponent',\r\n  props: {\r\n    a: { type: Boolean },\r\n    aModifiers: {},\r\n    b: {},\r\n    bModifiers: {},\r\n    c: { type: Boolean }, // <-- Should be {type: [String, Boolean] }\r\n    cModifiers: {},\r\n    d: { type: Boolean, type: [String, Boolean] }, // <-- type property is duplicated with different values\r\n    dModifiers: {},\r\n    e: { type: [String, Boolean] },\r\n    eModifiers: {},\r\n  },\r\n  emits: ['update:a', 'update:b', 'update:c', 'update:d', 'update:e'],\r\n  setup(e) {\r\n    return o(e, 'a'), o(e, 'b'), o(e, 'c'), o(e, 'd'), o(e, 'e'), () => {};\r\n  },\r\n});\r\nexport { n as SampleComponent };\r\n//# sourceMappingURL=my-lib.js.map\r\n\r\n```\r\n\r\nA possible workaround could be to specify type property, but TypeScript complains about it in my editor : \r\n![CleanShot 2024-03-06 at 17 51 46@2x](https://github.com/vuejs/core/assets/675238/5c913c65-4efe-43e0-82c6-d49e0a6046f6)\r\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/vuejs/core/issues/comments/1981345157/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"bgondy","id":675238,"node_id":"MDQ6VXNlcjY3NTIzOA==","avatar_url":"https://avatars.githubusercontent.com/u/675238?v=4","gravatar_id":"","url":"https://api.github.com/users/bgondy","html_url":"https://github.com/bgondy","followers_url":"https://api.github.com/users/bgondy/followers","following_url":"https://api.github.com/users/bgondy/following{/other_user}","gists_url":"https://api.github.com/users/bgondy/gists{/gist_id}","starred_url":"https://api.github.com/users/bgondy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bgondy/subscriptions","organizations_url":"https://api.github.com/users/bgondy/orgs","repos_url":"https://api.github.com/users/bgondy/repos","events_url":"https://api.github.com/users/bgondy/events{/privacy}","received_events_url":"https://api.github.com/users/bgondy/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/vuejs/core/issues/comments/2042676438","html_url":"https://github.com/vuejs/core/issues/9587#issuecomment-2042676438","issue_url":"https:/