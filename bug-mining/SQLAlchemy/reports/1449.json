FiZWwxMTQxODk4MTkx","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/labels/loader%20options","name":"loader options","color":"b3f29b","default":false,"description":"ORM options like joinedload(), load_only(), these are complicated and have a lot of issues"},{"id":3627385794,"node_id":"LA_kwDOCX5JB87YNYPC","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/labels/hard%20orm","name":"hard orm","color":"EF69D6","default":false,"description":"hard ORM bugs mike needs to look at"}],"state":"closed","locked":false,"assignee":null,"assignees":[],"milestone":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/milestones/100","html_url":"https://github.com/sqlalchemy/sqlalchemy/milestone/100","labels_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/milestones/100/labels","id":8974115,"node_id":"MI_kwDOCX5JB84AiO8j","number":100,"title":"2.0.x","description":"","creator":{"login":"CaselIT","id":16175304,"node_id":"MDQ6VXNlcjE2MTc1MzA0","avatar_url":"https://avatars.githubusercontent.com/u/16175304?v=4","gravatar_id":"","url":"https://api.github.com/users/CaselIT","html_url":"https://github.com/CaselIT","followers_url":"https://api.github.com/users/CaselIT/followers","following_url":"https://api.github.com/users/CaselIT/following{/other_user}","gists_url":"https://api.github.com/users/CaselIT/gists{/gist_id}","starred_url":"https://api.github.com/users/CaselIT/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CaselIT/subscriptions","organizations_url":"https://api.github.com/users/CaselIT/orgs","repos_url":"https://api.github.com/users/CaselIT/repos","events_url":"https://api.github.com/users/CaselIT/events{/privacy}","received_events_url":"https://api.github.com/users/CaselIT/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":62,"closed_issues":423,"state":"open","created_at":"2023-01-27T12:23:11Z","updated_at":"2025-12-09T20:45:45Z","due_on":null,"closed_at":null},"comments":10,"created_at":"2023-04-11T15:23:26Z","updated_at":"2023-04-17T21:26:46Z","closed_at":"2023-04-17T21:26:46Z","author_association":"MEMBER","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Discussed in https://github.com/sqlalchemy/sqlalchemy/discussions/9633\r\n\r\nthere's no way to get loader criteria on the two SELECTs here because they are not top level.   A new definition of \"top level\" that accommodates for UNION might be beneficial\r\n\r\n```py\r\nfrom typing import Any\r\n\r\nfrom sqlalchemy import Column, Integer, create_engine, select, event, DateTime\r\nfrom sqlalchemy.ext.declarative import declarative_base\r\nfrom sqlalchemy.orm import Session, with_loader_criteria\r\n\r\nBase: Any = declarative_base()\r\n\r\nclass SoftDeleted:\r\n    deleted_at = Column(DateTime)\r\n\r\nclass A(SoftDeleted, Base):\r\n    __tablename__ = \"a\"\r\n    id = Column(Integer, primary_key=True)\r\n\r\nclass B(SoftDeleted, Base):\r\n    __tablename__ = \"b\"\r\n    id = Column(Integer, primary_key=True)\r\n\r\n\r\n@event.listens_for(Session, \"do_orm_execute\")\r\ndef _add_soft_delete_filtering_criteria(execute_state):\r\n    execute_state.statement = execute_state.statement.options(\r\n        with_loader_criteria(\r\n            SoftDeleted,\r\n            lambda cls: cls.deleted_at.is_(None),\r\n            include_aliases=True,\r\n        )\r\n    )\r\n\r\ne = create_engine(\"sqlite://\", echo=True)\r\nBase.metadata.create_all(e)\r\n\r\nsession = Session(e)\r\n\r\nall_items_stmt = select(A.id).union(select(B.id))\r\n\r\nsession.execute(all_items_stmt).scalars().all()\r\n```\r\n\r\n","closed_by":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/9635/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/9635/timeline","performed_via_github_app":null,"state_reason":"completed"}