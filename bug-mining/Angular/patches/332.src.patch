diff --git a/DEVELOPER.md b/DEVELOPER.md
index 5ab9167875..ba0c7eb4b3 100644
--- a/DEVELOPER.md
+++ b/DEVELOPER.md
@@ -155,3 +155,6 @@ For subsequent snapshots, just run
 ``` shell
 $ ./scripts/publish/publish-build-artifacts.sh [github username]
