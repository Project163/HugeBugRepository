ightyPenguin/gists{/gist_id}","starred_url":"https://api.github.com/users/TheMightyPenguin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TheMightyPenguin/subscriptions","organizations_url":"https://api.github.com/users/TheMightyPenguin/orgs","repos_url":"https://api.github.com/users/TheMightyPenguin/repos","events_url":"https://api.github.com/users/TheMightyPenguin/events{/privacy}","received_events_url":"https://api.github.com/users/TheMightyPenguin/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":3,"created_at":"2021-02-23T19:22:29Z","updated_at":"2021-03-18T14:15:53Z","closed_at":"2021-03-18T14:15:53Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**Describe the bug**\r\nWhen applying a dark theme to the Docs page, the table still has white and light gray background colors. This obviously ruins the readability of the table as the text color is also a light gray. There is a hardcoded `background-color: white;` value applied to the `table tr` element.\r\n\r\n**To Reproduce**\r\nSteps to reproduce the behavior:\r\n\r\n1. Use a dark theme for the docs page\r\n  ```jsx \r\n  // .storybook/preview.js\r\n  import { themes } from '@storybook/theming';\r\n \r\n  export const parameters = {\r\n    docs: {\r\n      theme: themes.dark\r\n    }\r\n  };\r\n  ``` \r\n2. Create a `stories.mdx` file and add a table: \r\n  ```mdx\r\n    <table><tr><th>Header</th></tr><tr><td>Table Cell</td></tr></table> \r\n  ```\r\n3. Run storybook and view the table's white and gray background colors\r\n\r\n**Expected behavior**\r\nI expect the table to inherit the dark theme's colors and retain its readability.\r\n\r\n**Screenshots**\r\n<img width=\"315\" alt=\"Screen Shot 2021-02-23 at 11 11 49 AM\" src=\"https://user-images.githubusercontent.com/768965/108895048-ef613900-75c7-11eb-88f7-295a4c3cdeb3.png\">\r\n\r\n\r\n**Code snippets**\r\nI believe this line to blame: https://github.com/storybookjs/storybook/blob/next/lib/components/src/typography/DocumentFormatting.tsx#L169\r\n\r\nI'm unclear how `theme` works in that file as I do not understand where `theme.color.medium` and `theme.color.lighter` are coming from or how `theme.color` should be used (generally speaking). Otherwise I'd PR a fix directly. \r\n\r\nThanks for reading.\r\n","closed_by":{"login":"shilman","id":488689,"node_id":"MDQ6VXNlcjQ4ODY4OQ==","avatar_url":"https://avatars.githubusercontent.com/u/488689?v=4","gravatar_id":"","url":"https://api.github.com/users/shilman","html_url":"https://github.com/shilman","followers_url":"https://api.github.com/users/shilman/followers","following_url":"https://api.github.com/users/shilman/following{/other_user}","gists_url":"https://api.github.com/users/shilman/gists{/gist_id}","starred_url":"https://api.github.com/users/shilman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shilman/subscriptions","organizations_url":"https://api.github.com/users/shilman/orgs","repos_url":"https://api.github.com/users/shilman/repos","events_url":"https://api.github.com/users/shilman/events{/privacy}","received_events_url":"https://api.github.com/users/shilman/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/storybookjs/storybook/issues/14029/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/storybookjs/storybook/issues/14029/timeline","performed_via_github_app":null,"state_reason":"completed"}