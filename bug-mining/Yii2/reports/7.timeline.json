b\\Command->queryRow()\n#2  + /Users/syang/Downloads/yii2demo/protected/controllers/SiteController.php(14): yii\\db\\ActiveQuery->one()\n#3   SiteController->actionIndex()\n#4  + /Users/syang/Downloads/yii2/framework/base/InlineAction.php(47): call_user_func_array(array(SiteController, \"actionIndex\"), array())\n#5  + /Users/syang/Downloads/yii2/framework/base/Controller.php(118): yii\\base\\InlineAction->runWithParams(array())\n#6  + /Users/syang/Downloads/yii2/framework/base/Module.php(569): yii\\base\\Controller->runAction(\"\", array())\n#7  + /Users/syang/Downloads/yii2/framework/web/Application.php(35): yii\\base\\Module->runAction(\"\", array())\n#8  + /Users/syang/Downloads/yii2/framework/base/Application.php(140): yii\\web\\Application->processRequest()\n#9  - /Users/syang/Downloads/yii2demo/www/index.php(8): yii\\base\\Application->run()\n```\n\n配置文内容\n\n```\n        'db' => array(\n            'class' => 'yii\\db\\Connection',\n            'dsn' => 'mysql:host=localhost;dbname=pin',\n            'username' => 'root',\n            'password' => '',\n            'tablePrefix'=>'uu_'\n        ),\n```\n\n模型如上：\n\n难道要定义时手动调用getRawTableName吗？\n\n查看yii\\db\\Command->queryInternal 会调用\n\nyii\\db\\Schema->quoteTableName()\n会quoteTableName未执行getRawTableName\n\n暂时修改quoteTableName方法，最开始加上一条$name = $this->getRawTableName($name);，就可以解决。\n\n但考虑到这个位置可能不是最好的，还是请你来解决吧。\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yiisoft/yii2/issues/comments/17438091/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"netyum","id":195082,"node_id":"MDQ6VXNlcjE5NTA4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/195082?v=4","gravatar_id":"","url":"https://api.github.com/users/netyum","html_url":"https://github.com/netyum","followers_url":"https://api.github.com/users/netyum/followers","following_url":"https://api.g