+        # GH12288
+        orig = RangeIndex(10)
+        orig.name = 'original'
+
+        copy = RangeIndex(orig)
+        copy.name = 'copy'
+
+        self.assertTrue(orig.name, 'original')
+        self.assertTrue(copy.name, 'copy')
+
+        new = Index(copy)
+        self.assertTrue(new.name, 'copy')
+
+        new.name = 'new'
+        self.assertTrue(orig.name, 'original')
