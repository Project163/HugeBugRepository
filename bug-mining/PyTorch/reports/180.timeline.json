SGD(model.parameters(), lr=0.01)\n\ninputs = torch.randn(20, 10)\ntargets = torch.randn(20, 1)\n\ncriterion = nn.MSELoss()\n\noutputs = model(inputs)\nloss = criterion(outputs, targets)\nloss.backward()\n\nprint(\"Before gradient clipping:\")\nfor name, param in model.named_parameters():\n    if param.grad is not None:\n        print(f\"Gradient of {name}: {param.grad.data}\")\n\nparams_to_clip = model.parameters()\n\nfor p in params_to_clip:\n    print(p.shape)\n\nnn.utils.clip_grad_value_(params_to_clip, clip_value=0.5)\n```\n\n```bash\n\nTraceback (most recent call last):\n  File \"/home/zong/code/pytorch/test/inductor/learn_inductor.py\", line 147, in <module>\n    nn.utils.clip_grad_value_(params_to_clip, clip_value=0.5)\n  File \"/home/zong/code/pytorch/torch/nn/utils/clip_grad.py\", line 40, in _no_grad_wrapper\n    return func(*args, **kwargs)\n           ^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/zong/code/pytorch/torch/nn/utils/clip_grad.py\", line 284, in clip_grad_value_\n    grouped_grads = _group_tensors_by_device_and_dtype([grads])\n                    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/zong/code/pytorch/torch/utils/_contextlib.py\", line 116, in decorate_context\n    return func(*args, **kwargs)\n           ^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/zong/code/pytorch/torch/utils/_foreach_utils.py\", line 37, in _group_tensors_by_device_and_dtype\n    return torch._C._group_tensors_by_device_and_dtype(tensorlistlist, with_indices)\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\nRuntimeError: Expected !nested_tensorlist[0].empty() to be true, but got false.  (Could this error message be improved?  If so, please report an enhancement request to PyTorch.)\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/pytorch/pytorch/issues/comments/2811962038/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},