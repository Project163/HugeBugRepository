sociation":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"With the change to remove the extra versioning on the boost libraries, CMake's `FindBoost` module is no longer able to distinguish between the debug and release libraries, and ends up thinking that the debug version is both the debug and release versions of the library. The same issue also occurs with `FindOpenSSL`. The debug version of `boost::atomic` was previously named `boost_atomic-vc140-mt-gd-1_62.lib` and is now named `boost_atomic.lib`. This confuses CMake.\r\n\r\nAs Boost has a well-established naming layout on Windows, vcpkg should probably stick with that convention.","closed_by":{"login":"alexkaratarakis","id":128712,"node_id":"MDQ6VXNlcjEyODcxMg==","avatar_url":"https://avatars.githubusercontent.com/u/128712?v=4","gravatar_id":"","url":"https://api.github.com/users/alexkaratarakis","html_url":"https://github.com/alexkaratarakis","followers_url":"https://api.github.com/users/alexkaratarakis/followers","following_url":"https://api.github.com/users/alexkaratarakis/following{/other_user}","gists_url":"https://api.github.com/users/alexkaratarakis/gists{/gist_id}","starred_url":"https://api.github.com/users/alexkaratarakis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alexkaratarakis/subscriptions","organizations_url":"https://api.github.com/users/alexkaratarakis/orgs","repos_url":"https://api.github.com/users/alexkaratarakis/repos","events_url":"https://api.github.com/users/alexkaratarakis/events{/privacy}","received_events_url":"https://api.github.com/users/alexkaratarakis/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/microsoft/vcpkg/issues/369/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"hear