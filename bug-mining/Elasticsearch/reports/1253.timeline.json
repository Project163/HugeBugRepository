ow).\n","reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/12656/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/elastic/elasticsearch/issues/12656/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}},"event":"cross-referenced"},{"actor":{"login":"rjernst","id":289412,"node_id":"MDQ6VXNlcjI4OTQxMg==","avatar_url":"https://avatars.githubusercontent.com/u/289412?v=4","gravatar_id":"","url":"https://api.github.com/users/rjernst","html_url":"https://github.com/rjernst","followers_url":"https://api.github.com/users/rjernst/followers","following_url":"https://api.github.com/users/rjernst/following{/other_user}","gists_url":"https://api.github.com/users/rjernst/gists{/gist_id}","starred_url":"https://api.github.com/users/rjernst/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rjernst/subscriptions","organizations_url":"https://api.github.com/users/rjernst/orgs","repos_url":"https://api.github.com/users/rjernst/repos","events_url":"https://api.github.com/users/rjernst/events{/privacy}","received_events_url":"https://api.github.com/users/rjernst/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2015-08-08T23:00:48Z","updated_at":"2015-08-08T23:00:48Z","source":{"type":"issue","issue":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/12744","repository_url":"https://api.github.com/repos/elastic/elasticsearch","labels_url":"https://api.github.com/repos/elastic/elasticsearch/issues/12744/labels{/name}","comments_url":"https://api.github.com/repos/elastic/elasticsearch/issues/12744/comments","events_url":"https://api.github.com/repos/elastic/elasticsearch/issues/12744/events","html_url":"https://github.com/elastic/elasticsearch/pull/12744","id":99841032,"node_id":"MDExOlB1bGxSZXF1ZXN0NDE5NjIxNDQ=","number":12744,"title":"Remove Se