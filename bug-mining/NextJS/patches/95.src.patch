+
+jest.setTimeout(1000 * 60 * 2)
+context.appDir = join(__dirname, '../')
+
+describe('Middleware usage of dynamic code evaluation', () => {
+  describe('dev mode', () => {
+    let output = ''
+
+    beforeAll(async () => {
+      context.appPort = await findPort()
