ooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/chartjs/Chart.js/issues/2218/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/chartjs/Chart.js/issues/comments/205523479","html_url":"https://github.com/chartjs/Chart.js/issues/2192#issuecomment-205523479","issue_url":"https://api.github.com/repos/chartjs/Chart.js/issues/2192","id":205523479,"node_id":"MDEyOklzc3VlQ29tbWVudDIwNTUyMzQ3OQ==","user":{"login":"eemikula","id":7127702,"node_id":"MDQ6VXNlcjcxMjc3MDI=","avatar_url":"https://avatars.githubusercontent.com/u/7127702?v=4","gravatar_id":"","url":"https://api.github.com/users/eemikula","html_url":"https://github.com/eemikula","followers_url":"https://api.github.com/users/eemikula/followers","following_url":"https://api.github.com/users/eemikula/following{/other_user}","gists_url":"https://api.github.com/users/eemikula/gists{/gist_id}","starred_url":"https://api.github.com/users/eemikula/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eemikula/subscriptions","organizations_url":"https://api.github.com/users/eemikula/orgs","repos_url":"https://api.github.com/users/eemikula/repos","events_url":"https://api.github.com/users/eemikula/events{/privacy}","received_events_url":"https://api.github.com/users/eemikula/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-04-04T22:35:25Z","updated_at":"2016-04-04T22:35:25Z","body":"I made a PR with the change as described above, but I just wanted to highlight that if anyone else created a doughnut chart with a legend modeled after the one on the front page of chartjs.org, a CSS change will be necessary to accompany it, because the CSS used there applies to both spans generated by this change. Simply changing it to use the new class will restore the original behavior. I think this is the best change in terms of providing everyone the f