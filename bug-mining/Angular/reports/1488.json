://api.github.com/users/IgorMinar/following{/other_user}","gists_url":"https://api.github.com/users/IgorMinar/gists{/gist_id}","starred_url":"https://api.github.com/users/IgorMinar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/IgorMinar/subscriptions","organizations_url":"https://api.github.com/users/IgorMinar/orgs","repos_url":"https://api.github.com/users/IgorMinar/repos","events_url":"https://api.github.com/users/IgorMinar/events{/privacy}","received_events_url":"https://api.github.com/users/IgorMinar/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":681,"closed_issues":22796,"state":"open","created_at":"2018-01-18T16:52:20Z","updated_at":"2026-03-11T09:12:24Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2022-04-21T12:32:10Z","updated_at":"2022-11-11T16:06:39Z","closed_at":"2022-10-11T17:20:59Z","assignee":{"login":"JiaLiPassion","id":1442575,"node_id":"MDQ6VXNlcjE0NDI1NzU=","avatar_url":"https://avatars.githubusercontent.com/u/1442575?v=4","gravatar_id":"","url":"https://api.github.com/users/JiaLiPassion","html_url":"https://github.com/JiaLiPassion","followers_url":"https://api.github.com/users/JiaLiPassion/followers","following_url":"https://api.github.com/users/JiaLiPassion/following{/other_user}","gists_url":"https://api.github.com/users/JiaLiPassion/gists{/gist_id}","starred_url":"https://api.github.com/users/JiaLiPassion/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JiaLiPassion/subscriptions","organizations_url":"https://api.github.com/users/JiaLiPassion/orgs","repos_url":"https://api.github.com/users/JiaLiPassion/repos","events_url":"https://api.github.com/users/JiaLiPassion/events{/privacy}","received_events_url":"https://api.github.com/users/JiaLiPassion/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Which @angular/* package(s) are the source of the bug?\r\n\r\nDon't known / other\r\n\r\n### Is this a regression?\r\n\r\nNo\r\n\r\n### Description\r\n\r\nWe have code running a Knexjs migration which is wrapped in some code that we use Zonejs for tracing execution. It appears that by the time Zonejs tries to cancel a task, it is already in a `notScheduled` state. \r\n\r\nA similar circumstance was fixed awhile back in the context of `runTask`, see https://github.com/angular/zone.js/issues/778\r\n\r\nIt may be a simple fix to add a similar guard in `cancelTask` at https://github.com/angular/angular/blob/master/packages/zone.js/lib/zone.ts#L959\r\n\r\n### Please provide a link to a minimal reproduction of the bug\r\n\r\n_No response_\r\n\r\n### Please provide the exception or error you saw\r\n\r\n```\r\n{\"type\":\"Error\",\r\n \"message\":\"eventTask 'Client_PG.addListener:start': can not transition to 'canceling', expecting state 'scheduled' or 'running', was 'notScheduled'.\",\r\n \"stack_trace\":[\r\n   \"Error: eventTask 'Client_PG.addListener:start': can not transition to 'canceling', expecting state 'scheduled' or 'running', was 'notScheduled'.\",\r\n   \"    at ZoneTask._transitionTo (/opt/nodejs/node_modules/zone.js/dist/zone-node.js:532:23)\",\r\n   \"    at Zone.cancelTask (/opt/nodejs/node_modules/zone.js/dist/zone-node.js:270:18)\",\r\n   \"    at Client_PG.proto.<computed> [as removeListener (/opt/nodejs/node_modules/zone.js/dist/zone-node.js:1959:43)\",\r\n   \"    at /opt/nodejs/node_modules/knex/lib/util/make-knex.js:284:19\",\r\n   \"    at Array.forEach (<anonymous>)\",\"    at redefineProperties (/opt/nodejs/node_modules/knex/lib/util/make-knex.js:283:29)\",\r\n   \"    at Object.withUserParams (/opt/nodejs/node_modules/knex/lib/util/make-knex.js:207:7)\",\r\n   \"    at Function.value (/opt/nodejs/node_modules/knex/lib/util/make-knex.js:90:29)\",\r\n   \"    at new Migrator (/opt/nodejs/node_modules/knex/lib/migrate/Migrator.js:34:26)\",\r\n   \"    at Function.get (/opt/nodejs/node_modules/knex/lib/util/make-knex.js:49:14)\"]}\r\n```\r\n\r\n\r\n\r\n### Please provide the environment you discovered this bug in (run `ng version`)\r\n\r\n```\r\nNode: 16.14.0\r\nKnex: 0.21.21\r\nZone.js: 0.8.29\r\n```\r\n\r\n\r\n### Anything else?\r\n\r\n_No response_","closed_by":{"login":"jessicajaniuk","id":72768744,"node_id":"MDQ6VXNlcjcyNzY4NzQ0","avatar_url":"https://avatars.githubusercontent.com/u/72768744?v=4","gravatar_id":"","url":"https://api.github.com/users/jessicajaniuk","html_url":"https://github.com/jessicajaniuk","followers_url":"https://api.github.com/users/jessicajaniuk/followers","following_url":"https://api.github.com/users/jessicajaniuk/following{/other_user}","gists_url":"https://api.github.com/users/jessicajaniuk/gists{/gist_id}","starred_url":"https://api.github.com/users/jessicajaniuk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jessicajaniuk/subscriptions","organizations_url":"https://api.github.com/users/jessicajaniuk/orgs","repos_url":"https://api.github.com/users/jessicajaniuk/repos","events_url":"https://api.github.com/users/jessicajaniuk/events{/privacy}","received_events_url":"https://api.github.com/users/jessicajaniuk/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/45711/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/angular/angular/issues/45711/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}