efined }` is different than `{}` and it will result in strange behavior. For example, if you're handling defaults by doing something like `{ ...DEFAULT_PROPS, props }`, then a value of `undefined` will overwrite the default.\n\nSee discussion in issue #15378 for more details. Seems like this was introduced in #14579.\n\nMentioning people involved / with the same issue: tmeasday shilman penx mboettcher\n\n","closed_by":{"login":"shilman","id":488689,"node_id":"MDQ6VXNlcjQ4ODY4OQ==","avatar_url":"https://avatars.githubusercontent.com/u/488689?v=4","gravatar_id":"","url":"https://api.github.com/users/shilman","html_url":"https://github.com/shilman","followers_url":"https://api.github.com/users/shilman/followers","following_url":"https://api.github.com/users/shilman/following{/other_user}","gists_url":"https://api.github.com/users/shilman/gists{/gist_id}","starred_url":"https://api.github.com/users/shilman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shilman/subscriptions","organizations_url":"https://api.github.com/users/shilman/orgs","repos_url":"https://api.github.com/users/shilman/repos","events_url":"https://api.github.com/users/shilman/events{/privacy}","received_events_url":"https://api.github.com/users/shilman/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/storybookjs/storybook/issues/15630/reactions","total_count":7,"+1":7,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/storybookjs/storybook/issues/15630/timeline","performed_via_github_app":null,"state_reason":"completed"}