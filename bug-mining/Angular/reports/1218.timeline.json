XNlcjg2MDQyMDU=","avatar_url":"https://avatars.githubusercontent.com/u/8604205?v=4","gravatar_id":"","url":"https://api.github.com/users/gkalpak","html_url":"https://github.com/gkalpak","followers_url":"https://api.github.com/users/gkalpak/followers","following_url":"https://api.github.com/users/gkalpak/following{/other_user}","gists_url":"https://api.github.com/users/gkalpak/gists{/gist_id}","starred_url":"https://api.github.com/users/gkalpak/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gkalpak/subscriptions","organizations_url":"https://api.github.com/users/gkalpak/orgs","repos_url":"https://api.github.com/users/gkalpak/repos","events_url":"https://api.github.com/users/gkalpak/events{/privacy}","received_events_url":"https://api.github.com/users/gkalpak/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2020-04-26T20:51:47Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/angular/angular/issues/comments/620036887","html_url":"https://github.com/angular/angular/issues/36539#issuecomment-620036887","issue_url":"https://api.github.com/repos/angular/angular/issues/36539","id":620036887,"node_id":"MDEyOklzc3VlQ29tbWVudDYyMDAzNjg4Nw==","user":{"login":"gkalpak","id":8604205,"node_id":"MDQ6VXNlcjg2MDQyMDU=","avatar_url":"https://avatars.githubusercontent.com/u/8604205?v=4","gravatar_id":"","url":"https://api.github.com/users/gkalpak","html_url":"https://github.com/gkalpak","followers_url":"https://api.github.com/users/gkalpak/followers","following_url":"https://api.github.com/users/gkalpak/following{/other_user}","gists_url":"https://api.github.com/users/gkalpak/gists{/gist_id}","starred_url":"https://api.github.com/users/gkalpak/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gkalpak/subscriptions","organizations_url":"https://api.github.com/users/gkalpak/orgs","repos_url":"https://api.github.com/users/gkalpak/repos","events_url":"https://api.github.com/users/gkalpak/events{/privacy}","received_events_url":"https://api.github.com/users/gkalpak/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-04-27T14:52:32Z","updated_at":"2020-04-27T14:52:32Z","body":"> If the asset doesn't exist in the cache anymore, then nothing needs to be purged. Is that my correct understanding?\r\n\r\nWe need to clear the whole cache. See https://github.com/angular/angular/issues/36539#issue-597196606 for more details.\r\n\r\n##\r\n> Would you recommend to use an `Observable` so that the page can be notified of this state?\r\n\r\nSounds reasonable. (I would be open to suggestions, though.)\r\n\r\n##\r\n> Again, would an `Observable` here be sufficient?\r\n\r\nEhm...this is the same observable we are talking about in the previous point.\r\nBasically, the SW will communicate to the pages via `postMessage()`. On the page side, an Angular service (possibly `SwUpdate` or a similar one) will expose an observable that will get a new emission each time such a message is received from the SW.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/comments/620036887/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"gkalpak","id":8604205,"node_id":"MDQ6VXNlcjg2MDQyMDU=","avatar_url":"https://avatars.githubusercontent.com/u/8604205?v=4","gravatar_id":"","url":"https://api.github.com/users/gkalpak","html_url":"https://github.com/gkalpak","followers_url":"https://api.github.com/users/gkalpak/followers","following_url":"https://api.github.com/users/gkalpak/following{/other_user}","gists_url":"https://api.github.com/users/gkalpak/gists{/gist_id}","starred_url":"https://api.github.com/users/gkalpak/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gkalpa