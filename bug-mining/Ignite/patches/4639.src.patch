-        // Try reading ASCII.
-        while (cntr1 < len1 && cntr2 < len2) {
-            c = (int) GridUnsafe.getByte(addr) & 0xFF;
-
-            if (c > 127)
-                break;
-
-            cntr1++; addr++;
-
-            v1 = (char)c;
-            v2 = s.charAt(cntr2++);
-
-            if (ignoreCase) {
-                v1 = Character.toUpperCase(v1);
-                v2 = Character.toUpperCase(v2);
