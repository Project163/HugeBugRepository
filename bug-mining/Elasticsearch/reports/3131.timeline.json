users/siposea/repos","events_url":"https://api.github.com/users/siposea/events{/privacy}","received_events_url":"https://api.github.com/users/siposea/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2024-11-27T15:37:22Z","performed_via_github_app":null},{"id":15454499489,"node_id":"SE_lADOAAe_f86g3p-4zwAAAAOZKPKh","url":"https://api.github.com/repos/elastic/elasticsearch/issues/events/15454499489","actor":{"login":"kkrik-es","id":131142368,"node_id":"U_kgDOB9ES4A","avatar_url":"https://avatars.githubusercontent.com/u/131142368?v=4","gravatar_id":"","url":"https://api.github.com/users/kkrik-es","html_url":"https://github.com/kkrik-es","followers_url":"https://api.github.com/users/kkrik-es/followers","following_url":"https://api.github.com/users/kkrik-es/following{/other_user}","gists_url":"https://api.github.com/users/kkrik-es/gists{/gist_id}","starred_url":"https://api.github.com/users/kkrik-es/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kkrik-es/subscriptions","organizations_url":"https://api.github.com/users/kkrik-es/orgs","repos_url":"https://api.github.com/users/kkrik-es/repos","events_url":"https://api.github.com/users/kkrik-es/events{/privacy}","received_events_url":"https://api.github.com/users/kkrik-es/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2024-11-27T15:37:22Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/comments/2508256452","html_url":"https://github.com/elastic/elasticsearch/issues/117644#issuecomment-2508256452","issue_url":"https://api.github.com/repos/elastic/elasticsearch/issues/117644","id":2508256452,"node_id":"IC_kwDOAAe_f86VgPTE","user":{"login":"martijnvg","id":580421,"node_id":"MDQ6VXNlcjU4MDQyMQ==","avatar_url":"https://avatars.githubusercontent.com/u/580421?v=4","gravatar_id":"","url":"https://api.github.com/users/martijnvg","html_url":"https://github.com/martijnvg","followers_url":"https://api.github.com/users/martijnvg/followers","following_url":"https://api.github.com/users/martijnvg/following{/other_user}","gists_url":"https://api.github.com/users/martijnvg/gists{/gist_id}","starred_url":"https://api.github.com/users/martijnvg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/martijnvg/subscriptions","organizations_url":"https://api.github.com/users/martijnvg/orgs","repos_url":"https://api.github.com/users/martijnvg/repos","events_url":"https://api.github.com/users/martijnvg/events{/privacy}","received_events_url":"https://api.github.com/users/martijnvg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-29T18:20:45Z","updated_at":"2024-11-29T19:22:33Z","body":"The main reason that the `EOFException` occurs is that `LeafSearchLookup` instance gets reused between `BlockDocValuesReader` instances. In the above query there are two `BlockDocValuesReader` instances using the `LeafSeachLookup`. When `ValuesSourceReaderOperator` reads on columnar fashion (via `loadFromSingleLeaf()` or loadFromSingleLeafUnsorted() methods) then ranges of docids get processed multiple times by same  `LeafSearchLookup` instance. For the synthetic source loader this is an issue because as part of synthesizing source doc value iterators then can advance backwards. This violates `DocValuesIterator#advanceExact(...)` and `DocIdSetIterator#advance(...)` contracts and then at some point during the executing of the query `EOFException` occur deep in the codec.\n\n\nThis is fixable. For example we could enforce different `SearchLookup` instances between fields or force a row oriented execution fashion.\n\n(note: this issue only occurs with runtime fields (script based block loaders))","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/comments/2508256452/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"martijnvg","id":580421,"node_id":"MDQ6VXNlcjU4MDQyMQ==","avatar_url":"https://avatars.githubusercontent.com/u/580421?v=4","gravatar_id":"","url":"https://api.github.com/users/martijnvg","html_url":"https://github.com/martijnvg","followers_url":"https://api.github.com/users/martijnvg/followers","following_url":"https://api.github.com/users/martijnvg/following{/other_user}","gists_url":"https://api.github.com/users/martijnvg/gists{/gist_id}","starred_url":"https://api.github.com/users/martijnvg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/martijnvg/subscriptions","organizations_url":"https://api.github.com/users/martijnvg/orgs","repos_url":"https://api.github.com/users/martijnvg/repos","events_url":"https://api.github.com/users/martijnvg/events{/privacy}","received_events_url":"https://api.github.com/users/martijnvg/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":15481031780,"node_id":"REFE_lADOAAe_f86g3p-4zwAAAAOavcxk","url":"https://api.github.com/repos/elastic/elasticsearch/issues/events/15481031780","actor":{"login":"martijnvg","id":580421,"node_id":"MDQ6VXNlcjU4MDQyMQ==","avatar_url":"https://avatars.githubusercontent.com/u/580421?v=4","gravatar_id":"","url":"https://api.github.com/users/martijnvg","html_url":"https://github.com/martijnvg","followers_url":"https://api.github.com/users/martijnvg/followers","following_url":"https://api.github.com/users/martijnvg/following{/other_user}","gists_url":"https://api.github.com/users/martijnvg/gists{/gist_id}","starred_url":"https://api.github.com/users/martijnvg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/martijnvg/subscriptions","organizations_url":"https://api.github.com/users/martijnvg/orgs","repos_url":"https