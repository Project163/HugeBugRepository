he tsconfig, which, as described in issue [#58640](https://github.com/vercel/next.js/issues/58640), is also no longer required.\n\n### Expected Behavior\n\nThe example should not run into hydration errors, use zustand optimisations where possible and not have any unnecessary configuration options set by default.\n\n### To Reproduce\n\nStart the with-zustand example on the canary branch.","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/58695/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vercel/next.js/issues/58695/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"actor":{"login":"N-Ziermann","id":46197265,"node_id":"MDQ6VXNlcjQ2MTk3MjY1","avatar_url":"https://avatars.githubusercontent.com/u/46197265?v=4","gravatar_id":"","url":"https://api.github.com/users/N-Ziermann","html_url":"https://github.com/N-Ziermann","followers_url":"https://api.github.com/users/N-Ziermann/followers","following_url":"https://api.github.com/users/N-Ziermann/following{/other_user}","gists_url":"https://api.github.com/users/N-Ziermann/gists{/gist_id}","starred_url":"https://api.github.com/users/N-Ziermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/N-Ziermann/subscriptions","organizations_url":"https://api.github.com/users/N-Ziermann/orgs","repos_url":"https://api.github.com/users/N-Ziermann/repos","events_url":"https://api.github.com/users/N-Ziermann/events{/privacy}","received_events_url":"https://api.github.com/users/N-Ziermann/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-11-20T18:19:02Z","updated_at":"2023-11-20T18:19:02Z","source":{"type":"issue","issue":{"url":"https://api.github.com/repos/vercel/next.js/issues/58696","repository_url":"https://api.github.com/repos/vercel/next.js","labels_url":"https://api.github.com/repos/vercel/nex