index 0000000000..ad5d3b6b8a
--- /dev/null
+++ b/packages/driver/test/cypress/integration/issues/1854_spec.js
@@ -0,0 +1,13 @@
+describe('issue #1854', () => {
+  it('does not error when using setTimeouts referencing string globals', () => {
+    cy.visit('/fixtures/generic.html')
+    cy.window().then((win) => {
+      win.foo = (arg) => {
+        win.bar = arg
+      }
+
+      win.setTimeout('foo(true)', 100)
+    })
+    cy.window().its('bar').should('be.true')
+  })
+})
