g==","avatar_url":"https://avatars.githubusercontent.com/u/879272?v=4","gravatar_id":"","url":"https://api.github.com/users/jmmv","html_url":"https://github.com/jmmv","followers_url":"https://api.github.com/users/jmmv/followers","following_url":"https://api.github.com/users/jmmv/following{/other_user}","gists_url":"https://api.github.com/users/jmmv/gists{/gist_id}","starred_url":"https://api.github.com/users/jmmv/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jmmv/subscriptions","organizations_url":"https://api.github.com/users/jmmv/orgs","repos_url":"https://api.github.com/users/jmmv/repos","events_url":"https://api.github.com/users/jmmv/events{/privacy}","received_events_url":"https://api.github.com/users/jmmv/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2020-04-24T10:52:20Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/619060128","html_url":"https://github.com/bazelbuild/bazel/issues/7435#issuecomment-619060128","issue_url":"https://api.github.com/repos/bazelbuild/bazel/issues/7435","id":619060128,"node_id":"MDEyOklzc3VlQ29tbWVudDYxOTA2MDEyOA==","user":{"login":"jmmv","id":879272,"node_id":"MDQ6VXNlcjg3OTI3Mg==","avatar_url":"https://avatars.githubusercontent.com/u/879272?v=4","gravatar_id":"","url":"https://api.github.com/users/jmmv","html_url":"https://github.com/jmmv","followers_url":"https://api.github.com/users/jmmv/followers","following_url":"https://api.github.com/users/jmmv/following{/other_user}","gists_url":"https://api.github.com/users/jmmv/gists{/gist_id}","starred_url":"https://api.github.com/users/jmmv/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jmmv/subscriptions","organizations_url":"https://api.github.com/users/jmmv/orgs","repos_url":"https://api.github.com/users/jmmv/repos","events_url":"https://api.github.com/users/jmmv/events{/privacy}","received_events_url":"https://api.github.com/users/jmmv/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-04-24T14:53:45Z","updated_at":"2020-04-24T14:53:45Z","body":"Sorry for the delay...\r\n\r\nSo the problem comes from here:\r\n\r\n```\r\n(version 1)\r\n(debug deny)\r\n(allow default)\r\n(deny file-write*)\r\n(allow file-write*\r\n    (subpath \"/dev\")\r\n    (subpath \"/private/var/folders/6c/16j7hmxs65x4mtf6xq6m8qhm002m9r/T\")\r\n    (subpath \"/Users/jmmv/Library/Logs\")\r\n    (subpath \"/private/var/tmp\")\r\n    (subpath \"/Users/jmmv/Library/Developer\")\r\n    (subpath \"/private/var/folders/6c/16j7hmxs65x4mtf6xq6m8qhm002m9r/C\")\r\n    (subpath \"/Users/jmmv/abseil/sandbox/darwin-sandbox/10/execroot/com_google_absl\")\r\n    (subpath \"/private/tmp\")\r\n)\r\n```\r\n\r\nThis is the configuration we write for `sandbox-exec`. When we use the default output base, we get blanket access to write into `.../tmp/` and because the sandboxfs instance is there, things work. When we move the output tree elsewhere, the sandbox only allows access to the `.../sandbox/darwin-sandbox/...` paths. This is fine for the symlinked sandbox because the symlinks are there, but when sandboxfs is active, we are issuing the writes to a path that is not covered by the sandbox.\r\n\r\nShould be easy to fix. Let me see if I can do something quickly.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/619060128/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"jmmv","id":879272,"node_id":"MDQ6VXNlcjg3OTI3Mg==","avatar_url":"https://avatars.githubusercontent.com/u/879272?v=4","gravatar_id":"","url":"https://api.github.com/users/jmmv","html_url":"https://github.com/jmmv","followers_url":"https://api.github.com/users/jmmv/followers","following_u