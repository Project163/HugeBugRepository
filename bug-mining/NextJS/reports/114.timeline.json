ithub.com/users/hello-rory/following{/other_user}","gists_url":"https://api.github.com/users/hello-rory/gists{/gist_id}","starred_url":"https://api.github.com/users/hello-rory/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hello-rory/subscriptions","organizations_url":"https://api.github.com/users/hello-rory/orgs","repos_url":"https://api.github.com/users/hello-rory/repos","events_url":"https://api.github.com/users/hello-rory/events{/privacy}","received_events_url":"https://api.github.com/users/hello-rory/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-06-11T23:56:24Z","updated_at":"2021-06-11T23:56:24Z","body":"I also just ran into this issue. Not that I recommend using `Link` for external hrefs but I think the behavior should be consistent. If you are creating these in loops it gets tedious to implement custom logic based on the URL.\r\n\r\n```\r\n<Link href=\"https://google.com/\">\r\n  <a onMouseEnter={e => console.log(\"External\", Date.now())}>External</a>\r\n</Link>\r\n<Link href=\"/\">\r\n  <a onMouseEnter={e => console.log(\"Internal\", Date.now())}>Internal</a>\r\n</Link>\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/859961972/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"hello-rory","id":69475903,"node_id":"MDQ6VXNlcjY5NDc1OTAz","avatar_url":"https://avatars.githubusercontent.com/u/69475903?v=4","gravatar_id":"","url":"https://api.github.com/users/hello-rory","html_url":"https://github.com/hello-rory","followers_url":"https://api.github.com/users/hello-rory/followers","following_url":"https://api.github.com/users/hello-rory/following{/other_user}","gists_url":"https://api.github.com/users/hello-rory/gists{/gist_id}","starred_url":"https://api.github.com/users/hello-rory/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hello-rory/subscriptions","organizations_url":"https://api.github.com/users/hello-rory/orgs","repos_url":"https://api.github.com/users/hello-rory/repos","events_url":"https://api.github.com/users/hello-rory/events{/privacy}","received_events_url":"https://api.github.com/users/hello-rory/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/921064288","html_url":"https://github.com/vercel/next.js/issues/22733#issuecomment-921064288","issue_url":"https://api.github.com/repos/vercel/next.js/issues/22733","id":921064288,"node_id":"IC_kwDOBC3Cis425lNg","user":{"login":"nuuou","id":2430471,"node_id":"MDQ6VXNlcjI0MzA0NzE=","avatar_url":"https://avatars.githubusercontent.com/u/2430471?v=4","gravatar_id":"","url":"https://api.github.com/users/nuuou","html_url":"https://github.com/nuuou","followers_url":"https://api.github.com/users/nuuou/followers","following_url":"https://api.github.com/users/nuuou/following{/other_user}","gists_url":"https://api.github.com/users/nuuou/gists{/gist_id}","starred_url":"https://api.github.com/users/nuuou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nuuou/subscriptions","organizations_url":"https://api.github.com/users/nuuou/orgs","repos_url":"https://api.github.com/users/nuuou/repos","events_url":"https://api.github.com/users/nuuou/events{/privacy}","received_events_url":"https://api.github.com/users/nuuou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-09-16T16:46:33Z","updated_at":"2021-09-16T16:46:33Z","body":"Encountered this exact same issue. Similar to others in this thread, my initial use was just avoiding some additional logic for checking external URLs, and using `<Link>` uniformly. \r\n\r\nIf _no_ events fired properly on external links with the `<Link>` component, then I would have no problem considering this as simply \"not supported\". However, because _some_ events fire (e.g., `onMouseOver`, `onClick`), while others (e.g., `onMouseEnter`, `onMouseLeave`) don't, it feels quite inconsistent.\r\n\r\nNot quite a fair one-to-one comparison I understand with my example events, but misleading nonetheless.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/921064288/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"nuuou","id":2430471,"node_id":"MDQ6VXNlcjI0MzA0NzE=","avatar_url":"https://avatars.githubusercontent.com/u/2430471?v=4","gravatar_id":"","url":"https://api.github.com/users/nuuou","html_url":"https://github.com/nuuou","followers_url":"https://api.github.com/users/nuuou/followers","following_url":"https://api.github.com/users/nuuou/following{/other_user}","gists_url":"https://api.github.com/users/nuuou/gists{/gist_id}","starred_url":"https://api.github.com/users/nuuou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nuuou/subscriptions","organizations_url":"https://api.github.com/users/nuuou/orgs","repos_url":"https://api.github.com/users/nuuou/repos","events_url":"https://api.github.com/users/nuuou/events{/privacy}","received_events_url":"https://api.github.com/users/nuuou/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/921717663","html_url":"https://github.com/vercel/next.js/issues/22733#issuecomment-921717663","issue_url":"https://api.github.com/repos/vercel/next.js/issues/22733","id":921717663,"node_id":"IC_kwDOBC3Cis428Euf","user":{"login":"balazsorban44","id":18369201,"node_id":"MDQ6VXNlcjE4MzY5MjAx","avatar_url":"https://avatars.githubusercontent.com/u/18369201?v=4","gravatar_id":"","url":"https://api.github.com/users/balazsorban44","html_url":"https://github.com/balazsorban44","followers_url":"https://api.github.com/users/balazsorban44/followers","following_url":"https://api.github.com/users/balazsorban44/following{/other_user}","gists_url":"https://api.github.com/users/balazsorban44/gists{/gist_id}","starred_url":"https://api.github.com/users/balazsorban44/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/balazsorban44/subscriptions","organizations_url":"https://api.github.com/users/balazsorban44/orgs","repos_url":"https://api.github.com/users/balazsorban44/repos","events_url":"https://api.github.com/users/balazsorban44/events{/privacy}","received_events_url":"https://api.github.com/users/balazsorban44/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-09-17T11:20:51Z","updated_at":"2021-09-17T11:20:51Z","body":"The thing is, the logic has to be in some place anyway. If not in userland, that complexity has to be added to `next/link`.\r\n\r\nCreating a custom `Link` component on top of `next/link` in userland is fairly easy though, we actually do that in our company. Here is an oversimplified implementation:\r\n\r\n```jsx\r\nimport NextLink from \"next/link\"\r\n\r\nexport function Link(props) {\r\n  if (props.href.startsWith(\"/\")) {\r\n    return (\r\n      <NextLink {...props}>\r\n        <a>{props.children}</a>\r\n      </NextLink>\r\n    )\r\n  }\r\n  return <a {...props} />\r\n}\r\n```\r\n\r\n\r\nIn any case, I don't think what the OP reported is an actual bug in Next.js, at least not when you consider how `next/link` is supposed to be used according to the documentation.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/921717663/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"balazsorban44","id":18369201,"node_id":"MDQ6VXNlcjE4MzY5MjAx","avatar_url":"http