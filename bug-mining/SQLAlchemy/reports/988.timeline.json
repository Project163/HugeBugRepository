[{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/502682458","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/4733#issuecomment-502682458","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/4733","id":502682458,"node_id":"MDEyOklzc3VlQ29tbWVudDUwMjY4MjQ1OA==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-06-17T13:29:28Z","updated_at":"2019-06-17T13:29:28Z","body":"note that enums don't need to have names unless they are Postgresql specific, however adding the name to the message if one is available should be fine.   \r\n\r\nAs far as possible values, this is also a good idea, but for it to be robust it would need to be implemented so as not to create an error message that is too long - assume some people have enums with 500 names in them and/or names that are hundreds of characters long.         There is a class that is used for this task within the realm of bound parameter sets at https://github.com/sqlalchemy/sqlalchemy/blob/master/lib/sqlalchemy/sql/util.py#L463, this is more complicated than what's needed here, a new helper function _repr_tuple_names() can be added to util/langhelpers.py that will list out the string entries of a given tuple using ellipses for more than four values, as well as use ellipses for very long names:\r\n\r\n```\r\n'foo', 'bar','bat',  ... 'hoho'\r\n'foo', 'bar', 'someverylongnametha...', .., 'hoho'\r\n\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/502682458/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":2417604433,"node_id":"MDEyOkxhYmVsZWRFdmVudDI0MTc2MDQ0MzM=","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/2417604433","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/use