[{"id":7932736006,"node_id":"LE_lADOCX5JB85XtMXkzwAAAAHY0_IG","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/7932736006","actor":{"login":"phofl","id":61934744,"node_id":"MDQ6VXNlcjYxOTM0NzQ0","avatar_url":"https://avatars.githubusercontent.com/u/61934744?v=4","gravatar_id":"","url":"https://api.github.com/users/phofl","html_url":"https://github.com/phofl","followers_url":"https://api.github.com/users/phofl/followers","following_url":"https://api.github.com/users/phofl/following{/other_user}","gists_url":"https://api.github.com/users/phofl/gists{/gist_id}","starred_url":"https://api.github.com/users/phofl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/phofl/subscriptions","organizations_url":"https://api.github.com/users/phofl/orgs","repos_url":"https://api.github.com/users/phofl/repos","events_url":"https://api.github.com/users/phofl/events{/privacy}","received_events_url":"https://api.github.com/users/phofl/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2022-12-01T14:59:33Z","label":{"name":"requires triage","color":"ffff00"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1333901259","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/8917#issuecomment-1333901259","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/8917","id":1333901259,"node_id":"IC_kwDOCX5JB85PgbfL","user":{"login":"CaselIT","id":16175304,"node_id":"MDQ6VXNlcjE2MTc1MzA0","avatar_url":"https://avatars.githubusercontent.com/u/16175304?v=4","gravatar_id":"","url":"https://api.github.com/users/CaselIT","html_url":"https://github.com/CaselIT","followers_url":"https://api.github.com/users/CaselIT/followers","following_url":"https://api.github.com/users/CaselIT/following{/other_user}","gists_url":"https://api.github.com/users/CaselIT/gists{/gist_id}","starred_url":"https://api.github.com/users/CaselIT/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CaselIT/subscriptions","organizations_url":"https://api.github.com/users/CaselIT/orgs","repos_url":"https://api.github.com/users/CaselIT/repos","events_url":"https://api.github.com/users/CaselIT/events{/privacy}","received_events_url":"https://api.github.com/users/CaselIT/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-12-01T15:03:42Z","updated_at":"2022-12-01T15:03:42Z","body":"Hi,\r\n\r\nI think this goes into the realm of expected behaviour.\r\n\r\nYou are passing an int instead of a string and the db does not like that. Pass a string and it will work correctly.\r\nIf you want to pass strings or int, you can probably create a TypeDecorator that does the string conversion","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/1333901259/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"CaselIT","id":16175304,"node_id":"MDQ6VXNlcjE2MTc1MzA0","avatar_url":"https://avatars.githubusercontent.com/u/16175304?v=4","gravatar_id":"","url":"https://api.github.com/users/CaselIT","html_url":"https://github.com/CaselIT","followers_url":"https://api.github.com/users/CaselIT/followers","following_url":"https://api.github.com/users/CaselIT/following{/other_user}","gists_url":"https://api.github.com/users/CaselIT/gists{/gist_id}","starred_url":"https://api.github.com/users/CaselIT/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CaselIT/subscriptions","organizations_url":"https://api.github.com/users/CaselIT/orgs","repos_url":"https://api.github.com/users/CaselIT/repos","events_url":"https://api.github.com/users/CaselIT/events{/privacy}","received_events_url":"https://api.github.com/users/CaselIT/received_events","type