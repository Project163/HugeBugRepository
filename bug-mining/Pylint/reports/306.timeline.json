a-core/commits{/sha}","git_commits_url":"https://api.github.com/repos/aiidateam/aiida-core/git/commits{/sha}","comments_url":"https://api.github.com/repos/aiidateam/aiida-core/comments{/number}","issue_comment_url":"https://api.github.com/repos/aiidateam/aiida-core/issues/comments{/number}","contents_url":"https://api.github.com/repos/aiidateam/aiida-core/contents/{+path}","compare_url":"https://api.github.com/repos/aiidateam/aiida-core/compare/{base}...{head}","merges_url":"https://api.github.com/repos/aiidateam/aiida-core/merges","archive_url":"https://api.github.com/repos/aiidateam/aiida-core/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/aiidateam/aiida-core/downloads","issues_url":"https://api.github.com/repos/aiidateam/aiida-core/issues{/number}","pulls_url":"https://api.github.com/repos/aiidateam/aiida-core/pulls{/number}","milestones_url":"https://api.github.com/repos/aiidateam/aiida-core/milestones{/number}","notifications_url":"https://api.github.com/repos/aiidateam/aiida-core/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/aiidateam/aiida-core/labels{/name}","releases_url":"https://api.github.com/repos/aiidateam/aiida-core/releases{/id}","deployments_url":"https://api.github.com/repos/aiidateam/aiida-core/deployments","created_at":"2016-12-23T15:38:21Z","updated_at":"2025-12-12T13:18:25Z","pushed_at":"2025-12-12T11:52:14Z","git_url":"git://github.com/aiidateam/aiida-core.git","ssh_url":"git@github.com:aiidateam/aiida-core.git","clone_url":"https://github.com/aiidateam/aiida-core.git","svn_url":"https://github.com/aiidateam/aiida-core","homepage":"https://aiida-core.readthedocs.io","size":144873,"stargazers_count":514,"watchers_count":514,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":true,"has_discussions":true,"forks_count":235,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":576,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["aiida","computational-science","data-provenance","database","provenance","scheduler","ssh","workflow","workflow-engine","workflows"],"visibility":"public","forks":235,"open_issues":576,"watchers":514,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/aiidateam/aiida-core/pulls/3686","html_url":"https://github.com/aiidateam/aiida-core/pull/3686","diff_url":"https://github.com/aiidateam/aiida-core/pull/3686.diff","patch_url":"https://github.com/aiidateam/aiida-core/pull/3686.patch","merged_at":"2020-01-10T10:11:04Z"},"body":"This PR incorporates two new tools for graph traversal:\r\n\r\n1) The AiiDA Graph Explorer (AGE) package of classes: this is a general tool that allows to do complex graph traversal operations in an AiiDA 'expanded graph' (in which both the AiiDA nodes and groups are considered to be graph nodes) by defining 'rules' from generic querybuilder instances. Then, given an initial set of nodes (that have to be set inside generic 'baskets'), these queries will be successively applied on top of the results of the previous one, repeating the whole cycle the desired number of times (which could be 'until no new nodes are added').\r\n\r\n2) The `traverse_graph` function: this is a simplified interface to use the AGE to search for AiiDA nodes and links using a reduced set of customizable rules. Contrary to the AGE, which retains basically the same versatility of the querybuilder and thus allows for very complex traversals, with `traverse_graph` you can only specify which type of links will be allowed to be traversed and in which direction, and these are all traversed in each iteration. The advantage is that one no longer needs to manually define and handle baskets and querybuilders.\r\n\r\nThe function `traverse_graph` (which uses AGE as its search engine) is now used by the delete, the export  and the graph visualization procedures. For the first one, the `delete_nodes` function now uses this function instead of doing its own search but the procedure is similar to how it was performed before. On the other hand, for the export procedure every node added to the set was queried separately for ancestors and descendants, whereas now the whole sets of new nodes found are queried for more nodes (all of this happens inside the `retrieve_linked_nodes` function). Finally, the graph class methods `recurse_descendants` and `recurse_ancestors` used to work by calling the `add_incoming` and `add_outgoing` many times, inside of which nodes were loaded to get their pks. Now these are all independent and each has its own call to `traverse_graph`, where pks are obtained directly from the query projection.\r\n\r\nThis closes #3331 ","reactions":{"url":"https://api.github.com/repos/aiidateam/aiida-core/issues/3686/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/aiidateam/aiida-core/issues/3686/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"actor":{"login":"m-chaturvedi","id":1082919,"node_id":"MDQ6VXNlcjEwODI5MTk=","avatar_url":"https://avatars.githubusercontent.com/u/1082919?v=4","gravatar_id":"","url":"https://api.github.com/users/m-chaturvedi","html_url":"https://github.com/m-chaturvedi","followers_url":"https://api.github.com/users/m-chaturvedi/followers","following_url":"https://api.github.com/users/m-chaturvedi/following{/other_user}","gists_url":"https://api.github.com/users/m-chaturvedi/gists{/gist_id}","starred_url":"https://api.github.com/users/m-chaturvedi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/m-chaturvedi/subscriptions","organizations_url":"https://api.github.com/users/m-chaturv