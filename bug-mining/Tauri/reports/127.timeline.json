w| {\r\n     *control_flow = ControlFlow::Wait;\r\n-    println!(\"{:?}\", event);\r\n+    // println!(\"{:?}\", event);\r\n \r\n+    if let Event::WindowEvent {\r\n+      event: WindowEvent::Resized(size),\r\n+      ..\r\n+    } = event\r\n+    {\r\n+      println!(\"new size: {:?}\", size);\r\n+    }\r\n     match event {\r\n       Event::WindowEvent {\r\n         event: WindowEvent::CloseRequested,\r\n```\r\n\r\nAnd yes, the width and height values do change.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/tauri-apps/tauri/issues/comments/898766887/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"smolck","id":46855713,"node_id":"MDQ6VXNlcjQ2ODU1NzEz","avatar_url":"https://avatars.githubusercontent.com/u/46855713?v=4","gravatar_id":"","url":"https://api.github.com/users/smolck","html_url":"https://github.com/smolck","followers_url":"https://api.github.com/users/smolck/followers","following_url":"https://api.github.com/users/smolck/following{/other_user}","gists_url":"https://api.github.com/users/smolck/gists{/gist_id}","starred_url":"https://api.github.com/users/smolck/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smolck/subscriptions","organizations_url":"https://api.github.com/users/smolck/orgs","repos_url":"https://api.github.com/users/smolck/repos","events_url":"https://api.github.com/users/smolck/events{/privacy}","received_events_url":"https://api.github.com/users/smolck/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":5157993648,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50NTE1Nzk5MzY0OA==","url":"https://api.github.com/repos/tauri-apps/tauri/issues/events/5157993648","actor":{"login":"amrbashir","id":48618675,"node_id":"MDQ6VXNlcjQ4NjE4Njc1","avatar_url":"https://avatars.githubusercontent.com/u/48618675?v=4","gravatar_id":"","url":"https://api.github