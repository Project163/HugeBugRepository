kend in selected_backends:\n            if isinstance(backend, required_interfaces):\n                filtered_backends.append(backend)\n\n        # If you pass an empty list to parametrize Bad Things(tm) happen\n        # as of pytest 2.6.4 when the test also has a parametrize decorator\n        skip_if_empty(filtered_backends, required_interfaces)\n\n        metafunc.parametrize(\"backend\", filtered_backends)\n```\n\nand then running `py.test tests/test_fernet.py -s`\n\n```\ncollecting 0 items(<class 'cryptography.hazmat.backends.interfaces.HMACBackend'>, <class 'cryptography.hazmat.backends.interfaces.CipherBackend'>)\n(<class 'cryptography.hazmat.backends.interfaces.CipherBackend'>, <class 'cryptography.hazmat.backends.interfaces.CipherBackend'>)\n(<class 'cryptography.hazmat.backends.interfaces.CipherBackend'>, <class 'cryptography.hazmat.backends.interfaces.CipherBackend'>)\n(<class 'cryptography.hazmat.backends.interfaces.CipherBackend'>, <class 'cryptography.hazmat.backends.interfaces.CipherBackend'>)\n(<class 'cryptography.hazmat.backends.interfaces.CipherBackend'>, <class 'cryptography.hazmat.backends.interfaces.CipherBackend'>)\n(<class 'cryptography.hazmat.backends.interfaces.CipherBackend'>, <class 'cryptography.hazmat.backends.interfaces.CipherBackend'>)\n(<class 'cryptography.hazmat.backends.interfaces.CipherBackend'>, <class 'cryptography.hazmat.backends.interfaces.CipherBackend'>)\n(<class 'cryptography.hazmat.backends.interfaces.CipherBackend'>, <class 'cryptography.hazmat.backends.interfaces.CipherBackend'>)\n(<class 'cryptography.hazmat.backends.interfaces.CipherBackend'>, <class 'cryptography.hazmat.backends.interfaces.CipherBackend'>)\ncollecting 36 items(<class 'cryptography.hazmat.backends.interfaces.HMACBackend'>, <class 'cryptography.hazmat.backends.interfaces.CipherBackend'>)\n(<class 'cryptography.hazmat.backends.interfaces.CipherBackend'>, <class 'cryptography.hazmat.backends.interfaces.CipherBackend'>)\n(<class 'cryptography.hazmat.bac