thub.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2017-03-28T14:43:44Z","rename":{"from":"Custom audio extension alongside base audio renderer","to":"DefaultTrackSelector should avoid enabling multiple renderers implementing MediaClock by default"},"performed_via_github_app":null},{"id":1018686755,"node_id":"MDEyOkxhYmVsZWRFdmVudDEwMTg2ODY3NTU=","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/1018686755","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2017-03-28T14:43:48Z","label":{"name":"bug","color":"fc2929"},"performed_via_github_app":null},{"id":1018686756,"node_id":"MDE0OlVubGFiZWxlZEV2ZW50MTAxODY4Njc1Ng==","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/1018686756","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"unlabeled","commit_id":null,"commit_url":null,"created_at":"2017-03-28T14:43:48Z","label":{"name":"enhancement","color":"84b6eb"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/289833609","html_url":"https://github.com/google/ExoPlayer/issues/2618#issuecomment-289833609","issue_url":"https://api.github.com/repos/google/ExoPlayer/issues/2618","id":289833609,"node_id":"MDEyOklzc3VlQ29tbWVudDI4OTgzMzYwOQ==","user":{"login":"SteUK","id":7014856,"node_id":"MDQ6VXNlcjcwMTQ4NTY=","avatar_url":"https://avatars.githubusercontent.com/u/7014856?v=4","gravatar_id":"","url":"https://api.github.com/users/SteUK","html_url":"https://github.com/SteUK","followers_url":"https://api.github.com/users/SteUK/followers","following_url":"https://api.github.com/users/SteUK/following{/other_user}","gists_url":"https://api.github.com/users/SteUK/gists{/gist_id}","starred_url":"https://api.github.com/users/SteUK/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SteUK/subscriptions","organizations_url":"https://api.github.com/users/SteUK/orgs","repos_url":"https://api.github.com/users/SteUK/repos","events_url":"https://api.github.com/users/SteUK/events{/privacy}","received_events_url":"https://api.github.com/users/SteUK/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-03-28T16:51:53Z","updated_at":"2017-03-28T16:51:53Z","body":"Roger that!  Your suggestion to override selectTracks works a treat.  I had to couple in disabling of 'none desired' renderers when changing audio stream  (trackSelector.setRendererDisabled( iRenderer, true );)\r\n\r\nHere is the class for anyone looking to do the same:\r\n\r\npublic class MultiAudio_DefaultTrackSelector extends DefaultTrackSelector\r\n{\r\n    public MultiAudio_DefaultTrackSelector( TrackSelection.Factory adaptiveVideoTrackSelectionFactory )\r\n    {\r\n        super( adaptiveVideoTrackSelectionFactory );\r\n    }\r\n\r\n    @Override\r\n    protected TrackSelection[] selectTracks(RendererCapabilities[] rendererCapabilities, TrackGroupArray[] rendererTrackGroupArrays, int[][][] rendererFormatSupports) throws ExoPlaybackException\r\n    {\r\n        // Make a track selection for each renderer.\r\n        int rendererCount = rendererCapabilities.length;\r\n        Parameters params = getParameters();\r\n\r\n        // Call parent to fill in video renderer\r\n        TrackSelection[] rendererTrackSelections = super.selectTracks( rendererCapabilities, rendererTrackGroupArrays, rendererFormatSupports );\r\n\r\n        boolean bSeenAudio = false;\r\n        for (int i = 0; i < rendererCount; i++)\r\n        {\r\n            if( rendererCapabilities[ i ].getTrackType() == C.TRACK_TYPE_AUDIO && rendererTrackSelections[ i ] != null )\r\n            {\r\n                if( bSeenAudio )\r\n                {\r\n                    rendererTrackSelections[ i ] = null;\r\n                }\r\n                bSeenAudio = true;\r\n            }\r\n        }\r\n\r\n        return rendererTrackSelections;\r\n    }\r\n}","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/289833609/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"SteUK","id":7014856,"node_id":"MDQ6VXNlcjcwMTQ4NTY=","avatar_url":"https://avatars.githubusercontent.com/u/7014856?v=4","gravatar_id":"","url":"https://api.github.com/users/SteUK","html_url":"https://github.com/SteUK","followers_url":"https://api.github.com/users/SteUK/followers","following_url":"https://api.github.com/users/SteUK/following{/other_user}","gists_url":"https://api.github.com/users/SteUK/gists{/gist_id}","starred_url":"https://api.github.com/users/SteUK/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SteUK/subscriptions","organizations_url":"https://api.github.com/users/SteUK/orgs","repos_url":"https://api.github.com/users/SteUK/repos","events_url":"https://api.github.com/users/SteUK/events{/privacy}","received_events_url":"https://api.github.com/users/SteUK/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1021144609,"node_id":"MDEzOkFzc2lnbmVkRXZlbnQxMDIxMTQ0NjA5","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/1021144609","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/ow