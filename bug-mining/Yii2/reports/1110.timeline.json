[{"url":"https://api.github.com/repos/yiisoft/yii2/issues/comments/501628721","html_url":"https://github.com/yiisoft/yii2/issues/17365#issuecomment-501628721","issue_url":"https://api.github.com/repos/yiisoft/yii2/issues/17365","id":501628721,"node_id":"MDEyOklzc3VlQ29tbWVudDUwMTYyODcyMQ==","user":{"login":"gerpayt","id":3348817,"node_id":"MDQ6VXNlcjMzNDg4MTc=","avatar_url":"https://avatars.githubusercontent.com/u/3348817?v=4","gravatar_id":"","url":"https://api.github.com/users/gerpayt","html_url":"https://github.com/gerpayt","followers_url":"https://api.github.com/users/gerpayt/followers","following_url":"https://api.github.com/users/gerpayt/following{/other_user}","gists_url":"https://api.github.com/users/gerpayt/gists{/gist_id}","starred_url":"https://api.github.com/users/gerpayt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gerpayt/subscriptions","organizations_url":"https://api.github.com/users/gerpayt/orgs","repos_url":"https://api.github.com/users/gerpayt/repos","events_url":"https://api.github.com/users/gerpayt/events{/privacy}","received_events_url":"https://api.github.com/users/gerpayt/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-06-13T09:37:39Z","updated_at":"2019-06-13T09:37:39Z","body":"I guess the problem was caused by `touch` function in php\r\nthe function `setValue()` in `FileCache.php`\r\n```\r\n    protected function setValue($key, $value, $duration)\r\n    {\r\n        $this->gc();\r\n        $cacheFile = $this->getCacheFile($key);\r\n        if ($this->directoryLevel > 0) {\r\n            @FileHelper::createDirectory(dirname($cacheFile), $this->dirMode, true);\r\n        }\r\n        if (@file_put_contents($cacheFile, $value, LOCK_EX) !== false) {\r\n            if ($this->fileMode !== null) {\r\n                @chmod($cacheFile, $this->fileMode);\r\n            }\r\n            if ($duration <= 0) {\r\n                $duration = 31536000; // 1 year\r\n            }\r\n\r\n            return @touch($cacheFile, $duration + time());\r\n        }\r\n\r\n        $error = error_get_last();\r\n        Yii::warning(\"Unable to write cache file '{$cacheFile}': {$error['message']}\", __METHOD__);\r\n        return false;\r\n    }\r\n```\r\n\r\n`touch()` function always return `False` when operator is different with the owner of cache file.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/yiisoft/yii2/issues/comments/501628721/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"gerpayt","id":3348817,"node_id":"MDQ6VXNlcjMzNDg4MTc=","avatar_url":"https://avatars.githubusercontent.com/u/3348817?v=4","gravatar_id":"","url":"https://api.github.com/users/gerpayt","html_url":"https://github.com/gerpayt","followers_url":"https://api.github.com/users/gerpayt/followers","following_url":"https://api.github.com/users/gerpayt/following{/other_user}","gists_url":"https://api.github.com/users/gerpayt/gists{/gist_id}","starred_url":"https://api.github.com/users/gerpayt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gerpayt/subscriptions","organizations_url":"https://api.github.com/users/gerpayt/orgs","repos_url":"https://api.github.com/users/gerpayt/repos","events_url":"https://api.github.com/users/gerpayt/events{/privacy}","received_events_url":"https://api.github.com/users/gerpayt/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":2414903261,"node_id":"MDEyOkxhYmVsZWRFdmVudDI0MTQ5MDMyNjE=","url":"https://api.github.com/repos/yiisoft/yii2/issues/events/2414903261","actor":{"login":"samdark","id":47294,"node_id":"MDQ6VXNlcjQ3Mjk0","avatar_url":"https://avatars.githubusercontent.com/u/47294?v=4","gravatar_id":"","url":"https://api.github.com/users/samdark","html_url":"https://github.com/samdark","followers_url":"https://api.github.com/users/s