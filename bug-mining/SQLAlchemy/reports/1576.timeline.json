r/subscriptions","organizations_url":"https://api.github.com/users/sqla-tester/orgs","repos_url":"https://api.github.com/users/sqla-tester/repos","events_url":"https://api.github.com/users/sqla-tester/events{/privacy}","received_events_url":"https://api.github.com/users/sqla-tester/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-10T22:24:35Z","updated_at":"2025-07-10T22:24:35Z","body":"**Federico Caselli** has proposed a fix for this issue in the **rel_2_0** branch:\n\n**Re-raise ``CancelledError`` in asyncpg** https://gerrit.sqlalchemy.org/c/sqlalchemy/sqlalchemy/+/6027","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/3059327064/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"sqla-tester","id":8250554,"node_id":"MDQ6VXNlcjgyNTA1NTQ=","avatar_url":"https://avatars.githubusercontent.com/u/8250554?v=4","gravatar_id":"","url":"https://api.github.com/users/sqla-tester","html_url":"https://github.com/sqla-tester","followers_url":"https://api.github.com/users/sqla-tester/followers","following_url":"https://api.github.com/users/sqla-tester/following{/other_user}","gists_url":"https://api.github.com/users/sqla-tester/gists{/gist_id}","starred_url":"https://api.github.com/users/sqla-tester/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqla-tester/subscriptions","organizations_url":"https://api.github.com/users/sqla-tester/orgs","repos_url":"https://api.github.com/users/sqla-tester/repos","events_url":"https://api.github.com/users/sqla-tester/events{/privacy}","received_events_url":"https://api.github.com/users/sqla-tester/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/3060205076","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/12728#issuecomment-3060205076","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/12728","id":3060205076,"node_id":"IC_kwDOCX5JB862ZwYU","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-11T03:21:27Z","updated_at":"2025-07-11T03:21:27Z","body":"this might not be our bug because I can reproduce the problem without SQLAlchemy at all.   Using an extremely simplistic connection pool that shouldnt be causing deadlocks.   See below:\n\n```py\nimport asyncio\nimport asyncpg\nimport uuid\n\n\nsemaphore = asyncio.Semaphore(2)\n\n\nclass DumbPool:\n    def __init__(self):\n        self.pool = []\n\n    async def get(self):\n        if self.pool:\n            print(\"using pooled connection\")\n            conn = self.pool.pop(0)\n            return conn\n        else:\n            print(\"making new connection\")\n            conn = await asyncpg.connect(\n                user=\"scott\",\n                password=\"tiger\",\n                host=\"localhost\",\n                database=\"test\",\n            )\n            return conn\n\n    def put(self, conn):\n        self.pool.append(conn)\n\n\ndumb_pool = DumbPool()\n\n\nasync def long_commit_task(magic: int):\n    async with semaphore:\n\n        print(f\"Adding {magic} to delayed_commit...\")\n\n        the_asyncpg_connection = await dumb_pool.get()\n        print(f\"{magic} has asyncpg connection {the_asyncpg_connection}\")\n\n        await the_asyncpg_connection.executemany(\n            \"INSERT INTO delayed_commit (id, magic) VALUES ($1::UUID, $2::INTEGER)\",\n            [(uuid.uuid4(), magic) for i in range(100000)],\n        )\n        print(f\"{magic} Done\")\n\n        dumb_pool.put(the_asyncpg_connection)\n        print(f\"{magic} closed\")\n\n\nasync def crashing_task():\n    async with semaphore:\n        print(\"Failing!\")\n        raise ValueError(\"Another task failed while we were committing\")\n\n\nasync def main():\n\n    the_asyncpg_connection = await dumb_pool.get()\n    await the_asyncpg_connection.execute(\n        \"\"\"CREATE TABLE IF NOT EXISTS\n        delayed_commit (id uuid PRIMARY KEY, magic INT)\"\"\"\n    )\n    await the_asyncpg_connection.execute(\"\"\"DELETE FROM delayed_commit\"\"\")\n    dumb_pool.put(the_asyncpg_connection)\n\n    print(\"---------START------------\")\n    tasks = []\n    for i in range(2):\n        tasks.append(asyncio.create_task(long_commit_task(i)))\n    tasks.append(asyncio.create_task(crashing_task()))\n\n    await asyncio.gather(*tasks)\n\n\nif __name__ == \"__main__\":\n    asyncio.run(main())\n\n```\n\nit's improtant that the pool has one connection in it before the tasks start.   with the above I get the same deadlocked output:\n\n```\n$ python test4.py \nmaking new connection\n---------START------------\nAdding 0 to delayed_commit...\nusing pooled connection\n0 has asyncpg connection <asyncpg.connection.Connection object at 0x7fab2c26e300>\nAdding 1 to delayed_commit...\nmaking new connection\n1 has asyncpg connection <asyncpg.connection.Connection object at 0x7fab2c26e8a0>\n0 Done\n0 closed\nFailing!\n\n```\n\nsimilar symptom in pg stat:\n\n```\ntest=> SELECT pid, wait_event, query, query_start\nFROM pg_stat_activity\nWHERE state IS NOT NULL AND pid != PG_BACKEND_PID();\n   pid   | wait_event |                                 query                                 |          query_start          \n---------+------------+-----------------------------------------------------------------------+-------------------------------\n 2067684 | ClientRead | INSERT INTO delayed_commit (id, magic) VALUES ($1::UUID, $2::INTEGER) | 2025-07-10 23:20:24.271955-04\n 2067685 | ClientRead | INSERT INTO delayed_commit (id, magic) VALUES ($1::UUID, $2::INTEGER) | 2025-07-10 23:20:24.409888-04\n(2 rows)\n\n```\n\nnote that this is NOT a DB deadlock at all.   this is juts something to do with multiple asyncpg connections in play at once, like they are doing something global perhaps.   no issue with psycopg3.    So leaning towards \"it's them\" on this one.\n\n\n\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/3060205076/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api