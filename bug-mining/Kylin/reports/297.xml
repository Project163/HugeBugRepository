&lt;span class=&quot;code-keyword&quot;&gt;where&lt;/span&gt; project_name = &lt;span class=&quot;code-quote&quot;&gt;&quot;abc&quot;&lt;/span&gt;;

&lt;span class=&quot;code-keyword&quot;&gt;select&lt;/span&gt; &lt;span class=&quot;code-keyword&quot;&gt;distinct&lt;/span&gt; engine_type &lt;span class=&quot;code-keyword&quot;&gt;from&lt;/span&gt; kylin_query_history &lt;span class=&quot;code-keyword&quot;&gt;where&lt;/span&gt; engine_type &amp;lt;&amp;gt; &#160;&lt;span class=&quot;code-quote&quot;&gt;&apos;NATIVE&apos;&lt;/span&gt; &lt;span class=&quot;code-keyword&quot;&gt;and&lt;/span&gt; project_name = &lt;span class=&quot;code-quote&quot;&gt;&quot;abc&quot;&lt;/span&gt;;
 &lt;/pre&gt;
