diff --git a/extensions/flyway/runtime/src/main/java/io/quarkus/flyway/runtime/graal/FlywaySubstitutions.java b/extensions/flyway/runtime/src/main/java/io/quarkus/flyway/runtime/graal/FlywaySubstitutions.java
