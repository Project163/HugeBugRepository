05199?v=4","gravatar_id":"","url":"https://api.github.com/users/edison1105","html_url":"https://github.com/edison1105","followers_url":"https://api.github.com/users/edison1105/followers","following_url":"https://api.github.com/users/edison1105/following{/other_user}","gists_url":"https://api.github.com/users/edison1105/gists{/gist_id}","starred_url":"https://api.github.com/users/edison1105/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/edison1105/subscriptions","organizations_url":"https://api.github.com/users/edison1105/orgs","repos_url":"https://api.github.com/users/edison1105/repos","events_url":"https://api.github.com/users/edison1105/events{/privacy}","received_events_url":"https://api.github.com/users/edison1105/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/vuejs/core/issues/comments/898799678","html_url":"https://github.com/vuejs/core/issues/4334#issuecomment-898799678","issue_url":"https://api.github.com/repos/vuejs/core/issues/4334","id":898799678,"node_id":"IC_kwDOCCum1841kpg-","user":{"login":"JamesChenX","id":44962329,"node_id":"MDQ6VXNlcjQ0OTYyMzI5","avatar_url":"https://avatars.githubusercontent.com/u/44962329?v=4","gravatar_id":"","url":"https://api.github.com/users/JamesChenX","html_url":"https://github.com/JamesChenX","followers_url":"https://api.github.com/users/JamesChenX/followers","following_url":"https://api.github.com/users/JamesChenX/following{/other_user}","gists_url":"https://api.github.com/users/JamesChenX/gists{/gist_id}","starred_url":"https://api.github.com/users/JamesChenX/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JamesChenX/subscriptions","organizations_url":"https://api.github.com/users/JamesChenX/orgs","repos_url":"https://api.github.com/users/JamesChenX/repos","events_url":"https://api.github.com/users/JamesChenX/events{/privacy}","received_events_url":"https://api.github.com/users/JamesChenX/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-08-14T02:28:45Z","updated_at":"2021-08-14T02:36:30Z","body":"@edison1105 Sorry about the misleading example.\r\nI was tricked by the pitfall of Object:\r\n\r\n### Steps to reproduce\r\nTaking the following vars as an example, `toDisplayString` will fail with \"var\", but will NOT fail with var \"b\".\r\nbecause \"val\" isn't inherited from Object meaning it doesn't have `toString` while \"b\" has.\r\n\"val\" works fine with `JSON.stringify(val)` but fails with `String(val)`\r\n![image](https://user-images.githubusercontent.com/44962329/129431584-e6e5f254-0d74-48ff-8a21-66d06f087565.png)\r\n\r\n### Solution\r\n```javascript\r\nconst toDisplayString = (val) => {\r\n    return val == null\r\n        ? ''\r\n        : isArray(val) || (isObject(val) && (val.toString === objectToString || val.toString == null)) // Add \"val.toString == null\"\r\n            ? JSON.stringify(val, replacer, 2)\r\n            : String(val);\r\n};\r\n```\r\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/vuejs/core/issues/comments/898799678/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"JamesChenX","id":44962329,"node_id":"MDQ6VXNlcjQ0OTYyMzI5","avatar_url":"https://avatars.githubusercontent.com/u/44962329?v=4","gravatar_id":"","url":"https://api.github.com/users/JamesChenX","html_url":"https://github.com/JamesChenX","followers_url":"https://api.github.com/users/JamesChenX/followers","following_url":"https://api.github.com/users/JamesChenX/following{/other_user}","gists_url":"https://api.github.com/users/JamesChenX/gists{/gist_id}","starred_url":"https://api.github.com/users/JamesChenX/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JamesChenX/subscriptions","organizations_url":"https://api.github.com/users/JamesChenX