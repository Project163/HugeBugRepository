     return YES;
 }
 
+////////////////////////////////////////////////////////
+-(void)keyDown:(NSEvent *)theEvent
+{
+    // Do nothing except preventing a system alert each time a key is pressed
+    //
+    // Special Consideration :
+    // -----------------------
+    // Consider overriding NSResponder -keyDown: message in a Cocoa view/window
