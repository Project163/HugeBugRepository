16:46:06Z","pushed_at":"2025-12-12T10:50:18Z","git_url":"git://github.com/typeorm/typeorm.git","ssh_url":"git@github.com:typeorm/typeorm.git","clone_url":"https://github.com/typeorm/typeorm.git","svn_url":"https://github.com/typeorm/typeorm","homepage":"http://typeorm.io","size":33014,"stargazers_count":36125,"watchers_count":36125,"language":"TypeScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":6469,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":540,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["active-record","cockroachdb","data-mapper","database","electron","hacktoberfest","javascript","mariadb","mysql","oracle","orm","postgresql","react-native","sap","sap-hana","sqlite","sqlserver","typeorm","typescript","websql"],"visibility":"public","forks":6469,"open_issues":540,"watchers":36125,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"### Issue description\n\nWhen using a custom `transformer` for Entity's primary key, this is ignored when saving a one-to-many relation failing to execute the broken SQL INSERT statement.\n\n### Expected Behavior\n\nThe `transformer.to()` should be invoked to marshal the external id of the one-to-many relation.\r\nIn a `User  1-to-N  Photo` relation, where `User` has a custom transformer for its PrimaryKey, the insertion of a `Photo` should invoke `transformer.to()` on the `userId` field.\r\n\r\nThe generated INSERT statement should be:\r\n```sql\r\nINSERT INTO `photo`(`id`, `url`, `userId`) VALUES (?, ?, ?) -- PARAMETERS: [2,\"me.jpg\",1]\r\n```\n\n### Actual Behavior\n\nThe generated INSERT statement instead present the \"raw\" value without any transformation (in this example the transformer simply transforms and quotes the input integer into string):\r\n\r\n```sql\r\nINSERT INTO `photo`(`id`, `url`, `userId`) VALUES (?, ?, ?) -- PARAMETERS: [2,\"me.jpg\",\"\\\"1\\\"\"]\r\n```\r\n\r\nThis generates the error:\r\n```\r\nError: Incorrect integer value: '\"1\"' for column 'userId' at row 1\r\n```\n\n### Steps to reproduce\n\nThis is the script that reproduces the error:\r\n```javascript\r\nimport \"reflect-metadata\"\r\nimport {Column, DataSource, Entity, ManyToOne, OneToMany, PrimaryColumn} from \"typeorm\";\r\n\r\nconst CustomTransformer = {\r\n    from: (value: number) => `\"${value}\"`,\r\n    to: (value: string | undefined | null) => value ? parseInt(value.slice(1, value.length - 1)) : null,\r\n}\r\n\r\n@Entity()\r\nexport class User {\r\n    @PrimaryColumn({type: \"integer\", transformer: CustomTransformer, nullable: false})\r\n    id: string\r\n\r\n    @Column()\r\n    name: string\r\n\r\n    @OneToMany(() => Photo, (photo) => photo.user)\r\n    photos: Photo[]\r\n}\r\n\r\n@Entity()\r\nexport class Photo {\r\n    @PrimaryColumn({type: \"integer\", transformer: CustomTransformer, nullable: false})\r\n    id: string\r\n\r\n    @Column()\r\n    url: string\r\n\r\n    @ManyToOne(() => User, (user) => user.photos)\r\n    user: User\r\n}\r\n\r\nasync function main() {\r\n    const dataSource = new DataSource({\r\n        type: \"mysql\",\r\n        host: \"localhost\",\r\n        port: 3306,\r\n        username: \"root\",\r\n        password: \"...\",\r\n        database: \"testdb\",\r\n        synchronize: true,\r\n        logging: true,\r\n        entities: [User, Photo]\r\n    });\r\n\r\n    await dataSource.initialize();\r\n\r\n    const user = new User()\r\n    user.id = \"\\\"1\\\"\"\r\n    user.name = \"Leo\"\r\n    await dataSource.manager.save(user)\r\n\r\n    const photo1 = new Photo()\r\n    photo1.id = \"\\\"2\\\"\"\r\n    photo1.url = \"me.jpg\"\r\n    photo1.user = user\r\n    await dataSource.manager.save(photo1)\r\n}\r\n\r\nmain().catch(console.error)\r\n```\n\n### My Environment\n\n| Dependency          | Version  |\r\n| ---                 | ---      |\r\n| Operating System    |     macOS     |\r\n| Node.js version     | v21.7.3  |\r\n| Typescript version  | v5.4.5  |\r\n| TypeORM version     | v0.3.20 |\r\n\n\n### Additional Context\n\nThis seems somehow similar (or related) to an old issue I found here: https://github.com/typeorm/typeorm/issues/8690\n\n### Relevant Database Driver(s)\n\n- [ ] aurora-mysql\n- [ ] aurora-postgres\n- [ ] better-sqlite3\n- [ ] cockroachdb\n- [ ] cordova\n- [ ] expo\n- [ ] mongodb\n- [X] mysql\n- [ ] nativescript\n- [ ] oracle\n- [ ] postgres\n- [ ] react-native\n- [ ] sap\n- [ ] spanner\n- [ ] sqlite\n- [ ] sqlite-abstract\n- [ ] sqljs\n- [ ] sqlserver\n\n### Are you willing to resolve this issue by submitting a Pull Request?\n\nYes, I have the time, but I don't know how to start. I would need guidance.","reactions":{"url":"https://api.github.com/repos/typeorm/typeorm/issues/11044/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/typeorm/typeorm/issues/11044/timeline","performed_via_github_app":null,"state_reason":"not_planned"}},"event":"cross-referenced"}]