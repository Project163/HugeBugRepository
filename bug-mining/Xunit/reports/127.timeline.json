dio.xunit/deployments","created_at":"2014-06-30T03:01:29Z","updated_at":"2025-12-09T03:22:34Z","pushed_at":"2025-12-09T03:22:29Z","git_url":"git://github.com/xunit/visualstudio.xunit.git","ssh_url":"git@github.com:xunit/visualstudio.xunit.git","clone_url":"https://github.com/xunit/visualstudio.xunit.git","svn_url":"https://github.com/xunit/visualstudio.xunit","homepage":"https://xunit.net/","size":1488,"stargazers_count":163,"watchers_count":163,"language":"C#","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":79,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":5,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":[],"visibility":"public","forks":79,"open_issues":5,"watchers":163,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"# Repro steps\n\nThis can be for example tested on https://github.com/microsoft/vs-streamjsonrpc, by forcing vstest mode in the test project:\n\n```\n<DisableTestingPlatformServerCapability>true</DisableTestingPlatformServerCapability>\n<TestingPlatformDotnetTestSupport>false</TestingPlatformDotnetTestSupport>\n<UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>\n```\n\nIf a user triggers a run in test explorer and then stops it mid-run, the test runner does not finish running it immediately.\nIt keeps running until completion. This causes file locking issues to appear.\n\n# Expected\n\nvstest and testhosts pass in the parentprocessid, so that the child process closes immediately as soon as the parent closes.\nif xunit test process would similarly pass in the parent process id, it could also detect parent closing and close immediately.\n ","reactions":{"url":"https://api.github.com/repos/xunit/visualstudio.xunit/issues/447/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/xunit/visualstudio.xunit/issues/447/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"actor":{"login":"marcOcram","id":784604,"node_id":"MDQ6VXNlcjc4NDYwNA==","avatar_url":"https://avatars.githubusercontent.com/u/784604?v=4","gravatar_id":"","url":"https://api.github.com/users/marcOcram","html_url":"https://github.com/marcOcram","followers_url":"https://api.github.com/users/marcOcram/followers","following_url":"https://api.github.com/users/marcOcram/following{/other_user}","gists_url":"https://api.github.com/users/marcOcram/gists{/gist_id}","starred_url":"https://api.github.com/users/marcOcram/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/marcOcram/subscriptions","organizations_url":"https://api.github.com/users/marcOcram/orgs","repos_url":"https://api.github.com/users/marcOcram/repos","events_url":"https://api.github.com/users/marcOcram/events{/privacy}","received_events_url":"https://api.github.com/users/marcOcram/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-27T09:29:58Z","updated_at":"2025-11-27T09:29:58Z","source":{"type":"issue","issue":{"url":"https://api.github.com/repos/xunit/xunit/issues/3452","repository_url":"https://api.github.com/repos/xunit/xunit","labels_url":"https://api.github.com/repos/xunit/xunit/issues/3452/labels{/name}","comments_url":"https://api.github.com/repos/xunit/xunit/issues/3452/comments","events_url":"https://api.github.com/repos/xunit/xunit/issues/3452/events","html_url":"https://github.com/xunit/xunit/issues/3452","id":3670589992,"node_id":"I_kwDOAJbtsc7ayMIo","number":3452,"title":"Sleeping thread prevents test runner from exiting","user":{"login":"marcOcram","id":784604,"node_id":"MDQ6VXNlcjc4NDYwNA==","avatar_url":"https://avatars.githubuserc