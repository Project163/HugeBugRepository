                                    <reporter username="agoncharuk">Alexey Goncharuk</reporter>
                        <labels>
                    </labels>
                <created>Tue, 28 Jul 2015 21:23:29 +0000</created>
                <updated>Sat, 1 Aug 2015 01:05:27 +0000</updated>
                            <resolved>Sat, 1 Aug 2015 00:36:44 +0000</resolved>
