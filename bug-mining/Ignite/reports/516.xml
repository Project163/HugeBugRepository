<item>
            <title>[IGNITE-264] Queue failover tests fail in transactional cache</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-264</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;See &lt;tt&gt;GridCachePartitionedQueueFailoverDataConsistencySelfTest&lt;/tt&gt;.&lt;/p&gt;</description>
                <environment></environment>
        <key id="12775280">IGNITE-264</key>
            <summary>Queue failover tests fail in transactional cache</summary>
                <type id="1" iconUrl="https://issues.apache.org/jira/secure/viewavatar?size=xsmall&amp;avatarId=21133&amp;avatarType=issuetype">Bug</type>
