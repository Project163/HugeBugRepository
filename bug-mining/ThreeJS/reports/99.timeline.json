oSilent/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WhySoSilent/subscriptions","organizations_url":"https://api.github.com/users/WhySoSilent/orgs","repos_url":"https://api.github.com/users/WhySoSilent/repos","events_url":"https://api.github.com/users/WhySoSilent/events{/privacy}","received_events_url":"https://api.github.com/users/WhySoSilent/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/mrdoob/three.js/issues/comments/36513533","html_url":"https://github.com/mrdoob/three.js/issues/4517#issuecomment-36513533","issue_url":"https://api.github.com/repos/mrdoob/three.js/issues/4517","id":36513533,"node_id":"MDEyOklzc3VlQ29tbWVudDM2NTEzNTMz","user":{"login":"WestLangley","id":1000017,"node_id":"MDQ6VXNlcjEwMDAwMTc=","avatar_url":"https://avatars.githubusercontent.com/u/1000017?v=4","gravatar_id":"","url":"https://api.github.com/users/WestLangley","html_url":"https://github.com/WestLangley","followers_url":"https://api.github.com/users/WestLangley/followers","following_url":"https://api.github.com/users/WestLangley/following{/other_user}","gists_url":"https://api.github.com/users/WestLangley/gists{/gist_id}","starred_url":"https://api.github.com/users/WestLangley/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WestLangley/subscriptions","organizations_url":"https://api.github.com/users/WestLangley/orgs","repos_url":"https://api.github.com/users/WestLangley/repos","events_url":"https://api.github.com/users/WestLangley/events{/privacy}","received_events_url":"https://api.github.com/users/WestLangley/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-03-03T14:19:10Z","updated_at":"2014-03-03T14:19:10Z","body":"If you change the light to a `SpotLight`, your program works correctly.\n\nThis is a bug in setting the `#defines` in the shader. To get your program to work with a `DirectionalLight`, the following change in `ShaderChunks.js` must be made _everywhere it occurs_.\n\n```\n-   \"#if MAX_SPOT_LIGHTS > 0 || defined( USE_BUMPMAP )\",\n+   \"#if MAX_SPOT_LIGHTS > 0 || defined( USE_BUMPMAP ) || defined( USE_ENVMAP )\",\n```\n\nThe problem is that while this change guarantees that all needed variables are defined when needed, it leads to warnings if the only material texture is an environment map.\n\n```\n WARNING: Output of vertex shader 'vWorldPosition' not read by fragment shader\n```\n\nGetting the `#defines` correct is a little tricky...\n","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/mrdoob/three.js/issues/comments/36513533/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"WestLangley","id":1000017,"node_id":"MDQ6VXNlcjEwMDAwMTc=","avatar_url":"https://avatars.githubusercontent.com/u/1000017?v=4","gravatar_id":"","url":"https://api.github.com/users/WestLangley","html_url":"https://github.com/WestLangley","followers_url":"https://api.github.com/users/WestLangley/followers","following_url":"https://api.github.com/users/WestLangley/following{/other_user}","gists_url":"https://api.github.com/users/WestLangley/gists{/gist_id}","starred_url":"https://api.github.com/users/WestLangley/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WestLangley/subscriptions","organizations_url":"https://api.github.com/users/WestLangley/orgs","repos_url":"https://api.github.com/users/WestLangley/repos","events_url":"https://api.github.com/users/WestLangley/events{/privacy}","received_events_url":"https://api.github.com/users/WestLangley/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":98565130,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDk4NTY1MTMw","url":"https://api.github.com/repos/mrdoob/three.js/issues/events/98565130","actor":{"login":"mrdoob","id":97088,"node_id":"MDQ6