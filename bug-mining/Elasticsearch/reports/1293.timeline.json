c","forks":25807,"open_issues":5588,"watchers":76300,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/elastic/elasticsearch/pulls/13299","html_url":"https://github.com/elastic/elasticsearch/pull/13299","diff_url":"https://github.com/elastic/elasticsearch/pull/13299.diff","patch_url":"https://github.com/elastic/elasticsearch/pull/13299.patch","merged_at":"2015-09-03T12:18:46Z"},"body":"Users might specify something like -Des.network.host=0.0.0.0, as that\nwas the old default with previous versions of elasticsearch. This means\nto bind to all interfaces, but it makes no sense as a publish address.\n\nPick a good one in this case, just like we do in other cases where\npublish isn't explicitly specified and we are bound to multiple (e.g.\nwhen configured by interface, or dns hostname with multiple addresses).\nHowever, in this case warn the user about it: since its arbitrarily\npicking the first non-loopback address like the old versions\ndid, thats a little too heuristical, but lets make the cutover easy.\n\nSeparately, fail hard if things like multicast or broadcast addresses are\nconfigured as bind or publish addresses, as that is simply invalid.\n\nCloses #13274\n","reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/13299/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/elastic/elasticsearch/issues/13299/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":399977275,"node_id":"MDExOkNsb3NlZEV2ZW50Mzk5OTc3Mjc1","url":"https://api.github.com/repos/elastic/elasticsearch/issues/events/399977275","actor":{"login":"rmuir","id":504194,"node_id":"MDQ6VXNlcjUwNDE5NA==","avatar_url":"https://avatars.githubusercontent.com/u/504194?v=4","gravatar_id":"","url":"https://api.github.com/users/rmuir"