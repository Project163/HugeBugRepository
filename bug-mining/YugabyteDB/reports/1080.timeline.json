n_sq\".\"vo_id\" = \"sOBsq\".\"vo_id\"\r\n    where \"sOBsq\".\"rm_entity\" = 'OB'\r\n  ) as \"sOB\"\r\n  left outer join lateral (\r\n    select\r\n      \"p_events\".\"p_events_entity_name\" as \"p_events_entity_name\"\r\n    from (\r\n      select\r\n        \"p_data_sq\".\"vo_id\" as \"p_data_vo_id\",\r\n        \"p_data_sq\".\"entity_idx\" as \"p_data_entity_idx\",\r\n        \"p_data_sq\".\"entity_idx_cap\" as \"p_data_entity_idx_cap\"\r\n      from public.\"comp_data\" as \"p_data_sq\"\r\n      where (\r\n        \"p_data_sq\".\"entity_concept\" = 'at0001'\r\n        and \"sOB\".\"sOB_vo_id\" = \"p_data_sq\".\"vo_id\"\r\n        and \"sOB\".\"sOB_entity_idx\" < \"p_data_sq\".\"entity_idx\"\r\n        and \"sOB\".\"sOB_entity_idx_cap\" > \"p_data_sq\".\"entity_idx\"\r\n        and \"p_data_sq\".\"entity_attribute\" = 'd'\r\n      )\r\n    ) as \"p_data\"\r\n      join (\r\n        select\r\n          \"p_events_sq\".\"vo_id\" as \"p_events_vo_id\",\r\n          \"p_events_sq\".\"entity_idx\" as \"p_events_entity_idx\",\r\n          \"p_events_sq\".\"entity_name\" as \"p_events_entity_name\"\r\n        from public.\"comp_data\" as \"p_events_sq\"\r\n        where (\r\n          \"p_events_sq\".\"entity_concept\" = 'at0002'\r\n          and \"p_events_sq\".\"entity_attribute\" = 'e'\r\n        )\r\n      ) as \"p_events\"\r\n        on (\r\n          \"p_data\".\"p_data_vo_id\" = \"p_events\".\"p_events_vo_id\"\r\n          and \"p_data\".\"p_data_entity_idx\" < \"p_events\".\"p_events_entity_idx\"\r\n          and \"p_data\".\"p_data_entity_idx_cap\" > \"p_events\".\"p_events_entity_idx\"\r\n        )\r\n  ) as \"p_eq\"\r\n    on true\r\nwhere \"sOB\".\"sOB_vo_id\" = 'cf7bedf8-ddf9-4fda-8af3-e444f978d5da';\r\n```\r\n\r\nThis crashes the connection. Removing `Set(yb_enable_optimizer_statistics true)` shows the wron result and removing `Set(yb_bnl_batch_size 200)` shows the correct result\n\n### Issue Type\n\nkind/bug\n\n### Warning: Please confirm that this issu