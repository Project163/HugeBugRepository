,\n            );\n        }\n```\n\nSiteController:\n\n```\npublic function actionContact() {\n        $model = new ContactForm;\n        $model->scenario = 'test';\n        if ($model->load($_POST)) {\n            if ($model->validate()) {\n                 //do smth and refresh\n            }\n        }\n        return $this->render('contact', array(\n                    'model' => $model,\n                ));\n    }\n```\n\nThis is what I've changed from basic application template. Now ActiveForm (in a contact view) with and without client validation behaves differently.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/yiisoft/yii2/issues/comments/25359813/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"azizkh","id":5466772,"node_id":"MDQ6VXNlcjU0NjY3NzI=","avatar_url":"https://avatars.githubusercontent.com/u/5466772?v=4","gravatar_id":"","url":"https://api.github.com/users/azizkh","html_url":"https://github.com/azizkh","followers_url":"https://api.github.com/users/azizkh/followers","following_url":"https://api.github.com/users/azizkh/following{/other_user}","gists_url":"https://api.github.com/users/azizkh/gists{/gist_id}","starred_url":"https://api.github.com/users/azizkh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/azizkh/subscriptions","organizations_url":"https://api.github.com/users/azizkh/orgs","repos_url":"https://api.github.com/users/azizkh/repos","events_url":"https://api.github.com/users/azizkh/events{/privacy}","received_events_url":"https://api.github.com/users/azizkh/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/yiisoft/yii2/issues/comments/25359917","html_url":"https://github.com/yiisoft/yii2/issues/928#issuecomment-25359917","issue_url":"https://api.github.com/repos/yiisoft/yii2/issues/928","id"