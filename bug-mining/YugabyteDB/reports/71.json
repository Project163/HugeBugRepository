v","followers_url":"https://api.github.com/users/spolitov/followers","following_url":"https://api.github.com/users/spolitov/following{/other_user}","gists_url":"https://api.github.com/users/spolitov/gists{/gist_id}","starred_url":"https://api.github.com/users/spolitov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/spolitov/subscriptions","organizations_url":"https://api.github.com/users/spolitov/orgs","repos_url":"https://api.github.com/users/spolitov/repos","events_url":"https://api.github.com/users/spolitov/events{/privacy}","received_events_url":"https://api.github.com/users/spolitov/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"spolitov","id":891914,"node_id":"MDQ6VXNlcjg5MTkxNA==","avatar_url":"https://avatars.githubusercontent.com/u/891914?v=4","gravatar_id":"","url":"https://api.github.com/users/spolitov","html_url":"https://github.com/spolitov","followers_url":"https://api.github.com/users/spolitov/followers","following_url":"https://api.github.com/users/spolitov/following{/other_user}","gists_url":"https://api.github.com/users/spolitov/gists{/gist_id}","starred_url":"https://api.github.com/users/spolitov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/spolitov/subscriptions","organizations_url":"https://api.github.com/users/spolitov/orgs","repos_url":"https://api.github.com/users/spolitov/repos","events_url":"https://api.github.com/users/spolitov/events{/privacy}","received_events_url":"https://api.github.com/users/spolitov/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2018-11-23T16:16:23Z","updated_at":"2018-11-26T13:29:59Z","closed_at":"2018-11-26T13:29:59Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Most of operations could be done only on leader side.\r\nWe have several kinds of checks for leadership, that takes place in different places.\r\n\r\nThe following issues present:\r\n\r\n1. We don't check for leadership during write, the check is done only when operation is added to the raft queue.\r\nSo during read-write operation it is possible that read is done while server is not leader, and then it obtains leadership and pushes wrong data to the raft.\r\n\r\n2. Transaction related operations check for leadership, but in rare cases it is possible that node is leader when operation is started,\r\nthen it looses leadership, and receives it back when operation is added to the raft queue.\r\n","closed_by":{"login":"spolitov","id":891914,"node_id":"MDQ6VXNlcjg5MTkxNA==","avatar_url":"https://avatars.githubusercontent.com/u/891914?v=4","gravatar_id":"","url":"https://api.github.com/users/spolitov","html_url":"https://github.com/spolitov","followers_url":"https://api.github.com/users/spolitov/followers","following_url":"https://api.github.com/users/spolitov/following{/other_user}","gists_url":"https://api.github.com/users/spolitov/gists{/gist_id}","starred_url":"https://api.github.com/users/spolitov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/spolitov/subscriptions","organizations_url":"https://api.github.com/users/spolitov/orgs","repos_url":"https://api.github.com/users/spolitov/repos","events_url":"https://api.github.com/users/spolitov/events{/privacy}","received_events_url":"https://api.github.com/users/spolitov/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/603/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/603/timeline","performed_via_github_app":null,"state_reason":"compl