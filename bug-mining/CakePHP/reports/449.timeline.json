know how to properly do PRs. Can you use a diff until I have time to wrap my head around how to do it properly?\n\n``` php\ndiff --git a/Vendor/cakephp/cakephp/lib/Cake/Cache/Engine/ApcEngine.php b/Vendor/cakephp/cakephp/lib/Cake/Cache/Engine/ApcEngine.php\nindex a06fbd3..0e8d124 100644\n--- a/Vendor/cakephp/cakephp/lib/Cake/Cache/Engine/ApcEngine.php\n+++ b/Vendor/cakephp/cakephp/lib/Cake/Cache/Engine/ApcEngine.php\n@@ -126,11 +126,10 @@ class ApcEngine extends CacheEngine {\n                        return true;\n                }\n                $info = apc_cache_info('user');\n-               $cacheKeys = $info['cache_list'];\n-               unset($info);\n-               foreach ($cacheKeys as $key) {\n-                       if (strpos($key['info'], $this->settings['prefix']) === 0) {\n-                               apc_delete($key['info']);\n+               foreach ($info['cache_list'] as $entry) {\n+                       $key = isset($entry['info']) ? $entry['info'] : $entry['key'];\n+                       if (strpos($key, $this->settings['prefix']) === 0) {\n+                               apc_delete($key);\n                        }\n                }\n                return true;\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/46561109/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"biesbjerg","id":230182,"node_id":"MDQ6VXNlcjIzMDE4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/230182?v=4","gravatar_id":"","url":"https://api.github.com/users/biesbjerg","html_url":"https://github.com/biesbjerg","followers_url":"https://api.github.com/users/biesbjerg/followers","following_url":"https://api.github.com/users/biesbjerg/following{/other_user}","gists_url":"https://api.github.com/users/biesbjerg/gists{/gist_id}","starred_url":"https://api.github.com/us