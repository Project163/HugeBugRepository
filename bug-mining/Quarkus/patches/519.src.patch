+package io.quarkus.it.main;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+
+import java.util.Arrays;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.TestFactory;
+
+import io.quarkus.it.arc.UnusedBean;
+import io.quarkus.test.junit.QuarkusDynamicTest;
+import io.quarkus.test.junit.QuarkusTest;
+
+@QuarkusTest
+public class DynamicTestsTestCase {
+
+    @Inject
+    UnusedBean bean;
+
+    @Test
+    public void testInjection() {
+        assertNotNull(bean);
+    }
+
+    @TestFactory
+    public List<?> dynamicTests() {
+        return Arrays.asList(
+                QuarkusDynamicTest.dynamicTest("test 1", () -> {
+                    assertNotNull(bean);
+                }),
+                QuarkusDynamicTest.dynamicTest("test 2", () -> {
+                    assertEquals(1, 1);
+                }));
+    }
+}
diff --git a/test-framework/junit5/src/main/java/io/quarkus/test/junit/QuarkusDynamicTest.java b/test-framework/junit5/src/main/java/io/quarkus/test/junit/QuarkusDynamicTest.java
