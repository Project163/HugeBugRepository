+     */
+    withScaleColumnTypes: ColumnType[] = [
+        "decimal",
+        "dec",
+        "numeric",
+        "fixed",
+        "float",
+        "double",
+        "double precision",
+        "real",
+    ]
+
+    /**
+     * Gets list of column data types that supports UNSIGNED and ZEROFILL attributes.
+     */
+    unsignedAndZerofillTypes: ColumnType[] = [
+        "int",
+        "integer",
+        "smallint",
+        "tinyint",
+        "mediumint",
