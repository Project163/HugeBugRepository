db/milestones/3","html_url":"https://github.com/yugabyte/yugabyte-db/milestone/3","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones/3/labels","id":4242639,"node_id":"MDk6TWlsZXN0b25lNDI0MjYzOQ==","number":3,"title":"v2.0","description":"YB 2.0 release","creator":{"login":"ndeodhar","id":15746068,"node_id":"MDQ6VXNlcjE1NzQ2MDY4","avatar_url":"https://avatars.githubusercontent.com/u/15746068?v=4","gravatar_id":"","url":"https://api.github.com/users/ndeodhar","html_url":"https://github.com/ndeodhar","followers_url":"https://api.github.com/users/ndeodhar/followers","following_url":"https://api.github.com/users/ndeodhar/following{/other_user}","gists_url":"https://api.github.com/users/ndeodhar/gists{/gist_id}","starred_url":"https://api.github.com/users/ndeodhar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ndeodhar/subscriptions","organizations_url":"https://api.github.com/users/ndeodhar/orgs","repos_url":"https://api.github.com/users/ndeodhar/repos","events_url":"https://api.github.com/users/ndeodhar/events{/privacy}","received_events_url":"https://api.github.com/users/ndeodhar/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":100,"state":"closed","created_at":"2019-04-18T21:03:32Z","updated_at":"2020-06-23T19:02:00Z","due_on":null,"closed_at":"2020-06-23T19:02:00Z"},"comments":0,"created_at":"2019-07-17T22:04:38Z","updated_at":"2019-07-30T19:14:38Z","closed_at":"2019-07-30T19:14:38Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"To reproduce:\r\n1. Create database exercises.\r\n\r\n2. Create DDLs and load data using these:\r\n[clubdata_ddl.sql](https://raw.githubusercontent.com/YugaByte/yugabyte-db/master/sample/clubdata_ddl.sql) which creates tables and other database objects\r\n[clubdata_data.sql](https://raw.githubusercontent.com/YugaByte/yugabyte-db/master/sample/clubdata_data.sql) which loads the sample data into the exercises database\r\n\r\n3. Now that you have the database and data, run this (from https://pgexercises.com/questions/joins/simplejoin2.html)\r\n\r\n```\r\nselect bks.starttime as start, facs.name as name\r\n\tfrom \r\n\t\tcd.facilities facs\r\n\t\tinner join cd.bookings bks\r\n\t\t\ton facs.facid = bks.facid\r\n\twhere \r\n\t\tfacs.facid in (0,1) and\r\n\t\tbks.starttime >= '2012-09-21' and\r\n\t\tbks.starttime < '2012-09-22'\r\norder by bks.starttime;   \r\n```\r\nThis will return no rows.\r\nHowever, if we change IN clause to equality, the query works.\r\n\r\n```\r\nselect bks.starttime as start, facs.name as name from cd.facilities facs inner join cd.bookings bks on facs.facid = bks.facid where (facs.facid=0 or facs.facid=1) and bks.starttime >= '2012-09-21' and bks.starttime < '2012-09-22'\r\n        start        |      name      \r\n---------------------+----------------\r\n 2012-09-21 08:00:00 | Tennis Court 1\r\n 2012-09-21 08:00:00 | Tennis Court 2\r\n 2012-09-21 09:30:00 | Tennis Court 1\r\n 2012-09-21 10:00:00 | Tennis Court 2\r\n 2012-09-21 11:30:00 | Tennis Court 2\r\n 2012-09-21 12:00:00 | Tennis Court 1\r\n 2012-09-21 13:30:00 | Tennis Court 1\r\n 2012-09-21 14:00:00 | Tennis Court 2\r\n 2012-09-21 15:30:00 | Tennis Court 1\r\n 2012-09-21 16:00:00 | Tennis Court 2\r\n 2012-09-21 17:00:00 | Tennis Court 1\r\n 2012-09-21 18:00:00 | Tennis Court 2\r\n(12 rows)\r\n```\r\n","closed_by":{"login":"srhickma","id":23058032,"node_id":"MDQ6VXNlcjIzMDU4MDMy","avatar_url":"https://avatars.githubusercontent.com/u/23058032?v=4","gravatar_id":"","url":"https://api.github.com/users/srhickma","html_url":"https://github.com/srhickma","followers_url":"https://api.github.com/users/srhickma/followers","following_url":"https://api.github.com/users/srhickma/following{/other_user}","gists_url":"https://api.gith