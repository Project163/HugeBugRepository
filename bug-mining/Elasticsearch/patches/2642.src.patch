+                            .setNumericType("date_nanos")
+                    )
+                    .addSort(SortBuilders.fieldSort("other_field").order(SortOrder.ASC))
+                    .get();
+                assertHitsInOrder(searchResponse, new String[] { "3", "6", "1", "2", "4", "5" });
+
+                searchResponse = client().prepareSearch(index)
