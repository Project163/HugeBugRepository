diff --git a/test/unit/modules/util/invoke-with-error-handling.spec.js b/test/unit/modules/util/invoke-with-error-handling.spec.js
new file mode 100644
index 00000000..e1c95e02
--- /dev/null
+++ b/test/unit/modules/util/invoke-with-error-handling.spec.js
@@ -0,0 +1,23 @@
+import Vue from 'vue'
+import { invokeWithErrorHandling } from 'core/util/error'
+
+describe('invokeWithErrorHandling', () => {
+  if (typeof Promise !== 'undefined') {
+    it('should errorHandler call once when nested calls return rejected promise', done => {
+      let times = 0
+
+      Vue.config.errorHandler = function () {
+        times++
+      }
+
+      invokeWithErrorHandling(() => {
+        return invokeWithErrorHandling(() => {
+          return Promise.reject(new Error('fake error'))
+        })
+      }).then(() => {
+        expect(times).toBe(1)
+        done()
+      })
+    })
+  }
+})
