tname) in enumerate(characters): # 4\n    print(firstname)\n    print(lastname + nr) # 6\n\nnames = [nr + firstname for nr, (firstname, lastname) in enumerate(characters)] # 8\n```\n\nmypy output:\n\n```\nline 4: Incompatible types in assignment (expression has type \"str\", variable has type \"int\")\nline 6: Unsupported operand types for + (\"str\" and \"int\")\nline 8: Unsupported operand types for + (\"int\" and \"str\")\n```\n\nFixes #310.\n","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/479/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/mypy/issues/479/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":180647551,"node_id":"MDExOkNsb3NlZEV2ZW50MTgwNjQ3NTUx","url":"https://api.github.com/repos/python/mypy/issues/events/180647551","actor":{"login":"JukkaL","id":1107911,"node_id":"MDQ6VXNlcjExMDc5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/1107911?v=4","gravatar_id":"","url":"https://api.github.com/users/JukkaL","html_url":"https://github.com/JukkaL","followers_url":"https://api.github.com/users/JukkaL/followers","following_url":"https://api.github.com/users/JukkaL/following{/other_user}","gists_url":"https://api.github.com/users/JukkaL/gists{/gist_id}","starred_url":"https://api.github.com/users/JukkaL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JukkaL/subscriptions","organizations_url":"https://api.github.com/users/JukkaL/orgs","repos_url":"https://api.github.com/users/JukkaL/repos","events_url":"https://api.github.com/users/JukkaL/events{/privacy}","received_events_url":"https://api.github.com/users/JukkaL/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2014-10-20T06:28:44Z","state_reason":null,"performed_via_github_app":null}]