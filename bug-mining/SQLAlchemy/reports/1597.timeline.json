[{"id":21023796984,"node_id":"LE_lADOCX5JB87Y7qwIzwAAAATlHa74","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/21023796984","actor":{"login":"blazewicz","id":13185945,"node_id":"MDQ6VXNlcjEzMTg1OTQ1","avatar_url":"https://avatars.githubusercontent.com/u/13185945?v=4","gravatar_id":"","url":"https://api.github.com/users/blazewicz","html_url":"https://github.com/blazewicz","followers_url":"https://api.github.com/users/blazewicz/followers","following_url":"https://api.github.com/users/blazewicz/following{/other_user}","gists_url":"https://api.github.com/users/blazewicz/gists{/gist_id}","starred_url":"https://api.github.com/users/blazewicz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blazewicz/subscriptions","organizations_url":"https://api.github.com/users/blazewicz/orgs","repos_url":"https://api.github.com/users/blazewicz/repos","events_url":"https://api.github.com/users/blazewicz/events{/privacy}","received_events_url":"https://api.github.com/users/blazewicz/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2025-11-18T18:37:10Z","label":{"name":"requires triage","color":"ffff00"},"performed_via_github_app":null},{"id":21023954054,"node_id":"RTE_lADOCX5JB87Y7qwIzwAAAATlIBSG","url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/events/21023954054","actor":{"login":"blazewicz","id":13185945,"node_id":"MDQ6VXNlcjEzMTg1OTQ1","avatar_url":"https://avatars.githubusercontent.com/u/13185945?v=4","gravatar_id":"","url":"https://api.github.com/users/blazewicz","html_url":"https://github.com/blazewicz","followers_url":"https://api.github.com/users/blazewicz/followers","following_url":"https://api.github.com/users/blazewicz/following{/other_user}","gists_url":"https://api.github.com/users/blazewicz/gists{/gist_id}","starred_url":"https://api.github.com/users/blazewicz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blazewicz/subscriptions","organizations_url":"https://api.github.com/users/blazewicz/orgs","repos_url":"https://api.github.com/users/blazewicz/repos","events_url":"https://api.github.com/users/blazewicz/events{/privacy}","received_events_url":"https://api.github.com/users/blazewicz/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2025-11-18T18:46:37Z","rename":{"from":"`in_` on nested `CompoundSelect` raises NotImplementedError","to":"`in_` on nested `CompoundSelect` raises `NotImplementedError`"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/3549204222","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/12987#issuecomment-3549204222","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/12987","id":3549204222,"node_id":"IC_kwDOCX5JB87TjI7-","user":{"login":"blazewicz","id":13185945,"node_id":"MDQ6VXNlcjEzMTg1OTQ1","avatar_url":"https://avatars.githubusercontent.com/u/13185945?v=4","gravatar_id":"","url":"https://api.github.com/users/blazewicz","html_url":"https://github.com/blazewicz","followers_url":"https://api.github.com/users/blazewicz/followers","following_url":"https://api.github.com/users/blazewicz/following{/other_user}","gists_url":"https://api.github.com/users/blazewicz/gists{/gist_id}","starred_url":"https://api.github.com/users/blazewicz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blazewicz/subscriptions","organizations_url":"https://api.github.com/users/blazewicz/orgs","repos_url":"https://api.github.com/users/blazewicz/repos","events_url":"https://api.github.com/users/blazewicz/events{/privacy}","received_events_url":"https://api.github.com/users/blazewicz/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-18T19:18:44Z","updated_at":"2025-11-18T19:19:19Z","body":"A workaround I used in my application is to make a subquery from the outer `CoumpoundSelect` and wrap it in a `Select`.\n\n```python\nfrom sqlalchemy import column, intersect, select, table, union\n\nt = table(\"t\", column(\"c1\"), column(\"c2\"))\n\ndef main() -> None:\n    inner_compound_stmt = union(\n        select(t.c.c1).where(t.c.c2 == \"x\"),\n        select(t.c.c1).where(t.c.c2 == \"y\"),\n    )\n    simple_stmt = select(t.c.c1).where(t.c.c2 == \"z\")\n\n    outer_compound_stmt = intersect(inner_compound_stmt, simple_stmt)\n\n    subq = outer_compound_stmt.subquery()\n    stmt = select(t).where(t.c.c1.in_(select(subq)))\n    print(stmt)\n\nif __name__ == \"__main__\":\n    main()\n```\n\nThis produces working SQL, though with a bit of redundancy:\n\n```sql\nSELECT t.c1, t.c2 \nFROM t \nWHERE t.c1 IN (SELECT anon_1.c1 \nFROM ((SELECT t.c1 AS c1 \nFROM t \nWHERE t.c2 = :c2_1 UNION SELECT t.c1 AS c1 \nFROM t \nWHERE t.c2 = :c2_2) INTERSECT SELECT t.c1 AS c1 \nFROM t \nWHERE t.c2 = :c2_3) AS anon_1)\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/3549204222/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"blazewicz","id":13185945,"node_id":"MDQ6VXNlcjEzMTg1OTQ1","avatar_url":"https://avatars.githubusercontent.com/u/13185945?v=4","gravatar_id":"","url":"https://api.github.com/users/blazewicz","html_url":"https://github.com/blazewicz","followers_url":"https://api.github.com/users/blazewicz/followers","following_url":"https://api.github.com/users/blazewicz/following{/other_user}","gists_url":"https://api.github.com/users/blazewicz/gists{/gist_id}","starred_url":"https://api.github.com/users/blazewicz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blazewicz/subscriptions","organizations_url":"https://api.github.com/users/blazewicz/orgs","repos_url":"https