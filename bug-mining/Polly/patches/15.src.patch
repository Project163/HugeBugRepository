+            FailureRatio = 0.5,
+            MinimumThroughput = 10,
+            SamplingDuration = TimeSpan.FromSeconds(10),
+            BreakDuration = breakDuration,
+            ShouldHandle = args => new ValueTask<bool>(args.Outcome.Result is -1),
