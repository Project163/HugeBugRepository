4fcc","default":false,"description":"Yugabyte SQL (YSQL)"},{"id":1419821900,"node_id":"MDU6TGFiZWwxNDE5ODIxOTAw","url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels/priority/medium","name":"priority/medium","color":"ffdc5e","default":false,"description":"Medium priority issue"}],"state":"closed","locked":false,"assignee":null,"assignees":[],"milestone":null,"comments":1,"created_at":"2022-08-04T18:19:10Z","updated_at":"2024-06-29T06:06:24Z","closed_at":"2022-08-10T13:57:34Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Jira Link: [DB-3116](https://yugabyte.atlassian.net/browse/DB-3116)\r\n### Description\r\n\r\nIf you create a cluster on, say YB v2.6 via something like `./bin/yb-ctl create --disable_ysql` and run initdb manually [as per our v1.x docs](https://docs-archive.yugabyte.com/v1.3/deploy/manual-deployment/start-tservers/#initialize-ysql), you'll get working YSQL.\r\nBut after upgrading to 2.8+, YSQL upgrade won't actually work because it won't recognize initdb was done:\r\n```\r\n./bin/yb-admin upgrade_ysql\r\nUpgrade is not needed since YSQL is disabled\r\n```\r\n(this check was added in #11206)","closed_by":{"login":"frozenspider","id":2077017,"node_id":"MDQ6VXNlcjIwNzcwMTc=","avatar_url":"https://avatars.githubusercontent.com/u/2077017?v=4","gravatar_id":"","url":"https://api.github.com/users/frozenspider","html_url":"https://github.com/frozenspider","followers_url":"https://api.github.com/users/frozenspider/followers","following_url":"https://api.github.com/users/frozenspider/following{/other_user}","gists_url":"https://api.github.com/users/frozenspider/gists{/gist_id}","starred_url":"https://api.github.com/users/frozenspider/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/frozenspider/subscriptions","organizations_