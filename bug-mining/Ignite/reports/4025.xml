                            <comment id="16740179" author="vozerov" created="Fri, 11 Jan 2019 08:53:40 +0000"  >&lt;p&gt;&lt;a href=&quot;https://issues.apache.org/jira/secure/ViewProfile.jspa?name=tledkov-gridgain&quot; class=&quot;user-hover&quot; rel=&quot;tledkov-gridgain&quot;&gt;tledkov-gridgain&lt;/a&gt;, &lt;br/&gt;
