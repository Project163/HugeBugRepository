<item>
            <title>[IGNITE-336] We need to add dynamic turn on/off cache statistics for Visor.</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-336</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;We need create task to turn on/off of cache statistics collecting.&lt;br/&gt;
Create Visor command for toggling.&lt;/p&gt;</description>
                <environment></environment>
        <key id="12777435">IGNITE-336</key>
            <summary>We need to add dynamic turn on/off cache statistics for Visor.</summary>
                <type id="1" iconUrl="https://issues.apache.org/jira/secure/viewavatar?size=xsmall&amp;avatarId=21133&amp;avatarType=issuetype">Bug</type>
                                            <priority id="3" iconUrl="https://issues.apache.org/jira/images/icons/priorities/major.svg">Major</priority>
                        <status id="6" iconUrl="https://issues.apache.org/jira/images/icons/statuses/closed.png" description="The issue is considered finished, the resolution is correct. Issues which are not closed can be reopened.">Closed</status>
                    <statusCategory id="3" key="done" colorName="green"/>
                                    <resolution id="1">Fixed</resolution>
                                        <assignee username="pkonstantinov">Pavel Konstantinov</assignee>
                                    <reporter username="vsisko">Vasiliy Sisko</reporter>
