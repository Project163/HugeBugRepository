hub.com/users/caisq/following{/other_user}","gists_url":"https://api.github.com/users/caisq/gists{/gist_id}","starred_url":"https://api.github.com/users/caisq/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/caisq/subscriptions","organizations_url":"https://api.github.com/users/caisq/orgs","repos_url":"https://api.github.com/users/caisq/repos","events_url":"https://api.github.com/users/caisq/events{/privacy}","received_events_url":"https://api.github.com/users/caisq/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2017-03-17T21:33:20Z","label":{"name":"type:bug/performance","color":"fbca04"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/tensorflow/tensorflow/issues/comments/287884455","html_url":"https://github.com/tensorflow/tensorflow/issues/8507#issuecomment-287884455","issue_url":"https://api.github.com/repos/tensorflow/tensorflow/issues/8507","id":287884455,"node_id":"MDEyOklzc3VlQ29tbWVudDI4Nzg4NDQ1NQ==","user":{"login":"caisq","id":16824702,"node_id":"MDQ6VXNlcjE2ODI0NzAy","avatar_url":"https://avatars.githubusercontent.com/u/16824702?v=4","gravatar_id":"","url":"https://api.github.com/users/caisq","html_url":"https://github.com/caisq","followers_url":"https://api.github.com/users/caisq/followers","following_url":"https://api.github.com/users/caisq/following{/other_user}","gists_url":"https://api.github.com/users/caisq/gists{/gist_id}","starred_url":"https://api.github.com/users/caisq/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/caisq/subscriptions","organizations_url":"https://api.github.com/users/caisq/orgs","repos_url":"https://api.github.com/users/caisq/repos","events_url":"https://api.github.com/users/caisq/events{/privacy}","received_events_url":"https://api.github.com/users/caisq/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-03-20T20:17:39Z","updated_at":"2017-03-20T20:17:39Z","body":"Update: the underlying cause of this bug is that `LocalCLIDebugWrapper` attempts to intercept `OpError`s that happen during the underlying `tf.Session.run()` calls. It works if the `OpError` happens in the middle of a graph execution, which will generate the debug dump directory. But in this case, the `OpError` (due to invalid device name) happens before the graph execution even happens, so there is no debug dump directory and `LocalCLIDebugWrapper` generates an error message that masks the original exception. I will push a fix to this issue soon. ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/tensorflow/tensorflow/issues/comments/287884455/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"caisq","id":16824702,"node_id":"MDQ6VXNlcjE2ODI0NzAy","avatar_url":"https://avatars.githubusercontent.com/u/16824702?v=4","gravatar_id":"","url":"https://api.github.com/users/caisq","html_url":"https://github.com/caisq","followers_url":"https://api.github.com/users/caisq/followers","following_url":"https://api.github.com/users/caisq/following{/other_user}","gists_url":"https://api.github.com/users/caisq/gists{/gist_id}","starred_url":"https://api.github.com/users/caisq/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/caisq/subscriptions","organizations_url":"https://api.github.com/users/caisq/orgs","repos_url":"https://api.github.com/users/caisq/repos","events_url":"https://api.github.com/users/caisq/events{/privacy}","received_events_url":"https://api.github.com/users/caisq/received_events","type":"User","user_view_type":"public","site_admin":false}},{"actor":{"login":"ppwwyyxx","id":1381301,"node_id":"MDQ6VXNlcjEzODEzMDE=","avatar_url":"https://avatars.githubusercontent.com/u/1381301?v=4","gravatar_id":"","url":"https://api.githu