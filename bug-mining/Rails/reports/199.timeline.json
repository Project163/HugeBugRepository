in":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2019-12-19T18:21:34Z","label":{"name":"activejob","color":"5319e7"},"performed_via_github_app":null},{"id":2898201301,"node_id":"MDE1Ok1pbGVzdG9uZWRFdmVudDI4OTgyMDEzMDE=","url":"https://api.github.com/repos/rails/rails/issues/events/2898201301","actor":{"login":"eileencodes","id":1080678,"node_id":"MDQ6VXNlcjEwODA2Nzg=","avatar_url":"https://avatars.githubusercontent.com/u/1080678?v=4","gravatar_id":"","url":"https://api.github.com/users/eileencodes","html_url":"https://github.com/eileencodes","followers_url":"https://api.github.com/users/eileencodes/followers","following_url":"https://api.github.com/users/eileencodes/following{/other_user}","gists_url":"https://api.github.com/users/eileencodes/gists{/gist_id}","starred_url":"https://api.github.com/users/eileencodes/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eileencodes/subscriptions","organizations_url":"https://api.github.com/users/eileencodes/orgs","repos_url":"https://api.github.com/users/eileencodes/repos","events_url":"https://api.github.com/users/eileencodes/events{/privacy}","received_events_url":"https://api.github.com/users/eileencodes/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"milestoned","commit_id":null,"commit_url":null,"created_at":"2019-12-19T18:21:52Z","milestone":{"title":"6.1.0"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/rails/rails/issues/comments/568079792","html_url":"https://github.com/rails/rails/issues/38040#issuecomment-568079792","issue_url":"https://api.github.com/repos/rails/rails/issues/38040","id":568079792,"node_id":"MDEyOklzc3VlQ29tbWVudDU2ODA3OTc5Mg==","user":{"login":"cpruitt","id":16896,"node_id":"MDQ6VXNlcjE2ODk2","avatar_url":"https://avatars.githubusercontent.com/u/16896?v=4","gravatar_id":"","url":"https://api.github.com/users/cpruitt","html_url":"https://github.com/cpruitt","followers_url":"https://api.github.com/users/cpruitt/followers","following_url":"https://api.github.com/users/cpruitt/following{/other_user}","gists_url":"https://api.github.com/users/cpruitt/gists{/gist_id}","starred_url":"https://api.github.com/users/cpruitt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cpruitt/subscriptions","organizations_url":"https://api.github.com/users/cpruitt/orgs","repos_url":"https://api.github.com/users/cpruitt/repos","events_url":"https://api.github.com/users/cpruitt/events{/privacy}","received_events_url":"https://api.github.com/users/cpruitt/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-12-20T20:38:55Z","updated_at":"2019-12-20T20:38:55Z","body":"Some additional information and another related problem introduced by https://github.com/rails/rails/pull/37950. This line:\r\n\r\nhttps://github.com/rails/rails/commit/9eb4b4ed01f893c2fc7ff3ee4f99301dec7ea3c2#diff-141fdcf8e028bfeca079b4ebb5cb00a3R43\r\n\r\nalways returns `true` from the block instead of the result of `perform` as was previously returned. This results in `true` being the return value from `yield` in callbacks. The following works with Rails 6.0 but not with 6.1:\r\n\r\n```ruby\r\nclass StatsLoggedJob < ActiveJob::Base\r\n  around_perform :log_results\r\n  def log_results\r\n    result = yield\r\n    FakeStatsLogger.log_stats({ stats_entry: result })\r\n  end\r\n  # ... [snip]\r\nend\r\n```\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/rails/rails/issues/comments/568079792/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"cpruitt","id":16896,"node_id":"MDQ6VXNlcjE2ODk2","avatar_url":"https://avatars.githubusercontent.com/u/16896?v=4","gravatar_id":"","url":"https://api.github.com/users/cpruitt","html_url":"https://github.com/cpruitt","followers_url":"https://api.github.com/users/cpruitt/followers","following_url":"https://api.github.com/users/cpruitt/following{/other_user}","gists_url":"https://api.github.com/users/cpruitt/gists{/gist_id}","starred_url":"https://api.github.com/users/cpruitt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cpruitt/subscriptions","organizations_url":"https://api.github.com/users/cpruitt/orgs","repos_url":"https://api.github.com/users/cpruitt/repos","events_url":"https://api.github.com/users/cpruitt/events{/privacy}","received_events_url":"https://api.github.com/users/cpruitt/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/rails/rails/issues/comments/568080204","html_url":"https://github.com/rails/rails/issues/38040#issuecomment-568080204","issue_url":"https://api.github.com/repos/rails/rails/issues/38040","id":568080204,"node_id":"MDEyOklzc3VlQ29tbWVudDU2ODA4MDIwNA==","user":{"login":"cpruitt","id":16896,"node_id":"MDQ6VXNlcjE2ODk2","avatar_url":"https://avatars.githubusercontent.com/u/16896?v=4","gravatar_id":"","url":"https://api.github.com/users/cpruitt","html_url":"https://github.com/cpruitt","followers_url":"https://api.github.com/users/cpruitt/followers","following_url":"https://api.github.com/users/cpruitt/following{/other_user}","gists_url":"https://api.github.com/users/cpruitt/gists{/gist_id}","starred_url":"https://api.github.com/users/cpruitt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cpruitt/subscriptions","organizations_url":"https://api.github.com/users/cpruitt/orgs","repos_url":"https://api.github.com/users/cpruitt/repos","events_url":"https://api.github.com/users/cpruitt/events{/privacy}","received_events_url":"https://api.github.com/users/cpruitt/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-12-20T20:40:38Z","updated_at":"2019-12-20T20:40:54Z","body":"Here is an updated version of the above reproduction script which shows both of the described issues:\r\n\r\n`$ ruby activejob_returnval.rb && RAILS_MASTER=1 ruby activejob_returnval.rb`\r\n\r\n**activejob_returnval.rb**\r\n\r\n```ruby\r\n# frozen_string_literal: true\r\n\r\nrequire \"bundler/inline\"\r\n\r\ngemfile(false) do\r\n  source \"https://rubygems.org\"\r\n\r\n  git_source(:github) { |repo| \"https://github.com/#{repo}.git\" }\r\n\r\n  if ENV['RAILS_MASTER'] == \"1\"\r\n    gem \"rails\", github: \"rails/rails\"\r\n  else\r\n    gem \"rails\", \"6.0.0\"\r\n  end\r\nend\r\n\r\nrequire \"active_job\"\r\nrequire \"minitest/autorun\"\r\n\r\nclass User\r\n  attr_accessor :id\r\n  def initialize(id)\r\n    @id = id\r\n  end\r\n\r\n  def self.all\r\n    (1..10).collect {|i| User.new(i)}\r\n  end\r\n\r\n  def has_warning?\r\n    self.id.even?\r\n  end\r\n\r\n  def send_warning\r\n    # Send a notification\r\n  end\r\nend\r\n\r\nclass FakeStatsLogger\r\n  cattr_accessor :logs\r\n  def self.log_stats(value)\r\n    self.logs ||= []\r\n    self.logs << value\r\n  end\r\nend\r\n\r\nclass BuggyJob < ActiveJob::Base\r\n  around_perform :log_results\r\n\r\n  def log_results\r\n    result = yield\r\n    FakeStatsLogger.log_stats({ stats_entry: result })\r\n  end\r\n\r\n  def perform\r\n    user_ids_with_warnings = []\r\n    User.all.each do |user|\r\n      if user.has_warning?\r\n        user.send_warning\r\n        user_ids_with_warnings << user.id\r\n      end\r\n    end\r\n    user_ids_with_warnings\r\n  end\r\nend\r\n\r\nclass BuggyJobTest < ActiveJob::TestCase\r\n  def test_return_value_returns_perform_result\r\n    result = BuggyJob.perform_now\r\n    assert_equal [2,4,6,8,10], result\r\n  end\r\n\r\n  def test_around_perform_yield_returns_perform_result\r\n    result = BuggyJob.perform_now\r\n    assert_equal ({ stats_entry: [2,4,6,8,10] }), FakeStatsLogger.logs.last\r\n  end\r\nend\r\n```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/rails/rails/issues/comments/568080204/r