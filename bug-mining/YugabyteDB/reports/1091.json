ithub.com/users/d-uspenskiy/gists{/gist_id}","starred_url":"https://api.github.com/users/d-uspenskiy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/d-uspenskiy/subscriptions","organizations_url":"https://api.github.com/users/d-uspenskiy/orgs","repos_url":"https://api.github.com/users/d-uspenskiy/repos","events_url":"https://api.github.com/users/d-uspenskiy/events{/privacy}","received_events_url":"https://api.github.com/users/d-uspenskiy/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2024-01-18T11:52:49Z","updated_at":"2024-02-03T11:42:58Z","closed_at":"2024-02-03T11:42:58Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Jira Link: [DB-9683](https://yugabyte.atlassian.net/browse/DB-9683)\r\n### Description\r\n\r\nThe `FetchRow/FetchRows/GetValue` template function in `libpq_utils` file doesn't check actual column type. Only value size is checked. As a result it is possible for example to fetch int column as string. No issue will raised in this case but return value will contain unusable data (in-memory representation of int interpreted as a string).\r\n\r\n```\r\nauto conn = ASSERT_RESULT(Connect());\r\nASSERT_OK(conn.Execute(\"CREATE TABLE t(k INT PRIMARY KEY, v INT, s TEXT)\"));\r\nASSERT_OK(conn.Execute(\"INSERT INTO t VALUES(1, NULL, 'one'), (2, NULL, 'two')\"));\r\nauto rows = ASSERT_RESULT((conn.FetchRows<int32_t, std::optional<std::string>, std::string>(\"SELECT * FROM t\")));\r\n```\r\n\r\nLast statement should fail at runtime because it tires to read second column (`v`) as `std::string` while its actual type is `int`.\r\n\r\n### Issue Type\r\n\r\nkind/bug\r\n\r\n### Warning: Please confirm that this issue does not contain any sensitive information\r\n\r\n- [X] I confirm this issue does not contain any sensitive information.\r\n\r\n[DB-9683]: https://yugabyte.atlassian.net/browse/DB-9683?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","closed_by":{"login":"d-uspenskiy","id":47734295,"node_id":"MDQ6VXNlcjQ3NzM0Mjk1","avatar_url":"https://avatars.githubusercontent.com/u/47734295?v=4","gravatar_id":"","url":"https://api.github.com/users/d-uspenskiy","html_url":"https://github.com/d-uspenskiy","followers_url":"https://api.github.com/users/d-uspenskiy/followers","following_url":"https://api.github.com/users/d-uspenskiy/following{/other_user}","gists_url":"https://api.github.com/users/d-uspenskiy/gists{/gist_id}","starred_url":"https://api.github.com/users/d-uspenskiy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/d-uspenskiy/subscriptions","organizations_url":"https://api.github.com/users/d-uspenskiy/orgs","repos_url":"https://api.github.com/users/d-uspenskiy/repos","events_url":"https://api.github.com/users/d-uspenskiy/events{/privacy}","received_events_url":"https://api.github.com/users/d-uspenskiy/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/20683/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/20683/timeline","performed_via_github_app":null,"state_reason":"completed"}