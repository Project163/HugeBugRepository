scribers","subscription_url":"https://api.github.com/repos/yugabyte/yugabyte-db/subscription","commits_url":"https://api.github.com/repos/yugabyte/yugabyte-db/commits{/sha}","git_commits_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/commits{/sha}","comments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/comments{/number}","issue_comment_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments{/number}","contents_url":"https://api.github.com/repos/yugabyte/yugabyte-db/contents/{+path}","compare_url":"https://api.github.com/repos/yugabyte/yugabyte-db/compare/{base}...{head}","merges_url":"https://api.github.com/repos/yugabyte/yugabyte-db/merges","archive_url":"https://api.github.com/repos/yugabyte/yugabyte-db/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/yugabyte/yugabyte-db/downloads","issues_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues{/number}","pulls_url":"https://api.github.com/repos/yugabyte/yugabyte-db/pulls{/number}","milestones_url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones{/number}","notifications_url":"https://api.github.com/repos/yugabyte/yugabyte-db/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels{/name}","releases_url":"https://api.github.com/repos/yugabyte/yugabyte-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"[This is on 1.2.4]\r\n\r\nIrrespective of the size of table, a simple `SELECT * FROM table LIMIT 1;` should return very quickly but that's not the case. On a 50K row table, this is taking about 2-3seconds instead of 1ms or less.\r\n\r\nI think we are doing a full-scan even for a LIMIT 1 query; seems like we are not pushing down the LIMIT 1 predicate to DocDB.\r\n\r\n```\r\n\\timing on\r\n\r\nDROP  TABLE sales_records;\r\n\r\nCREATE TABLE sales_records\r\n(\r\n  region         text,\r\n  country        text,\r\n  item_type      text,\r\n  sales_channel  text,\r\n  order_priority text,\r\n  order_date     date,\r\n  order_id       int PRIMARY KEY,\r\n  ship_data      date,\r\n  units_sold     int,\r\n  unit_price     real,\r\n  unit_cost      real,\r\n  total_revenue  real,\r\n  total_cost     real,\r\n  total_profit   real\r\n);\r\n\r\n-- load 50K rows\r\nCOPY sales_records FROM  '/home/centos/notes/SalesRecords.csv' WITH (FORMAT CSV, HEADER);\r\n\r\n-- these queries are super slow; take about 2-3seconds; should take 1ms or so.\r\nselect * from sales_records limit 1;\r\nselect * from sales_records limit 1;\r\nselect * from sales_records limit 1;\r\n\r\n-- these run 1ms or less\r\nselect * from sales_records where order_id = 447897851;\r\nselect * from sales_records where order_id = 447897851;\r\nselect * from sales_records where order_id = 447897851;\r\n\r\n\\timing off\r\n```\r\n\r\nRelevant output:\r\n\r\n```\r\npostgres# select * from sales_records limit 1;\r\n        region         | country  | item_type  | sales_channel | order_priority | order_date | order_id  | ship_data  | units_sold | unit_price | unit_cost | total_revenue | total_cost | total_profit\r\n-----------------------+----------+------------+---------------+----------------+------------+-----------+------------+------------+------------+-----------+---------------+------------+--------------\r\n Australia and Oceania | Kiribati | Vegetables | Online        | H              | 2015-07-08 | 954815614 | 2015-08-09 |         13 |     154.06 |     90.93 |       2002.78 |    1182.09 |       820.69\r\n(1 row)\r\n\r\nTime: 2810.465 ms (00:02.810)\r\n```\r\n\r\nand\r\n\r\n```\r\npostgres# select * from sales_records where order_id = 447897851;\r\n              region               | country | item_type | sales_channel | order_priority | order_date | order_id  | ship_data  | units_sold | unit_price | unit_cost | total_revenue | total_cost | total_profit\r\n-----------------------------------+---------+-----------+---------------+----------------+------------+-----------+------------+------------+------------+-----------+---------------+------------+--------------\r\n Central America and the Caribbean | Panama  | Baby Food | Online        | L              | 2016-12-20 | 447897851 | 2017-01-03 |       1782 |     255.28 |    159.42 |        454909 |     284086 |       170823\r\n(1 row)\r\n\r\nTime: 0.623 ms\r\n```\r\n","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/1204/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/1204/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"actor":{"login":"kmuthukk","id":136