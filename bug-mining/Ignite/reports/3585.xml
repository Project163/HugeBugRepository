&lt;span class=&quot;code-quote&quot;&gt;&quot;test-lock-thread-4&quot;&lt;/span&gt; #136488 prio=5 os_prio=0 tid=0x00007f208802a000 nid=0x36a5 waiting on condition [0x00007f1ea81c3000]
