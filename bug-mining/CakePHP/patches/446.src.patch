+/**
+ * Initialize hook.
+ *
+ * Populates the connection property, which is useful for tasks of tasks.
+ *
+ * @return void
+ */
+	public function initialize() {
+		if (empty($this->connection) && !empty($this->params['connection'])) {
+			$this->connection = $this->params['connection'];
+		}
+	}
