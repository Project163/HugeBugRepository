s_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy2-stubs/git/commits{/sha}","comments_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy2-stubs/comments{/number}","issue_comment_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy2-stubs/issues/comments{/number}","contents_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy2-stubs/contents/{+path}","compare_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy2-stubs/compare/{base}...{head}","merges_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy2-stubs/merges","archive_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy2-stubs/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy2-stubs/downloads","issues_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy2-stubs/issues{/number}","pulls_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy2-stubs/pulls{/number}","milestones_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy2-stubs/milestones{/number}","notifications_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy2-stubs/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy2-stubs/labels{/name}","releases_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy2-stubs/releases{/id}","deployments_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy2-stubs/deployments","created_at":"2021-02-19T19:42:25Z","updated_at":"2025-08-11T06:26:32Z","pushed_at":"2023-12-30T12:15:22Z","git_url":"git://github.com/sqlalchemy/sqlalchemy2-stubs.git","ssh_url":"git@github.com:sqlalchemy/sqlalchemy2-stubs.git","clone_url":"https://github.com/sqlalchemy/sqlalchemy2-stubs.git","svn_url":"https://github.com/sqlalchemy/sqlalchemy2-stubs","homepage":"","size":469,"stargazers_count":157,"watchers_count":157,"language":"Python","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":42,"mirror_url":null,"archive