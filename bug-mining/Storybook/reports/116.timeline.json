 add more cases to that logic or somehow generalize the preview handling to make it simpler for apps to provide their own tweaks.\r\n","reactions":{"url":"https://api.github.com/repos/storybookjs/storybook/issues/13979/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/storybookjs/storybook/issues/13979/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":4355626586,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDQzNTU2MjY1ODY=","url":"https://api.github.com/repos/storybookjs/storybook/issues/events/4355626586","actor":{"login":"jonspalmer","id":328224,"node_id":"MDQ6VXNlcjMyODIyNA==","avatar_url":"https://avatars.githubusercontent.com/u/328224?v=4","gravatar_id":"","url":"https://api.github.com/users/jonspalmer","html_url":"https://github.com/jonspalmer","followers_url":"https://api.github.com/users/jonspalmer/followers","following_url":"https://api.github.com/users/jonspalmer/following{/other_user}","gists_url":"https://api.github.com/users/jonspalmer/gists{/gist_id}","starred_url":"https://api.github.com/users/jonspalmer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jonspalmer/subscriptions","organizations_url":"https://api.github.com/users/jonspalmer/orgs","repos_url":"https://api.github.com/users/jonspalmer/repos","events_url":"https://api.github.com/users/jonspalmer/events{/privacy}","received_events_url":"https://api.github.com/users/jonspalmer/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"7cf5c72589774e5b105de4502aba303fb3ad7ff3","commit_url":"https://api.github.com/repos/jonspalmer/storybook/commits/7cf5c72589774e5b105de4502aba303fb3ad7ff3","created_at":"2021-02-20T19:34:07Z","performed_via_github_app":null},{"id":4538229922,"node_id":"MDE3OkRlbWlsZXN0b25lZEV2ZW50NDUzODIyOTkyMg==","url":"https://api.github.com/repos/storybookjs/storyb