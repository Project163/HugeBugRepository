s from the snapshot, restore also needs to know about this old_table_id -> new_table_id mapping to merge the relevant packings of a table. We need to have a way for the restore script to somehow pass this information down to the tservers so that they are able to use it at the time of restore.","closed_by":{"login":"druzac","id":865068,"node_id":"MDQ6VXNlcjg2NTA2OA==","avatar_url":"https://avatars.githubusercontent.com/u/865068?v=4","gravatar_id":"","url":"https://api.github.com/users/druzac","html_url":"https://github.com/druzac","followers_url":"https://api.github.com/users/druzac/followers","following_url":"https://api.github.com/users/druzac/following{/other_user}","gists_url":"https://api.github.com/users/druzac/gists{/gist_id}","starred_url":"https://api.github.com/users/druzac/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/druzac/subscriptions","organizations_url":"https://api.github.com/users/druzac/orgs","repos_url":"https://api.github.com/users/druzac/repos","events_url":"https://api.github.com/users/druzac/events{/privacy}","received_events_url":"https://api.github.com/users/druzac/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/14861/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/14861/timeline","performed_via_github_app":null,"state_reason":"completed"}