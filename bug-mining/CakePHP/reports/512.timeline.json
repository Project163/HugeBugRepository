hub.com/users/markstory/orgs","repos_url":"https://api.github.com/users/markstory/repos","events_url":"https://api.github.com/users/markstory/events{/privacy}","received_events_url":"https://api.github.com/users/markstory/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2014-08-07T17:02:10Z","label":{"name":"On hold","color":"eb6420"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/51580993","html_url":"https://github.com/cakephp/cakephp/issues/4189#issuecomment-51580993","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/4189","id":51580993,"node_id":"MDEyOklzc3VlQ29tbWVudDUxNTgwOTkz","user":{"login":"stevetauber","id":1258342,"node_id":"MDQ6VXNlcjEyNTgzNDI=","avatar_url":"https://avatars.githubusercontent.com/u/1258342?v=4","gravatar_id":"","url":"https://api.github.com/users/stevetauber","html_url":"https://github.com/stevetauber","followers_url":"https://api.github.com/users/stevetauber/followers","following_url":"https://api.github.com/users/stevetauber/following{/other_user}","gists_url":"https://api.github.com/users/stevetauber/gists{/gist_id}","starred_url":"https://api.github.com/users/stevetauber/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stevetauber/subscriptions","organizations_url":"https://api.github.com/users/stevetauber/orgs","repos_url":"https://api.github.com/users/stevetauber/repos","events_url":"https://api.github.com/users/stevetauber/events{/privacy}","received_events_url":"https://api.github.com/users/stevetauber/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-08-08T09:29:54Z","updated_at":"2014-08-08T09:29:54Z","body":"I guess what I'm saying is this logic makes sense to:\n\nA) Require all 4 parameters. Throw exception (??) if one is missing\nor\nB) Try to handle cases where a parameter is missing correctly. For instance, maybe the default settings should be\n\n```\narray(\n    'type' => 'CROSS',\n    'alias' => null,\n    'table' => 'join_table',\n    'conditions' => array()\n)\n```\n\nand then modify [this check](https://github.com/cakephp/cakephp/blob/master/lib/Cake/Model/Datasource/DboSource.php#L1922):\n\n```\nif (strtoupper($data['type']) === 'CROSS') {\n    return \"{$data['type']} JOIN {$data['table']} {$data['alias']}\";\n}\n```\n\nto \n\n```\nif (strtoupper($data['type']) === 'CROSS' || empty($data['conditions']) {\n    return \"{$data['type']} JOIN {$data['table']} {$data['alias']}\";\n}\n```\n\nIt just seems kind of odd that there isn't better checking here.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/51580993/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"stevetauber","id":1258342,"node_id":"MDQ6VXNlcjEyNTgzNDI=","avatar_url":"https://avatars.githubusercontent.com/u/1258342?v=4","gravatar_id":"","url":"https://api.github.com/users/stevetauber","html_url":"https://github.com/stevetauber","followers_url":"https://api.github.com/users/stevetauber/followers","following_url":"https://api.github.com/users/stevetauber/following{/other_user}","gists_url":"https://api.github.com/users/stevetauber/gists{/gist_id}","starred_url":"https://api.github.com/users/stevetauber/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stevetauber/subscriptions","organizations_url":"https://api.github.com/users/stevetauber/orgs","repos_url":"https://api.github.com/users/stevetauber/repos","events_url":"https://api.github.com/users/stevetauber/events{/privacy}","received_events_url":"https://api.github.com/users/stevetauber/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/cakephp/cakephp/issu