+        
         /** */
         public static readonly string SourcesPath =
             Path.Combine(Impl.Common.IgniteHome.Resolve(), "modules", "platforms", "dotnet", "examples");
@@ -31,10 +35,33 @@ namespace Apache.Ignite.Core.Tests.Examples
         /** */
