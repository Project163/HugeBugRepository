e/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"There is some bad implicit typecasting going on with `FLAGS_ysql_prefetch_limit`, `exec_params_.limit_count`, `predicted_limit`, and `limit_count`.  The types currently are\r\n\r\n- `FLAGS_ysql_prefetch_limit`: int32\r\n- `exec_params_.limit_count`: uint64\r\n- `predicted_limit`: int\r\n- `limit_count`: int64\r\n\r\nI haven't found any user-facing issues, but this typecasting should be fixed regardless.  One idea is to make everything uint64 because negative limits don't make sense.\r\n\r\nSee also issues #9849 and #9859.","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/9860/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/9860/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":5249182089,"node_id":"REFE_lADOBlCVUc46gv7WzwAAAAE44CmJ","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/5249182089"