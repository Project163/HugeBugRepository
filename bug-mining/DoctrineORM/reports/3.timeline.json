[{"url":"https://api.github.com/repos/doctrine/orm/issues/comments/162358066","html_url":"https://github.com/doctrine/orm/issues/2276#issuecomment-162358066","issue_url":"https://api.github.com/repos/doctrine/orm/issues/2276","id":162358066,"node_id":"MDEyOklzc3VlQ29tbWVudDE2MjM1ODA2Ng==","user":{"login":"doctrinebot","id":2414358,"node_id":"MDQ6VXNlcjI0MTQzNTg=","avatar_url":"https://avatars.githubusercontent.com/u/2414358?v=4","gravatar_id":"","url":"https://api.github.com/users/doctrinebot","html_url":"https://github.com/doctrinebot","followers_url":"https://api.github.com/users/doctrinebot/followers","following_url":"https://api.github.com/users/doctrinebot/following{/other_user}","gists_url":"https://api.github.com/users/doctrinebot/gists{/gist_id}","starred_url":"https://api.github.com/users/doctrinebot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/doctrinebot/subscriptions","organizations_url":"https://api.github.com/users/doctrinebot/orgs","repos_url":"https://api.github.com/users/doctrinebot/repos","events_url":"https://api.github.com/users/doctrinebot/events{/privacy}","received_events_url":"https://api.github.com/users/doctrinebot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2012-02-10T20:31:21Z","updated_at":"2015-12-06T22:49:24Z","body":"Comment created by @beberlei:\n\nThe type can never be part of the primary key, how did you even map that? can you post details?\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/doctrine/orm/issues/comments/162358066/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"doctrinebot","id":2414358,"node_id":"MDQ6VXNlcjI0MTQzNTg=","avatar_url":"https://avatars.githubusercontent.com/u/2414358?v=4","gravatar_id":"","url":"https://api.github.com/users/doctrinebot","html_url":"https://github.com/doctrinebot","followers_url":"https://api.github.com/users/doctrinebot/followers","following_url":"https://api.github.com/users/doctrinebot/following{/other_user}","gists_url":"https://api.github.com/users/doctrinebot/gists{/gist_id}","starred_url":"https://api.github.com/users/doctrinebot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/doctrinebot/subscriptions","organizations_url":"https://api.github.com/users/doctrinebot/orgs","repos_url":"https://api.github.com/users/doctrinebot/repos","events_url":"https://api.github.com/users/doctrinebot/events{/privacy}","received_events_url":"https://api.github.com/users/doctrinebot/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/doctrine/orm/issues/comments/162358067","html_url":"https://github.com/doctrine/orm/issues/2276#issuecomment-162358067","issue_url":"https://api.github.com/repos/doctrine/orm/issues/2276","id":162358067,"node_id":"MDEyOklzc3VlQ29tbWVudDE2MjM1ODA2Nw==","user":{"login":"doctrinebot","id":2414358,"node_id":"MDQ6VXNlcjI0MTQzNTg=","avatar_url":"https://avatars.githubusercontent.com/u/2414358?v=4","gravatar_id":"","url":"https://api.github.com/users/doctrinebot","html_url":"https://github.com/doctrinebot","followers_url":"https://api.github.com/users/doctrinebot/followers","following_url":"https://api.github.com/users/doctrinebot/following{/other_user}","gists_url":"https://api.github.com/users/doctrinebot/gists{/gist_id}","starred_url":"https://api.github.com/users/doctrinebot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/doctrinebot/subscriptions","organizations_url":"https://api.github.com/users/doctrinebot/orgs","repos_url":"https://api.github.com/users/doctrinebot/repos","events_url":"https://api.github.com/users/doctrinebot/events{/privacy}","received_events_url":"https://api.github.com/users/doctrinebot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2012-02-14T05:37:19Z","updated_at":"2015-12-06T22:49:24Z","body":"Comment created by h-andreas:\n\nI did not specified type as being part of the primary key ... for obvious reasons. I didnt even thought of it being necessary as this is the only time we are using single table inheritance.\n\nThis is an abstracted version of our domain model:\n\n```\nCREATE TABLE `users` (\n    `id` MEDIUMINT(8) UNSIGNED NOT NULL AUTO_INCREMENT,\n    `mail` VARCHAR(255) NULL DEFAULT NULL,\n    `passwd` VARCHAR(255) NULL DEFAULT NULL,\n    PRIMARY KEY (`id`)\n) ENGINE=InnoDB;\n\nCREATE TABLE `tasks` (\n    `id` INT(10) UNSIGNED NOT NULL AUTO_INCREMENT,\n    `f_user` MEDIUMINT(8) UNSIGNED NULL DEFAULT NULL,\n    `priority` SMALLINT(5) UNSIGNED NOT NULL,\n    `some*other*column` VARCHAR(255) NULL DEFAULT NULL,\n    PRIMARY KEY (`id`),\n    CONSTRAINT `fk*tasks_user` FOREIGN KEY (`f*user`) REFERENCES `users` (`id`) ON UPDATE CASCADE ON DELETE SET NULL\n) ENGINE=InnoDB;\n\nCREATE TABLE `attributes` (\n    `key` VARCHAR(50) NOT NULL,\n    `name` VARCHAR(255) NOT NULL,\n    PRIMARY KEY (`key`)\n) ENGINE=InnoDB;\n\nCREATE TABLE `attributes_rel` (\n    `type` ENUM('task','user') NOT NULL,\n    `foreign_id` BIGINT(20) UNSIGNED NOT NULL,\n    `f_attribute` VARCHAR(50) NOT NULL,\n    `value_int` BIGINT(20) UNSIGNED NULL DEFAULT NULL,\n    `value_date` DATETIME NULL DEFAULT NULL,\n    `value_text` TEXT NULL,\n    PRIMARY KEY (`type`, `foreign*id`, `f*attribute`),\n    CONSTRAINT `fk*attributes_rel_attribute` FOREIGN KEY (`f*attribute`) REFERENCES `attributes` (`key`) ON UPDATE CASCADE ON DELETE CASCADE\n) ENGINE=InnoDB;\n\nINSERT INTO `attributes` (`key`, `name`) VALUES\n  ('description', 'description');\n\nINSERT INTO `users` (`id`, `mail`, `passwd`) VALUES\n  (1, 'abc@def.xyz', 'e10adc3949ba59abbe56e057f20f883e');\n\nINSERT INTO `tasks` (`id`, `f*user`, `priority`, `some_other*column`) VALUES\n  (1, 1, 1, 'nothing in here');\n\nINSERT INTO `attributes*rel` (`type`, `foreign_id`, `f_attribute`, `value_int`, `value_date`, `value*text`) VALUES\n  ('task', 1, 'description', NULL, NULL, 'catchy description for a task'),\n  ('user', 1, 'description', NULL, NULL, 'catchy description for a user');\n```\n\n```\n// definition wihin task model\n/****\n * @var \\Doctrine\\Common\\Collections\\ArrayCollection\n *\n * @OneToMany(targetEntity=\"TaskAttribute\", mappedBy=\"foreign\")\n * @JoinColumn(name=\"foreign\", referencedColumnName=\"id\")\n */\nprotected $attributes;\n\n// definition wihin user model\n/****\n * @var \\Doctrine\\Common\\Collections\\ArrayCollection\n *\n * @OneToMany(targetEntity=\"UserAttribute\", mappedBy=\"foreign\")\n * @JoinColumn(name=\"foreign\", referencedColumnName=\"id\")\n */\nprotected $attributes;\n```\n\nWhen calling `$em->find('Task', 1)->getAttributes()` and then doing `$em->find('User', 1)->getAttributes()` it gives me an instance of TaskAttribute for the user instead of a fresh UserAttribute.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/doctrine/orm/issues/comments/162358067/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"doctrinebot","id":2414358,"node_id":"MDQ6VXNlcjI0MTQzNTg=","avatar_url":"https://avatars.githubusercontent.com/u/2414358?v=4","gravatar_id":"","url":"https://api.github.com/users/doctrinebot","html_url":"https://github.com/doctrinebot","followers_url":"https://api.github.com/users/doctrinebot/followers","following_url":"https://api.github.com/users/doctrinebot/following{/other_user}","gists_url":"https://api.github.com/users/doctrinebot/gists{/gist_id}","starred_url":"https://api.github.com/users/doctrinebot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/doctrinebot/subscriptions","organizations_url":"https://api.github.com/users/doctrinebot/orgs","repos_url":"https://api.github.com/users/doctrinebot/repos","events_url":"https://api.github.com/users/doctrinebot/events{/privacy}","received_events_url":"https://api.github.com/users/doctrinebot/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/doctrine/orm/issues/comments/162358068","html_url":"https://github.com/doctrine/orm/issues/2276#issuecomment-162358068","issue_url":"https://api.github.com/repos/doctrine/orm/issues/2276","id":162358068,"node_id":"MDEyOklzc3VlQ29tbWVudDE2MjM1ODA2OA==","user":{"login":"doctrinebot","id":2414358,"node_id":"MDQ6VXNlcjI0MTQzNTg=","avatar_url":"https://avatars.githubusercontent.com/u/2414358?v=4","gravatar_id":"","url":"https://api.github.com/users/doctrinebot","html_url":"https://github.com/doctrinebot","followers_url":"https://api.github.com/users/doctrinebot/followers","following_url":"https://api.github.com/users/doctrinebot/following{/other_user}","gists_url":"https://api.github.com/users/doctrinebot/gists{/gist_id}","starred_url":"https://api.github.com/users/doctrinebot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/doctrinebot/subscriptions","organizations_url":"https://api.github.com/users/doctrinebot/orgs","repos_url":"https://api.github.com/users/doctrinebot/repos","events_url":"https://api.github.com/users/doctrinebot/events{/privacy}","received_events_url":"https://api.github.com/users/doctrinebot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2012-02-18T13:50:31Z","updated_at":"2015-12-06T22:49:24Z","body":"Comment created by @beberlei:\n\nTo have type part of the primary key you have to map it as field. Discrimnator columns can never be part of the PK for doctrine, even if they are in the database.\n\nYou can change your domain model to something like\n\n```\nclass Attribute\n{\n   /*** @Id @Column(type=\"integer\") **/\n   public $type;\n   /*** @Id @ManyToOne(target=\"Foreign\") **/\n   public $foreign;\n   /*** @id @Column(type=\"string\") **/\n   public $key;\n}\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/doctrine/orm/issues/comments/162358068/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"doctrinebot","id":2414358,"node_id":"MDQ6VXNlcjI0MTQzNTg=","avatar_url":"https://avatars.githubusercontent.com/u/2414358?v=4","gravatar_id":"","url":"https://api.github.com/users/doctrinebot","html_url":"https://github.com/doctrinebot","followers_url":"https://api.github.com/users/doctrinebot/followers","following_url":"https://api.github.com/users/doctrinebot/following{/other_user}","gists_url":"https://api.github.com/users/doctrinebot/gists{/gist_id}","starred_url":"https://api.github.com/users/doctrinebot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/doctrinebot/subscriptions","organizations_url":"https://api.github.com/users/doctrinebot/orgs","repos_url":"https://api.github.com/users/doctrinebot/repos","events_url":"https://api.github.com/users/doctrinebot/events{/privacy}","received_events_url":"https://api.github.com/users/doctrinebot/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/doctrine/orm/issues/comments/162358071","html_url":"https://github.com/doctrine/orm/issues/2276#issuecomment-162358071","issue_url":"https://api.github.com/repos/doctrine/orm/issues/2276","id":162358071,"node_id":"MDEyOklzc3VlQ29tbWVudDE2MjM1ODA3MQ==","user":{"login":"doctrinebot","id":2414358,"node_id":"MDQ6VXNlcjI0MTQzNTg=","avatar_url":"https://avatars.githubusercontent.com/u/2414358?v=4","gravatar_id":"","url":"https://api.github.com/users/doctrinebot","html_url":"https://github.com/doctrinebot","followers_url":"https://api.github.com/users/doctrinebot/followers","following_url":"https://api.github.com/users/doctrinebot/following{/other_user}","gists_url":"https://api.github.co