thub.com/users/alxhub/orgs","repos_url":"https://api.github.com/users/alxhub/repos","events_url":"https://api.github.com/users/alxhub/events{/privacy}","received_events_url":"https://api.github.com/users/alxhub/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2017-04-18T22:24:27Z","label":{"name":"severity2: inconvenient","color":"0052cc"},"performed_via_github_app":null},{"id":1047545858,"node_id":"MDEyOkxhYmVsZWRFdmVudDEwNDc1NDU4NTg=","url":"https://api.github.com/repos/angular/angular/issues/events/1047545858","actor":{"login":"alxhub","id":4175141,"node_id":"MDQ6VXNlcjQxNzUxNDE=","avatar_url":"https://avatars.githubusercontent.com/u/4175141?v=4","gravatar_id":"","url":"https://api.github.com/users/alxhub","html_url":"https://github.com/alxhub","followers_url":"https://api.github.com/users/alxhub/followers","following_url":"https://api.github.com/users/alxhub/following{/other_user}","gists_url":"https://api.github.com/users/alxhub/gists{/gist_id}","starred_url":"https://api.github.com/users/alxhub/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alxhub/subscriptions","organizations_url":"https://api.github.com/users/alxhub/orgs","repos_url":"https://api.github.com/users/alxhub/repos","events_url":"https://api.github.com/users/alxhub/events{/privacy}","received_events_url":"https://api.github.com/users/alxhub/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2017-04-18T22:24:27Z","label":{"name":"type: bug","color":"EEEEEE"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/angular/angular/issues/comments/298074743","html_url":"https://github.com/angular/angular/issues/15932#issuecomment-298074743","issue_url":"https://api.github.com/repos/angular/angular/issues/15932","id":298074743,"node_id":"MDEyOklzc3VlQ29tbWVudDI5ODA3NDc0Mw==","user":{"login":"alxhub","id":4175141,"node_id":"MDQ6VXNlcjQxNzUxNDE=","avatar_url":"https://avatars.githubusercontent.com/u/4175141?v=4","gravatar_id":"","url":"https://api.github.com/users/alxhub","html_url":"https://github.com/alxhub","followers_url":"https://api.github.com/users/alxhub/followers","following_url":"https://api.github.com/users/alxhub/following{/other_user}","gists_url":"https://api.github.com/users/alxhub/gists{/gist_id}","starred_url":"https://api.github.com/users/alxhub/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alxhub/subscriptions","organizations_url":"https://api.github.com/users/alxhub/orgs","repos_url":"https://api.github.com/users/alxhub/repos","events_url":"https://api.github.com/users/alxhub/events{/privacy}","received_events_url":"https://api.github.com/users/alxhub/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-04-28T18:36:46Z","updated_at":"2017-04-28T18:36:46Z","body":"So, Angular's behavior here is arguably broken.\r\n\r\nWe handle neither UTF-16 nor UTF-8 for this conversion. Currently we (inadvertently) interpret the `ArrayBuffer` according to an old standard called UCS-2, which only supports the Basic Multilingual Plane of Unicode. It does overlap with UTF-16 for this plane, but we will do the wrong thing for surrogate pairs in UTF-16.\r\n\r\n`Uint8Array`, btw, would interpret each byte as a separate character code in JS, which would essentially be ISO-8859 decoding. Critically this would _not_ be UTF-8 support - that would require decoding of multi-byte characters.\r\n\r\nThe fix I'm implementing is to add an optional `charsetHint` parameter to `Body.text()`. The default value will be `legacy` in order to not break the behavior today. `iso-8859` will be the other option, which will use `Uint8Array` for the conversion.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/comments/298074743/rea