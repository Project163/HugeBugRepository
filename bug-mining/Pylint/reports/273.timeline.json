[{"url":"https://api.github.com/repos/pylint-dev/pylint/issues/comments/381866991","html_url":"https://github.com/pylint-dev/pylint/issues/2019#issuecomment-381866991","issue_url":"https://api.github.com/repos/pylint-dev/pylint/issues/2019","id":381866991,"node_id":"MDEyOklzc3VlQ29tbWVudDM4MTg2Njk5MQ==","user":{"login":"PCManticore","id":448166,"node_id":"MDQ6VXNlcjQ0ODE2Ng==","avatar_url":"https://avatars.githubusercontent.com/u/448166?v=4","gravatar_id":"","url":"https://api.github.com/users/PCManticore","html_url":"https://github.com/PCManticore","followers_url":"https://api.github.com/users/PCManticore/followers","following_url":"https://api.github.com/users/PCManticore/following{/other_user}","gists_url":"https://api.github.com/users/PCManticore/gists{/gist_id}","starred_url":"https://api.github.com/users/PCManticore/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PCManticore/subscriptions","organizations_url":"https://api.github.com/users/PCManticore/orgs","repos_url":"https://api.github.com/users/PCManticore/repos","events_url":"https://api.github.com/users/PCManticore/events{/privacy}","received_events_url":"https://api.github.com/users/PCManticore/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-04-17T06:46:24Z","updated_at":"2018-04-17T06:46:24Z","body":"Thanks for the report! I can reproduce the issue. From a short glance, it seems we don't quite handle correctly `ignore_imports`, we only replace the line that has the import with blank, but that still will trigger on the following lines, while we should in fact skip the entire block.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/pylint-dev/pylint/issues/comments/381866991/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"PCManticore","id":448166,"node_id":"MDQ6VXNlcjQ0ODE