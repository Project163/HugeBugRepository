rred_url":"https://api.github.com/users/cx690/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cx690/subscriptions","organizations_url":"https://api.github.com/users/cx690/orgs","repos_url":"https://api.github.com/users/cx690/repos","events_url":"https://api.github.com/users/cx690/events{/privacy}","received_events_url":"https://api.github.com/users/cx690/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-11-08T06:46:55Z","updated_at":"2021-11-08T06:46:55Z","body":"I meet the same problem,and I regist classes by this way.\r\n```js\r\n\r\nimport path from 'path';\r\nimport { fileURLToPath } from 'url';\r\nimport { createConnection } from 'typeorm';\r\nconst __dirname = path.dirname(fileURLToPath(import.meta.url));\r\nconst js_files = fs.readdirSync(path.resolve(__dirname, './entities')).filter((f) => {\r\n    return f.endsWith('.js') || f.endsWith('.ts');\r\n});//find all js or ts in entities dir\r\n\r\nfunction* importSth() {\r\n    for (const f of js_files) {\r\n        yield import('./entities/' + f).then((res) => Object.values(res));//import all of them classes\r\n    }\r\n}\r\nconst entities = (await Promise.all([...importSth()])).flat();\r\ncreateConnection({\r\n        type: 'mysql',\r\n        database: 'index',\r\n        username: 'root', \r\n        password: '123456', \r\n        host: 'localhost', \r\n        entities, //regist\r\n})\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/typeorm/typeorm/issues/comments/962857391/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"cx690","id":37604988,"node_id":"MDQ6VXNlcjM3NjA0OTg4","avatar_url":"https://avatars.githubusercontent.com/u/37604988?v=4","gravatar_id":"","url":"https://api.github.com/users/cx690","html_url":"https://github.com/cx690","followers_url":"https://api.github.com