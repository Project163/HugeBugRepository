github.com/eslint/eslint.git","ssh_url":"git@github.com:eslint/eslint.git","clone_url":"https://github.com/eslint/eslint.git","svn_url":"https://github.com/eslint/eslint","homepage":"https://eslint.org","size":51012,"stargazers_count":26698,"watchers_count":26698,"language":"JavaScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":4866,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":103,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["ecmascript","eslint","javascript","linter","static-code-analysis"],"visibility":"public","forks":4866,"open_issues":103,"watchers":26698,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/eslint/eslint/pulls/3811","html_url":"https://github.com/eslint/eslint/pull/3811","diff_url":"https://github.com/eslint/eslint/pull/3811.diff","patch_url":"https://github.com/eslint/eslint/pull/3811.patch","merged_at":"2015-09-17T23:23:12Z"},"body":"Add an optional configuration for `space-before-blocks` that allows the user to distinguish between a function's block and a keyword's block.\naddress #3758 \n\nmy local tests are suffering from #3778 but were otherwise fine.\n\nchanges i made:\n- added branching logic to be able to detect if the block came from a function. this is accomplished by checking the type of the node's parent. after identification, the requirement for 'if a space is needed' is assigned based on the appropriate config option. \n- Backwards compatibility is supported: the user can enter both `always`/`never` to apply the check to both cases, or the newly added configuration object to apply the check to one or the other.\n- added explanation in the docs with examples\n- boatloads of tests to check nearly every path the user could take\n\nchanges i didnt make:\n- didnt make any jsdoc changes. was unsure if they were necessary\n- sweeping / breaking changes. i tried to keep the existing code in tact as much as possible, and largely used the update to `space-before-function-paren` as a guide on implementing this change\n\nas always, im open to feedback, editing, suggestions etc.\nlooking forward to your response!\n","reactions":{"url":"https://api.github.com/repos/eslint/eslint/issues/3811/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/eslint/eslint/issues/3811/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":410558476,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDQxMDU1ODQ3Ng==","url":"https://api.github.com/repos/eslint/eslint/issues/events/410558476","actor":{"login":"royriojas","id":131290,"node_id":"MDQ6VXNlcjEzMTI5MA==","avatar_url":"https://avatars.githubusercontent.com/u/131290?v=4","gravatar_id":"","url":"https://api.github.com/users/royriojas","html_url":"https://github.com/royriojas","followers_url":"https://api.github.com/users/royriojas/followers","following_url":"https://api.github.com/users/royriojas/following{/other_user}","gists_url":"https://api.github.com/users/royriojas/gists{/gist_id}","starred_url":"https://api.github.com/users/royriojas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/royriojas/subscriptions","organizations_url":"https://api.github.com/users/royriojas/orgs","repos_url":"https://api.github.com/users/royriojas/repos","events_url":"https://api.github.com/users/royriojas/events{/privacy}","received_events_url":"https://api.github.com/users/royriojas/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"32f0392a620620d3ca9f1009585512a803a21b2a","commit