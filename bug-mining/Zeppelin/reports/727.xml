			&lt;li&gt;How should this be tested?&lt;br/&gt;
    1. In shiro.ini config the JDBCRealm like:&lt;/li&gt;
		&lt;/ol&gt;
		&lt;/li&gt;
	&lt;/ol&gt;
	&lt;/li&gt;
&lt;/ol&gt;


&lt;p&gt;    ds = org.apache.commons.dbcp2.BasicDataSource&lt;br/&gt;
    ds.driverClassName = com.mysql.jdbc.Driver&lt;br/&gt;
    ds.url= jdbc:mysql://localhost:3306/shiro&lt;br/&gt;
    ds.username = root&lt;br/&gt;
    ds.password = 123456&lt;/p&gt;

&lt;p&gt;    jdbcRealm = org.apache.shiro.realm.jdbc.JdbcRealm&lt;br/&gt;
    jdbcRealm.dataSource = $ds&lt;br/&gt;
    jdbcRealm.permissionsLookupEnabled = false&lt;br/&gt;
    jdbcRealm.authenticationQuery = SELECT password FROM user WHERE name = ?&lt;br/&gt;
    jdbcRealm.userRolesQuery = SELECT role_name FROM user_roles WHERE name  = ?&lt;br/&gt;
    jdbcRealm.permissionsQuery = SELECT permission FROM roles_permissions WHERE role_name = ?&lt;/p&gt;

&lt;p&gt;    2. login and request the rest&lt;br/&gt;
    Get /security/userlist/youruser&lt;/p&gt;


