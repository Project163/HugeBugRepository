her_user}","gists_url":"https://api.github.com/users/not-an-aardvark/gists{/gist_id}","starred_url":"https://api.github.com/users/not-an-aardvark/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/not-an-aardvark/subscriptions","organizations_url":"https://api.github.com/users/not-an-aardvark/orgs","repos_url":"https://api.github.com/users/not-an-aardvark/repos","events_url":"https://api.github.com/users/not-an-aardvark/events{/privacy}","received_events_url":"https://api.github.com/users/not-an-aardvark/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":2,"created_at":"2016-11-10T07:21:32Z","updated_at":"2018-02-06T22:02:58Z","closed_at":"2016-11-11T16:26:31Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**Configuration**\r\n```\r\nnode 6.9.1\r\nnpm 3.10.8\r\ndependencies: {\r\n    \"eslint\": \"^3.8.0\",\r\n    \"eslint-loader\": \"^1.6.1\",\r\n    \"eslint-plugin-import\": \"^2.0.1\",\r\n    \"babel-eslint\": \"^7.1.0\",\r\n    \"eslint-config-xo\": \"^0.17.0\",\r\n    \"eslint-config-xo-react\": \"^0.10.0\",\r\n    \"eslint-plugin-ava\": \"^4.0.0\",\r\n    \"eslint-plugin-react\": \"^6.6.0\"\r\n  }\r\n```\r\n\r\n**Have**\r\nYou have `index.js`:\r\n```js\r\nfunction MyObj() {}\r\n\r\nMyObj.prototype = {\r\n    someMethod: async function () {}\r\n};\r\n```\r\n\r\nYou have `.eslintrc`\r\n```json\r\n{\r\n    \"parserOptions\": {\r\n        \"ecmaVersion\": 2017\r\n    },\r\n    \"rules\": {\r\n        \"object-shorthand\": [\"error\", \"always\"]\r\n    }\r\n}\r\n```\r\n\r\nYou run:\r\n```bash\r\n./node_modules/.bin/eslint --fix ./index.js \r\n```\r\n\r\nYou get in `index.js`:\r\n```js\r\nexport default {};\r\n\r\nfunction MyObj() {}\r\n\r\nMyObj.prototype = {\r\n    someMethodnction() {} // wrong auto-fix\r\n};\r\n```\r\n\r\n**Expects & caused by**\r\nI've investigated that it caused by `object-shorthand` rule. \r\n```json\r\n{\r\n    \"object-shorthand\": [\"error\", \"properties\"]\r\n}\r\n```\r\nIf i set up it like that everything is ok. But I think with rule `[\"error\", \"always\"]` also everything should be linted great.","closed_by":{"login":"vitorbal","id":626038,"node_id":"MDQ6VXNlcjYyNjAzOA==","avatar_url":"https://avatars.githubusercontent.com/u/626038?v=4","gravatar_id":"","url":"https://api.github.com/users/vitorbal","html_url":"https://github.com/vitorbal","followers_url":"https://api.github.com/users/vitorbal/followers","following_url":"https://api.github.com/users/vitorbal/following{/other_user}","gists_url":"https://api.github.com/users/vitorbal/gists{/gist_id}","starred_url":"https://api.github.com/users/vitorbal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vitorbal/subscriptions","organizations_url":"https://api.github.com/users/vitorbal/orgs","repos_url":"https://api.github.com/users/vitorbal/repos","events_url":"https://api.github.com/users/vitorbal/events{/privacy}","received_events_url":"https://api.github.com/users/vitorbal/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/eslint/eslint/issues/7574/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/eslint/eslint/issues/7574/timeline","performed_via_github_app":null,"state_reason":"completed"}