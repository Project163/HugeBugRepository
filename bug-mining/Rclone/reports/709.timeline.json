rs/ncw/subscriptions","organizations_url":"https://api.github.com/users/ncw/orgs","repos_url":"https://api.github.com/users/ncw/repos","events_url":"https://api.github.com/users/ncw/events{/privacy}","received_events_url":"https://api.github.com/users/ncw/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-06-04T17:12:50Z","updated_at":"2022-06-04T17:12:50Z","body":"The problem here is that each of the unknown length files (the google docs) is counting as 3 transfers, not 1.\r\n\r\nHere is a simple example\r\n\r\n```\r\n$ rclone -vv copy drive:GDocs/Sheets.xlsx /tmp/\r\n...\r\nTransferred:   \t    7.078 KiB / 7.078 KiB, 100%, 0 B/s, ETA -\r\nTransferred:            3 / 3, 100%\r\nElapsed time:         3.8s\r\n```\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/rclone/rclone/issues/comments/1146652123/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ncw","id":536803,"node_id":"MDQ6VXNlcjUzNjgwMw==","avatar_url":"https://avatars.githubusercontent.com/u/536803?v=4","gravatar_id":"","url":"https://api.github.com/users/ncw","html_url":"https://github.com/ncw","followers_url":"https://api.github.com/users/ncw/followers","following_url":"https://api.github.com/users/ncw/following{/other_user}","gists_url":"https://api.github.com/users/ncw/gists{/gist_id}","starred_url":"https://api.github.com/users/ncw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ncw/subscriptions","organizations_url":"https://api.github.com/users/ncw/orgs","repos_url":"https://api.github.com/users/ncw/repos","events_url":"https://api.github.com/users/ncw/events{/privacy}","received_events_url":"https://api.github.com/users/ncw/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":6742246351,"node_id":"RTE_lADOAQ-n5M5LGbIqzwAAAAGR3oPP","url":"https://api.github.com/repos/rclone/rclone/issues/events/6742246351","actor":{"login":"ncw","id":536803,"node_id":"MDQ6VXNlcjUzNjgwMw==","avatar_url":"https://avatars.githubusercontent.com/u/536803?v=4","gravatar_id":"","url":"https://api.github.com/users/ncw","html_url":"https://github.com/ncw","followers_url":"https://api.github.com/users/ncw/followers","following_url":"https://api.github.com/users/ncw/following{/other_user}","gists_url":"https://api.github.com/users/ncw/gists{/gist_id}","starred_url":"https://api.github.com/users/ncw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ncw/subscriptions","organizations_url":"https://api.github.com/users/ncw/orgs","repos_url":"https://api.github.com/users/ncw/repos","events_url":"https://api.github.com/users/ncw/events{/privacy}","received_events_url":"https://api.github.com/users/ncw/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2022-06-04T17:13:20Z","rename":{"from":"Stats incorrect count retries","to":"Unknown length file transfers count 3 transfers not one"},"performed_via_github_app":null},{"id":6742248960,"node_id":"MIE_lADOAQ-n5M5LGbIqzwAAAAGR3o4A","url":"https://api.github.com/repos/rclone/rclone/issues/events/6742248960","actor":{"login":"ncw","id":536803,"node_id":"MDQ6VXNlcjUzNjgwMw==","avatar_url":"https://avatars.githubusercontent.com/u/536803?v=4","gravatar_id":"","url":"https://api.github.com/users/ncw","html_url":"https://github.com/ncw","followers_url":"https://api.github.com/users/ncw/followers","following_url":"https://api.github.com/users/ncw/following{/other_user}","gists_url":"https://api.github.com/users/ncw/gists{/gist_id}","starred_url":"https://api.github.com/users/ncw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ncw/subscriptions","organizations_url":"https://api.github.com/users/ncw/orgs","repos_url":"https://api.github.com/users/ncw/repos","events_url":"https://api.github.com/users/ncw/events{/privacy}","received_events_url":"https://api.github.com/users/ncw/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"milestoned","commit_id":null,"commit_url":null,"created_at":"2022-06-04T17:15:57Z","milestone":{"title":"v1.59"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/rclone/rclone/issues/comments/1163922478","html_url":"https://github.com/rclone/rclone/issues/6213#issuecomment-1163922478","issue_url":"https://api.github.com/repos/rclone/rclone/issues/6213","id":1163922478,"node_id":"IC_kwDOAQ-n5M5FYAwu","user":{"login":"SandroJijavadze","id":23349818,"node_id":"MDQ6VXNlcjIzMzQ5ODE4","avatar_url":"https://avatars.githubusercontent.com/u/23349818?v=4","gravatar_id":"","url":"https://api.github.com/users/SandroJijavadze","html_url":"https://github.com/SandroJijavadze","followers_url":"https://api.github.com/users/SandroJijavadze/followers","following_url":"https://api.github.com/users/SandroJijavadze/following{/other_user}","gists_url":"https://api.github.com/users/SandroJijavadze/gists{/gist_id}","starred_url":"https://api.github.com/users/SandroJijavadze/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SandroJijavadze/subscriptions","organizations_url":"https://api.github.com/users/SandroJijavadze/orgs","repos_url":"https://api.github.com/users/SandroJijavadze/repos","events_url":"https://api.github.com/users/SandroJijavadze/events{/privacy}","received_events_url":"https://api.github.com/users/SandroJijavadze/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-06-23T04:45:18Z","updated_at":"2022-06-23T04:45:18Z","body":"I tried to look into it to possibly fix it, found why it happens but I don't know the codebase well enough yet to propose solution.\r\n\r\nIt does these:\r\n`Copied (new)` \r\n` Doc.docx: Copied (Rcat, new)`\r\neach time calling `Transfer.Done()` thereby incrementing `s.transfers++` which adds stats.\r\nand also possibly doing the same after \r\n`Doc.docx: Updating size of doc after download to 7625`\r\n\r\n\r\n\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/rclone/rclone/issues/comments/1163922478/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"SandroJijavadze","id":23349818,"node_id":"MDQ6VXNlcjIzMzQ5ODE4","avatar_url":"https://avatars.githubusercontent.com/u/23349818?v=4","gravatar_id":"","url":"https://api.github.com/users/SandroJijavadze","html_url":"https://github.com/SandroJijavadze","followers_url":"https://api.github.com/users/SandroJijavadze/followers","following_url":"https://api.github.com/users/SandroJijavadze/following{/other_user}","gists_url":"https://api.github.com/users/SandroJijavadze/gists{/gist_id}","starred_url":"https://api.github.com/users/SandroJijavadze/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SandroJijavadze/subscriptions","organizations_url":"https://api.github.com/users/SandroJijavadze/orgs","repos_url":"https://api.github.com/users/SandroJijavadze/repos","events_url":"https://api.github.com/users/SandroJijavadze/events{/privacy}","received_events_url":"https://api.github.com/users/SandroJijavadze/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/rclone/rclone/issues/comments/1164169523","html_url":"https://github.com/rclone/rclone/issues/6213#issuecomment-1164169523","issue_url":"https://api.github.com/repos/rclone/rclone/issues/6213","id":1164169523,"node_id":"IC_kwDOAQ-n5M5FY9Ez","user":{"login":"ncw","id":536803,"node_id":"MDQ6VXNlcjUzNjgwMw==","avatar_url":"https://avatars.githubusercontent.com/u/536803?v=4","gravatar_id":"","url":"https://api.github.com/users/ncw","html_url":"https://github.com/ncw","followers_url":"https://api.github.com/users/ncw/followers","following_url":"https://api.github.com/users/ncw/following{/other_user}","gists_url":"https://api.github.com/users/ncw/gists{/gist_id}","starred_url":"https://api.github.com/users/ncw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ncw/subscriptions","organizations_url":"https://api.github.com/users/ncw/orgs","repos_url":"https://api.github.com/users/ncw/repos","events_url":"https://api.github.com/users/ncw/events{/privacy}","received_events_url":"https://api.github.com/users/ncw/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-06-23T09:24:37Z","updated_at":"2022-06-23T09:25:05Z","body":"@SandroJijavadze what is happening is that the `operations.Copy` is falling back to `operations.Rcat` because the length of the file is unknown which happens here\r\n\r\nhttps://github.com/rclone/rclone/blob/53f831f40a7341cc3da199b0266ea573b6d94551/fs/operations/operations.go#L461-L469\r\n\r\nYou are correct in that `operations.Copy` counts a transfer regardless of what happens (provided there is no error being returned)\r\n\r\nhttps://github.com/rclone/rclone/blob/53f831f40a7341cc3da199b0266ea573b6d94551/fs/operations/operations.go#L383-L385\r\n\r\n`operations.Rcat` counts a transfer too here\r\n\r\nhttps://github.com/rclone/rclone/blob/53f831f40a7341cc3da199b0266ea573b6d94551/fs/operations/operations.go#L1347-L1353\r\n\r\nAnd I think the 3rd one is counted by `operations.Copy`! when `Rcat` calls it to transfer a small memory sized object.\r\n\r\nhttps://github.com/rclone/rclone/blob/53f831f40a7341cc3da199b0266ea573b6d94551/fs/operations/operations.go#L1390-L1396\r\n\r\nSo I think that is why we get 3 transfers. How to fix it isn't so obvious though...\r\n\r\nI think this needs to be a fix in `Transfer`. What is happening is that we are getting nested calls to `NewTransfer(o)` `tr.Done()` with the same object.\r\n\r\n- tr: = NewTransfer(o) // Copy\r\n    - tr: = NewTransfer(o) // Rcat\r\n        - tr: = NewTransfer(o) // Copy\r\n        - tr.Done()\r\n    - tr.Done() // tr not in transfer map here\r\n- tr.Done() // tr not in transfer map here\r\n\r\nThe transfer is counted here\r\n\r\nhttps://github.com/rclone/rclone/blob/53f831f40a7341cc3da199b0266ea573b6d94551/fs/accounting/stats.go#L718-L724\r\n\r\nAnd that gives me an idea for a fix. If the transfer was not in the transfer map (which it won't be if it is nested), then we shouldn't count a transfer as it has already been counted. So change\r\n\r\nhttps://github.com/rclone/rclone/blob/53f831f40a7341cc3da199b0266ea573b6d94551/fs/accounting/transfermap.go#L37\r\n\r\nto return a boolean as to whether it was present in the map or not, and only increment transfers if it was.\r\n\r\nThis change should probably be made to \r\n\r\nhttps://github.com/rclone/rclone/blob/53f831f40a7341cc3da199b0266ea573b6d94551/fs/accounting/stats.go#L685\r\n\r\nif it works.\r\n\r\nFancy giving that a try?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/rclone/rclone/issues/comments/1164169523/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ncw","id":536803,"node_id":"MDQ6VXNlcjUzNjgwMw==","avatar_url":"https://avatars.githubusercontent.com/u/536803?v=4","gravatar_id":"","url":"https://api.github.com/users/ncw","html_url":"https://github.com/ncw","followers_url":"https://api.github.com/users/ncw/followers","following_url":"https://api.github.com/users/ncw/following{/other_user}","gists_url":"https://api.github.com/users/ncw/gists{/gist_id}","starred_url":"https://api.github.com/users/ncw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ncw/subscriptions","organizations_url":"https://api.github.com/users/ncw/orgs","repos_url":"https://api.github.com/users/ncw/repos","events_url":"https://api.github.com/users/ncw/events{/privacy}","received_e