b.com/users/ADITYA-kus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ADITYA-kus/subscriptions","organizations_url":"https://api.github.com/users/ADITYA-kus/orgs","repos_url":"https://api.github.com/users/ADITYA-kus/repos","events_url":"https://api.github.com/users/ADITYA-kus/events{/privacy}","received_events_url":"https://api.github.com/users/ADITYA-kus/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-25T14:03:44Z","updated_at":"2025-10-25T14:03:44Z","body":"Thanks for the quick response! Here's my proposed improved error message:\n\n\nIntCastingNaNError: Cannot convert non-finite values (NA or inf) to integer.\n\nSuggested solutions:\n• Use .astype('Int64') for nullable integer type (supports missing values)\n• Use .fillna(value) to replace missing values before conversion  \n• Use .dropna() to remove rows with missing values\n\nExample usage:\n    df['column'] = df['column'].astype('Int64')\n    df['column'] = df['column'].fillna(0).astype('int64')\n    df = df.dropna().astype({'column': 'int64'})","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/pandas-dev/pandas/issues/comments/3446737736/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ADITYA-kus","id":196836206,"node_id":"U_kgDOC7t7bg","avatar_url":"https://avatars.githubusercontent.com/u/196836206?v=4","gravatar_id":"","url":"https://api.github.com/users/ADITYA-kus","html_url":"https://github.com/ADITYA-kus","followers_url":"https://api.github.com/users/ADITYA-kus/followers","following_url":"https://api.github.com/users/ADITYA-kus/following{/other_user}","gists_url":"https://api.github.com/users/ADITYA-kus/gists{/gist_id}","starred_url":"https://api.github.com/users/ADITYA-kus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ADITYA-kus/subscriptions","organizations_url":"https://api.github.com/users/ADITYA-kus/orgs","repos_url":"https://api.github.com/users/ADITYA-kus/repos","events_url":"https://api.github.com/users/ADITYA-kus/events{/privacy}","received_events_url":"https://api.github.com/users/ADITYA-kus/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/pandas-dev/pandas/issues/comments/3446874510","html_url":"https://github.com/pandas-dev/pandas/issues/62838#issuecomment-3446874510","issue_url":"https://api.github.com/repos/pandas-dev/pandas/issues/62838","id":3446874510,"node_id":"IC_kwDOAA0YD87NcyGO","user":{"login":"rhshadrach","id":45562402,"node_id":"MDQ6VXNlcjQ1NTYyNDAy","avatar_url":"https://avatars.githubusercontent.com/u/45562402?v=4","gravatar_id":"","url":"https://api.github.com/users/rhshadrach","html_url":"https://github.com/rhshadrach","followers_url":"https://api.github.com/users/rhshadrach/followers","following_url":"https://api.github.com/users/rhshadrach/following{/other_user}","gists_url":"https://api.github.com/users/rhshadrach/gists{/gist_id}","starred_url":"https://api.github.com/users/rhshadrach/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rhshadrach/subscriptions","organizations_url":"https://api.github.com/users/rhshadrach/orgs","repos_url":"https://api.github.com/users/rhshadrach/repos","events_url":"https://api.github.com/users/rhshadrach/events{/privacy}","received_events_url":"https://api.github.com/users/rhshadrach/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-25T16:16:53Z","updated_at":"2025-10-25T16:16:53Z","body":"I see a few more, perhaps there are still others.\n\n- One could also cast to different dtypes, e.g. `int64[pyarrow]` or `float64` or ...\n- One could avoid nans entering the data in the first place (e.g. join with `how=\"inner\"` instead of the default `how=\"left\"`)\n- A nan could be the result of invalid input data, and fixing the data could be the resolution.\n\nThe error message you have is already beyond what I think pandas should strive for in a concise error message. In this case, there are many different resolutions a user can do, it seems to me we should not attempt to enumerate them. I'm negative on this change.\n\ncc @mroeschke  for any thoughts.\n\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/pandas-dev/pandas/issues/comments/3446874510/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"rhshadrach","id":45562402,"node_id":"MDQ6VXNlcjQ1NTYyNDAy","avatar_url":"https://avatars.githubusercontent.com/u/45562402?v=4","gravatar_id":"","url":"https://api.github.com/users/rhshadrach","html_url":"https://github.com/rhshadrach","followers_url":"https://api.github.com/users/rhshadrach/followers","following_url":"https://api.github.com/users/rhshadrach/following{/other_user}","gists_url":"https://api.github.com/users/rhshadrach/gists{/gist_id}","starred_url":"https://api.github.com/users/rhshadrach/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rhshadrach/subscriptions","organizations_url":"https://api.github.com/users/rhshadrach/orgs","repos_url":"https://api.github.com/users/rhshadrach/repos","events_url":"https://api.github.com/users/rhshadrach/events{/privacy}","received_events_url":"https://api.github.com/users/rhshadrach/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":20503368120,"node_id":"MEE_lADOAA0YD87TvlbvzwAAAATGGJG4","url":"https://api.github.com/repos/pandas-dev/pandas/issues/events/20503368120","actor":{"login":"mroeschke","id":10647082,"node_id":"MDQ6VXNlcjEwNjQ3MDgy","avatar_url":"https://avatars.githubusercontent.com/u/10647082?v=4","gravatar_id":"","url":"https://api.github.com/users/mroeschke","html_url":"https://github.com/mroeschke","fol