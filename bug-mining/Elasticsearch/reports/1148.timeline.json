icsearch","size":1565839,"stargazers_count":76300,"watchers_count":76300,"language":"Java","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":25807,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":5588,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["elasticsearch","java","search-engine"],"visibility":"public","forks":25807,"open_issues":5588,"watchers":76300,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/elastic/elasticsearch/pulls/11158","html_url":"https://github.com/elastic/elasticsearch/pull/11158","diff_url":"https://github.com/elastic/elasticsearch/pull/11158.diff","patch_url":"https://github.com/elastic/elasticsearch/pull/11158.patch","merged_at":null},"body":"This PR ensures completion entries with an input of an empty string never gets indexed into the underlying FST. \n\nThere is no way to retrieve an entry associated with an empty string through the _suggest API, so these entries should never be part of the underlying index, as they can never be retrieved but might bloat the FST with their context, weight, payload, etc.\n\ncloses #10987\n","reactions":{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/11158/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/elastic/elasticsearch/issues/11158/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/elastic/elasticsearch/issues/comments/101882678","html_url":"https://github.com/elastic/elasticsearch/issu