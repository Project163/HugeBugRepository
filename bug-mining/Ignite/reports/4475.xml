            <title>[IGNITE-12277] Index usage is not applicable for mixed IN and EQUALS queries.</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-12277</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;create table test(pk int, a int, b int);&lt;br/&gt;
create index idx on test(a);&lt;br/&gt;
select * from test where a in(r1 ...r2) &amp;lt;- index usage passed here, explain show correctness.&lt;br/&gt;
select * from test where a in(r1 ...r2) and b = r3 &amp;lt;- index usage failed here, but there is no rejection for using it.&lt;/p&gt;</description>
