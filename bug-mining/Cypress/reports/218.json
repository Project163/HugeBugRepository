rred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brian-mann/subscriptions","organizations_url":"https://api.github.com/users/brian-mann/orgs","repos_url":"https://api.github.com/users/brian-mann/repos","events_url":"https://api.github.com/users/brian-mann/events{/privacy}","received_events_url":"https://api.github.com/users/brian-mann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":78,"state":"closed","created_at":"2017-09-13T14:53:19Z","updated_at":"2018-06-01T19:50:25Z","due_on":null,"closed_at":"2017-09-18T04:13:38Z"},"comments":14,"created_at":"2015-04-20T20:01:02Z","updated_at":"2023-05-19T08:26:41Z","closed_at":"2017-07-07T18:21:34Z","author_association":"MEMBER","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"When I use command `cy.type()` for inputs of type date, time, month, and week the value is not updated for the input. The type command needs to do special logic to inject the values (or do special click / selects / types) due to the formatting / dropdown nature of these inputs. \n\n**Date Example**\n\n``` html\n<input name=\"birthday\" type=\"date\">\n```\n\n``` coffee\ncy.get(\"input[name='birthday']\").type(\"11151985\").should(\"have.value\", \"1985-11-15\")\n```\n\nThis example's assertion will fail and say `expected input to have value of '1985-11-15', but got ''`\n\n**Time Example**\n\n``` html\n<input name=\"appt\" type=\"time\">\n```\n\n``` coffee\ncy.get(\"input[name='appt']\").type(\"1215am\").should(\"have.value\", \"00:15:00\")\n```\n\nThis example's assertion will fail and say `expected input to have value of '00:15:00', but got ''`\n\n**Month Example**\n\n``` html\n<input id=\"month\" type=\"month\">\n```\n\n``` coffee\ncy.get(\"#month\").type(\"February 2012\").should(\"have.value\", \"February 2012\")\n```\n\nThis example's assertion will fail and say `expected '<input#month.form-control>' to have value 'February 2012', but the value was ''`\n\n**Week Example**\n\n``` html\n<input id=\"week\" type=\"week\">\n```\n\n``` coffee\ncy.get(\"#week\").type(\"20, 2016\").should(\"have.value\", \"February 2012\")\n```\n\nThis example's assertion will fail and say `expected '<input#week.form-control>' to have value '20, 2016', but the value was ''`\n","closed_by":{"login":"RandallKent","id":51821,"node_id":"MDQ6VXNlcjUxODIx","avatar_url":"https://avatars.githubusercontent.com/u/51821?v=4","gravatar_id":"","url":"https://api.github.com/users/RandallKent","html_url":"https://github.com/RandallKent","followers_url":"https://api.github.com/users/RandallKent/followers","following_url":"https://api.github.com/users/RandallKent/following{/other_user}","gists_url":"https://api.github.com/users/RandallKent/gists{/gist_id}","starred_url":"https://api.github.com/users/RandallKent/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RandallKent/subscriptions","organizations_url":"https://api.github.com/users/RandallKent/orgs","repos_url":"https://api.github.com/users/RandallKent/repos","events_url":"https://api.github.com/users/RandallKent/events{/privacy}","received_events_url":"https://api.github.com/users/RandallKent/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/cypress-io/cypress/issues/27/reactions","total_count":5,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/cypress-io/cypress/issues/27/timeline","performed_via_github_app":null,"state_reason":"completed"}