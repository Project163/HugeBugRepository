                                    <fixVersion>2.0</fixVersion>
                                    <component>platforms</component>
                        <due></due>
                            <votes>0</votes>
                                    <watches>1</watches>
                                                                                                                <comments>
                            <comment id="15968896" author="ptupitsyn" created="Fri, 14 Apr 2017 11:03:20 +0000"  >&lt;p&gt;We should probably remove &lt;tt&gt;ICachePluginProvider&lt;/tt&gt; and related infrastructure and leave only Java-based plugins in place (&lt;tt&gt;ICachePluginConfiguration&lt;/tt&gt; with non-null &lt;tt&gt;CachePluginConfigurationClosureFactoryId&lt;/tt&gt;), since current infrastructure on .NET side does not play along with new Java aprt at all.&lt;/p&gt;</comment>
                            <comment id="15968920" author="ptupitsyn" created="Fri, 14 Apr 2017 11:34:16 +0000"  >&lt;p&gt;&lt;a href=&quot;https://issues.apache.org/jira/browse/IGNITE-4987&quot; title=&quot;.NET-based cache plugins&quot; class=&quot;issue-link&quot; data-issue-key=&quot;IGNITE-4987&quot;&gt;IGNITE-4987&lt;/a&gt; created to restore .NET-based cache plugins&lt;/p&gt;</comment>
                            <comment id="15968930" author="ptupitsyn" created="Fri, 14 Apr 2017 11:45:38 +0000"  >&lt;p&gt;Fixed in master&lt;/p&gt;</comment>
                    </comments>
