re is just one traversal that uses `minimatch` to compare patterns.\n- Added `debug` so it will be easier to debug issues with this behavior in the future.\n- Removed unnecessary code from config.\n\n(refs #928, fixes #901, fixes #837, fixes #853)\n","reactions":{"url":"https://api.github.com/repos/eslint/eslint/issues/930/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/eslint/eslint/issues/930/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":124527414,"node_id":"MDExOkNsb3NlZEV2ZW50MTI0NTI3NDE0","url":"https://api.github.com/repos/eslint/eslint/issues/events/124527414","actor":{"login":"nzakas","id":38546,"node_id":"MDQ6VXNlcjM4NTQ2","avatar_url":"https://avatars.githubusercontent.com/u/38546?v=4","gravatar_id":"","url":"https://api.github.com/users/nzakas","html_url":"https://github.com/nzakas","followers_url":"https://api.github.com/users/nzakas/followers","following_url":"https://api.github.com/users/nzakas/following{/other_user}","gists_url":"https://api.github.com/users/nzakas/gists{/gist_id}","starred_url":"https://api.github.com/users/nzakas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nzakas/subscriptions","organizations_url":"https://api.github.com/users/nzakas/orgs","repos_url":"https://api.github.com/users/nzakas/repos","events_url":"https://api.github.com/users/nzakas/events{/privacy}","received_events_url":"https://api.github.com/users/nzakas/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2014-05-24T18:49:46Z","state_reason":null,"performed_via_github_app":null},{"id":1461480095,"node_id":"MDExOkxvY2tlZEV2ZW50MTQ2MTQ4MDA5NQ==","url":"https://api.github.com/repos/eslint/eslint/issues/events/1461480095","actor":{"login":"eslint-deprecated[bot]","id":29966797,"node_id":"MDM6Qm90Mjk5N