/core_type_mat4x4.cpp:235:25: No matching constructor for initialization of 'std::vectorglm::mat4'\n\nThis was tested on Apple LLVM version 5.0 (clang-500.2.79) (based on LLVM 3.3svn).\n\nI also tested the behaviour of VC13 and it's very similar.\n\nThanks,\nChristophe \n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/g-truc/glm/issues/comments/34523331/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Groovounet","id":367227,"node_id":"MDQ6VXNlcjM2NzIyNw==","avatar_url":"https://avatars.githubusercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/g-truc/glm/issues/comments/34538932","html_url":"https://github.com/g-truc/glm/issues/160#issuecomment-34538932","issue_url":"https://api.github.com/repos/g-truc/glm/issues/160","id":34538932,"node_id":"MDEyOklzc3VlQ29tbWVudDM0NTM4OTMy","user":{"login":"TieJu","id":858025,"node_id":"MDQ6VXNlcjg1ODAyNQ==","avatar_url":"https://avatars.githubusercontent.com/u/858025?v=4","gravatar_id":"","url":"https://api.github.com/users/TieJu","html_url":"https://g