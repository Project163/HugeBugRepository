+
+        assertThrows(() ->
+                execute("UPDATE SIMPLE SET _key = ?, _val = ?", 42, "simple name"),
+            "SQL UPDATE can't modify key or its fields directly");
+
+        assertThrows(() ->
+                execute("UPDATE SIMPLE SET id = ?, _val = ?", 42, "simple name"),
