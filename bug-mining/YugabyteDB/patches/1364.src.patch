+  INSERT INTO pg_catalog.pg_proc (
+    oid, proname, pronamespace, proowner, prolang, procost, prorows, provariadic, prosupport,
+    prokind, prosecdef, proleakproof, proisstrict, proretset, provolatile, proparallel, pronargs,
