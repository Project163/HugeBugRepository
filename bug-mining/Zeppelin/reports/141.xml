<item>
            <title>[ZEPPELIN-414] Big Result are shown outside the container</title>
                <link>https://issues.apache.org/jira/browse/ZEPPELIN-414</link>
                <project id="12316221" key="ZEPPELIN">Zeppelin</project>
                    <description>&lt;p&gt;When custom result is too wide (html for example), the result will burst out of the container and create a scrollbar at page level.&lt;/p&gt;

&lt;p&gt;The result should always be constrained to the paragraph result container&lt;/p&gt;</description>
                <environment></environment>
        <key id="12912394">ZEPPELIN-414</key>
            <summary>Big Result are shown outside the container</summary>
                <type id="1" iconUrl="https://issues.apache.org/jira/secure/viewavatar?size=xsmall&amp;avatarId=21133&amp;avatarType=issuetype">Bug</type>
                                            <priority id="3" iconUrl="https://issues.apache.org/jira/images/icons/priorities/major.svg">Major</priority>
                        <status id="6" iconUrl="https://issues.apache.org/jira/images/icons/statuses/closed.png" description="The issue is considered finished, the resolution is correct. Issues which are not closed can be reopened.">Closed</status>
                    <statusCategory id="3" key="done" colorName="green"/>
