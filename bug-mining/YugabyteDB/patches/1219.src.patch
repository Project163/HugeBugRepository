+    ASSERT_OK(result);
+    ASSERT_EQ((std::vector<int32_t>{1, 2, 3}), *result);
+
+    // Test with bounds
+    result = ParseCommaSeparatedListOfNumbers<int32_t, std::vector<int32_t>>("4,5,6", 4, 6);
+    ASSERT_OK(result);
+    ASSERT_EQ((std::vector<int32_t>{4, 5, 6}), *result);
