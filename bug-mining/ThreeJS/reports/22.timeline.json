ssues/comments/6906183","html_url":"https://github.com/mrdoob/three.js/issues/2175#issuecomment-6906183","issue_url":"https://api.github.com/repos/mrdoob/three.js/issues/2175","id":6906183,"node_id":"MDEyOklzc3VlQ29tbWVudDY5MDYxODM=","user":{"login":"timknip","id":48036,"node_id":"MDQ6VXNlcjQ4MDM2","avatar_url":"https://avatars.githubusercontent.com/u/48036?v=4","gravatar_id":"","url":"https://api.github.com/users/timknip","html_url":"https://github.com/timknip","followers_url":"https://api.github.com/users/timknip/followers","following_url":"https://api.github.com/users/timknip/following{/other_user}","gists_url":"https://api.github.com/users/timknip/gists{/gist_id}","starred_url":"https://api.github.com/users/timknip/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timknip/subscriptions","organizations_url":"https://api.github.com/users/timknip/orgs","repos_url":"https://api.github.com/users/timknip/repos","events_url":"https://api.github.com/users/timknip/events{/privacy}","received_events_url":"https://api.github.com/users/timknip/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2012-07-11T13:19:14Z","updated_at":"2012-07-11T13:22:02Z","body":"Looking at mergeVertices() it seems the convert from Face4 to Face3 only happens when there's dup indices in Face4....\n\nSo... guess I created some invalid Face4's to begin with (my bad!)... \n\nThat said: the issue still stands.\n\n```\nvar geometry = new THREE.Geometry();\n\ngeometry.vertices = [\n    new THREE.Vector3(-1, 0, 0),\n    new THREE.Vector3( 1, 0, 0),\n    new THREE.Vector3( 1, 1, 0),\n    new THREE.Vector3( 1, 1, 0),\n];\n\ngeometry.materials = [\n    new THREE.MeshPhongMaterial( { color: 0xff0000, shading: THREE.FlatShading } ),\n    new THREE.MeshPhongMaterial( { color: 0x00ff00, shading: THREE.FlatShading } )\n];\n\ngeometry.faces = [\n    new THREE.Face4(0, 1, 2, 3, null, null, 1)\n];\n\ngeometry.mergeVertices();\n\nscene.add( new THREE.Mesh( geometry, new THREE.MeshFaceMaterial() ) );\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/mrdoob/three.js/issues/comments/6906183/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"timknip","id":48036,"node_id":"MDQ6VXNlcjQ4MDM2","avatar_url":"https://avatars.githubusercontent.com/u/48036?v=4","gravatar_id":"","url":"https://api.github.com/users/timknip","html_url":"https://github.com/timknip","followers_url":"https://api.github.com/users/timknip/followers","following_url":"https://api.github.com/users/timknip/following{/other_user}","gists_url":"https://api.github.com/users/timknip/gists{/gist_id}","starred_url":"https://api.github.com/users/timknip/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timknip/subscriptions","organizations_url":"https://api.github.com/users/timknip/orgs","repos_url":"https://api.github.com/users/timknip/repos","events_url":"https://api.github.com/users/timknip/events{/privacy}","received_events_url":"https://api.github.com/users/timknip/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/mrdoob/three.js/issues/comments/6941374","html_url":"https://github.com/mrdoob/three.js/issues/2175#issuecomment-6941374","issue_url":"https://api.github.com/repos/mrdoob/three.js/issues/2175","id":6941374,"node_id":"MDEyOklzc3VlQ29tbWVudDY5NDEzNzQ=","user":{"login":"zz85","id":314997,"node_id":"MDQ6VXNlcjMxNDk5Nw==","avatar_url":"https://avatars.githubusercontent.com/u/314997?v=4","gravatar_id":"","url":"https://api.github.com/users/zz85","html_url":"https://github.com/zz85","followers_url":"https://api.github.com/users/zz85/followers","following_url":"https://api.github.com/users/zz85/following{/other_user}","gists_url":"https://api.github.com/users/zz85/gists{/gist_id}","starred_url":"https://api.