_admin":false},"created_at":"2020-01-13T14:24:34Z","updated_at":"2020-01-13T14:24:34Z","body":"I used serializer for implementing pagination for REST API. First request arrives, I build query, then serialize and cache it. When client want next chunk, I deserialize query, adjust limit/offset and execute it.\r\n\r\nThe reason why I chosen this way is that queries can be very complicated, and context (attributes and values, joins, etc) will be lost when requesting next chunk.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/573687356/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"tribals","id":3613180,"node_id":"MDQ6VXNlcjM2MTMxODA=","avatar_url":"https://avatars.githubusercontent.com/u/3613180?v=4","gravatar_id":"","url":"https://api.github.com/users/tribals","html_url":"https://github.com/tribals","followers_url":"https://api.github.com/users/tribals/followers","following_url":"https://api.github.com/users/tribals/following{/other_user}","gists_url":"https://api.github.com/users/tribals/gists{/gist_id}","starred_url":"https://api.github.com/users/tribals/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tribals/subscriptions","organizations_url":"https://api.github.com/users/tribals/orgs","repos_url":"https://api.github.com/users/tribals/repos","events_url":"https://api.github.com/users/tribals/events{/privacy}","received_events_url":"https://api.github.com/users/tribals/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/573697566","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/5086#issuecomment-573697566","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5086","id":573697566,"node_id":"MDEyOklzc3VlQ29tbWVudDU3MzY5NzU