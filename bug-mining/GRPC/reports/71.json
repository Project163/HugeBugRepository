nts_url":"https://api.github.com/users/veblush/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":2,"created_at":"2023-05-17T11:42:52Z","updated_at":"2023-06-05T01:04:23Z","closed_at":"2023-06-05T01:04:22Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Seeing some false sharing problems in \"struct grpc_completion_queue\". \r\n\r\nThe following is how I identified the problems:\r\n1. sudo -E ./run_performance_tests.py -l c++ --category scalable -r cpp_protobuf_async_streaming_qps_unconstrained_1cq_secure\r\n2. Run \"perf c2c record  -a -u --ldlat 50 -p $PID -F 2000 -- sleep 10\" while the command above is running.\r\n3. sudo perf c2c report -NN -g --call-graph --full-symbols -c pid,iaddr --stdio > perf_report.txt\r\n\r\nBelow is the output of \"perf c2c report\". There are HITMs (Hit modified cache line) at offset 0x0, 0x8, 0x10 and 0x18 of the same cacheline 0x7fff50011d40. It means that there are some false sharings in \"struct grpc_completion_queue\". I guess we can see some performance improvement if adding some padding in that struct.\r\n<img width=\"945\" alt=\"image\" src=\"https://github.com/grpc/grpc/assets/51774176/a9095301-dd38-4483-9622-35af652b8703\">\r\n<img width=\"943\" alt=\"image\" src=\"https://github.com/grpc/grpc/assets/51774176/ae937fd8-44ca-4354-9d8b-6355063c632d\">\r\n","closed_by":{"login":"LeiW000","id":51774176,"node_id":"MDQ6VXNlcjUxNzc0MTc2","avatar_url":"https://avatars.githubusercontent.com/u/51774176?v=4","gravatar_id":"","url":"https://api.github.com/users/LeiW000","html_url":"https://github.com/LeiW000","followers_url":"https://api.github.com/users/LeiW000/followers","following_url":"https://api.github.com/users/LeiW000/following{/other_user}","gists_url":"https://api.github.com/users/LeiW000/gists{/gist_id}","starred_url":"https://api.github.com/users/LeiW000/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LeiW000/subscriptions","organizations_url":"https://api.github.com/users/LeiW000/orgs","repos_url":"https://api.github.com/users/LeiW000/repos","events_url":"https://api.github.com/users/LeiW000/events{/privacy}","received_events_url":"https://api.github.com/users/LeiW000/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/grpc/grpc/issues/33157/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/grpc/grpc/issues/33157/timeline","performed_via_github_app":null,"state_reason":"completed"}