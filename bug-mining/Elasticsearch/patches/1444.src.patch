+                if (counter.decrementAndGet() == 0) {
+                    finishHim();
+                }
+            }
+        }
+    }
+
+    void executePhase(final int shardIndex, DiscoveryNode node, final long searchId) {
+        InternalScrollSearchRequest internalRequest = internalScrollSearchRequest(searchId, request);
