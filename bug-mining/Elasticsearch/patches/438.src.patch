+                .addHighlightedField(new HighlightBuilder.Field("highlight_field")
+                        .fragmentSize(-1).numOfFragments(1).fragmenter("simple"))
+                .execute().actionGet();
+        assertThat(response.getHits().hits()[0].highlightFields().isEmpty(), equalTo(true));
