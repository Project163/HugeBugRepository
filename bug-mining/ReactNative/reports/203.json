Request={this.onShouldStartLoadWithRequest}\r\n          onNavigationStateChange={this.onShouldStartLoadWithRequest}\r\n          injectedJavaScript={patchPostMessageJsCode}\r\n          useWebKit={true}\r\n          />\r\n```\r\n\r\nI am not sure why this file doesn't work on react native.\r\nAny help are appreciated.\r\n","closed_by":{"login":"dulmandakh","id":178494,"node_id":"MDQ6VXNlcjE3ODQ5NA==","avatar_url":"https://avatars.githubusercontent.com/u/178494?v=4","gravatar_id":"","url":"https://api.github.com/users/dulmandakh","html_url":"https://github.com/dulmandakh","followers_url":"https://api.github.com/users/dulmandakh/followers","following_url":"https://api.github.com/users/dulmandakh/following{/other_user}","gists_url":"https://api.github.com/users/dulmandakh/gists{/gist_id}","starred_url":"https://api.github.com/users/dulmandakh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dulmandakh/subscriptions","organizations_url":"https://api.github.com/users/dulmandakh/orgs","repos_url":"https://api.github.com/users/dulmandakh/repos","events_url":"https://api.github.com/users/dulmandakh/events{/privacy}","received_events_url":"https://api.github.com/users/dulmandakh/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/facebook/react-native/issues/24251/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/facebook/react-native/issues/24251/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}