                                    <reporter username="sboikov">Semen Boikov</reporter>
                        <labels>
                    </labels>
                <created>Wed, 12 Dec 2018 18:11:47 +0000</created>
                <updated>Thu, 13 Dec 2018 06:50:55 +0000</updated>
                            <resolved>Thu, 13 Dec 2018 06:50:55 +0000</resolved>
                                    <version>2.7</version>
