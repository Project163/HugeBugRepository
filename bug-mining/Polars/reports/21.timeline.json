s","repos_url":"https://api.github.com/users/gab23r/repos","events_url":"https://api.github.com/users/gab23r/events{/privacy}","received_events_url":"https://api.github.com/users/gab23r/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2023-07-24T14:29:10Z","label":{"name":"python","color":"0052cc"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/pola-rs/polars/issues/comments/1648048717","html_url":"https://github.com/pola-rs/polars/issues/10058#issuecomment-1648048717","issue_url":"https://api.github.com/repos/pola-rs/polars/issues/10058","id":1648048717,"node_id":"IC_kwDOD7gq785iOzpN","user":{"login":"gab23r","id":106454081,"node_id":"U_kgDOBlhcQQ","avatar_url":"https://avatars.githubusercontent.com/u/106454081?v=4","gravatar_id":"","url":"https://api.github.com/users/gab23r","html_url":"https://github.com/gab23r","followers_url":"https://api.github.com/users/gab23r/followers","following_url":"https://api.github.com/users/gab23r/following{/other_user}","gists_url":"https://api.github.com/users/gab23r/gists{/gist_id}","starred_url":"https://api.github.com/users/gab23r/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gab23r/subscriptions","organizations_url":"https://api.github.com/users/gab23r/orgs","repos_url":"https://api.github.com/users/gab23r/repos","events_url":"https://api.github.com/users/gab23r/events{/privacy}","received_events_url":"https://api.github.com/users/gab23r/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-07-24T14:41:28Z","updated_at":"2023-07-24T14:41:28Z","body":"If it helps for debugging, the issue is resolved if I had `pl.all_horizontal`\r\n```\r\n(\r\n    ids\r\n    .join(filters, how='left', on = 'id')\r\n    .filter(pl.all_horizontal(pl.col('filter').fill_null(True)))\r\n    .collect()\r\n    .to_dict(False)['id']\r\n)\r\n```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/pola-rs/polars/issues/comments/1648048717/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"gab23r","id":106454081,"node_id":"U_kgDOBlhcQQ","avatar_url":"https://avatars.githubusercontent.com/u/106454081?v=4","gravatar_id":"","url":"https://api.github.com/users/gab23r","html_url":"https://github.com/gab23r","followers_url":"https://api.github.com/users/gab23r/followers","following_url":"https://api.github.com/users/gab23r/following{/other_user}","gists_url":"https://api.github.com/users/gab23r/gists{/gist_id}","starred_url":"https://api.github.com/users/gab23r/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gab23r/subscriptions","organizations_url":"https://api.github.com/users/gab23r/orgs","repos_url":"https://api.github.com/users/gab23r/repos","events_url":"https://api.github.com/users/gab23r/events{/privacy}","received_events_url":"https://api.github.com/users/gab23r/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/pola-rs/polars/issues/comments/1649426492","html_url":"https://github.com/pola-rs/polars/issues/10058#issuecomment-1649426492","issue_url":"https://api.github.com/repos/pola-rs/polars/issues/10058","id":1649426492,"node_id":"IC_kwDOD7gq785iUEA8","user":{"login":"rikkaka","id":39625849,"node_id":"MDQ6VXNlcjM5NjI1ODQ5","avatar_url":"https://avatars.githubusercontent.com/u/39625849?v=4","gravatar_id":"","url":"https://api.github.com/users/rikkaka","html_url":"https://github.com/rikkaka","followers_url":"https://api.github.com/users/rikkaka/followers","following_url":"https://api.github.com/users/rikkaka/following{/other_user}","gists_url":"https://api.github.com/users/rikkaka/gists{/gist_id}","starred_url":"https://api.github.com/users/rikkaka/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rikkaka/subscriptions","organizations_url":"https://api.github.com/users/rikkaka/orgs","repos_url":"https://api.github.com/users/rikkaka/repos","events_url":"https://api.github.com/users/rikkaka/events{/privacy}","received_events_url":"https://api.github.com/users/rikkaka/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-07-25T09:05:44Z","updated_at":"2023-07-25T09:09:35Z","body":"You can use `LazyFrame.explain()` for more detail.\r\n```python\r\nids = pl.LazyFrame({\"id\": [0,1,2]})\r\nfilters = pl.LazyFrame({\"id\": [0,1], \"filter\": [True, False]})\r\nids = ids.join(filters, how='left', on = 'id').filter(pl.col('filter').fill_null(True))\r\nprint(ids.explain())\r\n```\r\noutput:\r\n```text\r\nFILTER col(\"filter\").fill_null([true]) FROM\r\nLEFT JOIN:\r\nLEFT PLAN ON: [col(\"id\")]\r\n  DF [\"id\"]; PROJECT */1 COLUMNS; SELECTION: \"None\"\r\nRIGHT PLAN ON: [col(\"id\")]\r\n  DF [\"id\", \"filter\"]; PROJECT */2 COLUMNS; SELECTION: \"col(\\\"filter\\\").fill_null([true])\"\r\nEND LEFT JOIN\r\n```\r\nHere `col(\"filter\").fill_null([true])` is performed before join as the LazyFrame reorganized the work and leads to different results.\r\n\r\nIf we collect before filter:\r\n```python\r\nids = pl.LazyFrame({\"id\": [0,1,2]})\r\nfilters = pl.LazyFrame({\"id\": [0,1], \"filter\": [True, False]})\r\nids = ids.join(filters, how='left', on = 'id')\r\nprint(ids.explain())\r\nids = ids.collect().lazy().filter(pl.col('filter').fill_null(True))\r\nprint(ids.explain())\r\n```\r\noutput:\r\n```text\r\nLEFT JOIN:\r\nLEFT PLAN ON: [col(\"id\")]\r\n  DF [\"id\"]; PROJECT */1 COLUMNS; SELECTION: \"None\"\r\nRIGHT PLAN ON: [col(\"id\")]\r\n  DF [\"id\", \"filter\"]; PROJECT */2 COLUMNS; SELECTION: \"None\"\r\nEND LEFT JOIN\r\nDF [\"id\", \"filter\"]; PROJECT */2 COLUMNS; SELECTION: \"col(\\\"filter\\\").fill_null([true])\"\r\n```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/pola-rs/polars/issues/comments/1649426492/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"rikkaka","id":39625849,"node_id":"MDQ6VXNlcjM5NjI1ODQ5","avatar_url":"https://avatars.githubusercontent.com/u/39625849?v=4","gravatar_id":"","url":"https://api.github.com/users/rikkaka","html_url":"https://github.com/rikkaka","followers_url":"https://api.github.com/users/rikkaka/followers","following_url":"https://api.github.com/users/rikkaka/following{/other_user}","gists_url":"https://api.github.com/users/rikkaka/gists{/gist_id}","starred_url":"https://api.github.com/users/rikkaka/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rikkaka/subscriptions","organizations_url":"https://api.github.com/users/rikkaka/orgs","repos_url":"https://api.github.com/users/rikkaka/repos","events_url":"https://api.github.com/users/rikkaka/events{/privacy}","received_events_url":"https://api.github.com/users/rikkaka/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/pola-rs/polars/issues/comments/1649585823","html_url":"https://github.com/pola-rs/polars/issues/10058#issuecomment-1649585823","issue_url":"https://api.github.com/repos/pola-rs/polars/issues/10058","id":1649585823,"node_id":"IC_kwDOD7gq785iUq6f","user":{"login":"gab23r","id":106454081,"node_id":"U_kgDOBlhcQQ","avatar_url":"https://avatars.githubusercontent.com/u/106454081?v=4","gravatar_id":"","url":"https://api.github.com/users/gab23r","html_url":"https://github.com/gab23r","followers_url":"https://api.github.com/users/gab23r/followers","following_url":"https://api.github.com/users/gab23r/following{/other_user}","gists_url":"https://api.github.com/users/gab23r/gists{/gist_id}","starred_url":"https://api.github.com/users/gab23r/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gab23r/s