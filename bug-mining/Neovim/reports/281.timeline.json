.github.com/repos/neovim/neovim/issues{/number}","pulls_url":"https://api.github.com/repos/neovim/neovim/pulls{/number}","milestones_url":"https://api.github.com/repos/neovim/neovim/milestones{/number}","notifications_url":"https://api.github.com/repos/neovim/neovim/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/neovim/neovim/labels{/name}","releases_url":"https://api.github.com/repos/neovim/neovim/releases{/id}","deployments_url":"https://api.github.com/repos/neovim/neovim/deployments","created_at":"2014-01-31T13:39:22Z","updated_at":"2025-12-13T09:22:08Z","pushed_at":"2025-12-13T05:17:45Z","git_url":"git://github.com/neovim/neovim.git","ssh_url":"git@github.com:neovim/neovim.git","clone_url":"https://github.com/neovim/neovim.git","svn_url":"https://github.com/neovim/neovim","homepage":"https://neovim.io","size":355316,"stargazers_count":94890,"watchers_count":94890,"language":"Vim Script","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":6465,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":2020,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["api","c","lua","neovim","nvim","text-editor","vim"],"visibility":"public","forks":6465,"open_issues":2020,"watchers":94890,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"- `nvim --version`: v0.3.4\r\n- Vim (version: ) behaves differently? Stores the terminal buffer differently in the session file.\r\n- Operating system/version: macOS v10.14.2\r\n- Terminal name/version: kitty v0.13.3\r\n- `$TERM`: xterm-256color\r\n\r\n### Steps to reproduce using `nvim -u NORC`\r\n\r\n```\r\n$ nvim -u NORC\r\n:call termopen('bash -c \"cd '.shellescape(expand('~')).'\"', {})\r\n:mksession!\r\n:qa\r\n$ nvim -u NORC -S Session.vim\r\n```\r\n\r\n### Actual behaviour\r\n\r\nIt will error with the following message:\r\n\r\n```\r\nError detected while processing /Users/rrethy/.local/share/nvim/site/pack/sixpack/start/vim-devilish/Session.vim:                                                                               \r\nline   29:                                                                                                                                                                                      \r\nE121: Undefined variable: Users                                                                                                                                                                 \r\nE116: Invalid arguments for function bufexists                                                                                                                                                  \r\nE15: Invalid expression: bufexists('term://.//15639:bash\\ -c\\ \\\"cd\\ \\'/Users/rrethy\\'\\\"') | buffer term://.//15639:bash\\ -c\\ \\\"cd\\ \\'/Users/rrethy\\'\\\" | else | edit term://.//15639:bash\\ -c\\ \\\r\n\"cd\\ \\'/Users/rrethy\\'\\\" | endif                                                                                                                                                                \r\nline   78:                                                                                                                                                                                      \r\nE171: Missing :endif \r\n```\r\n\r\nThe two `'` inside the terminal buffer name (due to the command used) are escaped with `\\` while they should be escaped with `'`. The following is the `Session.vim`:\r\n\r\n```vim\r\nlet SessionLoad = 1\r\nlet s:so_save = &so | let s:siso_save = &siso | set so=0 siso=0\r\nlet v:this_session=expand(\"<sfile>:p\")\r\nsilent only\r\ncd ~/.local/share/nvim/site/pack/sixpack/start/vim-devilish\r\nif expand('%') == '' && !&modified && line('$') <= 1 && getline(1) == ''\r\n  let s:wipebuf = bufnr('%')\r\nendif\r\nset shortmess=aoO\r\nbadd +1 term://.//23212:bash\\ -c\\ \\\"cd\\ \\'/Users/rrethy\\'\\\"\r\nargglobal\r\nsilent! argdel *\r\nset splitbelow splitright\r\nset nosplitbelow\r\nset nosplitright\r\nwincmd t\r\nset winminheight=0\r\nset winheight=1\r\nset winminwidth=0\r\nset winwidth=1\r\nargglobal\r\nif bufexists('term://.//23212:bash\\ -c\\ \\\"cd\\ \\'/Users/rrethy\\'\\\"') | buffer term://.//23212:bash\\ -c\\ \\\"cd\\ \\'/Users/rrethy\\'\\\" | else | edit term://.//23212:bash\\ -c\\ \\\"cd\\ \\'/Users/rrethy\\'\\\" | endif\r\nsetlocal fdm=manual\r\nsetlocal fde=0\r\nsetlocal fmr={{{,}}}\r\nsetlocal fdi=#\r\nsetlocal fdl=0\r\nsetlocal fml=1\r\nsetlocal fdn=20\r\nsetlocal fen\r\nlet s:l = 1 - ((0 * winheight(0) + 21) / 42)\r\nif s:l < 1 | let s:l = 1 | endif\r\nexe s:l\r\nnormal! zt\r\n1\r\nnormal! 0\r\ntabnext 1\r\nif exists('s:wipebuf') && getbufvar(s:wipebuf, '&buftype') isnot# 'terminal'\r\n  silent exe 'bwipe ' . s:wipebuf\r\nendif\r\nunlet! s:wipebuf\r\nset winheight=1 winwidth=20 winminheight=1 winminwidth=1 shortmess=filnxtToOF\r\nlet s:sx = expand(\"<sfile>:p:r\").\"x.vim\"\r\nif file_readable(s:sx)\r\n  exe \"source \" . fnameescape(s:sx)\r\nendif\r\nlet &so = s:so_save | let &siso = s:siso_save\r\ndoautoall SessionLoadPost\r\nunlet SessionLoad\r\n\" vim: set ft=vim :\r\n```\r\n\r\nLine 22 should instead be\r\n\r\n```vim\r\nif bufexists('term://.//21553:bash\\ -c\\ \\\"cd\\ \\''/Users/rrethy\\''\\\"') | buffer term://.//21553:bash\\ -c\\ \\\"cd\\ \\'/Users/rrethy\\'\\\" | else | edit term://.//21553:bash\\ -c\\ \\\"cd\\ \\'/Users/rrethy\\'\\\" | endif\r\n```\r\n\r\n### Expected behaviour\r\n\r\nIt would not error, instead it would read the session file and open the terminal buffer appropriately.","reactions":{"url":"https://api.github.com/repos/neovim/neovim/issues/9913/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/neovim/neovim/issues/9913/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]