+}
+
+void ThunkSequence::Append(ThunkSequence other) {
+  reserve(size() + other.size());
+  for (auto& thunk : other) {
+    push_back(std::move(thunk));
+  }
+}
+
+absl::Status ThunkSequence::Execute(const Thunk::ExecuteParams& params) {
