[{"id":8449972287,"node_id":"LE_lADOAGuhRc5dwcZRzwAAAAH3qFg_","url":"https://api.github.com/repos/python/mypy/issues/events/8449972287","actor":{"login":"ikonst","id":1186084,"node_id":"MDQ6VXNlcjExODYwODQ=","avatar_url":"https://avatars.githubusercontent.com/u/1186084?v=4","gravatar_id":"","url":"https://api.github.com/users/ikonst","html_url":"https://github.com/ikonst","followers_url":"https://api.github.com/users/ikonst/followers","following_url":"https://api.github.com/users/ikonst/following{/other_user}","gists_url":"https://api.github.com/users/ikonst/gists{/gist_id}","starred_url":"https://api.github.com/users/ikonst/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ikonst/subscriptions","organizations_url":"https://api.github.com/users/ikonst/orgs","repos_url":"https://api.github.com/users/ikonst/repos","events_url":"https://api.github.com/users/ikonst/events{/privacy}","received_events_url":"https://api.github.com/users/ikonst/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2023-02-06T17:27:21Z","label":{"name":"bug","color":"f9d0c4"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/python/mypy/issues/comments/1419510993","html_url":"https://github.com/python/mypy/issues/14622#issuecomment-1419510993","issue_url":"https://api.github.com/repos/python/mypy/issues/14622","id":1419510993,"node_id":"IC_kwDOAGuhRc5UnATR","user":{"login":"erictraut","id":7040122,"node_id":"MDQ6VXNlcjcwNDAxMjI=","avatar_url":"https://avatars.githubusercontent.com/u/7040122?v=4","gravatar_id":"","url":"https://api.github.com/users/erictraut","html_url":"https://github.com/erictraut","followers_url":"https://api.github.com/users/erictraut/followers","following_url":"https://api.github.com/users/erictraut/following{/other_user}","gists_url":"https://api.github.com/users/erictraut/gists{/gist_id}","starred_url":"https://api.github.com/users/erictraut/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/erictraut/subscriptions","organizations_url":"https://api.github.com/users/erictraut/orgs","repos_url":"https://api.github.com/users/erictraut/repos","events_url":"https://api.github.com/users/erictraut/events{/privacy}","received_events_url":"https://api.github.com/users/erictraut/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-02-06T17:57:06Z","updated_at":"2023-02-06T17:57:06Z","body":"The code above (in particular, the signature for function `f`) isn't legal. A `P.args` annotation can be used only within a context where `P` is bound to a scope (a generic function or class), only with a `*args` parameter, and only when paired with a corresponding `**kwargs: P.kwargs` parameter. See PEP 612 for details.\r\n\r\nMypy should flag the illegal use of `P.args` as an error. (That makes this a false negative, not a false positive.)","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/1419510993/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"erictraut","id":7040122,"node_id":"MDQ6VXNlcjcwNDAxMjI=","avatar_url":"https://avatars.githubusercontent.com/u/7040122?v=4","gravatar_id":"","url":"https://api.github.com/users/erictraut","html_url":"https://github.com/erictraut","followers_url":"https://api.github.com/users/erictraut/followers","following_url":"https://api.github.com/users/erictraut/following{/other_user}","gists_url":"https://api.github.com/users/erictraut/gists{/gist_id}","starred_url":"https://api.github.com/users/erictraut/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/erictraut/subscriptions","organizations_url":"https://api.github.com/users/erictraut/orgs","repos_url":"https://api.github.com/users/erictraut/repos","events_url":"https://api.github.com/users/erictraut/events{/privacy}","received_events_url":"https://api.github.com/users/erictraut/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/python/mypy/issues/comments/1419522049","html_url":"https://github.com/python/mypy/issues/14622#issuecomment-1419522049","issue_url":"https://api.github.com/repos/python/mypy/issues/14622","id":1419522049,"node_id":"IC_kwDOAGuhRc5UnDAB","user":{"login":"ikonst","id":1186084,"node_id":"MDQ6VXNlcjExODYwODQ=","avatar_url":"https://avatars.githubusercontent.com/u/1186084?v=4","gravatar_id":"","url":"https://api.github.com/users/ikonst","html_url":"https://github.com/ikonst","followers_url":"https://api.github.com/users/ikonst/followers","following_url":"https://api.github.com/users/ikonst/following{/other_user}","gists_url":"https://api.github.com/users/ikonst/gists{/gist_id}","starred_url":"https://api.github.com/users/ikonst/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ikonst/subscriptions","organizations_url":"https://api.github.com/users/ikonst/orgs","repos_url":"https://api.github.com/users/ikonst/repos","events_url":"https://api.github.com/users/ikonst/events{/privacy}","received_events_url":"https://api.github.com/users/ikonst/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-02-06T18:05:37Z","updated_at":"2023-02-06T18:05:37Z","body":"@erictraut, thanks for jumping in so quickly!\r\n\r\nI've read this in [the docs](https://docs.python.org/3/library/typing.html#typing.ParamSpec)\r\n> P.args represents the tuple of positional parameters in a given call\r\n\r\nand failed to read the rest of it :)\r\n> [...] and should only be used to annotate *args\r\n\r\nIndeed, then it shall be a false negative.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/1419522049/reactions","total_count":0,"+1":0,"-1":0,"laugh