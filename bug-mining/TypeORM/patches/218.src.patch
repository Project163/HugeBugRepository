-                            && dbIndex["TABLE_SCHEMA"] === dbTable["TABLE_SCHEMA"]
-                            && dbIndex["COLUMN_NAME"] === dbColumn["COLUMN_NAME"]
-                            && parseInt(dbIndex["NON_UNIQUE"], 10) === 0
