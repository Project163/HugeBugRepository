+    @Test
+    public void alterTableChangeColumnAndUseIndex() {
+        sql("create table my_table(c1 int, c2 int, c3 int, c4 int)");
+        sql("create index my_index on my_table(c4)");
+
+        for (int i = 0; i < 100; i++)
