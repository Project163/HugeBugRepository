thub.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2020-11-26T16:42:28Z","label":{"name":"question","color":"d876e3"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/734401988","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/5728#issuecomment-734401988","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5728","id":734401988,"node_id":"MDEyOklzc3VlQ29tbWVudDczNDQwMTk4OA==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-11-26T16:49:34Z","updated_at":"2020-11-26T16:49:34Z","body":"hey there -\r\n\r\nCan you share your evidence that the value is an integer?   The test below indicates it is an internal PostgreSQL type called \"xid\" (I would assume transaction id), and it appears to behave more as a string than as an integer.\r\n\r\nGiven:\r\n\r\n```\r\npsql (12.4)\r\nType \"help\" for help.\r\n\r\ntest=> create table foo(id integer);\r\nCREATE TABLE\r\ntest=> insert into foo values(35);\r\nINSERT 0 1\r\n\r\n\r\ntest=> select xmin from foo;\r\n xmin \r\n------\r\n 7178\r\n(1 row)\r\n\r\n```\r\n\r\nthe value successfully casts into VARCHAR, both explicitly and implicitly:\r\n\r\n```\r\ntest=> select xmin::varchar AS \"is it a string?\" from foo;\r\n is it a string? \r\n-----------------\r\n 7178\r\n(1 row)\r\n\r\n\r\ntest=> select xmin || 'it concats, like a string' from foo;\r\n           ?column?            \r\n-------------------------------\r\n 7178it concats, like a string\r\n(1 row)\r\n\r\n```\r\n\r\nhowever it does neither for integer:\r\n\r\n```\r\ntest=> select xmin::int AS \"is it an integer?\" from foo;\r\nERROR:  cannot cast type xid to integer\r\nLINE 1: select xmin::int AS \"is it an integer?\" from foo;\r\n                   ^\r\n\r\n\r\ntest=> select xmin + 35 AS \"it's won't do arithmetic, not an int\" from foo;\r\nERROR:  operator does not exist: xid + integer\r\nLINE 1: select xmin + 35 AS \"it's won't do arithmetic, not an int\" f...\r\n                    ^\r\nHINT:  No operator matches the given name and argument types. You might need to add explicit type casts.\r\n\r\n```\r\n\r\nit seems a safe bet we should change that documentation example to use String for xmin and not integer.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/734401988/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/734409024","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/5728#issuecomment-734409024","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5728","id":734409024,"node_id":"MDEyOklzc3VlQ29tbWVudDczNDQwOTAyNA==","user":{"login":"ghost","id":10137,"node_id":"MDQ6VXNlcjEwMTM3","avatar_url":"https://avatars.githubusercontent.com/u/10137?v=4","gravatar_id":"","url":"https://api.github.com/users/ghost","html_url":"https://github.com/ghost","followers_url":"https://api.github.com/users/ghost/followers","following_url":"https://api.github.com/users/ghost/following{/other_user}","gists_url":"https://api.github.com/users/ghost/gists{/gist_id}","starred_url":"https://api.github.com/users/ghost/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ghost/subscriptions","organizations_url":"https://api.github.com/users/ghost/orgs","repos_url":"https://api.github.com/users/ghost/repos","events_url":"https://api.github.com/users/ghost/events{/privacy}","received_events_url":"https://api.github.com/users/ghost/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-11-26T17:07:33Z","updated_at":"2020-11-26T17:07:33Z","body":"Hi,\r\n\r\nI just did a quick query (`SELECT xmin FROM some_table WHERE ...`) and assumed the result was an int since it looked like one.  Forgetting that in `psql` string results render just like the same as ints (I don't have to use direct SQL that often anymore, I'm blaming ORMs for that ;) ).\r\n\r\nBesides that, https://www.postgresql.org/docs/9.6/ddl-system-columns.html talks about a \"transaction ID\" and I also assumed that was talking about integers (combined with the SQLAlchemy documentation example also using integers), together with me vaguely remembering us hitting an internal Postgres integer max on transaction IDs many years before.\r\n\r\nHence the safe-guards in my initial report on this :)\r\n\r\n> it seems a safe bet we should change that documentation example to use String for xmin and not integer.\r\n\r\nI agree, especially considering your tests (even *if* Postgres may use an int internally, if it's presented like a string to clients it makes sense to me if SQLAlchemy and the docs do so as well).","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/734409024/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ghost","id":10137,"node_id":"MDQ6VXNlcjEwMTM3","avatar_url":"https://avatars.githubusercontent.com/u/10137?v=4","gravatar_id":"","url":"https://api.github.com/users/ghost","html_url":"https://github.com/ghost","followers_url":"https://api.github.com/users/ghost/followers","following_url":"https://api.github.com/users/ghost/following{/other_user}","gists_url":"https://api.github.com/users/ghost/gists{/gist_id}","starred_url":"https://api.github.com/users/ghost/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ghost/subscriptions","organizations_url":"https://api.github.com/users/ghost/orgs","repos_url":"https://api.github.com/users/ghost/repos","events_url":"https://api.github.com/users/ghost/events{/privacy}","received_events_url":"https://api.github.com/users/ghost/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/734415797","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/5728#issuecomment-734415797","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/5728","id":734415797,"node_id":"MDEyOklzc3VlQ29tbWVudDczNDQxNTc5Nw==","user":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-11-26T17:25:45Z","updated_at":"2020-11-26T17:25:45Z","body":"same all around, it looked like a number so certainly that's why I put Integer there also, will change it now.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalche