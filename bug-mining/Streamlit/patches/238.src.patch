+import streamlit as st
+
+
+@st.fragment
+def show_page():
+    checkmark = st.checkbox("Yes or No")
+
+    if checkmark:
+        st.tabs(["Tab A", "Tab B", "Tab C"])
+    else:
+        st.tabs(["Tab 1", "Tab 2"])
+
+
+show_page()
diff --git a/e2e_playwright/st_fragment_dynamic_containers_test.py b/e2e_playwright/st_fragment_dynamic_containers_test.py
