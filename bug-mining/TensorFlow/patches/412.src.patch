+  def testEmbeddingLayerInFunction(self):
+
+    class M(tf.keras.Model):
+
+      def __init__(self):
+        super(M, self).__init__()
+        self.embed = tf.keras.layers.Embedding(5, 1)
+        self.proj = tf.keras.layers.Dense(1)
+
+      @tf.function
+      def call(self, x):
