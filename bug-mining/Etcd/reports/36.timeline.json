commits_url":"https://api.github.com/repos/etcd-io/etcd/commits{/sha}","git_commits_url":"https://api.github.com/repos/etcd-io/etcd/git/commits{/sha}","comments_url":"https://api.github.com/repos/etcd-io/etcd/comments{/number}","issue_comment_url":"https://api.github.com/repos/etcd-io/etcd/issues/comments{/number}","contents_url":"https://api.github.com/repos/etcd-io/etcd/contents/{+path}","compare_url":"https://api.github.com/repos/etcd-io/etcd/compare/{base}...{head}","merges_url":"https://api.github.com/repos/etcd-io/etcd/merges","archive_url":"https://api.github.com/repos/etcd-io/etcd/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/etcd-io/etcd/downloads","issues_url":"https://api.github.com/repos/etcd-io/etcd/issues{/number}","pulls_url":"https://api.github.com/repos/etcd-io/etcd/pulls{/number}","milestones_url":"https://api.github.com/repos/etcd-io/etcd/milestones{/number}","notifications_url":"https://api.github.com/repos/etcd-io/etcd/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/etcd-io/etcd/labels{/name}","releases_url":"https://api.github.com/repos/etcd-io/etcd/releases{/id}","deployments_url":"https://api.github.com/repos/etcd-io/etcd/deployments","created_at":"2013-07-06T21:57:21Z","updated_at":"2025-12-13T00:56:38Z","pushed_at":"2025-12-12T12:13:25Z","git_url":"git://github.com/etcd-io/etcd.git","ssh_url":"git@github.com:etcd-io/etcd.git","clone_url":"https://github.com/etcd-io/etcd.git","svn_url":"https://github.com/etcd-io/etcd","homepage":"https://etcd.io","size":93446,"stargazers_count":50971,"watchers_count":50971,"language":"Go","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":10239,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":204,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cncf","consensus","database","distributed-database","distributed-systems","etcd","go","key-value","kubernetes","raft"],"visibility":"public","forks":10239,"open_issues":204,"watchers":50971,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"The following code hangs forever. If you comment out the `Username` and `Password` lines it fails after one second and correctly reports \"connection refused\" as expected.\r\n```package main\r\n\r\nimport (\r\n        \"time\"\r\n\r\n        \"github.com/coreos/etcd/clientv3\"\r\n)\r\n\r\nfunc main() {\r\n        _, err := clientv3.New(\r\n                clientv3.Config{\r\n                        Endpoints:   []string{\"localhost:12345\"}, // nothing is listening here\r\n                        DialTimeout: 1 * time.Second,\r\n                        Username:    \"someone\",\r\n                        Password:    \"special\",\r\n                },\r\n        )\r\n        if err != nil {\r\n                panic(err)\r\n        }\r\n}\r\n```\r\n\r\nAnother way to observe the bug:\r\n```\r\n# hangs forever\r\nETCDCTL_API=3 /usr/local/etcd-v3.1.5-linux-amd64/etcdctl --endpoints=localhost:12345 --user=someone:special get /foo\r\n```\r\nIf you remove the `--user` flag it exists after 2 seconds and reports \"timed out when dialing\".\r\n\r\nThis bug came up because we turned on auth in our cluster and now go clients hang when one or more of the endpoints are down. The desired behavior is that they will use one of the still working endpoints or produce a timeout error if no endpoints are up.\r\n","reactions":{"url":"https://api.github.com/repos/etcd-io/etcd/issues/7747/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/etcd-io/etcd/issues/7747/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]