[{"url":"https://api.github.com/repos/pylint-dev/pylint/issues/comments/163172427","html_url":"https://github.com/pylint-dev/pylint/issues/117#issuecomment-163172427","issue_url":"https://api.github.com/repos/pylint-dev/pylint/issues/117","id":163172427,"node_id":"MDEyOklzc3VlQ29tbWVudDE2MzE3MjQyNw==","user":{"login":"pylint-bot","id":16198247,"node_id":"MDQ6VXNlcjE2MTk4MjQ3","avatar_url":"https://avatars.githubusercontent.com/u/16198247?v=4","gravatar_id":"","url":"https://api.github.com/users/pylint-bot","html_url":"https://github.com/pylint-bot","followers_url":"https://api.github.com/users/pylint-bot/followers","following_url":"https://api.github.com/users/pylint-bot/following{/other_user}","gists_url":"https://api.github.com/users/pylint-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/pylint-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pylint-bot/subscriptions","organizations_url":"https://api.github.com/users/pylint-bot/orgs","repos_url":"https://api.github.com/users/pylint-bot/repos","events_url":"https://api.github.com/users/pylint-bot/events{/privacy}","received_events_url":"https://api.github.com/users/pylint-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2013-12-17T01:27:28Z","updated_at":"2015-12-09T10:09:00Z","body":"_Original comment by_ **Damien Nozay (BitBucket: [dnozay](http://bitbucket.org/dnozay), GitHub: @dnozay?)**:\n\n---\n\nhere's a fix:\n\n```\n#!python\n\ndef _loop_exits_early(loop):\n    \"\"\"Returns true if a loop has a break statement in its body.\"\"\"\n    loop_nodes = (astroid.For, astroid.While)\n    # Loop over body explicitly to avoid matching break statements\n    # in orelse.\n    for child in loop.body:\n        if isinstance(child, loop_nodes):\n            if child.orelse is None:\n                continue\n            # break statement may be in orelse of child loop.\n            for orelse in child.orelse:\n                for _ in orelse.nodes_of_class(astroid.Break, skip_klass=loop_nodes):\n                    return True\n        for _ in child.nodes_of_class(astroid.Break, skip_klass=loop_nodes):\n            return True\n    return False\n\n```\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/pylint-dev/pylint/issues/comments/163172427/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"pylint-bot","id":16198247,"node_id":"MDQ6VXNlcjE2MTk4MjQ3","avatar_url":"https://avatars.githubusercontent.com/u/16198247?v=4","gravatar_id":"","url":"https://api.github.com/users/pylint-bot","html_url":"https://github.com/pylint-bot","followers_url":"https://api.github.com/users/pylint-bot/followers","following_url":"https://api.github.com/users/pylint-bot/following{/other_user}","gists_url":"https://api.github.com/users/pylint-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/pylint-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pylint-bot/subscriptions","organizations_url":"https://api.github.com/users/pylint-bot/orgs","repos_url":"https://api.github.com/users/pylint-bot/repos","events_url":"https://api.github.com/users/pylint-bot/events{/privacy}","received_events_url":"https://api.github.com/users/pylint-bot/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/pylint-dev/pylint/issues/comments/163172428","html_url":"https://github.com/pylint-dev/pylint/issues/117#issuecomment-163172428","issue_url":"https://api.github.com/repos/pylint-dev/pylint/issues/117","id":163172428,"node_id":"MDEyOklzc3VlQ29tbWVudDE2MzE3MjQyOA==","user":{"login":"pylint-bot","id":16198247,"node_id":"MDQ6VXNlcjE2MTk4MjQ3","avatar_url":"https://avatars.githubusercontent.com/u/16198247?v=4","gravatar_id":"","url":"https://api.github.com/users/pylint-bot","html_url":"ht