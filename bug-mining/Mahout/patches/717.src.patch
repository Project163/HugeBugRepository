-    implicit val ktag = op.keyClassTag
-
-    val ewOps = getEWOps()
-    val opId = op.op
-    val ncol = op.ncol
-
-    val reduceFunc = opId match {
-      case "+" => ewOps.plus
-      case "-" => ewOps.minus
-      case "*" => ewOps.hadamard
-      case "/" => ewOps.eldiv
-      case default => throw new IllegalArgumentException("Unsupported elementwise operator:%s.".format(opId))
