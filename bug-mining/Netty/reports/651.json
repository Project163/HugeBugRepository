ception occurs, perhaps in the finally block on line 803.\r\n\r\nI only noticed this randomly while helping a coworker to track down an unrelated issue, so it's not like I've actually seen this leak happen.","closed_by":{"login":"Anon43590","id":33058791,"node_id":"MDQ6VXNlcjMzMDU4Nzkx","avatar_url":"https://avatars.githubusercontent.com/u/33058791?v=4","gravatar_id":"","url":"https://api.github.com/users/Anon43590","html_url":"https://github.com/Anon43590","followers_url":"https://api.github.com/users/Anon43590/followers","following_url":"https://api.github.com/users/Anon43590/following{/other_user}","gists_url":"https://api.github.com/users/Anon43590/gists{/gist_id}","starred_url":"https://api.github.com/users/Anon43590/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Anon43590/subscriptions","organizations_url":"https://api.github.com/users/Anon43590/orgs","repos_url":"https://api.github.com/users/Anon43590/repos","events_url":"https://api.github.com/users/Anon43590/events{/privacy}","received_events_url":"https://api.github.com/users/Anon43590/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/netty/netty/issues/7337/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/netty/netty/issues/7337/timeline","performed_via_github_app":null,"state_reason":"completed"}