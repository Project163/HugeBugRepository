\n  Logger logger;\r\n\r\n\r\n  @GET\r\n  public Uni<String> endpoint() {\r\n    logger.info(\"Api called\");\r\n    return Uni.createFrom().item(\"Hello\");\r\n  }\r\n}\r\n```\r\nCalled with:\r\n```\r\necho -en \"GET / HTTP/1.1\\r\\nHost: localhost\\r\\n\\r\\nGET / HTTP/1.1\\r\\nHost: localhost\\r\\n\\r\\n\" | nc localhost 8080\r\n```\r\nUnfortunately its not consistent so I can't say for sure","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/1113102582/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"RuggeroDAlo","id":51959308,"node_id":"MDQ6VXNlcjUxOTU5MzA4","avatar_url":"https://avatars.githubusercontent.com/u/51959308?v=4","gravatar_id":"","url":"https://api.github.com/users/RuggeroDAlo","html_url":"https://github.com/RuggeroDAlo","followers_url":"https://api.github.com/users/RuggeroDAlo/followers","following_url":"https://api.github.com/users/RuggeroDAlo/following{/other_user}","gists_url":"https://api.github.com/users/RuggeroDAlo/gists{/gist_id}","starred_url":"https://api.github.com/users/RuggeroDAlo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RuggeroDAlo/subscriptions","organizations_url":"https://api.github.com/users/RuggeroDAlo/orgs","repos_url":"https://api.github.com/users/RuggeroDAlo/repos","events_url":"https://api.github.com/users/RuggeroDAlo/events{/privacy}","received_events_url":"https://api.github.com/users/RuggeroDAlo/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/1114524562","html_url":"https://github.com/quarkusio/quarkus/issues/25229#issuecomment-1114524562","issue_url":"https://api.github.com/repos/quarkusio/quarkus/issues/25229","id":1114524562,"node_id":"IC_kwDOCFbutM5CbkuS","user":{"login":"geoand","id":4374975,"node_id":"M