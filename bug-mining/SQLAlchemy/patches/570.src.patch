+
+        def scalar(q):
+            return [x for x, in q]
+
+        eq_(
+            scalar(session.query(Employee.employee_id)),
+            [m1id, e1id, e2id]
+        )
+
+        eq_(
+            scalar(session.query(Engineer.employee_id)),
