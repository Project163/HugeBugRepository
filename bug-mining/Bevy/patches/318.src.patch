+    #[rustfmt::skip]
+    struct DefaultGenericWithWhereNoTrailingComma<T>
+        where
+            T: Clone
+    {
+        foo: Option<T>,
+        #[reflect(ignore)]
+        _ignored: NonReflectNonDefault,
+    }
+
+    impl<T> Default for DefaultGenericWithWhereNoTrailingComma<T>
