 get active item. i.e: https://nextjs.org/docs/app/building-your-application/routing/linking-and-navigating#checking-active-links is not working as in the example, since the usePathname returns the path with basepath, but the configs dont. so you need to add basepath to every compare.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1581138725/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Inoir","id":5294072,"node_id":"MDQ6VXNlcjUyOTQwNzI=","avatar_url":"https://avatars.githubusercontent.com/u/5294072?v=4","gravatar_id":"","url":"https://api.github.com/users/Inoir","html_url":"https://github.com/Inoir","followers_url":"https://api.github.com/users/Inoir/followers","following_url":"https://api.github.com/users/Inoir/following{/other_user}","gists_url":"https://api.github.com/users/Inoir/gists{/gist_id}","starred_url":"https://api.github.com/users/Inoir/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Inoir/subscriptions","organizations_url":"https://api.github.com/users/Inoir/orgs","repos_url":"https://api.github.com/users/Inoir/repos","events_url":"https://api.github.com/users/Inoir/events{/privacy}","received_events_url":"https://api.github.com/users/Inoir/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1621711563","html_url":"https://github.com/vercel/next.js/issues/46562#issuecomment-1621711563","issue_url":"https://api.github.com/repos/vercel/next.js/issues/46562","id":1621711563,"node_id":"IC_kwDOBC3Cis5gqVrL","user":{"login":"joshuajaco","id":31038284,"node_id":"MDQ6VXNlcjMxMDM4Mjg0","avatar_url":"https://avatars.githubusercontent.com/u/31038284?v=4","gravatar_id":"","url":"https://api.github.com/users/joshuajaco","html_url":"https://github.com/joshuajaco","followers_url":"https://api.github.com/users/joshuajaco/followers","following_url":"https://api.github.com/users/joshuajaco/following{/other_user}","gists_url":"https://api.github.com/users/joshuajaco/gists{/gist_id}","starred_url":"https://api.github.com/users/joshuajaco/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joshuajaco/subscriptions","organizations_url":"https://api.github.com/users/joshuajaco/orgs","repos_url":"https://api.github.com/users/joshuajaco/repos","events_url":"https://api.github.com/users/joshuajaco/events{/privacy}","received_events_url":"https://api.github.com/users/joshuajaco/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-07-05T13:00:25Z","updated_at":"2023-07-05T20:50:45Z","body":"We are also currently experiencing this issue. Is there an update on this?\r\nOur current workaround is to compare both with and without basepath:\r\n\r\n```tsx\r\nconst pathname = usePathname();\r\n\r\nreturn (\r\n  <div>\r\n    {NAV_LINKS.map(({ label, path }) => (\r\n      <Link\r\n        key={path}\r\n        href={path}\r\n        $active={\r\n          pathname.startsWith(path) || pathname.startsWith(basePath + path)\r\n        }\r\n      >\r\n        {label}\r\n      </Link>\r\n    ))}\r\n  </div>\r\n);\r\n```\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1621711563/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"joshuajaco","id":31038284,"node_id":"MDQ6VXNlcjMxMDM4Mjg0","avatar_url":"https://avatars.githubusercontent.com/u/31038284?v=4","gravatar_id":"","url":"https://api.github.com/users/joshuajaco","html_url":"https://github.com/joshuajaco","followers_url":"https://api.github.com/users/joshuajaco/followers","following_url":"https://api.github.com/users/joshuajaco/following{/other_user}","gists_url":"https://api.github.com/users/joshuajaco/gists{/gist_id}","starred_url":"https://api.github.com/users/joshuajaco/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joshuajaco/subscriptions","organizations_url":"https://api.github.com/users/joshuajaco/orgs","repos_url":"https://api.github.com/users/joshuajaco/repos","events_url":"https://api.github.com/users/joshuajaco/events{/privacy}","received_events_url":"https://api.github.com/users/joshuajaco/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1646265915","html_url":"https://github.com/vercel/next.js/issues/46562#issuecomment-1646265915","issue_url":"https://api.github.com/repos/vercel/next.js/issues/46562","id":1646265915,"node_id":"IC_kwDOBC3Cis5iIAY7","user":{"login":"ammmze","id":203336,"node_id":"MDQ6VXNlcjIwMzMzNg==","avatar_url":"https://avatars.githubusercontent.com/u/203336?v=4","gravatar_id":"","url":"https://api.github.com/users/ammmze","html_url":"https://github.com/ammmze","followers_url":"https://api.github.com/users/ammmze/followers","following_url":"https://api.github.com/users/ammmze/following{/other_user}","gists_url":"https://api.github.com/users/ammmze/gists{/gist_id}","starred_url":"https://api.github.com/users/ammmze/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ammmze/subscriptions","organizations_url":"https://api.github.com/users/ammmze/orgs","repos_url":"https://api.github.com/users/ammmze/repos","events_url":"https://api.github.com/users/ammmze/events{/privacy}","received_events_url":"https://api.github.com/users/ammmze/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-07-21T21:42:13Z","updated_at":"2023-07-21T21:42:13Z","body":"My workaround for now is setting a `NEXT_PUBLIC_BASE_PATH` environment variable and then using a wrapper hook like this:\r\n\r\n```ts\r\nimport { usePathname as useNextPathname } from 'next/navigation';\r\n\r\n/**\r\n * Retrieves the current url pathname, **from the base path**.\r\n * Note: This is used as a workaround because the current implementation of `usePathname` from NextJS is inconsistent\r\n * in scenarios where the application is running with a \"basePath\" that is not the root. In this scenario, on the\r\n * server side `usePathname` would return the path after the base path but on the client side, it would result in the\r\n * path including the base path. This in turn could cause the application to rehydrate improperly and trigger errors\r\n * when the page hydrates in the browser. See: https://github.com/vercel/next.js/issues/46562\r\n */\r\nexport function usePathname(): string | null {\r\n    let pathname = useNextPathname();\r\n    if (pathname && process?.env?.NEXT_PUBLIC_BASE_PATH && pathname.startsWith(process.env.NEXT_PUBLIC_BASE_PATH)) {\r\n        pathname = pathname.substring(process.env.NEXT_PUBLIC_BASE_PATH.length);\r\n        return pathname === '' ? '/' : pathname;\r\n    }\r\n    return pathname;\r\n}\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/1646265915/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ammmze","id":203336,"node_id":"MDQ6VXNlcjIwMzMzNg==","avatar_url":"https://avatars.githubusercontent.com/u/203336?v=4","gravatar_id":"","url":"https://api.github.com/users/ammmze","html_url":"https://github.com/ammmze","followers_url":"https://api.github.com/users/ammmze/followers","following_url":"https://api.github.com/users/ammmze/following{/other_user}","gists_url":"https://api.github.com/users/ammmze/gists{/gist_id}","starred_url":"https://api.github.com/users/ammmze/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ammmze/subscriptions","organizations_url":"https:/