thub.com/users/myang2021/events{/privacy}","received_events_url":"https://api.github.com/users/myang2021/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2025-05-07T23:01:42Z","updated_at":"2025-05-29T20:41:13Z","closed_at":"2025-05-29T20:41:13Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Jira Link: [DB-16589](https://yugabyte.atlassian.net/browse/DB-16589)\r\n### Description\n\n\n```\nCREATE OR REPLACE FUNCTION foo(amount INT) RETURNS VOID AS\n$$\n  UPDATE pg_yb_catalog_version SET current_version = current_version + amount WHERE db_oid = 1;\n$$ LANGUAGE SQL;\nCREATE FUNCTION\nSET enable_seqscan = off;\nSET\nSET yb_non_ddl_txn_for_sys_tables_allowed=1;\nSET\nSELECT foo(null);\n foo \n-----\n \n(1 row)\n\nSELECT * FROM pg_yb_catalog_version WHERE db_oid = 1;\n db_oid | current_version | last_breaking_version \n--------+-----------------+-----------------------\n      1 |                 |                     1\n(1 row)\n```\n\nThe bug is that we were able to insert a NULL value into the `current_version` column\nwhich has a not null constraint:\n\n```\nyugabyte=# \\d pg_yb_catalog_version;\n            Table \"pg_catalog.pg_yb_catalog_version\"\n        Column         |  Type  | Collation | Nullable | Default \n-----------------------+--------+-----------+----------+---------\n db_oid                | oid    |           | not null | \n current_version       | bigint |           | not null | \n last_breaking_version | bigint |           | not null | \nIndexes:\n    \"pg_yb_catalog_version_db_oid_index\" PRIMARY KEY, lsm (db_oid ASC), tablespace \"pg_global\"\nTablespace: \"pg_global\"\n\n```\n\n\n\n### Issue Type\n\nkind/bug\n\n### Warning: Please confirm that this issue does not contain any sensitive information\n\n- [x] I confirm this issue does not contain any sensitive information.\n\n[DB-16589]: https://yugabyte.atlassian.net/browse/DB-16589?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","closed_by":{"login":"myang2021","id":79478033,"node_id":"MDQ6VXNlcjc5NDc4MDMz","avatar_url":"https://avatars.githubusercontent.com/u/79478033?v=4","gravatar_id":"","url":"https://api.github.com/users/myang2021","html_url":"https://github.com/myang2021","followers_url":"https://api.github.com/users/myang2021/followers","following_url":"https://api.github.com/users/myang2021/following{/other_user}","gists_url":"https://api.github.com/users/myang2021/gists{/gist_id}","starred_url":"https://api.github.com/users/myang2021/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/myang2021/subscriptions","organizations_url":"https://api.github.com/users/myang2021/orgs","repos_url":"https://api.github.com/users/myang2021/repos","events_url":"https://api.github.com/users/myang2021/events{/privacy}","received_events_url":"https://api.github.com/users/myang2021/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/27103/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/27103/timeline","performed_via_github_app":null,"state_reason":"completed"}