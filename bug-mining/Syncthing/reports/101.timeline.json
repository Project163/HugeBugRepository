ojects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":4850,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":377,"license":{"key":"mpl-2.0","name":"Mozilla Public License 2.0","spdx_id":"MPL-2.0","url":"https://api.github.com/licenses/mpl-2.0","node_id":"MDc6TGljZW5zZTE0"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":true,"topics":["go","p2p","peer-to-peer","synchronization"],"visibility":"public","forks":4850,"open_issues":377,"watchers":78227,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Problems with disc space like  #302\n\nTested on:\n- Syncthing version v0.11.6.\n- Node 1: linux amd64 with 100GB disc space.\n- Node 2: linux arm with 8GB disc space.\n\nSteps:\n1. Setup 2 nodes that syncs without shared files.\n2. Node 1 share one file called 'shareFile' with 10GB size.\n3. Node 2 start to sync and stops (in my case by 81%).\n4. Node 1 delete shared file.\n\nNode 2 don't remove shareFile.tmp that was created by sycthing. It would be great that when syncthing stop by a critical error, all files it tried to sync will remove their temporal files.\n","reactions":{"url":"https://api.github.com/repos/syncthing/syncthing/issues/1890/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/syncthing/syncthing/issues/1890/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"actor":{"login":"hungrywolf27","id":8271455,"node_id":"MDQ6VXNlcjgyNzE0NTU=","avatar_url":"https://avatars.githubusercontent.com/u/8271455?v=4","gravatar_id":"","url":"https://api.github.com/users/hungrywolf27","html_url":"https://github.com/hungrywolf27","followers_url":"https://api.github.com/users/hungrywolf27/followers","following_url":"https://api.github.com/users/hungrywolf27/following