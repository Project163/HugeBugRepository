eceived_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2022-04-19T12:59:25Z","updated_at":"2022-04-20T17:13:26Z","closed_at":"2022-04-20T17:13:26Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Description\r\n\r\nView reloption `use_initdb_acl` exists as a YSQL upgrade helper for views, it should be removed from the reloptions before persisting.\r\nHowever, when doing `CREATE OR REPLACE VIEW`, only the `CREATE` part does the filtering.\r\nExample:\r\n```sql\r\nSET ysql_upgrade_mode TO true;\r\nSET yb_test_system_catalogs_creation TO true;\r\nCREATE OR REPLACE VIEW pg_catalog.test_view WITH (use_initdb_acl = true) AS SELECT 1;\r\nSELECT oid, relname, reloptions FROM pg_class WHERE relname = 'test_view';\r\n--   oid  |  relname  | reloptions\r\n-- -------+-----------+------------\r\n--  13283 | test_view |\r\n-- (1 row)\r\n\r\nCREATE OR REPLACE VIEW pg_catalog.test_view WITH (use_initdb_acl = true) AS SELECT 1;\r\nSELECT oid, relname, reloptions FROM pg_class WHERE relname = 'test_view';\r\n--   oid  |  relname  |      reloptions\r\n-- -------+-----------+-----------------------\r\n--  13283 | test_view | {use_initdb_acl=true}\r\n-- (1 row)\r\n```\r\n","closed_by":{"login":"frozenspider","id":2077017,"node_id":"MDQ6VXNlcjIwNzcwMTc=","avatar_url":"https://avatars.githubusercontent.com/u/2077017?v=4","gravatar_id":"","url":"https://api.github.com/users/frozenspider","html_url":"https://github.com/frozenspider","followers_url":"https://api.github.com/users/frozenspider/followers","following_url":"https://api.github.com/users/frozenspider/following{/other_user}","gists_url":"https://api.github.com/users/frozenspider/gists{/gist_id}","starred_url":"https://api.github.com/users/frozenspider/starred{/owner}