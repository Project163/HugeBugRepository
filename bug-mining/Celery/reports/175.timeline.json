ntents_url":"https://api.github.com/repos/celery/celery/contents/{+path}","compare_url":"https://api.github.com/repos/celery/celery/compare/{base}...{head}","merges_url":"https://api.github.com/repos/celery/celery/merges","archive_url":"https://api.github.com/repos/celery/celery/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/celery/celery/downloads","issues_url":"https://api.github.com/repos/celery/celery/issues{/number}","pulls_url":"https://api.github.com/repos/celery/celery/pulls{/number}","milestones_url":"https://api.github.com/repos/celery/celery/milestones{/number}","notifications_url":"https://api.github.com/repos/celery/celery/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/celery/celery/labels{/name}","releases_url":"https://api.github.com/repos/celery/celery/releases{/id}","deployments_url":"https://api.github.com/repos/celery/celery/deployments","created_at":"2009-04-24T11:31:24Z","updated_at":"2026-03-11T11:08:53Z","pushed_at":"2026-03-10T15:04:28Z","git_url":"git://github.com/celery/celery.git","ssh_url":"git@github.com:celery/celery.git","clone_url":"https://github.com/celery/celery.git","svn_url":"https://github.com/celery/celery","homepage":"https://docs.celeryq.dev","size":36397,"stargazers_count":28268,"watchers_count":28268,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":4989,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":773,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["amqp","python","python-library","python3","queue-tasks","queue-workers","queued-jobs","redis","redis-queue","sqs","sqs-queue","task-manager","task-runner","task-scheduler"],"visibility":"public","forks":4989,"open_issues":773,"watchers":28268,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/celery/celery/pulls/10157","html_url":"https://github.com/celery/celery/pull/10157","diff_url":"https://github.com/celery/celery/pull/10157.diff","patch_url":"https://github.com/celery/celery/pull/10157.patch","merged_at":"2026-03-01T09:47:20Z"},"body":"## Description\n\nThe existing partial examples in the Canvas guide use `add(x, y)`, which is commutative (`add(4, 2) == add(2, 4)`). This makes it unclear whether `delay()` prepends or appends its arguments to the partial signature.\n\nThis adds a `.. note::` with a `subtract` example that makes the prepend behavior obvious:\n\n```python\n>>> partial = subtract.s(10)    # incomplete: second arg only\n>>> partial.delay(30)           # -> subtract(30, 10) = 20\n```\n\nSince subtraction is not commutative, the reader can immediately see that `delay(30)` prepends `30` as the first argument.\n\nFixes #6484","reactions":{"url":"https://api.github.com/repos/celery/celery/issues/10157/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/celery/celery/issues/10157/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/celery/celery/issues/comments/3979272086","html_url":"https://github.com/celery/celery/issues/6484#issuecomment-3979272086","issue_url":"https://api.github.com/repos/celery/celery/issues/6484","id":3979272086,"node_id":"IC_kwDOAALQjM7tLt-W","user":{"login":"Br1an67","id":29810238,"node_id":"MDQ6VXNlcjI5ODEwMjM4","avatar_url":"https://avatars.githubusercontent.com/u/29810238?v=4","gravatar_id":"","url":"https://api.github.com/users/Br1an67","html_url":"https://github.com/Br1an67","followers_url":"https://api.github.com/users/Br1an6