., A]\r\ny: Type[A]\r\nx = y\r\n```\r\n\r\nNote that it shouldn't typecheck in the opposite direction. There is still problem with parameter types, as the comment says, but this isn't the problem I'm trying to fix.\r\n\r\nThis is needed for #2892, but isn't enough (I'll hopefully open another PR).","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/2894/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/mypy/issues/2894/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/python/mypy/issues/comments/281807152","html_url":"https://github.com/python/mypy/issues/2892#issuecomment-281807152","issue_url":"https://api.github.com/repos/python/mypy/issues/2892","id":281807152,"node_id":"MDEyOklzc3VlQ29tbWVudDI4MTgwNzE1Mg==","user":{"login":"miedzinski","id":12597084,"node_id":"MDQ6VXNlcjEyNTk3MDg0","avatar_url":"https://avatars.githubusercontent.com/u/12597084?v=4","gravatar_id":"","url":"https://api.github.com/users/miedzinski","html_url":"https://github.com/miedzinski","followers_url":"https://api.github.com/users/miedzinski/followers","following_url":"https://api.github.com/users/miedzinski/following{/other_user}","gists_url":"https://api.github.com/users/miedzinski/gists{/gist_id}","starred_url":"https://api.github.com/users/miedzinski/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/miedzinski/subscriptions","organizations_url":"https://api.github.com/users/miedzinski/orgs","repos_url":"https://api.github.com/users/miedzinski/repos","events_url":"https://api.github.com/users/miedzinski/events{/privacy}","received_events_url":"https://api.github.com/users/miedzinski/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-02-22T21:18:45Z","updated_at":"2017-02-22T21:32:38Z","body":"Changes to subtyping don't fully fix this. There is another problem:\r\n\r\n```python\r\nfrom typing import Callable, TypeVar\r\nT = TypeVar('T')\r\ndef f(x: Callable[..., T], y: T = None) -> None: return None\r\nclass A: pass\r\nx: Type[A]\r\nf(x)  # E: Argument 1 to \"f\" has incompatible type Type[A]; expected Callable[..., None]\r\ny: A\r\nf(x, y)  # OK\r\n```\r\n(with strict-optional `None` is substituted with `<uninhabited>`)\r\n\r\nI'd like to tackle this.\r\n\r\nedit:\r\nAnother repro\r\n\r\n```python\r\nfrom typing import Callable, Type\r\ndef f(x: Callable[..., T]) -> T: return x()\r\nclass A: pass\r\nx: Type[A]\r\nf(x)  # E: Argument 1 to \"f\" has incompatible type Type[A]; expected Callable[..., None]\r\n```\r\n\r\nBoth examples pass with `Type[Any]`.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/comments/281807152/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"miedzinski","id":12597084,"node_id":"MDQ6VXNlcjEyNTk3MDg0","avatar_url":"https://avatars.githubusercontent.com/u/12597084?v=4","gravatar_id":"","url":"https://api.github.com/users/miedzinski","html_url":"https://github.com/miedzinski","followers_url":"https://api.github.com/users/miedzinski/followers","following_url":"https://api.github.com/users/miedzinski/following{/other_user}","gists_url":"https://api.github.com/users/miedzinski/gists{/gist_id}","starred_url":"https://api.github.com/users/miedzinski/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/miedzinski/subscriptions","organizations_url":"https://api.github.com/users/miedzinski/orgs","repos_url":"https://api.github.com/users/miedzinski/repos","events_url":"https://api.github.com/users/miedzinski/events{/privacy}","received_events_url":"https://api.github.com/users/miedzinski/received_events","type":"User","user_view_type":"public","site_admin":false}},{"acto