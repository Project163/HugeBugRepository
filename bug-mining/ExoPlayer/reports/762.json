i.github.com/users/klhyun/followers","following_url":"https://api.github.com/users/klhyun/following{/other_user}","gists_url":"https://api.github.com/users/klhyun/gists{/gist_id}","starred_url":"https://api.github.com/users/klhyun/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/klhyun/subscriptions","organizations_url":"https://api.github.com/users/klhyun/orgs","repos_url":"https://api.github.com/users/klhyun/repos","events_url":"https://api.github.com/users/klhyun/events{/privacy}","received_events_url":"https://api.github.com/users/klhyun/received_events","type":"User","user_view_type":"public","site_admin":false},"assignees":[{"login":"klhyun","id":59003567,"node_id":"MDQ6VXNlcjU5MDAzNTY3","avatar_url":"https://avatars.githubusercontent.com/u/59003567?v=4","gravatar_id":"","url":"https://api.github.com/users/klhyun","html_url":"https://github.com/klhyun","followers_url":"https://api.github.com/users/klhyun/followers","following_url":"https://api.github.com/users/klhyun/following{/other_user}","gists_url":"https://api.github.com/users/klhyun/gists{/gist_id}","starred_url":"https://api.github.com/users/klhyun/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/klhyun/subscriptions","organizations_url":"https://api.github.com/users/klhyun/orgs","repos_url":"https://api.github.com/users/klhyun/repos","events_url":"https://api.github.com/users/klhyun/events{/privacy}","received_events_url":"https://api.github.com/users/klhyun/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":2,"created_at":"2021-07-13T21:42:40Z","updated_at":"2021-09-20T01:04:35Z","closed_at":"2021-07-21T22:36:21Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"I was using dev-v2 branch and found this\r\n\r\nDuring the buffer stage the player doesn't have the proper aspect ratio, is just a square but the content and view are 16 by 9.\r\n\r\nAfter `Player.STATE_READY` the size is OK.\r\n\r\nI initiate the view layout like this.\r\n\r\n```\r\n            <com.google.android.exoplayer2.ui.PlayerView\r\n                android:id=\"@+id/player_view\"\r\n                android:layout_width=\"match_parent\"\r\n                android:layout_height=\"match_parent\"\r\n                android:focusableInTouchMode=\"false\"\r\n                app:show_buffering=\"always\"\r\n                app:use_artwork=\"false\"\r\n                app:use_controller=\"false\" />\r\n```\r\nThen dinamicly change the view layout to be smaller always keeping the 16 by 9 aspect ratio, that is why I can see it changing from a square to a rectangle, as the view is smaller then the device screen and is above a lighter background.\r\n\r\nI notice this issue after this change https://github.com/google/ExoPlayer/commit/3c97815d55529cbd1f98581fa1a5677af16ceb9e reverting it will solve.\r\n\r\nI made this for testing\r\nhttps://github.com/fgl27/ExoPlayer/commit/39b2ea662a2e5b5685cec032f0be2c6a2cc624dc\r\n\r\nthe result is this\r\n\r\n```\r\nupdateAspectRatio: setPlayer\r\nupdateAspectRatio: width 0 height 0\r\nupdateAspectRatio: onVideoSizeChanged\r\nupdateAspectRatio: width 1920 height 1080\r\n```\r\n\r\nAs we can see `setPlayer` is called before `onVideoSizeChanged` and the sizes are 0 causing the issue, once `onVideoSizeChanged` is called the sizes are OK.\r\n\r\n","closed_by":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ojw28/subscriptions","organizations_url":"https://api.github.com/users/ojw28/orgs","repos_url":"https://api.github.com/users/ojw28/repos","events_url":"https://api.github.com/users/ojw28/events{/privacy}","received_events_url":"https://api.github.com/users/ojw28/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/9189/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/google/ExoPlayer/issues/9189/timeline","performed_via_github_app":null,"state_reason":"completed"}