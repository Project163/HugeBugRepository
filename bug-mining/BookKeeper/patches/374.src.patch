-                      "' within '" + messageId);
-                final String region = remote.substring(0, regionIndx);
-                final long seqId;
-
-
-                try {
-                    seqId = Long.parseLong(remote.substring(regionIndx + 1, remote.length() - 1));
-                } catch (NumberFormatException nfEx){
