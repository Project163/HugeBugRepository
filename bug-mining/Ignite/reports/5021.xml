            &lt;span class=&quot;code-quote&quot;&gt;&quot;dname VARCHAR,\n&quot;&lt;/span&gt; +
            &lt;span class=&quot;code-quote&quot;&gt;&quot;loc VARCHAR,\n&quot;&lt;/span&gt; +
