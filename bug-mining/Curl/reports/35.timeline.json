2-12T23:57:49Z","pushed_at":"2025-12-12T23:57:45Z","git_url":"git://github.com/curl/curl.git","ssh_url":"git@github.com:curl/curl.git","clone_url":"https://github.com/curl/curl.git","svn_url":"https://github.com/curl/curl","homepage":"https://curl.se/","size":124054,"stargazers_count":40144,"watchers_count":40144,"language":"C","has_issues":true,"has_projects":false,"has_downloads":false,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":6982,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":25,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["c","client","curl","ftp","gopher","hacktoberfest","http","https","imaps","ldap","libcurl","library","mqtt","pop3","scp","sftp","transfer-data","transferring-data","user-agent","websocket"],"visibility":"public","forks":6982,"open_issues":25,"watchers":40144,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/curl/curl/pulls/2105","html_url":"https://github.com/curl/curl/pull/2105","diff_url":"https://github.com/curl/curl/pull/2105.diff","patch_url":"https://github.com/curl/curl/pull/2105.patch","merged_at":null},"body":"Related to Issue #1809, where dict-schema URL data returned contained a bunch of extraneous stuff.\r\n\r\nThis is definitely a WIP as I've only just glanced at the code base and developer guidelines for a few short hours. So far, I've drafted a function that replaces characters in the problematic (extraneous) lines with dashes:\r\n```\r\n$ ./src/curl -sSL dict://dict.org/d:yagni:foldoc\r\n----------------------------------------------------------------------------------------------------------------------\r\n-------\r\n----------------------------\r\n------------------------------------------------------------------------------\r\nYou aren't gonna need it\r\nYAGNI\r\n\r\n   <programming> (YAGNI) A motto of {extreme programming} expressing\r\n   the principle that functionality should not be implemented until\r\n   it is needed.  The traditional {waterfall model} makes it\r\n   difficult to add features after the specification has been signed\r\n   off, tempting the specifier to add features that may never be used\r\n   but which take time to program, debug, test and document.\r\n\r\n   (2014-03-27)\r\n\r\n.\r\n---------------------------------------------\r\n----------------------------------------------\r\n```\r\n\r\n\r\n I tried removing the extraneous lines completely, but changing the length of the character array seems to completely abrogate downstream output, presumably because of other processing in `readwrite_data()` -- which handles various situations as it strides through the data, as far as I can tell.\r\n\r\nSome initial thoughts / questions:\r\n- I suspect I won't get away with a single function like this because of the dowstream processing of header data, etc? so the work may have to be split into smaller pieces?\r\n- Is it far too fragile to simply filter lines that start with three digits? I'm guessing there might even be a data structure in the library that is available for checking for specific (transfer protocol) codes more robustly, and with less danger of filtering out content lines proper?!\r\n- I see that there's a mixture of Python / Perl / C stuff in the testsuite -- the C stuff looks like it is a bunch of main() functions wrapped in preprocessor statements; might need a little guidance if I need to touch that eventually; presumably one would want tests that mock various dict protocol inputs and verify that the processed output removes the extraneous lines / data","reactions":{"url":"https://api.github.com/repos/curl/curl/issues/2105/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"