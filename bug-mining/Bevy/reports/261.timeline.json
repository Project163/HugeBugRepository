o}","subscriptions_url":"https://api.github.com/users/kirusfg/subscriptions","organizations_url":"https://api.github.com/users/kirusfg/orgs","repos_url":"https://api.github.com/users/kirusfg/repos","events_url":"https://api.github.com/users/kirusfg/events{/privacy}","received_events_url":"https://api.github.com/users/kirusfg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-03-13T20:29:52Z","updated_at":"2022-03-13T20:29:52Z","body":"I would like to tackle this issue. A minimal example to reproduce would be nice.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1066176559/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"kirusfg","id":32136879,"node_id":"MDQ6VXNlcjMyMTM2ODc5","avatar_url":"https://avatars.githubusercontent.com/u/32136879?v=4","gravatar_id":"","url":"https://api.github.com/users/kirusfg","html_url":"https://github.com/kirusfg","followers_url":"https://api.github.com/users/kirusfg/followers","following_url":"https://api.github.com/users/kirusfg/following{/other_user}","gists_url":"https://api.github.com/users/kirusfg/gists{/gist_id}","starred_url":"https://api.github.com/users/kirusfg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kirusfg/subscriptions","organizations_url":"https://api.github.com/users/kirusfg/orgs","repos_url":"https://api.github.com/users/kirusfg/repos","events_url":"https://api.github.com/users/kirusfg/events{/privacy}","received_events_url":"https://api.github.com/users/kirusfg/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1066179835","html_url":"https://github.com/bevyengine/bevy/issues/4200#issuecomment-1066179835","issue_url":"https://api.github.com/repos/bevyengine/