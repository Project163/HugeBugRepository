@@ -0,0 +1,13 @@
+
+var path = require('path');
+var sorcery = require('sorcery');
+var yargs = require('yargs');
+
+var argv = require('yargs')
+  .alias('f', 'file')
+  .argv;
+
+
+sorcery.load(argv.file).then(function(chain) {
+  chain.write();
+});
