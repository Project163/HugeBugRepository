ps://api.github.com/users/klimov-paul/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":{"url":"https://api.github.com/repos/yiisoft/yii2/milestones/17","html_url":"https://github.com/yiisoft/yii2/milestone/17","labels_url":"https://api.github.com/repos/yiisoft/yii2/milestones/17/labels","id":1580065,"node_id":"MDk6TWlsZXN0b25lMTU4MDA2NQ==","number":17,"title":"2.0.9","description":"","creator":{"login":"cebe","id":189796,"node_id":"MDQ6VXNlcjE4OTc5Ng==","avatar_url":"https://avatars.githubusercontent.com/u/189796?v=4","gravatar_id":"","url":"https://api.github.com/users/cebe","html_url":"https://github.com/cebe","followers_url":"https://api.github.com/users/cebe/followers","following_url":"https://api.github.com/users/cebe/following{/other_user}","gists_url":"https://api.github.com/users/cebe/gists{/gist_id}","starred_url":"https://api.github.com/users/cebe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cebe/subscriptions","organizations_url":"https://api.github.com/users/cebe/orgs","repos_url":"https://api.github.com/users/cebe/repos","events_url":"https://api.github.com/users/cebe/events{/privacy}","received_events_url":"https://api.github.com/users/cebe/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":153,"state":"closed","created_at":"2016-02-12T16:35:34Z","updated_at":"2017-05-23T21:32:15Z","due_on":"2016-07-09T22:00:00Z","closed_at":"2016-07-11T13:40:39Z"},"comments":2,"created_at":"2016-05-04T10:14:02Z","updated_at":"2016-05-06T09:05:16Z","closed_at":"2016-05-06T09:05:16Z","author_association":"MEMBER","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### What steps will reproduce the problem?\n\nAttempt to save object into a session variable:\n\n``` php\nYii::$app->session->set('user', Yii::$app->assetManager);\nYii::$app->session->close(); // throws an exception\nexit;\n```\n\nSession table DDL:\n\n``` sql\ncreate table \"session\"\n(\n    \"id\"  varchar(256) not null,\n    \"expire\" integer,\n    \"data\" bytea,  /* Binary string column has been used as it should be, text - would not work */\n    primary key (\"id\")\n);\n```\n### What is the expected result?\n\nObject stored into the session successfully and available for the get.\n### What do you get instead?\n\nDatabase exception:\n\n```\nException (Database Exception) 'yii\\db\\Exception' with message 'SQLSTATE[22P02]: Invalid text representation: 7 ERROR: invalid input syntax for type bytea The SQL being executed was: UPDATE \"session\" SET \"data\"='__flash|a:0:{}_language|s:2:\"ru\";__id|i:1;test|s:4:\"some\";foo|s:4:\"some\";user|O:20:\"yii\\web\\AssetManager\":17:{s:7:\"bundles\";a:1:{s:28:\"yii\\bootstrap\\BootstrapAsset\";a:2:{s:10:\"sourcePath\";s:28:\"@app/assets/source/bootstrap\";s:3:\"css\";a:1:{i:0;s:18:\"css/bootstrap.less\";}}}s:8:\"basePath\";s:43:\"/home/pklimov/projects/soft-farm/web/assets\";s:7:\"baseUrl\";s:25:\"/pklimov/soft-farm/assets\";s:8:\"assetMap\";a:0:{}s:10:\"linkAssets\";b:1;s:8:\"fileMode\";N;s:7:\"dirMode\";i:509;s:10:\"beforeCopy\";N;s:9:\"afterCopy\";N;s:9:\"forceCopy\";b:0;s:15:\"appendTimestamp\";b:1;s:12:\"hashCallback\";N;s:35:\"', \"expire\"=1462357997 WHERE \"id\"='85gdh4kpu4d43ck9f288sal7d1'' in /home/pklimov/projects/yii2/framework/db/Schema.php:633 Stack trace: #0 /home/pklimov/projects/yii2/framework/db/Command.php(854): yii\\db\\Schema->convertException(Object(PDOException), 'UPDATE \"session...') #1 /home/pklimov/projects/yii2/framework/web/DbSession.php(179): yii\\db\\Command->execute() #2 [internal function]: yii\\web\\DbSession->writeSession('85gdh4kpu4d43ck...', '__flash|a:0:{}_...') #3 /home/pklimov/projects/yii2/framework/web/Session.php(175): session_write_close() #4 [internal function]: yii\\web\\Session->close() #5 {main}\n```\n### Additional info\n\n| Q | A |\n| --- | --- |\n| Yii version | 2.0.8 |\n| PHP version | 5.4 |\n| Operating system | CentOS |\n| PostgreSQL version | 9.4.5 |\n\nThe problem can be fixed using direct setup of the data PDO type to be `PDO::PARAM_LOB`.\nThis will work for PostgreSQL. But I am unsure if it is safe to do so for other DBMS.\n\nAlso such classes as `yii\\caching\\DbCache` and `yii\\rbac\\DbManager` may be affected by this problem.\n","closed_by":{"login":"klimov-paul","id":1482054,"node_id":"MDQ6VXNlcjE0ODIwNTQ=","avatar_url":"https://avatars.githubusercontent.com/u/1482054?v=4","gravatar_id":"","url":"https://api.github.com/users/klimov-paul","html_url":"https://github.com/klimov-paul","followers_url":"https://api.github.com/users/klimov-paul/followers","following_url":"https://api.github.com/users/klimov-paul/following{/other_user}","gists_url":"https://api.github.com/users/klimov-paul/gists{/gist_id}","starred_url":"https://api.github.com/users/klimov-paul/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/klimov-paul/subscriptions","organizations_url":"https://api.github.com/users/klimov-paul/orgs","repos_url":"https://api.github.com/users/klimov-paul/repos","events_url":"https://api.github.com/users/klimov-paul/events{/privacy}","received_events_url":"https://api.github.com/users/klimov-paul/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yiisoft/yii2/issues/11498/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yiisoft/yii2/issues/11498/timeline","performed_via_github_app":null,"state_reason":"completed"}