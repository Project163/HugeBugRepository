-    // try quick version and see whether we get numeric overflows.
-    // factorial(..) is O(1); requires no loop; only a table lookup.
-    if (n > k) {
-      int max = FACTORIAL_TABLE.length + LARGE_FACTORIAL_TABLE.length;
-      if (n < max) { // if (n! < inf && k! < inf)
