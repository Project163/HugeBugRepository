.sh\"] ,\n  data = [ \"@test//pkg:b\"])\n\n$ bazel test -s --nocheck_visibility sub/x_test\nERROR: Error sending results to http://localhost:8082: Connection to http://localhost:8082 refused.\nWARNING: /home/hanwen/vc/test2/sub/BUILD:1:1: in sh_test rule //sub:x_test: Target '//sub:x_test' violates visibility of target '@test//pkg:b'. Continuing because --nocheck_visibility is active.\nINFO: Found 1 test target...\n\n> > > > > # @test//pkg:b [action 'GoCompile external/test/pkg/b.a']\n> > > > > \n> > > > > (cd /home/hanwen/.cache/bazel/_bazel_hanwen/6433d2bba0e406fe672e2326d722746b/test2 && \\\n> > > > >   exec env - \\\n> > > > >     GOARCH=amd64 \\\n> > > > >     GOOS=linux \\\n> > > > >   /bin/bash -c 'rm -rf bazel-out/local_linux-fastbuild/bin/external/test/pkg/b.a.dir && mkdir -p bazel-out/local_linux-fastbuild/bin/external/test/pkg/b.a.dir && mkdir -p bazel-out/local_linux-fastbuild/bin/external/test/pkg/b.a.dir/github.com/hanwen/test2/external/test/pkg && ln -s ../../../../../../../../../../../../../bazel-out/local_linux-fastbuild/bin/external/test/pkg/go_default_library.a bazel-out/local_linux-fastbuild/bin/external/test/pkg/b.a.dir/github.com/hanwen/test2/external/test/pkg/go_default_library.a && mkdir -p bazel-out/local_linux-fastbuild/bin/external/test/pkg/b.a.dir/github.com/hanwen/test2/external/test/pkg && ln -s ../../../../../../../../../../../../../external/test/pkg/b.go bazel-out/local_linux-fastbuild/bin/external/test/pkg/b.a.dir/github.com/hanwen/test2/external/test/pkg/b.go && export GOROOT=$(pwd)/external/golang-linux-amd64/go/bin/.. && cd  bazel-out/local_linux-fastbuild/bin/external/test/pkg/b.a.dir && ../../../../../../../external/golang-linux-amd64/go/bin/go tool compile -o ../../../../../../../bazel-out/local_linux-fastbuild/bin/external/test/pkg/b.a -pack -I . -importmap=github.com/hanwen/test2/pkg=github.com/hanwen/test2/pkg/go_default_library github.com/hanwen/test2/external/test/pkg/b.go')\n> > > > > INFO: From GoCompile external/test/pk