+                                $filter->declare_strict_types[$directory_path] = true;
+                            }
+
+                            $filter->addDirectory(readlink($iterator->getPathName()));
+                        }
+                    }
+
+                    $iterator->next();
+                }
+
                 if ($ignore_type_stats && $filter instanceof ProjectFileFilter) {
                     $filter->ignore_type_stats[$directory_path] = true;
