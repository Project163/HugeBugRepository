CR/followers","following_url":"https://api.github.com/users/EuMMCR/following{/other_user}","gists_url":"https://api.github.com/users/EuMMCR/gists{/gist_id}","starred_url":"https://api.github.com/users/EuMMCR/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/EuMMCR/subscriptions","organizations_url":"https://api.github.com/users/EuMMCR/orgs","repos_url":"https://api.github.com/users/EuMMCR/repos","events_url":"https://api.github.com/users/EuMMCR/events{/privacy}","received_events_url":"https://api.github.com/users/EuMMCR/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-08-31T18:58:32Z","updated_at":"2016-08-31T18:58:32Z","body":"In the code all scalars and objects are checked if the value has changed. Only arrays are not checked.\nSee here: [Marshaller.php](https://github.com/cakephp/cakephp/blob/master/src/ORM/Marshaller.php) Line 554.\nSo, if scalars and objects are checked, why not additionally compare NULL values?\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/243865489/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"EuMMCR","id":4921015,"node_id":"MDQ6VXNlcjQ5MjEwMTU=","avatar_url":"https://avatars.githubusercontent.com/u/4921015?v=4","gravatar_id":"","url":"https://api.github.com/users/EuMMCR","html_url":"https://github.com/EuMMCR","followers_url":"https://api.github.com/users/EuMMCR/followers","following_url":"https://api.github.com/users/EuMMCR/following{/other_user}","gists_url":"https://api.github.com/users/EuMMCR/gists{/gist_id}","starred_url":"https://api.github.com/users/EuMMCR/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/EuMMCR/subscriptions","organizations_url":"https://api.github.com/users/EuMMCR/orgs","repos_url":"https://api.github.com/users/EuMMCR/repos","event