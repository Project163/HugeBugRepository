ng/orgs","repos_url":"https://api.github.com/users/Huqicheng/repos","events_url":"https://api.github.com/users/Huqicheng/events{/privacy}","received_events_url":"https://api.github.com/users/Huqicheng/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":1,"created_at":"2022-09-02T19:35:52Z","updated_at":"2022-09-07T19:35:44Z","closed_at":"2022-09-07T19:35:44Z","author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Jira Link: [DB-3355](https://yugabyte.atlassian.net/browse/DB-3355)\r\n### Description\n\nSlack thread: https://yugabyte.slack.com/archives/C03ULJYE0KG/p1662072447976889\r\n\r\nThere's the race on `min_pinned_op_index_` between `LogCallback` and `PrepareAppendOperations`\r\n\r\nConsidering the following sequence of log cache operations:\r\n```\r\ninsert(1.1)\r\ninsert(1.2)\r\nflush(1.1) -> min_pinned_op_index_ = 2\r\ninsert(2.1) -> min_pinned_op_index_ = 1\r\nflush(1.2) -> min_pinned_op_index_ = 3\r\n```\r\n2.1 can be evicted before being flushed, which is not expected.\r\n","closed_by":{"login":"Huqicheng","id":31775227,"node_id":"MDQ6VXNlcjMxNzc1MjI3","avatar_url":"https://avatars.githubusercontent.com/u/31775227?v=4","gravatar_id":"","url":"https://api.github.com/users/Huqicheng","html_url":"https://github.com/Huqicheng","followers_url":"https://api.github.com/users/Huqicheng/followers","following_url":"https://api.github.com/users/Huqicheng/following{/other_user}","gists_url":"https://api.github.com/users/Huqicheng/gists{/gist_id}","starred_url":"https://api.github.com/users/Huqicheng/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Huqicheng/subscriptions","organizations_url":"https://api.github.com/users/Huqicheng/orgs","repos_url":"https://api.github.com/users/Huqicheng/repos","events_url":"https://api.github.com/users/Huqicheng/events{/privacy}","received_events_url":"https://api.github.com/users/Huqicheng/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/13855/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/13855/timeline","performed_via_github_app":null,"state_reason":"completed"}