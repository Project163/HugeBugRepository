chie46/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ritchie46/subscriptions","organizations_url":"https://api.github.com/users/ritchie46/orgs","repos_url":"https://api.github.com/users/ritchie46/repos","events_url":"https://api.github.com/users/ritchie46/events{/privacy}","received_events_url":"https://api.github.com/users/ritchie46/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-04-28T17:00:24Z","updated_at":"2022-04-28T17:00:24Z","body":"Have you got an idea how we might solve this? ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/pola-rs/polars/issues/comments/1112446004/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ritchie46","id":3023000,"node_id":"MDQ6VXNlcjMwMjMwMDA=","avatar_url":"https://avatars.githubusercontent.com/u/3023000?v=4","gravatar_id":"","url":"https://api.github.com/users/ritchie46","html_url":"https://github.com/ritchie46","followers_url":"https://api.github.com/users/ritchie46/followers","following_url":"https://api.github.com/users/ritchie46/following{/other_user}","gists_url":"https://api.github.com/users/ritchie46/gists{/gist_id}","starred_url":"https://api.github.com/users/ritchie46/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ritchie46/subscriptions","organizations_url":"https://api.github.com/users/ritchie46/orgs","repos_url":"https://api.github.com/users/ritchie46/repos","events_url":"https://api.github.com/users/ritchie46/events{/privacy}","received_events_url":"https://api.github.com/users/ritchie46/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/pola-rs/polars/issues/comments/1112491091","html_url":"https://github.com/pola-rs/polars/issues/3253#issuecomment-1112491091","issue_url":"https://api.github.com/repos/pola-rs/polars/issues/3253","id":1112491091,"node_id":"IC_kwDOD7gq785CT0RT","user":{"login":"qiemem","id":28215,"node_id":"MDQ6VXNlcjI4MjE1","avatar_url":"https://avatars.githubusercontent.com/u/28215?v=4","gravatar_id":"","url":"https://api.github.com/users/qiemem","html_url":"https://github.com/qiemem","followers_url":"https://api.github.com/users/qiemem/followers","following_url":"https://api.github.com/users/qiemem/following{/other_user}","gists_url":"https://api.github.com/users/qiemem/gists{/gist_id}","starred_url":"https://api.github.com/users/qiemem/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qiemem/subscriptions","organizations_url":"https://api.github.com/users/qiemem/orgs","repos_url":"https://api.github.com/users/qiemem/repos","events_url":"https://api.github.com/users/qiemem/events{/privacy}","received_events_url":"https://api.github.com/users/qiemem/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-04-28T17:43:32Z","updated_at":"2022-04-28T17:43:32Z","body":"Hmm. Possibly. Looking at it further this almost seems like a bug in numpy in that it treats `__array__(None)` differently than `__array__()`:\r\n\r\n```python\r\nIn [116]: np.array([\"one\", \"two\"]).__array__()\r\nOut[116]: array(['one', 'two'], dtype='<U3')\r\n\r\nIn [117]: np.array([\"one\", \"two\"]).__array__(None)\r\n---------------------------------------------------------------------------\r\nValueError                                Traceback (most recent call last)\r\n<ipython-input-117-d6e8f6586de8> in <module>\r\n----> 1 np.array([\"one\", \"two\"]).__array__(None)\r\n\r\nValueError: could not convert string to float: 'one'\r\n```\r\n\r\nThat said, it's (arguably) a bug that could be worked around by only passing the arg if you actually get it:\r\n\r\n```python\r\ndef __array__(self, *args) -> np.ndarray:\r\n    return self.to_numpy().__array__(*args)\r\n```\r\n\r\nto reproduce numpy's behavior exactly, or maybe:\r\n\r\n```python\r\ndef __array__(self, dtype: Any = None) -> np.ndarray:\r\n    arr = self.to_numpy()\r\n    return arr.__array__(arr.dtype if dtype is None else dtype)\r\n```\r\n\r\nto behave how numpy probably should be behaving here.\r\n\r\nbleh","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/pola-rs/polars/issues/comments/1112491091/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"qiemem","id":28215,"node_id":"MDQ6VXNlcjI4MjE1","avatar_url":"https://avatars.githubusercontent.com/u/28215?v=4","gravatar_id":"","url":"https://api.github.com/users/qiemem","html_url":"https://github.com/qiemem","followers_url":"https://api.github.com/users/qiemem/followers","following_url":"https://api.github.com/users/qiemem/following{/other_user}","gists_url":"https://api.github.com/users/qiemem/gists{/gist_id}","starred_url":"https://api.github.com/users/qiemem/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qiemem/subscriptions","organizations_url":"https://api.github.com/users/qiemem/orgs","repos_url":"https://api.github.com/users/qiemem/repos","events_url":"https://api.github.com/users/qiemem/events{/privacy}","received_events_url":"https://api.github.com/users/qiemem/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":6522103482,"node_id":"REFE_lADOD7gq785Ip9ATzwAAAAGEv2a6","url":"https://api.github.com/repos/pola-rs/polars/issues/events/6522103482","actor":{"login":"ghuls","id":1299177,"node_id":"MDQ6VXNlcjEyOTkxNzc=","avatar_url":"https://avatars.githubusercontent.com/u/1299177?v=4","gravatar_id":"","url":"https://api.github.com/users/ghuls","html_url":"https://github.com/ghuls","followers_url":"https://api.github.com/users/ghuls/followers","following_url":"https://api.github.com/users/ghuls/following{/other_user}","gists_url":"https://api.github.com/users/ghuls/gists{/gist_id}","starred_url":"https://api.github.com/users/ghuls/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ghuls/subscriptions","organizations_url":"https://api.github.com/users/ghuls/orgs","repos_url":"https://api.github.com/users/ghuls/repos","events_url":"https://api.github.com/users/ghuls/events{/privacy}","received_events_url":"https://api.github.com/users/ghuls/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"68fa5af8975dfb9e2ff0d05f3784fa24fe5efaa5","commit_url":"https://api.github.com/repos/ghuls/polars/commits/68fa5af8975dfb9e2ff0d05f3784fa24fe5efaa5","created_at":"2022-04-29T10:35:09Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/pola-rs/polars/issues/comments/1113165741","html_url":"https://github.com/pola-rs/polars/issues/3253#issuecomment-1113165741","issue_url":"https://api.github.com/repos/pola-rs/polars/issues/3253","id":1113165741,"node_id":"IC_kwDOD7gq785CWY-t","user":{"login":"ghuls","id":1299177,"node_id":"MDQ6VXNlcjEyOTkxNzc=","avatar_url":"https://avatars.githubusercontent.com/u/1299177?v=4","gravatar_id":"","url":"https://api.github.com/users/ghuls","html_url":"https://github.com/ghuls","followers_url":"https://api.github.com/users/ghuls/followers","following_url":"https://api.github.com/users/ghuls/following{/other_user}","gists_url":"https://api.github.com/users/ghuls/gists{/gist_id}","starred_url":"https://api.github.com/users/ghuls/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ghuls/subscriptions","organizations_url":"https://api.github.com/users/ghuls/orgs","repos_url":"https://api.github.com/users/ghuls/repos","events_url":"https://api.github.com/users/ghuls/events{/privacy}","received_events_url":"https://api.github.com/users/ghuls/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-04-29T10:46:59Z","updated_at":"2022-04-29T10:46:59Z","body":"Polars series with ints/floats of a specific dtype were also not preserved before:\r\n\r\n```python\r\nIn [4]: pl.Series([1, 3, 2], dtype=pl.Int8).to_numpy()\r\nOut[4]: array([1, 3, 2], dtype=int8)\r\n\r\n# Before patch\r\nIn [5]: np.array(pl.Series([1, 3, 2], dtype=pl.Int8))\r\nOut[5]: array([1., 3., 2.])\r\n\r\nIn [6]: np.array(pl.Series([1, 3, 2], dtype=pl.Int8)).dtype\r\nOut[6]: dtype('float64')\r\n\r\n# After\r\nIn [38]: np.array(pl.Series([1, 3, 2], dtype=pl.Int8))\r\nOut[38]: array([1, 3, 2], dtype=int8)\r\n```","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/pola-rs/polars/issues/comments/1113165741/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ghuls","id":1299177,"node_id":"MDQ6VXNlcjEyOTkxNzc=","avatar_url":"https://avatars.githubusercontent.com/u/1299177?v=4","gravatar_id":"","url":"https://api.github.com/users/ghuls","html_url":"https://github.com/ghuls","followers_url":"https://api.github.com/users/ghuls/followers","following_url":"https://api.github.com/users/ghuls/following{/other_user}","gists_url":"https://api.github.com/users/ghuls/gists{/gist_id}","starred_url":"https://api.github.com/users/ghuls/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ghuls/subscriptions","organizations_url":"https://api.github.com/users/ghuls/orgs","repos_url":"https://api.github.com/users/ghuls/repos","events_url":"https://api.github.com/users/ghuls/events{/privacy}","received_events_url":"https://api.github.com/users/ghuls/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":6522658718,"node_id":"REFE_lADOD7gq785Ip9ATzwAAAAGEx9-e","url":"https://api.github.com/repos/pola-rs/polars/issues/events/6522658718","actor":{"login":"ghuls","id":1299177,"node_id":"MDQ6VXNlcjEyOTkxNzc=","avatar_url":"https://avatars.githubusercontent.com/u/1299177