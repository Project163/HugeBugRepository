//www.mypy-lang.org/","size":77161,"stargazers_count":20064,"watchers_count":20064,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":3065,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":3124,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["linter","python","typechecker","types","typing"],"visibility":"public","forks":3065,"open_issues":3124,"watchers":20064,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"```python\r\nfrom typing import TypeVar, ParamSpec, Generic, Protocol\r\nfrom collections.abc import Callable\r\nfrom functools import partial\r\n\r\nV_co = TypeVar(\"V_co\", covariant=True)\r\nP = ParamSpec(\"P\")\r\n\r\nclass Wrapped(Protocol, Generic[P, V_co]):\r\n  def __call__(self, *args: P.args, **kwargs: P.kwargs) -> V_co:\r\n    raise NotImplementedError\r\n\r\ndef jit(fun: Callable[P, V_co],\r\n        argnames: str | None = None\r\n        ) -> Wrapped[P, V_co]:\r\n  ...\r\n\r\n@partial(jit, argnames='debug')\r\ndef some_function(debug: bool = False):\r\n  pass\r\n\r\nsome_function(debug=False)\r\n# a.py:22: error: Argument \"debug\" to \"__call__\" of \"Wrapped\" has incompatible type \"bool\"; expected \"P.kwargs\"  [arg-type]\r\n```\r\nMyPy 1.6.1 is for some reason exposing \"P.kwargs\" and demanding it as a parameter!\r\n\r\n(PyRight produces no errors.)\r\n\r\nMay possibly be related to https://github.com/python/mypy/issues/15215, but this gives a very different error.","reactions":{"url":"https://api.github.com/repos/python/mypy/issues/16404/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/mypy/issues/1640