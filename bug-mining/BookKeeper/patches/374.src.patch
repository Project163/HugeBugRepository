-        if (Session.AUTO_ACKNOWLEDGE == getAcknowledgeMode() ||
-            Session.DUPS_OK_ACKNOWLEDGE == getAcknowledgeMode()){
-            // Ignore (any) exceptions which might be thrown ...
-            try {
