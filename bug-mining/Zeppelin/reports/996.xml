&lt;/span&gt;   print(&lt;span class=&quot;code-quote&quot;&gt;&quot;start&quot;&lt;/span&gt;)
   time.sleep(1000)
   print(&lt;span class=&quot;code-quote&quot;&gt;&quot;end&quot;&lt;/span&gt;)&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;p&gt;&#160;&lt;/p&gt;

