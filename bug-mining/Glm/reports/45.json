sercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":82,"state":"open","created_at":"2012-09-12T10:39:07Z","updated_at":"2018-07-29T21:40:26Z","due_on":null,"closed_at":null},"comments":5,"created_at":"2013-09-13T00:21:26Z","updated_at":"2013-09-20T04:53:40Z","closed_at":"2013-09-17T22:15:32Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Hi,\n\nIn gtc/matrix_transform.inl, the lookAt function code includes a superfluous normalization of the up vector.  This error was possibly copied from the GLU man page for gluLookAt (man page error acknowledged by Jon Leech).  The current GLM (0.9.4.5) source code reads:\n\n```\n    detail::tvec3<T> f = normalize(center - eye);\n    detail::tvec3<T> u = normalize(up);      // Accomplishes nothing\n    detail::tvec3<T> s = normalize(cross(f, u));\n    u = cross(s, f);\n```\n\nThe code should read:\n\n```\n    detail::tvec3<T> f = normalize(center - eye);\n    detail::tvec3<T> s = normalize(cross(f, up)); // changed u to up in cross.\n    u = cross(s, f);\n```\n\nThis is the GLU source code (correct), according to Jon Leech:\n\n```\nnormalize(forward);\n/* Side = forward x up */\ncross(forward, up, side);\nnormalize(side);\n/* Recompute up as: up = side x forward */\ncross(side, forward, up);\n... construct view matrix\n```\n\nThis fix should not alter the correctness of the glm::lookAt result.  It only removes a pointless calculation.\n","closed_by":{"login":"Groovounet","id":367227,"node_id":"MDQ6VXNlcjM2NzIyNw==","avatar_url":"https://avatars.githubusercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/g-truc/glm/issues/114/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/g-truc/glm/issues/114/timeline","performed_via_github_app":null,"state_reason":"completed"}