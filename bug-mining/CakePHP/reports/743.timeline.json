e://localhost/path\\to\\file`.\n\n        return $path;\n    }\n\n    ...\n\n    // Restore all `schema://...` parts here.\n    // `\\path\\to\\file` should be `compress.zlib://file://localhost/path\\to\\file`.\n\n    return Folder::slashTerm($newpath);\n}\n```\n\nBut sorry, I have no time to contribute :sob: \n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/151371318/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"chinpei215","id":7399393,"node_id":"MDQ6VXNlcjczOTkzOTM=","avatar_url":"https://avatars.githubusercontent.com/u/7399393?v=4","gravatar_id":"","url":"https://api.github.com/users/chinpei215","html_url":"https://github.com/chinpei215","followers_url":"https://api.github.com/users/chinpei215/followers","following_url":"https://api.github.com/users/chinpei215/following{/other_user}","gists_url":"https://api.github.com/users/chinpei215/gists{/gist_id}","starred_url":"https://api.github.com/users/chinpei215/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chinpei215/subscriptions","organizations_url":"https://api.github.com/users/chinpei215/orgs","repos_url":"https://api.github.com/users/chinpei215/repos","events_url":"https://api.github.com/users/chinpei215/events{/privacy}","received_events_url":"https://api.github.com/users/chinpei215/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":446359513,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50NDQ2MzU5NTEz","url":"https://api.github.com/repos/cakephp/cakephp/issues/events/446359513","actor":{"login":"dereuromark","id":39854,"node_id":"MDQ6VXNlcjM5ODU0","avatar_url":"https://avatars.githubusercontent.com/u/39854?v=4","gravatar_id":"","url":"https://api.github.com/users/dereuromark","html_url":"https://github.com/dereuromark","followers_url":"https://api.github.com/users/de