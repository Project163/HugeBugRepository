pi.github.com/repos/yiisoft/yii2/downloads","issues_url":"https://api.github.com/repos/yiisoft/yii2/issues{/number}","pulls_url":"https://api.github.com/repos/yiisoft/yii2/pulls{/number}","milestones_url":"https://api.github.com/repos/yiisoft/yii2/milestones{/number}","notifications_url":"https://api.github.com/repos/yiisoft/yii2/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/yiisoft/yii2/labels{/name}","releases_url":"https://api.github.com/repos/yiisoft/yii2/releases{/id}","deployments_url":"https://api.github.com/repos/yiisoft/yii2/deployments","created_at":"2012-02-13T15:32:36Z","updated_at":"2025-12-13T02:47:07Z","pushed_at":"2025-12-09T16:34:01Z","git_url":"git://github.com/yiisoft/yii2.git","ssh_url":"git@github.com:yiisoft/yii2.git","clone_url":"https://github.com/yiisoft/yii2.git","svn_url":"https://github.com/yiisoft/yii2","homepage":"http://www.yiiframework.com","size":87780,"stargazers_count":14308,"watchers_count":14308,"language":"PHP","has_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":6857,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":521,"license":{"key":"bsd-3-clause","name":"BSD 3-Clause \"New\" or \"Revised\" License","spdx_id":"BSD-3-Clause","url":"https://api.github.com/licenses/bsd-3-clause","node_id":"MDc6TGljZW5zZTU="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["framework","hacktoberfest","php","php-framework","yii","yii2"],"visibility":"public","forks":6857,"open_issues":521,"watchers":14308,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"The [ICU Date/Time Format Syntax](http://userguide.icu-project.org/formatparse/datetime#TOC-Date-Time-Format-Syntax) specifies that it’s possible to escape text by placing it within single quotes, and that two consecutive single quotes should result in one single quote. However, FormatConverter::convertDateIcuToPhp() and ::convertDateIcuToJui() do not respect those syntaxes.\n\nExample:\n\n``` php\n$formatter = new IntlDateFormatter('en_US', IntlDateFormatter::FULL, IntlDateFormatter::FULL);\n$pattern = $formatter->getPattern();\necho \\yii\\helpers\\FormatConverter::convertDateIcuToPhp($pattern).\"\\n\" .\n     \\yii\\helpers\\FormatConverter::convertDateIcuToJui($pattern);\n```\n\nExpected output:\n\n```\nl, F j, Y \\a\\t g:i:s a T\nDD, MM d, yy 'at' ::  \n```\n\nActual output:\n\n```\nl, F j, Y 'at' g:i:s a T\nDD, MM d, yy 't' ::  \n```\n\n(The expected jQuery output is admittedly a little weird in this example, since jQuery UI’s Datepicker doesn't support time formats, but it still illustrates the issue.)\n\nTested in Yii 2.0.2.\n","reactions":{"url":"https://api.github.com/repos/yiisoft/yii2/issues/7150/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yiisoft/yii2/issues/7150/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/yiisoft/yii2/issues/comments/77567466","html_url":"https://github.com/yiisoft/yii2/issues/7603#issuecomment-77567466","issue_url":"https://api.github.com/repos/yiisoft/yii2/issues/7603","id":77567466,"node_id":"MDEyOklzc3VlQ29tbWVudDc3NTY3NDY2","user":{"login":"maddoger","id":6214206,"node_id":"MDQ6VXNlcjYyMTQyMDY=","avatar_url":"https://avatars.githubusercontent.com/u/6214206?v=4","gravatar_id":"","url":"https://api.github.com/users/maddoger","html_url":"https://github.com/maddoger","followers_url":"https://api.github.com/users/maddoger/followers","following_url":"https://api.github.com/users/maddoger/following{/other_user}","gists_url":"https://api.github.com/users/maddoger/gists{/gist_id}","starred_url":"https://api.github.com/users/maddoger/starred{/owner}{/repo}","subscriptions_url":"https://api.g