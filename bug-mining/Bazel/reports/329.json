"https://api.github.com/users/philwo/orgs","repos_url":"https://api.github.com/users/philwo/repos","events_url":"https://api.github.com/users/philwo/events{/privacy}","received_events_url":"https://api.github.com/users/philwo/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"hermione521","id":1552651,"node_id":"MDQ6VXNlcjE1NTI2NTE=","avatar_url":"https://avatars.githubusercontent.com/u/1552651?v=4","gravatar_id":"","url":"https://api.github.com/users/hermione521","html_url":"https://github.com/hermione521","followers_url":"https://api.github.com/users/hermione521/followers","following_url":"https://api.github.com/users/hermione521/following{/other_user}","gists_url":"https://api.github.com/users/hermione521/gists{/gist_id}","starred_url":"https://api.github.com/users/hermione521/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hermione521/subscriptions","organizations_url":"https://api.github.com/users/hermione521/orgs","repos_url":"https://api.github.com/users/hermione521/repos","events_url":"https://api.github.com/users/hermione521/events{/privacy}","received_events_url":"https://api.github.com/users/hermione521/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":4,"created_at":"2017-01-23T07:19:37Z","updated_at":"2017-02-28T11:35:25Z","closed_at":"2017-02-28T11:35:25Z","author_association":"COLLABORATOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"`Runfiles` may have an `EmptyFileSupplier` instance that can add empty files to the runfiles tree. `build-runfiles` creates regular empty files for paths added by the supplier. The sandbox code, however, creates symlinks to `/dev/null` for such paths. This means the empty files in the sandbox dereference to character devices not genuine files. For two reasons, I believe the sandbox code should create regular empty files, too:\r\n1. It's an inconsistency between standalone and sandbox mode.\r\n2. The only (public) use for `EmptyFilesSupplier` is adding `__init__.py` to make Python packages. (C)Python 2 is okay with `__init__.py` being a character device, but Python 3 is not. Moreover, other Python implementations and tools that do not exactly replicate CPython's arcane import behavior are generally confused by `__init__.py` being a character device.","closed_by":{"login":"bazel-io","id":15028808,"node_id":"MDQ6VXNlcjE1MDI4ODA4","avatar_url":"https://avatars.githubusercontent.com/u/15028808?v=4","gravatar_id":"","url":"https://api.github.com/users/bazel-io","html_url":"https://github.com/bazel-io","followers_url":"https://api.github.com/users/bazel-io/followers","following_url":"https://api.github.com/users/bazel-io/following{/other_user}","gists_url":"https://api.github.com/users/bazel-io/gists{/gist_id}","starred_url":"https://api.github.com/users/bazel-io/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bazel-io/subscriptions","organizations_url":"https://api.github.com/users/bazel-io/orgs","repos_url":"https://api.github.com/users/bazel-io/repos","events_url":"https://api.github.com/users/bazel-io/events{/privacy}","received_events_url":"https://api.github.com/users/bazel-io/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/2394/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bazelbuild/bazel/issues/2394/timeline","performed_via_github_app":null,"state_reason":"completed"}