\r\n```\r\n\r\n<!-- If this PR contains a breaking change, please describe the impact and migration path for existing applications below. -->\r\n\r\n","reactions":{"url":"https://api.github.com/repos/angular/angular/issues/26243/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/angular/angular/issues/26243/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/angular/angular/issues/comments/440468848","html_url":"https://github.com/angular/angular/issues/26224#issuecomment-440468848","issue_url":"https://api.github.com/repos/angular/angular/issues/26224","id":440468848,"node_id":"MDEyOklzc3VlQ29tbWVudDQ0MDQ2ODg0OA==","user":{"login":"jasonaden","id":516168,"node_id":"MDQ6VXNlcjUxNjE2OA==","avatar_url":"https://avatars.githubusercontent.com/u/516168?v=4","gravatar_id":"","url":"https://api.github.com/users/jasonaden","html_url":"https://github.com/jasonaden","followers_url":"https://api.github.com/users/jasonaden/followers","following_url":"https://api.github.com/users/jasonaden/following{/other_user}","gists_url":"https://api.github.com/users/jasonaden/gists{/gist_id}","starred_url":"https://api.github.com/users/jasonaden/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jasonaden/subscriptions","organizations_url":"https://api.github.com/users/jasonaden/orgs","repos_url":"https://api.github.com/users/jasonaden/repos","events_url":"https://api.github.com/users/jasonaden/events{/privacy}","received_events_url":"https://api.github.com/users/jasonaden/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-11-20T23:41:37Z","updated_at":"2018-11-20T23:41:37Z","body":"Thanks for the issue and PR. I'll try to get to the PR shortly and let you know.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com