+    /**
+     * Aliases or names  enclose into {{}}
+     * @param string $name
+     * @return string
+     */
+    private function encloseName($name)
+    {
+        if ($name && !preg_match('/^{{.*}}$/', $name)) {
+            $name = trim($name, '{}');
+            
+            return '{{' . $name . '}}';
+        }
+
+        return $name;
+    }
