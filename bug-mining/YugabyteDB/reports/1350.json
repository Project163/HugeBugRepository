EXT NOT NULL,  \n  created_at TIMESTAMPTZ DEFAULT now(),\n  is_active BOOLEAN DEFAULT true,   \n  amount NUMERIC(10, 2),              \n  metadata JSONB,                     \n  tags TEXT[],                       \n  location POINT,                     \n  ip_address INET  \n);\n```\n```\nBEGIN ISOLATION LEVEL REPEATABLE READ;\n\n\nCREATE EXTENSION pgcrypto;\n\nINSERT INTO complex_table (uuid_col, name, created_at, is_active, amount, metadata, tags, location, ip_address)\nSELECT\n  gen_random_uuid(),\n  'Sample Entry ' || g,\n  NOW() - (g || ' days')::interval,\n  g % 2 = 0,\n  round((random() * 10000)::numeric, 2),\n  jsonb_build_object('source', 'gen_' || g, 'priority', CASE WHEN g % 3 = 0 THEN 'high' WHEN g % 3 = 1 THEN 'medium' ELSE 'low' END),\n  ARRAY['tag' || (g % 5), 'tag' || ((g + 1) % 5)],\n  point((random() * 180 - 90), (random() * 360 - 180)),\n  ('192.168.' || (trunc(random() * 255))::int || '.' || (trunc(random() * 255))::int)::inet\nFROM generate_series(1, 1000) AS g;\n\ncreate index idx on complex_table (id);\n```\nFinal statement failed with : ERROR:  EnterSeparateDdlTxnMode called when already in DDL mode\n\n### Issue Type\n\nkind/bug\n\n### Warning: Please confirm that this issue does not contain any sensitive information\n\n- [x] I confirm this issue does not contain any sensitive information.\n\n[DB-16192]: https://yugabyte.atlassian.net/browse/DB-16192?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","closed_by":{"login":"dr0pdb","id":21277837,"node_id":"MDQ6VXNlcjIxMjc3ODM3","avatar_url":"https://avatars.githubusercontent.com/u/21277837?v=4","gravatar_id":"","url":"https://api.github.com/users/dr0pdb","html_url":"https://github.com/dr0pdb","followers_url":"https://api.github.com/users/dr0pdb/followers","following_url":"https://api.github.com/users/dr0pdb/following{/other_user}","gists_url":"https://api.github.com/users/dr0pdb/gists{/gist_id}","starred_url":"https://api.github.com/users/dr0pdb/starre