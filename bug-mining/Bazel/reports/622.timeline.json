":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":4359,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1818,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["bazel","build","build-system","correct","fast","multi-language","scalable","test"],"visibility":"public","forks":4359,"open_issues":1818,"watchers":24886,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/bazelbuild/bazel/pulls/6538","html_url":"https://github.com/bazelbuild/bazel/pull/6538","diff_url":"https://github.com/bazelbuild/bazel/pull/6538.diff","patch_url":"https://github.com/bazelbuild/bazel/pull/6538.patch","merged_at":null},"body":"Currently, `pkg_tar` rule uses equal sign as a delimiter to pass file names to the underlying `build_tar.py` script. When a file/directory contains equal sign in the name, the script will incorrectly extract the file name and fail the build.\r\n\r\nInterestingly, the same rule/script uses different delimiter (colon) to pass symlink information.\r\n\r\nThis update changes the delimiter from equal sign to colon so files and directories with equal sign will be processed successfully by the rule.\r\n\r\nFixes #4063","reactions":{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/6538/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bazelbuild/bazel/issues/6538/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":1954813332,"node_id":"MDExOkNsb3NlZEV2ZW50MTk1NDgxMzMzMg==","url":"https://api.github.com/repos/bazelbuild/bazel/issues/events/1954