ectionFactoryImpl.doAuthentication(ConnectionFactoryImpl.java:499)\r\n\tat org.postgresql.core.v3.ConnectionFactoryImpl.tryConnect(ConnectionFactoryImpl.java:141)\r\n\tat org.postgresql.core.v3.ConnectionFactoryImpl.openConnectionImpl(ConnectionFactoryImpl.java:192)\r\n\t... 7 more\r\n```","closed_by":{"login":"frozenspider","id":2077017,"node_id":"MDQ6VXNlcjIwNzcwMTc=","avatar_url":"https://avatars.githubusercontent.com/u/2077017?v=4","gravatar_id":"","url":"https://api.github.com/users/frozenspider","html_url":"https://github.com/frozenspider","followers_url":"https://api.github.com/users/frozenspider/followers","following_url":"https://api.github.com/users/frozenspider/following{/other_user}","gists_url":"https://api.github.com/users/frozenspider/gists{/gist_id}","starred_url":"https://api.github.com/users/frozenspider/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/frozenspider/subscriptions","organizations_url":"https://api.github.com/users/frozenspider/orgs","repos_url":"https://api.github.com/users/frozenspider/repos","events_url":"https://api.github.com/users/frozenspider/events{/privacy}","received_events_url":"https://api.github.com/users/frozenspider/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/2387/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/2387/timeline","performed_via_github_app":null,"state_reason":"completed"}