e/yugabyte-db/labels{/name}","releases_url":"https://api.github.com/repos/yugabyte/yugabyte-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Jira Link: [DB-5618](https://yugabyte.atlassian.net/browse/DB-5618)\r\n### Description\r\n\r\nIn running yugabyted in a system that calls openssl_proxy.sh, the script failed because `sh` is not linked to `bash` (see https://github.com/yugabyte/yugabyte-db/issues/16182), but yugabyted did not detect the error condition.\r\n\r\nThe return code here: https://github.com/yugabyte/yugabyte-db/blob/2.17.1/bin/yugabyted#L4554 was 0, but the error message was not null (print out of the variables in a failed run):\r\n```\r\nout=, err=/home/ubuntu/yugabyte-2.17.1.0/bin/openssl_proxy.sh: 141: /home/ubuntu/yugabyte-2.17.1.0/bin/openssl_proxy.sh: [[: not found\r\n, ret=0\r\n```\r\n\r\nThis matches with the behavior we see \r\n```\r\n# ./bin/openssl_proxy.sh\r\n./bin/openssl_proxy.sh: 141: ./bin/openssl_proxy.sh: [[: not found\r\n# echo $?\r\n0\r\n```\r\n\r\n[DB-5618]: https://yugabyte.atlassian.net/browse/DB-5618?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/16183/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/16183/timeline","performed_via_github_app":null,"state_reason":"reopened"}},"event":"cross-referenced"},{"id":8578996682,"node_id":"AE_lADOBlCVUc5fCi3pzwAAAAH_WRnK","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/8578996682","actor":{"login":"gargsans-yb","id":41946894,"node_id":"MDQ6VXNlcjQxOTQ2ODk0","avatar_url":"https://avatars.githubusercontent.com/u/41946894?v=4","gravatar_id":"","url":"https://api.github.com/users/gargsans-yb","html_url":"https://github.com/gargsans-yb","followers_url":"https://api.github.com/users/gargsans-yb/followers","following_url":"https://api.github.com/users/gargsans-yb/following{/other_user}","gists_url":"https://api.github.com/users/gargsans-yb/gists{/gist_id}","starred_url":"https://api.github.com/users/gargsans-yb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gargsans-yb/subscriptions","organizations_url":"https://api.github.com/users/gargsans-yb/orgs","repos_url":"https://api.github.com/users/gargsans-yb/repos","events_url":"https://api.github.com/users/gargsans-yb/events{/privacy}","received_events_url":"https://api.github.com/users/gargsans-yb/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"assigned","commit_id":null,"commit_url":null,"created_at":"2023-02-22T09:38:25Z","assignee"