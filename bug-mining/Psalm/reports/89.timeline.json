lestones{/number}","notifications_url":"https://api.github.com/repos/vimeo/psalm/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/vimeo/psalm/labels{/name}","releases_url":"https://api.github.com/repos/vimeo/psalm/releases{/id}","deployments_url":"https://api.github.com/repos/vimeo/psalm/deployments","created_at":"2016-11-21T17:04:41Z","updated_at":"2025-12-12T13:56:46Z","pushed_at":"2025-12-11T08:59:09Z","git_url":"git://github.com/vimeo/psalm.git","ssh_url":"git@github.com:vimeo/psalm.git","clone_url":"https://github.com/vimeo/psalm.git","svn_url":"https://github.com/vimeo/psalm","homepage":"https://psalm.dev","size":116606,"stargazers_count":5784,"watchers_count":5784,"language":"PHP","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":684,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1949,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["hacktoberfest","php","security-analysis","static-analysis","taint-analysis","type-inference"],"visibility":"public","forks":684,"open_issues":1949,"watchers":5784,"default_branch":"6.x","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"This may have started happening after fixing https://github.com/vimeo/psalm/issues/288.\r\n\r\nPHP allows this code to be executed, and returning a non-nullable string instead of a nullable string is valid.\r\nNote that the opposite is not allowed - Non-nullable can't be overridden with nullable.\r\n\r\n- Other edge cases: array is a narrower form of iterable, so array return type can override iterable return type, and iterable param can override array param.\r\n\r\nObserved: MethodSignatureMismatch\r\nExpected: No warnings\r\n\r\n```php\r\n<?php\r\n\r\ninterface I1 {\r\n    public function test() : ?string;\r\n    public function testIterable() : iterable;\r\n}\r\n\r\nclass A1 implements I1 {\r\n    public function test() : string {\r\n        return \"value\";\r\n    }\r\n    public function testIterable() : array {\r\n        return [];\r\n    }\r\n}\r\n$a = new A1();\r\nvar_export($a->test());\r\nvar_export($a->testIterable());\r\n```","reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/348/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vimeo/psalm/issues/348/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"}]