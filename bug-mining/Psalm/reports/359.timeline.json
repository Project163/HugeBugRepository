vimeo/psalm/commits{/sha}","git_commits_url":"https://api.github.com/repos/vimeo/psalm/git/commits{/sha}","comments_url":"https://api.github.com/repos/vimeo/psalm/comments{/number}","issue_comment_url":"https://api.github.com/repos/vimeo/psalm/issues/comments{/number}","contents_url":"https://api.github.com/repos/vimeo/psalm/contents/{+path}","compare_url":"https://api.github.com/repos/vimeo/psalm/compare/{base}...{head}","merges_url":"https://api.github.com/repos/vimeo/psalm/merges","archive_url":"https://api.github.com/repos/vimeo/psalm/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/vimeo/psalm/downloads","issues_url":"https://api.github.com/repos/vimeo/psalm/issues{/number}","pulls_url":"https://api.github.com/repos/vimeo/psalm/pulls{/number}","milestones_url":"https://api.github.com/repos/vimeo/psalm/milestones{/number}","notifications_url":"https://api.github.com/repos/vimeo/psalm/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/vimeo/psalm/labels{/name}","releases_url":"https://api.github.com/repos/vimeo/psalm/releases{/id}","deployments_url":"https://api.github.com/repos/vimeo/psalm/deployments","created_at":"2016-11-21T17:04:41Z","updated_at":"2025-12-12T13:56:46Z","pushed_at":"2025-12-11T08:59:09Z","git_url":"git://github.com/vimeo/psalm.git","ssh_url":"git@github.com:vimeo/psalm.git","clone_url":"https://github.com/vimeo/psalm.git","svn_url":"https://github.com/vimeo/psalm","homepage":"https://psalm.dev","size":116606,"stargazers_count":5784,"watchers_count":5784,"language":"PHP","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":684,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1949,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["hacktoberfest","php","security-analysis","static-analysis","taint-analysis","type-inference"],"visibility":"public","forks":684,"open_issues":1949,"watchers":5784,"default_branch":"6.x","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"The following is currently allowed by Psalm, even though it would fail in practice:\r\n\r\nhttps://getpsalm.org/r/ef21737d26\r\n\r\n```php\r\n<?php\r\n\r\nclass Foo\r\n{\r\n    public function __construct(int $_)\r\n    {\r\n    }\r\n}\r\n\r\n/**\r\n * @return Foo\r\n */\r\nfunction makeFoo()\r\n{\r\n    $fooClass = Foo::class;\r\n    return new $fooClass;\r\n}\r\n```\r\n\r\nPsalm output (using commit d70f853): \r\n```\r\nNo issues!\r\n```\r\n\r\n---\r\n\r\nIMO if `$classString` is just known to be a `class-string` then the expression `new $classString` shouldn't be allowed: since the constructor might have requirements (as above), be `private`, or even might be throwing. `class-string` without any more specificity is the `mixed` of metatypes, and you shouldn't really be able to do much with it without running into analysis errors.\r\n\r\nI think a better pattern to enable constructing metatypes might be something like (using the `@template T as ...` notation):\r\n```php\r\n<?php\r\n  \r\ninterface DefaultConstructable\r\n{\r\n    public function __construct();\r\n}\r\n\r\n/**\r\n * @template T as DefaultConstructable\r\n * @template-typeof T $defaultConstructableClass\r\n * @param T::class $defaultConstructableClass\r\n * @return T\r\n */\r\nfunction make($defaultConstructableClass)\r\n{\r\n    return new $defaultConstructableClass;\r\n}\r\n```\r\n\r\nbut this could be generalised to allow other static behaviour too if #1142 is fixed.","reactions":{"url":"https://api.github.com/repos/vimeo/psalm/issues/1143/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vimeo/psalm/issues/1143/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":2042343069,"node_id":"MDEyOkxhYmVsZWRFdmVudDIwNDIzNDMwNjk=","url":"https://api.github.com/repos/vimeo/psalm/issues/events/2042343069","actor":{"login":"muglug","id":2292638,"node_id":"MDQ6VXNlcjIyOTI2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/2292638?v=4","gravatar_id":"","url":"https://api.github.com/users/muglug","html_url":"https://github.com/muglug","followers_url":"https://api.github.com/users/muglug/followers","following_url":"https://api.github.com/users/muglug/following{/other_user}","gists_url":"https://api.github.com/users/muglug/gists{/gist_id}","starred_url":"https://api.github.com/users/muglug/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/muglug/subscriptions","organizations_url":"https://api.github.com/users/muglug/orgs","repos_url":"https://api.github.com/users/muglug/repos","events_url":"https://api.github.com/users/muglug/events{/privacy}","received_events_url":"https://api.github.com/users/muglug/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2018-12-23T04:41:21Z","label":{"name":"bug","color":"ee0701"},"performed_via_github_app":null},{"id":2050408911,"node_id":"MDExOkNsb3NlZEV2ZW50MjA1MDQwODkxMQ==","url":"https://api.github.com/repos/vimeo/psalm/issues/events/2050408911","actor":{"login":"muglug","id":2292638,"node_id":"MDQ6VXNlcjIyOTI2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/2292638?v=4","gravatar_id":"","url":"https://api.github.com/users/muglug","html_url":"https://github.com/muglug","followers_url":"https://api.github.com/users/muglug/followers","following_url":"https://api.github.com/users/muglug/following{/other_user}","gists_url":"https://api.github.com/users/muglug/gists{/gist_id}","starred_url":"https://api.github.com/users/muglug/starred{/owner}{/repo}","subscriptions_url":"htt