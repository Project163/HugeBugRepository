url":"https://api.github.com/repos/bedita/bedita/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/bedita/bedita/labels{/name}","releases_url":"https://api.github.com/repos/bedita/bedita/releases{/id}","deployments_url":"https://api.github.com/repos/bedita/bedita/deployments","created_at":"2012-08-09T07:13:29Z","updated_at":"2025-11-24T16:32:11Z","pushed_at":"2025-11-24T16:50:46Z","git_url":"git://github.com/bedita/bedita.git","ssh_url":"git@github.com:bedita/bedita.git","clone_url":"https://github.com/bedita/bedita.git","svn_url":"https://github.com/bedita/bedita","homepage":"https://www.bedita.com","size":46993,"stargazers_count":68,"watchers_count":68,"language":"PHP","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":21,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":20,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["api-first","api-server","backend","bedita","cakephp","mysql","php","php7","php8","postgres","restful-api"],"visibility":"public","forks":21,"open_issues":20,"watchers":68,"default_branch":"6-pinus","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/bedita/bedita/pulls/1271","html_url":"https://github.com/bedita/bedita/pull/1271","diff_url":"https://github.com/bedita/bedita/pull/1271.diff","patch_url":"https://github.com/bedita/bedita/pull/1271.patch","merged_at":"2017-06-21T07:21:10Z"},"body":"This PR fixes an issue that arose after the release of CakePHP 3.4.8, in cakephp/cakephp#10665.\r\n\r\nRelationships were not saved anymore due to the primary key of the ObjectRelation entity being completely erased in order to avoid issues with relations being saved more than once. Unfortunately this does not take into account a scenario like ours where a discriminator column `relation_id` is part of the primary key, and is used to distinguish between several kinds of associations between the very same objects.\r\n\r\nSince our scenario is quite uncommon, it's probably better to fix it in our homeland rather than opening a PR to CakePHP core, which might add complexity that's not needed by most users.","reactions":{"url":"https://api.github.com/repos/bedita/bedita/issues/1271/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bedita/bedita/issues/1271/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/309814427","html_url":"https://github.com/cakephp/cakephp/issues/10665#issuecomment-309814427","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/10665","id":309814427,"node_id":"MDEyOklzc3VlQ29tbWVudDMwOTgxNDQyNw==","user":{"login":"fquffio","id":7108146,"node_id":"MDQ6VXNlcjcxMDgxNDY=","avatar_url":"https://avatars.githubusercontent.com/u/7108146?v=4","gravatar_id":"","url":"https://api.github.com/users/fquffio","html_url":"https://github.com/fquffio","followers_url":"https://api.github.com/users/fquffio/followers","following_url":"https://api.github.com/users/fquffio/following{/other_user}","gists_url":"https://api.github.com/users/fquffio/gists{/gist_id}","starred_url":"https://api.github.com/users/fquffio/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fquffio/subscriptions","organizations_url":"https://api.github.com/users/fquffio/orgs","repos_url":"https://api.github.com/users/fquffio/repos","events_url":"https://api.github.com/users/fquffio/events{/privacy}","received_events_url":"https://api.github.com/users/fquffio/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-06-20T16:29:58Z","updated_at":"2017-06-20T16:29:58Z","body":"Just to let you know, commit b94a3c7 actually breaks things in a scenario where a single junction table is used for several associations, and a \"discriminator\" column is in the primary key and is used to tell one association from the others.\r\n\r\nFor instance, if one has a junction table with three columns:\r\n - `user_id`: foreign key to users table\r\n - `place_id`: foreign key to places table\r\n - `type`: one of `works_at`, `lives_in`, `usually_haves_breakfast_at`\r\n\r\nIn this case, you must manually set all these three columns in order for things to work, otherwise the whole primary key will be unset, thus `type` will become null. Before 3.4.8, just setting `type` did work, since the association took care of setting `user_id` and `place_id` correctly without touching `type`.\r\n\r\nSince this is quite an uncommon scenario I'm not sure if it should be considered an issue, as fixing it would likely add complexity not needed by most users, but maybe somebody else is having an headache with the same problem. 😉 ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/309814427/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"fquffio","id":7108146,"node_id":"MDQ6VXNlcjcxMDgxNDY=","avatar_url":"https://avatars.githubusercontent.com/u/7108146?v=4","gravatar_id":"","url":"https://api.github.com/users/fquffio","html_url":"https://github.com/fquffio","followers_url":"https://api.github.com/users/fquffio/followers","following_url":"https://api.github.com/users/fquffio/following{/other_user}","gists_url":"https://api.github.com/users/fquffio/gists{/gist_id}","starred_url":"https://api.github.com/users/fquffio/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fquffio/subscriptions","organizations_url":"https://api.github.com/users/fquffio/orgs","repos_url":"https://api.github.com/users/fquffio/repos","events_url":"https://api.github.com/users/fquffio/events{/privacy}","received_events_url":"https://api.github.com/users/fquffio/received_events","type":"User","user_view_type":"public","site_admin":false}}]