+        ]
+        ctx, rev = mock.Mock(), mock.Mock()
+        writer1(ctx, rev, directives)
+
+        directives[0].upgrade_ops_list.extend(
+            [
+                ops.UpgradeOps(
+                    ops=[
+                        ops.CreateTableOp(
+                            "another_test_table",
+                            [sa.Column("id", sa.Integer(), primary_key=True)],
+                        )
+                    ]
+                ),
