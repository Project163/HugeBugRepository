ery/celery/milestones{/number}","notifications_url":"https://api.github.com/repos/celery/celery/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/celery/celery/labels{/name}","releases_url":"https://api.github.com/repos/celery/celery/releases{/id}","deployments_url":"https://api.github.com/repos/celery/celery/deployments","created_at":"2009-04-24T11:31:24Z","updated_at":"2026-03-11T11:08:53Z","pushed_at":"2026-03-10T15:04:28Z","git_url":"git://github.com/celery/celery.git","ssh_url":"git@github.com:celery/celery.git","clone_url":"https://github.com/celery/celery.git","svn_url":"https://github.com/celery/celery","homepage":"https://docs.celeryq.dev","size":36397,"stargazers_count":28268,"watchers_count":28268,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":4989,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":773,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["amqp","python","python-library","python3","queue-tasks","queue-workers","queued-jobs","redis","redis-queue","sqs","sqs-queue","task-manager","task-runner","task-scheduler"],"visibility":"public","forks":4989,"open_issues":773,"watchers":28268,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/celery/celery/pulls/6966","html_url":"https://github.com/celery/celery/pull/6966","diff_url":"https://github.com/celery/celery/pull/6966.diff","patch_url":"https://github.com/celery/celery/pull/6966.patch","merged_at":"2021-09-21T11:32:15Z"},"body":"# Allow to enable Events with app.conf mechanism\r\n\r\n### Description\r\n\r\n`--task-events` is defined as a [Click Boolean Flag](https://click.palletsprojects.com/en/8.0.x/options/#boolean-flags), without an *off-switch* and `False` as the implicit default value, so when this parameter is omitted in CLI invocation, *Click* will set it to `False`. Because the aforementioned, *Events* only can be enabled via CLI (values in `app.conf.worker_send_task_events` will be ignored).\r\n\r\n### Current behaviour\r\n\r\n1. `click.option` decorator for `--task-events` sets `task_events` flag to `False`\r\nhttps://github.com/celery/celery/blob/e2e3e95bf8ac9f85e1ee91753602c47bac878380/celery/bin/worker.py#L205\r\n\r\n2. `either` function resolves to the first non-None value (in our case `False` from `task_events` argument ) ignoring values from `app.conf`\r\nhttps://github.com/celery/celery/blob/e2e3e95bf8ac9f85e1ee91753602c47bac878380/celery/worker/worker.py#L377\r\n\r\n### Proposed solution\r\n\r\nThis fix changes `--task-events` default value from *implicit `False`* to *explicit `None`*, allowing `either` method to correctly resolve in favor of `app.conf.worker_send_task_events` value when set.\r\n\r\nFixes: #6910","reactions":{"url":"https://api.github.com/repos/celery/celery/issues/6966/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/celery/celery/issues/6966/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":5334533260,"node_id":"LE_lADOAALQjM45s8rJzwAAAAE99oSM","url":"https://api.github.com/repos/celery/celery/issues/events/5334533260","actor":{"login":"auvipy","id":6212603,"node_id":"MDQ6VXNlcjYyMTI2MDM=","avatar_url":"https://avatars.githubusercontent.com/u/6212603?v=4","gravatar_id":"","url":"https://api.github.com/users/auvipy","html_url":"https://github.com/auvipy","followers_url":"https://api.github.com/users/auvipy/followers","following_url":"https://api.github.com/users/auvipy/following{/other_user}","gists_url":"https