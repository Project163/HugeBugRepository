google/protobuf/empty.proto\";\n\nservice ControlService {\n   rpc Method1(google.protobuf.Empty) returns (google.protobuf.Empty);\n}\n\nservice ControlBackend {\n   rpc Method2(google.protobuf.Empty) returns (google.protobuf.Empty);\n}\n```\n\nWill generate Services.pbrpc.h that will not compile:\n\n... Redefinition of 'kPackageName'\n... Redefinition of 'kServiceName'\n\nExample:\n\n```\n#import \"Services.pbrpc.h\"\n\n#import <ProtoRPC/ProtoRPC.h>\n#import <RxLibrary/GRXWriter+Immediate.h>\n\nstatic NSString *const kPackageName = @\"TestPackage\";\nstatic NSString *const kServiceName = @\"ControlService\";\n\n@implementation ControlService\n\n// Designated initializer\n- (instancetype)initWithHost:(NSString *)host {\n  return (self = [super initWithHost:host packageName:kPackageName serviceName:kServiceName]);\n}\n\n// Override superclass initializer to disallow different package and service names.\n- (instancetype)initWithHost:(NSString *)host\n                 packageName:(NSString *)packageName\n                 serviceName:(NSString *)serviceName {\n  return [self initWithHost:host];\n}\n\n+ (instancetype)serviceWithHost:(NSString *)host {\n  return [[self alloc] initWithHost:host];\n}\n\n\n#pragma mark Method1(Empty) returns (Empty)\n\n- (void)method1WithRequest:(GPBEmpty *)request handler:(void(^)(GPBEmpty *response, NSError *error))handler{\n  [[self RPCToMethod1WithRequest:request handler:handler] start];\n}\n// Returns a not-yet-started RPC object.\n- (ProtoRPC *)RPCToMethod1WithRequest:(GPBEmpty *)request handler:(void(^)(GPBEmpty *response, NSError *error))handler{\n  return [self RPCToMethod:@\"Method1\"\n            requestsWriter:[GRXWriter writerWithValue:request]\n             responseClass:[GPBEmpty class]\n        responsesWriteable:[GRXWriteable writeableWithSingleHandler:handler]];\n}\n@end\nstatic NSString *const kPackageName = @\"TestPackage\";\nstatic NSString *const kServiceName = @\"ControlBackend\";\n```\n\nI would expect I can define as many services as I'd like in a single proto.\n","closed_by":{"login":"makdharma","id":17325098,"node_id":"MDQ6VXNlcjE3MzI1MDk4","avatar_url":"https://avatars.githubusercontent.com/u/17325098?v=4","gravatar_id":"","url":"https://api.github.com/users/makdharma","html_url":"https://github.com/makdharma","followers_url":"https://api.github.com/users/makdharma/followers","following_url":"https://api.github.com/users/makdharma/following{/other_user}","gists_url":"https://api.github.com/users/makdharma/gists{/gist_id}","starred_url":"https://api.github.com/users/makdharma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/makdharma/subscriptions","organizations_url":"https://api.github.com/users/makdharma/orgs","repos_url":"https://api.github.com/users/makdharma/repos","events_url":"https://api.github.com/users/makdharma/events{/privacy}","received_events_url":"https://api.github.com/users/makdharma/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/grpc/grpc/issues/6834/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/grpc/grpc/issues/6834/timeline","performed_via_github_app":null,"state_reason":"completed"}