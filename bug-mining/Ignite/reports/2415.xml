                            <comment id="15949583" author="skalashnikov" created="Thu, 30 Mar 2017 18:45:05 +0000"  >&lt;p&gt;Found an issue in H2 while adding the tests for this one.&lt;/p&gt;

&lt;p&gt;Here are the details:&lt;/p&gt;

&lt;div class=&quot;code panel&quot; style=&quot;border-width: 1px;&quot;&gt;&lt;div class=&quot;codeContent panelContent&quot;&gt;
&lt;pre class=&quot;code-java&quot;&gt;drop table test &lt;span class=&quot;code-keyword&quot;&gt;if&lt;/span&gt; exists;
create table test(key &lt;span class=&quot;code-object&quot;&gt;int&lt;/span&gt;, a &lt;span class=&quot;code-object&quot;&gt;int&lt;/span&gt;, b &lt;span class=&quot;code-object&quot;&gt;int&lt;/span&gt;);
create index key_pk on test(key);
create index usr_idx on test(a, key);
explain select min(key) from test;

PLAN  
SELECT
    MIN(KEY)
FROM PUBLIC.TEST
    &lt;span class=&quot;code-comment&quot;&gt;/* PUBLIC.USR_IDX */&lt;/span&gt;
&lt;span class=&quot;code-comment&quot;&gt;/* direct lookup */&lt;/span&gt;
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;

&lt;p&gt;The index in &quot;explain results&quot; is wrong. It should be KEY_PK.&lt;/p&gt;</comment>
