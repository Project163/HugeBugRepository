b.com/KunduAbhishek","followers_url":"https://api.github.com/users/KunduAbhishek/followers","following_url":"https://api.github.com/users/KunduAbhishek/following{/other_user}","gists_url":"https://api.github.com/users/KunduAbhishek/gists{/gist_id}","starred_url":"https://api.github.com/users/KunduAbhishek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KunduAbhishek/subscriptions","organizations_url":"https://api.github.com/users/KunduAbhishek/orgs","repos_url":"https://api.github.com/users/KunduAbhishek/repos","events_url":"https://api.github.com/users/KunduAbhishek/events{/privacy}","received_events_url":"https://api.github.com/users/KunduAbhishek/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/angular/angular/issues/comments/1072220992","html_url":"https://github.com/angular/angular/issues/42546#issuecomment-1072220992","issue_url":"https://api.github.com/repos/angular/angular/issues/42546","id":1072220992,"node_id":"IC_kwDOAXExC84_6MtA","user":{"login":"ivanovivelin","id":22252962,"node_id":"MDQ6VXNlcjIyMjUyOTYy","avatar_url":"https://avatars.githubusercontent.com/u/22252962?v=4","gravatar_id":"","url":"https://api.github.com/users/ivanovivelin","html_url":"https://github.com/ivanovivelin","followers_url":"https://api.github.com/users/ivanovivelin/followers","following_url":"https://api.github.com/users/ivanovivelin/following{/other_user}","gists_url":"https://api.github.com/users/ivanovivelin/gists{/gist_id}","starred_url":"https://api.github.com/users/ivanovivelin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ivanovivelin/subscriptions","organizations_url":"https://api.github.com/users/ivanovivelin/orgs","repos_url":"https://api.github.com/users/ivanovivelin/repos","events_url":"https://api.github.com/users/ivanovivelin/events{/privacy}","received_events_url":"https://api.github.com/users/ivanovivelin/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-03-18T09:15:37Z","updated_at":"2022-03-18T09:18:08Z","body":"I had to do a small change to **zone.js** as _attributeChangedCallback_ is just not a valid lifecycle hook for LWC. It will probably work fine for other web components like LitElement without this change.\r\n\r\n```\r\nfunction patchCallbacks(api, target, targetName, method, callbacks) {\r\n    const symbol = Zone.__symbol__(method);\r\n    if (target[symbol]) {\r\n        return;\r\n    }\r\n    const nativeDelegate = target[symbol] = target[method];\r\n    target[method] = function (name, opts, options) {\r\n        if (opts && opts.prototype) {\r\n            callbacks.forEach(function (callback) {\r\n                const source = `${targetName}.${method}::` + callback;\r\n                const prototype = opts.prototype;\r\n                if (prototype.hasOwnProperty(callback)) {\r\n                    const descriptor = api.ObjectGetOwnPropertyDescriptor(prototype, callback);\r\n                    if (descriptor && descriptor.value) {\r\n                        descriptor.value = api.wrapWithCurrentZone(descriptor.value, source);\r\n                        api._redefineProperty(opts.prototype, callback, descriptor);\r\n                    }\r\n                    else if (prototype[callback]) {\r\n                        prototype[callback] = api.wrapWithCurrentZone(prototype[callback], source);\r\n                    }\r\n                }\r\n                else if (prototype[callback]) {\r\n                    // here is the change\r\n                    if(callback !== \"attributeChangedCallback\") {\r\n                        prototype[callback] = api.wrapWithCurrentZone(prototype[callback], source);\r\n                    }\r\n                }\r\n            });\r\n        }\r\n        return nativeDelegate.call(target, name, opts, options);\r\n    };\r\n    api.attachOriginToPatched(target[method], nativeDelegate);\r\n}\r\n```","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/angular/angular/issues/comments/1072220992/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ivanovivelin","id":22252962,"node_id":"MDQ6VXNlcjIyMjUyOTYy","avatar_url":"https://avatars.githubusercontent.com/u/22252962?v=4","gravatar_id":"","url":"https://api.github.com/users/ivanovivelin","html_url":"https://github.com/ivanovivelin","followers_url":"https://api.github.com/users/ivanovivelin/followers","following_url":"https://api.github.com/users/ivanovivelin/following{/other_user}","gists_url":"https://api.github.com/users/ivanovivelin/gists{/gist_id}","starred_url":"https://api.github.com/users/ivanovivelin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ivanovivelin/subscriptions","organizations_url":"https://api.github.com/users/ivanovivelin/orgs","repos_url":"https://api.github.com/users/ivanovivelin/repos","events_url":"https://api.github.com/users/ivanovivelin/events{/privacy}","received_events_url":"https://api.github.com/users/ivanovivelin/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/angular/angular/issues/comments/1072322133","html_url":"https://github.com/angular/angular/issues/42546#issuecomment-1072322133","issue_url":"https://api.github.com/repos/angular/angular/issues/42546","id":1072322133,"node_id":"IC_kwDOAXExC84_6lZV","user":{"login":"JiaLiPassion","id":1442575,"node_id":"MDQ6VXNlcjE0NDI1NzU=","avatar_url":"https://avatars.githubusercontent.com/u/1442575?v=4","gravatar_id":"","url":"https://api.github.com/users/JiaLiPassion","html_url":"https://github.com/JiaLiPassion","followers_url":"https://api.github.com/users/JiaLiPassion/followers","following_url":"https://api.github.com/users/JiaLiPassion/following{/other_user}","gists_url":"https://api.github.