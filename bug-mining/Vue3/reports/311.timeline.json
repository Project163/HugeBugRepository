pi.github.com/repos/vuejs/core/issues/5817","id":1112079795,"node_id":"IC_kwDOCCum185CSP2z","user":{"login":"liulinboyi","id":41336612,"node_id":"MDQ6VXNlcjQxMzM2NjEy","avatar_url":"https://avatars.githubusercontent.com/u/41336612?v=4","gravatar_id":"","url":"https://api.github.com/users/liulinboyi","html_url":"https://github.com/liulinboyi","followers_url":"https://api.github.com/users/liulinboyi/followers","following_url":"https://api.github.com/users/liulinboyi/following{/other_user}","gists_url":"https://api.github.com/users/liulinboyi/gists{/gist_id}","starred_url":"https://api.github.com/users/liulinboyi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/liulinboyi/subscriptions","organizations_url":"https://api.github.com/users/liulinboyi/orgs","repos_url":"https://api.github.com/users/liulinboyi/repos","events_url":"https://api.github.com/users/liulinboyi/events{/privacy}","received_events_url":"https://api.github.com/users/liulinboyi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-04-28T11:14:21Z","updated_at":"2023-01-19T17:08:12Z","body":"> ### Version\r\n> 3.2.25\r\n> \r\n> ### Reproduction link\r\n> [stackblitz.com](https://stackblitz.com/edit/github-qwk9ei)\r\n> \r\n> ### Steps to reproduce\r\n> Create a component with a scoped style (parent) Create a regular component with a template tag (children) Create a functional component that uses `h` (children)\r\n> \r\n> The regular children inherit the data attribute from the parent The functional children doesn't inherit the data attribute from the parent.\r\n> \r\n> ### What is expected?\r\n> The child functional component should receive the data attributes as if it were a template component\r\n> \r\n> ### What is actually happening?\r\n> Functional and Regular component behaves differently in this instance :\r\n> \r\n> <img alt=\"image\" width=\"1204\" src=\"https://user-images.githubusercontent.com/13395944/165164384-b4847cf4-abb3-43d0-9318-cbd153157de8.png\">\r\n> \r\n> * Initially opened there : [Scoped data attributes aren't passed down to functional components nuxt/framework#4605 (comment)](https://github.com/nuxt/nuxt.js/issues/13827)\r\n> * Using script setup\r\n> * Doesn't happen on non SSR\r\n\r\n### I recommend not using the same class 😉.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/vuejs/core/issues/comments/1112079795/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"liulinboyi","id":41336612,"node_id":"MDQ6VXNlcjQxMzM2NjEy","avatar_url":"https://avatars.githubusercontent.com/u/41336612?v=4","gravatar_id":"","url":"https://api.github.com/users/liulinboyi","html_url":"https://github.com/liulinboyi","followers_url":"https://api.github.com/users/liulinboyi/followers","following_url":"https://api.github.com/users/liulinboyi/following{/other_user}","gists_url":"https://api.github.com/users/liulinboyi/gists{/gist_id}","starred_url":"https://api.github.com/users/liulinboyi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/liulinboyi/subscriptions","organizations_url":"https://api.github.com/users/liulinboyi/orgs","repos_url":"https://api.github.com/users/liulinboyi/repos","events_url":"https://api.github.com/users/liulinboyi/events{/privacy}","received_events_url":"https://api.github.com/users/liulinboyi/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":6514224871,"node_id":"REFE_lADOCCum185IjwP0zwAAAAGERy7n","url":"https://api.github.com/repos/vuejs/core/issues/events/6514224871","actor":{"login":"liulinboyi","id":41336612,"node_id":"MDQ6VXNlcjQxMzM2NjEy","avatar_url":"https://avatars.githubusercontent.com/u/41336612?v=4","gravatar_id":"","url":"https://api.github.com/users/liulinboyi","html_url":"https://github.com/liulinboyi","followers_url":"https://api.github.c