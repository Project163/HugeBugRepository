1935979","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/3896","id":441935979,"node_id":"MDEyOklzc3VlQ29tbWVudDQ0MTkzNTk3OQ==","user":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-03-16T21:22:19Z","updated_at":"2018-11-27T06:05:24Z","body":"**Michael Bayer ([@zzzeek](https://github.com/zzzeek)) wrote:**\n\nAdd bulk_replace event, integrate with @validates\n\nAdded new attribute event :meth:`.AttributeEvents.bulk_replace`.\nThis event is triggered when a collection is assigned to a\nrelationship, before the incoming collection is compared with the\nexisting one.  This early event allows for conversion of incoming\nnon-ORM objects as well.  The event is integrated with the\n``@validates`` decorator.\n\nThe ``@validates`` decorator now allows the decorated method to receive\nobjects from a \"bulk collection set\" operation that have not yet\nbeen compared to the existing collection.  This allows incoming values\nto be converted to compatible ORM objects as is already allowed\nfrom an \"append\" event.   Note that this means that the\n``@validates`` method is called for **all** values during a collection\nassignment, rather than just the ones that are new.\n\nChange-Id: I27f59db008d9e521d31a3e30143d7cd997e4b7b3\nFixes: #3896\n\n\n→ 9974e9a46bdf\n","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/441935979/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sqlalchemy-bot/repos","events_url":"https://api.github.com/users/sqlalchemy-bot/events{/privacy}","received_events_url":"https://api.github.com/users/sqlalchemy-bot/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/comments/441935984","html_url":"https://github.com/sqlalchemy/sqlalchemy/issues/3896#issuecomment-441935984","issue_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/issues/3896","id":441935984,"node_id":"MDEyOklzc3VlQ29tbWVudDQ0MTkzNTk4NA==","user":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.gi