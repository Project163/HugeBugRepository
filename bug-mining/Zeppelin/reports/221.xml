		&lt;ol&gt;
			&lt;li&gt;How should this be tested?&lt;br/&gt;
    Set remote debug options:&lt;br/&gt;
    ```&lt;br/&gt;
    export ZEPPELIN_INTP_JAVA_OPTS=-agentlib:jdwp=transport=dt_socket,server=y,address=8000,suspend=n&lt;br/&gt;
