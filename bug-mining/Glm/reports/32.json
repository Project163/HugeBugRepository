ps://avatars.githubusercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":53,"state":"open","created_at":"2012-09-12T10:38:59Z","updated_at":"2013-12-18T17:39:48Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2013-03-09T07:39:29Z","updated_at":"2013-03-16T00:25:53Z","closed_at":"2013-03-16T00:25:53Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"In matrix_interpolation.hpp function \"interpolate\" dltRotation \"rotation\" part is not necessarily orthonormalized, if m1 and m2 contain translation. Using just the rotational portion of m1 seem to fix the issue. Plus there is no additional cost for this fix, due to the fact that we need rotational portion of m1 later in the function.\n\nSo the code should be this instead\n\n```\ntemplate <typename T>\nGLM_FUNC_QUALIFIER detail::tmat4x4<T> interpolate\n(\n    detail::tmat4x4<T> const & m1,\n    detail::tmat4x4<T> const & m2,\n    T const delta\n)\n{\n    detail::tmat4x4<T> m1rot = extractMatrixRotation(m1);\n    detail::tmat4x4<T> dltRotation = m2 * transpose(m1rot);\n    detail::tvec3<T> dltAxis;\n    T dltAngle;\n    axisAngle(dltRotation, dltAxis, dltAngle);\n    detail::tmat4x4<T> out = axisAngleMatrix(dltAxis, dltAngle * delta) * m1rot;\n    out[3][0] = m1[3][0] + delta * (m2[3][0] - m1[3][0]);\n    out[3][1] = m1[3][1] + delta * (m2[3][1] - m1[3][1]);\n    out[3][2] = m1[3][2] + delta * (m2[3][2] - m1[3][2]);\n    return out;\n}\n```\n","closed_by":{"login":"Groovounet","id":367227,"node_id":"MDQ6VXNlcjM2NzIyNw==","avatar_url":"https://avatars.githubusercontent.com/u/367227?v=4","gravatar_id":"","url":"https://api.github.com/users/Groovounet","html_url":"https://github.com/Groovounet","followers_url":"https://api.github.com/users/Groovounet/followers","following_url":"https://api.github.com/users/Groovounet/following{/other_user}","gists_url":"https://api.github.com/users/Groovounet/gists{/gist_id}","starred_url":"https://api.github.com/users/Groovounet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Groovounet/subscriptions","organizations_url":"https://api.github.com/users/Groovounet/orgs","repos_url":"https://api.github.com/users/Groovounet/repos","events_url":"https://api.github.com/users/Groovounet/events{/privacy}","received_events_url":"https://api.github.com/users/Groovounet/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/g-truc/glm/issues/58/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/g-truc/glm/issues/58/timeline","performed_via_github_app":null,"state_reason":"completed"}