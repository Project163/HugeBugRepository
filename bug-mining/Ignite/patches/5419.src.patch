+                snpDir.getAbsolutePath(),
+                null,
+                false,
+                false,
+                true
+            ).get();
+
+            assertFalse(
+                "Standard snapshot directory must created lazily for in-memory node",
+                new File(U.defaultWorkDirectory(), DFLT_SNAPSHOT_DIRECTORY).exists()
