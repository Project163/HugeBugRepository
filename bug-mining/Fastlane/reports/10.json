 use a Ruby environment manager (e.g. `chruby`, `rbenv`, `rvm`)?\nNo\n","closed_by":{"login":"mfurtak","id":343134,"node_id":"MDQ6VXNlcjM0MzEzNA==","avatar_url":"https://avatars.githubusercontent.com/u/343134?v=4","gravatar_id":"","url":"https://api.github.com/users/mfurtak","html_url":"https://github.com/mfurtak","followers_url":"https://api.github.com/users/mfurtak/followers","following_url":"https://api.github.com/users/mfurtak/following{/other_user}","gists_url":"https://api.github.com/users/mfurtak/gists{/gist_id}","starred_url":"https://api.github.com/users/mfurtak/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mfurtak/subscriptions","organizations_url":"https://api.github.com/users/mfurtak/orgs","repos_url":"https://api.github.com/users/mfurtak/repos","events_url":"https://api.github.com/users/mfurtak/events{/privacy}","received_events_url":"https://api.github.com/users/mfurtak/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/fastlane/fastlane/issues/6285/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/fastlane/fastlane/issues/6285/timeline","performed_via_github_app":null,"state_reason":"completed"}