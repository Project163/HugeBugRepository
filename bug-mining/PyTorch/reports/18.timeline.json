ers_count":98201,"watchers_count":98201,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":27143,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":18135,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["autograd","deep-learning","gpu","machine-learning","neural-network","numpy","python","tensor"],"visibility":"public","forks":27143,"open_issues":18135,"watchers":98201,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/pytorch/pytorch/pulls/44054","html_url":"https://github.com/pytorch/pytorch/pull/44054","diff_url":"https://github.com/pytorch/pytorch/pull/44054.diff","patch_url":"https://github.com/pytorch/pytorch/pull/44054.patch","merged_at":null},"body":"Stack from [ghstack](https://github.com/ezyang/ghstack):\r\n* **#44054 [JIT] Improve error message for unsupported Optional types**\r\n\r\n**Summary**\r\nThis commit improves the error message that is printed when an\r\n`Optional` type annotation with an unsupported contained type is\r\nencountered. At present, the `Optional` is printed as-is, and\r\n`Optional[T]` is syntatic sugar for `Union[T, None]`, so that is what\r\nshows up in the error message and can be confusing. This commit modifies\r\nthe error message so that it prints `T` instead of `Union[T, None]`.\r\n\r\n**Test Plan**\r\nContinuous integration.\r\n\r\nExample of old message:\r\n```\r\nAssertionError: Unsupported annotation typing.Union[typing.List, NoneType] could not be resolved.\r\n```\r\nExample of new message:\r\n```\r\nAssertionError: Unsupported annotation typing.Union[typing.List, NoneType] could not be resolved because typing.List could not be resolved.\r\n```\r\n\r\n**Fixes**\r\nThis commit fixes #42859.\n\nDifferential Revision: [D23490365](https://our.internmc.facebook.com/intern/diff/D23490365)","reactions":{"url":"https://api.github.com/repos/pytorch/pytorch/issues/44054/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/pytorch/pytorch/issues/44054/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":3721555250,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDM3MjE1NTUyNTA=","url":"https://api.github.com/repos/pytorch/pytorch/issues/events/3721555250","actor":{"login":"SplitInfinity","id":4392003,"node_id":"MDQ6VXNlcjQzOTIwMDM=","avatar_url":"https://avatars.githubusercontent.com/u/4392003?v=4","gravatar_id":"","url":"https://api.github.com/users/SplitInfinity","html_url":"https://github.com/SplitInfinity","followers_url":"https://api.github.com/users/SplitInfinity/followers","following_url":"https://api.github.com/users/SplitInfinity/following{/other_user}","gists_url":"https://api.github.com/users/SplitInfinity/gists{/gist_id}","starred_url":"https://api.github.com/users/SplitInfinity/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SplitInfinity/subscriptions","organizations_url":"https://api.github.com/users/SplitInfinity/orgs","repos_url":"https://api.github.com/users/SplitInfinity/repos","events_url":"https://api.github.com/users/SplitInfinity/events{/privacy}","received_events_url":"https://api.github.com/users/SplitInfinity/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"fc4570adaa8f4aa66ae7f29a2cb5a2792ee198d7","commit_url":"https://api.github.com/repos/pytorch/pytorch/commits/fc4570adaa8f4aa66ae7f29a2cb5a2792ee198d7","created_at":"2020-09-02T20:04:05Z","performed_via_github_app":null},{"id":3721555618,"node_id":"MDE1OlJlZmVyZW5jZWRFdmV