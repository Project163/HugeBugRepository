[{"id":6990759536,"node_id":"LE_lADOA-j9z85NtQJwzwAAAAGgroZw","url":"https://api.github.com/repos/pytorch/pytorch/issues/events/6990759536","actor":{"login":"ngimel","id":15841449,"node_id":"MDQ6VXNlcjE1ODQxNDQ5","avatar_url":"https://avatars.githubusercontent.com/u/15841449?v=4","gravatar_id":"","url":"https://api.github.com/users/ngimel","html_url":"https://github.com/ngimel","followers_url":"https://api.github.com/users/ngimel/followers","following_url":"https://api.github.com/users/ngimel/following{/other_user}","gists_url":"https://api.github.com/users/ngimel/gists{/gist_id}","starred_url":"https://api.github.com/users/ngimel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ngimel/subscriptions","organizations_url":"https://api.github.com/users/ngimel/orgs","repos_url":"https://api.github.com/users/ngimel/repos","events_url":"https://api.github.com/users/ngimel/events{/privacy}","received_events_url":"https://api.github.com/users/ngimel/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2022-07-14T03:15:02Z","label":{"name":"module: crash","color":"f7e101"},"performed_via_github_app":null},{"id":6990759849,"node_id":"LE_lADOA-j9z85NtQJwzwAAAAGgroep","url":"https://api.github.com/repos/pytorch/pytorch/issues/events/6990759849","actor":{"login":"ngimel","id":15841449,"node_id":"MDQ6VXNlcjE1ODQxNDQ5","avatar_url":"https://avatars.githubusercontent.com/u/15841449?v=4","gravatar_id":"","url":"https://api.github.com/users/ngimel","html_url":"https://github.com/ngimel","followers_url":"https://api.github.com/users/ngimel/followers","following_url":"https://api.github.com/users/ngimel/following{/other_user}","gists_url":"https://api.github.com/users/ngimel/gists{/gist_id}","starred_url":"https://api.github.com/users/ngimel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ngimel/subscriptions","organizations_url":"https://api.github.com/users/ngimel/orgs","repos_url":"https://api.github.com/users/ngimel/repos","events_url":"https://api.github.com/users/ngimel/events{/privacy}","received_events_url":"https://api.github.com/users/ngimel/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2022-07-14T03:15:08Z","label":{"name":"module: pooling","color":"f7e101"},"performed_via_github_app":null},{"id":6990760221,"node_id":"LE_lADOA-j9z85NtQJwzwAAAAGgrokd","url":"https://api.github.com/repos/pytorch/pytorch/issues/events/6990760221","actor":{"login":"ngimel","id":15841449,"node_id":"MDQ6VXNlcjE1ODQxNDQ5","avatar_url":"https://avatars.githubusercontent.com/u/15841449?v=4","gravatar_id":"","url":"https://api.github.com/users/ngimel","html_url":"https://github.com/ngimel","followers_url":"https://api.github.com/users/ngimel/followers","following_url":"https://api.github.com/users/ngimel/following{/other_user}","gists_url":"https://api.github.com/users/ngimel/gists{/gist_id}","starred_url":"https://api.github.com/users/ngimel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ngimel/subscriptions","organizations_url":"https://api.github.com/users/ngimel/orgs","repos_url":"https://api.github.com/users/ngimel/repos","events_url":"https://api.github.com/users/ngimel/events{/privacy}","received_events_url":"https://api.github.com/users/ngimel/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2022-07-14T03:15:16Z","label":{"name":"triaged","color":"006b75"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/pytorch/pytorch/issues/comments/1192369359","html_url":"https://github.com/pytorch/pytorch/issues/81409#issuecomment-1192369359","issue_url":"https://api.github.com/repos/pytorch/pytorch/issues/81409","id":1192369359,"node_id":"IC_kwDOA-j9z85HEhzP","user":{"login":"ptrblck","id":11662379,"node_id":"MDQ6VXNlcjExNjYyMzc5","avatar_url":"https://avatars.githubusercontent.com/u/11662379?v=4","gravatar_id":"","url":"https://api.github.com/users/ptrblck","html_url":"https://github.com/ptrblck","followers_url":"https://api.github.com/users/ptrblck/followers","following_url":"https://api.github.com/users/ptrblck/following{/other_user}","gists_url":"https://api.github.com/users/ptrblck/gists{/gist_id}","starred_url":"https://api.github.com/users/ptrblck/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ptrblck/subscriptions","organizations_url":"https://api.github.com/users/ptrblck/orgs","repos_url":"https://api.github.com/users/ptrblck/repos","events_url":"https://api.github.com/users/ptrblck/events{/privacy}","received_events_url":"https://api.github.com/users/ptrblck/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-07-22T09:24:08Z","updated_at":"2022-07-22T09:24:08Z","body":"It seems the kernel is running into an invalid read [here](https://github.com/pytorch/pytorch/blob/5dbec7c07c5eedd748fd56359c2d1b980dfa1037/aten/src/ATen/native/cpu/AdaptiveAvgPoolKernel.cpp#L54):\r\n```\r\nsum += accscalar_t(input_ptr[ih * input_width + iw]);\r\n```\r\nwhere `ih` has a value of `5877` and is thus indexing `input_ptr` out-of-bounds.\r\n\r\nThis is unexpected as `ih` is calculated via `c10::irange(ih0, ih1)` and `ih0` as well as `ih1` via:\r\n```\r\n        int64_t ih0 = start_index(oh, output_height, input_height);\r\n        int64_t ih1 = end_index(oh, output_height, input_height);\r\n```\r\nwhich should do the right thing as seen [here](https://github.com/pytorch/pytorch/blob/5dbec7c07c5eedd748fd56359c2d1b980dfa1037/aten/src/ATen/native/AdaptivePooling.h#L21-L26).\r\n\r\nIn the failing iteration we have:\r\n```\r\n(gdb) print ih\r\n$1 = 5877\r\n(gdb) print ih0\r\n$2 = 5874\r\n(gdb) print ih1\r\n$3 = 5878\r\n(gdb) print oh\r\n$4 = 2854\r\n(gdb) print output_height\r\n$5 = (int64_t &) @0x7fffffffc8b0: 2855\r\n(gdb) print input_height\r\n$6 = (int64_t &) @0x7fffffffc8a0: 5877\r\n```\r\nso it seems `ih1` is rounding up.\r\n\r\nIf we check the `end_index` calculation we see:\r\n```\r\nstatic inline int64_t end_index(int64_t a, int64_t b, int64_t c) {\r\n  return (int64_t)std::ceil((float)((a + 1) * c) / b);\r\n}\r\n```\r\nwhich looks correct, as the calculated value should be:\r\n```\r\nceil((float)(2854 + 1) * 5877 / 2855) = 5877\r\n```\r\nHowever, it's also interesting to check the intermediates and we see that `(a + 1) * c` starts to round to even multiples of 2 for integers as it's `>2**24`:\r\n```python\r\na = torch.tensor(2854.)\r\nb = torch.tensor(2855.)\r\nc = torch.tensor(5877.)\r\n\r\nret = (a + 1) * c / b\r\nprint(ret)\r\n# tensor(5877.0005) !!!\r\n\r\nprint(((a + 1) * c) > 2**24)\r\n# tensor(True)\r\n```\r\nThe `ceil` operation then rounds the value up to `5878` which creates the seg fault.\r\n\r\nOne solution could be to use `double` in:\r\n```\r\nreturn (int64_t)std::ceil((double)((a + 1) * c) / b);\r\n```\r\nas `float64` starts to round on integer values to even multiples of 2 for values `>2**53`, but I'm unsure if this could yield a performance overhead (I would not think so).\r\nWhat do you think @ngimel?\r\n\r\n\r\n\r\n","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/pytorch/pytorch/issues/comments/1192369359/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ptrblck","id":11662379,"node_id":"MDQ6VXNlcjExNjYyMzc5","avatar_url":"https://avatars.githubusercontent.com/u/11662379?v=4","gravatar_id":"","url":"https://api.github.com/users/ptrblck","html_url":"https://github.com/ptrblck","followers_url":"https://api.github.com/users/ptrblck/followers","following_url":"https://api.github.com/users/ptrblck/following{/other_user}","gists_url":"https://api.github.com/users/ptrblck/gists{/gist_id}","starred_url":"https://api.github.com/users/ptrblck/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ptrblck/subscriptions","organizations_url":"https://api.github.com/users/ptrblck/orgs","repos_url":"https://api.github.com/users/ptrblck/repos","events_url":"https://api.github.com/users/ptrblck/events{/privacy}","received_events_url":"https://api.github.com/users/ptrblck/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":7045043164,"node_id":"MEE_lADOA-j9z85NtQJwzwAAAAGj6tPc","url":"https://api.github.com/repos/pytorch/pytorch/issues/events/7045043164","actor":{"login":"ngimel","id":15841449,"node_id":"MDQ6VXNlcjE1ODQxNDQ5","avatar_url":"https://avatars.githubusercontent.com/u/15841449?v=4","gravatar_id":"","url":"https://api.github.com/users/ngimel","html_url":"https://github.com/ngimel","followers_url":"https://api.github.com/users/ngimel/followers","following_url":"https://api.github.com/users/ngimel/following{/other_user}","gists_url":"https://api.github.com/users/ngimel/gists{/gist_id}","starred_url":"https://api.github.com/users/ngimel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ngimel/subscriptions","organizations_url":"https://api.github.com/users/ngimel/orgs","repos_url":"https://api.github.com/users/ngimel/repos","events_url":"https://api.github.com/users/ngimel/events{/privacy}","received_events_url":"https://api.github.com/users/ngimel/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"mentioned","commit_id":null,"commit_url":null,"created_at":"2022-07-22T09:24:08Z","performed_via_github_app":null},{"id":7045043173,"node_id":"SE_lADOA-j9z85NtQJwzwAAAAGj6tPl","url":"https://api.github.com/repos/pytorch/pytorch/issues/events/7045043173","actor":{"login":"ngimel","id":15841449,"node_id":"MDQ6VXNlcjE1ODQxNDQ5","avatar_url":"https://avatars.githubusercontent.com/u/15841449?v=4","gravatar_id":"","url":"https://api.gi