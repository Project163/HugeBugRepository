ers/ZyX-I/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2017-07-04T14:56:09Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/neovim/neovim/issues/comments/312901868","html_url":"https://github.com/neovim/neovim/issues/6956#issuecomment-312901868","issue_url":"https://api.github.com/repos/neovim/neovim/issues/6956","id":312901868,"node_id":"MDEyOklzc3VlQ29tbWVudDMxMjkwMTg2OA==","user":{"login":"ZyX-I","id":322097,"node_id":"MDQ6VXNlcjMyMjA5Nw==","avatar_url":"https://avatars.githubusercontent.com/u/322097?v=4","gravatar_id":"","url":"https://api.github.com/users/ZyX-I","html_url":"https://github.com/ZyX-I","followers_url":"https://api.github.com/users/ZyX-I/followers","following_url":"https://api.github.com/users/ZyX-I/following{/other_user}","gists_url":"https://api.github.com/users/ZyX-I/gists{/gist_id}","starred_url":"https://api.github.com/users/ZyX-I/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ZyX-I/subscriptions","organizations_url":"https://api.github.com/users/ZyX-I/orgs","repos_url":"https://api.github.com/users/ZyX-I/repos","events_url":"https://api.github.com/users/ZyX-I/events{/privacy}","received_events_url":"https://api.github.com/users/ZyX-I/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-07-04T15:14:27Z","updated_at":"2017-07-04T15:16:45Z","body":"@wsdjeg This is not what you should do specifically for `<Esc>`: being a single byte it will return a number. What normally is done with `getchar()` is *first* converting `getchar()` output to a string *if* its output is number and only then doing anything with it at all: e.g. just always use wrapper\r\n\r\n ```VimL\r\nfunction Getchar(...)\r\n    let ret = call('getchar', a:000)\r\n    return (type(ret) == type(0) ? nr2char(ret) : ret)\r\nendfunction\r\n```\r\n\r\nThis way you do not need to bother which of the keys are represented with what type of the output.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/neovim/neovim/issues/comments/312901868/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ZyX-I","id":322097,"node_id":"MDQ6VXNlcjMyMjA5Nw==","avatar_url":"https://avatars.githubusercontent.com/u/322097?v=4","gravatar_id":"","url":"https://api.github.com/users/ZyX-I","html_url":"https://github.com/ZyX-I","followers_url":"https://api.github.com/users/ZyX-I/followers","following_url":"https://api.github.com/users/ZyX-I/following{/other_user}","gists_url":"https://api.github.com/users/ZyX-I/gists{/gist_id}","starred_url":"https://api.github.com/users/ZyX-I/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ZyX-I/subscriptions","organizations_url":"https://api.github.com/users/ZyX-I/orgs","repos_url":"https://api.github.com/users/ZyX-I/repos","events_url":"https://api.github.com/users/ZyX-I/events{/privacy}","received_events_url":"https://api.github.com/users/ZyX-I/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1149754740,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50MTE0OTc1NDc0MA==","url":"https://api.github.com/repos/neovim/neovim/issues/events/1149754740","actor":{"login":"wsdjeg","id":13142418,"node_id":"MDQ6VXNlcjEzMTQyNDE4","avatar_url":"https://avatars.githubusercontent.com/u/13142418?v=4","gravatar_id":"","url":"https://api.github.com/users/wsdjeg","html_url":"https://github.com/wsdjeg","followers_url":"https://api.github.com/users/wsdjeg/followers","following_url":"https://api.github.com/users/wsdjeg/following{/other_user}","gists_url":"https://api.github.com/users/wsdjeg/gists{/gist_id}","starred_url":"https://api.github.com/users/wsdjeg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wsdjeg/subscriptions","organizations_url"