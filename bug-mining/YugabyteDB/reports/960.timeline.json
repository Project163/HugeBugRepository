wner}{/repo}","subscriptions_url":"https://api.github.com/users/yugabyte-ci/subscriptions","organizations_url":"https://api.github.com/users/yugabyte-ci/orgs","repos_url":"https://api.github.com/users/yugabyte-ci/repos","events_url":"https://api.github.com/users/yugabyte-ci/events{/privacy}","received_events_url":"https://api.github.com/users/yugabyte-ci/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"unlabeled","commit_id":null,"commit_url":null,"created_at":"2023-05-09T20:51:33Z","label":{"name":"status/awaiting-triage","color":"E33F0D"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1542617716","html_url":"https://github.com/yugabyte/yugabyte-db/issues/17244#issuecomment-1542617716","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/17244","id":1542617716,"node_id":"IC_kwDOBlCVUc5b8np0","user":{"login":"Huqicheng","id":31775227,"node_id":"MDQ6VXNlcjMxNzc1MjI3","avatar_url":"https://avatars.githubusercontent.com/u/31775227?v=4","gravatar_id":"","url":"https://api.github.com/users/Huqicheng","html_url":"https://github.com/Huqicheng","followers_url":"https://api.github.com/users/Huqicheng/followers","following_url":"https://api.github.com/users/Huqicheng/following{/other_user}","gists_url":"https://api.github.com/users/Huqicheng/gists{/gist_id}","starred_url":"https://api.github.com/users/Huqicheng/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Huqicheng/subscriptions","organizations_url":"https://api.github.com/users/Huqicheng/orgs","repos_url":"https://api.github.com/users/Huqicheng/repos","events_url":"https://api.github.com/users/Huqicheng/events{/privacy}","received_events_url":"https://api.github.com/users/Huqicheng/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-05-10T18:16:24Z","updated_at":"2023-05-10T18:23:45Z","body":"Some use case of RPC is first prepare an rpc under the lock (reserve in the calls_ vector) and setting the call out of lock.\r\n```cpp\r\nRpcs::Handle Rpcs::Prepare() {\r\n  std::lock_guard<std::mutex> lock(*mutex_);\r\n  if (shutdown_) {\r\n    return InvalidHandle();\r\n  }\r\n  calls_.emplace_back();\r\n  return --calls_.end();\r\n}\r\n```\r\n\r\n```cpp\r\n    auto handle = rpcs_.Prepare();\r\n    if (handle != rpcs_.InvalidHandle()) {\r\n      *handle = UpdateTransaction(\r\n          TransactionRpcDeadline(),\r\n          nullptr /* remote_tablet */,\r\n          *client_result,\r\n          &req,\r\n          [this, handle](const Status& status,\r\n                         const tserver::UpdateTransactionRequestPB& req,\r\n                         const tserver::UpdateTransactionResponsePB& resp) {\r\n            client::UpdateClock(resp, &participant_context_);\r\n            rpcs_.Unregister(handle);\r\n            LOG_IF_WITH_PREFIX(WARNING, !status.ok()) << \"Failed to send applied: \" << status;\r\n          });\r\n      (**handle).SendRpc();\r\n    }\r\n```\r\n\r\nThis might have race with `DoRequestAbortAll`\r\n```cpp\r\nCoarseTimePoint Rpcs::DoRequestAbortAll(RequestShutdown shutdown) {\r\n  std::vector<Calls::value_type> calls;\r\n  {\r\n    std::lock_guard<std::mutex> lock(*mutex_);\r\n    if (!shutdown_) {\r\n      shutdown_ = shutdown;\r\n      calls.reserve(calls_.size());\r\n      calls.assign(calls_.begin(), calls_.end());\r\n    }\r\n  }\r\n```\r\n\r\nIt might copy a `nullptr` from the calls_ vector.\r\n\r\nNoticed that many other cases start an rpc with `RegisterAndStart`, which seems thread safe. What's the benefit with `Prepare`?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1542617716/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Huqicheng","id":31775227,"node_id":"MDQ6VXNlcjMxNzc1MjI3","avatar_url":"https://avatars.githubusercontent.com/u/31775227?v=4","gravatar_id":"","url":"https://api.github.com/users/Huqicheng","html_url":"https://github.com/Huqicheng","followers_url":"https://api.github.com/users/Huqicheng/followers","following_url":"https://api.github.com/users/Huqicheng/following{/other_user}","gists_url":"https://api.github.com/users/Huqicheng/gists{/gist_id}","starred_url":"https://api.github.com/users/Huqicheng/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Huqicheng/subscriptions","organizations_url":"https://api.github.com/users/Huqicheng/orgs","repos_url":"https://api.github.com/users/Huqicheng/repos","events_url":"https://api.github.com/users/Huqicheng/events{/privacy}","received_events_url":"https://api.github.com/users/Huqicheng/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1542689706","html_url":"https://github.com/yugabyte/yugabyte-db/issues/17244#issuecomment-1542689706","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/17244","id":1542689706,"node_id":"IC_kwDOBlCVUc5b85Oq","user":{"login":"Huqicheng","id":31775227,"node_id":"MDQ6VXNlcjMxNzc1MjI3","avatar_url":"https://avatars.githubusercontent.com/u/31775227?v=4","gravatar_id":"","url":"https://api.github.com/users/Huqicheng","html_url":"https://github.com/Huqicheng","followers_url":"https://api.github.com/users/Huqicheng/followers","following_url":"https://api.github.com/users/Huqicheng/following{/other_user}","gists_url":"https://api.github.com/users/Huqicheng/gists{/gist_id}","starred_url":"https://api.github.com/users/Huqicheng/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Huqicheng/subscriptions","organizations_url":"https://api.github.com/users/Huqicheng/orgs","repos_url":"https://api.github.com/users/Huqicheng/repos","events_url":"https://api.github.com/users/Huqicheng/events{/privacy}","received_events_url":"https://api.github.com/users/Huqicheng/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-05-10T19:22:26Z","updated_at":"2023-05-10T19:22:26Z","body":"The root cause should be\r\n```cpp\r\n  auto rpc_handle = rpcs_.Prepare();\r\n  if (rpc_handle == rpcs_.InvalidHandle()) {\r\n    LOG(WARNING) << \"Shutting down. Cannot send GetTransactionStatus: \" << transaction_metadata;\r\n    return;\r\n  }\r\n  auto client = client_future_.get();\r\n  if (!client) {\r\n    LOG(WARNING) << \"Shutting down. Cannot get GetTransactionStatus: \" << transaction_metadata;\r\n    return;\r\n  }\r\n```\r\n\r\nThe rpc is prepared with an empty call but returned without setting it because the master is shutting down. Seems we can skip the check of call.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/1542689706/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"Huqicheng","id":31775227,"node_id":"MDQ6VXNlcjMxNzc1MjI3","avatar_url":"https://avatars.githubusercontent.com/u/31775227?v=4","gravatar_id":"","url":"https://api.github.com/users/Huqicheng","html_url":"https://github.com/Huqicheng","followers_url":"https://api.github.com/users/Huqicheng/followers","following_url":"https://api.github.com/users/Huqicheng/following{/other_user}","gists_url":"https://api.github.com/users/Huqicheng/gists{/gist_id}","starred_url":"https://api.github.com/users/Huqicheng/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Huqicheng/subscriptions","organizations_url":"https://api.github.com/users/Huqicheng/orgs","repos_url":"https://api.github.com/users/Huqicheng/repos","events_url":"https://api.github.com/users/Huqicheng/events{/privacy}","received_events_url":"https://api.github.com/users/Huqicheng/received_events","type":"Use