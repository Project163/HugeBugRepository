+			{`@for`, Keyword, Push("for")},
+			{`@(debug|warn|if|while)`, Keyword, Push("value")},
+			{`(@mixin)( [\w-]+)`, ByGroups(Keyword, NameFunction), Push("value")},
+			{`(@include)( [\w-]+)`, ByGroups(Keyword, NameDecorator), Push("value")},
+			{`@extend`, Keyword, Push("selector")},
