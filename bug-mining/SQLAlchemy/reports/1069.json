hub.com/users/gordthompson/events{/privacy}","received_events_url":"https://api.github.com/users/gordthompson/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":{"url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/milestones/90","html_url":"https://github.com/sqlalchemy/sqlalchemy/milestone/90","labels_url":"https://api.github.com/repos/sqlalchemy/sqlalchemy/milestones/90/labels","id":4888003,"node_id":"MDk6TWlsZXN0b25lNDg4ODAwMw==","number":90,"title":"1.3.x","description":null,"creator":{"login":"zzzeek","id":128223,"node_id":"MDQ6VXNlcjEyODIyMw==","avatar_url":"https://avatars.githubusercontent.com/u/128223?v=4","gravatar_id":"","url":"https://api.github.com/users/zzzeek","html_url":"https://github.com/zzzeek","followers_url":"https://api.github.com/users/zzzeek/followers","following_url":"https://api.github.com/users/zzzeek/following{/other_user}","gists_url":"https://api.github.com/users/zzzeek/gists{/gist_id}","starred_url":"https://api.github.com/users/zzzeek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zzzeek/subscriptions","organizations_url":"https://api.github.com/users/zzzeek/orgs","repos_url":"https://api.github.com/users/zzzeek/repos","events_url":"https://api.github.com/users/zzzeek/events{/privacy}","received_events_url":"https://api.github.com/users/zzzeek/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":279,"state":"closed","created_at":"2019-11-28T15:49:07Z","updated_at":"2024-07-03T20:28:12Z","due_on":null,"closed_at":"2023-01-27T18:28:50Z"},"comments":6,"created_at":"2021-03-05T22:20:09Z","updated_at":"2021-03-07T16:30:52Z","closed_at":"2021-03-07T16:30:52Z","author_association":"NONE","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**Describe the bug**\r\nCreating the same table in two different databases, emits different sql.\r\n\r\nWhen using a boolean constraint name, and a naming convention, the constraint is not emitted, the second time the table is created.\r\n\r\n**Expected behavior**\r\nCreating the same table in two different databases, should emit the same sql.\r\n\r\n**To Reproduce**\r\n```py\r\n#!/usr/bin/env python3\r\n# SQLAlchemy==1.3.23\r\nfrom sqlalchemy import create_engine\r\nfrom sqlalchemy.ext.declarative import declarative_base\r\nfrom sqlalchemy.schema import Column, MetaData\r\nfrom sqlalchemy.types import Boolean, Integer\r\n\r\nnaming_convention = {\r\n    \"ck\": \"ck_%(table_name)s_%(constraint_name)s\",\r\n}\r\nmeta = MetaData(naming_convention=naming_convention)\r\n\r\nBase = declarative_base(metadata=meta)\r\n\r\nclass User(Base):\r\n    __tablename__ = \"Users\"\r\n\r\n    id = Column(\"user_id\", Integer, primary_key=True)\r\n    is_active = Column(Boolean(name=\"is_active\"))\r\n\r\nengine = create_engine('sqlite:///:memory:', echo=True)\r\nUser.__table__.create(bind=engine)\r\n\"\"\"\r\n2021-03-05 17:13:49,500 INFO sqlalchemy.engine.base.Engine SELECT CAST('test plain returns' AS VARCHAR(60)) AS anon_1\r\n2021-03-05 17:13:49,500 INFO sqlalchemy.engine.base.Engine ()\r\n2021-03-05 17:13:49,501 INFO sqlalchemy.engine.base.Engine SELECT CAST('test unicode returns' AS VARCHAR(60)) AS anon_1\r\n2021-03-05 17:13:49,501 INFO sqlalchemy.engine.base.Engine ()\r\n2021-03-05 17:13:49,502 INFO sqlalchemy.engine.base.Engine\r\nCREATE TABLE \"Users\" (\r\n    user_id INTEGER NOT NULL,\r\n    is_active BOOLEAN,\r\n    PRIMARY KEY (user_id),\r\n    CONSTRAINT \"ck_Users_is_active\" CHECK (is_active IN (0, 1))\r\n)\r\n\r\n\r\n2021-03-05 17:13:49,502 INFO sqlalchemy.engine.base.Engine ()\r\n2021-03-05 17:13:49,503 INFO sqlalchemy.engine.base.Engine COMMIT\r\n\"\"\"\r\n\r\nengine = create_engine('sqlite:///:memory:', echo=True)\r\nUser.__table__.create(bind=engine)\r\n\"\"\"\r\n2021-03-05 17:13:49,504 INFO sqlalchemy.engine.base.Engine SELECT CAST('test plain returns' AS VARCHAR(60)) AS anon_1\r\n2021-03-05 17:13:49,504 INFO sqlalchemy.engine.base.Engine ()\r\n2021-03-05 17:13:49,505 INFO sqlalchemy.engine.base.Engine SELECT CAST('test unicode returns' AS VARCHAR(60)) AS anon_1\r\n2021-03-05 17:13:49,505 INFO sqlalchemy.engine.base.Engine ()\r\n2021-03-05 17:13:49,505 INFO sqlalchemy.engine.base.Engine\r\nCREATE TABLE \"Users\" (\r\n    user_id INTEGER NOT NULL,\r\n    is_active BOOLEAN,\r\n    PRIMARY KEY (user_id),\r\n    CHECK (is_active IN (0, 1))\r\n)\r\n\r\n\r\n2021-03-05 17:13:49,506 INFO sqlalchemy.engine.base.Engine ()\r\n2021-03-05 17:13:49,506 INFO sqlalchemy.engine.base.Engine COMMIT\r\n\"\"\"\r\n```\r\n\r\n**Versions.**\r\n - OS: 20.04.1 LTS (Focal Fossa)\r\n - Python: Python 3.8.5\r\n - SQLAlchemy: SQLAlchemy==1.3.23\r\n - Database: sqlite\r\n - DBAPI: default sqlite?\r\n\r\n\r\n**Context**\r\n\r\nI narrowed down the problem to:\r\nhttps://github.com/sqlalchemy/sqlalchemy/blob/rel_1_3_23/lib/sqlalchemy/sql/naming.py#L56\r\n\r\nIf I remove that if statement, the constraint name is not lost. However, I have no clue what else this impacts.\r\n\r\nThanks You for SQLAlchemy! :-)\r\n","closed_by":{"login":"sqlalchemy-bot","id":36047385,"node_id":"MDQ6VXNlcjM2MDQ3Mzg1","avatar_url":"https://avatars.githubusercontent.com/u/36047385?v=4","gravatar_id":"","url":"https://api.github.com/users/sqlalchemy-bot","html_url":"https://github.com/sqlalchemy-bot","followers_url":"https://api.github.com/users/sqlalchemy-bot/followers","following_url":"https://api.github.com/users/sqlalchemy-bot/following{/other_user}","gists_url":"https://api.github.com/users/sqlalchemy-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/sqlalchemy-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sqlalchemy-bot/subscriptions","organizations_url":"https://api.github.com/users/sqlalchemy-bot/orgs","repos_url":"https://api.github.com/users/sq