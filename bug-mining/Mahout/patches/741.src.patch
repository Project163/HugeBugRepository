+
+# Skip qdp tests if dependencies are not available
+collect_ignore_glob = []
+
+try:
+    import _qdp  # noqa: F401
+    import torch  # noqa: F401
+except ImportError:
+    collect_ignore_glob.append("qdp/*.py")
+
+
