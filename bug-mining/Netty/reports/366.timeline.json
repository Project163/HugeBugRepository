[{"url":"https://api.github.com/repos/netty/netty/issues/comments/51036740","html_url":"https://github.com/netty/netty/issues/2728#issuecomment-51036740","issue_url":"https://api.github.com/repos/netty/netty/issues/2728","id":51036740,"node_id":"MDEyOklzc3VlQ29tbWVudDUxMDM2NzQw","user":{"login":"martin-robo","id":1705517,"node_id":"MDQ6VXNlcjE3MDU1MTc=","avatar_url":"https://avatars.githubusercontent.com/u/1705517?v=4","gravatar_id":"","url":"https://api.github.com/users/martin-robo","html_url":"https://github.com/martin-robo","followers_url":"https://api.github.com/users/martin-robo/followers","following_url":"https://api.github.com/users/martin-robo/following{/other_user}","gists_url":"https://api.github.com/users/martin-robo/gists{/gist_id}","starred_url":"https://api.github.com/users/martin-robo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/martin-robo/subscriptions","organizations_url":"https://api.github.com/users/martin-robo/orgs","repos_url":"https://api.github.com/users/martin-robo/repos","events_url":"https://api.github.com/users/martin-robo/events{/privacy}","received_events_url":"https://api.github.com/users/martin-robo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2014-08-04T09:36:30Z","updated_at":"2014-08-04T09:36:30Z","body":"My unit test:\n\n<pre>\nimport junit.framework.Assert;\nimport org.jboss.netty.channel.ChannelFuture;\nimport org.jboss.netty.channel.DefaultChannelFuture;\nimport org.junit.Test;\npublic class ChannelFutureTest {\n    private final ChannelFuture future = new DefaultChannelFuture(createChannel(), false);\n    @Test\n    public void setSuccess() {\n        Assert.assertTrue(this.future.setSuccess());\n        Assert.assertTrue(this.future.isDone());\n        Assert.assertTrue(this.future.isSuccess());\n        Assert.assertNull(this.future.getCause());\n    }\n    @Test\n    public void setFailure() {\n        Assert.assertTrue(this.future.setFailure(new IllegalStateException()));\n        Assert.assertTrue(this.future.isDone());\n        Assert.assertFalse(this.future.isSuccess());\n        Assert.assertNotNull(this.future.getCause());\n    }\n    @Test\n    public void setFailureWithoutException() {\n        Assert.assertTrue(this.future.setFailure(null));\n        Assert.assertTrue(this.future.isDone());\n        Assert.assertFalse(this.future.isSuccess());\n        Assert.assertNull(this.future.getCause());\n    }\n}\n</pre>\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/netty/netty/issues/comments/51036740/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"martin-robo","id":1705517,"node_id":"MDQ6VXNlcjE3MDU1MTc=","avatar_url":"https://avatars.githubusercontent.com/u/1705517?v=4","gravatar_id":"","url":"https://api.github.com/users/martin-robo","html_url":"https://github.com/martin-robo","followers_url":"https://api.github.com/users/martin-robo/followers","following_url":"https://api.github.com/users/martin-robo/following{/other_user}","gists_url":"https://api.github.com/users/martin-robo/gists{/gist_id}","starred_url":"https://api.github.com/users/martin-robo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/martin-robo/subscriptions","organizations_url":"https://api.github.com/users/martin-robo/orgs","repos_url":"https://api.github.com/users/martin-robo/repos","events_url":"https://api.github.com/users/martin-robo/events{/privacy}","received_events_url":"https://api.github.com/users/martin-robo/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/netty/netty/issues/comments/51042602","html_url":"https://github.com/netty/netty/issues/2728#issuecomment-51042602","issue_url":"https://api.github.com/repos/netty/netty/issues/2728","id":51042602,"node_id":"MDEyOklzc3VlQ29tbWVudD