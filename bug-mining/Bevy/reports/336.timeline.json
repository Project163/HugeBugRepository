26200911","actor":{"login":"MrGVSV","id":49806985,"node_id":"MDQ6VXNlcjQ5ODA2OTg1","avatar_url":"https://avatars.githubusercontent.com/u/49806985?v=4","gravatar_id":"","url":"https://api.github.com/users/MrGVSV","html_url":"https://github.com/MrGVSV","followers_url":"https://api.github.com/users/MrGVSV/followers","following_url":"https://api.github.com/users/MrGVSV/following{/other_user}","gists_url":"https://api.github.com/users/MrGVSV/gists{/gist_id}","starred_url":"https://api.github.com/users/MrGVSV/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MrGVSV/subscriptions","organizations_url":"https://api.github.com/users/MrGVSV/orgs","repos_url":"https://api.github.com/users/MrGVSV/repos","events_url":"https://api.github.com/users/MrGVSV/events{/privacy}","received_events_url":"https://api.github.com/users/MrGVSV/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"unlabeled","commit_id":null,"commit_url":null,"created_at":"2023-04-17T15:37:11Z","label":{"name":"S-Needs-Triage","color":"D876e3"},"performed_via_github_app":null},{"id":9026200958,"node_id":"LE_lADODf6-U85jmeS-zwAAAAIaAOV-","url":"https://api.github.com/repos/bevyengine/bevy/issues/events/9026200958","actor":{"login":"MrGVSV","id":49806985,"node_id":"MDQ6VXNlcjQ5ODA2OTg1","avatar_url":"https://avatars.githubusercontent.com/u/49806985?v=4","gravatar_id":"","url":"https://api.github.com/users/MrGVSV","html_url":"https://github.com/MrGVSV","followers_url":"https://api.github.com/users/MrGVSV/followers","following_url":"https://api.github.com/users/MrGVSV/following{/other_user}","gists_url":"https://api.github.com/users/MrGVSV/gists{/gist_id}","starred_url":"https://api.github.com/users/MrGVSV/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MrGVSV/subscriptions","organizations_url":"https://api.github.com/users/MrGVSV/orgs","repos_url":"https://api.github.com/users/MrGVSV/repos","events_url":"https://api.github.com/users/MrGVSV/events{/privacy}","received_events_url":"https://api.github.com/users/MrGVSV/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2023-04-17T15:37:11Z","label":{"name":"A-Scenes","color":"C6a751"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1511624610","html_url":"https://github.com/bevyengine/bevy/issues/8415#issuecomment-1511624610","issue_url":"https://api.github.com/repos/bevyengine/bevy/issues/8415","id":1511624610,"node_id":"IC_kwDODf6-U85aGY-i","user":{"login":"MrGVSV","id":49806985,"node_id":"MDQ6VXNlcjQ5ODA2OTg1","avatar_url":"https://avatars.githubusercontent.com/u/49806985?v=4","gravatar_id":"","url":"https://api.github.com/users/MrGVSV","html_url":"https://github.com/MrGVSV","followers_url":"https://api.github.com/users/MrGVSV/followers","following_url":"https://api.github.com/users/MrGVSV/following{/other_user}","gists_url":"https://api.github.com/users/MrGVSV/gists{/gist_id}","starred_url":"https://api.github.com/users/MrGVSV/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MrGVSV/subscriptions","organizations_url":"https://api.github.com/users/MrGVSV/orgs","repos_url":"https://api.github.com/users/MrGVSV/repos","events_url":"https://api.github.com/users/MrGVSV/events{/privacy}","received_events_url":"https://api.github.com/users/MrGVSV/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-04-17T15:44:14Z","updated_at":"2023-04-17T15:52:51Z","body":"<details>\r\n<summary>Original message</summary>\r\n\r\nThis is actually expected behavior.\r\n\r\nThe scene (de)serializer can only handle components and resources that register `ReflectComponent` and `ReflectResource`, respectively. This means that if the type is not registered, it will not be able to access those type data to perform the required operations.\r\n\r\nThe fix here is to just register all types that need to be (de)serialized. It's a bit annoying, but it's the best solution we have given Rust's current tooling.\r\n\r\nSo in this particular case, the solution would be to register `BreakLineOn`.\r\n\r\n---\r\n\r\nAnd for reference, `Vec3` is registered here:\r\nhttps://github.com/bevyengine/bevy/blob/c488b7089c58c99371af25b7e27551e892df3dcf/crates/bevy_core/src/lib.rs#L83\r\n\r\nBut it doesn't need to be for `Transform` to be (de)serializable in scenes. Again, the important thing is that `Transform` is registered and also registers `ReflectComponent`— which it does using the `#[reflect(Component)]` attribute.\r\n\r\n</details>\r\n\r\n---\r\n\r\n\r\n**Edit:** Seems I'm wrong here. I mistakenly thought `BreakLineOn` was a `Component` (and also forgot how reflection's (de)serialization works for a moment haha).\r\n\r\nStill, the solution here is to just register the type in `bevy_text`.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/bevyengine/bevy/issues/comments/1511624610/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"MrGVSV","id":49806985,"node_id":"MDQ6VXNlcjQ5ODA2OTg1","avatar_url":"https://avatars.githubusercontent.com/u/49806985?v=4","gravatar_id":"","url":"https://api.github.com/users/MrGVSV","html_url":"https://github.com/MrGVSV","followers_url":"https://api.github.com/users/MrGVSV/followers","following_url":"https://api.github.com/users/MrGVSV/following{/other_user}","gists_url":"https://api.github.com/users/MrGVSV/gists{/gist_id}","starred_url":"https://api.github.com/users/MrGVSV/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MrGVSV/subscriptions","organizations_url":"https://api.github.com/users/MrGVSV/orgs","repos_url":"https://api.github.com/users/MrGVSV/repos","events_url":"https://api.github.com/users/MrGVSV/events{/privacy}","received_e