t%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2024-10-26T10:23:10Z","label":{"name":"TypeScript","color":"226CDE"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/2439807945","html_url":"https://github.com/vercel/next.js/issues/71901#issuecomment-2439807945","issue_url":"https://api.github.com/repos/vercel/next.js/issues/71901","id":2439807945,"node_id":"IC_kwDOBC3Cis6RbIPJ","user":{"login":"wiscaksono","id":63142229,"node_id":"MDQ6VXNlcjYzMTQyMjI5","avatar_url":"https://avatars.githubusercontent.com/u/63142229?v=4","gravatar_id":"","url":"https://api.github.com/users/wiscaksono","html_url":"https://github.com/wiscaksono","followers_url":"https://api.github.com/users/wiscaksono/followers","following_url":"https://api.github.com/users/wiscaksono/following{/other_user}","gists_url":"https://api.github.com/users/wiscaksono/gists{/gist_id}","starred_url":"https://api.github.com/users/wiscaksono/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wiscaksono/subscriptions","organizations_url":"https://api.github.com/users/wiscaksono/orgs","repos_url":"https://api.github.com/users/wiscaksono/repos","events_url":"https://api.github.com/users/wiscaksono/events{/privacy}","received_events_url":"https://api.github.com/users/wiscaksono/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-10-27T02:19:14Z","updated_at":"2024-10-27T02:19:14Z","body":"The documentation example might be misleading. The cacheTag function uses rest parameters (...tags: string[]), so it expects individual string arguments rather than an array. Here's how to fix it:\r\n\r\n```typescript\r\n// ❌ Incorrect - passing array\r\ncacheTag([\"tag-1\", \"tag-2\"]);\r\n\r\n// ✅ Correct - passing individual strings\r\ncacheTag(\"tag-1\", \"tag-2\");\r\n```\r\n\r\nThe TypeScript signature is:\r\n```typescript\r\nfunction cacheTag(...tags: string[]): void\r\n```\r\nSee the type definition [here](https://github.com/vercel/next.js/blob/ca5f29d81b011c3a01e2372118b29836f1df0fa7/packages/next/src/server/use-cache/cache-tag.ts#L4C1-L4C52)\r\n\r\nThis means you can pass any number of string arguments, but they need to be passed as separate arguments, not as an array. The rest parameter syntax (...) will automatically collect them into an array internally.\r\nIf you have an array of tags that you need to pass, you can spread them:\r\n\r\n```typescript\r\nconst tags = [\"tag-1\", \"tag-2\"];\r\ncacheTag(...tags);\r\n```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/comments/2439807945/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"wiscaksono","id":63142229,"node_id":"MDQ6VXNlcjYzMTQyMjI5","avatar_url":"https://avatars.githubusercontent.com/u/63142229?v=4","gravatar_id":"","url":"https://api.github.com/users/wiscaksono","html_url":"https://github.com/wiscaksono","followers_url":"https://api.github.com/users/wiscaksono/followers","following_url":"https://api.github.com/users/wiscaksono/following{/other_user}","gists_url":"https://api.github.com/users/wiscaksono/gists{/gist_id}","starred_url":"https://api.github.com/users/wiscaksono/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wiscaksono/subscriptions","organizations_url":"https://api.gith