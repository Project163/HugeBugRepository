+---+-----------
+ 1 | {1,2,3,4}
+(1 row)
+
+-- the || operator.
+UPDATE array_t1 SET arr = arr||'{5, 6}'::int[] WHERE k = 1;
+SELECT * FROM array_t1 ORDER BY k;
+ k |      arr
+---+---------------
+ 1 | {1,2,3,4,5,6}
+(1 row)
+
+-- array_cat().
+UPDATE array_t1 SET arr = array_cat(arr, '{7, 8}'::int[]) WHERE k = 1;
