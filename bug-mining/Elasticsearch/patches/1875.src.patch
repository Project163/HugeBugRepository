+            books.add(Tuple.tuple(String.format(Locale.ROOT, "%03d", i), chapters));
+        }
+        try (Directory directory = newDirectory()) {
+            try (RandomIndexWriter iw = new RandomIndexWriter(random(), directory)) {
+                int id = 0;
