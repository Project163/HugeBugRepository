git_commits_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/commits{/sha}","comments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/comments{/number}","issue_comment_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments{/number}","contents_url":"https://api.github.com/repos/yugabyte/yugabyte-db/contents/{+path}","compare_url":"https://api.github.com/repos/yugabyte/yugabyte-db/compare/{base}...{head}","merges_url":"https://api.github.com/repos/yugabyte/yugabyte-db/merges","archive_url":"https://api.github.com/repos/yugabyte/yugabyte-db/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/yugabyte/yugabyte-db/downloads","issues_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues{/number}","pulls_url":"https://api.github.com/repos/yugabyte/yugabyte-db/pulls{/number}","milestones_url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones{/number}","notifications_url":"https://api.github.com/repos/yugabyte/yugabyte-db/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels{/name}","releases_url":"https://api.github.com/repos/yugabyte/yugabyte-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Using 11.2-YB-2.0.9.0-b0 on Ubuntu 18.04.\r\n\r\nThis compilation attempt is enough to demonstrate the restriction:\r\n```\r\n\\set VERBOSITY verbose\r\ncreate  procedure p()\r\n  language plpgsql\r\nas $body$\r\ndeclare\r\n  cur refcursor;\r\nbegin\r\n  null;\r\nend;\r\n$body$;\r\n```\r\nThe attempt causes this error:\r\n```\r\nERROR:  0A000: Declare Cursor Variable not supported yet\r\nLINE 5:   cur refcursor;\r\n          ^\r\nHINT:  Please report the issue on https://github.com/YugaByte/yugabyte-db/issues\r\nLOCATION:  ybc_not_support, pl_gram.y:4119\r\n```\r\nI've copied the text of my intended function at the end so that you can see why it benefits from dynamic SQL. I developed and tested it in vanilla PG 11.2 where (of course) it works fine.\r\n\r\nAt least I have a choice of two workarounds:\r\n\r\n(1) Use the `list_agg()` built-in in the select list so that the query returns a single result, use the simple `execute Stmt into result` (which I have shown works) and step through the array of records programmatically. This is, anyway, a generally useful way to implement \"bulk collect\" (as Oracle Database calls it and for which plpgsql has no corresponding functionality). Only thing is, in YB it performs worse than a straight \"cursor for loop\" unless the result set is large. (The break-even comes at about 500 rows.) In PG it never harms performance, and the benefit kicks in with much smaller result sets.\r\n\r\n(2) Define the required number of static cursors and choose the one to open with a case statement. This is no good in general, because not all the facts are at hand until run time. It also suffers from the combinatorial explosion effect, so it's viable (but tedious to program and QA) only when the number of, and cardinality of, the degrees of freedom increases. In my use case it's 2*3 (two tables and three possible ratios).\r\n\r\n# The real function\r\n```\r\ncreate or replace function speed_ratios(table_name in varchar, which_ratio in int)\r\n  returns table(n int, t varchar)\r\n  language plpgsql\r\nas $body$\r\ndeclare\r\n  quot constant varchar(1) not null := '''';\r\n\r\n  cur refcursor;\r\n  qry_template constant varchar not null := '\r\n    select\r\n      to_char(nr_results_pr_query, ''99999999'') ||\r\n      to_char(?ratio, ''99999999990.99'')||''x''\r\n    from \"?table\"\r\n    order by nr_results_pr_query';\r\n\r\n  ratio_1 constant varchar not null := 'cursor_for_loop_time_avg / array_agg_plpgsql_time_avg';\r\n  ratio_2 constant varchar not null := 'cursor_for_loop_time_avg / array_agg_sql_time_avg';\r\n  ratio_3 constant varchar not null := 'array_agg_sql_time_avg / array_agg_plpgsql_time_avg';\r\n  ratio constant varchar not null :=\r\n    case which_ratio\r\n      when 1 then ratio_1\r\n      when 2 then ratio_2\r\n      when 3 then ratio_3\r\n    end;\r\nbegin\r\n  n := 0;\r\n  declare\r\n    qry varchar not null :=\r\n      replace(replace(qry_template, '?table', table_name), '?ratio', ratio);\r\n  begin\r\n    open cur for execute qry;\r\n    loop\r\n      fetch cur into t;\r\n      exit when not found;\r\n      n := n + 1; return next;\r\n    end loop;\r\n    close cur;\r\n  end;\r\n\r\n  for j in 1..2 loop\r\n    t := '';\r\n    n := n + 1; return next;\r\n  end loop;\r\nend;\r\n$body$;\r\n```\n","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/3286/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/3286/timeline","performed_via_github_app":null,"state_reason":"completed"}},"event":"cross-referenced"},{"id":4198426914,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDQxOTg0MjY5MTQ=","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/4198426914","actor":{"login":"nocaway","id":31016169,"node_id":"MDQ6VXNlcjMxMDE2MTY5","avatar_url":"https://avatars.githubusercontent.com/u/31016169?v=4","gravatar_id":"","url":"https://api.github.com/users/nocaway","html_url":"https://github.com/nocaway","followers_url":"https://api.github.com/users/nocaway/followers","following_url":"https://api.github.com/users/nocaway/following{/other_user}","gists_url":"https://api.github.com/users/nocaway/gists{/gist_id}","starred_url":"https://api.github.com/users/nocaway/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nocaway/subscriptions","organizations_url":"https://api.github.com/users/nocaway/orgs","repos_url":"https://api.github.com/users/nocaway/repos","events_url":"https://api.github.com/users/nocaway/events{/privacy}","received_events_url":"https://api.github.com/users/nocaway/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"e649d074dc5a839c549f698c08cc4f630e84f4a3","commit_url":"https://api.github.com/repos/yugabyte/yugabyte-db/commits/e649d074dc5a839c549f698c08cc4f630e84f4a3","created_at":"2021-01-12T23:01:18Z","performed_via_github_app":null},{"id":5253615253,"node_id":"RTE_lADOBlCVUc4terimzwAAAAE5I86V","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/5253615253","actor":{"login":"nocaway","id":31016169,"node_id":"MDQ6VXNlcjMxMDE2MTY5","avatar_url":"https://avatars.githubusercontent.com/u/31016169?v=4","gravatar_id":"","url":"https://api.github.com/users/nocaway","html_url":"https://github.com/nocaway","followers_url":"https://api.github.com/users/nocaway/followers","following_url":"https://api.github.com/users/no