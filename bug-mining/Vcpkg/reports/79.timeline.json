                                   /wd4305 /wd4127 /wd4100 /wd4512 /wd4125 /wd4389 /wd4510 /wd4610\r\n```\r\nI noticed that since [this commit](https://github.com/Microsoft/vcpkg/commit/6721b5337d00ea65cc8cb5fe1d8fa8c65e7a8246), protobuf could be built as shared library, which requires the `PROTOBUF_USE_DLLS` definition.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/microsoft/vcpkg/issues/comments/310989468/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"seanlis","id":7328445,"node_id":"MDQ6VXNlcjczMjg0NDU=","avatar_url":"https://avatars.githubusercontent.com/u/7328445?v=4","gravatar_id":"","url":"https://api.github.com/users/seanlis","html_url":"https://github.com/seanlis","followers_url":"https://api.github.com/users/seanlis/followers","following_url":"https://api.github.com/users/seanlis/following{/other_user}","gists_url":"https://api.github.com/users/seanlis/gists{/gist_id}","starred_url":"https://api.github.com/users/seanlis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/seanlis/subscriptions","organizations_url":"https://api.github.com/users/seanlis/orgs","repos_url":"https://api.github.com/users/seanlis/repos","events_url":"https://api.github.com/users/seanlis/events{/privacy}","received_events_url":"https://api.github.com/users/seanlis/received_events","type":"User","user_view_type":"public","site_admin":false}},{"actor":{"login":"seanlis","id":7328445,"node_id":"MDQ6VXNlcjczMjg0NDU=","avatar_url":"https://avatars.githubusercontent.com/u/7328445?v=4","gravatar_id":"","url":"https://api.github.com/users/seanlis","html_url":"https://github.com/seanlis","followers_url":"https://api.github.com/users/seanlis/followers","following_url":"https://api.github.com/users/seanlis/following{/other_user}","gists_url":"https://api.github.com/users/seanlis/gists{/gist_id}","starred_u