-    MultiplexSubscriberClientChannelHandlerPtr existedHandler = subhandlers[addr];
-    if (existedHandler.get() == handler.get()) {
-      subhandlers.erase(addr);
-      removed = true;
-    } else {
-      removed = false;
-    }
-  }
