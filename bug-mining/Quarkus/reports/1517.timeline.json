owers_url":"https://api.github.com/users/stuartwdouglas/followers","following_url":"https://api.github.com/users/stuartwdouglas/following{/other_user}","gists_url":"https://api.github.com/users/stuartwdouglas/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartwdouglas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartwdouglas/subscriptions","organizations_url":"https://api.github.com/users/stuartwdouglas/orgs","repos_url":"https://api.github.com/users/stuartwdouglas/repos","events_url":"https://api.github.com/users/stuartwdouglas/events{/privacy}","received_events_url":"https://api.github.com/users/stuartwdouglas/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2022-02-16T12:29:18Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/1046160183","html_url":"https://github.com/quarkusio/quarkus/issues/23756#issuecomment-1046160183","issue_url":"https://api.github.com/repos/quarkusio/quarkus/issues/23756","id":1046160183,"node_id":"IC_kwDOCFbutM4-WyM3","user":{"login":"AkMo3","id":69365878,"node_id":"MDQ6VXNlcjY5MzY1ODc4","avatar_url":"https://avatars.githubusercontent.com/u/69365878?v=4","gravatar_id":"","url":"https://api.github.com/users/AkMo3","html_url":"https://github.com/AkMo3","followers_url":"https://api.github.com/users/AkMo3/followers","following_url":"https://api.github.com/users/AkMo3/following{/other_user}","gists_url":"https://api.github.com/users/AkMo3/gists{/gist_id}","starred_url":"https://api.github.com/users/AkMo3/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AkMo3/subscriptions","organizations_url":"https://api.github.com/users/AkMo3/orgs","repos_url":"https://api.github.com/users/AkMo3/repos","events_url":"https://api.github.com/users/AkMo3/events{/privacy}","received_events_url":"https://api.github.com/users/AkMo3/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-02-20T04:21:36Z","updated_at":"2022-02-20T13:00:22Z","body":"@sbeigel I believe the issue is with the Intellij HTTP request tool not with RESTEasy serialization. In my system (Ubuntu 20.04) the native file editor shows the emoji correctly but the Intellij HTTP tool fails to serialize it.\r\n\r\n![ss1](https://user-images.githubusercontent.com/69365878/154828265-bad45414-6d3e-422a-a3dd-ee0c8f43bcf8.png)\r\n![Screenshot from 2022-02-20 09-47-56](https://user-images.githubusercontent.com/69365878/154828282-d71f85a1-38b8-46f1-a3be-de91f08e2016.png)\r\n\r\nNote: I have used Jackson for serialization.\r\n\r\n<details>\r\n  <summary>See Code</summary>\r\n  \r\n```\r\npackage org.acme;\r\n\r\nimport com.fasterxml.jackson.core.JsonProcessingException;\r\nimport com.fasterxml.jackson.databind.ObjectMapper;\r\nimport com.fasterxml.jackson.databind.SerializationFeature;\r\nimport org.jboss.resteasy.reactive.PartType;\r\nimport org.jboss.resteasy.reactive.RestForm;\r\n\r\nimport javax.ws.rs.GET;\r\nimport javax.ws.rs.Path;\r\nimport javax.ws.rs.Produces;\r\nimport javax.ws.rs.core.MediaType;\r\n\r\n\r\n@Path(\"/test\")\r\npublic class ReactiveMultipartTestResource {\r\n\r\n    public static class TestData {\r\n        public String bar;\r\n\r\n        public TestData(String bar) {\r\n            this.bar = bar;\r\n        }\r\n    }\r\n\r\n    public static class FormData {\r\n        @RestForm\r\n        @PartType(MediaType.APPLICATION_JSON)\r\n        public TestData data;\r\n        @RestForm\r\n        public String dataAsString;\r\n    }\r\n\r\n    @GET\r\n    @Produces(MediaType.MULTIPART_FORM_DATA)\r\n    public FormData hello() throws JsonProcessingException {\r\n        ObjectMapper om = new ObjectMapper();\r\n        FormData form = new FormData();\r\n        form.data = new TestData(\"Bar äöü 😀\");\r\n        form.dataAsString = om.writeValueAsString(form.data);\r\n        return form;\r\n    }\r\n}\r\n```\r\n</details>\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/comments/1046160183/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"AkMo3","id":69365878,"node_id":"MDQ6VXNlcjY5MzY1ODc4","avatar_url":"https://avatars.githubusercontent.com/u/69365878?v=4","gravatar_id":"","url":"https://api.github.com/users/AkMo3","html_url":"https://github.com/AkMo3","followers_url":"https://api.github.com/users/AkMo3/followers","following_url":"https://api.github.com/users/AkMo3/following{/other_user}","gists_url":"https://api.github.com/users/AkMo3/gists{/gist_id}","starred_url":"https://api.github.com/users/AkMo3/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AkMo3/subscriptions","organizations_url":"https://api.github.com/users/AkMo3/orgs","repos_url":"https://api.github.com/users/AkMo3/repos","events_url":"https://api.github.com/users/AkMo3/events{/privacy}","received_events_url":"https://api.github.com/users/AkMo3/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":6106742547,"node_id":"MEE_lADOCFbutM5D8UvkzwAAAAFr_X8T","url":"https://api.github.com/repos/quarkusio/quarkus/issues/events/6106742547","actor":{"login":"sbeigel","id":48511,"node_id":"MDQ6VXNlcjQ4NTEx","avatar_url":"https://avatars.githubusercontent.com/u/48511?v=4","gravatar_id":"","url":"https://api.github.com/users/sbeigel","html_url":"https://github.com/sbeigel","followers_url":"https://api.github.com/users/sbeigel/followers","following_url":"https://api.github.com/users/sbeigel/following{/other_user}","gists_url":"https://api.github.com/users/sbeigel/gists{/gist_id}","starred_url":"https://api.github.com/users/sbeigel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sbeigel/subscriptions","organizations_url":"https://