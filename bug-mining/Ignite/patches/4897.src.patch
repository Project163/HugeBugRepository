+        cfg.setMBeanServer(rsrcs.getMBeanServer());
+
+        node.setId(rsrcs.getNodeId());
+
+        MessageFactoryProvider testMsgFactory = factory -> factory.register(GridTestMessage.DIRECT_TYPE, GridTestMessage::new);
