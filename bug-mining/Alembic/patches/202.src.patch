+    def _compare_default_roundtrip(
+        self, type_, orig_default, alternate=None, diff_expected=None
+    ):
+        diff_expected = (
+            diff_expected
+            if diff_expected is not None
+            else alternate is not None
+        )
+        if alternate is None:
