:00:00\", periods=3, freq=\"250L\", tz=\"US/Central\"), columns=range(3,6))\n\nIn [96]: test1\nOut[96]:\n                                  0  1  2\n2012-11-15 00:00:00-06:00         0  0  0\n2012-11-15 00:00:00.100000-06:00  0  0  0\n2012-11-15 00:00:00.200000-06:00  0  0  0\n2012-11-15 00:00:00.300000-06:00  0  0  0\n2012-11-15 00:00:00.400000-06:00  0  0  0\n2012-11-15 00:00:00.500000-06:00  0  0  0\n\nIn [97]: test2\nOut[97]:\n                                  3  4  5\n2012-11-15 00:00:00-06:00         0  0  0\n2012-11-15 00:00:00.250000-06:00  0  0  0\n2012-11-15 00:00:00.500000-06:00  0  0  0\n\nIn [98]: test1.join(test2, how=\"outer\")\nOut[98]:\n                                   0   1   2   3   4   5\n2012-11-15 06:00:00-06:00          0   0   0   0   0   0\n2012-11-15 06:00:00.100000-06:00   0   0   0 NaN NaN NaN\n2012-11-15 06:00:00.200000-06:00   0   0   0 NaN NaN NaN\n2012-11-15 06:00:00.250000-06:00 NaN NaN NaN   0   0   0\n2012-11-15 06:00:00.300000-06:00   0   0   0 NaN NaN NaN\n2012-11-15 06:00:00.400000-06:00   0   0   0 NaN NaN NaN\n2012-11-15 06:00:00.500000-06:00   0   0   0   0   0   0\n```\n","closed_by":{"login":"wesm","id":329591,"node_id":"MDQ6VXNlcjMyOTU5MQ==","avatar_url":"https://avatars.githubusercontent.com/u/329591?v=4","gravatar_id":"","url":"https://api.github.com/users/wesm","html_url":"https://github.com/wesm","followers_url":"https://api.github.com/users/wesm/followers","following_url":"https://api.github.com/users/wesm/following{/other_user}","gists_url":"https://api.github.com/users/wesm/gists{/gist_id}","starred_url":"https://api.github.com/users/wesm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wesm/subscriptions","organizations_url":"https://api.github.com/users/wesm/orgs","repos_url":"https://api.github.com/users/wesm/repos","events_url":"https://api.github.com/users/wesm/events{/privacy}","received_events_url":"https://api.github.com/users/wesm/received_events","type":"User","user_view_type":"pu