s/aesara/contents/{+path}","compare_url":"https://api.github.com/repos/aesara-devs/aesara/compare/{base}...{head}","merges_url":"https://api.github.com/repos/aesara-devs/aesara/merges","archive_url":"https://api.github.com/repos/aesara-devs/aesara/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/aesara-devs/aesara/downloads","issues_url":"https://api.github.com/repos/aesara-devs/aesara/issues{/number}","pulls_url":"https://api.github.com/repos/aesara-devs/aesara/pulls{/number}","milestones_url":"https://api.github.com/repos/aesara-devs/aesara/milestones{/number}","notifications_url":"https://api.github.com/repos/aesara-devs/aesara/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/aesara-devs/aesara/labels{/name}","releases_url":"https://api.github.com/repos/aesara-devs/aesara/releases{/id}","deployments_url":"https://api.github.com/repos/aesara-devs/aesara/deployments","created_at":"2019-11-12T14:02:08Z","updated_at":"2025-11-17T13:32:50Z","pushed_at":"2024-11-15T03:40:56Z","git_url":"git://github.com/aesara-devs/aesara.git","ssh_url":"git@github.com:aesara-devs/aesara.git","clone_url":"https://github.com/aesara-devs/aesara.git","svn_url":"https://github.com/aesara-devs/aesara","homepage":"https://aesara.readthedocs.io","size":83117,"stargazers_count":1217,"watchers_count":1217,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":true,"forks_count":153,"mirror_url":null,"archived":true,"disabled":false,"open_issues_count":330,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["aesara","automatic-differentiation","optimizing-compiler","optimizing-compilers","symbolic-computation","tensors","term-rewriting-system","theano","transpiler"],"visibility":"public","forks":153,"open_issues":330,"watchers":1217,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/aesara-devs/aesara/pulls/947","html_url":"https://github.com/aesara-devs/aesara/pull/947","diff_url":"https://github.com/aesara-devs/aesara/pull/947.diff","patch_url":"https://github.com/aesara-devs/aesara/pull/947.patch","merged_at":"2022-05-07T16:20:58Z"},"body":"Closes #944\r\n\r\nOn windows systems, the dll or lib libraries don't follow gcc's library naming convention, which means that their file name doesn't have the lib prefix (e.g. libmkl_core.dll). For this reason, gcc's library search fails to find these dynamic link libraries or static libs. An undesired consequence was that aesara (and old theano) was not able to set the correct blas__ldflags to link with mkl, even if the library had been correctly installed.\r\n\r\nThis PR introduces two GCC_compiler static methods that patch the libs or ldflags that are used during compilation. The static methods specifically target dll and lib files. They search for the library files in the provided library directories, and if a dll or lib is found, the ldflag is set to the absolute path that points to the dll or lib file. As a sidenote, dlls are preferred over libs.\r\n\r\nAs a consequence, the normal unix-like ldflags will be patched to work in windows as they do in unix. Thanks to this, aesara is now able to set the correct ldflags in windows to link to mkl installations.","reactions":{"url":"https://api.github.com/repos/aesara-devs/aesara/issues/947/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/aesara-devs/aesara/issues/947/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"actor":{"login":"shoracek","id":4643182,"node_id":"MDQ6VXNlcjQ2NDMxODI=","avatar_url":"https://avatars.githubusercontent.com/u/46431