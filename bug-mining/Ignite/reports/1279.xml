<item>
            <title>[IGNITE-1070] Zombie entries in cache with SortedEvictionPolicy</title>
                <link>https://issues.apache.org/jira/browse/IGNITE-1070</link>
                <project id="12315922" key="IGNITE">Ignite</project>
                    <description>&lt;p&gt;Sometimes test &lt;tt&gt;GridCacheConcurrentEvictionConsistencySelfTest.testPolicyConsistencySortedLocal&lt;/tt&gt; fails because cache contains entries that are untracked by &lt;tt&gt;SortedEvictionPolicy&lt;/tt&gt;.&lt;/p&gt;</description>
                <environment></environment>
        <key id="12842062">IGNITE-1070</key>
            <summary>Zombie entries in cache with SortedEvictionPolicy</summary>
                <type id="1" iconUrl="https://issues.apache.org/jira/secure/viewavatar?size=xsmall&amp;avatarId=21133&amp;avatarType=issuetype">Bug</type>
                                            <priority id="3" iconUrl="https://issues.apache.org/jira/images/icons/priorities/major.svg">Major</priority>
                        <status id="6" iconUrl="https://issues.apache.org/jira/images/icons/statuses/closed.png" description="The issue is considered finished, the resolution is correct. Issues which are not closed can be reopened.">Closed</status>
                    <statusCategory id="3" key="done" colorName="green"/>
                                    <resolution id="1">Fixed</resolution>
                                        <assignee username="agura">Andrey N. Gura</assignee>
                                    <reporter username="agura">Andrey N. Gura</reporter>
                        <labels>
                    </labels>
                <created>Wed, 1 Jul 2015 18:00:06 +0000</created>
                <updated>Tue, 7 Jul 2015 11:58:18 +0000</updated>
                            <resolved>Tue, 7 Jul 2015 11:00:53 +0000</resolved>
                                    <version>sprint-7</version>
                                    <fixVersion>sprint-7</fixVersion>
                                        <due></due>
                            <votes>0</votes>
                                    <watches>1</watches>
                                                                                                                <comments>
                            <comment id="14610756" author="agura" created="Wed, 1 Jul 2015 18:12:47 +0000"  >&lt;p&gt;After gathering trace info I noticed that one thread adds entry to backed collection, while other thread invokes &lt;tt&gt;shrink&lt;/tt&gt;, poll this entry from backed collection and doesn&apos;t invoke eviction because entry has no associated meta yet. Thus entry is removed from eviction policy but not evicted.&lt;/p&gt;</comment>
                            <comment id="14611826" author="agura" created="Thu, 2 Jul 2015 11:46:51 +0000"  >&lt;p&gt;Fixed. Also removed unreacheable code branch for LRU, FIFO and sorted policies.&lt;/p&gt;</comment>
                            <comment id="14616576" author="agura" created="Tue, 7 Jul 2015 11:58:18 +0000"  >&lt;p&gt;Merged into master branch.&lt;/p&gt;</comment>
                    </comments>
