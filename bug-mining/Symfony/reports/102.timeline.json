achkaev mentioned the problem is within [Symfony\\Component\\Console\\Application::getNamespaces()](https://github.com/symfony/symfony/blob/master/src/Symfony/Component/Console/Application.php#L473) which clearly mentions `It does not returns the global namespace which always exists.` however [Symfony\\Component\\Console\\Application::extractNamespace()](https://github.com/symfony/symfony/blob/master/src/Symfony/Component/Console/Application.php#L1046) has a second argument `limit` which we can pass a flag to getNamespaces() to set limit to `1` whenever `app/console list XX` is called\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/symfony/symfony/issues/comments/39656770/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"habashyjr","id":1475873,"node_id":"MDQ6VXNlcjE0NzU4NzM=","avatar_url":"https://avatars.githubusercontent.com/u/1475873?v=4","gravatar_id":"","url":"https://api.github.com/users/habashyjr","html_url":"https://github.com/habashyjr","followers_url":"https://api.github.com/users/habashyjr/followers","following_url":"https://api.github.com/users/habashyjr/following{/other_user}","gists_url":"https://api.github.com/users/habashyjr/gists{/gist_id}","starred_url":"https://api.github.com/users/habashyjr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/habashyjr/subscriptions","organizations_url":"https://api.github.com/users/habashyjr/orgs","repos_url":"https://api.github.com/users/habashyjr/repos","events_url":"https://api.github.com/users/habashyjr/events{/privacy}","received_events_url":"https://api.github.com/users/habashyjr/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":109032651,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50MTA5MDMyNjUx","url":"https://api.github.com/repos/symfony/symfony/issues/events/109032651","actor":{"login":"kachkaev","id":6