-    @Override
-    public int hashCode() {
-      return index ^ Doubles.hashCode(value);
-    }
-
-    @Override
-    public boolean equals(Object o) {
-      if (!(o instanceof OrderedElement)) {
-        return false;
-      }
-      OrderedElement other = (OrderedElement) o;
-      return index == other.index && value == other.value;
-    }
-  }
-}
