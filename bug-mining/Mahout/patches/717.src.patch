-    // Sort eigenvalues and corresponding vectors.
-
-    for (int i = 0; i < n - 1; i++) {
-      int k = i;
-      double p = d.getQuick(i);
-      for (int j = i + 1; j < n; j++) {
-        if (d.getQuick(j) > p) {
-          k = j;
-          p = d.getQuick(j);
-        }
-      }
-      if (k != i) {
-        d.setQuick(k, d.getQuick(i));
-        d.setQuick(i, p);
-        for (int j = 0; j < n; j++) {
-          p = v.getQuick(j, i);
-          v.setQuick(j, i, v.getQuick(j, k));
-          v.setQuick(j, k, p);
-        }
-      }
-    }
-  }
