+ t_part3s1 | i       |       738 |          -1 |           0
+ t_part3s1 | a       |       738 |          41 |           0
+ t_part3s1 | b       |       738 |          -1 |           0
+ t_part3s2 | i       |      6599 |          -1 |           0
+ t_part3s2 | a       |      6599 |         350 |           0
