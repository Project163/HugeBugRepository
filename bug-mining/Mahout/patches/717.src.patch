-
-      for ( col ← row + 1 until mxR.ncol) {
-        // this vector-vector should be sort of optimized, right?
-        val v = a(row, ::) dot a(col, ::)
-
-        mxR(row, col) = v
-        mxR(col,row) = v
-      }
-    }
-
