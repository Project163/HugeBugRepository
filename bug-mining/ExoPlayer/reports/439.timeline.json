rn true, it works perfectly... \r\n\r\n@ojw28 , are the audio capabilities more strict in the new ExoPlayer version?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/google/ExoPlayer/issues/comments/444511245/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"cyrillrx","id":1511463,"node_id":"MDQ6VXNlcjE1MTE0NjM=","avatar_url":"https://avatars.githubusercontent.com/u/1511463?v=4","gravatar_id":"","url":"https://api.github.com/users/cyrillrx","html_url":"https://github.com/cyrillrx","followers_url":"https://api.github.com/users/cyrillrx/followers","following_url":"https://api.github.com/users/cyrillrx/following{/other_user}","gists_url":"https://api.github.com/users/cyrillrx/gists{/gist_id}","starred_url":"https://api.github.com/users/cyrillrx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cyrillrx/subscriptions","organizations_url":"https://api.github.com/users/cyrillrx/orgs","repos_url":"https://api.github.com/users/cyrillrx/repos","events_url":"https://api.github.com/users/cyrillrx/events{/privacy}","received_events_url":"https://api.github.com/users/cyrillrx/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":2007311793,"node_id":"MDE0Ok1lbnRpb25lZEV2ZW50MjAwNzMxMTc5Mw==","url":"https://api.github.com/repos/google/ExoPlayer/issues/events/2007311793","actor":{"login":"ojw28","id":7881572,"node_id":"MDQ6VXNlcjc4ODE1NzI=","avatar_url":"https://avatars.githubusercontent.com/u/7881572?v=4","gravatar_id":"","url":"https://api.github.com/users/ojw28","html_url":"https://github.com/ojw28","followers_url":"https://api.github.com/users/ojw28/followers","following_url":"https://api.github.com/users/ojw28/following{/other_user}","gists_url":"https://api.github.com/users/ojw28/gists{/gist_id}","starred_url":"https://api.github.com/users/ojw28/starred{/owner}{/repo}",