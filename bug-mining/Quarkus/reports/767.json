finnigan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kenfinnigan/subscriptions","organizations_url":"https://api.github.com/users/kenfinnigan/orgs","repos_url":"https://api.github.com/users/kenfinnigan/repos","events_url":"https://api.github.com/users/kenfinnigan/events{/privacy}","received_events_url":"https://api.github.com/users/kenfinnigan/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":{"url":"https://api.github.com/repos/quarkusio/quarkus/milestones/79","html_url":"https://github.com/quarkusio/quarkus/milestone/79","labels_url":"https://api.github.com/repos/quarkusio/quarkus/milestones/79/labels","id":5731018,"node_id":"MDk6TWlsZXN0b25lNTczMTAxOA==","number":79,"title":"1.7.1.Final","description":"","creator":{"login":"gsmet","id":1279749,"node_id":"MDQ6VXNlcjEyNzk3NDk=","avatar_url":"https://avatars.githubusercontent.com/u/1279749?v=4","gravatar_id":"","url":"https://api.github.com/users/gsmet","html_url":"https://github.com/gsmet","followers_url":"https://api.github.com/users/gsmet/followers","following_url":"https://api.github.com/users/gsmet/following{/other_user}","gists_url":"https://api.github.com/users/gsmet/gists{/gist_id}","starred_url":"https://api.github.com/users/gsmet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gsmet/subscriptions","organizations_url":"https://api.github.com/users/gsmet/orgs","repos_url":"https://api.github.com/users/gsmet/repos","events_url":"https://api.github.com/users/gsmet/events{/privacy}","received_events_url":"https://api.github.com/users/gsmet/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":129,"state":"closed","created_at":"2020-08-04T12:11:58Z","updated_at":"2020-10-01T14:41:53Z","due_on":null,"closed_at":"2020-08-27T07:36:28Z"},"comments":6,"created_at":"2020-08-12T13:53:27Z","updated_at":"2020-08-24T10:32:55Z","closed_at":"2020-08-20T09:12:45Z","author_association":"MEMBER","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"We see multiple traces in Native mode instead of one trace with multiple spans like in JVM mode. Using Quarkus 1.7.0.Final, GraalVM 20.1 JDK11 based.\r\nThis issue was Identified using https://github.com/quarkus-qe/quarkus-openshift-test-suite, I created a standalone application which doesn't need OpenShift cluster - https://github.com/rsvoboda/tracing-sample\r\n\r\nThe expected behavior for Native mode is to see the same behavior as in JVM mode, just one trace with multiple spans.\r\n@Ladicek indicated that it sounds like context propagation not working\r\n\r\n### Steps to reproduce:\r\nTerminal 1\r\n```\r\ndocker run -p 5775:5775/udp -p 6831:6831/udp -p 6832:6832/udp -p 5778:5778 -p 16686:16686 -p 14268:14268 jaegertracing/all-in-one:latest\r\n```\r\n\r\nTerminal 2\r\n```\r\ngit clone https://github.com/rsvoboda/tracing-sample.git\r\ncd tracing-sample\r\n\r\nsdk use java 20.1.0.r11-grl && export GRAALVM_HOME=$JAVA_HOME\r\nmvn verify -Dnative\r\n```\r\n\r\n### View the traces\r\nOpen http://localhost:16686/ and Find traces for `test-traced-service` service\r\n\r\n### Screenshots\r\nSearch for Traces:\r\n![Screenshot 2020-08-12 at 15 34 14](https://user-images.githubusercontent.com/925259/90022840-4dc16c80-dcb3-11ea-9904-6873cac10ae5.png)\r\n\r\nJVM mode result\r\n![Screenshot 2020-08-12 at 15 34 30](https://user-images.githubusercontent.com/925259/90022860-55811100-dcb3-11ea-9b31-741d5ba77ffa.png)\r\n\r\nNative mode result\r\n![Screenshot 2020-08-12 at 15 34 37](https://user-images.githubusercontent.com/925259/90022869-59ad2e80-dcb3-11ea-9c31-0fa436cfb442.png)\r\n![Screenshot 2020-08-12 at 15 34 43](https://user-images.githubusercontent.com/925259/90022888-5d40b580-dcb3-11ea-8d41-9dd38e3449f2.png)\r\n\r\n\r\n\r\n","closed_by":{"login":"gsmet","id":1279749,"node_id":"MDQ6VXNlcjEyNzk3NDk=","avatar_url":"https://avatars.githubusercontent.com/u/1279749?v=4","gravatar_id":"","url":"https://api.github.com/users/gsmet","html_url":"https://github.com/gsmet","followers_url":"https://api.github.com/users/gsmet/followers","following_url":"https://api.github.com/users/gsmet/following{/other_user}","gists_url":"https://api.github.com/users/gsmet/gists{/gist_id}","starred_url":"https://api.github.com/users/gsmet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gsmet/subscriptions","organizations_url":"https://api.github.com/users/gsmet/orgs","repos_url":"https://api.github.com/users/gsmet/repos","events_url":"https://api.github.com/users/gsmet/events{/privacy}","received_events_url":"https://api.github.com/users/gsmet/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/issues/11349/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/quarkusio/quarkus/issues/11349/timeline","performed_via_github_app":null,"state_reason":"completed"}