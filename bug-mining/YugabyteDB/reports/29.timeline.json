ars.githubusercontent.com/u/6334739?v=4","gravatar_id":"","url":"https://api.github.com/users/bbaddepudi","html_url":"https://github.com/bbaddepudi","followers_url":"https://api.github.com/users/bbaddepudi/followers","following_url":"https://api.github.com/users/bbaddepudi/following{/other_user}","gists_url":"https://api.github.com/users/bbaddepudi/gists{/gist_id}","starred_url":"https://api.github.com/users/bbaddepudi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bbaddepudi/subscriptions","organizations_url":"https://api.github.com/users/bbaddepudi/orgs","repos_url":"https://api.github.com/users/bbaddepudi/repos","events_url":"https://api.github.com/users/bbaddepudi/events{/privacy}","received_events_url":"https://api.github.com/users/bbaddepudi/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2018-05-23T22:47:19Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/393668876","html_url":"https://github.com/yugabyte/yugabyte-db/issues/294#issuecomment-393668876","issue_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/294","id":393668876,"node_id":"MDEyOklzc3VlQ29tbWVudDM5MzY2ODg3Ng==","user":{"login":"bbaddepudi","id":6334739,"node_id":"MDQ6VXNlcjYzMzQ3Mzk=","avatar_url":"https://avatars.githubusercontent.com/u/6334739?v=4","gravatar_id":"","url":"https://api.github.com/users/bbaddepudi","html_url":"https://github.com/bbaddepudi","followers_url":"https://api.github.com/users/bbaddepudi/followers","following_url":"https://api.github.com/users/bbaddepudi/following{/other_user}","gists_url":"https://api.github.com/users/bbaddepudi/gists{/gist_id}","starred_url":"https://api.github.com/users/bbaddepudi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bbaddepudi/subscriptions","organizations_url":"https://api.github.com/users/bbaddepudi/orgs","repos_url":"https://api.github.com/users/bbaddepudi/repos","events_url":"https://api.github.com/users/bbaddepudi/events{/privacy}","received_events_url":"https://api.github.com/users/bbaddepudi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-05-31T20:27:44Z","updated_at":"2018-05-31T20:28:15Z","body":"Had discussed updating server conf file offline. And here are the some recent logs, with comments about master changes done externally. This shows the behavior of a client embedded in the tserver (YCQL) proxy and proposes changes at the end.\r\n\r\n`I0531 05:51:16.717581 20998 client-internal.cc:1159] New master addresses: 10.9.136.107:7100,10.9.203.122:7100,10.9.68.117:7100\r\n\r\n// Removed master 10.9.68.117 via ChangeConfig and killed it.\r\n\r\nI0531 06:04:42.362607 20757 tablet_server.cc:167] Got new list of 2 masters at index 4990 new masters=10.9.136.107:7100,10.9.203.122:7100\r\n\r\n// ChangeConfig add master 10.9.87.220\r\n\r\nI0531 06:13:07.007033 20757 tablet_server.cc:167] Got new list of 3 masters at index 5580 new masters=10.9.136.107:7100,10.9.203.122:7100,10.9.87.220:7100\r\n\r\n// Just kill master process at 10.9.136.107, which was the master leader.\r\n\r\nI0531 17:06:07.983470 20835 client-internal.cc:1148] Reinitialize master addresses from file: /home/yugabyte/tserver/conf/server.conf\r\nI0531 17:06:07.983813 20835 client-internal.cc:1159] New master addresses: 10.9.136.107:7100,10.9.203.122:7100,10.9.68.117:7100`\r\n\r\nIt starts off with 3 masters, one of them (10.9.68.117) is removed and replaced with a new master (10.9.87.220), both via ChangeConfig. The tserver/client get the in-memory update of new masters correctly, so far so good. Then the master leader is plain killed. So the client code defaults to reading the tserver log file and overwrites the new info in memory with stale info from config flag file.\r\n\r\nThis shows the need to update the server conf file also with superset of master ips from memory.\r\n","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments/393668876/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"bbaddepudi","id":6334739,"node_id":"MDQ6VXNlcjYzMzQ3Mzk=","avatar_url":"https://avatars.githubusercontent.com/u/6334739?v=4","gravatar_id":"","url":"https://api.github.com/users/bbaddepudi","html_url":"https://github.com/bbaddepudi","followers_url":"https://api.github.com/users/bbaddepudi/followers","following_url":"https://api.github.com/users/bbaddepudi/following{/other_user}","gists_url":"https://api.github.com/users/bbaddepudi/gists{/gist_id}","starred_url":"https://api.github.com/users/bbaddepudi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bbaddepudi/subscriptions","organizations_url":"https://api.github.com/users/bbaddepudi/orgs","repos_url":"https://api.github.com/users/bbaddepudi/repos","events_url":"https://api.github.com/users/bbaddepudi/events{/privacy}","received_events_url":"https://api.github.com/users/bbaddepudi/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":1671373614,"node_id":"MDE1OlJlZmVyZW5jZWRFdmVudDE2NzEzNzM2MTQ=","url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/events/1671373614","actor":{"login":"yugabyte-ci","id":17281578,"node_id":"MDQ6VXNlcjE3MjgxNTc4","avatar_url":"https://avatars.githubusercontent.com/u/17281578?v=4","gravatar_id":"","url":"https://api.github.com/users/yugabyte-ci","html_url":"https://github.com/yugabyte-ci","followers_url":"https://api.github.com/users/yugabyte-ci/followers","following_url":"https://api.github.com/users/yugabyte-ci/following{/other_user}","gists_url":"https://api.github.com/users/yugabyte-ci/gists{/gist_id}","starred_url":"https://api.github.com/users/yugabyte-ci/starred{/owner}{/repo}","subscriptions_url":"htt