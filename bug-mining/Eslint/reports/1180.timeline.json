repos/AtomLinter/linter-eslint/milestones{/number}","notifications_url":"https://api.github.com/repos/AtomLinter/linter-eslint/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/AtomLinter/linter-eslint/labels{/name}","releases_url":"https://api.github.com/repos/AtomLinter/linter-eslint/releases{/id}","deployments_url":"https://api.github.com/repos/AtomLinter/linter-eslint/deployments","created_at":"2014-06-26T14:19:58Z","updated_at":"2025-08-03T08:39:51Z","pushed_at":"2023-08-07T18:34:35Z","git_url":"git://github.com/AtomLinter/linter-eslint.git","ssh_url":"git@github.com:AtomLinter/linter-eslint.git","clone_url":"https://github.com/AtomLinter/linter-eslint.git","svn_url":"https://github.com/AtomLinter/linter-eslint","homepage":"https://atom.io/packages/linter-eslint","size":2268,"stargazers_count":581,"watchers_count":581,"language":"JavaScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":141,"mirror_url":null,"archived":true,"disabled":false,"open_issues_count":28,"license":null,"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["atom","eslint","eslint-extension","linter-eslint"],"visibility":"public","forks":141,"open_issues":28,"watchers":581,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"## Issue Type\r\n<!-- Can be \"Bug\", \"Feature Request\", \"Question\", etc.-->\r\n\r\nBug, sort of\r\n\r\n## Issue Description\r\n<!-- Describe what happened, what you think should have happened, and any other relevant details -->\r\n\r\nWhen using ESLint 4.0.0-alpha, I added a rule that does not exist to my config file. As expected, ESLint reported an error because the rule was missing. However, linter-eslint displayed the error like this:\r\n\r\n![](https://i.gyazo.com/8ec7e9428619efcb112cba507dd21d6e.png)\r\n\r\nIn other words, it highlighted the entire file rather than a single line, which is what it did previously.\r\n\r\nThe issue is caused by [this change](http://eslint.org/docs/4.0.0/user-guide/migrating-to-4.0.0#report-locations) in ESLint 4.0. If a rule reports a node, the reported problem now has an end range. In this case, the entire AST was reported, so there are a lot of highlighted lines.\r\n\r\nIt might be worth limiting the number of lines highlighted in cases like this.\r\n\r\n## Bug Checklist\r\n- Restart Atom\r\n- Verify the `eslint` CLI gives the proper result, while `linter-eslint` does not\r\n- Paste the output of the `Linter Eslint: Debug` command from the Command Palette below\r\n\r\n```\r\nAtom version: 1.16.0\r\nlinter-eslint version: 8.1.7\r\nESLint version: 4.0.0-alpha.1\r\nHours since last Atom restart: 0.1\r\nPlatform: darwin\r\nUsing local project ESLint from: /path/to/eslint/node_modules/eslint\r\nCurrent file's scopes: [\r\n  \"source.js\",\r\n  \"meta.function.js\",\r\n  \"meta.parameters.js\",\r\n  \"punctuation.definition.parameters.begin.bracket.round.js\"\r\n]\r\nlinter-eslint configuration: {\r\n  \"disableFSCache\": true,\r\n  \"eslintRulesDir\": \"lib/internal-rules\",\r\n  \"rulesToSilenceWhileTyping\": [\r\n    \"no-trailing-spaces\"\r\n  ],\r\n  \"lintHtmlFiles\": false,\r\n  \"useGlobalEslint\": false,\r\n  \"showRuleIdInMessage\": true,\r\n  \"disableWhenNoEslintConfig\": true,\r\n  \"eslintrcPath\": \"\",\r\n  \"globalNodePath\": \"\",\r\n  \"advancedLocalNodeModules\": \"\",\r\n  \"disableEslintIgnore\": false,\r\n  \"fixOnSave\": false,\r\n  \"scopes\": [\r\n    \"source.js\",\r\n    \"source.jsx\",\r\n    \"source.js.jsx\",\r\n    \"source.babel\",\r\n    \"source.js-semantic\"\r\n  ],\r\n  \"rulesToDisableWhileFixing\": []\r\n}\r\n```\r\n","reactions":{"url":"https://api.github.com/repos/AtomLinter/linter-eslint/issues/908/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.git