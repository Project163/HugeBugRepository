[{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/461003591","html_url":"https://github.com/cakephp/cakephp/issues/12954#issuecomment-461003591","issue_url":"https://api.github.com/repos/cakephp/cakephp/issues/12954","id":461003591,"node_id":"MDEyOklzc3VlQ29tbWVudDQ2MTAwMzU5MQ==","user":{"login":"ndm2","id":5031606,"node_id":"MDQ6VXNlcjUwMzE2MDY=","avatar_url":"https://avatars.githubusercontent.com/u/5031606?v=4","gravatar_id":"","url":"https://api.github.com/users/ndm2","html_url":"https://github.com/ndm2","followers_url":"https://api.github.com/users/ndm2/followers","following_url":"https://api.github.com/users/ndm2/following{/other_user}","gists_url":"https://api.github.com/users/ndm2/gists{/gist_id}","starred_url":"https://api.github.com/users/ndm2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ndm2/subscriptions","organizations_url":"https://api.github.com/users/ndm2/orgs","repos_url":"https://api.github.com/users/ndm2/repos","events_url":"https://api.github.com/users/ndm2/events{/privacy}","received_events_url":"https://api.github.com/users/ndm2/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-02-06T12:18:30Z","updated_at":"2019-02-06T12:23:27Z","body":"```php\r\npublic function testLocalePropertyShouldNotBleedIntoNtoManyAssociationPropertiesWhenUsingMatching()\r\n{\r\n    $table = $this->getTableLocator()->get('Articles');\r\n    $table->hasMany('Comments');\r\n\r\n    $table->Comments->addBehavior('Translate');\r\n    $table->Comments->setLocale('xyz');\r\n\r\n    $this->assertNotEquals($table->Comments->getLocale(), I18n::getLocale());\r\n\r\n    $result = $table\r\n        ->find()\r\n        ->contain('Comments')\r\n        ->matching('Comments')\r\n        ->first();\r\n\r\n    $this->assertArrayNotHasKey('_locale', $result->comments);\r\n}\r\n```\r\n\r\nThe problem seems to stem from the fact that matching creates a joinable containment, which is being processed in `\\Cake\\ORM\\Association::attachTo()` using the same property path/name as the regular, non-matching containment.\r\n\r\nI'm not tooo familiar with the inner workings, but maybe for `matching` containments the `propertyPath` built in `\\Cake\\ORM\\EagerLoader::_normalizeContain()` should point to `_matchingData.$alias` instead of the association property name?\r\n\r\nhttps://github.com/cakephp/cakephp/blob/b0b9a3713720b30cd8e90c8b1a317a8294b2513a/src/ORM/EagerLoader.php#L560","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/cakephp/cakephp/issues/comments/461003591/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ndm2","id":5031606,"node_id":"MDQ6VXNlcjUwMzE2MDY=","avatar_url":"https://avatars.githubusercontent.com/u/5031606?v=4","gravatar_id":"","url":"https://api.github.com/users/ndm2","html_url":"https://github.com/ndm2","followers_url":"https://api.github.com/users/ndm2/followers","following_url":"https://api.github.com/users/ndm2/following{/other_user}","gists_url":"https://api.github.com/users/ndm2/gists{/gist_id}","starred_url":"https://api.github.com/users/ndm2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ndm2/subscriptions","organizations_url":"https://api.github.com/users/ndm2/orgs","repos_url":"https://api.github.com/users/ndm2/repos","events_url":"https://api.github.com/users/ndm2/events{/privacy}","received_events_url":"https://api.github.com/users/ndm2/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":2121081688,"node_id":"MDE1Ok1pbGVzdG9uZWRFdmVudDIxMjEwODE2ODg=","url":"https://api.github.com/repos/cakephp/cakephp/issues/events/2121081688","actor":{"login":"ADmad","id":142658,"node_id":"MDQ6VXNlcjE0MjY1OA==","avatar_url":"https://avatars.githubusercontent.com/u/142658?v=4","gravatar_id":"","url":"https://api.github.com/users