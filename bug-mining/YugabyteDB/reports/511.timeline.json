":"https://api.github.com/repos/yugabyte/yugabyte-db/subscription","commits_url":"https://api.github.com/repos/yugabyte/yugabyte-db/commits{/sha}","git_commits_url":"https://api.github.com/repos/yugabyte/yugabyte-db/git/commits{/sha}","comments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/comments{/number}","issue_comment_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/comments{/number}","contents_url":"https://api.github.com/repos/yugabyte/yugabyte-db/contents/{+path}","compare_url":"https://api.github.com/repos/yugabyte/yugabyte-db/compare/{base}...{head}","merges_url":"https://api.github.com/repos/yugabyte/yugabyte-db/merges","archive_url":"https://api.github.com/repos/yugabyte/yugabyte-db/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/yugabyte/yugabyte-db/downloads","issues_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues{/number}","pulls_url":"https://api.github.com/repos/yugabyte/yugabyte-db/pulls{/number}","milestones_url":"https://api.github.com/repos/yugabyte/yugabyte-db/milestones{/number}","notifications_url":"https://api.github.com/repos/yugabyte/yugabyte-db/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/yugabyte/yugabyte-db/labels{/name}","releases_url":"https://api.github.com/repos/yugabyte/yugabyte-db/releases{/id}","deployments_url":"https://api.github.com/repos/yugabyte/yugabyte-db/deployments","created_at":"2017-10-05T21:56:00Z","updated_at":"2025-12-13T01:01:53Z","pushed_at":"2025-12-13T05:03:31Z","git_url":"git://github.com/yugabyte/yugabyte-db.git","ssh_url":"git@github.com:yugabyte/yugabyte-db.git","clone_url":"https://github.com/yugabyte/yugabyte-db.git","svn_url":"https://github.com/yugabyte/yugabyte-db","homepage":"https://www.yugabyte.com","size":908218,"stargazers_count":9958,"watchers_count":9958,"language":"C","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1201,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7608,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"topics":["cloud-native","cpp","database","distributed-database","distributed-sql","distributed-sql-database","high-performance","kubernetes","multi-cloud","multi-region","scale-out","sql"],"visibility":"public","forks":1201,"open_issues":7608,"watchers":9958,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"body":"Jira Link: [DB-16633](https://yugabyte.atlassian.net/browse/DB-16633)\n### Description\n\nSeems like https://github.com/yugabyte/yugabyte-db/issues/9915 happens again after the PG15 merge.\n\n```\nCREATE TEMP TABLE uctest(f1 int, f2 text);\nINSERT INTO uctest VALUES (1, 'one'), (2, 'two'), (3, 'three');\nSELECT * FROM uctest FOR UPDATE;\n```\n\ncauses a crash on master (but not on 2024.2.2.3). This is a modified form of the regress test case in https://github.com/yugabyte/yugabyte-db/blob/46a531d975145bb3e7ef21ed5f6fba1b1b2d2717/src/postgres/src/test/regress/sql/yb.port.portals.sql#L418\n\nThe call stack below is not accurate, most likely, but it is what the core dump showed from a fastdebug build.\n\n```\n#0  0x00007ff409bde52f in raise () from /lib64/libc.so.6\n#1  0x00007ff409bb1e65 in abort () from /lib64/libc.so.6\n#2  0x000056247bc44820 in ExceptionalCondition ()\n#3  0x000056247ba88840 in ProcArrayRemove ()\n#4  0x000056247b9f53af in reaper ()\n#5  <signal handler called>\n#6  0x00007ff409cc51bb in select () from /lib64/libc.so.6\n#7  0x000056247b9f7161 in ServerLoop ()\n#8  0x000056247b9f3f87 in PostmasterMain ()\n#9  0x000056247b917fab in PostgresServerProcessMain ()\n#10 0x000056247b917ce2 in main ()\n```\n\n### Issue Type\n\nkind/bug\n\n### Warning: Please confirm that this issue does not contain any sensitive information\n\n- [x] I confirm this issue does not contain any sensitive information.\n\n[DB-16633]: https://yugabyte.atlassian.net/browse/DB-16633?atlOrigin=eyJpIjoiNWRkNTljNzYxNjVmNDY3MDlhMDU5Y2ZhYzA5YTRkZjUiLCJwIjoiZ2l0aHViLWNvbS1KU1cifQ","reactions":{"url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/27149/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/yugabyte/yugabyte-db/issues/27149/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"}]