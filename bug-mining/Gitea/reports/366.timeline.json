s_issues":true,"has_projects":false,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":6255,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":2890,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":true,"topics":["bitbucket","cicd","devops","docker-registry-v2","git","git-gui","git-server","gitea","github","github-actions","gitlab","go","golang","hacktoberfest","maven-server","npm-registry","vue"],"visibility":"public","forks":6255,"open_issues":2890,"watchers":52486,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/go-gitea/gitea/pulls/10814","html_url":"https://github.com/go-gitea/gitea/pull/10814","diff_url":"https://github.com/go-gitea/gitea/pull/10814.diff","patch_url":"https://github.com/go-gitea/gitea/pull/10814.patch","merged_at":"2020-04-01T04:14:47Z"},"body":"Add organization wide labels\r\n\r\nImplement organization wide labels similar to organization wide webhooks. This lets you create individual labels for organizations that can be used for all repos under that organization (so being able to reuse the same label across multiple repos).\r\n\r\nThis makes it possible for small organizations with many repos to use labels effectively.\r\n\r\nFixes #7406\r\n\r\n- [x] Combine repo/organization templates to reduce code \r\n\r\n- [x] Update label selection \r\n\r\n- [x] Add API endpoints for organization labels that match repo labels\r\n\r\n- [x] Integrate organization labels in relevant Issues and IssueLabel API calls\r\n\r\n- [x] Unit Tests\r\n\r\n- [x] Integration Tests\r\n\r\nWhile I was here I updated the repo labels UI a bit as it had a few layout issues and the current dashed border version didn't look very nice in the organization settings.\r\n\r\nAlso found that https://try.gitea.io/api/swagger#/issue/issueSearchIssues with multiple labels was broken in https://github.com/go-gitea/gitea/commit/dbd9d8dd54fd3b0ff7b02ae7b7da8369654e3725#diff-d5eea3b2c0d4c92d62e12b34eb8da2c0 and fixed that too (and added integration tests).\r\n\r\nScreenshots:\r\n\r\n**Org Labels:**\r\n<img width=\"1298\" alt=\"Screen Shot 2020-03-24 at 6 37 46 PM\" src=\"https://user-images.githubusercontent.com/1669571/77485178-dfaf0280-6e02-11ea-843f-8fae901133ed.png\">\r\n\r\n<img width=\"1253\" alt=\"Screen Shot 2020-03-24 at 6 08 48 PM\" src=\"https://user-images.githubusercontent.com/1669571/77485304-2ef53300-6e03-11ea-8076-66b125aec6e1.png\">\r\n\r\n**Label Selection:**\r\n\r\n<img width=\"240\" alt=\"Screen Shot 2020-03-24 at 10 45 03 PM\" src=\"https://user-images.githubusercontent.com/1669571/77496350-2a3f7780-6e21-11ea-889d-04384ddb126e.png\">\r\n\r\n**Repo Label List:**\r\n<img width=\"1273\" alt=\"Screen Shot 2020-03-24 at 6 07 32 PM\" src=\"https://user-images.githubusercontent.com/1669571/77485346-47654d80-6e03-11ea-8455-689fc992df6d.png\">\r\n\r\n**Issue search/list with same label applied to multiple repo issues:**\r\n<img width=\"1181\" alt=\"Screen Shot 2020-03-24 at 6 20 28 PM\" src=\"https://user-images.githubusercontent.com/1669571/77485367-5a781d80-6e03-11ea-9b04-28366071d62b.png\">\r\n(pagination bugs not mine 😬)","reactions":{"url":"https://api.github.com/repos/go-gitea/gitea/issues/10814/reactions","total_count":9,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":5,"rocket":4,"eyes":0},"timeline_url":"https://api.github.com/repos/go-gitea/gitea/issues/10814/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":3186104651,"node_id":"MDExOkNsb3NlZEV2ZW50MzE4NjEwNDY1MQ==","url":"https://api.github.com/repos/go-gitea/gitea/issues/events/3186104651","actor":{"login":"guillep2k","id":18600385,"node_id":"MDQ6VXNlcjE4NjAwMzg1","avatar_url":"https://avatars