ne of the following code in the file _detail/setup.hpp_\n\n``` cpp\n#   define GLM_HAS_DEFAULTED_FUNCTIONS ((GLM_LANG & GLM_LANG_CXX0X_FLAG) && (\\\n        ((GLM_COMPILER & GLM_COMPILER_GCC) && (GLM_COMPILER >= GLM_COMPILER_GCC44)) || \\\n        ((GLM_COMPILER & GLM_COMPILER_VC) && (GLM_COMPILER >= GLM_COMPILER_VC2013)) || \\\n        ((GLM_COMPILER & GLM_COMPILER_INTEL) && (GLM_COMPILER >= GLM_COMPILER_INTEL12)))) == 0 ? 0 : 1\n```\n\nDo not forget the bracket added in the first line of the code.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/g-truc/glm/issues/comments/132587305/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"wierich","id":13868710,"node_id":"MDQ6VXNlcjEzODY4NzEw","avatar_url":"https://avatars.githubusercontent.com/u/13868710?v=4","gravatar_id":"","url":"https://api.github.com/users/wierich","html_url":"https://github.com/wierich","followers_url":"https://api.github.com/users/wierich/followers","following_url":"https://api.github.com/users/wierich/following{/other_user}","gists_url":"https://api.github.com/users/wierich/gists{/gist_id}","starred_url":"https://api.github.com/users/wierich/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wierich/subscriptions","organizations_url":"https://api.github.com/users/wierich/orgs","repos_url":"https://api.github.com/users/wierich/repos","events_url":"https://api.github.com/users/wierich/events{/privacy}","received_events_url":"https://api.github.com/users/wierich/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/g-truc/glm/issues/comments/132620246","html_url":"https://github.com/g-truc/glm/issues/377#issuecomment-132620246","issue_url":"https://api.github.com/repos/g-truc/glm/issues/377","id":132620246,"node_id":"MDEyOklzc3VlQ29tbWVudDEzMjYyMDI0Ng==","user":{