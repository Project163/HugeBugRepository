rmup -v\r\ncat var/cache/prod/App_KernelProdContainer.preload.php\r\n```\r\n\r\nIs there anything else I can do to help ? I could help with a PR, but I don't know how to approach the bug. This feels like an issue with the design. Yeah, sure, I might be able to submit a PR with one or two extra checks to prevent this from happening, but that wouldn't be ok in the long run.\r\n\r\nThanks !","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/symfony/symfony/issues/comments/627466082/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"event":"commented","actor":{"login":"ovrflo","id":4866936,"node_id":"MDQ6VXNlcjQ4NjY5MzY=","avatar_url":"https://avatars.githubusercontent.com/u/4866936?v=4","gravatar_id":"","url":"https://api.github.com/users/ovrflo","html_url":"https://github.com/ovrflo","followers_url":"https://api.github.com/users/ovrflo/followers","following_url":"https://api.github.com/users/ovrflo/following{/other_user}","gists_url":"https://api.github.com/users/ovrflo/gists{/gist_id}","starred_url":"https://api.github.com/users/ovrflo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ovrflo/subscriptions","organizations_url":"https://api.github.com/users/ovrflo/orgs","repos_url":"https://api.github.com/users/ovrflo/repos","events_url":"https://api.github.com/users/ovrflo/events{/privacy}","received_events_url":"https://api.github.com/users/ovrflo/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/symfony/symfony/issues/comments/627468961","html_url":"https://github.com/symfony/symfony/issues/36793#issuecomment-627468961","issue_url":"https://api.github.com/repos/symfony/symfony/issues/36793","id":627468961,"node_id":"MDEyOklzc3VlQ29tbWVudDYyNzQ2ODk2MQ==","user":{"login":"nicolas-grekas","id":243674,"node_id":"MDQ6VXNlcjI0MzY3NA==","avatar_url":"https://avatars