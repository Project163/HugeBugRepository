et":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vuejs/core/issues/8503/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/vuejs/core/issues/comments/1578886289","html_url":"https://github.com/vuejs/core/issues/8501#issuecomment-1578886289","issue_url":"https://api.github.com/repos/vuejs/core/issues/8501","id":1578886289,"node_id":"IC_kwDOCCum185eG-SR","user":{"login":"Fuzzyma","id":3540542,"node_id":"MDQ6VXNlcjM1NDA1NDI=","avatar_url":"https://avatars.githubusercontent.com/u/3540542?v=4","gravatar_id":"","url":"https://api.github.com/users/Fuzzyma","html_url":"https://github.com/Fuzzyma","followers_url":"https://api.github.com/users/Fuzzyma/followers","following_url":"https://api.github.com/users/Fuzzyma/following{/other_user}","gists_url":"https://api.github.com/users/Fuzzyma/gists{/gist_id}","starred_url":"https://api.github.com/users/Fuzzyma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Fuzzyma/subscriptions","organizations_url":"https://api.github.com/users/Fuzzyma/orgs","repos_url":"https://api.github.com/users/Fuzzyma/repos","events_url":"https://api.github.com/users/Fuzzyma/events{/privacy}","received_events_url":"https://api.github.com/users/Fuzzyma/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-06T14:35:08Z","updated_at":"2023-06-06T14:37:22Z","body":"@shaileshnighojkar I disagree. as-is means, that nothing is changed in whatever object you pass to shallowReactive.\r\nSince you pass a reactive object, that exposes every property (and doesnt expose refs), shallowReactive should leave it untouched and just also return every property as before. A reactive object should behave like a transparent proxy. From the shallowReactive functions point of view, it is just a plain object\r\n\r\n> ref values will **not** be automatically unwrapped\r\n\r\nIn a sense the opposite happens because they are go