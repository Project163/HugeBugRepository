":10134896,"node_id":"MDQ6VXNlcjEwMTM0ODk2","avatar_url":"https://avatars.githubusercontent.com/u/10134896?v=4","gravatar_id":"","url":"https://api.github.com/users/janakdr","html_url":"https://github.com/janakdr","followers_url":"https://api.github.com/users/janakdr/followers","following_url":"https://api.github.com/users/janakdr/following{/other_user}","gists_url":"https://api.github.com/users/janakdr/gists{/gist_id}","starred_url":"https://api.github.com/users/janakdr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/janakdr/subscriptions","organizations_url":"https://api.github.com/users/janakdr/orgs","repos_url":"https://api.github.com/users/janakdr/repos","events_url":"https://api.github.com/users/janakdr/events{/privacy}","received_events_url":"https://api.github.com/users/janakdr/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2020-09-17T13:39:45Z","label":{"name":"P3","color":"fbca04"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/bazelbuild/bazel/issues/comments/694342107","html_url":"https://github.com/bazelbuild/bazel/issues/11151#issuecomment-694342107","issue_url":"https://api.github.com/repos/bazelbuild/bazel/issues/11151","id":694342107,"node_id":"MDEyOklzc3VlQ29tbWVudDY5NDM0MjEwNw==","user":{"login":"endobson","id":170008,"node_id":"MDQ6VXNlcjE3MDAwOA==","avatar_url":"https://avatars.githubusercontent.com/u/170008?v=4","gravatar_id":"","url":"https://api.github.com/users/endobson","html_url":"https://github.com/endobson","followers_url":"https://api.github.com/users/endobson/followers","following_url":"https://api.github.com/users/endobson/following{/other_user}","gists_url":"https://api.github.com/users/endobson/gists{/gist_id}","starred_url":"https://api.github.com/users/endobson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/endobson/subscriptions","organizations_url":"https://a