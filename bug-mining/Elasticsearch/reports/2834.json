rl":"https://api.github.com/users/kingherc/subscriptions","organizations_url":"https://api.github.com/users/kingherc/orgs","repos_url":"https://api.github.com/users/kingherc/repos","events_url":"https://api.github.com/users/kingherc/events{/privacy}","received_events_url":"https://api.github.com/users/kingherc/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Today if we detect concurrent modification of a snapshot repository then we mark it with `CORRUPTED_REPO_GEN` which blocks further writes to try and prevent additional damage to its contents. You can remove the marker by calling the register-repository API again, but this API will discard no-op re-registrations without taking any action. You can work around this by unregistering the repository first (which may be impossible if it's still in use for searchable snapshots) or by re-registering it with some trivial setting change (which seems hacky).\r\n\r\nWe should not consider it a no-op re-registration if the repository is currently marked with `CORRUPTED_REPO_GEN`, because doing this re-registration will re-read the repo contents and clear the corruption marker and therefore is not a no-op.","closed_by":{"login":"kingherc","id":5519665,"node_id":"MDQ6VXNlcjU1MTk2NjU=","avatar_url":"https://avatars.githubusercontent.com/u/5519665?v=4","gravatar_id":"","url":"https://api.github.com/users/kingherc","html_url":"https://github.com/kingherc","followers_url":"https://api.github.com/users/kingherc/followers","following_url":"https://api.github.com/users/kingherc/following{/other_user}","gists_url":"https://api.github.com/users/kingherc/gists{/gist_id}","starred_url":"https://api.github.com/users/kingherc/starred{/owner}{/repo}","subscriptions_url"