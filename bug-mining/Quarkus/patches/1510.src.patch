+
+    @Test
+    public void testPermitAllBlocking() {
+        Arrays.asList("/permitAllBlocking/defaultSecurity", "/permitAllBlocking/sub/subMethod").forEach((path) -> {
+            RestAssured.get(path).then().statusCode(200);
