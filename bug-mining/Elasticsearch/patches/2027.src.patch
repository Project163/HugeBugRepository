+
+description = 'Request and response objects shared by the cli, jdbc ' +
+        'and the Elasticsearch plugin'
+
+dependencies {
+    /* We'd like to just depend on xcontent but there are some bits of
+     * :server that we rely on.... */
+    compile (project(':server')) {
+        transitive = false
